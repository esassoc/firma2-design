---
// AppLayout — the application chrome every ProjectFirma 2.0 prototype renders
// inside: a collapsible sidenav that owns the omnibox and account menu, a thin
// pinned top bar over the content column (firma2-top-bar: crumbs and the page's
// actions), and the content region. A thin wrapper over esa-app-shell, the hub's
// CANONICAL house chrome — this layout contributes the nav model, the search
// index, and the fixed-height frame the shell needs, and no visual primitives
// of its own.
//
// Use this for prototypes (screens of the product). BaseLayout stays the bare
// document for anything that is NOT the app — the landing page and the
// design-system browser, which carry DocsLayout's own chrome instead.
import BaseLayout from './BaseLayout.astro';
import EsaAppShell from '@esa/ecology/esa-app-shell.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import { navItemsFor, organizationNavItems, workspaceSettingsNavItems, searchIndex } from '../data/firma2-nav';
import type { Firma2NavItem } from '../data/firma2-nav';
import { withBase } from '../lib/base';
import { CONTENT_MAX, CONTENT_READING } from '../lib/content-width';
import Firma2PagesNav from '../components/shared/firma2-pages-nav.astro';
import Firma2NavArrange from '../components/shared/firma2-nav-arrange.astro';
import Firma2TopBar from '../components/shared/firma2-top-bar.astro';
import { seedEntries } from '../data/firma2-pages';
import { pagesNavItems } from '../lib/custom-pages';

interface Props {
  /** Document title. The shell's wordmark is the product name and does not change. */
  title?: string;
  /** `key` of the nav item to mark current. */
  active?: string;
  /** Which rail to show: the app's navigation, or Workspace settings' sections. */
  nav?: 'app' | 'workspace-settings';
  /**
   * How wide the page's content may grow. `default` caps it at CONTENT_MAX and
   * centres it in the pane. `full` hands the whole pane to the page: the project
   * map, where the canvas IS the page, and any page with a trailing rail, which
   * wraps its own main column in an EsaContainer at CONTENT_MAX so the rail
   * stays on the window's edge. `reading` caps at CONTENT_READING for pages
   * that are read rather than surveyed: settings sections, forms, short lists.
   */
  width?: 'default' | 'reading' | 'full';
}

const { title = 'ProjectFirma 2.0', active, nav = 'app', width = 'default' } = Astro.props;

// THE CONTENT COLUMN HAS A CEILING. On a wide monitor an uncapped pane stretches
// tables, forms and cards into lines too long to read and rows too wide to scan;
// past CONTENT_MAX the column stops growing and centres instead (the settings-page
// pattern Linear uses). The pane's own padding still supplies the gutter below it,
// so nothing changes until the pane outgrows it. The number and its reasoning
// live in lib/content-width, shared with the pages that cap only a main column.

// The nav model and search index are stored base-less; the base prefix is a
// render-time concern (dev serves at /, the GitHub Pages build at /firma2-design/).
// `disabled` is DERIVED from the missing href rather than stored beside it, so
// the two can never disagree: a route this spoke has not built is a route you
// cannot go to, and it says so.
//
// It has to be `disabled` and not just the absence of an href. esa-sidebar-nav
// renders an href-less row as an inert <span>, which is genuinely unclickable —
// but `.link--inert` only sets `cursor: default`, so it LOOKS exactly like a
// working row. Unavailable and indistinguishable is the worst of both. Setting
// `disabled` dims the row to opacity 0.5 and takes it out of the pointer and
// tab order, so the appearance matches the behaviour.
//
// Most of the rail is dimmed today because most of the product is unbuilt. That
// is an accurate picture of a spoke with one working screen, not a styling
// problem — the dimming recedes on its own as pages land.
//
// A PARENT ROW is the exception: it has no href by construction (it opens, it
// does not go), so it is never disabled — even when every child is unbuilt,
// opening it is how a reader sees what that organization will offer.
const toRailItem = (item: Firma2NavItem): Firma2NavItem & { disabled: boolean } => {
  const children = item.children?.map(toRailItem);
  return {
    ...item,
    href: item.href ? withBase(item.href) : undefined,
    children,
    disabled: children ? false : !item.href,
  };
};
const items = (nav === 'workspace-settings' ? workspaceSettingsNavItems : [...navItemsFor(active), ...organizationNavItems]).map(toRailItem);
// PAGES CLOSE THE APP RAIL: the workspace's own pages and folders, after the
// product's fixed groups. The seeds render here so the group is on the page
// before any script runs; Firma2PagesNav swaps in this browser's adds and puts
// the + on the heading. Built already based and enabled — a folder has no href
// and must not be dimmed by the rule above.
const railItems = nav === 'app' ? [...items, ...pagesNavItems(seedEntries)] : items;
const searchEntries = searchIndex.map((entry) => ({ ...entry, id: withBase(entry.id) }));

// THE ACCOUNT MENU IS SIGN OUT ALONE. The shell's default adds Profile and
// Settings, both cut (user call): the settings rail already opens on the
// Personal pages, so the account menu was a second door to the same room.
const userMenu = [{ label: 'Sign out', action: 'sign-out', variant: 'danger' as const }];

// No `mark` is passed: this spoke has no ProjectFirma wordmark or glyph yet, and
// the brand ramp still points at the hub's default. Inventing a logo for a real
// product would be worse than the text wordmark the shell falls back to —
// design-principles wants the identity RESEARCHED, not fabricated.
---
<BaseLayout title={title}>
  <div class="firma2-app-frame" data-nav={nav}>
    <EsaAppShell
      title="ProjectFirma 2.0"
      active={active}
      items={railItems}
      searchIndex={searchEntries}
      searchPlaceholder="Search projects, organizations, and pages"
      userName="Dana Whitfield"
      userMenu={userMenu}
      brandHref={withBase('/')}
    >
      {/* The root-only bar. A page's firma2-page-header swaps its own (crumbs,
          status, actions) in for this one during parse — see firma2-top-bar. */}
      <Firma2TopBar />
      {width === 'full' ? <slot /> : <EsaContainer maxWidth={width === 'reading' ? CONTENT_READING : CONTENT_MAX}><slot /></EsaContainer>}
    </EsaAppShell>
  </div>
  {nav === 'app' && <Firma2PagesNav />}
  {nav === 'app' && <Firma2NavArrange />}
</BaseLayout>

<script>
  // THE ACCOUNT MENU'S DESTINATIONS.
  //
  // esa-app-shell's user menu is DATA, not links: its items carry an `action`
  // string and selecting one emits a composed `menu-action` event: the shell
  // deliberately does not decide where an app's account routes live. So the
  // routing is the spoke's, and it belongs in the layout rather than on a page —
  // the menu is on every screen, so its behaviour has to be too.
  //
  // The account menu is Sign out alone (see the frontmatter), and it stays inert:
  // there is no sign-in screen to land on. esa-app-shell's AppShellMenuItem has
  // no `disabled` field, so it cannot yet be DIMMED the way a nav row is — an
  // upstream gap. Only the workspace menu's actions are wired.
  import { withBase } from '../lib/base';
  import { SETTINGS_HOME } from '../data/firma2-nav';

  const ROUTES: Record<string, string> = {
    // The workspace menu on the rail's wordmark emits the same event. Settings
    // opens on the first row of its rail, Personal › Preferences.
    settings: SETTINGS_HOME,
  };

  // On `document`, not on the menu: the event is composed and bubbling, and the
  // menu element is created by the shell's own island script, so there is no
  // reliable moment at which this layout could query for it.
  document.addEventListener('menu-action', (event) => {
    const route = ROUTES[(event as CustomEvent<string>).detail];
    if (route) window.location.href = withBase(route);
  });

  // G THEN S OPENS SETTINGS — the two-key "go to" convention Linear and GitHub
  // use. Not ⌘, (the desktop-app habit): in a browser that is the browser's own
  // settings, and a page that steals it surprises more people than it helps.
  // The second key has to follow within a second, and neither counts while the
  // reader is typing — in a field, in the omnibox, or inside a lego's shadow
  // root, which is why the target is read through composedPath().
  const isTyping = (event: KeyboardEvent): boolean =>
    event.composedPath().some(
      (node) =>
        node instanceof HTMLElement &&
        (node.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(node.tagName)),
    );

  let goPressedAt = 0;
  document.addEventListener('keydown', (event) => {
    if (event.metaKey || event.ctrlKey || event.altKey || event.repeat || isTyping(event)) return;
    const key = event.key.toLowerCase();
    if (key === 'g') {
      goPressedAt = event.timeStamp;
    } else if (key === 's' && goPressedAt && event.timeStamp - goPressedAt < 1000) {
      goPressedAt = 0;
      event.preventDefault();
      window.location.href = withBase(SETTINGS_HOME);
    } else {
      goPressedAt = 0;
    }
  });
</script>

<script>
  // Staggers bcn-progress-ring's draw-in across every ring on the page.
  import '../lib/ring-stagger';
  import { ICON_PATHS } from '@esa/ecology/icon-registry';
  // Registers <bcn-edge-handle>, the grip mountRailEdgeHandle appends to the
  // rail's edge below. A side-effect import: the module defines a custom element
  // and exports nothing.
  import '../components/shared/bcn-edge-handle';

  // esa-text-field is TALLER THAN EVERY CONTROL BESIDE IT, at every size.
  //
  // Measured control heights, the two legos a filter row is built from:
  //
  //     size   esa-text-field .control   esa-filter-dropdown trigger
  //     xs     31px                      28px
  //     sm     38px                      32px
  //     md     46px                      40px      <- the row this spoke uses
  //     lg     58px                      48px
  //
  // They never agree, so a search field next to a filter dropdown is ragged out
  // of the box. design-principles asks for the opposite in as many words:
  // "every control sharing a row, bar, or group matches its siblings in rendered
  // height, font size, and variant. Verify RENDERED output — different
  // components can resolve different tokens and silently mismatch." This is that
  // failure exactly.
  //
  // No token can reach it: --form-height-* was deleted (2026-08-14) and
  // --form-padding-* the same week, so a field's height is padding read straight
  // off --spacing-* with no hook. Hence a literal 40px — not a chosen value but a
  // MEASURED one, the height esa-filter-dropdown renders at md. Zeroing the
  // input's block padding lets it centre in the shorter box.
  //
  // Scoped to size="md" because that is the rung this spoke's filter rows use;
  // sm and lg are untouched and still ragged if something adopts them.
  //
  // TEMPORARY — belongs upstream. Not yet filed; #31 covers the LABEL half of
  // the same root cause (one `size` prop mapped onto ramps that disagree).
  // ONE height for every field control in this app, whatever lego draws it.
  //
  // The measured md rung, at the point each lego stops agreeing with the others:
  //
  //     lego                  box     text
  //     esa-text-field        44px    15px
  //     esa-select            47px    16px
  //     esa-filter-dropdown   40px    —
  //
  // Three legos, three heights, no two the same — and the sm rung is worse
  // (36 / 43, with esa-text-field's text at 12px, below the 13px floor
  // design-principles sets for ANY text). So `md` is the rung this app uses
  // everywhere and 40px is the height, taken from esa-filter-dropdown because it
  // is the one control here with no height hook to pin at all.
  //
  // The payloads differ because the legos hang their box on different
  // elements: esa-text-field draws border/height on a `.control` wrapper around
  // `.input`, while esa-select's trigger IS `.input` and there is no `.control`.
  // Pinning the wrong one is a no-op that looks like a fix. esa-combobox takes
  // esa-select's payload: its box is likewise the `.input` itself (in multi
  // mode the chips render OUTSIDE the box, above it, so a fixed input height
  // stays correct however many members are picked).
  const CONTROL_PINS: Record<string, string> = {
    'esa-text-field': `
      .control { height: 40px; }
      .input { padding-block: 0; }
    `,
    'esa-select': `
      .input { height: 40px; padding-block: 0; }
    `,
    'esa-combobox': `
      .input { height: 40px; padding-block: 0; }
    `,
    // Not a height: the group's <fieldset> keeps the UA's grooved border,
    // padding and margin — esa-radio-group resets all four, this lego none
    // (hub bug, 2026-10-20; drop this once the hub resets it).
    'esa-checkbox-group': `
      .items { border: 0; padding: 0; margin: 0; min-inline-size: 0; }
    `,
  };

  function pinControl(tag: string, css: string): void {
    document.querySelectorAll(`${tag}[size="md"]`).forEach((field) => {
      const root = field.shadowRoot as (ShadowRoot & { _firma2FieldH?: boolean }) | null;
      if (!root || root._firma2FieldH) return;
      const sheet = new CSSStyleSheet();
      sheet.replaceSync(css);
      root.adoptedStyleSheets = [...root.adoptedStyleSheets, sheet];
      root._firma2FieldH = true;
    });
  }

  // EACH TAG WAITS ON ITS OWN DEFINITION. Not Promise.all over all of them —
  // that shipped as a regression on 2026-08-20 and is worth the warning:
  // `customElements.whenDefined()` for an element a page never imports NEVER
  // RESOLVES, it does not reject and it does not time out. So one Promise.all
  // across the whole map meant a single unused lego silently withheld the pin
  // from every OTHER control on that page. The Projects index imports
  // esa-text-field and esa-filter-dropdown but no esa-select, so its search
  // field went back to 46px beside 40px dropdowns — the exact mismatch this
  // code exists to prevent, reintroduced by the code itself.
  //
  // Per-tag registration is also what makes CONTROL_PINS safe to grow: adding a
  // lego here can never affect a page that does not use it.
  const defined = new Set<string>();
  for (const [tag, css] of Object.entries(CONTROL_PINS)) {
    customElements.whenDefined(tag).then(() => {
      defined.add(tag);
      requestAnimationFrame(() => pinControl(tag, css));
    });
  }

  // CONTROLS BUILT AFTER LOAD GET THE PIN TOO. A canvas that repaints (the
  // intake builder, its inline field and condition rows) creates fresh md
  // fields long after the pass above, and each came back at the lego's own
  // 46px beside its 40px neighbours. One frame after any insertion, every
  // defined tag is pinned again; pinControl skips roots it has already done.
  let repin = 0;
  new MutationObserver(() => {
    if (repin) return;
    repin = requestAnimationFrame(() => {
      repin = 0;
      defined.forEach((tag) => pinControl(tag, CONTROL_PINS[tag]));
    });
  }).observe(document.body, { childList: true, subtree: true });

  // "/" TYPED INTO A FIELD STAYS IN THE FIELD. esa-entity-search's "/ to
  // search" hotkey listens on document and asks whether event.target is an
  // input — but a lego's input sits in a shadow root, so the target it sees is
  // the esa-text-field host, and a web address typed into a link dialog lost
  // its first "/" to the search box (focus jumped there). Hub bug, due
  // upstream; until then the keystroke is stopped on <html>, one step before
  // document, whenever the element really receiving it is editable.
  document.documentElement.addEventListener('keydown', (event) => {
    if (event.key !== '/') return;
    const origin = event.composedPath()[0] as HTMLElement | undefined;
    if (origin && (['INPUT', 'TEXTAREA', 'SELECT'].includes(origin.tagName) || origin.isContentEditable)) event.stopPropagation();
  });

  // THE RAIL OWNS THE APP'S CHROME; THE TOP BAR OWNS THE PAGE'S.
  //
  // Since 2026-10-19 there IS a top bar again — firma2-top-bar, thin (48px) and
  // pinned over the content column, holding the breadcrumb trail and the page's
  // status and actions, Tally-style. It is not the shell's bar: that one stays
  // hidden (below), because everything it held is app chrome and still lives in
  // the rail, for the reason that follows. The split is: rail = who you are and
  // where you can go; top bar = where you are and what you can do here.
  //
  // esa-app-shell's house arrangement is a bar across the top holding the
  // collapse toggle, the omnibox and the profile menu, above a rail that holds
  // only navigation. This spoke makes the opposite choice, and the reason is the
  // scroll model directly above: the document scrolls, so the bar does not stay
  // on screen. Every control left in it — search, collapse, account — is one you
  // reach for at any moment, and a control you can only reach by scrolling back
  // to the top of a six-section record is not available. The rail is the surface
  // that persists, so the persistent controls live there:
  //
  //     head   brand · search          (identity, then the way to anything)
  //     body   navigation              (the rail's own job)
  //     foot   account · collapse      (who you are, how wide this is)
  //
  // That empties the bar completely, so the stylesheet drops it — see the
  // `display: none` rule, which also means none of this is ever painted in the
  // corner it is about to leave.
  //
  // MOVED, NOT REBUILT — all three. Each node keeps its id, its data attribute
  // and its listeners, and the shell wires all of them from the document rather
  // than from inside the bar (`document.querySelector('[data-shell-toggle=…]')`,
  // `[data-shell-search=…]`, `getElementById(menuId)`), so relocation cannot
  // break the wiring and the order of the two module scripts does not matter.
  // Nothing here re-implements a control.
  function moveChromeIntoRail(): void {
    document.querySelectorAll<HTMLElement>('.esa-app-shell').forEach((shell) => {
      // ---- head: the omnibox trigger, directly under the wordmark ----
      // Slotted into the rail's `header` alongside the brand, which is the only
      // slot esa-sidebar-nav exposes. Both land in its `.rail-head`, a flex ROW
      // by default — the companion shadow stylesheet turns it into a column so
      // the search sits UNDER the wordmark rather than beside it.
      //
      // The rail styles slotted header content with `::slotted([slot='header'])`
      // — `display: block` and its own padding — which would flatten the search
      // button's internal flex row. It does not, and that is the shadow-DOM
      // cascade rather than luck: for a slotted element the OUTER tree's
      // declarations win over the inner tree's ::slotted rules, so the shell's
      // own `.esa-app-shell__search` display/padding/height hold. Measured to
      // confirm rather than taken on faith.
      const brand = shell.querySelector<HTMLElement>('.esa-app-shell__brand');
      const search = shell.querySelector<HTMLElement>('.esa-app-shell__search');
      if (brand && search) {
        search.setAttribute('slot', 'header');
        brand.insertAdjacentElement('afterend', search);
      }
      if (brand) mountWorkspaceMenu(brand);

      // ---- foot: the account menu and the collapse toggle ----
      const menu = shell.querySelector<HTMLElement>('.esa-app-shell__bar esa-dropdown-menu');
      if (!menu) return;
      // A menu anchored at the bottom of the viewport has to open upward. The
      // four placements are a reflected attribute, so setting it before or after
      // upgrade both land.
      menu.setAttribute('position', 'above-start');

      // A plain container, not a component: it holds two legos and its only job
      // is to be the grid item the stylesheet places at the foot of column 1.
      const foot = document.createElement('div');
      foot.className = 'firma2-app-frame__account';
      foot.appendChild(menu);

      const toggle = shell.querySelector<HTMLElement>('.esa-app-shell__toggle');
      if (toggle) foot.appendChild(toggle);

      // Appended to the SHELL, not to the rail. esa-sidebar-nav has no footer
      // slot, and its host clips (`overflow: hidden`), which would cut the menu
      // panel off at the rail's edge. As a sibling grid item laid over the
      // rail's foot it needs no shadow-DOM surgery and the panel opens
      // unclipped. This is the third override against the same two missing
      // slots — worth a /request-lego for `header` room and a `footer` on the
      // rail, and then most of this function goes away.
      shell.appendChild(foot);
    });
  }

  // ---- THE WORDMARK IS THE WORKSPACE MENU ----
  //
  // The top of the rail names where you are, so it is also where you go to
  // change it or configure it — the workspace switcher convention (Slack, Linear,
  // Notion). The menu is esa-dropdown-menu, the same lego as the account menu at
  // the foot; nothing about the panel is re-implemented.
  //
  // The shell renders its brand as an <a> to brandHref, and a link cannot also be
  // a menu trigger — a click would both navigate and open. So the anchor is
  // swapped for a <button> carrying the SAME attributes (the class and Astro's
  // scope attribute, so every shell rule for `.esa-app-shell__brand` still
  // matches) and the same children. Home stays one click away on the nav.
  const WORKSPACE_MENU = [
    { label: 'Settings', action: 'settings' },
    { label: 'Switch workspace', action: 'change-workspace' },
  ];

  // Drawn from the icon registry, so it is the spoke's icon set like every
  // other chevron in the frame.
  const CHEVRON = `<svg class="firma2-app-frame__workspace-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON_PATHS['chevron-down'] ?? '<path d="m6 9 6 6 6-6"/>'}</svg>`;

  function mountWorkspaceMenu(brand: HTMLElement): void {
    const trigger = document.createElement('button');
    trigger.type = 'button';
    for (const { name, value } of Array.from(brand.attributes)) {
      if (name !== 'href' && name !== 'slot') trigger.setAttribute(name, value);
    }
    trigger.append(...Array.from(brand.childNodes));
    trigger.insertAdjacentHTML('beforeend', CHEVRON);

    const menu = document.createElement('esa-dropdown-menu');
    menu.className = 'firma2-app-frame__workspace';
    menu.setAttribute('slot', 'header');
    menu.setAttribute('width', 'trigger');
    menu.appendChild(trigger);
    brand.replaceWith(menu);

    // `items` is a property, not an attribute, and it is assigned only once the
    // element is defined: set before upgrade it would land as an own property and
    // shadow the reactive accessor the constructor initialises.
    // The lego wraps its trigger in two inline-block boxes, so a slotted
    // `width: 100%` resolves against the trigger's own content. The rail row
    // needs it full-width; there is no hook, so the same adopted-sheet move as
    // stackRailHead below.
    customElements.whenDefined('esa-dropdown-menu').then(() => {
      (menu as HTMLElement & { items: unknown }).items = WORKSPACE_MENU;
      requestAnimationFrame(() => {
        const root = menu.shadowRoot;
        if (!root) return;
        const sheet = new CSSStyleSheet();
        // The shortcut beside Settings. EsaMenuItem has no shortcut field, so it
        // is generated content on the first item, silent to assistive tech (the
        // `/ ''` alt text) since a screen reader user meets it in the omnibox
        // instead. Lego gap: a `shortcut` on EsaMenuItem would retire this.
        sheet.replaceSync(`
          .esa-dropdown, .esa-dropdown__trigger { display: block; }
          .esa-dropdown-menu__item:first-child::after {
            content: 'G S' / '';
            margin-inline-start: auto;
            padding-inline-start: var(--spacing-400, 1rem);
            color: var(--color-content-default-secondary, #646464);
            font-size: var(--typography-body-sm-font-size, 0.875rem);
          }
        `);
        root.adoptedStyleSheets = [...root.adoptedStyleSheets, sheet];
      });
    });
  }

  moveChromeIntoRail();

  // ---- THE RAIL'S EDGE IS A CONTROL ----
  //
  // A bcn-edge-handle on the rail's trailing edge: a 2px bar at the middle of the
  // fold that DRAGS THE RAIL TO A WIDTH. It does not collapse anything — the
  // grip carried both jobs briefly and the two were split apart (2026-08-24,
  // user-directed, following Stripe's docs sidebar), so the edge means width and
  // nothing else. The component's own file owns the interaction; three things are
  // this layout's.
  //
  // COLLAPSE STAYS IN THE FOOT, and this rail is the one place in the spoke where
  // that differs from the record rail's top-corner button. It is not an oversight:
  // moveChromeIntoRail put the shell's toggle down there on a documented argument
  // — with no top bar, the rail IS the app's chrome, and the controls that persist
  // across every screen (who you are, how wide this is) belong together at its
  // foot. Moving it up to match the record rail would re-litigate that to make two
  // rails with different jobs look alike. The grip watches the same `collapsed`
  // attribute the foot toggle flips, so it takes itself off the edge of a
  // collapsed rail whichever control shut it (see its #sync).
  //
  // WHY THE WIDTH IS WORTH DRAGGING AT ALL. 280px is a default chosen for a nav
  // model, not for this one: every label in this spoke's rail fits inside it, and
  // the reader who wants the rail narrower is buying content width on a screen
  // whose main column is a map or a four-column table. The two ends are the
  // limits of the rail's own construction — 200px is where the longest nav label
  // starts to truncate, 400px is where the icon-plus-label row stops reading as a
  // rail and starts reading as a column of its own.
  //
  // CREATED IN SCRIPT, NOT RENDERED IN MARKUP, for the same reason the account
  // strip is: esa-sidebar-nav exposes one slot (`header`) and clips its host, so
  // a handle rendered inside it would be dropped or cut in half at the border it
  // is meant to straddle. Appended to the SHELL, it is a grid item in the rail's
  // own column — the stylesheet places it, exactly as it places the foot.
  function mountRailEdgeHandle(): void {
    document.querySelectorAll<HTMLElement>('.esa-app-shell').forEach((shell) => {
      // `:scope >` and not a bare tag selector. A page can render handles of its
      // own — the record rail puts one on its own edge, inside this shell's
      // content pane — and a descendant search would find that one and conclude
      // the rail already had its handle. Cost one silent no-op before it was
      // caught in the browser; the app's handle is a DIRECT child of the shell,
      // and nothing else's ever is.
      if (shell.querySelector(':scope > bcn-edge-handle')) return;
      const nav = shell.querySelector<HTMLElement>('esa-sidebar-nav');
      if (!nav?.id) return;

      const handle = document.createElement('bcn-edge-handle');
      // `end`: the rail is on the leading side of the page, so the edge that
      // moves is its trailing one.
      handle.setAttribute('edge', 'end');
      handle.setAttribute('panel', `#${nav.id}`);
      // The lego's own width hook, written on the lego's own element. Collapsed
      // it reads --sidenav-width-collapsed instead, which is why nothing here has
      // to remember the open width in order to restore it.
      handle.setAttribute('size-var', '--sidenav-width');
      handle.setAttribute('min', '200');
      // 320, AND THE CEILING IS SET BY A NEIGHBOUR RATHER THAN BY THE RAIL. 400
      // is where the icon-plus-label row stops reading as a rail, and it is not
      // the binding constraint: the project record's `.sidebar` track wraps its
      // rail below the content once the pane drops under 1064px, and on a 1440px
      // window that happens the moment this rail passes 328px. A drag that made
      // the navigation 40px wider and sent the record's rail to the bottom of the
      // page would read as a bug whatever the CSS says. 320 keeps the whole range
      // safe at the width most of these screens are reviewed at, and it costs
      // nothing a nav label needs — the longest in this spoke fits at 280.
      handle.setAttribute('max', '320');
      // The accessible name reads "Resize navigation". "Navigation"
      // and not "sidebar" or "rail": the reader is told what the panel HOLDS,
      // which is also what the landmark it controls is called.
      handle.setAttribute('label', 'navigation');
      handle.setAttribute('storage-key', 'app-nav');
      shell.appendChild(handle);
    });
  }

  mountRailEdgeHandle();

  // The rail's head is a ROW (brand beside toggle) and this spoke needs a COLUMN
  // (brand above search). esa-sidebar-nav already writes exactly this rule for
  // its own collapsed state — `:host([collapsed]) .rail-head { flex-direction:
  // column }` — but exposes no hook to ask for it at full width, so it is
  // adopted onto the shadow root instead. A stylesheet rather than rewritten
  // markup because Lit re-renders that subtree whenever `collapsed` flips and
  // would wipe anything injected as nodes; an adopted sheet survives.
  //
  // `align-items: stretch` is the load-bearing half. The row centres its items,
  // which in a column means both the wordmark and the search shrink-wrap to
  // their content instead of spanning the rail.
  //
  // THE LIST SCROLLS, which the lego only arranges for its drawer mode. At full
  // width `.nav-content` is a `flex: 1; min-height: 0` column with no overflow
  // rule, so a list taller than the rail spills past it and the host's
  // `overflow: hidden` clips the last rows — under the account strip, where they
  // cannot be reached at all. Workspace settings was the first rail long enough
  // to hit it (Your organization, at 950px tall). `overflow-y: auto` on the
  // region the lego already sizes is the whole fix. A hub gap: /request-lego.
  //
  // A LONG LABEL ELLIPSIZES. `.label` is `flex: 1` with text-overflow set, but
  // no `min-width: 0`, so a flex item's automatic minimum holds it at its full
  // text width: "California Watershed Restoration Board" ran past the rail and
  // pushed its parent row's chevron out of sight. Same hub gap.
  const RAIL_HEAD_CSS = `
    .rail-head { flex-direction: column; align-items: stretch; }
    .nav-content { overflow-y: auto; }
    .label { min-width: 0; }
  `;

  function stackRailHead(): void {
    document.querySelectorAll('esa-sidebar-nav').forEach((nav) => {
      const root = nav.shadowRoot as (ShadowRoot & { _firma2Head?: boolean }) | null;
      if (!root || root._firma2Head) return;
      const sheet = new CSSStyleSheet();
      sheet.replaceSync(RAIL_HEAD_CSS);
      root.adoptedStyleSheets = [...root.adoptedStyleSheets, sheet];
      root._firma2Head = true;
    });
  }

  // A PARENT ROW OPENS ON ITS OWN when the page being read is one of its
  // children — an organization's Home, Updates, … — or the reader lands on a
  // page and cannot see where it is. `_expanded` is the rail's private open-set,
  // keyed by label; there is no public way to open a parent row (the same lego
  // gap firma2-pages-nav works around for folders).
  type RailItem = { label: string; active?: boolean; children?: RailItem[] };
  function openActiveParents(): void {
    document.querySelectorAll('esa-sidebar-nav').forEach((nav) => {
      const rail = nav as HTMLElement & { items?: RailItem[]; _expanded?: Set<string> };
      const open = (rail.items ?? []).filter((i) => i.children?.some((c) => c.active)).map((i) => i.label);
      if (open.length && rail._expanded) rail._expanded = new Set([...rail._expanded, ...open]);
    });
  }

  customElements.whenDefined('esa-sidebar-nav').then(() => {
    requestAnimationFrame(() => {
      stackRailHead();
      openActiveParents();
    });
  });

  // ---- A SHUT RAIL PEEKS FROM ITS TOGGLE ----
  //
  // Hovering the expand toggle of a collapsed rail slides the full navigation out
  // OVER the page, and it stays while the pointer is anywhere on it — links,
  // workspace menu, account menu, all live. Leaving shuts it again; clicking the
  // toggle while it is out pins it open instead of shutting it. Linear and
  // Notion's convention for a collapsed sidebar: reach a destination without
  // giving the content its width back.
  //
  // THE PEEK REUSES THE RAIL'S OWN OPEN STATE. `collapsed` is lifted for the
  // length of the peek, so every label, badge and group the lego renders comes
  // back exactly as it does when opened for real, and the lego's own width
  // transition is the slide. `data-nav-peek` on the frame is what makes it an
  // overlay: it holds the grid track at the collapsed width, so the rail
  // overflows across the content instead of pushing it (see the stylesheet).
  // Nothing is persisted — bcn-edge-handle stores state only on its own drags.
  //
  // MOUSE ONLY. A touch "hover" arrives a beat before the tap's click, which
  // would open a peek and then pin it; on a finger the toggle stays a toggle.
  // Keyboard users get the toggle as it was — a peek they cannot point at would
  // only shut under them.
  const PEEK_OPEN_DELAY = 100; // intent: a pointer crossing the toggle on its way elsewhere does not open it
  const PEEK_CLOSE_DELAY = 250; // grace: an overshoot past the panel edge does not shut it

  function mountRailPeek(): void {
    document.querySelectorAll<HTMLElement>('.firma2-app-frame').forEach((frame) => {
      const nav = frame.querySelector<HTMLElement & { collapsed: boolean }>('esa-sidebar-nav');
      const foot = frame.querySelector<HTMLElement>('.firma2-app-frame__account');
      const toggle = foot?.querySelector<HTMLElement>('.esa-app-shell__toggle');
      if (!nav || !foot || !toggle) return;

      let openTimer = 0;
      let closeTimer = 0;
      let settleTimer = 0;
      const peeking = () => frame.getAttribute('data-nav-peek') === 'open';
      const inside = () => nav.matches(':hover') || foot.matches(':hover');
      // HELD OPEN by an open menu (its light-DOM trigger reports aria-expanded) or
      // by keyboard focus inside. Not by any focus: the toggle keeps focus after
      // the click that shut the rail, and that would hold every later peek open.
      const focusInside = () => {
        const el = document.activeElement;
        const menuOpen = !!(nav.querySelector('[aria-expanded="true"]') || foot.querySelector('[aria-expanded="true"]'));
        const keyboard = !!el && (nav.contains(el) || foot.contains(el)) && el.matches(':focus-visible');
        return menuOpen || keyboard;
      };

      const open = () => {
        if (!nav.collapsed || peeking()) return;
        window.clearTimeout(settleTimer);
        const width = getComputedStyle(nav).getPropertyValue('--sidenav-width').trim() || '280px';
        frame.style.setProperty('--firma2-peek-width', width);
        // Two steps, so the foot strip has a computed 72px to slide FROM: its
        // resting width is the track's stretch (`auto`), which does not transition.
        frame.setAttribute('data-nav-peek', 'enter');
        void foot.offsetWidth;
        frame.setAttribute('data-nav-peek', 'open');
        nav.collapsed = false;
      };

      // The track stays held at the collapsed width until the rail has finished
      // sliding back; releasing it sooner would let the content ride the shrink.
      const close = () => {
        if (!peeking()) return;
        frame.setAttribute('data-nav-peek', 'closing');
        nav.collapsed = true;
        const ms = parseFloat(getComputedStyle(nav).transitionDuration) * 1000 || 0;
        settleTimer = window.setTimeout(() => frame.removeAttribute('data-nav-peek'), ms + 20);
      };

      const closeSoon = () => {
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(() => {
          if (!inside() && !focusInside()) close();
        }, PEEK_CLOSE_DELAY);
      };

      toggle.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse' || !nav.collapsed) return;
        window.clearTimeout(openTimer);
        openTimer = window.setTimeout(open, PEEK_OPEN_DELAY);
      });
      toggle.addEventListener('pointerleave', () => window.clearTimeout(openTimer));

      for (const region of [nav, foot]) {
        region.addEventListener('pointerenter', () => window.clearTimeout(closeTimer));
        region.addEventListener('pointerleave', () => { if (peeking()) closeSoon(); });
        // A menu opened from the peek holds focus inside it; when focus leaves
        // to the page, the peek follows unless the pointer is still on it.
        region.addEventListener('focusout', () => { if (peeking()) closeSoon(); });
      }

      // PIN. A capture listener on the target runs before the shell's own click
      // handler, which would otherwise read the peek's lifted `collapsed` as
      // "open" and shut the rail. Stopping it here leaves the rail open; dropping
      // the overlay hands the column its width.
      toggle.addEventListener('click', (e) => {
        window.clearTimeout(openTimer);
        if (!peeking()) return;
        e.stopImmediatePropagation();
        window.clearTimeout(closeTimer);
        frame.removeAttribute('data-nav-peek');
        toggle.classList.remove('is-collapsed');
      }, { capture: true });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && peeking()) close();
      });
      // A peek held open by a menu has no pointerleave left to shut it once the
      // menu goes; a press out on the page does.
      document.addEventListener('pointerdown', (e) => {
        const path = e.composedPath();
        if (peeking() && !path.includes(nav) && !path.includes(foot)) close();
      });
    });
  }

  customElements.whenDefined('esa-sidebar-nav').then(mountRailPeek);

  // THE CONTENT PANE IS NOT A SCROLL REGION HERE, so it must not be a tab stop.
  //
  // esa-app-shell ships `<main tabindex="0">` and is right to: upstream that pane
  // IS the app's scroll container (`overflow-y: auto`), and a scrollable region
  // holding no focusable element cannot be scrolled by keyboard unless it is
  // itself focusable — WCAG 2.1.1, and axe's `scrollable-region-focusable`.
  //
  // The pane scrolls again here (the inset sheet), but Chrome 130+ and Firefox
  // make a scroller with no focusable child keyboard-focusable on their own, so
  // the attribute is still not what keeps it reachable — and it is not free
  // either — @esa/tokens/focus.css matches `[tabindex]:focus-visible`,
  // so landing on it draws a 2px ring around the ENTIRE content region, which
  // reads as a rendering fault rather than as a focus indicator. Every keyboard
  // user hit it on the way out of the rail.
  //
  // Removing the attribute also retires the ~45 lines that used to sit here
  // correcting where focus landed after the omnibox closed: that fix existed
  // only because `showModal()`'s restore could put focus on this pane, which it
  // can no longer do. Native restore is now correct on its own.
  document.querySelectorAll('.esa-app-shell__content[tabindex]').forEach((pane) => {
    pane.removeAttribute('tabindex');
  });
</script>

<style>
  /* md BUTTONS TAKE THE CONTROL LINE TOO. esa-button has no height: an md
     button is 2 × 12px padding + its content + border, so a text-only one
     lands at 41px and one carrying a 20px icon at 46px — "Add option", every
     grip and "…". Beside 40px fields that put a 6px step into every row that
     held one (the schema board's options measured 46px apart instead of 40).
     The pin is the CONTROL_PINS rule, carried in light DOM because
     esa-button is an .astro lego: same 40px, content centred by the button's
     own inline-flex. Icon-only buttons are squares, so they take the width
     too — their padding would otherwise leave a 46 × 40 rectangle. */
  .firma2-app-frame :global(.esa-button--md > .esa-button__native) {
    block-size: 40px;
    padding-block: 0;
  }
  .firma2-app-frame :global(.esa-button--md.esa-button--icon-only > .esa-button__native) {
    inline-size: 40px;
    padding-inline: 0;
  }

  /* THE PAGE SCROLLS, NOT A PANE — so the top bar scrolls AWAY with the content
     instead of hanging over it.

     esa-app-shell's stock arrangement is the opposite: it is layout-agnostic and
     asks for a fixed-height parent, and then only its main region scrolls — which
     makes the bar permanent chrome pinned above a moving page. This spoke wants
     the omnibox and the account menu to read as the top OF the page rather than a
     strip fixed over it, so the scroller moves out to the document and the frame
     claims a MINIMUM height instead of a fixed one: 100dvh so a short page still
     fills the viewport, dvh rather than vh so mobile browser chrome cannot clip
     it, and no ceiling so a long page just grows.

     `display: grid` is how the shell inherits that floor. A block child with
     `height: auto` would not stretch to a parent's min-height, so the shell would
     stop at its content and leave the rail hanging short of the fold; as a grid
     item it stretches to the frame by default.

     The RAIL is the one thing that stays put — it is pinned separately below,
     because a nav you have to scroll back up to reach is not a nav. */
  .firma2-app-frame {
    display: grid;
    height: 100dvh;
    /* THE INSET SHEET — a deliberate departure from esa-app-shell, which has no
       inset variant. The content pane is a rounded sheet laid on the rail's
       sunken surface, a gutter clear of the viewport on every side; the gap and
       the change in value, not a border, are what separate it from the rail.
       Rounded corners only hold if the sheet never scrolls out from under them,
       so the PANE is the scroller here, not the document (see the content rule
       below), and --firma2-fold is the height of that scrollport: every sticky
       panel that used to size itself to 100dvh sizes itself to this instead. */
    --firma2-gutter: var(--spacing-200, 8px);
    --firma2-fold: calc(100dvh - 2 * var(--firma2-gutter));
    /* The sheet's surface: RAISED, not default. The sheet is a panel above the
       frame, and Radix lifts a panel one step in dark (its --color-panel-solid
       is gray-2) rather than sinking what is behind it. Light resolves raised
       and default to the same step, so only dark moves — olive-dark 1 → 2,
       which puts the sheet clear of the frame instead of four RGB values off
       it. Published rather than inlined because every band that paints "the
       page" so content can pass under it (top bar, record rail, peek, side
       panel, sticky table columns, graph halos) has to paint this same step;
       outside the shell they fall back to default. */
    --firma2-sheet-background: var(--color-background-elevation-raised, #fcfcfc);
    /* A sticky box inside a scroll container sticks to its CONTENT edge — the
       scrollport deflated by the container's padding — so in this pane `top: 0`
       lands 1.5rem below the sheet's top and a fold-tall rail overruns its
       bottom by the same. Every block-axis sticky in the spoke adds this to its
       `top`, which puts its zero back on the sheet's edge. The literal is the
       pane padding the bleeding bands already restate as --_bleed. */
    --firma2-sticky-origin: calc(var(--spacing-500, 1.5rem) * -1);
    background: var(--color-background-elevation-sunken, #f0f0f0);
    /* The height of the account strip at the foot of the rail — see the ACCOUNT
       MENU block below. Declared here because the rail reads it too, to reserve
       the space, and one number cannot be kept in sync in two places. */
    --firma2-account-height: 56px;
  }

  /* FULL-HEIGHT SIDENAV. esa-app-shell stacks a full-width bar ABOVE a row that
     holds the nav, so the rail starts below the bar. This spoke wants the rail
     to own the full viewport height with the bar beside it — a layout variant
     the shell exposes no prop for, so it is re-flowed here.
     The nav is a GRANDCHILD of the shell (shell > __body > nav), which a grid on
     the shell could not place. `display: contents` on __body dissolves that
     wrapper so the nav, bar, and content all become items of the same grid:
       col 1 = rail (spans both rows) · col 2 = bar over content.
     Everything below is placement only — no colour, no spacing, no type. */
  .firma2-app-frame :global(.esa-app-shell) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    /* ONE row. The bar used to hold the top one; with the bar gone the rail and
       the content are the whole grid, side by side. */
    grid-template-rows: minmax(0, 1fr);
    /* `overflow: visible` undoes the shell's own `overflow: hidden`, and it is
       load-bearing rather than tidying: an `overflow: hidden` ancestor becomes
       the scrollport for every sticky descendant, so the rail below would have
       stuck to a box that itself never scrolls and drifted off with the page.
       The shell's companion `height: 100%` needs no override — it resolves
       against a parent with no fixed height, so it is already `auto`. */
    overflow: visible;
    /* The gutter around the sheet reads as the rail's surface carried round the
       page, so the shell paints it rather than its stock page background. */
    background: transparent;
  }
  .firma2-app-frame :global(.esa-app-shell__body) {
    display: contents;
  }
  /* The rail is the only pinned surface left. With the document scrolling, a
     rail that merely spans both rows would scroll off with everything else, so
     it sticks to the top of the viewport instead.
     `align-self: start` + an explicit 100dvh are both required: stretched to a
     grid area as tall as the page, a sticky box has nowhere to travel and never
     appears to stick. Sized to the viewport and anchored at the area's start, it
     holds the fold. esa-sidebar-nav's `height: 100%` and its internal scroll
     resolve against that 100dvh, so a long nav still scrolls within the rail. */
  .firma2-app-frame :global(.esa-app-shell__nav) {
    grid-column: 1;
    grid-row: 1;
    position: sticky;
    top: 0;
    align-self: start;
    height: 100dvh;
    /* Keeps the foot of the rail clear for the account strip below, so a nav
       list long enough to reach the bottom stops above it instead of running
       underneath. The host is border-box (BaseLayout's global reset reaches
       it), so this comes out of the 100dvh rather than adding to it, and
       esa-sidebar-nav's own `height: 100%` inner nav shortens to match. */
    padding-block-end: var(--firma2-account-height);
    /* The gutter is the rail's edge now; a hairline beside it would draw a
       second edge a gutter's width from the sheet's own. The border sits on the
       host, so this outer rule beats the lego's :host declaration. */
    border-inline-end: 0;
  }
  /* THE BAR IS GONE. Its three controls now live in the rail (see
     moveChromeIntoRail above), which left an empty 66px band that scrolled away
     for no reason — so the layout drops it rather than reserving space for
     nothing.

     `display: none` rather than removing the node in script. It takes the
     element out of the accessibility tree as well as the layout, so there is no
     empty <header> banner landmark left for a screen-reader user to land in —
     which removing it in JS would also achieve, but a frame later and after the
     browser had already painted the controls in a corner they are leaving. This
     way they are never painted there at all.

     Two classes on the selector, not one, and that is load-bearing. Astro
     compiles the shell's own rule to `.esa-app-shell__bar[data-astro-cid-...]` —
     one class plus one attribute, specificity (0,2,0), exactly what
     `.firma2-app-frame .esa-app-shell__bar` scores. On a tie the later rule
     wins, and the shell's stylesheet is emitted after this one, so the plain
     selector would compile to dead code. Matching the bar's second class
     (esa-app-bar, which EsaAppBar puts on the same element) takes it to (0,3,0)
     and settles it on specificity instead of on emission order, which is not
     something this layout controls. */
  .firma2-app-frame :global(.esa-app-shell__bar.esa-app-bar) {
    display: none;
  }
  /* min-height: 0 so this grid item can be laid out from its track rather than
     floored at its content height — the row is `minmax(0, 1fr)` and this is the
     matching half on the item.

     position: relative is not cosmetic and not about z-order. The pane ships
     `position: static`, and `.visually-hidden` (a11y.css) is `position:
     absolute` with auto offsets — the standard clip-rect pattern. An absolutely
     positioned element resolves against its nearest POSITIONED ancestor, so with
     a static pane every screen-reader-only string in the app takes <body> as its
     containing block instead of the content it describes.

     That was a visible fault back when this pane was the app's scroller: the
     project detail page's funding table carries a `<caption class="visually-
     hidden">` ~1490px down, unclipped by the pane's `overflow: auto` because
     clipping only reaches descendants whose containing block is inside the
     clipper — and the 100dvh frame gained a second, outer scrollbar that pushed
     the whole UI off-screen. The document scrolls now, so that specific failure
     cannot recur, but the containing block is still the correct one to establish:
     it keeps a 1px absolutely-positioned box tied to the section it belongs to
     rather than to the document root. */
  .firma2-app-frame :global(.esa-app-shell__content) {
    grid-column: 2;
    grid-row: 1;
    min-height: 0;
    position: relative;
    /* THE SHEET. The pane is the scroller again (the shell's own `overflow-y:
       auto`, restated so it is not read as an accident), sized to the fold and
       held a gutter clear of every edge. `overflow` is also what clips the
       sticky top bar and record rail to the rounded corners — without it their
       square backgrounds would paint over the curve. `overscroll-behavior` keeps
       a fling at the end of a page from bouncing the frame around it. */
    margin: var(--firma2-gutter);
    margin-inline-start: 0;
    block-size: var(--firma2-fold);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: var(--radius-lg, 12px);
    background: var(--firma2-sheet-background);
    box-shadow: 0 0 0 var(--border-width-default, 1px) var(--color-border-default-subtle, #d9d9d9);
  }
  /* ROOM FOR A DOCKED SIDE SHEET (bcn-side-sheet). While one is open the pane's
     end padding grows by the sheet's width, so the sheet sits ON the page
     beside what it edits rather than over it — under the top bar, whose end
     bleed grows by the same amount so it still spans the whole pane. The sheet
     writes its width here as --firma2-side-sheet-size when it opens; a dragged
     width (--firma2-side-sheet-width, from its edge handle) beats it. Below
     64rem the sheet lies over the pane instead, so nothing is reserved. Whole
     selector in :global — Astro mangles a :global nested inside :has. */
  .firma2-app-frame {
    --firma2-side-sheet-size: 400px;
  }
  @media (min-width: 64.0625rem) {
    :global(.firma2-app-frame:has(bcn-side-sheet[open]) .esa-app-shell__content) {
      --_sheet-room: calc(var(--spacing-500, 1.5rem) + var(--firma2-side-sheet-width, var(--firma2-side-sheet-size)));
      padding-inline-end: var(--_sheet-room);
    }
    /* Opening from and closing to the strip: the room follows the sheet. */
    :global(.firma2-app-frame:has(bcn-side-sheet[open][collapsed]) .esa-app-shell__content) {
      --_sheet-room: calc(var(--spacing-500, 1.5rem) + 2.5rem + 2 * var(--spacing-200, 0.5rem) + var(--border-width-default, 1px));
    }
    :global(.firma2-app-frame:has(bcn-side-sheet[open]) .esa-app-shell__content > .firma2-top-bar) {
      margin-inline-end: calc(var(--_sheet-room) * -1);
    }
    /* Same ease as the sheet's own width, so the two edges move as one. */
    :global(.firma2-app-frame .esa-app-shell__content) {
      transition: padding-inline-end var(--transition-base, 200ms ease);
    }
    :global(.firma2-app-frame .esa-app-shell__content > .firma2-top-bar) {
      transition: margin-inline-end var(--transition-base, 200ms ease);
    }
    :global(.firma2-app-frame:has(bcn-side-sheet[data-resizing]) .esa-app-shell__content),
    :global(.firma2-app-frame:has(bcn-side-sheet[data-resizing]) .esa-app-shell__content > .firma2-top-bar) {
      transition: none;
    }
  }
  /* A phone has no gutter to spare: the sheet goes back to the full pane. */
  @media (max-width: 40rem) {
    .firma2-app-frame {
      --firma2-gutter: 0px;
    }
    .firma2-app-frame :global(.esa-app-shell__content) {
      border-radius: 0;
      box-shadow: none;
    }
  }

  /* THE CAP, WITHOUT A SECOND GUTTER. esa-container brings its own 2rem
     padding-inline, written for a page with no other gutter. Here the shell's
     pane already pads its content, so keeping both would inset every page by an
     extra 2rem at all widths — the container is only here for its max-width and
     centring.

     A DESCENDANT, not a child: a page with a trailing rail places its container
     inside its `.sidebar` main track rather than at the top of the pane, and
     that column is already guttered by the sidebar's own gap.

     NO `min-width` HERE, deliberately. In a `.sidebar` the container IS the
     main track, and layouts.css floors that track with `min-inline-size:
     var(--sidebar-content-min)` — the same property. Zeroing it stopped the
     record's rail from wrapping below the content on narrow windows. */
  .firma2-app-frame :global(.esa-app-shell__content .esa-container) {
    padding-inline: 0;
  }

  /* ---- THE RAIL'S FOOT: ACCOUNT + COLLAPSE ----
     The companion script moves the shell's profile dropdown and its sidebar
     toggle out of the (now deleted) bar and appends them to the shell as
     `.firma2-app-frame__account`; the rules below are where they land. Both are
     app-level controls rather than page ones, which is why they sit together
     under the navigation instead of over the content.

     The strip's height is --firma2-account-height, declared on the frame at the
     top of this stylesheet because both halves read it: the strip itself, and
     the padding the rail reserves so a long nav list can never run underneath
     it. */
  .firma2-app-frame :global(.firma2-app-frame__account) {
    /* Same grid area as the rail, pinned to the bottom of it. The column track
       is sized BY the rail, so the strip is exactly as wide as the rail is and
       follows it down to 72px when it collapses — no width of its own, and no
       second place to keep that number in sync. */
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    /* The rail holds the fold with `top: 0`; this holds the other edge. Both are
       sticky because the document is what scrolls (see the frame rule at the top
       of this stylesheet), so without it the strip would sit at the bottom of the
       PAGE — a screen or six below the rail it belongs to. */
    position: sticky;
    bottom: 0;
    z-index: var(--z-sidebar, 100);

    /* Account leading, collapse trailing. `space-between` rather than a gap so
       the toggle keeps the rail's trailing edge whatever the name's length —
       the same edge esa-sidebar-nav's own toggle held with `margin-left: auto`
       before this spoke moved it down here. */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-200, 8px);
    min-height: var(--firma2-account-height);
    /* Matches esa-sidebar-nav's own `.nav` padding, so the account row's icon
       lands on the same left edge as every nav item's icon above it. */
    padding: var(--spacing-200, 8px);

    /* The rail's surface and the rail's edge, both read from the same tokens
       esa-sidebar-nav uses (--color-background-elevation-sunken /
       --color-border-default-subtle). The strip is laid OVER the rail rather
       than inside it, so it has to paint the same surface or it would read as a
       panel floating on the nav. The top hairline is the only thing that says
       it is a separate region — the same weight the rail's own group headings
       use. */
    background: var(--color-background-elevation-sunken, #f0f0f0);
    border-block-start: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #d9d9d9);
  }

  /* ---- THE RAIL'S EDGE HANDLE ----
     bcn-edge-handle ships a placement that assumes it is a child of the panel it
     controls, which is the common case and is what the record rail uses. It
     cannot be one here — esa-sidebar-nav has a closed set of slots and clips its
     host — so the companion script appends it to the SHELL and these six lines
     put it back on the rail's edge. Same trick, same grid area, same reasoning as
     `.firma2-app-frame__account` above.

     `inset: auto` first, and it is load-bearing rather than tidy: the component's
     own `:host` rules set inset-block-start and inset-inline-end for an ABSOLUTE
     box, and on a STICKY one those same two properties are sticky constraints
     against the scrollport — a stray `right` would shove the grip sideways for
     reasons nothing on the page would explain. Clearing them and naming one
     leaves exactly one constraint. (Outer-tree declarations beat a shadow root's
     `:host` rules whatever their specificity, so this needs no !important and no
     selector games.)

     THE CHILD COMBINATOR IS LOAD-BEARING, not tidiness. A page inside this shell
     can render handles of its own — the project record's rail puts one on its own
     edge, in the content pane — and a descendant selector would drag them all
     into the nav rail's grid area. It did, and the rail's grip landed at the foot
     of the column instead of the middle of the fold. The app's handle is the only
     one that is ever a direct child of the shell.

     `top: 50dvh` + `translate: … -50%` is what holds the grip at the middle of
     the FOLD rather than the middle of the page — the document is what scrolls
     here, so the rail's own column is as tall as the whole record. The X half of
     the translate is the straddle: `justify-self: end` lands the box's trailing
     edge on the rail's border, and half its width back over the content pane is
     what makes it sit ON the line instead of inside it. */
  .firma2-app-frame :global(.esa-app-shell > bcn-edge-handle) {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
    align-self: start;
    position: sticky;
    inset: auto;
    top: 50dvh;
    /* Half its own width past the rail's border, then --spacing-200 clear of it —
       the grip stands OFF the edge rather than sitting on it, so it reads as an
       object beside the line instead of a nick in it. The component makes the
       same move for a handle placed inside its panel (--bcn-edge-handle-gap), and
       the token is restated rather than read from there because that declaration
       lives on the shadow root's `:host` and this rule is what overrides the
       placement it belongs to — reading a value out of the block you are
       replacing is a loop waiting to break. */
    translate: calc(50% + var(--bcn-edge-handle-gap, var(--spacing-200, 8px))) -50%;
  }

  /* THE DRAG MUST NOT BE WATCHED THROUGH A 200ms EASE. esa-sidebar-nav animates
     its own width — `transition: width var(--_sidenav-transition)`, which chains
     off the global --transition-base — and that is right for a click and wrong
     for a pointer, where it reads as the edge lagging behind the hand. The lego
     exposes no per-component duration hook, so the tier-1 token is re-pointed on
     the host for the length of the drag and nowhere else; `data-resizing` is set
     and removed by the handle. A /request-lego for --sidenav-transition would
     retire this rule. */
  .firma2-app-frame :global(esa-sidebar-nav[data-resizing]) {
    --transition-base: 0s;
  }

  /* NO EDGE HANDLE ON A PHONE. 45rem is the shell's own breakpoint — the width at
     which it drops the omnibox to an icon — and below it a 18px drag target
     pinned to the middle of the screen's edge is a thing to catch with a thumb by
     accident, not a control. The foot's toggle still collapses the rail. */
  @media (max-width: 45rem) {
    .firma2-app-frame :global(.esa-app-shell > bcn-edge-handle) {
      display: none;
    }
  }

  /* ---- COLLAPSED RAIL: 72px ----
     Everything with a text half loses it and the glyphs centre, which is the
     icon-rail convention the nav items above already follow — esa-sidebar-nav
     zeroes its own labels exactly this way, and turns its head row into a column
     for the same reason: two 32px controls plus a gap do not fit across 72px.
     So the foot stacks too, and the strip's reserved height grows to hold both.

     `:has()` on the frame rather than a class toggled by script: `collapsed` is
     a reflected attribute on the rail, so the DOM already carries the state and
     a second copy of it could only disagree. Every target here is LIGHT DOM —
     esa-button and the shell's own search/toggle buttons — so none of it needs
     shadow-root injection. */
  .firma2-app-frame:has(esa-sidebar-nav[collapsed]),
  .firma2-app-frame[data-nav-peek] {
    --firma2-account-height: 96px;
  }
  .firma2-app-frame:has(esa-sidebar-nav[collapsed]) :global(.firma2-app-frame__account),
  .firma2-app-frame[data-nav-peek] :global(.firma2-app-frame__account) {
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .firma2-app-frame:has(esa-sidebar-nav[collapsed]) :global(.firma2-app-frame__account .esa-button__label),
  .firma2-app-frame:has(esa-sidebar-nav[collapsed]) :global(.firma2-app-frame__account .esa-button__native > .esa-icon:last-child),
  .firma2-app-frame[data-nav-peek] :global(.firma2-app-frame__account .esa-button__label),
  .firma2-app-frame[data-nav-peek] :global(.firma2-app-frame__account .esa-button__native > .esa-icon:last-child),
  .firma2-app-frame:has(esa-sidebar-nav[collapsed]) :global(.esa-app-shell__search-label),
  .firma2-app-frame:has(esa-sidebar-nav[collapsed]) :global(.esa-app-shell__search-kbd) {
    display: none;
  }
  .firma2-app-frame:has(esa-sidebar-nav[collapsed]) :global(.esa-app-shell__search) {
    justify-content: center;
    padding-inline: 0;
  }

  /* ---- THE PEEK: A SHUT RAIL SHOWN OVER THE PAGE ----
     bcn-lego-checked: no esa- overlay fits — this is esa-sidebar-nav's own open
     state laid over the content, not a new surface (esa-side-dialog is modal and
     a second nav); Beacon has no hover-peek. The script (mountRailPeek) lifts
     `collapsed` and sets `data-nav-peek`; these rules make that an overlay.

     The track holds at the collapsed width, so the rail's 280px overflows across
     the content rather than pushing it, and lifts above the page's sticky
     header band (the record rail sits at --z-header + 1). The foot keeps its
     collapsed stack — the toggle under the pointer must not move — inside a
     strip that widens with the panel: the inline-end padding holds the stack in
     the leftmost 72px exactly where it was. The width rides the same token as the
     lego's own slide, so strip and rail travel as one. */
  .firma2-app-frame[data-nav-peek] :global(.esa-app-shell) {
    grid-template-columns: var(--sidenav-width-collapsed, 72px) minmax(0, 1fr);
  }
  .firma2-app-frame[data-nav-peek] :global(.esa-app-shell__nav) {
    z-index: calc(var(--z-header, 200) + 2);
    box-shadow: var(--elevation-3);
  }
  .firma2-app-frame[data-nav-peek] :global(.firma2-app-frame__account) {
    z-index: calc(var(--z-header, 200) + 3);
    justify-self: start;
    width: var(--sidenav-width-collapsed, 72px);
    transition:
      width var(--transition-base, 200ms ease),
      padding-inline-end var(--transition-base, 200ms ease);
  }
  .firma2-app-frame[data-nav-peek='open'] :global(.firma2-app-frame__account) {
    width: var(--firma2-peek-width, 280px);
    padding-inline-end: calc(var(--firma2-peek-width, 280px) - var(--sidenav-width-collapsed, 72px) + var(--spacing-200, 8px));
  }
  /* The width grip belongs to a rail that is open for real. */
  .firma2-app-frame[data-nav-peek] :global(.esa-app-shell > bcn-edge-handle) {
    display: none;
  }

  /* Omnibox icon: stop the placeholder from eating it.
     esa-app-shell lays the search trigger out as a flex row —
       [ svg ] gap [ .__search-label ] gap [ .__search-kbd ]
     — and assigns flex to only two of the three. The kbd is `flex: none`, the
     label is `flex: 1`, and the raw inline <svg> gets nothing, so it keeps the
     initial `flex-shrink: 1`. The label also carries `white-space: nowrap` with
     `min-width: auto`, so its automatic minimum size is the WHOLE placeholder
     string, which it can never give back.

     With a long placeholder that row is over-constrained, and the icon is the
     only item that can yield, so it absorbs the entire deficit. Measured on this
     page: content box 314px, label floor 272.23px, kbd 18px, gaps 16px — leaving
     the icon 7.77px. It collapses to the SAME 7.77px whatever width it is given
     (a bigger icon just makes the deficit bigger by exactly as much), which is
     why sizing it alone does nothing at all.

     So both rules are load-bearing: `flex: none` takes the icon out of the
     shrink pool, and `min-width: 0` lets the label ellipsize — its intended
     behaviour, since it already asks for `text-overflow: ellipsis` it can never
     reach. Deliberately NO size override: at its native 16px the icon draws a
     13px glyph against a 10px text cap, which is right. It only ever looked
     undersized because it was being crushed, not because 16px is wrong.

     TEMPORARY: filed on the hub as esassoc/ecology#27 — every spoke with a
     placeholder longer than its omnibox inherits this. Delete once that ships. */
  .firma2-app-frame :global(.esa-app-shell__search > svg) {
    flex: none;
  }
  .firma2-app-frame :global(.esa-app-shell__search-label) {
    min-width: 0;
  }

  /* THE OMNIBOX IS A RAIL ROW NOW, so it takes the rail's width instead of the
     bar's. The shell sizes it `clamp(180px, 30vw, 340px)` — a rule written for a
     control floating in a full-width bar, where the viewport is the only thing
     there is to measure against. In a 280px rail that clamp resolves to 340px at
     any window wider than 1133px and the button hangs out past the rail's edge.
     100% hands the width back to the column, which is the rail's own token
     (--sidenav-width) and follows it down to 72px on collapse with nothing to
     keep in sync.

     The `::slotted([slot='header'])` rules the rail applies to header content —
     `display: block`, its own padding — do NOT reach this button, and that is
     the shadow-DOM cascade rather than luck: for a slotted element the outer
     tree's declarations beat the inner tree's ::slotted rules, so the shell's
     own display/padding/height hold. Verified rendered: 34px tall, flex row
     intact, in both rail states. */
  .firma2-app-frame :global(.esa-app-shell__search) {
    width: 100%;
  }

  /* ---- SETTINGS PAGES START LOWER ----
     A record page's title sits one gutter under the top bar because the record
     is dense. A settings page is short and read top-down, and the title hugging
     the bar read as cramped, so it takes one more step of air: 48px bar + 24px
     gutter + this 16px = the title at 88px from the window top. */
  .firma2-app-frame[data-nav='workspace-settings'] :global(.firma2-page-header) {
    margin-block-start: var(--spacing-400, 1rem);
  }

  /* ---- THE WORKSPACE MENU ----
     The companion script swaps the shell's brand <a> for a <button> inside an
     esa-dropdown-menu (see mountWorkspaceMenu). The shell's own brand rules
     still apply — the button carries the same class and scope attribute — so
     these lines only undo the UA button chrome and stretch it to the rail. */
  /* The rail's `::slotted([slot='header'])` gives header content its own
     padding and `overflow: hidden`. The anchor escaped both by carrying the
     shell's brand rules; the menu host is now the slotted element, so it has to
     undo them itself — the padding would double the brand's, and the clip would
     cut the panel off at the rail head. Outer-tree declarations beat ::slotted.
     The z-index lifts the open panel over the search and nav rows below it. */
  .firma2-app-frame :global(.firma2-app-frame__workspace) {
    display: block;
    padding: 0;
    overflow: visible;
    position: relative;
    z-index: var(--z-dropdown, 50);
  }
  .firma2-app-frame :global(button.esa-app-shell__brand) {
    width: 100%;
    border: 0;
    background: transparent;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  .firma2-app-frame :global(button.esa-app-shell__brand[aria-expanded='true']) {
    background: var(--app-shell-brand-bg-hover, color-mix(in srgb, currentColor 8%, transparent));
  }
  .firma2-app-frame :global(.firma2-app-frame__workspace-chevron) {
    flex: none;
    margin-inline-start: auto;
    color: var(--color-content-subtle, #646464);
  }
  .firma2-app-frame:has(esa-sidebar-nav[collapsed]) :global(.firma2-app-frame__workspace-chevron) {
    display: none;
  }
</style>
