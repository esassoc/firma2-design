---
// The setup layer. Setup is a mode that sits on top of the app rather than a
// section inside it: no sidebar, no search, no nav for records that do not
// exist yet. One thin bar names the mode and the tenant and offers the way
// out, then a centred column holds the page. Every setup page (the hub, the
// start steps, each journey) renders through this layout, so leaving setup is
// always the same act: the bar's "Exit setup" link.
//
// bcn-lego-checked: esa-app-shell is the app chrome this layer deliberately
// removes; esa-app-bar is the bar; the centred column is the `.center`
// primitive with its width knob. The only styling here is the frame that
// stacks bar over column, which no lego owns.
import BaseLayout from './BaseLayout.astro';
import EsaAppBar from '@esa/ecology/esa-app-bar.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { withBase } from '../lib/base';
import { tenantOrganization } from '../data/firma2-setup';

interface Props {
  title: string;
  /** Column width ceiling. `narrow` for one-question steps, `wide` for the hub and journeys. */
  width?: 'narrow' | 'wide';
}

const { title, width = 'wide' } = Astro.props;
---
<BaseLayout title={title}>
  <div class="firma2-setup-layer">
    <div class="firma2-setup-layer__bar">
      <EsaAppBar as="header" tone="surface" ariaLabel="Setup">
      <span slot="start" class="typography-label-md-strong">Setup</span>
      <span class="typography-label-md">{tenantOrganization.name}</span>
      <EsaButton slot="end" variant="ghost" size="sm" href={withBase('/prototypes/projects')}>Exit setup</EsaButton>
      </EsaAppBar>
    </div>
    <main class={`center firma2-setup-layer__column firma2-setup-layer__column--${width}`}>
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .firma2-setup-layer {
    min-block-size: 100dvh;
    background: var(--color-background-default);
  }
  /* The bar stays put while a long journey scrolls, so the way out never leaves the screen. */
  .firma2-setup-layer__bar {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
  }
  .firma2-setup-layer__column {
    padding-block: var(--spacing-800) var(--spacing-1000);
    padding-inline: var(--spacing-600);
  }
  .firma2-setup-layer__column--wide { --center-max: 64rem; }
  .firma2-setup-layer__column--narrow { --center-max: 40rem; }
</style>
