---
// PublicLayout — the frame of every public page: the tenant's header, the
// page, the footer. The public pair of AppLayout, and nothing like it: no
// rail, no top bar, no sheet — a reader with no account gets a document.
//
// The footer sits at the bottom of the window on a short page (the
// not-public-yet notice, a not-built-yet destination) and under the content on
// a long one.
//
// bcn-lego-checked: the frame is a three-row column — header and footer are
// firma2-public-header / firma2-public-footer (esa-app-bar inside); the one
// class here pins the footer to the window's foot, which no layout primitive
// does (`.stack` has no grow slot).
import BaseLayout from './BaseLayout.astro';
import Firma2PublicHeader from '../components/public/firma2-public-header.astro';
import Firma2PublicFooter from '../components/public/firma2-public-footer.astro';
import { publicSiteDefaults } from '../data/firma2-public-site';
import type { PublicNavKey } from '../data/firma2-public-site';

interface Props {
  title: string;
  /** The header destination this page belongs to. */
  current?: PublicNavKey;
  /** The signed-in reader's way to this page's record, first in the header's account menu. */
  workspaceDoor?: { label: string; href: string };
}

const { title, current, workspaceDoor } = Astro.props;
---
<BaseLayout title={title}>
  {/* THE SITE'S SETTINGS (Workspace settings › Public site). The defaults ride
      in the page as JSON; src/lib/public-site-apply.ts lays the published
      settings over them. The inline script holds the frame back for the one
      beat that takes, only when this browser has settings stored, so a
      rearranged home never shows its default order first — and lets go after
      two seconds whatever happens. The key is a DELIBERATE DUPLICATE of
      PUBLIC_SITE_KEY: an inline script has no module graph. */}
  <script type="application/json" data-public-site-defaults set:html={JSON.stringify(publicSiteDefaults()).replace(/</g, '\\u003c')} />
  <script is:inline>
    try {
      if (localStorage.getItem('firma2:public-site:v1')) {
        document.documentElement.setAttribute('data-public-site-pending', '');
        setTimeout(function () { document.documentElement.removeAttribute('data-public-site-pending'); }, 2000);
      }
    } catch (e) {}
  </script>
  <div class="firma2-public-frame">
    <Firma2PublicHeader current={current} workspaceDoor={workspaceDoor} />
    <main class="firma2-public-frame__main">
      <slot />
    </main>
    <Firma2PublicFooter />
  </div>
</BaseLayout>

<style>
  .firma2-public-frame {
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
    background: var(--color-background-default);
    /* ONE GUTTER for the header, the page and the footer, so the tenant's
       name, the page's title and the contact line share a left edge at every
       width. Public pages read it with their own fallback. */
    --firma2-public-gutter: var(--spacing-600);
  }
  @media (max-width: 45rem) {
    .firma2-public-frame {
      --firma2-public-gutter: var(--spacing-400);
    }
  }
  .firma2-public-frame__main {
    flex: 1 0 auto;
  }
  /* `hidden` MEANS HIDDEN on a public page. The site's settings hide sections,
     results and links with the attribute, and a layout class (`.stack`,
     `.grid`) or a lego's own display rule would otherwise out-rank it. */
  :global(.firma2-public-frame [hidden]) {
    display: none !important;
  }
  :global(html[data-public-site-pending]) .firma2-public-frame {
    visibility: hidden;
  }
</style>

<script>
  import { applyPublicSite } from '../lib/public-site-apply';
  applyPublicSite();
</script>
