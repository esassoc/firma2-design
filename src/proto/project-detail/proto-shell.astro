---
// PROTOTYPE — /proto/project-detail. Throwaway; nothing in production imports
// src/proto/project-detail/. Deleted once a direction is picked (emil-prototype
// Phase 7).
//
// The record page's frame, unchanged from src/pages/prototypes/projects/
// [project].astro — record bar, pinned rail, sticky header — with the main
// column's BODY handed to a slot, so every variant is judged against the same
// rail and header and differs only in how the document is arranged.
//
// bcn-lego-checked: prototype harness — copies the real record page's spine verbatim; the only addition is a keydown forwarder so the parent picker hears 1–4 / arrows from inside the iframe
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2RecordRail from '../../components/shared/firma2-record-rail.astro';
import Firma2ProjectRail from '../../components/projects/firma2-project-rail.astro';
import Firma2RailModes from '../../components/shared/firma2-rail-modes.astro';
import Firma2RecordBar from '../../components/shared/firma2-record-bar.astro';
import Firma2ProjectActions from '../../components/projects/firma2-project-actions.astro';
import Firma2RecordMode from '../../components/shared/firma2-record-mode.astro';
import Firma2ProjectEditAccess from '../../components/projects/firma2-project-edit-access.astro';
import Firma2ProjectPublishState from '../../components/projects/firma2-project-publish-state.astro';
import Firma2ProjectGisStatus from '../../components/gis/firma2-project-gis-status.astro';
import { reviewHref } from '../../data/firma2-publishing';
import { projectSlug } from '../../data/firma2-projects';
import type { ProjectDetail } from '../../data/firma2-project-detail';
import { withBase } from '../../lib/base';
import EsaContainer from '@esa/ecology/esa-container.astro';
import ProtoKeyForward from './proto-key-forward.astro';

interface Props {
  detail: ProjectDetail;
  /** Main-column cap. The current page uses 60rem. */
  maxWidth?: string;
  /** false: no rail and no rail toggles — the body carries the properties itself. */
  rail?: boolean;
}

const { detail, maxWidth = '60rem', rail = true } = Astro.props;
const project = detail.project;
---
{rail && <Firma2RecordBar>
  <Firma2RailModes
    slot="end"
    rail="firma2-record-rail"
    storageKey="project-rail"
    modes={[
      { key: 'details', label: 'Details', icon: 'panel-right' },
      { key: 'map', label: 'Map', icon: 'map' },
    ]}
  />
</Firma2RecordBar>}
<div
  class={rail ? 'sidebar' : undefined}
  data-side="end"
  style="--sidebar-width: 25rem; --sidebar-content-min: min(40rem, 100%)"
>
  {rail && <Firma2RecordRail label="project details" external>
    <slot name="rail-top" />
    <Firma2ProjectRail detail={detail} />
  </Firma2RecordRail>}
  <div>
    <EsaContainer maxWidth={maxWidth}>
      <div class="stack" data-gap="xl">
        <Firma2PageHeader
          title={project.projectName}
          editableTitle={{ field: 'projectName', label: 'Project name' }}
          crumbs={[
            { label: 'Projects', href: withBase('/prototypes/projects'), aliasable: true },
            { label: project.projectName },
          ]}
        >
          <Firma2RecordMode slot="actions" noun="Project" />
          <Firma2ProjectEditAccess slot="actions" project={project.projectName} leadOrganization={project.leadOrganization} />
          <Firma2ProjectPublishState slot="status" slug={projectSlug(project)} publishing={detail.publishing} />
          <Firma2ProjectActions
            slot="toolbar"
            audit={detail.audit}
            reviewHref={detail.publishing.changes.length ? withBase(reviewHref(project)) : undefined}
          />
        </Firma2PageHeader>
        <div class="stack" data-gap="xl">
          <Firma2ProjectGisStatus project={project} />
          <slot />
        </div>
      </div>
    </EsaContainer>
  </div>
</div>

<ProtoKeyForward />
