---
// PROTOTYPE variant 4 — Briefing. Axis: SUMMARY FIRST, THEN AN UNBOXED DOCUMENT.
// The first screen is a band of answers — a photo tile beside progress, spend
// and the next milestone — so a reader gets the verdict without reading a
// table. Below it the sections lose their card boxes and become one document
// separated by hairlines (the "messy" read of the current page is mostly
// box-after-box), and money reads as one section: expenditures then funding.
// The photos keep a full grid near the end, but the band has already shown one.
//
// bcn-lego-checked: prototype-only — strips esa-card's border and padding inside this body only (esa-card has no padding hook; flagged as a /request-lego candidate if this direction wins)
import Firma2ProjectFacts from '../../components/projects/firma2-project-facts.astro';
import Firma2ProjectDescription from '../../components/projects/firma2-project-description.astro';
import Firma2ProjectMeasures from '../../components/projects/firma2-project-measures.astro';
import Firma2ProjectExpenditures from '../../components/projects/firma2-project-expenditures.astro';
import Firma2ProjectFunding from '../../components/projects/firma2-project-funding.astro';
import Firma2ProjectTimeline from '../../components/projects/firma2-project-timeline.astro';
import Firma2ProjectGallery from '../../components/projects/firma2-project-gallery.astro';
import Firma2ProjectComments from '../../components/projects/firma2-project-comments.astro';
import ProtoBriefingSummary from './proto-briefing-summary.astro';
import { projectSlug } from '../../data/firma2-projects';
import type { ProjectDetail } from '../../data/firma2-project-detail';

interface Props { detail: ProjectDetail }
const { detail } = Astro.props;
const slug = projectSlug(detail.project);
---
<Firma2ProjectFacts detail={detail} layout="strip" />
<ProtoBriefingSummary detail={detail} />
<div class="proto-doc">
  <Firma2ProjectDescription description={detail.projectDescription} />
  <Firma2ProjectMeasures measures={detail.measures} projectSlug={slug} />
  <div class="proto-doc__pair">
    <Firma2ProjectExpenditures
      expenditures={detail.expenditures}
      estimatedTotalCost={detail.project.estimatedTotalCost}
      estimatedAnnualOperatingCost={detail.project.estimatedAnnualOperatingCost}
      projectSlug={slug}
    />
    <Firma2ProjectFunding funding={detail.funding} estimatedTotalCost={detail.project.estimatedTotalCost} />
  </div>
  <Firma2ProjectTimeline milestones={detail.milestones} />
  <Firma2ProjectGallery photos={detail.photos} />
  <Firma2ProjectComments comments={detail.comments} />
</div>

<style>
  .proto-doc {
    display: flex;
    flex-direction: column;
  }
  .proto-doc > :global(*),
  .proto-doc__pair {
    padding-block: var(--spacing-600, 2rem);
    border-block-start: 1px solid var(--color-border-default-subtle, rgb(0 0 0 / 0.08));
  }
  .proto-doc > :global(*:first-child) { border-block-start: 0; padding-block-start: var(--spacing-300, 0.75rem); }
  .proto-doc__pair { display: flex; flex-direction: column; gap: var(--spacing-600, 2rem); }
  .proto-doc__pair > :global(*) { padding: 0; border: 0; }

  /* Unbox the cards: same lego, no frame. The body keeps its own rhythm. */
  .proto-doc :global(.esa-card) {
    --_card-padding: 0;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }
  .proto-doc :global(.esa-card__header) { padding-block-start: 0; }
</style>
