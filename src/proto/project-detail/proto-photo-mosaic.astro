---
// PROTOTYPE — a photo mosaic for the top of the record: one lead frame and up
// to two (or four) companions, the last one carrying "+N" when the record has
// more. Every tile opens the gallery's own lightbox at that photo: the tile
// carries data-lightbox-open, which firma2-project-gallery's script binds on
// load, so the viewer, its carousel and its keys are the real ones.
//
// bcn-lego-checked: prototype-only — no esa- lego renders an image mosaic; the lightbox is firma2-project-gallery's esa-dialog, reused, not rebuilt
import type { ProjectPhoto } from '../../data/firma2-project-detail';
import { photoSrc } from '../../lib/project-photos';

interface Props {
  photos: ProjectPhoto[];
  /** `wide`: lead left at 2/3, companions stacked right. `stack`: lead on top, a row of thumbs under it. `tile`: lead only, fills its box. */
  layout?: 'wide' | 'stack' | 'tile';
  /** How many companions to show before collapsing into "+N". */
  companions?: number;
}

const { photos, layout = 'wide', companions = 2 } = Astro.props;
const lead = photos[0];
const rest = layout === 'tile' ? [] : photos.slice(1, 1 + companions);
const more = photos.length - 1 - rest.length;
---
{lead && (
  <div class={`proto-mosaic proto-mosaic--${layout}`} data-count={rest.length} style={`--proto-thumbs: ${Math.max(rest.length, 1)}`}>
    <button class="proto-mosaic__tile proto-mosaic__tile--lead" type="button" data-lightbox-open="0" aria-label={`View photo: ${lead.caption}`}>
      <img src={photoSrc(lead, 1280, 720, 70)} alt="" width="1280" height="720" decoding="async" />
      {layout === 'tile' && photos.length > 1 && (
        <span class="proto-mosaic__more typography-label-md-strong">{photos.length} photos</span>
      )}
      {layout === 'wide' && rest.length === 0 && (
        <span class="proto-mosaic__caption typography-body-sm">{lead.caption} · {lead.date}</span>
      )}
    </button>
    {rest.map((photo, i) => {
      const last = i === rest.length - 1 && more > 0;
      return (
        <button
          class="proto-mosaic__tile"
          type="button"
          data-lightbox-open={String(i + 1)}
          aria-label={last ? `View all ${photos.length} photos` : `View photo: ${photo.caption}`}
        >
          <img src={photoSrc(photo, 640, 480)} alt="" width="640" height="480" loading="lazy" decoding="async" />
          {last && <span class="proto-mosaic__more typography-label-md-strong">+{more + 1}</span>}
        </button>
      );
    })}
  </div>
)}

<style>
  .proto-mosaic {
    display: grid;
    gap: var(--spacing-200, 0.5rem);
  }

  /* wide: lead spans every companion row; companions stack in a third. */
  .proto-mosaic--wide {
    grid-template-columns: 2fr 1fr;
    grid-auto-rows: 1fr;
    aspect-ratio: 21 / 9;
  }
  .proto-mosaic--wide[data-count='0'] { grid-template-columns: 1fr; }
  .proto-mosaic--wide[data-count='1'] .proto-mosaic__tile--lead { grid-row: span 1; }
  .proto-mosaic--wide[data-count='2'] .proto-mosaic__tile--lead { grid-row: span 2; }

  /* stack: lead on top at 4:3, thumbs in one row under it. */
  .proto-mosaic--stack {
    grid-template-columns: repeat(var(--proto-thumbs, 4), 1fr);
  }
  .proto-mosaic--stack .proto-mosaic__tile--lead {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 3;
  }
  .proto-mosaic--stack .proto-mosaic__tile:not(.proto-mosaic__tile--lead) { aspect-ratio: 1; }

  .proto-mosaic--tile { block-size: 100%; }
  .proto-mosaic--tile .proto-mosaic__tile--lead { min-block-size: 14rem; }

  .proto-mosaic__tile {
    position: relative;
    display: block;
    min-block-size: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    background: var(--color-background-elevation-sunken, #f4f5f4);
    cursor: zoom-in;
  }
  .proto-mosaic__tile:focus-visible {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, currentColor);
    outline-offset: var(--focus-ring-offset, 2px);
  }

  .proto-mosaic__tile img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    outline: 1px solid rgb(0 0 0 / 0.1);
    outline-offset: -1px;
    border-radius: inherit;
    transition: transform 300ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .proto-mosaic__tile:hover img { transform: scale(1.02); }
  }
  @media (prefers-reduced-motion: reduce) {
    .proto-mosaic__tile img { transition: none; }
  }

  /* "+N" — a scrim over the last companion, the count centred on it. */
  .proto-mosaic__more {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .proto-mosaic--tile .proto-mosaic__more {
    inset: auto var(--spacing-300, 0.75rem) var(--spacing-300, 0.75rem) auto;
    padding: var(--spacing-100, 0.25rem) var(--spacing-300, 0.75rem);
    border-radius: var(--radius-full, 999px);
    background: rgb(0 0 0 / 0.6);
  }

  .proto-mosaic__caption {
    position: absolute;
    inset: auto var(--spacing-300, 0.75rem) var(--spacing-300, 0.75rem) auto;
    padding: var(--spacing-100, 0.25rem) var(--spacing-300, 0.75rem);
    border-radius: var(--radius-full, 999px);
    background: rgb(0 0 0 / 0.6);
    color: #fff;
  }

  @media (max-width: 45rem) {
    .proto-mosaic--wide { aspect-ratio: auto; grid-template-columns: 1fr 1fr; grid-auto-rows: auto; }
    .proto-mosaic--wide .proto-mosaic__tile--lead { grid-column: 1 / -1; grid-row: auto; aspect-ratio: 16 / 9; }
    .proto-mosaic--wide .proto-mosaic__tile:not(.proto-mosaic__tile--lead) { aspect-ratio: 4 / 3; }
  }
</style>
