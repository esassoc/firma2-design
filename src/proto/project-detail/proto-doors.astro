---
// PROTOTYPE — wires the task strips' buttons to the page's existing doors.
// [data-proto-click="<selector>"] clicks the control that selector names (its
// inner native button when it is an esa-button wrapper); [data-proto-scroll=
// "<key>"] brings #sec-<key> into view and focuses it. No workflow is copied.
---
<script>
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-proto-click], [data-proto-scroll]');
    if (!t) return;
    const sel = t.getAttribute('data-proto-click');
    if (sel) {
      const host = document.querySelector<HTMLElement>(sel);
      const target = host?.querySelector<HTMLElement>('button') ?? host;
      target?.scrollIntoView({ block: 'center' });
      target?.click();
      return;
    }
    const key = t.getAttribute('data-proto-scroll');
    const sec = key ? document.getElementById(`sec-${key}`) : null;
    if (sec) {
      e.preventDefault();
      sec.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      sec.focus({ preventScroll: true });
    }
  });
</script>
<style is:global>
  [id^='sec-'] { scroll-margin-block-start: 6rem; }
  [id^='sec-']:focus { outline: none; }
</style>
