---
// PROTOTYPE variant 3 — Overview + tabs. Axis: NAVIGATION — a short page.
// The first screen is an overview: the facts strip, then the description and
// a photo stack side by side (prose left, the ground right). Everything
// tracked moves under four tabs — Progress (measures + milestones), Money
// (expenditures + funding), Photos, Comments — so the page ends one screen
// down and every section is one click from the top instead of a scroll away.
//
// bcn-lego-checked: prototype-only — the overview split is the .switcher primitive; tabs are esa-tab-layout; the one bespoke rule is the description/photo column ratio
import Firma2ProjectFacts from '../../components/projects/firma2-project-facts.astro';
import Firma2ProjectDescription from '../../components/projects/firma2-project-description.astro';
import Firma2ProjectMeasures from '../../components/projects/firma2-project-measures.astro';
import Firma2ProjectExpenditures from '../../components/projects/firma2-project-expenditures.astro';
import Firma2ProjectFunding from '../../components/projects/firma2-project-funding.astro';
import Firma2ProjectTimeline from '../../components/projects/firma2-project-timeline.astro';
import Firma2ProjectGallery from '../../components/projects/firma2-project-gallery.astro';
import Firma2ProjectComments from '../../components/projects/firma2-project-comments.astro';
import ProtoPhotoMosaic from './proto-photo-mosaic.astro';
import ProtoLightboxHost from './proto-lightbox-host.astro';
import { projectSlug } from '../../data/firma2-projects';
import type { ProjectDetail } from '../../data/firma2-project-detail';

interface Props { detail: ProjectDetail }
const { detail } = Astro.props;
const slug = projectSlug(detail.project);
const hasPhotos = detail.photos.length > 0;
const tabs = [
  { label: 'Progress' },
  { label: 'Money' },
  { label: 'Photos', badge: detail.photos.length || undefined },
  { label: 'Comments', badge: detail.comments.length || undefined },
];
---
<Firma2ProjectFacts detail={detail} layout="strip" />

<div class="proto-overview" data-photos={hasPhotos ? '' : undefined}>
  <div class="proto-overview__text">
    <Firma2ProjectDescription description={detail.projectDescription} />
  </div>
  {hasPhotos && (
    <div class="proto-overview__photos">
      <ProtoPhotoMosaic photos={detail.photos} layout="stack" companions={3} />
      <!-- The gallery under the Photos tab is unslotted (unrendered) while
           another tab is open, so its lightbox could not open from here; this
           host comes first in the DOM, so the gallery script binds to it. -->
      <ProtoLightboxHost photos={detail.photos} />
    </div>
  )}
</div>

<esa-tab-layout class="proto-tabs" tabs={JSON.stringify(tabs)} size="md" appearance="underline">
  <div slot="panel-0" class="stack" data-gap="xl">
    <Firma2ProjectMeasures measures={detail.measures} projectSlug={slug} />
    <Firma2ProjectTimeline milestones={detail.milestones} />
  </div>
  <div slot="panel-1" class="stack" data-gap="xl">
    <Firma2ProjectExpenditures
      expenditures={detail.expenditures}
      estimatedTotalCost={detail.project.estimatedTotalCost}
      estimatedAnnualOperatingCost={detail.project.estimatedAnnualOperatingCost}
      projectSlug={slug}
    />
    <Firma2ProjectFunding funding={detail.funding} estimatedTotalCost={detail.project.estimatedTotalCost} />
  </div>
  <div slot="panel-2">
    <Firma2ProjectGallery photos={detail.photos} />
  </div>
  <div slot="panel-3">
    <Firma2ProjectComments comments={detail.comments} />
  </div>
</esa-tab-layout>

<script>
  import '@esa/ecology/esa-tab-layout';
</script>

<style>
  .proto-overview {
    display: grid;
    gap: var(--spacing-600, 2rem);
    align-items: start;
  }
  .proto-overview[data-photos] {
    grid-template-columns: minmax(0, 3fr) minmax(16rem, 2fr);
  }
  @media (max-width: 64rem) {
    .proto-overview[data-photos] { grid-template-columns: 1fr; }
  }
  .proto-tabs :global([slot^='panel-']) {
    padding-block-start: var(--spacing-500, 1.5rem);
  }
</style>
