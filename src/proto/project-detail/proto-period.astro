---
// PROTOTYPE — the reporting period that is due, as one card: each measure's
// planned figure for that year against what was filed, the year's spend, and
// the milestones that fall in it. It is the report a sponsor is closing out,
// gathered from four sections into one place; the buttons are the sections'
// own doors (Report <year> opens the measures' report view on that period,
// Record spend the spend sheet).
//
// bcn-lego-checked: prototype-only — esa-card, esa-button, esa-badge, and the firma2-settings-table rules for the ruled table; the card layout is prototype CSS
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import '../../components/settings/firma2-settings-table.css';
import { duePeriod, missingReports, parseMonthYear, TODAY } from './proto-attention';
import { currencyFormatter } from '../../lib/format';
import type { ProjectDetail } from '../../data/firma2-project-detail';

interface Props { detail: ProjectDetail }
const { detail } = Astro.props;
const year = duePeriod(detail);
const num = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1 });
const missing = year !== null ? missingReports(detail, year).length : 0;
const spend = year !== null ? detail.expenditures.find((e) => e.year === year) : undefined;
const inYear = year !== null ? detail.milestones.filter((m) => m.date.endsWith(String(year)) || m.date.endsWith(String(year + 1))) : [];
const STATUS: Record<string, { label: string; variant: 'success' | 'warning' | 'secondary' | 'danger' }> = {
  complete: { label: 'Complete', variant: 'success' },
  current: { label: 'In progress', variant: 'warning' },
  upcoming: { label: 'Upcoming', variant: 'secondary' },
  halted: { label: 'Halted', variant: 'danger' },
};
---
{year === null ? (
  <EsaCard title="Nothing to report yet">
    <p class="typography-body-md proto-period__muted">The first reporting period closes at the end of {detail.project.implementationStartYear}.</p>
  </EsaCard>
) : (
  <EsaCard title={`${year} report`}>
    <div slot="actions" class="cluster" data-gap="sm">
      {missing > 0 && <EsaButton variant="primary" size="sm" data-proto-click="[data-pm-due-report]">Report {year}</EsaButton>}
      <EsaButton variant="secondary" size="sm" data-proto-click="[data-firma2-spend-record]">Record spend</EsaButton>
    </div>
    <div class="stack" data-gap="lg">
      <p class="typography-body-md">
        {missing ? `${detail.measures.length - missing} of ${detail.measures.length} measures reported` : `All ${detail.measures.length} measures reported`}
        {spend ? ` · ${currencyFormatter.format(spend.spent)} spent` : ''}
      </p>
      <div class="firma2-settings-table-scroll">
        <table class="firma2-settings-table proto-period__table">
          <thead>
            <tr><th scope="col">Measure</th><th scope="col">Planned</th><th scope="col">Reported</th></tr>
          </thead>
          <tbody>
            {detail.measures.map((m) => {
              const p = m.series.find((s) => s.year === year);
              return (
                <tr>
                  <th scope="row">{m.name}</th>
                  <td>{p?.planned !== undefined ? `${num(p.planned)} ${m.unit}` : '—'}</td>
                  <td>{p?.value === null || p === undefined ? <EsaBadge value="Not reported" variant="warning" size="sm" /> : `${num(p.value)} ${m.unit}`}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      {inYear.length > 0 && (
        <div class="stack" data-gap="sm">
          <h4 class="typography-label-md-strong proto-period__h">Milestones in {year}–{year + 1}</h4>
          <ul class="proto-period__ms" role="list">
            {inYear.map((m) => (
              <li class="repel" data-gap="sm">
                <span class="typography-body-md">{m.title}{' '}<span class="proto-period__muted">· {m.date}</span></span>
                {(() => {
                  const d = parseMonthYear(m.date);
                  const late = m.status !== 'complete' && m.status !== 'halted' && d !== null && d < TODAY;
                  return late
                    ? <EsaBadge value="Past due" variant="danger" size="sm" />
                    : <EsaBadge value={STATUS[m.status].label} variant={STATUS[m.status].variant} size="sm" />;
                })()}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </EsaCard>
)}

<style>
  .proto-period__table td, .proto-period__table th[scope='col']:not(:first-child) { text-align: end; font-variant-numeric: tabular-nums; }
  .proto-period__muted { color: var(--color-content-default-secondary, #60655f); margin: 0; }
  .proto-period__h { margin: 0; }
  .proto-period__ms { display: grid; gap: var(--spacing-200, 0.5rem); margin: 0; padding: 0; list-style: none; }
</style>
