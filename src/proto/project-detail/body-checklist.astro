---
// PROTOTYPE internal round — Checklist. Axis: EVERY SECTION'S STATE, ALWAYS IN VIEW.
// Inbox lists only the gaps, once, at the top. This keeps the whole record's
// status pinned at the head of the rail — one row per section, a derived state
// beside each (2 missing for 2025, Past due, Fully funded, 3 unpublished) —
// and every row jumps to its section. The main column is the shipping page;
// what changes is that the reader always knows what is left and where it is.
import Firma2ProjectFacts from '../../components/projects/firma2-project-facts.astro';
import ProtoSections from './proto-sections.astro';
import ProtoDoors from './proto-doors.astro';
import type { ProjectDetail } from '../../data/firma2-project-detail';

interface Props { detail: ProjectDetail }
const { detail } = Astro.props;
---
<Firma2ProjectFacts detail={detail} layout="strip" />
<ProtoSections detail={detail} />
<ProtoDoors />
