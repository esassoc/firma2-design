---
// PROTOTYPE riff B — Unfold. Axis: SUMMARY TILES THAT OPEN INTO THE SECTION.
// The page is one screen of bento: each tile answers its question in a line or
// two (how far along, how much spent, what's next, where, who said what). Open
// a tile and it takes the full width and becomes the real section — the
// measures table, the spend chart and funding, the timeline, the full map —
// in place, with the rest of the bento reflowing around it. One open at a
// time; Close (or Escape) folds it back. No rail: Details is a tile.
//
// bcn-lego-checked: prototype-only — tiles are esa-card, controls esa-button, bars esa-progress-bar; the open/close wiring and the 12-column placement are prototype code. Promoting this would want a bento primitive and an "expandable tile" lego (/request-lego)
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaProgressBar from '@esa/ecology/esa-progress-bar.astro';
import Firma2ProjectFacts from '../../components/projects/firma2-project-facts.astro';
import Firma2ProjectContacts from '../../components/projects/firma2-project-contacts.astro';
import Firma2WorkAreas from '../../components/projects/firma2-work-areas.astro';
import Firma2ProjectDescription from '../../components/projects/firma2-project-description.astro';
import Firma2ProjectMeasures from '../../components/projects/firma2-project-measures.astro';
import Firma2ProjectExpenditures from '../../components/projects/firma2-project-expenditures.astro';
import Firma2ProjectFunding from '../../components/projects/firma2-project-funding.astro';
import Firma2ProjectTimeline from '../../components/projects/firma2-project-timeline.astro';
import Firma2ProjectGallery from '../../components/projects/firma2-project-gallery.astro';
import Firma2ProjectComments from '../../components/projects/firma2-project-comments.astro';
import ProtoPhotoMosaic from './proto-photo-mosaic.astro';
import ProtoLightboxHost from './proto-lightbox-host.astro';
import { projectSlug } from '../../data/firma2-projects';
import type { ProjectDetail } from '../../data/firma2-project-detail';

interface Props { detail: ProjectDetail }
const { detail } = Astro.props;
const slug = projectSlug(detail.project);
const p = detail.project;

const pct = (part: number, whole: number) => (whole > 0 ? Math.min(100, Math.round((part / whole) * 100)) : 0);
const num = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1 });
const usd = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

const shownMeasures = detail.measures.slice(0, 3);
const spent = detail.expenditures.filter((y) => y.status !== 'upcoming').reduce((s, y) => s + y.spent, 0);
const done = detail.milestones.filter((m) => m.status === 'complete').length;
const next = detail.milestones.find((m) => m.status === 'current') ?? detail.milestones.find((m) => m.status === 'upcoming');
const latest = detail.comments[0];
const hasPhotos = detail.photos.length > 0;
---
<div class="proto-unfold" data-unfold>
  {hasPhotos && (
    <div class="proto-unfold__cell proto-unfold__cell--photos">
      <ProtoPhotoMosaic photos={detail.photos} layout="wide" companions={2} />
      <ProtoLightboxHost photos={detail.photos} />
    </div>
  )}

  <div class="proto-unfold__cell proto-unfold__cell--side" data-tile="details">
    <div class="proto-unfold__summary">
      <EsaCard title="Details">
        <EsaButton slot="actions" variant="chrome" size="sm" iconOnly icon="maximize" label="Open details" data-unfold-open />
        <Firma2ProjectFacts detail={detail} layout="strip" />
      </EsaCard>
    </div>
    <div class="proto-unfold__full proto-unfold__flush">
      <div class="proto-unfold__bar"><EsaButton variant="chrome" size="sm" icon="x" data-unfold-close>Close</EsaButton></div>
      <div class="proto-unfold__pair">
        <EsaCard><Firma2ProjectFacts detail={detail} showDescription={false} /></EsaCard>
        <EsaCard><Firma2ProjectContacts contacts={detail.contacts} /></EsaCard>
      </div>
    </div>
  </div>

  <div class="proto-unfold__cell proto-unfold__cell--side" data-tile="progress">
    <div class="proto-unfold__summary">
      <EsaCard title="Progress">
        <EsaButton slot="actions" variant="chrome" size="sm" iconOnly icon="maximize" label="Open performance measures" data-unfold-open />
        {shownMeasures.length ? (
          <ul class="proto-unfold__list" role="list">
            {shownMeasures.map((m) => (
              <li class="stack" data-gap="xs">
                <span class="proto-unfold__row typography-body-sm">
                  <span class="proto-unfold__name">{m.name}</span>
                  <span class="proto-unfold__fig">{num(m.reported)} of {num(m.expected)} {m.unit}</span>
                </span>
                <EsaProgressBar value={pct(m.reported, m.expected)} size="xs" showValue={false} />
              </li>
            ))}
            {detail.measures.length > 3 && <li class="typography-meta proto-unfold__muted">{detail.measures.length - 3} more</li>}
          </ul>
        ) : <p class="typography-body-sm proto-unfold__muted">No measures yet</p>}
      </EsaCard>
    </div>
    <div class="proto-unfold__full">
      <div class="proto-unfold__bar"><EsaButton variant="chrome" size="sm" icon="x" data-unfold-close>Close</EsaButton></div>
      <Firma2ProjectMeasures measures={detail.measures} projectSlug={slug} />
    </div>
  </div>

  <div class="proto-unfold__cell proto-unfold__cell--wide">
    <EsaCard><Firma2ProjectDescription description={detail.projectDescription} /></EsaCard>
  </div>

  <div class="proto-unfold__cell proto-unfold__cell--side" data-tile="money">
    <div class="proto-unfold__summary">
      <EsaCard title="Money">
        <EsaButton slot="actions" variant="chrome" size="sm" iconOnly icon="maximize" label="Open expenditures and funding" data-unfold-open />
        <div class="stack" data-gap="sm">
          <div class="stack" data-gap="xs">
            <span class="typography-title-strong proto-unfold__fig">{usd(spent)}</span>
            <span class="typography-body-sm proto-unfold__muted">spent of {usd(p.estimatedTotalCost)}</span>
            <EsaProgressBar value={pct(spent, p.estimatedTotalCost)} size="xs" showValue={false} />
          </div>
          <ul class="proto-unfold__list proto-unfold__list--tight" role="list">
            {detail.funding.map((f) => (
              <li class="proto-unfold__row typography-body-sm">
                <span class="proto-unfold__name">{f.organization}</span>
                <span class="proto-unfold__fig">{Math.round(f.share * 100)}%</span>
              </li>
            ))}
          </ul>
        </div>
      </EsaCard>
    </div>
    <div class="proto-unfold__full">
      <div class="proto-unfold__bar"><EsaButton variant="chrome" size="sm" icon="x" data-unfold-close>Close</EsaButton></div>
      <div class="stack" data-gap="xl">
        <Firma2ProjectExpenditures
          expenditures={detail.expenditures}
          estimatedTotalCost={p.estimatedTotalCost}
          estimatedAnnualOperatingCost={p.estimatedAnnualOperatingCost}
          projectSlug={slug}
        />
        <Firma2ProjectFunding funding={detail.funding} estimatedTotalCost={p.estimatedTotalCost} />
      </div>
    </div>
  </div>

  <div class="proto-unfold__cell proto-unfold__cell--third" data-tile="milestones">
    <div class="proto-unfold__summary">
      <EsaCard title="Milestones">
        <EsaButton slot="actions" variant="chrome" size="sm" iconOnly icon="maximize" label="Open milestones" data-unfold-open />
        <div class="stack" data-gap="sm">
          <span class="typography-body-sm proto-unfold__muted">{done} of {detail.milestones.length} complete</span>
          {next ? (
            <div class="stack" data-gap="2xs">
              <span class="typography-body-md">{next.title}</span>
              <span class="typography-body-sm proto-unfold__muted">Next · {next.date}</span>
            </div>
          ) : <span class="typography-body-md">All milestones complete</span>}
        </div>
      </EsaCard>
    </div>
    <div class="proto-unfold__full">
      <div class="proto-unfold__bar"><EsaButton variant="chrome" size="sm" icon="x" data-unfold-close>Close</EsaButton></div>
      <Firma2ProjectTimeline milestones={detail.milestones} />
    </div>
  </div>

  <div class="proto-unfold__cell proto-unfold__cell--third" data-tile="map">
    <div class="proto-unfold__summary">
      <EsaCard title="Work areas">
        <EsaButton slot="actions" variant="chrome" size="sm" iconOnly icon="maximize" label="Open work areas map" data-unfold-open />
        <div class="stack" data-gap="sm">
          <span class="typography-body-sm proto-unfold__muted">{detail.workAreas.length} {detail.workAreas.length === 1 ? 'area' : 'areas'} · {p.county} County</span>
          <ul class="proto-unfold__list proto-unfold__list--tight" role="list">
            {detail.workAreas.slice(0, 3).map((w) => <li class="typography-body-sm proto-unfold__name">{w.label}</li>)}
          </ul>
        </div>
      </EsaCard>
    </div>
    <div class="proto-unfold__full">
      <div class="proto-unfold__bar"><EsaButton variant="chrome" size="sm" icon="x" data-unfold-close>Close</EsaButton></div>
      <Firma2WorkAreas project={p} variant="section" />
    </div>
  </div>

  <div class="proto-unfold__cell proto-unfold__cell--third" data-tile="comments">
    <div class="proto-unfold__summary">
      <EsaCard title={`Comments${detail.comments.length ? ` (${detail.comments.length})` : ''}`}>
        <EsaButton slot="actions" variant="chrome" size="sm" iconOnly icon="maximize" label="Open comments" data-unfold-open />
        {latest ? (
          <div class="stack" data-gap="2xs">
            <span class="typography-body-sm proto-unfold__clamp">{latest.body}</span>
            <span class="typography-meta proto-unfold__muted">{latest.author.name} · {latest.date}</span>
          </div>
        ) : <span class="typography-body-sm proto-unfold__muted">No comments yet</span>}
      </EsaCard>
    </div>
    <div class="proto-unfold__full">
      <div class="proto-unfold__bar"><EsaButton variant="chrome" size="sm" icon="x" data-unfold-close>Close</EsaButton></div>
      <Firma2ProjectComments comments={detail.comments} />
    </div>
  </div>

  {!hasPhotos && (
    <div class="proto-unfold__cell proto-unfold__cell--wide"><Firma2ProjectGallery photos={detail.photos} /></div>
  )}
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-unfold]');
  if (root) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Resolves once the DOM change has applied (a view transition runs its
    // callback asynchronously, so focus has to wait for it).
    const run = (change: () => void): Promise<unknown> => {
      const vt = (document as Document & { startViewTransition?: (cb: () => void) => { updateCallbackDone: Promise<unknown> } }).startViewTransition;
      if (vt && !reduce.matches) return vt.call(document, change).updateCallbackDone;
      change();
      return Promise.resolve();
    };
    const btn = (cell: HTMLElement, attr: string) => {
      const host = cell.querySelector<HTMLElement>(`[${attr}]`);
      return host?.querySelector<HTMLElement>('button') ?? host;
    };
    const close = (cell: HTMLElement, refocus = true) => {
      run(() => cell.removeAttribute('data-open')).then(() => {
        if (refocus) btn(cell, 'data-unfold-open')?.focus();
      });
    };
    const open = (cell: HTMLElement) => {
      const current = root.querySelector<HTMLElement>('[data-tile][data-open]');
      run(() => {
        current?.removeAttribute('data-open');
        cell.setAttribute('data-open', '');
      }).then(() => {
        // Maps sized while display:none need a nudge once they have a box.
        window.dispatchEvent(new Event('resize'));
        cell.scrollIntoView({ block: 'start', behavior: reduce.matches ? 'auto' : 'smooth' });
        btn(cell, 'data-unfold-close')?.focus({ preventScroll: true });
      });
    };
    root.querySelectorAll<HTMLElement>('[data-tile]').forEach((cell) => {
      cell.querySelector('[data-unfold-open]')?.addEventListener('click', (e) => { e.stopPropagation(); open(cell); });
      cell.querySelector('[data-unfold-close]')?.addEventListener('click', () => close(cell));
      // The whole summary is a pointer target too; the button stays the keyboard one.
      cell.querySelector('.proto-unfold__summary')?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('button, a, input, [contenteditable], [role="button"]')) return;
        open(cell);
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const cell = root.querySelector<HTMLElement>('[data-tile][data-open]');
      if (cell && !(e.target as HTMLElement).closest('esa-dialog, input, textarea, [contenteditable]')) close(cell);
    });
  }
</script>

<style>
  .proto-unfold {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: row dense;
    gap: var(--spacing-400, 1rem);
  }
  .proto-unfold__cell { min-inline-size: 0; display: flex; flex-direction: column; }
  .proto-unfold__cell > :global(*),
  .proto-unfold__summary,
  .proto-unfold__summary > :global(*) { flex: 1 1 auto; }
  .proto-unfold__summary { display: flex; flex-direction: column; cursor: pointer; }

  .proto-unfold__cell--photos { grid-column: span 8; grid-row: span 2; }
  .proto-unfold__cell--photos :global(.proto-mosaic) { block-size: 100%; aspect-ratio: auto; min-block-size: 20rem; }
  .proto-unfold__cell--side { grid-column: span 4; }
  .proto-unfold__cell--wide { grid-column: span 8; }
  .proto-unfold__cell--third { grid-column: span 4; }

  [data-tile] { view-transition-name: var(--vt); }
  [data-tile='details'] { --vt: tile-details; }
  [data-tile='progress'] { --vt: tile-progress; }
  [data-tile='money'] { --vt: tile-money; }
  [data-tile='milestones'] { --vt: tile-milestones; }
  [data-tile='map'] { --vt: tile-map; }
  [data-tile='comments'] { --vt: tile-comments; }
  ::view-transition-group(*) { animation-duration: 260ms; animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1); }

  /* Closed: summary shows. Open: the cell spans the row and swaps to the section. */
  .proto-unfold__full { display: none; }
  [data-tile][data-open] { grid-column: 1 / -1; grid-row: auto; order: -1; }
  [data-tile][data-open] .proto-unfold__summary { display: none; }
  [data-tile][data-open] .proto-unfold__full { display: flex; flex-direction: column; gap: var(--spacing-300, 0.75rem); }
  .proto-unfold__bar { display: flex; justify-content: flex-end; }
  [data-tile] { scroll-margin-block-start: 6rem; }

  .proto-unfold__pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr)); gap: var(--spacing-400, 1rem); align-items: start; }
  .proto-unfold__flush :global(.esa-collapsible) { border: 0; border-radius: 0; background: transparent; }
  .proto-unfold__flush :global(.esa-collapsible__summary),
  .proto-unfold__flush :global(.esa-collapsible__body) { padding-inline: 0; }

  .proto-unfold__list { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--spacing-300, 0.75rem); margin: 0; padding: 0; list-style: none; }
  .proto-unfold__list--tight { gap: var(--spacing-150, 0.375rem); }
  .proto-unfold__row { display: flex; gap: var(--spacing-200, 0.5rem); justify-content: space-between; align-items: baseline; }
  .proto-unfold__name { flex: 1 1 0; min-inline-size: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .proto-unfold__fig { flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .proto-unfold__muted { color: var(--color-content-default-secondary, #60655f); margin: 0; }
  .proto-unfold__clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  @media (max-width: 64rem) {
    .proto-unfold__cell, .proto-unfold__cell--photos { grid-column: 1 / -1; grid-row: auto; }
  }
</style>
