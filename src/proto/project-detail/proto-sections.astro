---
// PROTOTYPE — the record page's sections in their shipping order, each wrapped
// in an addressable #sec-<key> so the task strips can send a reader to it.
// `order` lets a variant re-sequence them; anything not named is left out.
import Firma2ProjectDescription from '../../components/projects/firma2-project-description.astro';
import Firma2ProjectMeasures from '../../components/projects/firma2-project-measures.astro';
import Firma2ProjectExpenditures from '../../components/projects/firma2-project-expenditures.astro';
import Firma2ProjectFunding from '../../components/projects/firma2-project-funding.astro';
import Firma2ProjectTimeline from '../../components/projects/firma2-project-timeline.astro';
import Firma2ProjectGallery from '../../components/projects/firma2-project-gallery.astro';
import Firma2ProjectComments from '../../components/projects/firma2-project-comments.astro';
import { projectSlug } from '../../data/firma2-projects';
import type { ProjectDetail } from '../../data/firma2-project-detail';

export type SectionKey = 'description' | 'measures' | 'expenditures' | 'funding' | 'milestones' | 'photos' | 'comments';

interface Props {
  detail: ProjectDetail;
  order?: SectionKey[];
}
const { detail, order = ['description', 'measures', 'expenditures', 'funding', 'milestones', 'photos', 'comments'] } = Astro.props;
const slug = projectSlug(detail.project);
const p = detail.project;
---
{order.map((key) => (
  <div id={`sec-${key}`} tabindex="-1">
    {key === 'description' && <Firma2ProjectDescription description={detail.projectDescription} />}
    {key === 'measures' && <Firma2ProjectMeasures measures={detail.measures} projectSlug={slug} />}
    {key === 'expenditures' && (
      <Firma2ProjectExpenditures
        expenditures={detail.expenditures}
        estimatedTotalCost={p.estimatedTotalCost}
        estimatedAnnualOperatingCost={p.estimatedAnnualOperatingCost}
        projectSlug={slug}
      />
    )}
    {key === 'funding' && <Firma2ProjectFunding funding={detail.funding} estimatedTotalCost={p.estimatedTotalCost} />}
    {key === 'milestones' && <Firma2ProjectTimeline milestones={detail.milestones} />}
    {key === 'photos' && <Firma2ProjectGallery photos={detail.photos} />}
    {key === 'comments' && <Firma2ProjectComments comments={detail.comments} />}
  </div>
))}
