---
// PROTOTYPE — "Needs attention": what the record is asking of its editors, one
// row per gap, each with the button that fixes it. Built from attentionFor();
// every button is a door to a control already on the page (proto-doors).
// With nothing owed it shrinks to one quiet line rather than disappearing, so
// a reader can tell "all clear" from "this page has no such strip".
//
// bcn-lego-checked: prototype-only — esa-card, esa-button, esa-badge; the row list is the .repel primitive inside a <ul>
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import type { AttentionItem } from './proto-attention';

interface Props { items: AttentionItem[] }
const { items } = Astro.props;
const KIND: Record<AttentionItem['kind'], string> = {
  report: 'Report',
  spend: 'Spend',
  milestone: 'Milestone',
  publish: 'Publish',
  empty: 'Empty',
};
---
{items.length === 0 ? (
  <p class="proto-att__clear typography-body-md">Nothing needs attention on this record.</p>
) : (
  <EsaCard title={`Needs attention (${items.length})`}>
    <ul class="proto-att" role="list">
      {items.map((item, i) => (
        <li class="proto-att__row" data-primary={i === 0 ? '' : undefined}>
          <span class="proto-att__kind"><EsaBadge value={KIND[item.kind]} variant={item.weight < 3 ? 'warning' : 'secondary'} size="sm" /></span>
          <span class="proto-att__text typography-body-md">{item.text}</span>
          {item.href ? (
            <EsaButton variant="secondary" size="md" tag="a" href={item.href}>{item.action}</EsaButton>
          ) : (
            <EsaButton
              variant={i === 0 ? 'primary' : 'secondary'}
              size="md"
              data-proto-click={item.click}
              data-proto-scroll={item.scrollTo}
            >{item.action}</EsaButton>
          )}
        </li>
      ))}
    </ul>
  </EsaCard>
)}

<style>
  .proto-att { display: grid; margin: 0; padding: 0; list-style: none; }
  .proto-att__row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--spacing-400, 1rem);
    padding-block: var(--spacing-300, 0.75rem);
    border-block-start: 1px solid var(--color-border-default-subtle, rgb(0 0 0 / 0.08));
  }
  .proto-att__row:first-child { border-block-start: 0; padding-block-start: 0; }
  .proto-att__row:last-child { padding-block-end: 0; }
  .proto-att__text { min-inline-size: 0; }
  .proto-att__clear { margin: 0; color: var(--color-content-default-secondary, #60655f); }
  @media (max-width: 45rem) {
    .proto-att__row { grid-template-columns: minmax(0, 1fr); gap: var(--spacing-200, 0.5rem); }
  }
</style>
