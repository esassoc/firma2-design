---
// PROTOTYPE internal round — Inbox. Axis: WHAT IS ASKED OF ME, FIRST.
// The page answers the sponsor's question ("what is being asked of me, and is
// my record in good shape?") before anything else: a Needs attention list
// under the facts strip, one row per gap with the button that closes it —
// Report 2025 opens the measures' own report view, Record spend the spend
// sheet, Review changes the diff page. Below it the page is unchanged. When
// nothing is owed the list collapses to one quiet line.
import Firma2ProjectFacts from '../../components/projects/firma2-project-facts.astro';
import ProtoAttentionList from './proto-attention-list.astro';
import ProtoSections from './proto-sections.astro';
import ProtoDoors from './proto-doors.astro';
import { attentionFor } from './proto-attention';
import { reviewHref } from '../../data/firma2-publishing';
import { withBase } from '../../lib/base';
import type { ProjectDetail } from '../../data/firma2-project-detail';

interface Props { detail: ProjectDetail }
const { detail } = Astro.props;
const items = attentionFor(detail, withBase(reviewHref(detail.project)));
---
<Firma2ProjectFacts detail={detail} layout="strip" />
<ProtoAttentionList items={items} />
<ProtoSections detail={detail} />
<ProtoDoors />
