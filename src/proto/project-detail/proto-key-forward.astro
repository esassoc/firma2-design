---
// PROTOTYPE — forwards the picker's keys from inside a variant's iframe to the harness.
---
<script>
  // The picker lives in the parent page; keys pressed inside this frame would
  // never reach it. Forward the picker's keys, same filters as PICKER.md.
  document.addEventListener('keydown', (e) => {
    if (window.parent === window) return;
    const t = e.target as HTMLElement;
    if (/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (t.closest('esa-dialog, esa-tab-layout, [role="tablist"]')) return;
    if (/^[1-9]$/.test(e.key) || e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
      window.parent.postMessage({ protoKey: e.key }, '*');
    }
  });
</script>
