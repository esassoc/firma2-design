---
// PROTOTYPE — mounts firma2-project-gallery off-screen so its lightbox (an
// esa-dialog, which opens in the top layer and escapes this clip) is on the
// page for variants that show photos somewhere other than the gallery card.
// visibility:hidden takes the hidden tiles out of the tab order; the dialog
// opts back in.
//
// bcn-lego-checked: prototype-only host for the real gallery's lightbox; nothing new is drawn
import Firma2ProjectGallery from '../../components/projects/firma2-project-gallery.astro';
import type { ProjectPhoto } from '../../data/firma2-project-detail';

interface Props { photos: ProjectPhoto[] }
const { photos } = Astro.props;
---
<div class="proto-lightbox-host">
  <Firma2ProjectGallery photos={photos} readonly />
</div>

<style>
  .proto-lightbox-host {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    visibility: hidden;
  }
  .proto-lightbox-host :global(esa-dialog) { visibility: visible; }
</style>
