---
// PROTOTYPE — the Briefing variant's opening band: a photo tile and three
// answer tiles (progress, money, what's next), so the page's question — is
// this project doing what it said it would — is answered on one screen before
// the full tables. Every figure is derived from the same detail record the
// tables below read; nothing here is new data.
//
// bcn-lego-checked: prototype-only — tiles are esa-card (compact), bars are esa-progress-bar, layout is a two-column grid; no esa- lego is a bento band
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaProgressBar from '@esa/ecology/esa-progress-bar.astro';
import ProtoPhotoMosaic from './proto-photo-mosaic.astro';
import type { ProjectDetail } from '../../data/firma2-project-detail';

interface Props { detail: ProjectDetail }
const { detail } = Astro.props;

const pct = (part: number, whole: number) => (whole > 0 ? Math.min(100, Math.round((part / whole) * 100)) : 0);
const num = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1 });
const usd = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

const shown = detail.measures.slice(0, 3);
const hiddenMeasures = detail.measures.length - shown.length;

const spent = detail.expenditures.filter((y) => y.status !== 'upcoming').reduce((s, y) => s + y.spent, 0);
const total = detail.project.estimatedTotalCost;

const next =
  detail.milestones.find((m) => m.status === 'current') ??
  detail.milestones.find((m) => m.status === 'upcoming');
const last = [...detail.milestones].reverse().find((m) => m.status === 'complete');
const hasPhotos = detail.photos.length > 0;
---
<div class="proto-brief" data-photos={hasPhotos ? '' : undefined}>
  {hasPhotos && (
    <div class="proto-brief__photo">
      <ProtoPhotoMosaic photos={detail.photos} layout="tile" />
    </div>
  )}

  <EsaCard title="Progress" padding="compact">
    {shown.length ? (
      <ul class="proto-brief__list" role="list">
        {shown.map((m) => (
          <li class="stack" data-gap="xs">
            <span class="repel proto-brief__row typography-body-sm" data-gap="sm">
              <span class="proto-brief__name">{m.name}</span>
              <span class="proto-brief__fig">{num(m.reported)} of {num(m.expected)} {m.unit}</span>
            </span>
            <EsaProgressBar value={pct(m.reported, m.expected)} size="xs" showValue={false} />
          </li>
        ))}
        {hiddenMeasures > 0 && <li class="typography-meta proto-brief__muted">+{hiddenMeasures} more below</li>}
      </ul>
    ) : (
      <p class="typography-body-sm proto-brief__muted">No measures yet</p>
    )}
  </EsaCard>

  <EsaCard title="Spent" padding="compact">
    <div class="stack" data-gap="xs">
      <span class="proto-brief__big typography-title-strong">{usd(spent)}</span>
      <span class="typography-body-sm proto-brief__muted">of {usd(total)} · {detail.funding.length} funding {detail.funding.length === 1 ? 'source' : 'sources'}</span>
      <EsaProgressBar value={pct(spent, total)} size="xs" showValue={false} />
    </div>
  </EsaCard>

  <EsaCard title={next ? 'Next milestone' : 'Last milestone'} padding="compact">
    {(next ?? last) ? (
      <div class="stack" data-gap="xs">
        <span class="typography-body-md">{(next ?? last)!.title}</span>
        <span class="typography-body-sm proto-brief__muted">{(next ?? last)!.date}</span>
      </div>
    ) : (
      <p class="typography-body-sm proto-brief__muted">No milestones yet</p>
    )}
  </EsaCard>
</div>

<style>
  .proto-brief {
    display: grid;
    gap: var(--spacing-400, 1rem);
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
  }
  .proto-brief > :global(*) { min-inline-size: 0; }
  .proto-brief__row { flex-wrap: nowrap; }
  /* Photo on the left at two columns' width across both rows; the three
     answers stack beside it, progress on top because it is the question. */
  .proto-brief[data-photos] {
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
  }
  .proto-brief[data-photos] .proto-brief__photo { grid-row: span 2; }
  .proto-brief[data-photos] > :global(:nth-child(2)) { grid-column: span 2; }

  @media (max-width: 64rem) {
    .proto-brief, .proto-brief[data-photos] { grid-template-columns: 1fr 1fr; }
    .proto-brief[data-photos] .proto-brief__photo { grid-column: 1 / -1; grid-row: auto; }
    .proto-brief[data-photos] .proto-brief__photo :global(.proto-mosaic__tile--lead) { aspect-ratio: 16 / 9; }
  }
  @media (max-width: 45rem) {
    .proto-brief, .proto-brief[data-photos] { grid-template-columns: 1fr; }
    .proto-brief[data-photos] > :global(:nth-child(2)) { grid-column: auto; }
  }

  .proto-brief__photo { min-block-size: 0; }
  .proto-brief__photo :global(.proto-mosaic),
  .proto-brief__photo :global(.proto-mosaic__tile--lead) { block-size: 100%; }

  .proto-brief__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-300, 0.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .proto-brief__name { flex: 1 1 0; min-inline-size: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .proto-brief__fig { flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .proto-brief__big { font-variant-numeric: tabular-nums; }
  .proto-brief__muted { color: var(--color-content-default-secondary, #60655f); margin: 0; }
</style>
