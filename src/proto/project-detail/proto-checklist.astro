---
// PROTOTYPE — the record's status, section by section, pinned at the head of
// the rail so it stays in view however far down the page the reader is. Every
// row is a link to its section; the state beside it is derived from the record
// (proto-attention), never typed. Attention rows carry a warning badge, the
// rest a quiet one, so "what's left" reads in one glance down the column.
//
// bcn-lego-checked: prototype-only — rows are links with esa-badge values inside firma2-rail-section; no esa- lego is a status checklist
import Firma2RailSection from '../../components/shared/firma2-rail-section.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import { sectionStates } from './proto-attention';
import { reviewHref } from '../../data/firma2-publishing';
import { withBase } from '../../lib/base';
import { currencyFormatter } from '../../lib/format';
import type { ProjectDetail } from '../../data/firma2-project-detail';

interface Props { detail: ProjectDetail }
const { detail } = Astro.props;
const s = sectionStates(detail);
const funded = detail.funding.reduce((sum, f) => sum + f.amount, 0);
const gap = detail.project.estimatedTotalCost - funded;
const changes = detail.publishing.changes.length;

const rows = [
  { key: 'measures', name: 'Performance measures', ...s.measures },
  { key: 'expenditures', name: 'Expenditures', ...s.expenditures },
  { key: 'funding', name: 'Funding sources', ...(gap > 0 ? { tone: 'attention', text: `${currencyFormatter.format(gap)} short` } : { tone: 'quiet', text: 'Fully funded' }) },
  { key: 'milestones', name: 'Milestones', ...s.milestones },
  { key: 'photos', name: 'Photos', ...s.photos },
  { key: 'comments', name: 'Comments', ...s.comments },
] as { key: string; name: string; tone: 'attention' | 'quiet'; text: string; href?: string }[];
rows.push(
  changes
    ? { key: 'publish', name: 'Public page', tone: 'attention', text: `${changes} unpublished`, href: withBase(reviewHref(detail.project)) }
    : { key: 'publish', name: 'Public page', tone: 'quiet', text: 'Up to date' },
);
const open = rows.filter((r) => r.tone === 'attention').length;
---
<div class="proto-check">
  <Firma2RailSection title="Record status">
    <p class="typography-body-sm proto-check__sum">{open ? `${open} of ${rows.length} need attention` : 'Everything is up to date'}</p>
    <ul class="proto-check__list" role="list">
      {rows.map((r) => (
        <li>
          <a class="proto-check__row" href={r.href ?? `#sec-${r.key}`} data-proto-scroll={r.href ? undefined : r.key}>
            <span class="typography-body-md">{r.name}</span>
            <EsaBadge value={r.text} variant={r.tone === 'attention' ? 'warning' : 'secondary'} size="sm" />
          </a>
        </li>
      ))}
    </ul>
  </Firma2RailSection>
</div>

<style>
  .proto-check { margin-block-end: var(--spacing-700, 2.5rem); }
  .proto-check__sum { margin: 0 0 var(--spacing-300, 0.75rem); color: var(--color-content-default-secondary, #60655f); }
  .proto-check__list { display: grid; margin: 0; padding: 0; list-style: none; }
  .proto-check__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-300, 0.75rem);
    min-block-size: 2.5rem;
    padding-inline: var(--spacing-200, 0.5rem);
    margin-inline: calc(-1 * var(--spacing-200, 0.5rem));
    border-radius: var(--radius-sm, 4px);
    color: var(--color-content-default, #1d211c);
    text-decoration: none;
    transition: background-color 150ms ease-out;
  }
  @media (hover: hover) and (pointer: fine) {
    .proto-check__row:hover { background: var(--color-background-default-hover, rgb(0 0 0 / 0.04)); }
  }
  .proto-check__row:focus-visible {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, currentColor);
    outline-offset: var(--focus-ring-offset, 2px);
  }
</style>
