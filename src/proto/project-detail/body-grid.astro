---
// PROTOTYPE riff A — Grid. Axis: THE WHOLE RECORD IS ONE BENTO.
// No rail: the property sheet, the people and the map become tiles beside the
// sections they used to sit a column away from. Every tile is a real section
// (same components, same editing), in two columns of unequal width —
// wide tiles for the things you read (photos, description, measures, money),
// narrow ones for the things you set (facts, contacts, map). Nothing is a
// summary; nothing is hidden behind a click.
//
// bcn-lego-checked: prototype-only — tiles are esa-card (the sections already are); the grid placement and the flush-collapsible override inside the facts tile are prototype CSS; promoting this would need a bento primitive (/request-lego)
import EsaCard from '@esa/ecology/esa-card.astro';
import Firma2ProjectFacts from '../../components/projects/firma2-project-facts.astro';
import Firma2ProjectContacts from '../../components/projects/firma2-project-contacts.astro';
import Firma2WorkAreas from '../../components/projects/firma2-work-areas.astro';
import Firma2ProjectDescription from '../../components/projects/firma2-project-description.astro';
import Firma2ProjectMeasures from '../../components/projects/firma2-project-measures.astro';
import Firma2ProjectExpenditures from '../../components/projects/firma2-project-expenditures.astro';
import Firma2ProjectFunding from '../../components/projects/firma2-project-funding.astro';
import Firma2ProjectTimeline from '../../components/projects/firma2-project-timeline.astro';
import Firma2ProjectGallery from '../../components/projects/firma2-project-gallery.astro';
import Firma2ProjectComments from '../../components/projects/firma2-project-comments.astro';
import ProtoPhotoMosaic from './proto-photo-mosaic.astro';
import ProtoLightboxHost from './proto-lightbox-host.astro';
import { projectSlug } from '../../data/firma2-projects';
import type { ProjectDetail } from '../../data/firma2-project-detail';

interface Props { detail: ProjectDetail }
const { detail } = Astro.props;
const slug = projectSlug(detail.project);
const hasPhotos = detail.photos.length > 0;
---
<div class="proto-grid">
  <!-- WIDE: the things you read. -->
  <div class="proto-grid__col">
    {hasPhotos ? (
      <div class="proto-grid__photos">
        <ProtoPhotoMosaic photos={detail.photos} layout="wide" companions={2} />
        <ProtoLightboxHost photos={detail.photos} />
      </div>
    ) : (
      <Firma2ProjectGallery photos={detail.photos} />
    )}
    <EsaCard><Firma2ProjectDescription description={detail.projectDescription} /></EsaCard>
    <Firma2ProjectMeasures measures={detail.measures} projectSlug={slug} />
    <Firma2ProjectExpenditures
      expenditures={detail.expenditures}
      estimatedTotalCost={detail.project.estimatedTotalCost}
      estimatedAnnualOperatingCost={detail.project.estimatedAnnualOperatingCost}
      projectSlug={slug}
    />
    <Firma2ProjectFunding funding={detail.funding} estimatedTotalCost={detail.project.estimatedTotalCost} />
  </div>

  <!-- NARROW: the things you set, the people, the ground, the dates. -->
  <div class="proto-grid__col proto-grid__flush">
    <EsaCard><Firma2ProjectFacts detail={detail} showDescription={false} /></EsaCard>
    <EsaCard><Firma2ProjectContacts contacts={detail.contacts} /></EsaCard>
    <EsaCard><Firma2WorkAreas project={detail.project} variant="rail" /></EsaCard>
    <Firma2ProjectTimeline milestones={detail.milestones} />
  </div>

  <div class="proto-grid__full"><Firma2ProjectComments comments={detail.comments} /></div>
</div>

<style>
  .proto-grid {
    display: grid;
    inline-size: 100%;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--spacing-400, 1rem);
    align-items: start;
  }
  .proto-grid__col { display: flex; flex-direction: column; gap: var(--spacing-400, 1rem); min-inline-size: 0; }
  .proto-grid__full { grid-column: 1 / -1; }

  .proto-grid__photos :global(.proto-mosaic) { aspect-ratio: 16 / 9; }

  /* Inside a tile the facts' and contacts' groups lose their own boxes. */
  .proto-grid__flush :global(.esa-collapsible) { border: 0; border-radius: 0; background: transparent; }
  .proto-grid__flush :global(.esa-collapsible__summary),
  .proto-grid__flush :global(.esa-collapsible__body) { padding-inline: 0; }

  @media (max-width: 64rem) {
    .proto-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
