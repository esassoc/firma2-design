---
// PROTOTYPE internal round — This period. Axis: ORGANIZED AROUND THE REPORT THAT IS DUE.
// The record's tables run lifetime-first; the job most sessions come for is
// one period. So the page opens on that period gathered into one card —
// planned against reported per measure, the year's spend, the milestones that
// fall in it — with the doors to close it out. The full sections follow in
// working order (measures, money, milestones), and the read-once material
// (description, photos, comments) moves to the end.
import Firma2ProjectFacts from '../../components/projects/firma2-project-facts.astro';
import ProtoPeriod from './proto-period.astro';
import ProtoSections from './proto-sections.astro';
import ProtoDoors from './proto-doors.astro';
import type { ProjectDetail } from '../../data/firma2-project-detail';

interface Props { detail: ProjectDetail }
const { detail } = Astro.props;
---
<Firma2ProjectFacts detail={detail} layout="strip" />
<ProtoPeriod detail={detail} />
<ProtoSections detail={detail} order={['measures', 'expenditures', 'milestones', 'funding', 'description', 'photos', 'comments']} />
<ProtoDoors />
