---
// PROTOTYPE — the public project page with the Wall band (user, 2026-11-02:
// "keep Wall as a starting point for public"). The real public component
// renders unchanged; its <article> becomes display:contents inside this
// wrapper so the band can sit between its hero and its body without forking
// the component. The gallery section is hidden because the band now carries
// the photos (its lightbox is the band's).
//
// Figures read the live record, not the published snapshot — a known gap of
// the prototype; the real port would take them from `published`.
//
// bcn-lego-checked: prototype-only — wraps firma2-public-project; the band is proto-wall-band (esa-stat + photo tiles)
import Firma2PublicProject from '../../components/public/firma2-public-project.astro';
import ProtoWallBand from './proto-wall-band.astro';
import type { ProjectDetail } from '../../data/firma2-project-detail';

interface Props { detail: ProjectDetail }
const { detail } = Astro.props;
---
<div class="proto-pubwall">
  <div class="proto-pubwall__band">
    <ProtoWallBand detail={detail} columns={4} />
  </div>
  <Firma2PublicProject detail={detail} published={detail.publishing.published} />
</div>

<style>
  .proto-pubwall { display: flex; flex-direction: column; }
  .proto-pubwall :global(.firma2-public-project) { display: contents; }
  .proto-pubwall :global(.firma2-public-project__hero) { order: 0; }
  .proto-pubwall__band {
    order: 1;
    inline-size: 100%;
    max-inline-size: 76rem;
    margin-inline: auto;
    padding-inline: var(--spacing-600, 2rem);
    padding-block-start: var(--spacing-600, 2rem);
    box-sizing: border-box;
  }
  .proto-pubwall :global(.firma2-public-project__body) { order: 2; }
  .proto-pubwall :global([data-section='gallery']) { display: none !important; }
  @media (max-width: 45rem) {
    .proto-pubwall__band { padding-inline: var(--spacing-400, 1rem); }
  }
</style>
