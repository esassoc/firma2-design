---
// PROTOTYPE the "Sections" page's Funding sources: the four-column table as it
// is, and each source opens to its years, funded and spent. Throwaway.
//
// bcn-lego-checked: prototype harness; native details/summary is the disclosure (Ecology has no accordion-row lego)
import EsaCard from '@esa/ecology/esa-card.astro';
import './proto-funding.css';
import { currencyFormatter as usd } from '../../lib/format';
import type { FundingPlan } from './model';

interface Props {
  plan: FundingPlan;
}
const { plan } = Astro.props;
const showSecuredRow = plan.rows.some((row) => row.status !== 'secured');
const share = (amount: number) => (plan.cost > 0 ? `${Math.round((amount / plan.cost) * 100)}%` : '');
---
<EsaCard title="Funding sources">
  <div class="proto-funding proto-expand typography-body-md">
    {plan.rows.length === 0 ? (
      <p class="proto-funding__empty">No funding sources yet.</p>
    ) : (
      <div class="proto-expand__head proto-expand__grid typography-label-md-strong" aria-hidden="true">
        <span>Funding source</span>
        <span>Status</span>
        <span class="proto-funding__num">Amount</span>
        <span class="proto-funding__num">Share of cost</span>
      </div>
    )}
    <ul class="proto-expand__list" role="list">
      {plan.rows.map((row) => (
        <li>
          <details>
            <summary class="proto-expand__grid">
              <span class="proto-expand__name">
                <span class="proto-funding__source">{row.name}</span>
                <span class="proto-funding__org typography-body-sm">{row.organization}</span>
              </span>
              <span>{row.statusLabel}</span>
              <span class="proto-funding__num">{usd.format(row.total)}</span>
              <span class="proto-funding__num">{row.status === 'not-awarded' ? '' : share(row.total)}</span>
            </summary>
            <dl class="proto-expand__years">
              <div class="proto-expand__grid proto-expand__years-head typography-label-md" aria-hidden="true">
                <span></span>
                <span>Year</span>
                <span class="proto-funding__num">Funded</span>
                <span class="proto-funding__num">Spent</span>
              </div>
              {[...new Set([...plan.years, ...plan.spendYears])].sort().filter((year) => row.byYear[year] || row.spentByYear[year]).map((year) => (
                <div class="proto-expand__grid">
                  <span></span>
                  <dt>{year}</dt>
                  <dd class="proto-funding__num"><span class="visually-hidden">Funded </span>{row.byYear[year] ? usd.format(row.byYear[year]) : '–'}</dd>
                  <dd class="proto-funding__num"><span class="visually-hidden">Spent </span>{row.spentByYear[year] ? usd.format(row.spentByYear[year]) : '–'}</dd>
                </div>
              ))}
              {row.href && (
                <div class="proto-expand__grid">
                  <span></span>
                  <a class="proto-funding__source proto-expand__open" href={row.href}>Open funding source</a>
                </div>
              )}
            </dl>
          </details>
        </li>
      ))}
    </ul>
    {plan.rows.length > 0 && (
      <dl class="proto-expand__foot">
        {showSecuredRow && (
          <div class="proto-expand__grid proto-expand__strong">
            <dt>Total secured</dt><span></span><dd class="proto-funding__num">{usd.format(plan.secured)}</dd><dd class="proto-funding__num">{share(plan.secured)}</dd>
          </div>
        )}
        {plan.gap > 0 && (
          <div class="proto-expand__grid">
            <dt>Funding gap</dt><span></span><dd class="proto-funding__num">{usd.format(plan.gap)}</dd><dd class="proto-funding__num">{share(plan.gap)}</dd>
          </div>
        )}
        <div class="proto-expand__grid proto-expand__strong">
          <dt>Estimated total cost</dt><span></span><dd class="proto-funding__num">{usd.format(plan.cost)}</dd><dd class="proto-funding__num">100%</dd>
        </div>
      </dl>
    )}
  </div>
</EsaCard>

<style>
  .proto-expand {
    font-variant-numeric: tabular-nums;
  }
  .proto-expand__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6.5rem 7rem 6.5rem;
    column-gap: var(--spacing-300);
    align-items: start;
  }
  .proto-expand__head {
    color: var(--color-content-default-secondary);
    padding-block: var(--spacing-300);
    padding-inline-start: var(--spacing-700);
    border-bottom: var(--border-width-default) solid var(--color-border-default);
  }
  .proto-expand__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .proto-expand__list > li {
    border-bottom: var(--border-width-default) solid var(--color-border-default-subtle);
  }
  .proto-expand summary {
    position: relative;
    list-style: none;
    cursor: pointer;
    min-height: 2.75rem;
    padding-block: var(--spacing-300);
    padding-inline-start: var(--spacing-700);
  }
  .proto-expand summary::-webkit-details-marker {
    display: none;
  }
  /* The chevron: a rotated corner, turned when open. */
  .proto-expand summary::before {
    content: '';
    position: absolute;
    inset-inline-start: var(--spacing-100);
    top: calc(var(--spacing-300) + 0.45em);
    width: 0.45em;
    height: 0.45em;
    border-inline-end: 1.5px solid var(--color-content-default-secondary);
    border-block-end: 1.5px solid var(--color-content-default-secondary);
    transform: rotate(-45deg);
  }
  .proto-expand details[open] > summary::before {
    transform: rotate(45deg);
  }
  .proto-expand summary:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }
  @media (hover: hover) {
    .proto-expand summary:hover .proto-funding__source {
      text-decoration: underline;
    }
  }
  .proto-expand__years {
    margin: 0;
    padding-block-end: var(--spacing-300);
    padding-inline-start: var(--spacing-700);
  }
  .proto-expand__years > div {
    padding-block: var(--spacing-100);
  }
  .proto-expand__years-head {
    color: var(--color-content-default-secondary);
  }
  .proto-expand__years dt {
    color: var(--color-content-default-secondary);
  }
  .proto-expand :is(dd, dt) {
    margin: 0;
  }
  .proto-expand__open {
    grid-column: 2 / -1;
    padding-block-start: var(--spacing-100);
  }
  .proto-expand__foot {
    margin: 0;
    padding-inline-start: var(--spacing-700);
  }
  .proto-expand__foot > div {
    padding-block: var(--spacing-300);
    border-top: var(--border-width-default) solid var(--color-border-default-subtle);
  }
  .proto-expand__foot > div:first-child {
    border-top: 0;
  }
  .proto-expand__strong {
    font-weight: var(--font-weight-semibold);
  }
  /* Phone: two columns. Status drops under the name; share goes. */
  @media (max-width: 45rem) {
    .proto-expand__grid {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .proto-expand__grid > :nth-child(4),
    .proto-expand__head > :nth-child(2),
    .proto-expand__years .proto-expand__grid > span:first-child,
    .proto-expand__foot .proto-expand__grid > span {
      display: none;
    }
    .proto-expand summary > :nth-child(2) {
      grid-column: 1;
      grid-row: 2;
      color: var(--color-content-default-secondary);
    }
    .proto-expand summary > :nth-child(3) {
      grid-column: 2;
      grid-row: 1;
    }
    .proto-expand__years .proto-expand__grid {
      grid-template-columns: minmax(0, 1fr) 6rem 6rem;
    }
    .proto-expand__years .proto-expand__grid > :nth-child(4) {
      display: block;
    }
    .proto-expand__open {
      grid-column: 1 / -1;
    }
    .proto-expand__head,
    .proto-expand summary,
    .proto-expand__years,
    .proto-expand__foot {
      padding-inline-start: var(--spacing-500);
    }
  }
</style>
