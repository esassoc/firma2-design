---
// PROTOTYPE — the "Document" page's frame: the same sections with their boxes
// taken off, so the main column reads as one continuous document under
// hairline rules. Throwaway.
//
// bcn-lego-checked: prototype harness; restyles esa-card from outside to compare a cardless page, nothing bespoke is built
---
<div class="proto-document">
  <slot />
</div>

<style is:global>
  .proto-document {
    display: flex;
    flex-direction: column;
  }
  .proto-document > * {
    padding-block: var(--spacing-600);
    border-top: var(--border-width-default) solid var(--color-border-default-subtle);
  }
  .proto-document > :first-child {
    border-top: 0;
    padding-block-start: 0;
  }
  /* A wrapper that renders nothing takes no rule and no room. */
  .proto-document > :empty,
  .proto-document > :not(:has(*)) {
    display: none;
  }
  .proto-document .esa-card {
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .proto-document .esa-card__header,
  .proto-document .esa-card__body {
    padding-inline: 0;
  }
  .proto-document .esa-card__header {
    padding-block-start: 0;
  }
  .proto-document .esa-card__body {
    padding-block-end: 0;
  }
</style>
