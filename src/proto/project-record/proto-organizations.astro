---
// PROTOTYPE — the "Money" page's Organizations section: everyone on the
// project in one table, with the part each plays. Lead and funder are read
// from the record; related organizations are the plain list (decision 18).
// Throwaway.
//
// bcn-lego-checked: prototype harness; no esa- table lego exists
import EsaCard from '@esa/ecology/esa-card.astro';
import './proto-funding.css';
import type { ProjectOrganization } from './model';

interface Props {
  organizations: ProjectOrganization[];
}
const { organizations } = Astro.props;
---
<EsaCard title="Organizations">
  <div class="proto-funding">
    <table class="typography-body-md">
      <thead>
        <tr>
          <th scope="col" class="typography-label-md-strong">Organization</th>
          <th scope="col" class="typography-label-md-strong">Part in the project</th>
        </tr>
      </thead>
      <tbody>
        {organizations.map((org) => (
          <tr>
            <th scope="row">{org.href ? <a class="proto-funding__source" href={org.href}>{org.name}</a> : <span class="proto-funding__source">{org.name}</span>}</th>
            <td>{org.part}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</EsaCard>
