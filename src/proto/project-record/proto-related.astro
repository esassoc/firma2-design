---
// PROTOTYPE — the "Sections" page's related organizations: a plain list in the
// rail, under the record's other set values. No role, no permissions
// (docs/data-model.md, decision 18). Throwaway.
//
// bcn-lego-checked: prototype harness; esa-card holds a plain list of links, nothing bespoke
import EsaCard from '@esa/ecology/esa-card.astro';
import type { ProjectOrganization } from './model';

interface Props {
  related: ProjectOrganization[];
}
const { related } = Astro.props;
---
<EsaCard title="Related organizations">
  {related.length === 0 ? (
    <p class="proto-related__none typography-body-md">None yet.</p>
  ) : (
    <ul class="proto-related stack" data-gap="sm" role="list">
      {related.map((org) => (
        <li class="typography-body-md">{org.href ? <a href={org.href}>{org.name}</a> : org.name}</li>
      ))}
    </ul>
  )}
</EsaCard>

<style>
  .proto-related {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .proto-related a {
    color: var(--color-content-brand);
    text-decoration: none;
  }
  .proto-related a:hover {
    text-decoration: underline;
  }
  .proto-related__none {
    margin: 0;
    color: var(--color-content-default-secondary);
  }
</style>
