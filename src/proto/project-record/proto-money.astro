---
// PROTOTYPE — the "Money" page's one money section: the figures, then a table
// of every funding source against every year, switched between what was funded
// and what was spent. Replaces the Expenditures and Funding sources cards.
// Throwaway.
//
// bcn-lego-checked: prototype harness; no esa- table lego exists, the switch is esa-button-toggle, the scroll region is a plain focusable div
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaStat from '@esa/ecology/esa-stat.astro';
import './proto-funding.css';
import { currencyFormatter as usd } from '../../lib/format';
import type { FundingPlan } from './model';

interface Props {
  plan: FundingPlan;
}
const { plan } = Astro.props;
const anyUnsecured = plan.rows.some((row) => row.status !== 'secured');
const dash = '–';

interface View {
  key: 'funding' | 'spending';
  years: number[];
  rows: { name: string; href?: string; note: string; byYear: Record<number, number>; total: number }[];
  foot: { label: string; byYear?: Record<number, number>; total: number; strong?: boolean }[];
  empty: string;
}
const views: View[] = [
  {
    key: 'funding',
    years: plan.years,
    rows: plan.rows.map((row) => ({ name: row.name, href: row.href, note: row.status === 'secured' ? row.organization : `${row.statusLabel} · ${row.organization}`, byYear: row.byYear, total: row.total })),
    foot: [
      ...(anyUnsecured ? [{ label: 'Total secured', byYear: plan.securedByYear, total: plan.secured, strong: true }] : []),
      ...(plan.gap > 0 ? [{ label: 'Funding gap', total: plan.gap }] : []),
      { label: 'Estimated total cost', total: plan.cost, strong: true },
    ],
    empty: 'No funding sources yet.',
  },
  {
    key: 'spending',
    years: plan.spendYears,
    rows: plan.rows.filter((row) => row.spent > 0).map((row) => ({ name: row.name, href: row.href, note: row.organization, byYear: row.spentByYear, total: row.spent })),
    foot: [
      { label: 'Total spent', byYear: plan.spentTotalByYear, total: plan.spent, strong: true },
      { label: 'Left to spend', total: Math.max(0, plan.cost - plan.spent) },
    ],
    empty: 'Nothing spent yet.',
  },
];
---
<EsaCard title="Funding and spending">
  <esa-button-toggle slot="actions" size="sm" aria-label="Amounts shown" data-proto-money-toggle></esa-button-toggle>
  <div class="proto-funding proto-money stack" data-gap="lg" data-proto-money>
    <!-- Three figures, not four: the estimated cost is in the facts strip above and the table's last row. -->
    <div class="grid" data-gap="md" style="--grid-min: 10rem">
      <EsaStat value={usd.format(plan.secured)} label="Secured" />
      {plan.gap > 0 && <EsaStat value={usd.format(plan.gap)} label="Funding gap" />}
      <EsaStat value={usd.format(plan.spent)} label="Spent" />
    </div>
    {views.map((view, v) => (
      <div data-proto-money-view={view.key} hidden={v > 0}>
        {view.rows.length === 0 ? (
          <p class="proto-funding__empty typography-body-md">{view.empty}</p>
        ) : (
          <div class="proto-money__scroll" tabindex="0" role="region" aria-label={view.key === 'funding' ? 'Funding by source and year' : 'Spending by source and year'}>
            <table>
              <thead>
                <tr>
                  <th scope="col" class="proto-money__pin typography-label-md-strong">Funding source</th>
                  {view.years.map((year) => <th scope="col" class="proto-funding__num typography-label-md-strong">{year}</th>)}
                  <th scope="col" class="proto-funding__num proto-money__total typography-label-md-strong">Total</th>
                </tr>
              </thead>
              <tbody>
                {view.rows.map((row) => (
                  <tr>
                    <th scope="row" class="proto-money__pin">
                      {row.href ? <a class="proto-funding__source typography-body-md" href={row.href}>{row.name}</a> : <span class="proto-funding__source typography-body-md">{row.name}</span>}
                      <span class="proto-funding__org typography-body-sm">{row.note}</span>
                    </th>
                    {view.years.map((year) => (
                      <td class="proto-funding__num typography-body-md">{row.byYear[year] ? usd.format(row.byYear[year]) : <span class="proto-funding__none" aria-hidden="true">{dash}</span>}</td>
                    ))}
                    <td class="proto-funding__num proto-money__total typography-body-md">{usd.format(row.total)}</td>
                  </tr>
                ))}
              </tbody>
              <tfoot class="typography-body-md">
                {view.foot.map((foot) => (
                  <tr class={foot.strong ? 'proto-funding__strong' : undefined}>
                    <th scope="row" class="proto-money__pin">{foot.label}</th>
                    {foot.byYear
                      ? view.years.map((year) => <td class="proto-funding__num">{foot.byYear![year] ? usd.format(foot.byYear![year]) : <span class="proto-funding__none" aria-hidden="true">{dash}</span>}</td>)
                      : <td colspan={view.years.length}></td>}
                    <td class="proto-funding__num proto-money__total">{usd.format(foot.total)}</td>
                  </tr>
                ))}
              </tfoot>
            </table>
          </div>
        )}
      </div>
    ))}
  </div>
</EsaCard>

<style>
  .proto-money [hidden] {
    display: none;
  }
  /* The scroll box is positioned so the pinned columns stick to IT. */
  .proto-money__scroll {
    position: relative;
    overflow-x: auto;
  }
  .proto-money__scroll:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }
  .proto-money table {
    min-width: max-content;
  }
  .proto-money__pin {
    position: sticky;
    inset-inline-start: 0;
    z-index: 1;
    width: 13rem;
    min-width: 13rem;
    max-width: 13rem;
    background: var(--card-bg, var(--color-background-elevation-raised));
    border-inline-end: var(--border-width-default) solid var(--color-border-default-subtle);
    padding-inline-end: var(--spacing-300);
  }
  /* Room to keep the total in view: it pins to the far edge. On a phone the
     source column narrows instead, and the total scrolls with the years. */
  @media (min-width: 45rem) {
    .proto-money .proto-money__total {
      position: sticky;
      inset-inline-end: 0;
      background: var(--card-bg, var(--color-background-elevation-raised));
      border-inline-start: var(--border-width-default) solid var(--color-border-default-subtle);
      padding-inline-start: var(--spacing-300);
    }
  }
  @media (max-width: 45rem) {
    .proto-money__pin {
      width: 9.5rem;
      min-width: 9.5rem;
      max-width: 9.5rem;
    }
  }
</style>

<script>
  import '@esa/ecology/esa-button-toggle';

  for (const toggle of document.querySelectorAll<HTMLElement & { options: { label: string; value: string }[]; value: string }>('[data-proto-money-toggle]')) {
    const root = toggle.closest('.esa-card')?.querySelector<HTMLElement>('[data-proto-money]');
    if (!root) continue;
    customElements.whenDefined('esa-button-toggle').then(() => {
      toggle.options = [
        { label: 'Funding', value: 'funding' },
        { label: 'Spending', value: 'spending' },
      ];
      toggle.value = 'funding';
    });
    toggle.addEventListener('change', (event) => {
      const value = (event as CustomEvent<{ value: string }>).detail.value;
      root.querySelectorAll<HTMLElement>('[data-proto-money-view]').forEach((view) => (view.hidden = view.dataset.protoMoneyView !== value));
    });
  }
</script>
