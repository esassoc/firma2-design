---
// PROTOTYPE — /proto/public-session. Throwaway; deleted when a direction is
// picked (emil-prototype Phase 7). Nothing in production imports it.
//
// THE QUESTION: a signed-in person lands on a public page. Where do their
// doors live — into the record, into the workspace, to the review, and out
// (Sign out)? Four answers, one per variant:
//   current — the header's door swap + the unpublished strip (as built; no sign out)
//   menu    — an account menu in the header's corner
//   bar     — a staff bar above the site's header
//   dock    — a floating dock, bottom corner, the page untouched
//
// bcn-lego-checked: prototype harness — every control is a lego (esa-button,
// esa-avatar, esa-badge, esa-dropdown-menu); the bar and the dock are the two
// surfaces under test and exist only here. Beacon is not cloned on this machine.
import EsaAvatar from '@esa/ecology/esa-avatar.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { CURRENT_USER } from '../../data/firma2-directory';
import { HOME_HREF } from '../../data/firma2-nav';
import { withBase } from '../../lib/base';

interface Props {
  variant: 'current' | 'menu' | 'bar' | 'dock';
  slug: string;
  keys: string[];
  /** Base-less. */
  projectHref: string;
  reviewHref: string;
}

const { variant, slug, keys, projectHref, reviewHref } = Astro.props;
const count = keys.length;
const changes = `${count} unpublished change${count === 1 ? '' : 's'}`;
const hrefs = { project: withBase(projectHref), review: withBase(reviewHref), workspace: withBase(HOME_HREF) };
const account = `Account, ${CURRENT_USER.name}`;
---
{variant !== 'current' && (
  <div
    class={`proto-session proto-session--${variant}`}
    data-proto-session={variant}
    data-slug={slug}
    data-keys={JSON.stringify(keys)}
    data-hrefs={JSON.stringify(hrefs)}
  >
    {variant === 'menu' && (
      <esa-dropdown-menu class="proto-session__menu" position="below-end" data-session-menu="full">
        <EsaButton variant="chrome" aria-label={account}>
          <EsaAvatar name={CURRENT_USER.name} size="sm" />
        </EsaButton>
      </esa-dropdown-menu>
    )}

    {variant === 'bar' && (
      <aside class="proto-session__bar repel" aria-label="Workspace">
        <div class="cluster" data-gap="xs">
          <EsaButton variant="chrome" icon="pencil" href={hrefs.project}>Open project</EsaButton>
          <span class="proto-session__wide"><EsaButton variant="chrome" href={hrefs.workspace}>Open workspace</EsaButton></span>
          <span class="proto-session__pending proto-session__wide" data-session-pending>
            <EsaButton variant="chrome" href={hrefs.review}>
              Review changes <EsaBadge value={count} variant="info" size="sm" />
            </EsaButton>
          </span>
        </div>
        <div class="cluster" data-gap="xs">
          <span class="proto-session__wide proto-session__who typography-label-md">
            <EsaAvatar name={CURRENT_USER.name} size="xs" />{CURRENT_USER.name}
          </span>
          <span class="proto-session__wide"><EsaButton variant="chrome" data-session-sign-out>Sign out</EsaButton></span>
          <esa-dropdown-menu class="proto-session__narrow" position="below-end" data-session-menu="rest">
            <EsaButton variant="chrome" aria-label={account}><EsaAvatar name={CURRENT_USER.name} size="sm" /></EsaButton>
          </esa-dropdown-menu>
        </div>
      </aside>
    )}

    {variant === 'dock' && (
      <aside class="proto-session__dock" aria-label="Workspace">
        <span class="proto-session__pending" data-session-pending>
          <EsaButton variant="chrome" href={hrefs.review}>
            <EsaBadge value={count} variant="info" size="sm" /> <span class="proto-session__dock-label">{changes.replace(/^\d+ /, '')}</span>
          </EsaButton>
        </span>
        <EsaButton variant="primary" icon="pencil" href={hrefs.project}>Open project</EsaButton>
        <esa-dropdown-menu position="above-end" data-session-menu="rest">
          <EsaButton variant="chrome" aria-label={account}><EsaAvatar name={CURRENT_USER.name} size="sm" /></EsaButton>
        </esa-dropdown-menu>
      </aside>
    )}
  </div>
)}

{/* Placement, before first paint: the menu goes into the header's corner, the
    bar above the header. Signed out, none of it is there. */}
<script is:inline define:vars={{ variant }}>
  (function () {
    var root = document.querySelector('[data-proto-session]');
    var html = document.documentElement;
    html.setAttribute('data-proto-session-variant', variant);
    if (!root) return;
    if (!html.hasAttribute('data-signed-in')) { root.remove(); return; }
    if (variant === 'menu') document.querySelector('.firma2-public-header__end').appendChild(root);
    if (variant === 'bar') {
      var frame = document.querySelector('.firma2-public-frame');
      frame.insertBefore(root, frame.firstChild);
    }
  })();
</script>

<style is:global>
  /* The session surface replaces the header's own signed-in door, and in the
     bar and the dock it carries the unpublished line too. */
  html[data-signed-in]:not([data-proto-session-variant='current']) .firma2-public-header__door[data-door='in'],
  html[data-signed-in][data-proto-session-variant='bar'] .firma2-public-review-notice,
  html[data-signed-in][data-proto-session-variant='dock'] .firma2-public-review-notice {
    display: none !important;
  }
  .proto-session [hidden] {
    display: none !important;
  }
  /* SIBLINGS MATCH: an avatar, a badge or a glyph inside a button must not
     make it taller than the text-only button beside it. */
  .proto-session .esa-button__native :is(.esa-avatar, .esa-badge, .esa-icon) {
    flex: none;
    margin-block: -0.5rem;
  }
  .proto-session .esa-button__native:has(.esa-avatar) {
    padding-inline: var(--spacing-100);
  }
  .proto-session--menu {
    display: inline-flex;
  }

  /* ── Bar ─────────────────────────────────────────────────────────────── */
  .proto-session__bar {
    flex-wrap: nowrap;
    padding: var(--spacing-100) var(--firma2-public-gutter, var(--spacing-600));
    background: var(--color-background-elevation-sunken);
    border-block-end: 1px solid var(--color-border-subtle);
  }
  .proto-session__bar .cluster {
    flex-wrap: nowrap;
  }
  .proto-session__who {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-200);
    padding-inline-end: var(--spacing-200);
    color: var(--color-content-default-secondary);
    white-space: nowrap;
  }
  .proto-session__wide {
    display: inline-flex;
  }
  .proto-session__narrow {
    display: none;
  }
  @media (max-width: 45rem) {
    .proto-session__bar .proto-session__wide {
      display: none;
    }
    .proto-session__narrow {
      display: inline-flex;
    }
  }

  /* ── Dock ────────────────────────────────────────────────────────────── */
  .proto-session__dock {
    position: fixed;
    inset-block-end: calc(var(--spacing-500) + env(safe-area-inset-bottom));
    inset-inline-end: var(--spacing-500);
    z-index: var(--z-popover, 400);
    display: flex;
    align-items: center;
    gap: var(--spacing-100);
    padding: var(--spacing-100);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background: var(--color-background-elevation-floating, var(--color-background-default));
    box-shadow: var(--elevation-4);
  }
  @media (max-width: 45rem) {
    .proto-session__dock {
      inset-inline: var(--spacing-400);
      justify-content: space-between;
    }
  }
</style>

<script>
  import '@esa/ecology/esa-dropdown-menu';
  import { setSignedIn } from '../../lib/session';
  import { reviewRows } from '../../components/review/review-rows';

  type Menu = HTMLElement & { items: { label: string; action?: string; divider?: boolean; variant?: string }[] };

  const root = document.querySelector<HTMLElement>('[data-proto-session]');
  if (root) {
    const hrefs: Record<string, string> = JSON.parse(root.dataset.hrefs!);
    const count = reviewRows(root.dataset.slug!, JSON.parse(root.dataset.keys ?? '[]')).count;
    root.querySelectorAll<HTMLElement>('[data-session-pending]').forEach((el) => (el.hidden = count === 0));

    // Sign out stays on the public page: the reader came for it, and now sees
    // it as the public does.
    const signOut = (): void => {
      setSignedIn(false);
      window.location.reload();
    };
    root.querySelector('[data-session-sign-out]')?.addEventListener('click', signOut);

    const review = count ? [{ label: `Review changes (${count})`, action: 'review' }] : [];
    const signOutItems = [{ label: '', divider: true }, { label: 'Sign out', action: 'sign-out', variant: 'danger' }];
    root.querySelectorAll<Menu>('esa-dropdown-menu').forEach((menu) => {
      const full = menu.dataset.sessionMenu === 'full';
      const phone = window.matchMedia('(max-width: 45rem)').matches;
      customElements.whenDefined('esa-dropdown-menu').then(() => {
        menu.items = [
          // The header menu carries every door; the bar's and the dock's carry
          // what their surface does not already show.
          ...(full ? [{ label: 'Open project', action: 'project' }] : []),
          ...(full || (phone && menu.closest('.proto-session__bar')) ? review : []),
          { label: 'Open workspace', action: 'workspace' },
          ...signOutItems,
        ];
      });
      menu.addEventListener('menu-action', (event) => {
        const action = (event as CustomEvent<string>).detail;
        if (action === 'sign-out') signOut();
        else if (hrefs[action]) window.location.href = hrefs[action];
      });
    });
  }

  // The harness owns the keys; a frame with focus hands them up.
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.metaKey || e.ctrlKey || e.altKey || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable) return;
    if (/^[1-9]$|^Arrow(Left|Right)$/.test(e.key)) window.parent?.postMessage({ protoKey: e.key }, '*');
  });
</script>
