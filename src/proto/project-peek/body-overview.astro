---
// PROTOTYPE — /proto/project-peek, direction "Overview" (picked 2026-11-02).
// AXIS: the peek answers "is this the project I think it is?" — what it is,
// where, and how far along. The content is fixed across arrangements:
// description, the placing facts, Filed under, the map, and Progress (ring
// rows ported from the current peek — easier to scan than a target list).
// Only the ARRANGEMENT differs:
//   read-down    — one column: description → facts → progress → map → filed under
//   side-by-side — description, then Progress | Key facts (its list carries the classifications), map last
//   map-beside   — description beside a small bare map, facts, one-line
//                  progress rows (ring · name · figure), filed under
//
// bcn-lego-checked: prototype — firma2-project-description (inline), firma2-project-facts (strip/list), firma2-project-map canvas, bcn-progress-ring, esa-pill, firma2-rail-section; bespoke CSS is the map band and row insets; throwaway
import EsaPill from '@esa/ecology/esa-pill.astro';
import BcnProgressRing from '../../components/shared/bcn-progress-ring.astro';
import Firma2RailSection from '../../components/shared/firma2-rail-section.astro';
import Firma2ProjectFacts from '../../components/projects/firma2-project-facts.astro';
import Firma2ProjectDescription from '../../components/projects/firma2-project-description.astro';
import Firma2ProjectMap from '../../components/projects/firma2-project-map.astro';
import { reportedTotal } from '../../data/firma2-project-detail';
import type { ProjectDetail } from '../../data/firma2-project-detail';
import { currencyFormatter as money } from '../../lib/format';
import { fmt, spentToDate, pickMilestone } from './derive';

export type OverviewLayout = 'read-down' | 'side-by-side' | 'map-beside';

interface Props {
  detail: ProjectDetail;
  layout: OverviewLayout;
}
const { detail, layout } = Astro.props;
const spent = spentToDate(detail);
const estimate = detail.project.estimatedTotalCost;
const milestone = pickMilestone(detail.milestones);
const rows = [
  ...detail.measures.map((m) => {
    const reported = reportedTotal(m.series);
    return {
      label: m.name,
      pct: m.expected > 0 ? (reported / m.expected) * 100 : 0,
      figure: `${fmt(reported)} of ${fmt(m.expected)} ${m.unit}`,
    };
  }),
  {
    label: 'Spent to date',
    pct: estimate > 0 ? (spent / estimate) * 100 : 0,
    figure: `${money.format(spent)} of ${money.format(estimate)} estimated`,
  },
];
const compact = layout === 'map-beside';
// The small locator needs more context than the record's zoom gives it.
const locator = { ...detail, mapZoom: detail.mapZoom - 2 };
---
<div class="stack" data-gap="xl" data-layout={layout}>
  {layout === 'map-beside' ? (
    <div class="proto-overview__lead grid" data-gap="lg">
      <Firma2ProjectDescription description={detail.projectDescription} inline />
      <div class="proto-overview__map proto-overview__map--bare">
        <Firma2ProjectMap detail={locator} variant="canvas" readonly />
      </div>
    </div>
  ) : (
    <Firma2ProjectDescription description={detail.projectDescription} inline />
  )}

  {layout !== 'side-by-side' && (
    <Firma2ProjectFacts detail={detail} layout="strip" showStage={false} />
  )}

  {layout === 'side-by-side' ? (
    <div class="proto-overview__columns grid" data-gap="xl">
      <Firma2RailSection title="Progress">
        <dl class="proto-overview__progress stack" data-gap="md">
          {rows.map((r) => (
            <div class="proto-overview__row stack" data-gap="2xs">
              <dt class="proto-overview__label typography-label-sm">{r.label}</dt>
              <dd class="cluster" data-gap="xs">
                <BcnProgressRing value={r.pct} size="xs" />
                <span class="typography-body-sm proto-overview__num">{r.figure}</span>
              </dd>
            </div>
          ))}
          {milestone && (
            <div class="proto-overview__row stack" data-gap="2xs">
              <dt class="proto-overview__label typography-label-sm">{milestone.label}</dt>
              <dd class="cluster" data-gap="xs">
                <span class="typography-body-sm">{milestone.milestone.title}</span>
                <span class="typography-meta">{milestone.milestone.date}</span>
              </dd>
            </div>
          )}
        </dl>
      </Firma2RailSection>
      <Firma2ProjectFacts detail={detail} showStage={false} showDescription={false} />
    </div>
  ) : (
    <Firma2RailSection title="Progress">
      <dl class:list={['proto-overview__progress stack', { 'proto-overview__progress--compact': compact }]} data-gap={compact ? 'sm' : 'md'}>
        {rows.map((r) => compact ? (
          <div class="proto-overview__row proto-overview__row--compact">
            <BcnProgressRing value={r.pct} size="xs" />
            <dt class="typography-body-sm">{r.label}</dt>
            <dd class="typography-body-sm proto-overview__num">{r.figure}</dd>
          </div>
        ) : (
          <div class="proto-overview__row stack" data-gap="2xs">
            <dt class="proto-overview__label typography-label-sm">{r.label}</dt>
            <dd class="cluster" data-gap="xs">
              <BcnProgressRing value={r.pct} size="xs" />
              <span class="typography-body-sm proto-overview__num">{r.figure}</span>
            </dd>
          </div>
        ))}
        {milestone && (compact ? (
          <div class="proto-overview__row proto-overview__row--compact">
            <span aria-hidden="true"></span>
            <dt class="typography-body-sm">{milestone.label}</dt>
            <dd class="typography-body-sm">{milestone.milestone.title} <span class="typography-meta">{milestone.milestone.date}</span></dd>
          </div>
        ) : (
          <div class="proto-overview__row stack" data-gap="2xs">
            <dt class="proto-overview__label typography-label-sm">{milestone.label}</dt>
            <dd class="cluster" data-gap="xs">
              <span class="typography-body-sm">{milestone.milestone.title}</span>
              <span class="typography-meta">{milestone.milestone.date}</span>
            </dd>
          </div>
        ))}
      </dl>
    </Firma2RailSection>
  )}

  {layout === 'read-down' && (
    <div class="proto-overview__map">
      <Firma2ProjectMap detail={detail} variant="canvas" readonly />
    </div>
  )}

  {layout !== 'side-by-side' && (
    <Firma2RailSection title="Filed under">
      <div class="proto-overview__pills cluster" data-gap="xs">
        {detail.project.classifications.map((c) => <EsaPill label={c} size="sm" removable={false} />)}
        {detail.project.tags.map((t) => <EsaPill label={t} variant="default" size="sm" removable={false} />)}
      </div>
    </Firma2RailSection>
  )}

  {layout === 'side-by-side' && (
    <div class="proto-overview__map">
      <Firma2ProjectMap detail={detail} variant="canvas" readonly />
    </div>
  )}
</div>

<style>
  .proto-overview__map {
    position: relative;
    block-size: 16rem;
    border: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #e3e5e2);
    border-radius: var(--radius-md, 0.5rem);
    overflow: hidden;
  }
  /* Small locator: no title plate, no legend — the description beside it
     names the place. Prototype only; production would need the legend's
     text alternative somewhere. */
  .proto-overview__map--bare { block-size: 100%; min-block-size: 11rem; }
  /* The 16rem band keeps the head plate, drops the legend (the harness
     re-frames the shapes to match). */
  .proto-overview__map:not(.proto-overview__map--bare) :global(.firma2-project-map__plate--legend) { display: none; }
  .proto-overview__map--bare :global(.firma2-project-map__plate) { display: none; }
  .proto-overview__lead { --grid-min: 15rem; align-items: stretch; }
  .proto-overview__columns { --grid-min: 16rem; }

  .proto-overview__progress, .proto-overview__progress dd { margin: 0; }
  /* One left edge with the facts: the field box's text inset, as production. */
  .proto-overview__row,
  .proto-overview__pills {
    padding-inline-start: calc(var(--spacing-300, 0.75rem) + var(--form-border-width, 1px));
  }
  .proto-overview__label { color: var(--color-content-default-secondary, #646464); }
  .proto-overview__map--bare :global(.leaflet-control-zoom) { display: none; }
  .proto-overview__row--compact {
    display: grid;
    grid-template-columns: 1.5rem 1fr auto;
    align-items: center;
    column-gap: var(--spacing-200, 0.5rem);
  }
  .proto-overview__row--compact dd { text-align: end; }
  .proto-overview__num { font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>
