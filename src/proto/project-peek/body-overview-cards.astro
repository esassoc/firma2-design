---
// PROTOTYPE — /proto/project-peek, "Map beside + cards". The Map beside
// arrangement with the entities in it made into doors: the lead organization,
// each classification and each performance measure is a link to its own page,
// and hovering or focusing it raises firma2-hover-card — the same card the
// project page's Contacts and Key facts raise. Question under test: does the
// peek answer "who / what is that?" without leaving, or is it hover noise?
//
// bcn-lego-checked: prototype — firma2-hover-card (esa-popover underneath) for every card, firma2-editable-field for Timeline/Estimated cost (same props as firma2-project-facts' strip), firma2-project-description, firma2-project-map canvas, bcn-progress-ring, esa-pill, firma2-rail-section; bespoke CSS is the map band, row insets and the text-link treatment; throwaway
import EsaPill from '@esa/ecology/esa-pill.astro';
import BcnProgressRing from '../../components/shared/bcn-progress-ring.astro';
import Firma2RailSection from '../../components/shared/firma2-rail-section.astro';
import Firma2HoverCard from '../../components/shared/firma2-hover-card.astro';
import Firma2EditableField from '../../components/shared/firma2-editable-field.astro';
import Firma2ProjectDescription from '../../components/projects/firma2-project-description.astro';
import Firma2ProjectMap from '../../components/projects/firma2-project-map.astro';
import { getProjectDetail, reportedTotal } from '../../data/firma2-project-detail';
import type { ProjectDetail } from '../../data/firma2-project-detail';
import { projects } from '../../data/firma2-projects';
import { getOrganization, organizationSlug } from '../../data/firma2-directory';
import { organizationPageHref, readerOrganizations } from '../../data/firma2-organization-pages';
import { CLASSIFICATION_GROUPS, classificationNamed } from '../../data/firma2-classifications';
import { classificationHref } from '../../data/firma2-classification-rollup';
import { getMeasure } from '../../data/firma2-performance-measures';
import { measurePageHref } from '../../lib/measure-pages';
import { currencyFormatter as money } from '../../lib/format';
import { withBase } from '../../lib/base';
import { fmt, spentToDate, pickMilestone } from './derive';

interface Props {
  detail: ProjectDetail;
}
const { detail } = Astro.props;
const { project } = detail;
const spent = spentToDate(detail);
const estimate = project.estimatedTotalCost;
const milestone = pickMilestone(detail.milestones);
const locator = { ...detail, mapZoom: detail.mapZoom - 2 };

// THE ORGANIZATION. Only the reader's own organizations have pages in this
// spoke; any other lead opens the Projects index, as Key facts does today.
const org = getOrganization(organizationSlug(project.leadOrganization));
const ownOrg = readerOrganizations().some((o) => o.slug === org?.slug);
const orgHref = withBase(ownOrg && org ? organizationPageHref(org.slug) : '/prototypes/projects');
const orgLines = org
  ? [`${org.projectsLed} ${org.projectsLed === 1 ? 'project' : 'projects'} led`, ...(org.primaryContact ? [`Contact: ${org.primaryContact}`] : [])]
  : [];

// CLASSIFICATIONS. Same card Key facts raises: group, name, portfolio share.
const groupName = (slug: string) => CLASSIFICATION_GROUPS.find((g) => g.slug === slug)?.name ?? 'Classification';
const classCards = project.classifications.map((name) => {
  const c = classificationNamed(name);
  const count = projects.filter((p) => p.classifications.includes(name)).length;
  return {
    name,
    href: c ? withBase(classificationHref(c.slug)) : undefined,
    kind: c ? groupName(c.group) : 'Classification',
    lines: [`${count} of ${projects.length} projects`],
  };
});

// MEASURES. The row label is the project's own wording; the card names the
// catalog measure it counts toward, where it rolls up, how widely it is
// reported, and when THIS project last reported it.
const reportersOf = (slug: string) =>
  projects.filter((p) => getProjectDetail(p).measures.some((m) => m.kpi === slug)).length;
const rows = detail.measures.map((m) => {
  const reported = reportedTotal(m.series);
  const def = m.kpi ? getMeasure(m.kpi) : undefined;
  const last = [...m.series].reverse().find((y) => y.value !== null)?.year;
  return {
    label: m.name,
    pct: m.expected > 0 ? (reported / m.expected) * 100 : 0,
    figure: `${fmt(reported)} of ${fmt(m.expected)} ${m.unit}`,
    card: def
      ? {
          href: withBase(measurePageHref(def.slug)),
          title: def.name,
          lines: [
            ...(def.classifications.length ? [`Counts toward ${def.classifications.join(', ')}`] : []),
            `${reportersOf(def.slug)} projects report this`,
            last ? `Last reported ${last}` : 'Not reported yet',
          ],
        }
      : undefined,
  };
});
---
<div class="stack" data-gap="xl">
  <div class="proto-cards__lead grid" data-gap="lg">
    <Firma2ProjectDescription description={detail.projectDescription} inline />
    <div class="proto-cards__map">
      <Firma2ProjectMap detail={locator} variant="canvas" readonly />
    </div>
  </div>

  <dl class="proto-cards__strip cluster" data-gap="lg" style="--align: start">
    <Firma2EditableField
      field="timeline"
      label="Timeline"
      value={`${project.implementationStartYear}–${project.completionYear}`}
      editValue={`${project.implementationStartYear},${project.completionYear}`}
      control="year-range"
      format="year-range"
    />
    <Firma2EditableField
      field="estimatedTotalCost"
      label="Estimated cost"
      value={money.format(estimate)}
      editValue={String(estimate)}
      control="number"
      format="currency"
    />
    <div class="proto-cards__pair stack" data-gap="2xs">
      <dt class="proto-cards__label typography-label-sm">Lead organization</dt>
      <dd>
        <Firma2HoverCard kind={org?.type ?? 'Organization'} title={project.leadOrganization} lines={orgLines} span="17rem">
          <a class="proto-cards__link typography-body-md" href={orgHref}>{project.leadOrganization}</a>
        </Firma2HoverCard>
      </dd>
    </div>
  </dl>

  <Firma2RailSection title="Progress">
    <dl class="proto-cards__progress stack" data-gap="sm">
      {rows.map((r) => (
        <div class="proto-cards__row">
          <BcnProgressRing value={r.pct} size="xs" />
          <dt class="typography-body-sm">
            {r.card ? (
              <Firma2HoverCard kind="Performance measure" title={r.card.title} lines={r.card.lines} span="20rem">
                <a class="proto-cards__link" href={r.card.href}>{r.label}</a>
              </Firma2HoverCard>
            ) : r.label}
          </dt>
          <dd class="typography-body-sm proto-cards__num">{r.figure}</dd>
        </div>
      ))}
      <div class="proto-cards__row">
        <BcnProgressRing value={estimate > 0 ? (spent / estimate) * 100 : 0} size="xs" />
        <dt class="typography-body-sm">Spent to date</dt>
        <dd class="typography-body-sm proto-cards__num">{money.format(spent)} of {money.format(estimate)} estimated</dd>
      </div>
      {milestone && (
        <div class="proto-cards__row">
          <span aria-hidden="true"></span>
          <dt class="typography-body-sm">{milestone.label}</dt>
          <dd class="typography-body-sm">{milestone.milestone.title} <span class="typography-meta">{milestone.milestone.date}</span></dd>
        </div>
      )}
    </dl>
  </Firma2RailSection>

  <Firma2RailSection title="Filed under">
    <div class="proto-cards__filed stack" data-gap="xs">
      {classCards.map((c) => (
        <Firma2HoverCard kind={c.kind} title={c.name} lines={c.lines} span="20rem">
          <a class="proto-cards__chip" href={c.href}><EsaPill label={c.name} size="sm" removable={false} /></a>
        </Firma2HoverCard>
      ))}
      {project.tags.length > 0 && (
        <div class="cluster" data-gap="xs">
          {project.tags.map((t) => <EsaPill label={t} variant="default" size="sm" removable={false} />)}
        </div>
      )}
    </div>
  </Firma2RailSection>
</div>

<style>
  .proto-cards__lead { --grid-min: 15rem; align-items: stretch; }
  .proto-cards__map {
    position: relative;
    isolation: isolate;
    block-size: 100%;
    min-block-size: 11rem;
    border: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #e3e5e2);
    border-radius: var(--radius-md, 0.5rem);
    overflow: hidden;
  }
  .proto-cards__map :global(.firma2-project-map__plate),
  .proto-cards__map :global(.leaflet-control-zoom) { display: none; }

  .proto-cards__strip, .proto-cards__strip dd, .proto-cards__progress, .proto-cards__progress dd { margin: 0; }
  /* The lead-organization pair sits on the editable fields' geometry: label
     and value at the field box's text inset, value centred in a 40px line. */
  .proto-cards__pair { padding-inline-start: calc(var(--spacing-300, 0.75rem) + var(--form-border-width, 1px)); }
  .proto-cards__pair dd { min-block-size: 2.5rem; display: flex; align-items: center; }
  .proto-cards__label { color: var(--color-content-default-secondary, #646464); }

  .proto-cards__row,
  .proto-cards__filed {
    padding-inline-start: calc(var(--spacing-300, 0.75rem) + var(--form-border-width, 1px));
  }
  .proto-cards__row {
    display: grid;
    grid-template-columns: 1.5rem 1fr auto;
    align-items: center;
    column-gap: var(--spacing-200, 0.5rem);
  }
  /* The hover card's bridge is padding under its trigger; cancel it in a row
     so a measure with a card sits on the same rhythm as one without. */
  .proto-cards__row :global(.firma2-hover-card__row) { padding-block-end: 0; }
  .proto-cards__filed :global(.firma2-hover-card__row) { padding-block-end: 0; }
  /* The shell shrink-wraps hover-card rows (min-inline-size: 0) for the facts
     list; that undoes the card's fix 1, and a 20rem card centred on a narrow
     chip spills off the rail's left edge. Give these rows their span back. */
  .proto-cards__row :global(.firma2-hover-card__row),
  .proto-cards__filed :global(.firma2-hover-card__row),
  .proto-cards__pair :global(.firma2-hover-card__row) { min-inline-size: var(--_span); }

  /* A door that reads as text until it is pointed at. */
  .proto-cards__link {
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-sm, 0.25rem);
  }
  @media (hover: hover) and (pointer: fine) {
    .proto-cards__link:hover {
      text-decoration: underline;
      text-decoration-color: var(--color-border-default, #c8cbc6);
      text-underline-offset: 3px;
    }
  }
  .proto-cards__link:focus-visible,
  .proto-cards__chip:focus-visible {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, #3e9b4f);
    outline-offset: var(--focus-ring-offset, 2px);
  }
  .proto-cards__chip { display: inline-flex; border-radius: var(--radius-sm, 0.25rem); text-decoration: none; }
  .proto-cards__num { font-variant-numeric: tabular-nums; white-space: nowrap; text-align: end; }
</style>
