---
// PROTOTYPE VARIANT — "Legend". Throwaway (emil-prototype).
//
// AXIS: the map is the editor, and there are no numbers. The model of Felt's
// legend and Google My Maps: the page is the map, the legend floats on it, and
// a legend row opens that layer's style in the legend's own place. Every
// choice is one of a few named steps (Thin / Medium / Thick, None / Light /
// Solid) and colour is a swatch — an administrator cannot make an ugly map,
// and cannot make an exact one either.
//
// bcn-lego-checked: prototype variant. Controls are legos (esa-button-toggle,
// esa-color-picker, esa-switch-toggle, esa-radio-group via kit.ts; esa-button
// for Back). Two pieces have no lego: the floating plate — the production
// project map documents the same gap (no floating-surface lego; esa-popover
// needs a trigger, esa-card is a page section) — and the legend's rows, which
// are navigation rows (mark, name, chevron) and so are native buttons; the
// only row-shaped lego, esa-dropdown-menu's item, lives inside a menu. Beacon
// is not cloned.
//
// THREE TAKES ON THE BASE MAP (round two — the direction picked was Legend,
// with Studio's always-there base map switch):
//   row       the base map is one more legend row (round one, unchanged)
//   switch    the switch is pinned to the top of the legend, in both views, so
//             a colour is judged on Satellite one click after it is picked
//   per-base  the same switch, and each base map KEEPS ITS OWN colours and
//             styles: switching swaps the set in (kit.ts, switchBase)
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  base?: 'row' | 'switch' | 'per-base';
}
const { base = 'row' } = Astro.props;
---
<section class="proto-legend" data-proto-variant data-base={base} hidden>
  <div class="proto-legend__map" data-canvas role="img" aria-label="Preview of the workspace map"></div>
  <div class="proto-legend__plate stack" data-gap="sm">
    {base !== 'row' && <div class="proto-legend__base" data-base-switch></div>}
    <div class="stack" data-gap="2xs" data-list>
      <h1 class="typography-title-sm-strong proto-legend__title">Map layers</h1>
      <div class="stack" data-gap="2xs" data-rows></div>
    </div>
    <div class="stack" data-gap="md" data-detail hidden>
      <div class="cluster" data-gap="xs">
        <span data-back><EsaButton variant="chrome" size="md" iconOnly icon="arrow-left" label="Back to layers" /></span>
        <h2 class="typography-title-sm-strong proto-legend__title" data-detail-title tabindex="-1"></h2>
      </div>
      <div data-detail-body></div>
    </div>
  </div>
</section>

<style>
  .proto-legend {
    position: relative;
    isolation: isolate;
  }

  .proto-legend__map {
    block-size: calc(100dvh - 6rem);
    min-block-size: 32rem;
  }

  /* Author display rules (.stack) out-rank the UA's [hidden]. */
  .proto-legend [hidden] {
    display: none !important;
  }

  .proto-legend__plate {
    position: absolute;
    inset-block-start: var(--spacing-400);
    /* The trailing edge: Leaflet's zoom control owns the leading corner. */
    inset-inline-end: var(--spacing-400);
    z-index: 1000; /* above Leaflet's own panes (max 800) inside this isolated section */
    inline-size: min(23rem, calc(100% - 2 * var(--spacing-400)));
    max-block-size: calc(100% - 2 * var(--spacing-400));
    overflow-y: auto;
    padding: var(--spacing-300);
    border: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #d9d9d9);
    border-radius: var(--radius-lg, 0.75rem);
    background: var(--color-background-elevation-floating, #fcfcfc);
    box-shadow: var(--elevation-2, 0 2px 12px rgb(0 0 0 / 0.08));
  }

  .proto-legend__base {
    padding: var(--spacing-200) var(--spacing-200) var(--spacing-300);
    border-block-end: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #d9d9d9);
  }

  .proto-legend__title {
    margin: 0;
    padding-inline: var(--spacing-200);
  }

  .proto-legend__title:focus {
    outline: none;
  }

  .proto-legend [data-list] > .proto-legend__title {
    padding-block: var(--spacing-200);
  }

  .proto-legend [data-detail-body] {
    padding: 0 var(--spacing-200) var(--spacing-200);
  }

  .proto-legend :global(.proto-legend__row) {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
    inline-size: 100%;
    min-block-size: 2.75rem;
    padding-inline: var(--spacing-200);
    border: 0;
    border-radius: var(--radius-md, 0.5rem);
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
    touch-action: manipulation;
  }

  @media (hover: hover) and (pointer: fine) {
    .proto-legend :global(.proto-legend__row:hover) {
      background: var(--color-background-elevation-sunken, #f5f5f5);
    }
  }

  .proto-legend :global(.proto-legend__row:focus-visible) {
    outline: 2px solid var(--color-border-focus, currentColor);
    outline-offset: -2px;
  }

  .proto-legend :global(.proto-legend__name) {
    flex: 1;
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .proto-legend :global(.proto-legend__off) {
    color: var(--color-content-default-secondary, #646464);
  }

  .proto-legend :global(.proto-legend__chevron) {
    flex: none;
    color: var(--color-content-default-secondary, #646464);
  }
</style>

<script>
  import { glyph } from '../../lib/leaflet';
  import {
    BASEMAPS,
    FILLS,
    LINE_STYLES,
    MAP_SWATCHES,
    WEIGHTS,
    areaHex,
    box,
    lego,
    lineStyleOf,
    nearest,
    onGeoChange,
    onShown,
    switchBase,
    patchLayer,
    patchMapStyle,
    reachHex,
    readLayers,
    readMapStyle,
    styleable,
    swatch,
    workSwatch,
  } from './kit';
  import type { LineStyle, ReferenceLayer } from './kit';

  document.querySelectorAll<HTMLElement>('.proto-legend').forEach((root) => {
    const $ = (sel: string) => root.querySelector<HTMLElement>(sel)!;
    const rows = $('[data-rows]');
    const mode = root.dataset.base ?? 'row';
    let lastKey = '';
    // The open detail view, as a way to rebuild it: a base-map switch can
    // change every value it is showing.
    let reopen: (() => void) | null = null;

    const pickColor = (label: string, value: string, set: (hex: string) => void) =>
      lego('esa-color-picker', { label, size: 'md', 'show-input': 'false' }, { value, swatches: MAP_SWATCHES }, (el) => set(String(el.value)));

    const layerBody = (layer: ReferenceLayer) =>
      box(
        'stack',
        'md',
        ...(styleable(layer)
          ? [
              pickColor('Color', layer.stroke, (hex) => patchLayer(layer.id, { stroke: hex, fill: hex })),
              lego('esa-button-toggle', { label: 'Line', size: 'md' }, { options: LINE_STYLES, value: lineStyleOf(layer) }, (el) => patchLayer(layer.id, { strokeStyle: String(el.value) as LineStyle })),
              lego('esa-button-toggle', { label: 'Weight', size: 'md' }, { options: WEIGHTS, value: nearest(WEIGHTS, layer.strokeWidth) }, (el) => patchLayer(layer.id, { strokeWidth: Number(el.value) })),
              lego('esa-button-toggle', { label: 'Fill', size: 'md' }, { options: FILLS, value: nearest(FILLS, layer.fillOpacity) }, (el) => patchLayer(layer.id, { fillOpacity: Number(el.value) })),
              lego('esa-switch-toggle', { label: 'Names on the map' }, { checked: Boolean(layer.showLabels) }, (el) => patchLayer(layer.id, { showLabels: Boolean(el.checked) })),
            ]
          : [Object.assign(document.createElement('p'), { className: 'typography-body-md', textContent: 'The publisher sets this layer’s colors.' })]),
        lego('esa-switch-toggle', { label: 'Available on maps' }, { checked: layer.active }, (el) => patchLayer(layer.id, { active: Boolean(el.checked) })),
      );

    const workBody = () =>
      box(
        'stack',
        'md',
        pickColor('Areas and points', areaHex(), (hex) => patchMapStyle({ areaColor: hex })),
        pickColor('Reaches', reachHex(), (hex) => patchMapStyle({ reachColor: hex })),
        lego('esa-button-toggle', { label: 'Area fill', size: 'md' }, { options: FILLS, value: nearest(FILLS, readMapStyle().areaFillOpacity) }, (el) => patchMapStyle({ areaFillOpacity: Number(el.value) })),
      );

    const baseBody = () =>
      lego('esa-radio-group', { label: 'Shown when a map opens', size: 'md' }, { options: BASEMAPS, value: readMapStyle().basemap }, (el) => patchMapStyle({ basemap: el.value as never }));

    const open = (key: string, title: string, body: HTMLElement) => {
      lastKey = key;
      const makers: Record<string, () => HTMLElement> = { work: workBody, base: baseBody };
      reopen = () => {
        const layer = readLayers().find((l) => l.id === key);
        $('[data-detail-body]').replaceChildren(layer ? layerBody(layer) : makers[key]());
      };
      $('[data-detail-title]').textContent = title;
      $('[data-detail-body]').replaceChildren(body);
      $('[data-list]').hidden = true;
      $('[data-detail]').hidden = false;
      $('[data-detail-title]').focus();
    };
    const close = () => {
      reopen = null;
      $('[data-detail]').hidden = true;
      $('[data-list]').hidden = false;
      paint();
      rows.querySelector<HTMLElement>(`[data-key="${lastKey}"]`)?.focus();
    };
    $('[data-back]').addEventListener('click', close);
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !$('[data-detail]').hidden) close();
    });

    const row = (key: string, name: string, mark: HTMLElement | null, onOpen: () => void, muted = false) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'proto-legend__row typography-body-md';
      b.dataset.key = key;
      const label = document.createElement('span');
      label.className = `proto-legend__name${muted ? ' proto-legend__off' : ''}`;
      label.textContent = name;
      const chevron = document.createElement('span');
      chevron.className = 'proto-legend__chevron';
      chevron.innerHTML = glyph('chevron-right');
      b.append(...(mark ? [mark] : []), label, chevron);
      b.addEventListener('click', onOpen);
      return b;
    };

    const paint = () => {
      if ($('[data-list]').hidden) return;
      const base = BASEMAPS.find((b) => b.value === readMapStyle().basemap)!;
      rows.replaceChildren(
        row('work', 'Work areas', workSwatch(), () => open('work', 'Work areas', workBody())),
        ...readLayers().map((layer) =>
          row(layer.id, layer.name, swatch(layer), () => open(layer.id, layer.name, layerBody(readLayers().find((l) => l.id === layer.id)!)), !layer.active),
        ),
        ...(mode === 'row'
          ? [
              row('base', `Base map: ${base.label}`, Object.assign(document.createElement('span'), { className: 'proto-swatch proto-swatch--icon', innerHTML: glyph('map') }), () =>
                open('base', 'Base map', baseBody()),
              ),
            ]
          : []),
      );
    };
    paint();
    onGeoChange(paint);

    if (mode !== 'row') {
      const toggle = lego(
        'esa-button-toggle',
        { label: 'Base map', size: 'md', ...(mode === 'per-base' ? { 'help-text': 'Each base map keeps its own colors.' } : {}) },
        { options: BASEMAPS, value: readMapStyle().basemap },
        (el) => {
          switchBase(el.value as never, mode === 'per-base');
          reopen?.();
        },
      );
      $('[data-base-switch]').append(toggle);
      // Another variant (or window) may have switched it.
      onGeoChange(() => (toggle.value = readMapStyle().basemap));
    }

    onShown(root, $('[data-canvas]'));
  });
</script>
