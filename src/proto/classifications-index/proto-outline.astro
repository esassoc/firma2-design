---
// PROTOTYPE — variant "Outline" of /proto/classifications-index: the whole
// classification tree as ONE table. A row per group and per classification,
// indented by depth; columns of counts that compare down the page; and one
// ring per performance measure, so a row shows how many measures a goal has
// and how far each is. A classification's row opens to its measures, each
// with its figure. Throwaway; nothing in production imports it.
//
// AXIS: density. Everything on one screen, compared down columns.
//
// bcn-lego-checked: prototype variant — a plain <table> (no esa- table lego
// exists; firma2-settings-table's and firma2-classification-measures' finding),
// esa-button the chevrons, bcn-progress-ring every ring, firma2-project-peek-
// button the side-panel door. Beacon is not cloned on this machine.
import EsaButton from '@esa/ecology/esa-button.astro';
import BcnProgressRing from '../../components/shared/bcn-progress-ring.astro';
import Firma2ProjectPeekButton from '../../components/projects/firma2-project-peek-button.astro';
import { tree } from './tree';
import type { ClassificationNode, GroupNode } from './tree';

type Row =
  | { kind: 'group'; node: GroupNode; depth: number; parents: string[] }
  | { kind: 'classification'; node: ClassificationNode; depth: number; parents: string[] };

// Tree order: a group, its own classifications, then the groups inside it.
const rowsOf = (g: GroupNode, parents: string[]): Row[] => [
  { kind: 'group', node: g, depth: g.depth, parents },
  ...g.classifications.map((c): Row => ({ kind: 'classification', node: c, depth: g.depth + 1, parents: [...parents, g.slug] })),
  ...g.groups.flatMap((child) => rowsOf(child, [...parents, g.slug])),
];
const rows = tree().flatMap((g) => rowsOf(g, []));
---
<div class="proto-outline" data-proto-outline>
  <div class="proto-outline__scroll">
    <table class="proto-outline__table">
      <caption class="visually-hidden">Classifications, by group</caption>
      <thead>
        <tr>
          <th scope="col">Classification</th>
          <th scope="col" class="proto-outline__num">Projects</th>
          <th scope="col" class="proto-outline__num">Funders</th>
          <th scope="col">Performance measures</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) =>
          row.kind === 'group' ? (
            <tr class="proto-outline__group" data-row={`g:${row.node.slug}`} data-parents={row.parents.join(' ')}>
              <th scope="row" style={`--depth:${row.depth}`}>
                <span class="proto-outline__name">
                  <span class="proto-outline__toggle" data-toggle>
                    <EsaButton variant="chrome" iconOnly icon="chevron-down" size="sm" aria-label={`Hide ${row.node.name}`} aria-expanded="true">Hide</EsaButton>
                  </span>
                  <span class="proto-outline__swatch" style={`background:${row.node.color}`} aria-hidden="true"></span>
                  <a class="proto-outline__link" href={row.node.href}>{row.node.name}</a>
                </span>
              </th>
              <td class="proto-outline__num">{row.node.projects}</td>
              <td class="proto-outline__num">{row.node.funders}</td>
              <td class="proto-outline__meta">{`${row.node.total} ${row.node.total === 1 ? 'classification' : 'classifications'}`}</td>
            </tr>
          ) : (
            <Fragment>
              <tr class="proto-outline__item" data-row={`c:${row.node.slug}`} data-parents={row.parents.join(' ')} data-peek-row>
                <th scope="row" style={`--depth:${row.depth}`}>
                  <span class="proto-outline__name">
                    <span class="proto-outline__toggle" data-toggle>
                      {row.node.measures.length > 0 && (
                        <EsaButton variant="chrome" iconOnly icon="chevron-down" size="sm" aria-label={`Show measures for ${row.node.name}`} aria-expanded="false">Show measures</EsaButton>
                      )}
                    </span>
                    <span class="proto-outline__swatch" style={`background:${row.node.color}`} aria-hidden="true"></span>
                    <span class="firma2-peek-pair">
                      <a class="proto-outline__link" href={row.node.href} title={row.node.description}>{row.node.name}</a>
                      <Firma2ProjectPeekButton slug={row.node.slug} name={row.node.name} kind="classification" />
                    </span>
                  </span>
                </th>
                <td class="proto-outline__num">{row.node.projects}</td>
                <td class="proto-outline__num">{row.node.funders}</td>
                <td>
                  {row.node.measures.length === 0 ? (
                    <span class="proto-outline__meta">None yet</span>
                  ) : (
                    <ul class="proto-outline__rings" aria-label={`${row.node.measures.length} performance measures`}>
                      {row.node.measures.map((m) => (
                        <li title={`${m.name}: ${m.total}`}>
                          <BcnProgressRing value={m.percent} secondary={m.plannedPercent} size="xs" decorative={false} label={`${m.name}: ${m.total}`} />
                        </li>
                      ))}
                    </ul>
                  )}
                </td>
              </tr>
              {row.node.measures.map((m) => (
                <tr class="proto-outline__measure" data-measure-of={row.node.slug} data-parents={row.parents.join(' ')} hidden>
                  <th scope="row" style={`--depth:${row.depth + 1}`}>
                    <span class="proto-outline__name">
                      <BcnProgressRing value={m.percent} secondary={m.plannedPercent} size="xs" />
                      <span>{m.name}</span>
                    </span>
                  </th>
                  <td></td>
                  <td></td>
                  <td class="proto-outline__figure">{m.total}</td>
                </tr>
              ))}
            </Fragment>
          ),
        )}
      </tbody>
    </table>
  </div>
</div>

<style>
  .proto-outline__scroll {
    position: relative;
    overflow-x: auto;
  }

  .proto-outline__table {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--typography-body-md-font-size);
    line-height: var(--typography-body-md-line-height);
  }

  .proto-outline__table :global(tr[hidden]) {
    display: none;
  }

  .proto-outline__table :global(th),
  .proto-outline__table :global(td) {
    padding-block: var(--spacing-200, 0.5rem);
    padding-inline: var(--spacing-300, 0.75rem);
    text-align: start;
    vertical-align: middle;
    font-weight: inherit;
  }

  .proto-outline__table thead :global(th) {
    color: var(--color-content-default-secondary, #646464);
    font-weight: var(--font-weight-semibold, 600);
    white-space: nowrap;
    border-block-end: var(--border-width-default, 1px) solid var(--color-border-default, #cecece);
  }

  .proto-outline__table tbody :global(tr) > :global(*) {
    border-block-end: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #d9d9d9);
  }

  /* One step in per level; the first column's own padding is the base. */
  .proto-outline__table tbody :global(th) {
    padding-inline-start: calc(var(--depth, 0) * var(--spacing-600, 1.5rem));
    min-inline-size: 18rem;
  }

  .proto-outline__name {
    display: flex;
    align-items: center;
    gap: var(--spacing-200, 0.5rem);
    min-inline-size: 0;
  }

  /* The chevron's column holds its width on rows with nothing to open, so
     names at one depth start on one line. */
  .proto-outline__toggle {
    flex: none;
    inline-size: 28px;
    block-size: 28px;
    line-height: 0;
  }

  .proto-outline__toggle :global(.esa-button__native) {
    block-size: 28px;
    inline-size: 28px;
    padding: 0;
  }

  @media (pointer: coarse) {
    .proto-outline__toggle :global(.esa-button__native) {
      position: relative;
    }
    .proto-outline__toggle :global(.esa-button__native)::before {
      content: '';
      position: absolute;
      inset: -8px;
    }
  }

  .proto-outline__toggle :global([aria-expanded='true'] svg) {
    transform: rotate(180deg);
  }

  .proto-outline__swatch {
    flex: none;
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border-radius: var(--radius-sm, 4px);
  }

  .proto-outline__link {
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .proto-outline__link:hover {
      text-decoration: underline;
    }
  }

  .proto-outline__group :global(th) {
    font-weight: var(--font-weight-semibold, 600);
  }

  .proto-outline__group > :global(*) {
    background: var(--color-background-elevation-sunken, #f4f4f4);
  }

  .proto-outline__num {
    inline-size: 6rem;
    text-align: end !important;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .proto-outline__meta,
  .proto-outline__measure > :global(*) {
    color: var(--color-content-default-secondary, #646464);
  }

  .proto-outline__figure {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .proto-outline__rings {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-200, 0.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .proto-outline__rings :global(li) {
    display: flex;
  }
</style>

<script>
  // Groups fold their whole branch; a classification unfolds its measures.
  document.querySelectorAll<HTMLElement>('[data-proto-outline]').forEach((root) => {
    const rows = [...root.querySelectorAll<HTMLTableRowElement>('tbody tr')];
    const closed = new Set<string>();
    const open = new Set<string>();

    const paint = (): void => {
      for (const tr of rows) {
        const parents = (tr.dataset.parents ?? '').split(' ').filter(Boolean);
        const folded = parents.some((p) => closed.has(p));
        const of = tr.dataset.measureOf;
        tr.hidden = folded || (of != null && !open.has(of));
      }
    };

    root.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-toggle] button, [data-toggle] [aria-expanded]');
      const tr = button?.closest<HTMLTableRowElement>('tr');
      if (!button || !tr) return;
      const [kind, slug] = (tr.dataset.row ?? '').split(':');
      const name = tr.querySelector('.proto-outline__link')?.textContent ?? '';
      const set = kind === 'g' ? closed : open;
      if (set.has(slug)) set.delete(slug);
      else set.add(slug);
      const expanded = kind === 'g' ? !closed.has(slug) : open.has(slug);
      const toggle = tr.querySelector<HTMLElement>('[data-toggle] [aria-expanded]');
      toggle?.setAttribute('aria-expanded', String(expanded));
      toggle?.setAttribute('aria-label', kind === 'g' ? `${expanded ? 'Hide' : 'Show'} ${name}` : `${expanded ? 'Hide' : 'Show'} measures for ${name}`);
      paint();
    });
  });
</script>
