---
// PROTOTYPE — variant "Browse" of /proto/classifications-index: the tree is
// a list of groups down the leading edge, and the page shows ONE group at a
// time — its description and counts, then every classification beneath it
// with every measure drawn in full (ring, name, "14.5 of 30 miles goal").
// Throwaway; nothing in production imports it.
//
// AXIS: interaction model. Pick a branch, read it whole; nothing else on screen.
//
// The chosen group is kept in the URL's hash, so a reload — and a link —
// lands on the same branch.
//
// bcn-lego-checked: prototype variant — esa-button each group in the list and
// the door, firma2-kpi-progress each measure (the classification peek's own
// row), firma2-project-peek-button the side-panel door; layout is a two-track
// grid with the list held in view. No esa- lego is a tree of selectable
// branches (esa-sidebar-nav is page navigation, with hrefs). Beacon is not
// cloned on this machine.
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2KpiProgress from '../../components/classifications/firma2-kpi-progress.astro';
import Firma2ProjectPeekButton from '../../components/projects/firma2-project-peek-button.astro';
import { flatGroups, plural } from './tree';
import type { ClassificationNode, GroupNode } from './tree';

const groups = flatGroups();

// A group's classifications, its own first, then each group inside it under
// that group's name.
type Block = { heading?: GroupNode; items: ClassificationNode[] };
const blocksOf = (g: GroupNode, top = true): Block[] => [
  ...(g.classifications.length ? [{ heading: top ? undefined : g, items: g.classifications }] : []),
  ...g.groups.flatMap((child) => blocksOf(child, false)),
];
---
<div class="proto-columns" data-proto-columns>
  <nav class="proto-columns__nav" aria-label="Classification groups">
    <ul class="proto-columns__list">
      {groups.map((g) => (
        <li style={`--depth:${g.depth}`} data-browse-nav={g.slug}>
          <EsaButton variant="ghost" size="md" data-pick={g.slug}>
            <span class="proto-columns__pick">
              <span class="proto-columns__swatch" style={`background:${g.color}`} aria-hidden="true"></span>
              <span class="proto-columns__pick-name">{g.name}</span>
              <span class="proto-columns__pick-count" aria-label={plural(g.total, 'classification')}>{g.total}</span>
            </span>
          </EsaButton>
        </li>
      ))}
    </ul>
  </nav>

  <div class="proto-columns__detail">
    {groups.map((g) => (
      <section class="stack" data-gap="xl" aria-labelledby={`browse-${g.slug}`} data-detail={g.slug} hidden>
        <header class="stack" data-gap="sm">
          <div class="repel" data-gap="sm">
            <h2 class="typography-title-strong" id={`browse-${g.slug}`}>{g.name}</h2>
            <EsaButton variant="secondary" size="md" tag="a" href={g.href}>Open group</EsaButton>
          </div>
          <p class="proto-columns__description typography-body-md">{g.description}</p>
          <p class="proto-columns__meta typography-body-md">
            {`${plural(g.total, 'classification')} · ${plural(g.projects, 'project')} · ${plural(g.funders, 'funder')}`}
          </p>
        </header>
        {blocksOf(g).map((block) => (
          <div class="stack" data-gap="md">
            {block.heading && <h3 class="proto-columns__sub typography-title-sm-strong">{block.heading.path.slice(g.path.length).join(' › ')}</h3>}
            <ul class="proto-columns__items">
              {block.items.map((c) => (
                <li class="proto-columns__item stack" data-gap="md" data-peek-row>
                  <div class="stack" data-gap="3xs">
                    <div class="firma2-peek-pair">
                      <h4 class="proto-columns__name typography-label-md-strong">
                        <a class="proto-columns__link" href={c.href}>
                          <span class="proto-columns__swatch" style={`background:${c.color}`} aria-hidden="true"></span>
                          <span>{c.name}</span>
                        </a>
                      </h4>
                      <Firma2ProjectPeekButton slug={c.slug} name={c.name} kind="classification" />
                    </div>
                    <p class="proto-columns__description typography-body-md">{c.description}</p>
                    <p class="proto-columns__meta typography-body-sm">{`${plural(c.projects, 'project')} · ${plural(c.funders, 'funder')}`}</p>
                  </div>
                  {c.measures.length === 0 ? (
                    <p class="proto-columns__meta typography-body-md">No performance measures yet</p>
                  ) : (
                    <ul class="proto-columns__measures grid" data-gap="lg">
                      {c.measures.map((m) => (
                        <li><Firma2KpiProgress name={m.name} {...m.input} from={[]} /></li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </div>
</div>

<style>
  .proto-columns {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: var(--spacing-800, 2rem);
    align-items: start;
  }

  .proto-columns [hidden] {
    display: none !important;
  }

  /* The list stays in view while a long branch scrolls. */
  .proto-columns__nav {
    position: sticky;
    inset-block-start: calc(var(--firma2-sticky-origin, 0px) + var(--spacing-400, 1rem));
  }

  @media (max-width: 45rem) {
    .proto-columns {
      grid-template-columns: minmax(0, 1fr);
    }
    .proto-columns__nav {
      position: static;
    }
  }

  .proto-columns__list,
  .proto-columns__items,
  .proto-columns__measures {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .proto-columns__list :global(li) {
    padding-inline-start: calc(var(--depth, 0) * var(--spacing-400, 1rem));
  }

  /* Each group fills its row, its name at the leading edge. */
  .proto-columns__list :global(.esa-button),
  .proto-columns__list :global(.esa-button__native) {
    display: flex;
    inline-size: 100%;
    justify-content: flex-start;
  }

  .proto-columns__list :global(.esa-button__label) {
    flex: 1 1 auto;
    min-inline-size: 0;
  }

  .proto-columns__list :global(li[data-selected]) :global(.esa-button__native) {
    background: var(--color-background-elevation-sunken, #f0f0f0);
    color: var(--color-content-default, #202020);
  }

  .proto-columns__pick {
    display: flex;
    align-items: center;
    gap: var(--spacing-200, 0.5rem);
    inline-size: 100%;
    min-inline-size: 0;
  }

  .proto-columns__pick-name {
    flex: 1 1 auto;
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: start;
  }

  .proto-columns__pick-count {
    flex: none;
    color: var(--color-content-default-secondary, #646464);
    font-variant-numeric: tabular-nums;
  }

  .proto-columns__swatch {
    flex: none;
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border-radius: var(--radius-sm, 4px);
  }

  .proto-columns__description,
  .proto-columns__meta,
  .proto-columns__name,
  .proto-columns__sub {
    margin: 0;
  }

  .proto-columns__description {
    max-inline-size: 60ch;
  }

  .proto-columns__description,
  .proto-columns__meta {
    color: var(--color-content-default-secondary, #646464);
  }

  .proto-columns__item {
    padding-block: var(--spacing-500, 1.25rem);
    border-block-start: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #d9d9d9);
  }

  .proto-columns__measures {
    --grid-min: 18rem;
  }

  /* Swatch beside the first line, however far the name wraps. */
  .proto-columns__link {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-200, 0.5rem);
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .proto-columns__link:hover {
      text-decoration: underline;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-proto-columns]').forEach((root) => {
    const details = [...root.querySelectorAll<HTMLElement>('[data-detail]')];
    const slugs = details.map((d) => d.dataset.detail ?? '');

    const select = (slug: string, remember = true): void => {
      const chosen = slugs.includes(slug) ? slug : slugs[0];
      for (const d of details) d.hidden = d.dataset.detail !== chosen;
      root.querySelectorAll<HTMLElement>('[data-browse-nav]').forEach((li) => {
        const on = li.dataset.browseNav === chosen;
        li.toggleAttribute('data-selected', on);
        const button = li.querySelector('button');
        if (on) button?.setAttribute('aria-current', 'true');
        else button?.removeAttribute('aria-current');
      });
      if (remember) history.replaceState(null, '', `#${chosen}`);
    };

    root.addEventListener('click', (event) => {
      const pick = (event.target as HTMLElement).closest<HTMLElement>('[data-browse-nav]');
      if (pick && (event.target as HTMLElement).closest('button')) select(pick.dataset.browseNav ?? '');
    });

    select(decodeURIComponent(location.hash.slice(1)), false);
  });
</script>
