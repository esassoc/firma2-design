---
// Classification detail — one page per classification, the roll-up a
// classification exists to answer. The door the classification chips on a
// project's Key facts open, and the page a program manager sends a funder
// who asks "what has the partnership done for salmon?".
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "How far along is this goal, KPI by KPI, and which
//    projects are moving it?"
// 2. READERS: program staff reading the totals; the executive asking whether
//    a goal is on track; a partner arriving from a project chip. WHO IS NOT
//    HERE: the administrator — KPIs and targets are set in the measure
//    catalog and Workspace settings.
// 3. SERIES/SCALAR: the description and four totals are scalars, stated once
//    at the top; the measures are the series and lead the body; the projects
//    are a homogeneous list — the portfolio grid, filtered.
// 4. IRREVERSIBLE: nothing. The page reads; every figure is derived from the
//    project records it lists.
// 5. CUT: a map of these projects (the portfolio map is one page-sized
//    instance, not a component a page can filter — a seam for later), a
//    spend-by-year chart (each project's chart already answers it at the
//    scale where it means something), a funder → project sankey (see
//    firma2-classification-funding for why bars won), and editing the
//    classification in place (it would make this a second studio).
//
// Funders sit LAST: the funder a program manager sends here reads the KPIs
// first and asks "how much of that was us?" second.
//
// Same spine as the Projects index — a docked peek beside a capped stack —
// because the grid's peek buttons open firma2-project-peek and need it on the
// page. Zero page CSS.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2ProjectPeekLayout from '../../../components/projects/firma2-project-peek-layout.astro';
import Firma2ClassificationSummary from '../../../components/classifications/firma2-classification-summary.astro';
import Firma2ClassificationMeasures from '../../../components/classifications/firma2-classification-measures.astro';
import Firma2ClassificationProjects from '../../../components/classifications/firma2-classification-projects.astro';
import Firma2ClassificationFunding from '../../../components/classifications/firma2-classification-funding.astro';
import EsaPill from '@esa/ecology/esa-pill.astro';
import { CLASSIFICATIONS, CLASSIFICATION_GROUPS } from '../../../data/firma2-classifications';
import type { Classification } from '../../../data/firma2-classifications';
import { rollupClassification } from '../../../data/firma2-classification-rollup';
import { withBase } from '../../../lib/base';

export function getStaticPaths() {
  return CLASSIFICATIONS.map((classification) => ({ params: { classification: classification.slug }, props: { classification } }));
}

interface Props {
  classification: Classification;
}

const { classification } = Astro.props;
const group = CLASSIFICATION_GROUPS.find((g) => g.slug === classification.group);
const rollup = rollupClassification(classification);
---
<!-- manifest:
  layout: firma2-project-peek-layout > stack(xl)
  sections:
    - project peek  -> firma2-project-peek-layout          (docked rail, opened from a grid row)
    - page header   -> firma2-page-header
    - summary       -> firma2-classification-summary  (description + four totals)
    - KPIs          -> firma2-classification-measures (each KPI against its goal, with its projects)
    - projects      -> firma2-classification-projects (the portfolio grid, filtered)
    - funders       -> firma2-classification-funding  (funding by funder, with the grants as data)
-->
<AppLayout title={`${classification.name} — Classifications — ProjectFirma 2.0`} active="classifications" width="full">
  <Firma2ProjectPeekLayout>
    <div class="stack" data-gap="xl">
      <!-- Back to the classifications index, the goal board this card sits on. -->
      <Firma2PageHeader
        title={classification.name}
        crumbs={[
          { label: 'Classifications', href: withBase('/prototypes/classifications'), aliasable: true },
          { label: classification.name },
        ]}
      >
        {group && <span slot="status" class="visually-hidden">Classification group</span>}
        {group && <EsaPill slot="status" label={group.name} size="md" removable={false} />}
      </Firma2PageHeader>
      <Firma2ClassificationSummary classification={classification} rollup={rollup} />
      <Firma2ClassificationMeasures slug={classification.slug} kpis={rollup.kpis} />
      <Firma2ClassificationProjects projects={rollup.projects} />
      <Firma2ClassificationFunding funding={rollup.funding} projects={rollup.projects} />
    </div>
  </Firma2ProjectPeekLayout>
</AppLayout>
