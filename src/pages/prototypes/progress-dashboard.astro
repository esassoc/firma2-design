---
// Progress Dashboard — the workspace's figures on one screen, assembled by an
// administrator from the inventory of everything the workspace holds.
//
// The brief's questions (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Where does the work stand?" — for whichever projects the
//    filter names.
// 2. READERS: an executive before a hearing, and a funder shown their own
//    projects; the administrator builds it. Hardest: the funder, who shares
//    none of the vocabulary — so a tile is a plain name, a figure and what it
//    is read against. Not here: the project leads who filed the numbers, and
//    whose missing reports change them — every filed figure says how many
//    projects filed of those that owed.
// MODES: it opens to read; Edit (firma2-record-mode) brings out Add chart and
//    each tile's grip (move, edit, duplicate, remove) and size corner.
// 3. SERIES/SCALAR: the tiles are the series; the filter is the one scalar,
//    set once for all of them. No rail — a tile's settings are six fields in
//    a docked sheet, opened only while editing.
// 4. IRREVERSIBLE: nothing. Removing a chart loses its settings and Add chart
//    brings one back; a filter is a view, not a change to any record.
// 5. CUT: prose around the charts, cards and borders, a saved-view picker,
//    per-chart project scopes, counts on every filter option, and — while
//    reading — every control that changes the dashboard's makeup.
// 6. WHO MEETS IT LATER: every reader of the dashboard. What the administrator
//    cannot do is what would cost them: total an average, stack groups that
//    overlap, or hide that half the projects have not filed.
import AppLayout from '../../layouts/AppLayout.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2Dashboard from '../../components/dashboard/firma2-dashboard.astro';
import Firma2RecordMode from '../../components/shared/firma2-record-mode.astro';
import { dashboardTemplate } from '../../data/firma2-dashboards';
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header -> firma2-page-header
    - dashboard   -> firma2-dashboard
-->
<AppLayout title="Progress dashboard — ProjectFirma 2.0" active="progress-dashboard">
  <div class="stack" data-gap="xl">
    <Firma2PageHeader title="Progress dashboard">
      <div slot="actions" class="cluster" data-gap="xs">
        <EsaButton variant="secondary" size="md" icon="plus" data-dashboard-add data-edit-only>Add chart</EsaButton>
        <Firma2RecordMode noun="Dashboard" />
      </div>
    </Firma2PageHeader>
    <Firma2Dashboard template={dashboardTemplate('program-progress')} />
  </div>
</AppLayout>
