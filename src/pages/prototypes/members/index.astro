---
// Members — everyone with an active account in the workspace, and a door to
// each person's page. The READING list, in the app rail's More group; the list
// an administrator runs accounts from (invitations, suspensions, roles) is
// Workspace settings › Users.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Who is in this workspace, and which organization are they with?"
// 2. READERS: program staff and sponsors looking a colleague up; a newcomer
//    working out whom to ask. Hardest: the newcomer, who has a name or an
//    organization and nothing else. WHO IS NOT HERE: the administrator
//    changing a role or chasing an invitation — that is Users.
// 3. SERIES/SCALAR: a homogeneous list of people — one sortable, searchable
//    table, one row each.
// 4. IRREVERSIBLE: nothing; the page reads.
// 5. CUT: invited and suspended accounts (not people a reader can reach; Users
//    has them), last active (an administrator's question), Invite people, and
//    any act on a row.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2MemberGrid from '../../../components/members/firma2-member-grid.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - list        -> firma2-member-grid  (one row per active member)
-->
<AppLayout title="Members — ProjectFirma 2.0" active="members">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Members" />
    <Firma2MemberGrid />
  </div>
</AppLayout>
