---
// Member — one person in the workspace: their role, how to reach them, and
// the organizations they are with. Opened from the Members list, an
// organization's About tab, or a support request.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Who is this person here, and how do I reach them?"
// 2. READERS: anyone signed in who followed a name. Hardest: the newcomer who
//    does not know what a role allows — the role states its reach. WHO IS NOT
//    HERE: the administrator changing the role or suspending the account
//    (Workspace settings › Users), and the manager changing a membership
//    (that organization's Members settings).
// 3. SERIES/SCALAR: scalars (role, email), then one short list — the
//    organizations, each with the role held there.
// 4. IRREVERSIBLE: nothing; the page reads.
// 5. CUT: an activity feed (the projects' change logs name project contacts,
//    not accounts, so there is nothing true to show), last active (an
//    administrator's question, on Users), a photo, a phone number, and the
//    projects of the member's organizations (each organization's page has
//    them).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2MemberRecord from '../../../components/members/firma2-member-record.astro';
import type { WorkspaceUser } from '../../../data/firma2-directory';
import { memberSlug, members } from '../../../data/firma2-members';
import { withBase } from '../../../lib/base';

export function getStaticPaths() {
  return members.map((member) => ({ params: { member: memberSlug(member.name) }, props: { member } }));
}

interface Props {
  member: WorkspaceUser;
}

const { member } = Astro.props;
const crumbs = [{ label: 'Members', href: withBase('/prototypes/members') }, { label: member.name }];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - record      -> firma2-member-record  (About: role, email; Organizations: role in each)
-->
<AppLayout title={`${member.name} — Members — ProjectFirma 2.0`} active="members" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title={member.name} crumbs={crumbs} />
    <Firma2MemberRecord member={member} />
  </div>
</AppLayout>
