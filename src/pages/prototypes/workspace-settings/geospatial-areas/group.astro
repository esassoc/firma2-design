---
// One geospatial area group — what it reads, what it is called, the areas that
// gives and the projects that fall in each, checked against a map.
//
// ONE STATIC ROUTE, the group in the query (`?id=`): groups live in the
// browser's store, seeded ones included, so every section fills itself there
// (the classification `draft` routes' arrangement).
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Is this group filing my projects the way I expect?"
// 2. READERS: the administrator, often with the GIS analyst beside them.
// 3. SERIES/SCALAR: four scalars (layer, name field, name, description), then
//    one series: the areas, each with a project count.
// 4. IRREVERSIBLE: removing the group (confirmed; its layer is untouched).
// 5. CUT: adding, renaming or removing an area (the layer owns them), an
//    area's own page with its description and performance measures, and
//    correcting one project's filing by hand — all still to design.
//
// The pane is not the reading column: the map needs the room, as on Map layers.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2AreaGroupForm from '../../../../components/settings/firma2-area-group-form.astro';
import Firma2AreaGroupAreas from '../../../../components/settings/firma2-area-group-areas.astro';
import Firma2AreaGroupMap from '../../../../components/settings/firma2-area-group-map.astro';
import Firma2AreaGroupRemove from '../../../../components/settings/firma2-area-group-remove.astro';
import { withBase } from '../../../../lib/base';
const crumbs = [
  { label: 'Geospatial areas', href: withBase('/prototypes/workspace-settings/geospatial-areas') },
  { label: 'Area group' },
];
---
<!-- manifest:
  layout: stack(2xl) > sidebar(end): settings stack(2xl) beside the map,
          which drops under them when the pane is cramped (Map layers' arrangement)
  sections:
    - page header -> firma2-page-header
    - map         -> firma2-area-group-map (sticky)
    - details     -> firma2-area-group-form (mode=edit)
    - areas       -> firma2-area-group-areas
    - remove      -> firma2-area-group-remove
-->
<AppLayout title="Area group — Geospatial areas — ProjectFirma 2.0" nav="workspace-settings" active="ws-geospatial-areas">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Area group" crumbs={crumbs} />
    <div class="sidebar" data-side="end" style="--sidebar-width: 26rem; --sidebar-content-min: 50%; --gap: var(--spacing-600)">
      <Firma2AreaGroupMap />
      <div class="stack" data-gap="2xl">
        <Firma2AreaGroupForm mode="edit" />
        <Firma2AreaGroupAreas />
        <Firma2AreaGroupRemove />
      </div>
    </div>
  </div>
</AppLayout>
