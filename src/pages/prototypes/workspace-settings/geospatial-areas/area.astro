---
// One geospatial area — what a person adds to it (a description, a colour,
// the performance measures that track it and a target for each) and the
// projects it holds.
//
// ONE STATIC ROUTE, the area in the query (`?slug=<group>~<area>`): areas are
// a layer's shapes, known only in the browser. The same key holds its details
// and, in the taxonomy store, its measures and targets — which is why the
// classification measures editor serves here unchanged: an area is used like a
// classification (spec decision 1), and a target stays optional.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is this area for, and what are we aiming for in it?"
// 2. READERS: the administrator setting up reporting by area.
// 3. SERIES/SCALAR: two scalars (description, colour), then two series: its
//    performance measures with targets, and its projects.
// 4. IRREVERSIBLE: nothing. An area cannot be removed here; the layer owns it.
// 5. CUT: renaming the area and editing its shape (the layer's), and adding or
//    removing a project by hand (still open, Q-239).
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2AreaDetails from '../../../../components/settings/firma2-area-details.astro';
import Firma2ClassificationKpiEditor from '../../../../components/settings/firma2-classification-kpi-editor.astro';
import { withBase } from '../../../../lib/base';
const list = withBase('/prototypes/workspace-settings/geospatial-areas');
const crumbs = [{ label: 'Geospatial areas', href: list }, { label: 'Area group', href: list }, { label: 'Area' }];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - details     -> firma2-area-details (description, colour; its projects last)
    - measures    -> firma2-classification-kpi-editor (keyed by the area; slotted
                     into the details, between the fields and the projects)
-->
<AppLayout title="Area — Geospatial areas — ProjectFirma 2.0" nav="workspace-settings" active="ws-geospatial-areas" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Area" crumbs={crumbs} />
    <Firma2AreaDetails>
      <Firma2ClassificationKpiEditor />
    </Firma2AreaDetails>
  </div>
</AppLayout>
