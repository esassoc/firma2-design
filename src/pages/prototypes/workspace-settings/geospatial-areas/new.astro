---
// Add geospatial areas — Workspace settings › Geospatial areas › Add geospatial areas.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which layer holds the areas, and what is each one called?"
// 2. READERS: the administrator, often with the GIS analyst beside them.
// 3. SERIES/SCALAR: scalars only — a layer, the field that names its areas,
//    a name and a line of description.
// 4. IRREVERSIBLE: nothing; all four are one edit back on the group's page.
// 5. CUT: setting the layer up (Map layers does, once), and the areas — the
//    new group opens on its own page, where they already are.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2AreaGroupForm from '../../../../components/settings/firma2-area-group-form.astro';
import { withBase } from '../../../../lib/base';
const crumbs = [
  { label: 'Geospatial areas', href: withBase('/prototypes/workspace-settings/geospatial-areas') },
  { label: 'Add geospatial areas' },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - form        -> firma2-area-group-form (mode=new)
-->
<AppLayout title="Add geospatial areas — Geospatial areas — ProjectFirma 2.0" nav="workspace-settings" active="ws-geospatial-areas" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Add geospatial areas" crumbs={crumbs} />
    <Firma2AreaGroupForm mode="new" />
  </div>
</AppLayout>
