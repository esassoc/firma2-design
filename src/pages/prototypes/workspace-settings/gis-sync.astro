---
// GIS sync — an ALTERNATIVE to GIS subscriptions, built to be compared with it.
// The subscription flow picks a mode, asks five decisions and locks the fields a
// layer maintains. This one connects once and lets either side be edited, the
// latest change winning. Both read the same mock ArcGIS; neither touches the
// other's state.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Are my layer and this tracker saying the same thing, and if
//    not, which one do I believe?"
// 2. READERS: the GIS analyst (Marcus), often not a workspace administrator.
//    WHO IS NOT HERE: every project owner whose record a sync can now change
//    from outside, and the ArcGIS administrator whose layer ProjectFirma writes
//    to — the edit-access alert names them before anything is written.
// 3. SERIES/SCALAR: scalars. One connection, a row per field, and a short list
//    of conflicts.
// 4. IRREVERSIBLE: nothing. A sync never deletes, a conflict keeps both values
//    until someone chooses, and Disconnect leaves every project as it is.
// 5. CUT: choosing a second layer, per-project linking and unlinking, and
//    conflict history. Each one is a real need; none is needed to judge the flow.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2GisSync from '../../../components/gis/firma2-gis-sync.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - gis sync    -> firma2-gis-sync
-->
<AppLayout title="GIS sync — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-gis-sync" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="GIS sync" />
    <Firma2GisSync />
  </div>
</AppLayout>
