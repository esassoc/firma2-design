---
// Project types — a Workspace settings section. What kinds of work the
// workspace files; each type decides what its projects are asked and how
// their pages are built. Each opens its studio. One per project — these were
// the Work type classifications until 2026-10-03.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What kinds of work do we file, and what does each ask?"
// 2. READERS: the tenant's administrator, rarely; ESA's delivery lead, who
//    holds every tenant's setup in their head.
// 3. SERIES/SCALAR: a homogeneous list — one table.
// 4. IRREVERSIBLE: nothing on this screen; the studio prices fields.
// 5. CUT: reordering types.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { withBase } from '../../../lib/base';
import Firma2ProjectTypeRoster from '../../../components/settings/firma2-project-type-roster.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - roster      -> firma2-project-type-roster
-->
<AppLayout title="Project types — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-project-types" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Project types">
      <EsaButton slot="actions" variant="primary" tag="a" href={withBase('/prototypes/workspace-settings/project-types/new')}>Add project type</EsaButton>
    </Firma2PageHeader>
    <Firma2ProjectTypeRoster />
  </div>
</AppLayout>
