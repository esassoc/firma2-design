---
// Project types — the kinds of work this tenant tracks, each with its own
// fields and its own public page. Ported from ProjectFirma2 hackathon team 3.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What kinds of project do we track, and how do they
//    differ?"
// 2. READERS: the tenant's administrator, rarely; ESA's delivery lead, who
//    has to hold every tenant's setup in their head. Hardest: an admin who
//    set this up two years ago. Nothing here assumes they remember.
// 3. SERIES/SCALAR: a homogeneous list — a table.
// 4. IRREVERSIBLE: nothing on this screen; the studio prices fields.
// 5. CUT: create and delete of types (a type is structure a delivery
//    conversation sets up, and a seam left for later), icons per type (the
//    swatch already tells them apart).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2TypeRoster from '../../../components/settings/firma2-type-roster.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - roster      -> firma2-type-roster
-->
<AppLayout title="Project types — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-project-types" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Project types" />
    <Firma2TypeRoster />
  </div>
</AppLayout>
