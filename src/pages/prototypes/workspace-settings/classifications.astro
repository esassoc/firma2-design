---
// Classifications — a Workspace settings section.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What goals can a project be tagged with, and how is the portfolio spread across them?"
// 2. READERS: the administrator and the program manager. Hardest: a sponsor reading the counts as a portfolio balance.
// 3. SERIES/SCALAR: a homogeneous list — a table. Counts come from the project list.
// 4. IRREVERSIBLE: nothing; removing a goal in use is not offered.
// 5. CUT: a second classification system and nesting.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2SettingsTable from '../../../components/settings/firma2-settings-table.astro';
import { classifications } from '../../../data/firma2-workspace-settings';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - list        -> firma2-settings-table
-->
<AppLayout title="Classifications — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-classifications" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Classifications" />
    <Firma2SettingsTable label="Classifications" nameLabel="Goal" columns={[{ key: 'projects', label: 'Projects', numeric: true }]} rows={classifications} />
  </div>
</AppLayout>
