---
// Classifications — a Workspace settings section. The goals the workspace
// tracks (or other groupings, like a species), sorted into classification
// groups, with the KPIs and targets that measure each. Kinds of work are
// Project types and functional labels are Tags; both have their own pages.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which goals do we track, and is each one measurable?"
// 2. READERS: the tenant's administrator; ESA's delivery lead setting up a
//    tenant. Hardest: a program manager reading a goal with no KPIs.
// 3. SERIES/SCALAR: homogeneous lists, one per group — tables.
// 4. IRREVERSIBLE: nothing on this screen.
// 5. CUT: editing KPIs and targets in the table (each classification's own
//    page does that), and renaming a group in place (its own page does that).
//
// ADDS: the header adds a GROUP; each group adds its own classifications, so
// a classification is always added into the group it belongs to.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { withBase } from '../../../lib/base';
import Firma2ClassificationRoster from '../../../components/settings/firma2-classification-roster.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - roster      -> firma2-classification-roster
-->
<AppLayout title="Classifications — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-classifications" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Classifications">
      <EsaButton slot="actions" variant="primary" size="md" tag="a" href={withBase('/prototypes/workspace-settings/classifications/groups/new')}>Add group</EsaButton>
    </Firma2PageHeader>
    <Firma2ClassificationRoster />
  </div>
</AppLayout>
