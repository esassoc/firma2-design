---
// Roles and permissions — a Workspace settings section.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Who can do what in this workspace?"
// 2. READERS: the administrator. Hardest: a steward asking why a contributor cannot approve their own update.
// 3. SERIES/SCALAR: a small matrix — roles down, permissions across, as a table.
// 4. IRREVERSIBLE: granting Administrator; assignment lives with people, not here.
// 5. CUT: custom roles and per-project overrides.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2SettingsTable from '../../../components/settings/firma2-settings-table.astro';
import { roles } from '../../../data/firma2-workspace-settings';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - list        -> firma2-settings-table
-->
<AppLayout title="Roles and permissions — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-roles" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Roles and permissions" />
    <Firma2SettingsTable label="Roles and permissions" nameLabel="Role" columns={[{ key: 'people', label: 'People', numeric: true }, { key: 'edit', label: 'Can edit' }, { key: 'approve', label: 'Approves updates' }, { key: 'settings', label: 'Manages settings' }]} rows={roles} />
  </div>
</AppLayout>
