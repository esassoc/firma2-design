---
// Funding source fields — a Workspace settings section.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does this workspace record about each funding source?"
// 2. READERS: the administrator and finance staff. Hardest: a grants manager checking that match requirements are captured.
// 3. SERIES/SCALAR: a homogeneous list — a table.
// 4. IRREVERSIBLE: deleting a field with data in it; not offered here.
// 5. CUT: per-funder field sets.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2SettingsTable from '../../../components/settings/firma2-settings-table.astro';
import { fundingSourceFields } from '../../../data/firma2-workspace-settings';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - list        -> firma2-settings-table
-->
<AppLayout title="Funding source fields — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-funding-fields" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Funding source fields" />
    <Firma2SettingsTable label="Funding source fields" nameLabel="Field" columns={[{ key: 'kind', label: 'Type' }, { key: 'required', label: 'Required' }]} rows={fundingSourceFields} />
  </div>
</AppLayout>
