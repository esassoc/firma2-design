---
// Branding — the tenant's colour, priced in legibility, previewed on a public
// page. Ported from ProjectFirma2 hackathon team 3.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does our site look like, and can everyone read it?"
// 2. READERS: the tenant's administrator. WHO IS NOT HERE: every reader of
//    the tenant's pages — the contrast card speaks for them.
// 3. SERIES/SCALAR: one scalar (a colour) and its consequences.
// 4. IRREVERSIBLE: nothing; the house colour is one click away.
// 5. CUT: fonts, a second text colour, logo and display name (see the
//    component header), and Save.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2TenantBranding from '../../../components/settings/firma2-tenant-branding.astro';
import { withBase } from '../../../lib/base';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - branding    -> firma2-tenant-branding
-->
<AppLayout title="Branding — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-branding">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Branding" />
    <Firma2TenantBranding previewHref={withBase('/prototypes/public/deer-creek-riparian-corridor-enhancement')} />
  </div>
</AppLayout>
