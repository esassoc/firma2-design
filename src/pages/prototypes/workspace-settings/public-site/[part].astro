---
// Public site — Workspace settings › Look and language. Five parts, each its
// own address: Home page, Navigation, Theme, Footer, Site details.
// Spec: .scratch/public-site-settings/spec.md.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does the public see when they arrive, and is it ours?"
// 2. READERS: the workspace's administrator, setting the site up and returning
//    when there is news. Hardest: the one with no web experience, who must not
//    be able to break the page or publish half an edit. WHO IS NOT HERE: every
//    public reader — the preview stands in for them at two widths, and the
//    contrast table speaks for the ones who read with difficulty.
// 3. SERIES/SCALAR: a short ordered series (sections, bar items) and scalars
//    (each section's choices, fonts, three colour roles).
// 4. IRREVERSIBLE: Publish changes what the public sees, so nothing is live
//    until it is pressed; Discard changes asks first. Removing a written block
//    deletes its words — Discard is the way back.
// 5. CUT: free fonts and free colours (closed lists, so contrast can be
//    checked), typed figures (the site computes them), a second brand colour
//    (Branding owns it), per-section spacing and layout knobs, custom domain,
//    analytics, languages, and the same builder for other public pages.
import AppLayout from '../../../../layouts/AppLayout.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2IconAction from '../../../../components/shared/firma2-icon-action.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2PublicSiteStudio from '../../../../components/public-site/firma2-public-site-studio.astro';
import Firma2PublicSiteHome from '../../../../components/public-site/firma2-public-site-home.astro';
import Firma2PublicSiteNavigation from '../../../../components/public-site/firma2-public-site-navigation.astro';
import Firma2PublicSiteTheme from '../../../../components/public-site/firma2-public-site-theme.astro';
import Firma2PublicSiteFooter from '../../../../components/public-site/firma2-public-site-footer.astro';
import Firma2PublicSiteDetails from '../../../../components/public-site/firma2-public-site-details.astro';
import { PUBLIC_HOME_HREF } from '../../../../data/firma2-public-site';
import { PUBLIC_SITE_PARTS, publicSitePartHref } from '../../../../lib/public-site-config';
import type { PublicSitePart } from '../../../../lib/public-site-config';
import { withBase } from '../../../../lib/base';

export function getStaticPaths() {
  return PUBLIC_SITE_PARTS.map((part) => ({ params: { part: part.key } }));
}

const part = Astro.params.part as PublicSitePart;
const label = PUBLIC_SITE_PARTS.find((p) => p.key === part)!.label;
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header -> firma2-page-header (status: Unpublished changes; toolbar: Public site; actions: Discard changes, Publish)
    - studio      -> firma2-public-site-studio (part links, the part's controls, the public home as preview)
    - home        -> firma2-public-site-home        (part: home)
    - navigation  -> firma2-public-site-navigation  (part: navigation)
    - theme       -> firma2-public-site-theme       (part: theme)
    - footer      -> firma2-public-site-footer      (part: footer)
    - details     -> firma2-public-site-details     (part: details)
-->
<AppLayout title={`${label} — Public site — Workspace settings — ProjectFirma 2.0`} nav="workspace-settings" active="ws-public-site">
  <div class="stack" data-gap="xl">
    <Firma2PageHeader title="Public site" crumbs={[{ label: 'Public site', href: withBase(publicSitePartHref('home')) }, { label }]}>
      <span slot="status" hidden data-site-status><EsaBadge variant="warning" size="md" value="Unpublished changes" /></span>
      <Firma2IconAction slot="toolbar" icon="globe" label="Open the public site" href={withBase(PUBLIC_HOME_HREF)} />
      <div slot="actions" class="cluster" data-gap="xs">
        <span hidden data-site-discard><EsaButton variant="ghost">Discard changes</EsaButton></span>
        <span hidden data-site-publish><EsaButton variant="primary">Publish</EsaButton></span>
      </div>
    </Firma2PageHeader>
    <Firma2PublicSiteStudio current={part}>
      {part === 'home' && <Firma2PublicSiteHome />}
      {part === 'navigation' && <Firma2PublicSiteNavigation />}
      {part === 'theme' && <Firma2PublicSiteTheme />}
      {part === 'footer' && <Firma2PublicSiteFooter />}
      {part === 'details' && <Firma2PublicSiteDetails />}
    </Firma2PublicSiteStudio>
  </div>
</AppLayout>
