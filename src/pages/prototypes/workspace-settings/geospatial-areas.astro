---
// Geospatial areas — a Workspace settings section. The places the workspace
// files its projects by (watersheds, habitat areas, districts), as groups of
// areas read from reference layers. A project belongs to an area because of
// where its work is. Spec: .scratch/geospatial-areas/spec.md.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which sets of places do we file projects by?"
// 2. READERS: the administrator, often with the GIS analyst beside them.
//    WHO IS NOT HERE: project staff, who never file a project by area — where
//    they draw the work does it.
// 3. SERIES/SCALAR: a homogeneous list — one table.
// 4. IRREVERSIBLE: nothing on this screen; removing a group is on its page.
// 5. CUT: reordering groups, and the areas themselves (each group's page).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2AreaGroups from '../../../components/settings/firma2-area-groups.astro';
import { withBase } from '../../../lib/base';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - groups      -> firma2-area-groups
-->
<AppLayout title="Geospatial areas — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-geospatial-areas" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Geospatial areas">
      <EsaButton slot="actions" variant="primary" tag="a" href={withBase('/prototypes/workspace-settings/geospatial-areas/new')}>Add geospatial areas</EsaButton>
    </Firma2PageHeader>
    <Firma2AreaGroups />
  </div>
</AppLayout>
