---
// Add a GIS subscription — the wizard, on a page of its own so it keeps its
// place when the analyst leaves to share a layer and comes back.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does ProjectFirma need to follow my layer?"
// 2. READERS: the GIS analyst (Marcus), often not a workspace administrator,
//    often stopping halfway. WHO IS NOT HERE: every project owner whose
//    record the first sync creates or rewrites — the fields step says which
//    fields will follow the layer, before anything is saved.
// 3. SERIES/SCALAR: scalars only, five steps of them; the review reads them back.
// 4. IRREVERSIBLE: nothing on this page — adding saves a subscription, and
//    the first sync is a separate act on the list.
// 5. CUT: a step indicator naming all five steps (the progress bar and the
//    heading say where you are), and a "test sync" before saving.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2GisSubscriptionWizard from '../../../../components/gis/firma2-gis-subscription-wizard.astro';
import { withBase } from '../../../../lib/base';

const crumbs = [
  { label: 'GIS subscriptions', href: withBase('/prototypes/workspace-settings/gis-subscriptions') },
  { label: 'Add subscription' },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - wizard      -> firma2-gis-subscription-wizard
-->
<AppLayout title="Add subscription — GIS subscriptions — ProjectFirma 2.0" nav="workspace-settings" active="ws-gis-subscriptions" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Add subscription" crumbs={crumbs} />
    <Firma2GisSubscriptionWizard />
  </div>
</AppLayout>
