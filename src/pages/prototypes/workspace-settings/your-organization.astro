---
// Your organization — Workspace settings › Your organization: the signed-in
// reader's own organization record.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does this workspace say about my organization, and is it right?"
// 2. READERS: an administrator or steward of the organization. Hardest: a member checking who else signs in for them. Not here: everyone who picks this organization from a dropdown or reads its name on a public page.
// 3. SERIES/SCALAR: a profile of scalars (click-to-edit rows), then collections — people, grant programs, projects.
// 4. IRREVERSIBLE: nothing; type is the weightiest field and is one edit back.
// 5. CUT: logo upload, mailing address, and a service-area map.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2OrganizationRecord from '../../../components/settings/firma2-organization-record.astro';
import { currentOrganization } from '../../../data/firma2-directory';

const organization = currentOrganization();
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header   (the organization's name, editable)
    - record      -> firma2-organization-record
-->
<AppLayout title={`${organization.name} — Workspace settings — ProjectFirma 2.0`} nav="workspace-settings" active="ws-your-organization">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title={organization.name} editableTitle={{ field: 'organizationName', label: 'Organization name' }} />
    <Firma2OrganizationRecord organization={organization} />
  </div>
</AppLayout>
