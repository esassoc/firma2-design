---
// Intake form — a Workspace settings section, and the one settings page that
// is a tool rather than a list: the Tally-like builder of the form every new
// project starts from. Specs: .scratch/project-intake/spec.md, and for the
// canvas and the free tier .scratch/form-canvas/spec.md.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What must a new project tell us before it exists?"
// 2. READERS: the administrator, episodically and with little context. Hardest:
//    the one weighing whether a new required question is worth asking every
//    proposer, forever — the canvas shows it exactly as they will meet it.
// 3. SERIES/SCALAR: a series of screens, each an ordered list of blocks.
// 4. IRREVERSIBLE: nothing. Removing a question keeps its field and answers;
//    members see nothing until Publish.
// 5. CUT: separate forms per project type, AND/OR conditions, version history,
//    file-upload questions (files live in text), a phone-width builder.
//
// FULL WIDTH so the canvas can carry its grip-and-+ gutter beside a column
// exactly as wide as the one members fill (the cap lives inside
// firma2-intake-builder), and the Fields drawer can dock at the window's right
// edge. The drawer only lists what to add; settings still sit on the blocks
// (docs/adr/0001-one-editing-grammar-for-builder-canvases.md).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2IntakeBuilder from '../../../components/settings/firma2-intake-builder.astro';
import Firma2IntakePublish from '../../../components/settings/firma2-intake-publish.astro';
---
<!-- manifest:
  layout: stack (inside firma2-intake-builder)
  sections:
    - page header      -> firma2-page-header
    - status + actions -> firma2-intake-publish
    - builder          -> firma2-intake-builder (docks firma2-intake-fields-drawer)
-->
<AppLayout title="Intake form — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-intake-form" width="full">
  <Firma2IntakeBuilder>
    <Firma2PageHeader slot="header" title="Intake form">
      <Firma2IntakePublish slot="actions" />
    </Firma2PageHeader>
  </Firma2IntakeBuilder>
</AppLayout>
