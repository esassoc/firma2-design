---
// Tags — a Workspace settings section. Functional labels a project can carry
// any number of, with no KPIs: "is this an education and outreach project?"
// (user, 2026-10-03). The list is closed so a filter by tag finds every
// project that has it.
//
// SET UP LIKE A TABLE (user, 2026-10-03): tags sit in groups an administrator
// adds, names, colours and orders; tags are added as rows, typed in place,
// coloured, and dragged within or between groups. Adding a tag is adding a
// row here — not the /tags/new page the other taxonomy lists use. A tag
// needs no group: "Add tag" in the header puts it in the list on its own.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What can we label a project with, how is it sorted, and how often is each used?"
// 2. READERS: the tenant's administrator; a program manager checking what a
//    tag means before filtering by it.
// 3. SERIES/SCALAR: a homogeneous list in groups — one grid.
// 4. IRREVERSIBLE: deleting a tag that projects carry (asks first).
// 5. CUT: merging two tags (a seam for when duplicates appear).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2TagBoard from '../../../components/settings/firma2-tag-board.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - grid        -> firma2-tag-board
-->
<AppLayout title="Tags — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-tags">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Tags">
      <div slot="actions" class="cluster" data-gap="xs">
        <EsaButton variant="secondary" icon="plus" data-add-group>Add group</EsaButton>
        <EsaButton variant="primary" icon="plus" data-add-tag>Add tag</EsaButton>
      </div>
    </Firma2PageHeader>
    <Firma2TagBoard />
  </div>
</AppLayout>
