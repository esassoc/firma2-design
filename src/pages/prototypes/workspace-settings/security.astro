---
// Security — Workspace settings › Administration.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Who can get into this workspace, and what can they do once in?"
// 2. READERS: the tenant administrator, at setup and after an audit. Hardest: a grantee who shouldn't have been let in by a too-wide domain.
// 3. SERIES/SCALAR: scalars — selects and one switch in headed sections, no table.
// 4. IRREVERSIBLE: nothing — every control is one edit back. The invite link that could be reset here moved to each organization's Members page.
// 5. CUT: sign-in methods (2026-11-24), SSO/SAML setup, compliance toggles, an audit log. Public site visibility moved to Custom pages.
//    BACK IN (2026-11-23, spec decision 41): one AI setting, whether Import a report may send documents to an outside AI service.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2WorkspaceSecurity from '../../../components/settings/firma2-workspace-security.astro';
import Firma2AiReading from '../../../components/settings/firma2-ai-reading.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - security    -> firma2-workspace-security
    - ai reading  -> firma2-ai-reading (administrators only)
-->
<AppLayout title="Security — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-security" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Security" />
    <Firma2WorkspaceSecurity />
    <Firma2AiReading />
  </div>
</AppLayout>
