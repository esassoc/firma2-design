---
// Security — Workspace settings › Administration.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Who can get into this workspace, how, and what can they do once in?"
// 2. READERS: the tenant administrator, at setup and after an audit. Hardest: a grantee who shouldn't have been let in by a too-wide domain.
// 3. SERIES/SCALAR: scalars — switches and selects in four headed sections, no table.
// 4. IRREVERSIBLE: resetting the invite link (the old one dies) — it asks first. Everything else is one edit back.
// 5. CUT: plan-gated rows, SSO/SAML setup, AI and compliance toggles, an audit log. Public site visibility moved to Custom pages.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2PlanLock from '../../../components/shared/firma2-plan-lock.astro';
import Firma2WorkspaceSecurity from '../../../components/settings/firma2-workspace-security.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - plan lock   -> firma2-plan-lock (wraps the sections below; read-only below Agency)
    - security    -> firma2-workspace-security
-->
<AppLayout title="Security — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-security" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Security" />
    <Firma2PlanLock needs="agency" message="Free workspaces use the standard permissions. Upgrade to Agency to choose who can invite, import, export and publish.">
      <Firma2WorkspaceSecurity />
    </Firma2PlanLock>
  </div>
</AppLayout>
