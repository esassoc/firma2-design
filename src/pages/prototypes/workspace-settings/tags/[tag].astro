---
// One tag in Workspace settings — its name, what earns a project the tag,
// and removing it.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does this tag mean?"
// 2. READERS: the administrator; a program manager checking a tag's meaning
//    before filtering by it.
// 3. SERIES/SCALAR: two scalars.
// 4. IRREVERSIBLE: removing it takes it off every project that has it — the
//    confirm says how many.
// 5. CUT: merging two tags (a seam for when duplicates appear).
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2TaxonomyDetails from '../../../../components/settings/firma2-taxonomy-details.astro';
import Firma2TagProjects from '../../../../components/settings/firma2-tag-projects.astro';
import Firma2TaxonomyDangerZone from '../../../../components/settings/firma2-taxonomy-danger-zone.astro';
import { TAGS, tagCount } from '../../../../data/firma2-tags';
import type { Tag } from '../../../../data/firma2-tags';
import { withBase } from '../../../../lib/base';

export function getStaticPaths() {
  return TAGS.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

interface Props {
  tag: Tag;
}

const { tag } = Astro.props;
const crumbs = [
  { label: 'Tags', href: withBase('/prototypes/workspace-settings/tags') },
  { label: tag.name },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - details     -> firma2-taxonomy-details
    - projects    -> firma2-tag-projects          (assign the tag to projects)
    - remove      -> firma2-taxonomy-danger-zone
-->
<AppLayout title={`${tag.name} — Tags — ProjectFirma 2.0`} nav="workspace-settings" active="ws-tags" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title={tag.name} crumbs={crumbs} />
    <Firma2TaxonomyDetails kind="tag" slug={tag.slug} noun="tag" />
    <Firma2TagProjects slug={tag.slug} />
    <Firma2TaxonomyDangerZone kind="tag" slug={tag.slug} inUse={tagCount(tag.name)} listPath="/prototypes/workspace-settings/tags" />
  </div>
</AppLayout>
