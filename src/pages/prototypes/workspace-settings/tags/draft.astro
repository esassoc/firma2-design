---
// A tag added in this browser — the same page as a seeded tag's
// (tags/[tag].astro) on one static route, the slug in the query.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2TaxonomyDetails from '../../../../components/settings/firma2-taxonomy-details.astro';
import Firma2TagProjects from '../../../../components/settings/firma2-tag-projects.astro';
import Firma2TaxonomyDangerZone from '../../../../components/settings/firma2-taxonomy-danger-zone.astro';
import { withBase } from '../../../../lib/base';
const crumbs = [
  { label: 'Tags', href: withBase('/prototypes/workspace-settings/tags') },
  { label: 'New tag' },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - details     -> firma2-taxonomy-details
    - projects    -> firma2-tag-projects          (assign the tag to projects)
    - remove      -> firma2-taxonomy-danger-zone
-->
<AppLayout title="New tag — Tags — ProjectFirma 2.0" nav="workspace-settings" active="ws-tags" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="New tag" crumbs={crumbs} />
    <Firma2TaxonomyDetails kind="tag" noun="tag" />
    <Firma2TagProjects />
    <Firma2TaxonomyDangerZone kind="tag" inUse={0} listPath="/prototypes/workspace-settings/tags" />
  </div>
</AppLayout>
