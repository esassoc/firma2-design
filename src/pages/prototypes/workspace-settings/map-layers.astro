---
// Map layers — what every map in the workspace is made of: the base map it
// opens on, the colours of its work areas, and the reference boundaries drawn
// under them. Ported from ProjectFirma2 hackathon team 2 (geospatial), story H.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What do our maps look like, and what do they sit against?"
// 2. READERS: the administrator, often with the GIS analyst beside them.
//    WHO IS NOT HERE: every map reader — a loud boundary drowns their work areas.
// 3. SERIES/SCALAR: four scalars for the map itself, then a short list of
//    layers, each a handful of scalars.
// 4. IRREVERSIBLE: deleting a layer (confirmed; the service is untouched).
// 5. CUT: credentialed services (where a password would live is unresolved
//    upstream), restyling services that send images, and a third work-area
//    colour (firma2-map-style says why two).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2MapStyle from '../../../components/settings/firma2-map-style.astro';
import Firma2MapLayers from '../../../components/settings/firma2-map-layers.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - map style   -> firma2-map-style (base map, work-area colors)
    - layers      -> firma2-map-layers
-->
<AppLayout title="Map layers — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-map-layers" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Map layers" />
    <Firma2MapStyle />
    <Firma2MapLayers />
  </div>
</AppLayout>
