---
// Map layers — the reference boundaries every map in the workspace is drawn
// against. Ported from ProjectFirma2 hackathon team 2 (geospatial), story H.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What geography do our maps sit against?"
// 2. READERS: the administrator, often with the GIS analyst beside them.
//    WHO IS NOT HERE: every map reader — a loud boundary drowns their work areas.
// 3. SERIES/SCALAR: a short list of layers, each a handful of scalars.
// 4. IRREVERSIBLE: deleting a layer (confirmed; the service is untouched).
// 5. CUT: credentialed services (where a password would live is unresolved
//    upstream), and restyling services that send images.
import AppLayout from '../../../layouts/AppLayout.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2MapLayers from '../../../components/settings/firma2-map-layers.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - layers      -> firma2-map-layers
-->
<AppLayout title="Map layers — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-map-layers" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Map layers">
      <span slot="actions" data-add-layer><EsaButton variant="primary" icon="plus">Add layer</EsaButton></span>
    </Firma2PageHeader>
    <Firma2MapLayers />
  </div>
</AppLayout>
