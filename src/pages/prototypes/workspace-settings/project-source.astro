---
// Project source — created in ProjectFirma, or kept current from a GIS.
// Ported from ProjectFirma2 hackathon team 2 (geospatial), decision 15.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Where do our projects, and their shapes, come from?"
// 2. READERS: the administrator. WHO IS NOT HERE: everyone who edits a
//    project — the drawing tools appear or vanish for all of them.
// 3. SERIES/SCALAR: one scalar with consequences, then the groups behind it.
// 4. IRREVERSIBLE: nothing, but switching is priced before it happens and
//    leaving subscriptions is refused until their shapes are taken over.
// 5. CUT: both modes at once (one owner per shape), and binding ArcGIS
//    groups, which is ESA's at onboarding.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2ProjectSource from '../../../components/settings/firma2-project-source.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - source      -> firma2-project-source
-->
<AppLayout title="Project source — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-project-source" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Project source" aliasableTitle />
    <Firma2ProjectSource />
  </div>
</AppLayout>
