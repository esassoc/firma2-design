---
// A new PM 2 measure — projectfirma2's performance-measures/new. The first Save
// creates a Draft and the address becomes new?id=<id>, which is also where a
// measure made in this browser opens from the catalog.
//
// The brief's five: as pm2/[measure].astro, whose component this hosts.
import AppLayout from '../../../../layouts/AppLayout.astro';
import EsaPill from '@esa/ecology/esa-pill.astro';
import { withBase } from '../../../../lib/base';
import { PM2_ROUTES, PM2_STATUSES, PM2_STATUS_TONE } from '../../../../data/firma2-pm2';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2Pm2Setup from '../../../../components/pm2/firma2-pm2-setup.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header      -> firma2-page-header (status: esa-pill, hidden until saved)
    - setup            -> firma2-pm2-setup
-->
<AppLayout title="New measure — Performance measures (PM 2) — ProjectFirma 2.0" nav="workspace-settings" active="ws-pm2" width="full">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="New measure" crumbs={[{ label: 'Performance measures (PM 2)', href: withBase(PM2_ROUTES.catalog) }, { label: 'New measure' }]}>
      <span slot="status" class="cluster" data-gap="sm">
        {PM2_STATUSES.map((s) => (
          <span data-pm2-status-pill={s.name} hidden>
            <EsaPill label={s.name} variant={PM2_STATUS_TONE[s.name]} size="md" removable={false} />
          </span>
        ))}
      </span>
    </Firma2PageHeader>

    <Firma2Pm2Setup />
  </div>
</AppLayout>
