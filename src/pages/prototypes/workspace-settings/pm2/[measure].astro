---
// One PM 2 measure's setup page — projectfirma2's
// performance-measures/:performanceMeasureID. Built once per SEEDED measure; a
// measure made in this browser opens on pm2/new?id= instead, which hosts the
// same component.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What will reporters be asked, and is it ready to publish?"
// 2. READERS: the program admin who owns the catalog. WHO IS NOT HERE: the
//    reporter — the aside shows them the form they will meet.
// 3. SERIES/SCALAR: one record, edited in cards.
// 4. IRREVERSIBLE: Publish freezes the breakdowns; it is confirmed and says so.
// 5. CUT: the roll-up and entries the team's plan put here — not built on the
//    branch.
import AppLayout from '../../../../layouts/AppLayout.astro';
import EsaPill from '@esa/ecology/esa-pill.astro';
import { withBase } from '../../../../lib/base';
import { PM2_ROUTES, PM2_SEED_MEASURES, PM2_STATUSES, PM2_STATUS_TONE, pm2MeasureName, pm2Status } from '../../../../data/firma2-pm2';
import type { Pm2Measure } from '../../../../data/firma2-pm2';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2Pm2Setup from '../../../../components/pm2/firma2-pm2-setup.astro';

export function getStaticPaths() {
  return PM2_SEED_MEASURES.map((measure) => ({ params: { measure: String(measure.id) }, props: { measure } }));
}

interface Props {
  measure: Pm2Measure;
}

const { measure } = Astro.props;
const title = pm2MeasureName(measure);
const status = pm2Status(measure.statusId).name;
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header      -> firma2-page-header (status: esa-pill)
    - setup            -> firma2-pm2-setup
-->
<AppLayout title={`${title} — Performance measures (PM 2) — ProjectFirma 2.0`} nav="workspace-settings" active="ws-pm2" width="full">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title={title} crumbs={[{ label: 'Performance measures (PM 2)', href: withBase(PM2_ROUTES.catalog) }, { label: title }]}>
      <span slot="status" class="cluster" data-gap="sm">
        {PM2_STATUSES.map((s) => (
          <span data-pm2-status-pill={s.name} hidden={s.name !== status}>
            <EsaPill label={s.name} variant={PM2_STATUS_TONE[s.name]} size="md" removable={false} />
          </span>
        ))}
      </span>
    </Firma2PageHeader>

    <Firma2Pm2Setup measureId={measure.id} />
  </div>
</AppLayout>
