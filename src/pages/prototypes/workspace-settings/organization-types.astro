---
// Organization types — a Workspace settings section.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What kinds of organization take part, and what can each kind do?"
// 2. READERS: the administrator. Hardest: someone working out why an organization cannot be picked as a project lead.
// 3. SERIES/SCALAR: a homogeneous list — a table.
// 4. IRREVERSIBLE: nothing here.
// 5. CUT: map legend colours and relationship types.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2SettingsTable from '../../../components/settings/firma2-settings-table.astro';
import { organizationTypes } from '../../../data/firma2-workspace-settings';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - list        -> firma2-settings-table
-->
<AppLayout title="Organization types — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-organization-types" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Organization types" />
    <Firma2SettingsTable label="Organization types" nameLabel="Type" columns={[{ key: 'organizations', label: 'Organizations', numeric: true }, { key: 'lead', label: 'Can lead projects' }, { key: 'fund', label: 'Can fund projects' }]} rows={organizationTypes} />
  </div>
</AppLayout>
