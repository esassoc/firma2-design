---
// Organization settings — Workspace settings › Your organization › Settings:
// the index of everything that configures the reader's own organization.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Where do I change how my organization works here?"
// 2. READERS: the organization's administrator. Hardest: a member who opens it to find the way out (Leave) and must not mistake it for Retire or Delete. Not here: the organization's other members, who live with whatever Retire or Delete decides.
// 3. SERIES/SCALAR: neither — an index of destinations, one row per page, plus the danger zone's three acts.
// 4. IRREVERSIBLE: Delete, gated to organizations with no projects; Retire is one restore back. Both get their consequence in the row and a confirmation.
// 5. CUT: per-row icons and per-row descriptions — the group headings carry the scent.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2OrganizationSettings from '../../../components/settings/firma2-organization-settings.astro';
import Firma2OrganizationDangerZone from '../../../components/settings/firma2-organization-danger-zone.astro';
import { currentOrganization } from '../../../data/firma2-directory';

const organization = currentOrganization();
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - settings    -> firma2-organization-settings
    - danger zone -> firma2-organization-danger-zone
-->
<AppLayout title="Organization settings — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-organization-settings" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Organization settings" />
    <Firma2OrganizationSettings organization={organization} />
    <Firma2OrganizationDangerZone organization={organization} />
  </div>
</AppLayout>
