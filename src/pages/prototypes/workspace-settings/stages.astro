---
// Stages — a Workspace settings section.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What lifecycle do projects move through, and what does each stage switch on?"
// 2. READERS: the administrator. Hardest: a program manager asking why a project vanished from the public map — each row's public-page fact answers it.
// 3. SERIES/SCALAR: an ordered list in lifecycle order, reordered by its grips; each stage led by its icon in its colour, which opens the icon and colour picker.
// 4. IRREVERSIBLE: nothing here; renaming or removing a stage with projects in it would be, and is not offered — only stages added here can be removed.
// 5. CUT: project counts per stage, and editing a seeded stage's name, description or reporting rules.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2PlanLock from '../../../components/shared/firma2-plan-lock.astro';
import Firma2StageEditor from '../../../components/settings/firma2-stage-editor.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - plan lock   -> firma2-plan-lock (wraps the sections below; read-only below Agency)
    - list        -> firma2-stage-editor
-->
<AppLayout title="Stages — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-stages" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Stages" />
    <Firma2PlanLock needs="agency" message="Free workspaces use the standard stages. Upgrade to Agency to name and order your own.">
      <Firma2StageEditor />
    </Firma2PlanLock>
  </div>
</AppLayout>
