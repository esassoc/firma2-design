---
// Stages — a Workspace settings section.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What lifecycle do projects move through, and what does each stage switch on?"
// 2. READERS: the administrator. Hardest: a program manager asking why a project vanished from the public map — the Public page column answers it.
// 3. SERIES/SCALAR: an ordered list — a table in lifecycle order, not alphabetical.
// 4. IRREVERSIBLE: nothing here; renaming or removing a stage with projects in it would be, and is not offered.
// 5. CUT: reordering and adding stages (the ladder is ProjectFirma's own).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2SettingsTable from '../../../components/settings/firma2-settings-table.astro';
import { stages } from '../../../data/firma2-workspace-settings';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - list        -> firma2-settings-table
-->
<AppLayout title="Stages — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-stages" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Stages" />
    <Firma2SettingsTable label="Stages" nameLabel="Stage" columns={[{ key: 'projects', label: 'Projects', numeric: true }, { key: 'reports', label: 'Reports yearly' }, { key: 'publicPage', label: 'Public page' }]} rows={stages} />
  </div>
</AppLayout>
