---
// Vocabulary — the tenant's own words for the application's nouns. Ported
// from ProjectFirma2 hackathon team 3.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does our program call these things?"
// 2. READERS: the tenant's administrator. WHO IS NOT HERE: everyone else in
//    the tenant, and the public — every one of them reads the result.
// 3. SERIES/SCALAR: ten pairs of scalars — one table.
// 4. IRREVERSIBLE: nothing; each row resets to the application's word.
// 5. CUT: a card and a Save per noun (one table, saved on leaving a field).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2WorkspaceSettingsNav from '../../../components/settings/firma2-workspace-settings-nav.astro';
import Firma2VocabularyEditor from '../../../components/settings/firma2-vocabulary-editor.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - sections    -> firma2-workspace-settings-nav
    - vocabulary  -> firma2-vocabulary-editor
-->
<AppLayout title="Vocabulary — Workspace settings — ProjectFirma 2.0">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Workspace settings" />
    <Firma2WorkspaceSettingsNav current="vocabulary" />
    <Firma2VocabularyEditor />
  </div>
</AppLayout>
