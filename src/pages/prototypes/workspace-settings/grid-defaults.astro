---
// Grid defaults — the workspace's own columns for each data table. Ported
// from ProjectFirma2 hackathon team 3.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What should everyone see when they open this table?"
// 2. READERS: the tenant's administrator. WHO IS NOT HERE: everyone who opens
//    the table — the preview shows them their result.
// 3. SERIES/SCALAR: an ordered list of columns per table.
// 4. IRREVERSIBLE: nothing; the standard columns are one click away.
// 5. CUT: the hackathon's drag-to-arrange header and its Save button, and the
//    count of people with their own layout (personal layouts live in one
//    browser here, so there is nobody else to count).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2WorkspaceSettingsNav from '../../../components/settings/firma2-workspace-settings-nav.astro';
import Firma2GridDefaultsEditor from '../../../components/settings/firma2-grid-defaults-editor.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header   -> firma2-page-header
    - sections      -> firma2-workspace-settings-nav
    - grid defaults -> firma2-grid-defaults-editor
-->
<AppLayout title="Grid defaults — Workspace settings — ProjectFirma 2.0">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Workspace settings" />
    <Firma2WorkspaceSettingsNav current="grid-defaults" />
    <Firma2GridDefaultsEditor />
  </div>
</AppLayout>
