---
// Menu order — a Workspace settings section.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "In what order should everyone's menu start?"
// 2. READERS: the administrator. WHO IS NOT HERE: everyone else, who can
//    rearrange their own menu from the rail and keeps that order whatever
//    is set here.
// 3. SERIES/SCALAR: three ordered lists — the top rows, Workspace, More —
//    with rows moving between them.
// 4. IRREVERSIBLE: nothing; the standard order is one click away.
// 5. CUT: the reader's organizations (each person's are their own), the Pages
//    group (ordered in the rail itself), and hiding rows.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2PlanLock from '../../../components/shared/firma2-plan-lock.astro';
import Firma2MenuOrderEditor from '../../../components/settings/firma2-menu-order-editor.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - plan lock   -> firma2-plan-lock (wraps the sections below; read-only below Agency)
    - lists       -> firma2-menu-order-editor
-->
<AppLayout title="Menu order — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-menu-order" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Menu order" />
    <Firma2PlanLock needs="agency" message="Upgrade to Agency to reorder the menu.">
      <Firma2MenuOrderEditor />
    </Firma2PlanLock>
  </div>
</AppLayout>
