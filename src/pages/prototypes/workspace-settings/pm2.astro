---
// Performance measures (PM 2) — a Workspace settings section beside the
// original Performance measures. PM 2 is projectfirma2's measure model AS BUILT
// on branch features/0010_project_performance_measures (Category, not
// subcategory; targets; a change log), ported so the two can be compared before
// one of them wins. Nothing here reads or writes the original's data.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does this program measure, and which measures are
//    collecting?"
// 2. READERS: program admins configure. WHO IS NOT HERE: the reporter, who meets
//    every published measure as a form on every project.
// 3. SERIES/SCALAR: one homogeneous list — a table.
// 4. IRREVERSIBLE: nothing on this page; publishing happens on a measure's page.
// 5. CUT: the roll-up chart and entries table the team's plan put on the setup
//    page — the branch never built them, so neither does PM 2.
import AppLayout from '../../../layouts/AppLayout.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { withBase } from '../../../lib/base';
import { PM2_ROUTES } from '../../../data/firma2-pm2';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2Pm2Catalog from '../../../components/pm2/firma2-pm2-catalog.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header      -> firma2-page-header
    - measures         -> firma2-pm2-catalog
-->
<AppLayout title="Performance measures (PM 2) — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-pm2">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Performance measures (PM 2)">
      <EsaButton slot="actions" variant="secondary" icon="arrow-right" tag="a" href={withBase(PM2_ROUTES.project('deer-creek-riparian-corridor-enhancement'))}>See it on a project</EsaButton>
      <EsaButton slot="actions" variant="primary" icon="plus" tag="a" href={withBase(PM2_ROUTES.newMeasure)}>New measure</EsaButton>
    </Firma2PageHeader>

    <Firma2Pm2Catalog />
  </div>
</AppLayout>
