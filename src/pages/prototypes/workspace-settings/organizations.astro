---
// Organizations — Workspace settings › Administration.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which organizations take part, and what does each one do here?"
// 2. READERS: the administrator — only administrators add organizations, here or by approving a request. Hardest: someone working out why an organization is missing from a lead or funder dropdown. Not here: every reporter who picks from those dropdowns.
// 3. SERIES/SCALAR: a homogeneous list of records — a full data grid, one row each — under a band of pending new-organization requests that is gone when none wait.
// 4. IRREVERSIBLE: nothing on this screen; removal lives on the record, Add organization (its own page) asks visibility up front, and each request is answered on its own review page.
// 5. CUT: map legend colours, logos in the grid, a "relationship" column, and the led/funded split (one Projects count; the split is on the record).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2AccessRequestList from '../../../components/settings/firma2-access-request-list.astro';
import Firma2OrganizationGrid from '../../../components/settings/firma2-organization-grid.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { withBase } from '../../../lib/base';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - requested   -> firma2-access-request-list   (kind="organization"; hides itself when none wait)
    - list        -> firma2-organization-grid
-->
<AppLayout title="Organizations — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-organizations">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Organizations" aliasableTitle>
      <EsaButton slot="actions" variant="primary" tag="a" href={withBase('/prototypes/workspace-settings/organizations/new')}>Add organization</EsaButton>
    </Firma2PageHeader>
    <Firma2AccessRequestList
      kind="organization"
      title="Requested"
      reviewBase={withBase('/prototypes/workspace-settings/organizations/requests')}
    />
    <Firma2OrganizationGrid />
  </div>
</AppLayout>
