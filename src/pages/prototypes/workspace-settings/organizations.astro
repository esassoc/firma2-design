---
// Organizations — Workspace settings › Administration.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which organizations take part, and what does each one do here?"
// 2. READERS: the administrator. Hardest: someone working out why an organization is missing from a lead or funder dropdown. Not here: every reporter who picks from those dropdowns.
// 3. SERIES/SCALAR: a homogeneous list of records — a full data grid, one row each.
// 4. IRREVERSIBLE: nothing on this screen; removal would live on the record.
// 5. CUT: map legend colours, logos, and a "relationship" column — type already says what an organization can do.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2OrganizationGrid from '../../../components/settings/firma2-organization-grid.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - list        -> firma2-organization-grid
-->
<AppLayout title="Organizations — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-organizations">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Organizations" aliasableTitle>
      <EsaButton slot="actions" variant="primary">Add organization</EsaButton>
    </Firma2PageHeader>
    <Firma2OrganizationGrid />
  </div>
</AppLayout>
