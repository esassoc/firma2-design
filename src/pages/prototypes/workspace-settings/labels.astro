---
// Labels and definitions — a Workspace settings section.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does this workspace call things, and what do the words mean?"
// 2. READERS: the administrator, and ESA delivery staff matching a tenant's words to the product's. Hardest: a partner reading a definition tooltip cold.
// 3. SERIES/SCALAR: a homogeneous list — a table.
// 4. IRREVERSIBLE: nothing; a label is one edit back.
// 5. CUT: per-page overrides and translations.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2SettingsTable from '../../../components/settings/firma2-settings-table.astro';
import { fieldDefinitions } from '../../../data/firma2-workspace-settings';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - list        -> firma2-settings-table
-->
<AppLayout title="Labels and definitions — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-labels" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Labels and definitions" />
    <Firma2SettingsTable label="Labels and definitions" nameLabel="Label" columns={[{ key: 'default', label: 'ProjectFirma term' }, { key: 'changed', label: 'Renamed' }]} rows={fieldDefinitions} />
  </div>
</AppLayout>
