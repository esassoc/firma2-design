---
// One performance measure in Workspace settings › Performance measures — its
// state and lifecycle in the header, then the settings record anatomy:
// details, what is counted, how entries are divided, what that asks of
// reporters, the reporter's form, the danger zone. Reading width.
//
// A PAGE AGAIN (2026-10-08). The measure was edited in a side sheet over the
// catalog; settings opens every record on its own page from a link in its
// list, so the measure does too. The flat attribute model is unchanged.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does this measure ask, and is it ready to collect?"
// 2. READERS: the program administrator who configures it. WHO IS NOT HERE:
//    every reporter who meets this definition as a form, every year — priced
//    by the Reporter burden level beside the schemas that set it.
// 3. SERIES/SCALAR: a profile of scalars (status, details, what is counted),
//    then one short list (subcategory schemas).
// 4. IRREVERSIBLE: publishing — it freezes the unit, counting rule and
//    questions, and asks first. Deleting asks too, and is offered only while
//    nothing is filed against the measure.
// 5. CUT: the claim sentence, split chart and per-measure results the old
//    detail page carried — results are read on projects and classifications.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2MeasureEditor from '../../../../components/measures/firma2-measure-editor.astro';
import Firma2MeasureDangerZone from '../../../../components/measures/firma2-measure-danger-zone.astro';
import Firma2MeasureStatus from '../../../../components/measures/firma2-measure-status.astro';
import Firma2MeasureActions from '../../../../components/measures/firma2-measure-actions.astro';
import Firma2MeasurePreview from '../../../../components/measures/firma2-measure-preview.astro';
import Firma2SidePanel from '../../../../components/shared/firma2-side-panel.astro';
import Firma2SidePanelToggle from '../../../../components/shared/firma2-side-panel-toggle.astro';
import { CONTENT_READING } from '../../../../lib/content-width';
import { measures, measureDisplayName } from '../../../../data/firma2-performance-measures';
import type { PerformanceMeasureDefinition } from '../../../../data/firma2-performance-measures';
import { withBase } from '../../../../lib/base';

export function getStaticPaths() {
  return measures.map((measure) => ({ params: { measure: measure.slug }, props: { measure } }));
}

interface Props {
  measure: PerformanceMeasureDefinition;
}

const { measure } = Astro.props;
const name = measureDisplayName(measure);
const crumbs = [
  { label: 'Performance measures', href: withBase('/prototypes/workspace-settings/performance-measures') },
  { label: name },
];
---
<!-- manifest:
  layout: firma2-side-panel > stack(2xl)
  sections:
    - reporter preview -> firma2-side-panel           (docked, closable; holds firma2-measure-preview)
    - page header      -> firma2-page-header          (status: firma2-measure-status · actions: firma2-measure-actions · toolbar: firma2-side-panel-toggle)
    - editor           -> firma2-measure-editor       (details, what is counted, schemas, redraft)
    - delete           -> firma2-measure-danger-zone
  note: the page takes the full pane (width="full") so the preview docks at
        the window's edge; the form column keeps the reading width settings
        records use.
-->
<AppLayout title={`${name} — Performance measures — ProjectFirma 2.0`} nav="workspace-settings" active="ws-performance-measures" width="full">
  <Firma2SidePanel id="measure-preview" title="Reporter preview" max={CONTENT_READING}>
    <Firma2MeasurePreview slot="panel" />
    <div class="stack" data-gap="2xl">
      <Firma2PageHeader title={name} crumbs={crumbs}>
        <Firma2MeasureStatus slot="status" status={measure.status} />
        <Firma2SidePanelToggle slot="toolbar" controls="measure-preview" label="Reporter preview" />
        <Firma2MeasureActions slot="actions" />
      </Firma2PageHeader>
      <Firma2MeasureEditor slug={measure.slug} />
      <Firma2MeasureDangerZone slug={measure.slug} />
    </div>
  </Firma2SidePanel>
</AppLayout>
