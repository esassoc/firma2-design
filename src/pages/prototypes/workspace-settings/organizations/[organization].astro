---
// One organization's record, opened from Workspace settings › Organizations.
// The same record "Your organization" renders; see that page for the brief's
// five. The difference is the way back: this page sits one step under the list.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2OrganizationRecord from '../../../../components/settings/firma2-organization-record.astro';
import { organizations, CURRENT_USER } from '../../../../data/firma2-directory';
import type { Organization } from '../../../../data/firma2-directory';
import { withBase } from '../../../../lib/base';

// The reader's own organization is not built here: its one page is Your
// organization, and the list links there instead.
export function getStaticPaths() {
  return organizations
    .filter((organization) => organization.name !== CURRENT_USER.organization)
    .map((organization) => ({ params: { organization: organization.slug }, props: { organization } }));
}

interface Props {
  organization: Organization;
}

const { organization } = Astro.props;
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header   (crumb back to Organizations; name editable)
    - record      -> firma2-organization-record
-->
<AppLayout title={`${organization.name} — Organizations — ProjectFirma 2.0`} nav="workspace-settings" active="ws-organizations">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader
      title={organization.name}
      editableTitle={{ field: 'organizationName', label: 'Organization name' }}
      crumbs={[
        { label: 'Organizations', href: withBase('/prototypes/workspace-settings/organizations'), aliasable: true },
        { label: organization.name },
      ]}
    />
    <Firma2OrganizationRecord organization={organization} />
  </div>
</AppLayout>
