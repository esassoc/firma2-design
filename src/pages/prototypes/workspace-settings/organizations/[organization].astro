---
// One organization's record, opened from Workspace settings › Organizations —
// the reader's own organization included; it has no second page of its own.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does this workspace say about this organization, and is it right?"
// 2. READERS: an administrator, or a steward of the organization. Hardest: a member checking who else signs in for them. Not here: everyone who picks this organization from a dropdown or reads its name on a public page.
// 3. SERIES/SCALAR: a profile of scalars (click-to-edit rows), then collections — people, grant programs, projects.
// 4. IRREVERSIBLE: nothing; type is the weightiest field and is one edit back.
// 5. CUT: logo upload, mailing address, and a service-area map.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2ProjectPeekLayout from '../../../../components/projects/firma2-project-peek-layout.astro';
import Firma2OrganizationRecord from '../../../../components/settings/firma2-organization-record.astro';
import { organizations } from '../../../../data/firma2-directory';
import type { Organization } from '../../../../data/firma2-directory';
import { withBase } from '../../../../lib/base';

export function getStaticPaths() {
  return organizations.map((organization) => ({ params: { organization: organization.slug }, props: { organization } }));
}

interface Props {
  organization: Organization;
}

const { organization } = Astro.props;
---
<!-- manifest:
  layout: firma2-project-peek-layout > stack(2xl)
  sections:
    - page header -> firma2-page-header   (crumb back to Organizations; name editable)
    - record      -> firma2-organization-record
-->
<AppLayout title={`${organization.name} — Organizations — ProjectFirma 2.0`} nav="workspace-settings" active="ws-organizations" width="full">
  <Firma2ProjectPeekLayout>
    <div class="stack" data-gap="2xl">
      <Firma2PageHeader
        title={organization.name}
        editableTitle={{ field: 'organizationName', label: 'Organization name' }}
        crumbs={[
          { label: 'Organizations', href: withBase('/prototypes/workspace-settings/organizations'), aliasable: true },
          { label: organization.name },
        ]}
      />
      <Firma2OrganizationRecord organization={organization} />
    </div>
  </Firma2ProjectPeekLayout>
</AppLayout>
