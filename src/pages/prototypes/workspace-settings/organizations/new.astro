---
// Add organization — Workspace settings › Organizations › Add organization.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is this organization called, and who can see it?"
// 2. READERS: the administrator. Hardest: someone adding a contractor whose drafts must not be public on day one. Not here: the organization's own members — they arrive by invitation afterwards.
// 3. SERIES/SCALAR: scalars only — a name, a logo, three choices.
// 4. IRREVERSIBLE: visibility, in effect — an organization created Public has been seen before anyone narrows it, so it is asked here rather than left to settings.
// 5. CUT: type, website, description and primary contact (Organization settings › General, once it exists; the contact has to be a member, and there are none yet).
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2OrganizationCreateForm from '../../../../components/settings/firma2-organization-create-form.astro';
import { withBase } from '../../../../lib/base';

const crumbs = [
  { label: 'Organizations', href: withBase('/prototypes/workspace-settings/organizations') },
  { label: 'Add organization' },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - form        -> firma2-organization-create-form
-->
<AppLayout title="Add organization — Organizations — ProjectFirma 2.0" nav="workspace-settings" active="ws-organizations" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Add organization" crumbs={crumbs} />
    <Firma2OrganizationCreateForm />
  </div>
</AppLayout>
