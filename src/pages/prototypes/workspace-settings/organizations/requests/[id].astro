---
// Review a new-organization request — Workspace settings › Organizations ›
// Requested › one request. Spec: .scratch/access-requests/spec.md.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Is this a real organization we don't already have, and should it exist here?"
// 2. READERS: the administrator — only administrators create organizations. Hardest: a request from a personal address whose name is one word off an existing organization. Not here: the requester, who sees only "pending".
// 3. SERIES/SCALAR: scalars (who asked, their email against the website), one short list (similar organizations), two correctable fields.
// 4. IRREVERSIBLE: Approve, in effect — it adds an organization and makes the requester a Contributor and its first Manager, so the line above the button says so. Decline sends its reason.
// 5. CUT: the requester's history, a domain lookup service, merging organizations, and a page per request made at runtime (static pages exist for the seeded ones only).
import AppLayout from '../../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../../components/shared/firma2-page-header.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import Firma2OrganizationRequestReview from '../../../../../components/settings/firma2-organization-request-review.astro';
import { SEED_REQUESTS, FLOW_REQUESTS, type AccessRequest } from '../../../../../data/firma2-access-requests';
import { withBase } from '../../../../../lib/base';

export function getStaticPaths() {
  return [...SEED_REQUESTS, ...FLOW_REQUESTS].filter((request) => request.kind === 'organization').map((request) => ({
    params: { id: request.id },
    props: { request },
  }));
}

interface Props {
  request: AccessRequest;
}

const { request } = Astro.props;
const crumbs = [
  { label: 'Organizations', href: withBase('/prototypes/workspace-settings/organizations') },
  { label: request.organization },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header   (status: esa-badge "Requested")
    - review      -> firma2-organization-request-review
-->
<AppLayout title={`${request.organization} — Organizations — ProjectFirma 2.0`} nav="workspace-settings" active="ws-organizations" width="reading">
  <div class="stack" data-gap="2xl">
    {/* The title is a name that does not exist yet; the badge says so. */}
    <Firma2PageHeader title={request.organization} crumbs={crumbs}>
      <EsaBadge slot="status" value="Requested" variant="secondary" size="md" />
    </Firma2PageHeader>
    <Firma2OrganizationRequestReview request={request} />
  </div>
</AppLayout>
