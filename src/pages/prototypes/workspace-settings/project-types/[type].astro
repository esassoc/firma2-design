---
// One project type in the studio — its fields and its page sections, with
// the public page it produces live beside them. Ported from ProjectFirma2
// hackathon team 3's Project Type Studio.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does a project of this type track, and what does
//    its public page show?"
// 2. READERS: the tenant's administrator. WHO IS NOT HERE: every project
//    sponsor who will be asked these fields, and every member of the public
//    who reads the page — the first are counted on the Fields card, the
//    second are shown the result in the preview.
// 3. SERIES/SCALAR: two ordered lists (fields, sections) — rows, not a rail.
// 4. IRREVERSIBLE: in production, retiring a field that has answers. The
//    prototype has no answers to lose, so removal here is a plain remove.
// 5. CUT: the hackathon's separate Custom Fields screen (defining a field
//    happens here, beside placing it), per-type style tabs (the tenant brand
//    is one screen, Branding), and field groups.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2TypeStudio from '../../../../components/settings/firma2-type-studio.astro';
import { PROJECT_TYPES } from '../../../../data/firma2-project-types';
import type { ProjectType } from '../../../../data/firma2-project-types';
import { projects, projectSlug } from '../../../../data/firma2-projects';
import { withBase } from '../../../../lib/base';

export function getStaticPaths() {
  return PROJECT_TYPES.map((type) => ({ params: { type: type.slug }, props: { type } }));
}

interface Props {
  type: ProjectType;
}

const { type } = Astro.props;
const typeProjects = projects
  .filter((p) => p.program === type.name)
  .map((p) => ({ name: p.projectName, publicHref: withBase(`/prototypes/public/${projectSlug(p)}`) }));
const crumbs = [
  { label: 'Project types', href: withBase('/prototypes/workspace-settings/project-types') },
  { label: type.name },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - studio      -> firma2-type-studio
-->
<AppLayout title={`${type.name} — Project types — ProjectFirma 2.0`} nav="workspace-settings" active="ws-project-types">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title={type.name} crumbs={crumbs} />
    <Firma2TypeStudio type={type} projects={typeProjects} />
  </div>
</AppLayout>
