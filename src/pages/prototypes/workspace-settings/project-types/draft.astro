---
// A project type added in this browser — the same page as a seeded type's
// (project-types/[type].astro), on one static route with the type's slug in
// the query, because a static site cannot build a page for a record it has
// never seen. Every section reads the slug from the URL and fills itself from
// browser storage. No project is this type yet, so the preview waits.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2ProjectTypeStudio from '../../../../components/settings/firma2-project-type-studio.astro';
import Firma2TaxonomyDetails from '../../../../components/settings/firma2-taxonomy-details.astro';
import Firma2TaxonomyDangerZone from '../../../../components/settings/firma2-taxonomy-danger-zone.astro';
import type { ProjectType } from '../../../../data/firma2-project-types';
import { withBase } from '../../../../lib/base';

// An empty shell for the server render; the browser fills it in.
const shell = { slug: '', name: '', color: '', description: '', fields: [], sections: {} } as unknown as ProjectType;
const crumbs = [
  { label: 'Project types', href: withBase('/prototypes/workspace-settings/project-types') },
  { label: 'New project type' },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - details     -> firma2-taxonomy-details
    - studio      -> firma2-project-type-studio
    - remove      -> firma2-taxonomy-danger-zone
-->
<AppLayout title="New project type — Project types — ProjectFirma 2.0" nav="workspace-settings" active="ws-project-types">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="New project type" crumbs={crumbs} />
    <Firma2TaxonomyDetails kind="projectType" noun="project type" />
    <Firma2ProjectTypeStudio projectType={shell} projects={[]} />
    <Firma2TaxonomyDangerZone kind="projectType" inUse={0} listPath="/prototypes/workspace-settings/project-types" />
  </div>
</AppLayout>
