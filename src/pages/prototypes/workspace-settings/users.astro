---
// Users — Workspace settings › Administration.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Who can sign in, for which organization, and with what role?"
// 2. READERS: the administrator. Hardest: someone chasing an invitation that was never accepted. Not here: the person whose access is being changed — "View administrators" on Account is their side.
// 3. SERIES/SCALAR: a homogeneous list of people — a full data grid.
// 4. IRREVERSIBLE: granting Administrator — Change role… in the row's "…", whose hint says what it hands over. Suspending is one step back (Restore access).
// 5. CUT: a status column (Active, Invited and Suspended are tabs instead), per-project access, and stewards — set per organization, on its Members page.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2UserGrid from '../../../components/settings/firma2-user-grid.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - list        -> firma2-user-grid
-->
<AppLayout title="Users — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-users">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Users">
      <EsaButton slot="actions" variant="primary">Invite people</EsaButton>
    </Firma2PageHeader>
    <Firma2UserGrid />
  </div>
</AppLayout>
