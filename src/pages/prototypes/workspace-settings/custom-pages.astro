---
// Custom pages — Workspace settings › Administration.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Does this workspace keep its own pages, and who may change them and hear about it?"
// 2. READERS: the tenant administrator, at setup. Who is NOT here: the contributor who
//    can't fix a typo in a protocol page, and the steward whose inbox fills with every edit.
// 3. SERIES/SCALAR: scalars — one feature switch, then switches and selects in four headed sections.
// 4. IRREVERSIBLE: nothing. Off hides the pages and deletes none.
// 5. CUT: per-page and per-folder permissions, page templates, the pages list itself (that is the rail).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2CustomPagesSettings from '../../../components/settings/firma2-custom-pages-settings.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header  -> firma2-page-header
    - custom pages -> firma2-custom-pages-settings
-->
<AppLayout title="Custom pages — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-custom-pages" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Custom pages" />
    <Firma2CustomPagesSettings />
  </div>
</AppLayout>
