---
// Plan and usage — Workspace settings › Administration. Where every plan-locked page's
// call to action leads. Spec: .scratch/tiers/spec.md.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does this plan allow, how much of it do we use, and what would a higher plan change?"
// 2. READERS: the administrator who just met a locked page — here from its
//    Upgrade, wanting to know what they would get before anything else.
// 3. SERIES/SCALAR: a scalar (the plan) and a short series per plan (what it adds).
// 4. IRREVERSIBLE: nothing. In the prototype the switch flips back.
// 5. CUT: prices, billing, invoices. Usage is counts against limits, no history.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2WorkspacePlan from '../../../components/settings/firma2-workspace-plan.astro';
import Firma2PlanUsage from '../../../components/settings/firma2-plan-usage.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - plan        -> firma2-workspace-plan (current plan, then what each plan adds)
    - usage       -> firma2-plan-usage (slotted into the plan, after the current plan)
-->
<AppLayout title="Plan and usage — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-plan" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Plan and usage" />
    <Firma2WorkspacePlan>
      <Firma2PlanUsage slot="usage" />
    </Firma2WorkspacePlan>
  </div>
</AppLayout>
