---
// A classification added in this browser — the same page as a seeded one
// (classifications/[classification].astro) on one static route, the slug in
// the query. Every section fills itself from browser storage.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2TaxonomyDetails from '../../../../components/settings/firma2-taxonomy-details.astro';
import Firma2ClassificationKpiEditor from '../../../../components/settings/firma2-classification-kpi-editor.astro';
import Firma2TaxonomyDangerZone from '../../../../components/settings/firma2-taxonomy-danger-zone.astro';
import { withBase } from '../../../../lib/base';
const crumbs = [
  { label: 'Classifications', href: withBase('/prototypes/workspace-settings/classifications') },
  { label: 'New classification' },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - details     -> firma2-taxonomy-details
    - KPIs        -> firma2-classification-kpi-editor
    - remove      -> firma2-taxonomy-danger-zone
-->
<AppLayout title="New classification — Classifications — ProjectFirma 2.0" nav="workspace-settings" active="ws-classifications" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="New classification" crumbs={crumbs} />
    <Firma2TaxonomyDetails kind="classification" noun="classification" />
    <Firma2ClassificationKpiEditor />
    <Firma2TaxonomyDangerZone kind="classification" inUse={0} listPath="/prototypes/workspace-settings/classifications" />
  </div>
</AppLayout>
