---
// Add group — Workspace settings › Classifications › Add group.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is the group called, and what do its classifications share?"
// 2. READERS: the administrator, or whoever Security › Manage classifications lets in.
// 3. SERIES/SCALAR: scalars only — a name and a line of description.
// 4. IRREVERSIBLE: nothing; both are one edit back on the record.
// 5. CUT: everything else — the new group opens on its own page, where its
//    classifications are added.
import AppLayout from '../../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../../components/shared/firma2-page-header.astro';
import Firma2TaxonomyCreateForm from '../../../../../components/settings/firma2-taxonomy-create-form.astro';
import { withBase } from '../../../../../lib/base';
const crumbs = [
  { label: 'Classifications', href: withBase('/prototypes/workspace-settings/classifications') },
  { label: 'Add group' },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - form        -> firma2-taxonomy-create-form
-->
<AppLayout title="Add group — Classifications — ProjectFirma 2.0" nav="workspace-settings" active="ws-classifications" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Add group" crumbs={crumbs} />
    <Firma2TaxonomyCreateForm kind="classificationGroup" />
  </div>
</AppLayout>
