---
// One classification group in Workspace settings — what it is called, the
// line under its name on the Classifications board, and the classifications
// in it, in the order the board shows them.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is this group, and which goals sit in it, in what order?"
// 2. READERS: the administrator, or whoever Security › Manage classifications
//    lets in; ESA's delivery lead setting up a tenant's goals.
// 3. SERIES/SCALAR: scalars (name, description), then one ordered list.
// 4. IRREVERSIBLE: removing the group — offered only once it is empty and
//    another group remains.
// 5. CUT: moving a classification between groups here (its own page's Group
//    field does that — one place to move it, not two).
import AppLayout from '../../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../../components/shared/firma2-page-header.astro';
import Firma2TaxonomyDetails from '../../../../../components/settings/firma2-taxonomy-details.astro';
import Firma2ClassificationGroupMembers from '../../../../../components/settings/firma2-classification-group-members.astro';
import Firma2TaxonomyDangerZone from '../../../../../components/settings/firma2-taxonomy-danger-zone.astro';
import { CLASSIFICATION_GROUPS } from '../../../../../data/firma2-classifications';
import type { ClassificationGroup } from '../../../../../data/firma2-classifications';
import { withBase } from '../../../../../lib/base';

export function getStaticPaths() {
  return CLASSIFICATION_GROUPS.map((group) => ({ params: { group: group.slug }, props: { group } }));
}

interface Props {
  group: ClassificationGroup;
}

const { group } = Astro.props;
const crumbs = [
  { label: 'Classifications', href: withBase('/prototypes/workspace-settings/classifications') },
  { label: group.name },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header      -> firma2-page-header
    - details          -> firma2-taxonomy-details                (name, description)
    - classifications  -> firma2-classification-group-members    (ordered, with its add)
    - remove           -> firma2-taxonomy-danger-zone
-->
<AppLayout title={`${group.name} — Classifications — ProjectFirma 2.0`} nav="workspace-settings" active="ws-classifications" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title={group.name} crumbs={crumbs} />
    <Firma2TaxonomyDetails kind="classificationGroup" slug={group.slug} noun="group" />
    <Firma2ClassificationGroupMembers slug={group.slug} />
    <Firma2TaxonomyDangerZone kind="classificationGroup" slug={group.slug} inUse={0} listPath="/prototypes/workspace-settings/classifications" />
  </div>
</AppLayout>
