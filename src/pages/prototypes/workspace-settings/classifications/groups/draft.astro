---
// A classification group added in this browser — the same page as a seeded
// one (groups/[group].astro) on one static route, the slug in the query.
// Every section fills itself from browser storage.
import AppLayout from '../../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../../components/shared/firma2-page-header.astro';
import Firma2TaxonomyDetails from '../../../../../components/settings/firma2-taxonomy-details.astro';
import Firma2ClassificationGroupMembers from '../../../../../components/settings/firma2-classification-group-members.astro';
import Firma2TaxonomyDangerZone from '../../../../../components/settings/firma2-taxonomy-danger-zone.astro';
import { withBase } from '../../../../../lib/base';
const crumbs = [
  { label: 'Classifications', href: withBase('/prototypes/workspace-settings/classifications') },
  { label: 'New group' },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header      -> firma2-page-header
    - details          -> firma2-taxonomy-details
    - classifications  -> firma2-classification-group-members
    - remove           -> firma2-taxonomy-danger-zone
-->
<AppLayout title="New group — Classifications — ProjectFirma 2.0" nav="workspace-settings" active="ws-classifications" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="New group" crumbs={crumbs} />
    <Firma2TaxonomyDetails kind="classificationGroup" noun="group" />
    <Firma2ClassificationGroupMembers />
    <Firma2TaxonomyDangerZone kind="classificationGroup" inUse={0} listPath="/prototypes/workspace-settings/classifications" />
  </div>
</AppLayout>
