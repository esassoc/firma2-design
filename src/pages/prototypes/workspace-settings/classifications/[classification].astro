---
// One classification in Workspace settings — what it is called, which group
// it sorts into, which performance measures track it and the goal target for
// each. The Classifications board reads progress against exactly this.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does this goal track, and what are we aiming for?"
// 2. READERS: the administrator; ESA's delivery lead setting a tenant's goals
//    with its program manager. WHO IS NOT HERE: every reader of the board,
//    who sees these targets as the end of each progress bar.
// 3. SERIES/SCALAR: scalars (name, description, group), then one list of
//    KPIs, each with a two-part target.
// 4. IRREVERSIBLE: removing the classification — offered only once no project
//    works toward it.
// 5. CUT: per-year interim targets (one target and a due year per KPI), and
//    defining a measure here (that is Performance measures' job).
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2TaxonomyDetails from '../../../../components/settings/firma2-taxonomy-details.astro';
import Firma2ClassificationKpiEditor from '../../../../components/settings/firma2-classification-kpi-editor.astro';
import Firma2TaxonomyDangerZone from '../../../../components/settings/firma2-taxonomy-danger-zone.astro';
import { CLASSIFICATIONS } from '../../../../data/firma2-classifications';
import type { Classification } from '../../../../data/firma2-classifications';
import { projects } from '../../../../data/firma2-projects';
import { withBase } from '../../../../lib/base';

export function getStaticPaths() {
  return CLASSIFICATIONS.map((classification) => ({ params: { classification: classification.slug }, props: { classification } }));
}

interface Props {
  classification: Classification;
}

const { classification } = Astro.props;
const inUse = projects.filter((p) => p.classifications.includes(classification.name)).length;
const crumbs = [
  { label: 'Classifications', href: withBase('/prototypes/workspace-settings/classifications') },
  { label: classification.name },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - details     -> firma2-taxonomy-details             (name, description, group)
    - KPIs        -> firma2-classification-kpi-editor    (linked measures + goal targets)
    - remove      -> firma2-taxonomy-danger-zone
-->
<AppLayout title={`${classification.name} — Classifications — ProjectFirma 2.0`} nav="workspace-settings" active="ws-classifications" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title={classification.name} crumbs={crumbs} />
    <Firma2TaxonomyDetails kind="classification" slug={classification.slug} noun="classification" />
    <Firma2ClassificationKpiEditor classification={classification} />
    <Firma2TaxonomyDangerZone kind="classification" slug={classification.slug} inUse={inUse} listPath="/prototypes/workspace-settings/classifications" />
  </div>
</AppLayout>
