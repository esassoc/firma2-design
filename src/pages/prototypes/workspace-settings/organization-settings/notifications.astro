---
// Notifications — Workspace settings › Your organization › Settings ›
// Notifications: what the organization's administrators are emailed about.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does this workspace email our administrators about?"
// 2. READERS: the organization's administrator. Hardest: an administrator who misses an update waiting for approval because nobody turned that email on. Not here: members, whose own mail is Settings › Personal › Notifications.
// 3. SERIES/SCALAR: five independent switches.
// 4. IRREVERSIBLE: nothing.
// 5. CUT: choosing recipients per event, delivery schedules, in-app channels.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2SettingsNotifications from '../../../../components/settings/firma2-settings-notifications.astro';
import type { Notification } from '../../../../components/settings/firma2-settings-notifications.astro';
import { withBase } from '../../../../lib/base';

const crumbs = [
  { label: 'Organization settings', href: withBase('/prototypes/workspace-settings/organization-settings') },
  { label: 'Notifications' },
];

// The organization's events, in the order work arrives: a project starts, an
// update waits on someone, a report falls due, the team changes, then the
// weekly catch-up — opt-in for the same reason as the personal one.
const notifications: Notification[] = [
  { key: 'org-new-project', label: 'New projects', hint: 'When a member adds a project for this organization.', on: true },
  { key: 'org-update-review', label: 'Updates to review', hint: 'When a member submits a project update for approval.', on: true },
  { key: 'org-report-due', label: 'Reports due', hint: 'When a performance measure report is due on a project this organization leads.', on: true },
  { key: 'org-new-member', label: 'New members', hint: 'When someone accepts an invitation to this organization.', on: true },
  { key: 'org-digest', label: 'Weekly summary', hint: 'Once a week, what changed on this organization’s projects.', on: false },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header   -> firma2-page-header
    - notifications -> firma2-settings-notifications
-->
<AppLayout title="Notifications — Organization settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-organization-settings" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Notifications" crumbs={crumbs} />
    <Firma2SettingsNotifications title="Email to administrators" notifications={notifications} />
  </div>
</AppLayout>
