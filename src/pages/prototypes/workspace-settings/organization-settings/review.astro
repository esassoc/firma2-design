---
// Review schedule — Workspace settings › Your organization › Settings ›
// Review schedule: how often the organization's stewards bring its projects'
// public pages up to date.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "How often do we review our projects before they go public?"
// 2. READERS: the organization's stewards. Hardest: a steward who sets a
//    monthly schedule and finds every project overdue the next morning — the
//    help line says exactly what the schedule turns overdue. Not here: the
//    editors, who never see a schedule; between publishes they are trusted.
// 3. SERIES/SCALAR: one choice of five, one switch.
// 4. IRREVERSIBLE: nothing. A schedule only marks waits as overdue; it
//    publishes nothing and blocks nothing.
// 5. CUT: who may publish (a workspace threshold, Security › Publish
//    projects), per-project schedules, and Save — each control commits on
//    change.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2PlanLock from '../../../../components/shared/firma2-plan-lock.astro';
import Firma2OrganizationReview from '../../../../components/settings/firma2-organization-review.astro';
import { currentOrganization } from '../../../../data/firma2-directory';
import { withBase } from '../../../../lib/base';

const organization = currentOrganization();
const crumbs = [
  { label: 'Organization settings', href: withBase('/prototypes/workspace-settings/organization-settings') },
  { label: 'Review schedule' },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - plan lock   -> firma2-plan-lock (wraps the sections below; read-only below Program)
    - schedule    -> firma2-organization-review
-->
<AppLayout title="Review schedule — Organization settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-organization-settings" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Review schedule" crumbs={crumbs} />
    <Firma2PlanLock needs="program" message="Upgrade to Program to review changes before they're published.">
      <Firma2OrganizationReview organization={organization} />
    </Firma2PlanLock>
  </div>
</AppLayout>
