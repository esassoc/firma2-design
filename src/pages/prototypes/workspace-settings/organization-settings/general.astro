---
// General — Workspace settings › Your organization › Settings › General: the
// organization's own details, as a form.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Is what this workspace says about my organization right?"
// 2. READERS: the organization's administrator. Hardest: whoever inherits the role and needs the primary contact to be someone who still works there. Not here: everyone who picks this organization from a dropdown or reads its name on a public project page — they meet these values.
// 3. SERIES/SCALAR: four scalars and one paragraph — labeled fields, no table.
// 4. IRREVERSIBLE: nothing; every value is one edit back. Type is the weightiest (it files the organization under a different heading everywhere) and still reverses.
// 5. CUT: logo, mailing address, and Save — fields commit on leave.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2OrganizationGeneral from '../../../../components/settings/firma2-organization-general.astro';
import { currentOrganization } from '../../../../data/firma2-directory';
import { withBase } from '../../../../lib/base';

const organization = currentOrganization();
const crumbs = [
  { label: 'Organization settings', href: withBase('/prototypes/workspace-settings/organization-settings') },
  { label: 'General' },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - form        -> firma2-organization-general
-->
<AppLayout title="General — Organization settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-organization-settings" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="General" crumbs={crumbs} />
    <Firma2OrganizationGeneral organization={organization} />
  </div>
</AppLayout>
