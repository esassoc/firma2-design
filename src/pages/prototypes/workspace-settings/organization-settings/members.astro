---
// Members — Workspace settings › Your organization › Settings › Members: who
// belongs to the organization, and the way to add or remove them.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Who is in my organization, and with what role?"
// 2. READERS: the organization's administrator. Hardest: someone onboarding a new hire who may or may not already have an account — one field takes both. Not here: the person being removed, who keeps their account and their past work.
// 3. SERIES/SCALAR: a short homogeneous list of people — the settings table, not the data grid.
// 4. IRREVERSIBLE: nothing; a removed member or a canceled invitation can be added back. Both still ask first, because the person affected is not in the room.
// 5. CUT: last active, per-row role editing, bulk select — Users carries the workspace-wide view.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2OrganizationMembers from '../../../../components/settings/firma2-organization-members.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { currentOrganization } from '../../../../data/firma2-directory';
import { withBase } from '../../../../lib/base';

const organization = currentOrganization();
const crumbs = [
  { label: 'Organization settings', href: withBase('/prototypes/workspace-settings/organization-settings') },
  { label: 'Members' },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - members     -> firma2-organization-members
-->
<AppLayout title="Members — Organization settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-organization-settings" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Members" crumbs={crumbs}>
      <EsaButton slot="actions" variant="primary" size="md" data-members-add>Add members</EsaButton>
    </Firma2PageHeader>
    <Firma2OrganizationMembers organization={organization} />
  </div>
</AppLayout>
