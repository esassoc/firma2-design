---
// Access and permissions — Workspace settings › Your organization › Settings ›
// Access and permissions: who can see the organization, how people join it, and
// which members may change it.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Who can see us, how do people get in, and who may change things?"
// 2. READERS: the organization's administrator. Hardest: an administrator who opens the organization to the public and does not realize its projects open with it. Not here: members, who meet these answers as what they can and cannot do.
// 3. SERIES/SCALAR: two choices of three, then four choices of two.
// 4. IRREVERSIBLE: nothing on this page — but going Public shows projects to people who are not signed in, so the help line under the answer says exactly that.
// 5. CUT: per-project overrides, custom roles, and Save — each control commits on change.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2OrganizationAccess from '../../../../components/settings/firma2-organization-access.astro';
import { withBase } from '../../../../lib/base';

const crumbs = [
  { label: 'Organization settings', href: withBase('/prototypes/workspace-settings/organization-settings') },
  { label: 'Access and permissions' },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - access      -> firma2-organization-access
-->
<AppLayout title="Access and permissions — Organization settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-organization-settings" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Access and permissions" crumbs={crumbs} />
    <Firma2OrganizationAccess />
  </div>
</AppLayout>
