---
// Custom fields — a Workspace settings section.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What extra facts does this workspace record about a project?"
// 2. READERS: the administrator. Hardest: someone deciding whether a field is safe to retire — Used by answers it.
// 3. SERIES/SCALAR: a homogeneous list — a table, each row edited in a side sheet.
// 4. IRREVERSIBLE: deleting a field with data in it — not offered; a field
//    is taken off its classifications in the studio first, then deleted here.
// 5. CUT: field placement on the page (each classification owns it), and required-ness.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2CustomFieldsEditor from '../../../components/settings/firma2-custom-fields-editor.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - fields      -> firma2-custom-fields-editor
-->
<AppLayout title="Custom fields — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-custom-fields" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Custom fields">
      <span slot="actions" data-new-field><EsaButton variant="primary" icon="plus">New field</EsaButton></span>
    </Firma2PageHeader>
    <Firma2CustomFieldsEditor />
  </div>
</AppLayout>
