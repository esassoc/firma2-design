---
// Custom fields — a Workspace settings section.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What extra facts does this workspace record about a project?"
// 2. READERS: the administrator. Hardest: someone deciding whether a field is safe to retire — Used by answers it.
// 3. SERIES/SCALAR: a homogeneous list — a table.
// 4. IRREVERSIBLE: deleting a field with data in it; not offered here.
// 5. CUT: field placement on the page (each project type owns it), and create/delete.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2SettingsTable from '../../../components/settings/firma2-settings-table.astro';
import { customFields } from '../../../data/firma2-workspace-settings';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - list        -> firma2-settings-table
-->
<AppLayout title="Custom fields — Workspace settings — ProjectFirma 2.0" nav="workspace-settings" active="ws-custom-fields" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Custom fields" />
    <Firma2SettingsTable label="Custom fields" nameLabel="Field" columns={[{ key: 'kind', label: 'Type' }, { key: 'types', label: 'Used by' }, { key: 'required', label: 'Required' }]} rows={customFields} />
  </div>
</AppLayout>
