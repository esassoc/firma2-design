---
// New support request — the page a request is sent from. An add is a page,
// not a dialog, as everywhere else in this spoke.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What do you need help with?"
// 2. READERS: anyone signed in who is stuck. Hardest: someone who cannot name
//    the kind of problem — Type starts on Question and "Other" is there. WHO
//    IS NOT HERE: the administrator who will answer; the subject is the row
//    they scan, so it is its own field.
// 3. SERIES/SCALAR: three scalars, one column.
// 4. IRREVERSIBLE: sending — so it is a button, never a save on blur.
// 5. CUT: name, email and organization (known from the account), the page it
//    was sent from, attachments and priority.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2SupportRequestForm from '../../../components/support/firma2-support-request-form.astro';
import { withBase } from '../../../lib/base';

const crumbs = [{ label: 'Support requests', href: withBase('/prototypes/support-requests') }, { label: 'New request' }];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - form        -> firma2-support-request-form
-->
<AppLayout title="New request — Support requests — ProjectFirma 2.0" active="support-requests" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="New request" crumbs={crumbs} />
    <Firma2SupportRequestForm />
  </div>
</AppLayout>
