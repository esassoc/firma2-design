---
// A support request sent in this browser — the same page as a seeded one
// (support-requests/[request].astro) on one static route, its slug in the
// query. The record fills itself from browser storage.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2SidePanel from '../../../components/shared/firma2-side-panel.astro';
import Firma2SupportRequestDetails from '../../../components/support/firma2-support-request-details.astro';
import { CONTENT_READING } from '../../../lib/content-width';
import Firma2SupportRequestRecord from '../../../components/support/firma2-support-request-record.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { SUPPORT_REQUEST_STATUS_LABEL, SUPPORT_REQUEST_STATUS_TONE } from '../../../data/firma2-support-requests';
import { withBase } from '../../../lib/base';

const request = { status: 'open', subject: 'Support request', id: 'Request' };
const crumbs = [{ label: 'Support requests', href: withBase('/prototypes/support-requests') }, { label: request.id }];
---
<!-- manifest:
  layout: firma2-side-panel > stack(2xl)
  sections:
    - details rail -> firma2-side-panel (firma2-rail) holding firma2-support-request-details
    - page header -> firma2-page-header            (status: esa-badge; action: Mark resolved / Reopen)
    - record      -> firma2-support-request-record (Request, Replies with the reply field)
-->
<AppLayout title={`${request.subject} — Support requests — ProjectFirma 2.0`} active="support-requests" width="full">
  <Firma2SidePanel id="support-request" title="Details" panelWidth="22rem" max={CONTENT_READING}>
  <Firma2SupportRequestDetails slot="panel" />
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title={request.subject} crumbs={crumbs}>
      {/* Both states are rendered and one shows: the status is this browser's
          (firma2-support-request-record flips them), and a lego's own root
          does not hold `hidden`, so spans carry it. */}
      <span slot="status" class="cluster" data-gap="xs">
        <span data-support-status="open" hidden={request.status !== 'open'}>
          <EsaBadge value={SUPPORT_REQUEST_STATUS_LABEL.open} variant={SUPPORT_REQUEST_STATUS_TONE.open} size="md" />
        </span>
        <span data-support-status="resolved" hidden={request.status !== 'resolved'}>
          <EsaBadge value={SUPPORT_REQUEST_STATUS_LABEL.resolved} variant={SUPPORT_REQUEST_STATUS_TONE.resolved} size="md" />
        </span>
      </span>
      <span slot="actions" class="cluster" data-gap="xs">
        <span data-support-act="resolved" hidden={request.status === 'resolved'}>
          <EsaButton variant="primary" size="md">Mark resolved</EsaButton>
        </span>
        <span data-support-act="open" hidden={request.status === 'open'}>
          <EsaButton variant="secondary" size="md">Reopen</EsaButton>
        </span>
      </span>
    </Firma2PageHeader>
    <Firma2SupportRequestRecord />
  </div>
  </Firma2SidePanel>
</AppLayout>
