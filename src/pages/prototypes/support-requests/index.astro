---
// Support requests — the questions and problems sent to the people who run
// the workspace, worked through as an inbox: the list beside the selected
// request, Resolve and next. In the app rail's More group.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which requests still want an answer, and what is this one asking?"
// 2. READERS: the administrator answering requests. Hardest: the second
//    administrator, who has to see what a colleague already took — each row
//    says who has it. WHO IS NOT HERE: the person who sent the request — they
//    get the reply by email, and what they wait on is how long it sits in Open.
// 3. SERIES/SCALAR: the requests are a series, a selection list; the selected
//    one is a document (message, replies) with its facts last.
// 4. IRREVERSIBLE: a reply, once sent — so it is sent with a button. Resolving
//    is one click back (Reopen, in Resolved).
// 5. CUT: a table of every request with search and CSV (built first, replaced
//    by the inbox the same day), requests for access or a new organization
//    (Access requests has them), and priority.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2SidePanel from '../../../components/shared/firma2-side-panel.astro';
import Firma2SupportRequestRail from '../../../components/support/firma2-support-request-rail.astro';
import Firma2SupportRequestInbox from '../../../components/support/firma2-support-request-inbox.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { withBase } from '../../../lib/base';
---
<!-- manifest:
  layout: firma2-side-panel > stack(lg)
  sections:
    - details rail -> firma2-side-panel (firma2-rail) holding firma2-support-request-rail: the selected request's properties
    - page header -> firma2-page-header
    - inbox       -> firma2-support-request-inbox  (firma2-inbox: Open | Resolved; each pane a firma2-support-request-record)
-->
<AppLayout title="Support requests — ProjectFirma 2.0" active="support-requests" width="full">
  <Firma2SidePanel id="support-request" title="Details" panelWidth="22rem">
  <Firma2SupportRequestRail slot="panel" />
  <div class="stack" data-gap="lg">
    <Firma2PageHeader title="Support requests">
      <EsaButton slot="actions" variant="primary" tag="a" href={withBase('/prototypes/support-requests/new')}>New request</EsaButton>
    </Firma2PageHeader>
    <Firma2SupportRequestInbox />
  </div>
  </Firma2SidePanel>
</AppLayout>
