---
// Updates — everything that changed on every project in the workspace,
// newest first, grouped by month. The organization's Updates page at
// workspace scope.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What has happened across the workspace, and when?"
// 2. READERS: an administrator checking that the trust given to editors
//    between publishes is holding up. Hardest: the one looking for a single
//    kind of change among hundreds — hence the filter by kind, and edit
//    sessions folded so one person tidying a record is one row.
// 3. SERIES/SCALAR: one series, the feed. No scalars.
// 4. IRREVERSIBLE: nothing. The feed reads each project's change log and
//    comments; it edits nothing.
// 5. CUT: a project filter (each project's History answers "what changed on
//    this one"), a person filter, and publishing from here — the review page
//    publishes, with the diff in front of the reader.
//
// Zero page CSS.
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2OrgUpdates from '../../components/organizations/firma2-org-updates.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { projects } from '../../data/firma2-projects';
import { projectUpdates } from '../../data/firma2-organization-pages';
import { WORKSPACE_REVIEW_HREF } from '../../data/firma2-publishing';
import { withBase } from '../../lib/base';
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header -> firma2-page-header
    - feed        -> firma2-org-updates (every project's updates, by month, filterable by kind)
-->
<AppLayout title="Updates — ProjectFirma 2.0" active="updates" width="reading">
  <div class="stack" data-gap="xl">
    <Firma2PageHeader title="Updates">
      <EsaButton slot="actions" variant="secondary" appearance="outline" size="md" tag="a" href={withBase(WORKSPACE_REVIEW_HREF)}>Review</EsaButton>
    </Firma2PageHeader>
    <Firma2OrgUpdates updates={projectUpdates(projects)} />
  </div>
</AppLayout>
