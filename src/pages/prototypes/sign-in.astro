---
// Sign in — the workspace's front door, and the first step of the
// access-request walkthrough (?flow=access-requests).
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "How do I get in?"
// 2. READERS: anyone with a link to the workspace. Hardest: a newcomer who expects a "Create account" form. Not here: people already signed in.
// 3. SERIES/SCALAR: one choice among the workspace's sign-in methods.
// 4. IRREVERSIBLE: nothing.
// 5. CUT: a separate sign-up form (signing in creates the account), marketing copy, the app's navigation.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Firma2WelcomeFrame from '../../components/welcome/firma2-welcome-frame.astro';
import Firma2SignIn from '../../components/welcome/firma2-sign-in.astro';
---
<!-- manifest:
  layout: firma2-welcome-frame (center column, no app chrome)
  sections:
    - sign in -> firma2-sign-in
-->
<BaseLayout title="Sign in — ProjectFirma 2.0">
  <Firma2WelcomeFrame>
    <Firma2SignIn />
  </Firma2WelcomeFrame>
</BaseLayout>
