---
// Projects index — the portfolio landing screen for ProjectFirma 2.0. A header
// with the primary action, a row of the projects this user opened most
// recently, and the searchable/filterable project table under it. Search, the
// Stage/Program filter dropdowns, the record count, and CSV export all belong
// to firma2-project-grid, which owns the one AG Grid instance they all drive.
//
// Recently viewed sits ABOVE the table rather than beside or below it: it is
// the shortest path back to work already in progress, and it costs one row of
// vertical space that the table (which owns page scroll from here down) does
// not miss.
//
// The app chrome (top bar, omnibox, sidenav, account menu) and the page's
// padding come from AppLayout -> esa-app-shell, so this page is nothing but its
// spine and three sections. Zero page CSS.
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2RecentProjects from '../../components/projects/firma2-recent-projects.astro';
import Firma2ProjectGrid from '../../components/projects/firma2-project-grid.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header     -> firma2-page-header
    - recently viewed -> firma2-recent-projects
    - project grid    -> firma2-project-grid
-->
<AppLayout title="Projects — ProjectFirma 2.0" active="projects">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Projects">
      <EsaButton slot="actions" variant="primary">New project</EsaButton>
    </Firma2PageHeader>
    <Firma2RecentProjects />
    <Firma2ProjectGrid />
  </div>
</AppLayout>
