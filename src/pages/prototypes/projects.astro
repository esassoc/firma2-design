---
// Projects index — the portfolio landing screen for ProjectFirma 2.0. A header
// with the primary action, and the searchable/filterable project table under
// it. Search, the Stage/Program filter dropdowns, the record count, and CSV
// export all belong to firma2-project-grid, which owns the one AG Grid instance
// they all drive.
//
// The app chrome (top bar, omnibox, sidenav, account menu) and the page's
// padding come from AppLayout -> esa-app-shell, so this page is nothing but its
// spine and two sections. Zero page CSS.
import AppLayout from '../../layouts/AppLayout.astro';
import EsaPageHeader from '@esa/ecology/esa-page-header.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2ProjectGrid from '../../components/projects/firma2-project-grid.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header  -> esa-page-header
    - project grid -> firma2-project-grid
-->
<AppLayout title="Projects — ProjectFirma 2.0" active="projects">
  <div class="stack" data-gap="2xl">
    <EsaPageHeader title="Projects">
      <EsaButton slot="actions" variant="primary">New project</EsaButton>
    </EsaPageHeader>
    <Firma2ProjectGrid />
  </div>
</AppLayout>
