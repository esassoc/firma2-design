---
// Projects index — the portfolio landing screen for ProjectFirma 2.0. A header
// with the primary action, a row of the projects this user opened most
// recently, and the searchable/filterable project table under it. Search, the
// Stage/Program filter dropdowns, the record count, and CSV export all belong
// to firma2-project-grid, which owns the one AG Grid instance they all drive.
//
// Recently viewed sits ABOVE the table rather than beside or below it: it is
// the shortest path back to work already in progress, and it costs one row of
// vertical space that the table (which owns page scroll from here down) does
// not miss.
//
// THREE VIEWS OF THE SAME RECORDS (2026-11-12): Table (the default — the
// index grows, memory: indexes-are-tables), List (firma2-my-projects' media
// cards, a map plate per project, for someone who knows a project by its
// place) and Map (firma2-project-set-map over every project). One
// firma2-variant-switch flips them and keeps the choice in ?view=. Each view
// keeps its own search and filters; the peek opens from any of them.
//
// The app chrome (top bar, omnibox, sidenav, account menu) and the page's
// padding come from AppLayout -> esa-app-shell, so this page is nothing but its
// spine and three sections. Zero page CSS.
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2ProjectsActions from '../../components/projects/firma2-projects-actions.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2RecentProjects from '../../components/projects/firma2-recent-projects.astro';
import Firma2ProjectGrid from '../../components/projects/firma2-project-grid.astro';
import Firma2ProjectPeekLayout from '../../components/projects/firma2-project-peek-layout.astro';
import Firma2VariantSwitch from '../../components/shared/firma2-variant-switch.astro';
import Firma2MyProjects from '../../components/projects/firma2-my-projects.astro';
import Firma2ProjectSetMap from '../../components/shared/firma2-project-set-map.astro';
import { projects } from '../../data/firma2-projects';

const views = [
  { value: 'table', label: 'Table' },
  { value: 'list', label: 'List' },
  { value: 'map', label: 'Map' },
];
---
<!-- manifest:
  layout: firma2-project-peek-layout > stack(2xl)
  sections:
    - project peek    -> firma2-project-peek-layout      (docked rail, hidden until a
                                                     grid row's peek button opens it)
    - page header     -> firma2-page-header
    - recently viewed -> firma2-recent-projects
    - view switch     -> firma2-variant-switch (Table / List / Map, ?view=)
    - project grid    -> firma2-project-grid       (Table)
    - project cards   -> firma2-my-projects        (List)
    - project map     -> firma2-project-set-map    (Map)
  note: the peek is a NON-MODAL aside — the index stays fully interactive
        beside it, rows repaint it in place, and its width is a draggable
        `.sidebar` track (bcn-edge-handle). Hidden, it costs the layout
        nothing and the stack has the pane to itself. --sidebar-content-min is
        a LENGTH, small on purpose: the grid scrolls horizontally inside its
        own frame when the peek takes the room, which beats wrapping a 100dvh
        panel below the table.
        The page takes the full pane (width="full") and caps only the stack, so
        an open peek docks against the window's edge rather than the content cap.
-->
<AppLayout title="Projects — ProjectFirma 2.0" active="projects" width="full">
  <Firma2ProjectPeekLayout>
    <div class="stack" data-gap="2xl">
      <Firma2PageHeader title="Projects" aliasableTitle>
        <Firma2ProjectsActions slot="actions" />
      </Firma2PageHeader>
      <Firma2RecentProjects />
      <div class="stack" data-gap="lg">
        <div><Firma2VariantSwitch variants={views} label="View" /></div>
        <div data-variant="table"><Firma2ProjectGrid /></div>
        <div data-variant="list" hidden><Firma2MyProjects /></div>
        <div data-variant="map" hidden>
          <Firma2ProjectSetMap title="All projects" label="Every project's work areas" items={projects.map((project) => ({ project }))} />
        </div>
      </div>
    </div>
  </Firma2ProjectPeekLayout>
</AppLayout>
