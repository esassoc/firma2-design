---
// Access requests — the people waiting to get into an organization, and the
// organizations people have asked for, worked through as an inbox. In the app
// rail's More group.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Who is waiting to get in, and should this one be let in?"
// 2. READERS: the administrator answering requests across every organization.
//    Hardest: an administrator who does not know the requester — so the
//    evidence (is their email at the organization's own domain?) sits beside
//    the buttons. WHO IS NOT HERE: the person waiting. They see only
//    "pending", and never who decides (requesters never see managers).
// 3. SERIES/SCALAR: the requests are a series, a selection list in two views;
//    the selected one is a handful of scalars.
// 4. IRREVERSIBLE: nothing. An approval is undone from the organization's
//    Members list; a declined requester may ask again after 30 days.
// 5. CUT: answered requests (no history view yet), approving a new
//    organization here (its review page settles its name and near-duplicates
//    first), and a manager's own scoped queue (their organization's Members
//    settings keeps it).
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2AccessRequestInbox from '../../components/settings/firma2-access-request-inbox.astro';
---
<!-- manifest:
  layout: stack(lg)
  sections:
    - page header -> firma2-page-header
    - inbox       -> firma2-access-request-inbox  (firma2-inbox: Join | New organization; one pane, filled for the selected request)
-->
<AppLayout title="Access requests — ProjectFirma 2.0" active="access-requests" width="full">
  <div class="stack" data-gap="lg">
    <Firma2PageHeader title="Access requests" />
    <Firma2AccessRequestInbox />
  </div>
</AppLayout>
