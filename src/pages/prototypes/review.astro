---
// Review — the workspace's sweep: every project's public page, whether it is
// up to date, and each organization's backlog.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which public pages are behind, and whose sweep has slipped?"
// 2. READERS: an administrator, who answers for every organization's schedule.
//    Hardest: the administrator deciding where to spend an afternoon — the
//    oldest wait first, and the organizations whose schedules are overdue.
//    WHO IS NOT HERE: the editor who made the change; the project page is
//    theirs.
// 3. SERIES/SCALAR: three scalars (up to date, longest wait, overdue), then
//    two lists — the projects waiting, the organizations behind.
// 4. IRREVERSIBLE: nothing here. Publishing happens on each project's review
//    page, one project at a time, with the diff in front of the reader.
// 5. CUT: bulk publish (a publish nobody looked at is the failure this
//    workflow exists to prevent), per-editor scorecards, and a schedule
//    setting — each organization sets its own in Organization settings.
//
// Zero page CSS.
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2ReviewQueue from '../../components/review/firma2-review-queue.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { WORKSPACE_UPDATES_HREF, organizationBacklogs, organizationsByProject, workspaceQueue } from '../../data/firma2-publishing';
import { withBase } from '../../lib/base';

const queue = workspaceQueue();
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header -> firma2-page-header
    - queue       -> firma2-review-queue (workspace scope: summary, waiting, up to date, by organization)
-->
<AppLayout title="Review — ProjectFirma 2.0" active="review">
  <div class="stack" data-gap="xl">
    <Firma2PageHeader title="Review">
      <EsaButton slot="actions" variant="secondary" appearance="outline" size="md" tag="a" href={withBase(WORKSPACE_UPDATES_HREF)}>All updates</EsaButton>
    </Firma2PageHeader>
    <Firma2ReviewQueue queue={queue} overdueFor={queue.overdueFor} backlogs={organizationBacklogs()} organizationsOf={organizationsByProject()} />
  </div>
</AppLayout>
