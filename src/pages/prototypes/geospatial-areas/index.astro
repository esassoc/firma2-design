---
// Geospatial areas — the reading index: every place the workspace files
// projects by, on a map that fills the sheet, with how much work is in each.
// Classifications' twin for places (.scratch/geospatial-areas/spec.md,
// decisions 1 and 5); set up in Workspace settings. It is the Map page's
// frame over areas instead of project cards.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Where is the work?"
// 2. READERS: program staff and the executive asking about one watershed or
//    district; a partner who knows their place better than our goals.
//    WHO IS NOT HERE: the administrator — groups are set up in settings.
// 3. SERIES/SCALAR: one picture — the areas and the projects on a map — and a
//    homogeneous list of the areas beside it, most projects first.
// 4. IRREVERSIBLE: nothing. The page reads.
// 5. CUT: two groups on the map at once (they cover the same ground), a
//    project's card here (a project opens in the side sheet), and filters
//    beyond a search. An area's full measures table and funders stay on its page.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2AreaExplorer from '../../../components/geospatial/firma2-area-explorer.astro';
import Firma2ProjectPeekLayout from '../../../components/projects/firma2-project-peek-layout.astro';
import { withBase } from '../../../lib/base';
---
<!-- manifest:
  layout: firma2-project-peek-layout(max=false) > firma2-area-explorer
  sections:
    - project peek      -> firma2-project-peek-layout (docked side sheet, opened from a project on the map or in an area's column)
    - map, edge to edge -> firma2-area-explorer (areas on the map, listed in its floating column)
    - page header       -> firma2-page-header, in the map's floating head (slot="title"), h1 visually hidden
  note: width="full" so the map can reach every edge of the sheet.
-->
<AppLayout title="Geospatial areas — ProjectFirma 2.0" active="geospatial-areas" width="full">
  <Firma2ProjectPeekLayout max={false} panelWidth="35rem">
  <Firma2AreaExplorer>
    <Firma2PageHeader slot="title" title="Geospatial areas" hideTitle>
      <EsaButton slot="actions" variant="secondary" size="md" icon="settings" tag="a" href={withBase('/prototypes/workspace-settings/geospatial-areas')}>Edit geospatial areas</EsaButton>
    </Firma2PageHeader>
  </Firma2AreaExplorer>
  </Firma2ProjectPeekLayout>
</AppLayout>
