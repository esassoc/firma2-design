---
// Settings has no landing page of its own: the account menu's Settings lands
// on the first Personal section. A redirect rather than a duplicate, so there
// is one URL for it — the same move workspace-settings.astro makes. The page
// that used to live here (account, appearance, notifications on one screen) is
// now Preferences, Profile and Notifications under Settings › Personal.
import { withBase } from '../../lib/base';
return Astro.redirect(withBase('/prototypes/settings/preferences'));
---
