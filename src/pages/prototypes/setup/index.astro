---
// Setup — the home base for standing a tenant up. Not a wizard: a set of
// MILESTONES, each its own URL, resumable, in any order its dependencies allow.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is left before this tenant is stood up, and where do I
//    pick it up?" The meter answers it as one fraction, the cards answer it one
//    milestone at a time; both read the same derived statuses, so they cannot
//    disagree.
// 2. READERS: the program admin (Dana) in year zero, with a signed contract and
//    a folder of documents. Hardest to serve is her ABSENT counterpart — the six
//    staff who will meet every vocabulary she confirms here as the dropdowns on
//    their project records. Their burden is priced by the counts on each card:
//    "11 suggested organizations" is eleven names somebody will have to pick
//    from.
// 3. SERIES/SCALAR: one homogeneous set of cards, grouped by SUBJECT rather than
//    by dependency tier — an admin arrives knowing what she has answers for, not
//    what unlocks what. The completion meter is the page's only aggregate and it
//    leads, because it is the fraction she reports upward.
// 4. IRREVERSIBLE: nothing. Drafts are browser-local patches and milestone status
//    is derived, never stored, so no card gets a warning band. Reset demo is the
//    one destructive act and it is a ghost button in the bar, beside the way
//    out, not a danger zone.
// 5. CUT: step numbers, a "next step" prompt, and a per-milestone description.
//    All three assert a sequence the model does not have. Also cut: a lede under
//    the page title, which would be text about a page that already shows its own
//    state.
//
// The setup layer (bar + centred column) comes from SetupLayout.
import SetupLayout from '../../../layouts/SetupLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2SetupProgress from '../../../components/setup/firma2-setup-progress.astro';
import Firma2SetupMilestoneGrid from '../../../components/setup/firma2-setup-milestone-grid.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - bar action  -> SetupLayout bar slot      (Reset demo)
    - page header -> firma2-page-header
      - progress    -> firma2-setup-progress   (actions slot: fraction and sash)
    - milestones  -> firma2-setup-milestone-grid
-->
<SetupLayout title="Setup">
  <!-- The seam for re-running the demo, in the bar beside the way out. Ghost,
       because clearing a browser-local draft is not the page's workflow — it is
       the way back to the start of one. data-setup-reset lands on the lego's
       inner native button (esa-button forwards rest props to it), so the
       handler below is delegated on the document rather than bound to this
       element. -->
  <EsaButton slot="bar" variant="ghost" size="sm" data-setup-reset>Reset demo</EsaButton>

  <div class="stack" data-gap="2xl">
    {/* The meter rides the title line: one row reads Setup, the fraction, the
        sash. It is the page's only aggregate and it is what the h1 is about. */}
    <Firma2PageHeader title="Setup">
      <Firma2SetupProgress slot="actions" />
    </Firma2PageHeader>

    <Firma2SetupMilestoneGrid />

  </div>
</SetupLayout>

<script>
  import { clearSetupDraft } from '../../../lib/setup-draft';

  // clearSetupDraft dispatches `setup-draft-change`, so the meter and the cards
  // re-derive themselves. Nothing here touches either section directly.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (target?.closest('[data-setup-reset]')) clearSetupDraft();
  });
</script>
