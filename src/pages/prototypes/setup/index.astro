---
// Setup — the home base for standing a tenant up. Not a wizard: a map and a
// list, each journey its own URL, resumable, in any order its tier allows.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is left before this tenant is stood up, and where do I
//    pick it up?" The map answers it as a shape, the list answers it as rows;
//    both read the same derived statuses, so they cannot disagree.
// 2. READERS: the program admin (Dana) in year zero, with a signed contract and
//    a folder of documents. Hardest to serve is her ABSENT counterpart — the six
//    staff who will meet every vocabulary she confirms here as the dropdowns on
//    their project records. Their burden is priced by the counts on each row:
//    "11 suggested" is eleven organizations somebody will have to pick from.
// 3. SERIES/SCALAR: one homogeneous list, grouped by tier. Nothing scalar leads,
//    and nothing goes in a rail — the completion meter is the page's only
//    aggregate and it sits above the rows it totals.
// 4. IRREVERSIBLE: nothing. Drafts are browser-local patches and journey status
//    is derived, never stored, so no row gets a warning band. Reset demo is the
//    one destructive act and it is a ghost button, not a danger zone.
// 5. CUT: step numbers, a "next step" prompt, and a per-journey description.
//    All three assert a sequence the model does not have. Also cut: a
//    per-journey unit label on the row, which the counts already carry.
//
// The setup layer (bar + centred column) comes from SetupLayout.
import SetupLayout from '../../../layouts/SetupLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2SetupJourneyList from '../../../components/setup/firma2-setup-journey-list.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header  -> firma2-page-header        (action: Reset demo)
    - the journeys -> firma2-setup-journey-list
-->
<SetupLayout title="Setup">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Setup">
      <!-- The seam for re-running the demo. Ghost, because clearing a
           browser-local draft is not the page's workflow — it is the way back to
           the start of one. data-setup-reset lands on the lego's inner native
           button (esa-button forwards rest props to it), so the handler below
           is delegated on the document rather than bound to this element. -->
      <EsaButton slot="actions" variant="ghost" data-setup-reset>Reset demo</EsaButton>
    </Firma2PageHeader>

    <Firma2SetupJourneyList />

  </div>
</SetupLayout>

<script>
  import { clearSetupDraft } from '../../../lib/setup-draft';

  // clearSetupDraft dispatches `setup-draft-change`, so the map and the list
  // re-derive themselves. Nothing here touches either section directly.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (target?.closest('[data-setup-reset]')) clearSetupDraft();
  });
</script>
