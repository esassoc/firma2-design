---
// /prototypes/setup/classifications: the Classifications milestone, as a walk.
//
// Answers to docs/product-brief.md § 5, for this screen:
//   WHO         Dana, the tenant admin, standing the program up alone or beside
//               the account team; later, program staff adding a new focus area.
//   DOING WHAT  Naming the outcomes the portfolio is sliced by, the ones a board
//               asks "how much did we do toward", and deciding how many of them
//               one project may carry.
//   BRINGING    A project tracker whose Program area column already names them;
//               a sense of what the board reports on that no column records.
//   OPTIMIZING  Confirming what the tracker already said over typing it; one
//               question a screen; totals that still add up afterwards.
//   PAYS FOR    dbo.Classification rows (ClassificationName, and a one-line
//               ClassificationDescription where typed), and the tenant's
//               classification limit, one or two.
//   LEAVES OUT  Project types, the reporting calendar, performance measures.
//               See below.
//
// A CLASSIFICATION IS WHAT A PROJECT IS FOR. The teammate's 2026-09-23
// "Classifications Interview" mock drew the line this milestone keeps: "If your
// board would ask how much you did toward something, that something is a
// classification. If a name describes the kind of work instead, like fencing or
// fish passage, it is a project type." That is the portfolio's goal-style
// Classification vocabulary, with Project.program as the separate work type, so
// the milestone configures the first and leaves the second to its own journey.
//
// FOUR SCREENS, IN START'S WALK. The tracker's suggestions as tiles, one
// question over the whole cast; the classifications the tracker did not name,
// typed; the one preference, how many a project may carry; the roster and the
// arrow to the hub. The format is the Funding sources walk's, screen for screen,
// with the limit added as the third.
//
// KEPT FROM THE MOCK: the concept, suggestions (sourced from the uploaded
// tracker like every other milestone, not from theme answers), add, and the
// one-or-two limit with its argument: past two, "a $1M project reads as $3M or
// $4M toward your classifications, and the roll-up stops meaning anything".
// CUT FROM THE MOCK, 2026-09-23: the reporting calendar (it belongs to the
// program-shape journey), the draft measures (the measures journey exists), and
// the purpose explainer screen (the helper line under the name carries the
// distinction in one sentence; text about the page is banned on the surface).
import SetupLayout from '../../../layouts/SetupLayout.astro';
import Firma2SetupStepper from '../../../components/setup/firma2-setup-stepper.astro';
import Firma2SetupClassificationPicker from '../../../components/setup/firma2-setup-classification-picker.astro';
import Firma2SetupClassificationAdd from '../../../components/setup/firma2-setup-classification-add.astro';
import Firma2SetupClassificationLimit from '../../../components/setup/firma2-setup-classification-limit.astro';
import Firma2SetupClassificationRoster from '../../../components/setup/firma2-setup-classification-roster.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';

const stepIds = ['suggested', 'add', 'limit', 'review'];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - status counts  -> esa-badge   (two, slotted into the milestone band SetupLayout renders)
    - walk           -> firma2-setup-stepper
      - suggested      -> firma2-setup-classification-picker
      - add            -> firma2-setup-classification-add
      - limit          -> firma2-setup-classification-limit
      - review         -> firma2-setup-classification-roster
-->
<SetupLayout title="Classifications" width="wide" milestone="classifications">
  <!-- The counts the screens produce, at the top of the page. Synced by the
       script below from the same draft the screens read. -->
  <span slot="status" data-part="confirmed-count"><EsaBadge value="0 confirmed" variant="secondary" size="sm" /></span>
  <span slot="status" data-part="review-count"><EsaBadge value="0 to review" variant="secondary" size="sm" /></span>

  <Firma2SetupStepper stepIds={stepIds}>
    <Firma2SetupClassificationPicker />
    <Firma2SetupClassificationAdd />
    <Firma2SetupClassificationLimit />
    <Firma2SetupClassificationRoster />
  </Firma2SetupStepper>
</SetupLayout>

<script>
  import { listClassifications } from '../../../lib/setup-draft';

  const confirmedBadge = document.querySelector<HTMLElement>('[data-part="confirmed-count"] .esa-badge__text');
  const reviewBadge = document.querySelector<HTMLElement>('[data-part="review-count"] .esa-badge__text');

  const sync = (): void => {
    const records = listClassifications();
    const confirmed = records.filter((record) => record.status === 'confirmed').length;
    const toReview = records.filter((record) => record.status === 'suggested').length;

    if (confirmedBadge) confirmedBadge.textContent = `${confirmed} confirmed`;
    if (reviewBadge) reviewBadge.textContent = `${toReview} to review`;
  };

  document.addEventListener('setup-draft-change', sync);
  sync();
</script>
