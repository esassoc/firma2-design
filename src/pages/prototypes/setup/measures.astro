---
// /prototypes/setup/measures: the Performance measures milestone, as a walk.
//
// Answers to docs/product-brief.md § 5, for this screen:
//   WHO         Dana, the tenant admin, choosing what the program reports before
//               the first project does. NOT HERE: every project lead who will
//               enter a number for each measure kept, on each split, every year.
//   DOING WHAT  Picking the kinds of work the projects do, then the counts the
//               program reports for them, then two program-wide preferences: how
//               much detail, and whether funded projects commit to an amount.
//   BRINGING    An annual report and a grant agreement that already report
//               counts ("38 large wood structures and 6 beaver dam analogs"),
//               and a sense of what the funder asks for.
//   OPTIMIZING  Confirming counts the documents already report over naming new
//               ones; one question a screen; a list the measure setup prototype
//               can take as drafts.
//   PAYS FOR    Performance measure rows (name, unit, counting rule, kind of
//               work, at most one split), and the tenant's reporting detail and
//               project commitment preferences.
//   LEAVES OUT  Each measure's definition, reporter guidance and per-project
//               targets; reporting year, who enters numbers, uploads. See below.
//
// THE ONE QUESTION: which counts does this program report? Series is the
// counts; the two preferences are scalars, one screen each. Nothing here is
// irreversible: a measure kept here arrives as a draft, and a draft deletes.
// The expensive choice is the split, and it is priced where it is chosen.
//
// THE CUT, 2026-09-24. A teammate's interview mock asked more than this walk does. Four
// of its questions are answered elsewhere in the hub and are not asked again: reporting year
// (Program shape), who enters numbers (People's project editors), the uploads
// and the program intro (Start). The mock's definition, guidance and per-project
// target questions belong to the separate Performance measure setup prototype
// at /prototypes/performance-measures, where every measure kept here arrives as
// a draft ("just scaffold them out; they become drafts"). What stayed: its kinds
// of work, its library of counts, its document reading (five kinds, six counts,
// two considered and left out), and its two program-wide questions, detail and
// targets.
//
// SIX SCREENS, IN START'S WALK. The kinds as tiles, pre-pressed from the
// documents; the counts for the kinds kept, grouped by kind, the left-out pair
// last with the reason; counts typed in; the detail preference; the targets
// preference; the roster and "Go to setup". The format is the People walk's,
// with the kinds screen in front because the counts depend on it.
//
// A FIXED LIST IS ASKED AS A PREFERENCE. The fifteen kinds and their counts are
// the library's. The tenant answers which, and adds what the library lacks; it
// does not author the list (product brief § 4).
//
// THE SPLIT IS PRICED WHERE IT IS CHOSEN. The detail screen carries the cost of
// a split as its help text: every split is a choice each project makes every
// year, and a split added later cannot be filled in for years already reported.
// The admin never pays it; the project leads do.
//
// WHAT CAN BE CUT, AND WAS: a definition line on each tile. The library holds
// one for a single count; a tile carries unit and evidence, and the definition
// waits for measure setup.
import SetupLayout from '../../../layouts/SetupLayout.astro';
import Firma2SetupStepper from '../../../components/setup/firma2-setup-stepper.astro';
import type { SetupStep } from '../../../lib/setup-steps';
import Firma2SetupMeasureKinds from '../../../components/setup/firma2-setup-measure-kinds.astro';
import Firma2SetupMeasurePicker from '../../../components/setup/firma2-setup-measure-picker.astro';
import Firma2SetupMeasureAdd from '../../../components/setup/firma2-setup-measure-add.astro';
import Firma2SetupMeasureQuestion from '../../../components/setup/firma2-setup-measure-question.astro';
import Firma2SetupMeasureRoster from '../../../components/setup/firma2-setup-measure-roster.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';

// The walk and its rail labels (firma2-setup-step-rail); each Next names the step after it.
const steps: SetupStep[] = [
  { id: 'kinds', label: 'Kinds of work' },
  { id: 'measures', label: 'Measures' },
  { id: 'add', label: 'Add others' },
  { id: 'detail', label: 'Level of detail' },
  { id: 'targets', label: 'Project targets' },
  { id: 'review', label: 'Review' },
];
const stepIds = steps.map((step) => step.id);
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - status counts  -> esa-badge   (two, slotted into the milestone band SetupLayout renders)
    - walk           -> firma2-setup-stepper   (rail of labelled steps: firma2-setup-step-rail)
      - kinds          -> firma2-setup-measure-kinds
      - measures       -> firma2-setup-measure-picker
      - add            -> firma2-setup-measure-add
      - detail         -> firma2-setup-measure-question
      - targets        -> firma2-setup-measure-question
      - review         -> firma2-setup-measure-roster
-->
<SetupLayout title="Performance measures" width="wide" milestone="measures">
  <!-- The counts the screens produce, at the top of the page. Synced by the
       script below from the same draft the screens read. -->
  <span slot="status" data-part="confirmed-count"><EsaBadge value="0 confirmed" variant="secondary" size="sm" /></span>
  <span slot="status" data-part="review-count"><EsaBadge value="0 to review" variant="secondary" size="sm" /></span>

  <Firma2SetupStepper steps={steps} stepIds={stepIds}>
    <Firma2SetupMeasureKinds />
    <Firma2SetupMeasurePicker />
    <Firma2SetupMeasureAdd />
    <Firma2SetupMeasureQuestion question="detail" />
    <Firma2SetupMeasureQuestion question="targets" />
    <Firma2SetupMeasureRoster />
  </Firma2SetupStepper>
</SetupLayout>

<script>
  import { listMeasures } from '../../../lib/setup-draft';

  const confirmedBadge = document.querySelector<HTMLElement>('[data-part="confirmed-count"] .esa-badge__text');
  const reviewBadge = document.querySelector<HTMLElement>('[data-part="review-count"] .esa-badge__text');

  const sync = (): void => {
    const records = listMeasures();
    const confirmed = records.filter((record) => record.status === 'confirmed').length;
    const toReview = records.filter((record) => record.status === 'suggested').length;

    if (confirmedBadge) confirmedBadge.textContent = `${confirmed} confirmed`;
    if (reviewBadge) reviewBadge.textContent = `${toReview} to review`;
  };

  document.addEventListener('setup-draft-change', sync);
  sync();
</script>
