---
// /prototypes/setup/program-shape: the Program shape milestone, as a walk.
//
// Answers to docs/product-brief.md § 5, for this screen:
//   WHO         Dana, the tenant admin, standing the program up alone or beside
//               the account team.
//   DOING WHAT  Settling the three rules the program runs by: how money moves,
//               how it counts years, and whether projects start as proposals.
//   BRINGING    A grant agreement that states the fiscal year, a tracker with no
//               proposal rows, an annual report that says who delivers the work.
//   OPTIMIZING  Confirming what the documents already said over recalling it;
//               one question a screen; every rule reachable again by Back.
//   PAYS FOR    Three draft.intent answers with schema consequences: the
//               tenant's reporting year, whether dbo.ProjectStage 'Proposal' is
//               in use, and the default lead implementer.
//   LEAVES OUT  Who approves a proposal (dbo.Project has no approver column),
//               and the reports that consume the period. See below.
//
// THREE QUESTIONS MOVED OUT OF START, 2026-09-23. Andy approved moving money,
// time and proposals (new) onto this milestone so Start asks only what the
// program does. The answers stay in draft.intent, so the same intent functions
// serve both walks and journeysFromIntent reads them alike.
//
// PRE-ANSWERED FROM THE DOCUMENTS. Each question arrives with the option its
// document evidence argues for selected, and the evidence named under the
// prompt, once documents are uploaded. The admin confirms a rule; a saved answer
// always wins.
//
// THE ANSWERS HAVE CONSEQUENCES ELSEWHERE. The proposals answer decides whether
// the Proposal tile arrives pressed on the Project stages walk
// (firma2-setup-stage-picker); the reporting year is the period every report
// frames; fund-or-deliver sets the default lead implementer.
//
// NOT ASKED: who approves a proposal. A teammate's 2026-09-23 x-ray found no
// column for it, so it is an open question in the brief, not a screen.
//
// FOUR SCREENS, IN START'S WALK. One reusable question screen, three times, and
// the roster with "Go to setup".
import SetupLayout from '../../../layouts/SetupLayout.astro';
import Firma2SetupStepper from '../../../components/setup/firma2-setup-stepper.astro';
import type { SetupStep } from '../../../lib/setup-steps';
import Firma2SetupShapeQuestion from '../../../components/setup/firma2-setup-shape-question.astro';
import Firma2SetupShapeRoster from '../../../components/setup/firma2-setup-shape-roster.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';

// The walk and its rail labels (firma2-setup-step-rail); each Next names the step after it.
const steps: SetupStep[] = [
  { id: 'money', label: 'Funding role' },
  { id: 'time', label: 'Reporting period' },
  { id: 'proposals', label: 'Proposals' },
  { id: 'review', label: 'Review' },
];
const stepIds = steps.map((step) => step.id);
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - status counts  -> esa-badge   (two, slotted into the milestone band SetupLayout renders)
    - walk           -> firma2-setup-stepper   (rail of labelled steps: firma2-setup-step-rail)
      - money          -> firma2-setup-shape-question
      - time           -> firma2-setup-shape-question
      - proposals      -> firma2-setup-shape-question
      - review         -> firma2-setup-shape-roster
-->
<SetupLayout title="Program shape" width="wide" milestone="program-shape">
  <!-- The counts the screens produce, at the top of the page. Synced by the
       script below from the same draft the screens read. -->
  <span slot="status" data-part="decided-count"><EsaBadge value="0 decided" variant="secondary" size="sm" /></span>
  <span slot="status" data-part="open-count"><EsaBadge value="3 to decide" variant="secondary" size="sm" /></span>

  <Firma2SetupStepper steps={steps} stepIds={stepIds}>
    <Firma2SetupShapeQuestion questionId="money" />
    <Firma2SetupShapeQuestion questionId="time" />
    <Firma2SetupShapeQuestion questionId="proposals" />
    <Firma2SetupShapeRoster />
  </Firma2SetupStepper>
</SetupLayout>

<script>
  import { intentQuestionsFor } from '../../../data/firma2-setup';
  import { intentAnswered } from '../../../lib/setup-draft';

  const decidedBadge = document.querySelector<HTMLElement>('[data-part="decided-count"] .esa-badge__text');
  const openBadge = document.querySelector<HTMLElement>('[data-part="open-count"] .esa-badge__text');
  const total = intentQuestionsFor('program-shape').length;

  const sync = (): void => {
    const decided = intentAnswered(undefined, 'program-shape');
    if (decidedBadge) decidedBadge.textContent = `${decided} decided`;
    if (openBadge) openBadge.textContent = `${total - decided} to decide`;
  };

  document.addEventListener('setup-draft-change', sync);
  sync();
</script>
