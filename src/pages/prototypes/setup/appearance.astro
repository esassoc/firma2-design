---
// /prototypes/setup/appearance: the Names and appearance milestone, as a walk.
//
// Answers to docs/product-brief.md § 5, for this screen:
//   WHO         Dana, the tenant admin, standing the program up; the person NOT
//               here is every reader after go-live (a partner, a funder, a member
//               of the public), who meets these four answers on every page before
//               any data.
//   DOING WHAT  Confirming what the program is called and how it looks: its name
//               and mark, its word for a project, its color, and whether the site
//               is public.
//   BRINGING    A directory entry that already names the program and draws its
//               mark; an annual report that calls projects "restoration actions";
//               a Start answer about sharing work publicly.
//   OPTIMIZING  Confirming a default over typing one; one decision a screen; a
//               kept default written, so "kept" and "not asked" stay apart.
//   PAYS FOR    dbo.Tenant display name, short name, logo (a file name in the
//               mock), primary color and public-site flag; the FieldDefinition
//               label for "Project", singular and plural.
//   LEAVES OUT  The banner logo, a custom stylesheet, custom pages, and any
//               simulated preview of the app shell. See below.
//
// FOUR DECISIONS, THEN THE ROSTER. The names with the mark beside them; the
// project noun; the color; who can see the site; a table of all six settings and
// the arrow to the hub. The format is the Classifications walk's, screen for
// screen.
//
// EVERY DEFAULT HAS A SOURCE, 2026-09-23. The names and the mark are the
// tenant's own directory entry (tenantAppearanceDefaults); the noun is the annual
// report's wording when documents are uploaded, and ProjectFirma's "Project"
// otherwise; the color is the swatch nearest the mark's hue; the visibility is
// Start's "share our work publicly" answer, or Signed-in only. Keeping a default
// counts as an answer only once written, so every Next writes.
//
// NO PREVIEW, 2026-09-23. A mock app shell tinted in the chosen color would be a
// simulation of someone else's UI (brief § 4, "State the record; price the
// burden; never simulate someone else's UI"); the swatch is the color and the
// roster is the record. The banner logo and a custom stylesheet are site
// administration after go-live, not what a tenant needs to open.
import SetupLayout from '../../../layouts/SetupLayout.astro';
import Firma2SetupStepper from '../../../components/setup/firma2-setup-stepper.astro';
import Firma2SetupAppearanceName from '../../../components/setup/firma2-setup-appearance-name.astro';
import Firma2SetupAppearanceNoun from '../../../components/setup/firma2-setup-appearance-noun.astro';
import Firma2SetupAppearanceColor from '../../../components/setup/firma2-setup-appearance-color.astro';
import Firma2SetupAppearanceVisibility from '../../../components/setup/firma2-setup-appearance-visibility.astro';
import Firma2SetupAppearanceRoster from '../../../components/setup/firma2-setup-appearance-roster.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';

const stepIds = ['name', 'noun', 'color', 'visibility', 'review'];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - status counts  -> esa-badge   (two, slotted into the milestone band SetupLayout renders)
    - walk           -> firma2-setup-stepper
      - name           -> firma2-setup-appearance-name
      - noun           -> firma2-setup-appearance-noun
      - color          -> firma2-setup-appearance-color
      - visibility     -> firma2-setup-appearance-visibility
      - review         -> firma2-setup-appearance-roster
-->
<SetupLayout title="Names and appearance" width="wide" milestone="appearance">
  <!-- The counts the screens produce, at the top of the page. Synced by the
       script below from the same draft the screens read. -->
  <span slot="status" data-part="decided-count"><EsaBadge value="0 decided" variant="secondary" size="sm" /></span>
  <span slot="status" data-part="open-count"><EsaBadge value="4 to decide" variant="secondary" size="sm" /></span>

  <Firma2SetupStepper stepIds={stepIds}>
    <Firma2SetupAppearanceName />
    <Firma2SetupAppearanceNoun />
    <Firma2SetupAppearanceColor />
    <Firma2SetupAppearanceVisibility />
    <Firma2SetupAppearanceRoster />
  </Firma2SetupStepper>
</SetupLayout>

<script>
  import { appearanceAnswered } from '../../../lib/setup-draft';

  const decidedBadge = document.querySelector<HTMLElement>('[data-part="decided-count"] .esa-badge__text');
  const openBadge = document.querySelector<HTMLElement>('[data-part="open-count"] .esa-badge__text');

  const sync = (): void => {
    const answers = Object.values(appearanceAnswered());
    const decided = answers.filter(Boolean).length;

    if (decidedBadge) decidedBadge.textContent = `${decided} decided`;
    if (openBadge) openBadge.textContent = `${answers.length - decided} to decide`;
  };

  document.addEventListener('setup-draft-change', sync);
  sync();
</script>
