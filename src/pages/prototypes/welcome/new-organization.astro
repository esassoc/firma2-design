---
// Request a new organization — first sign-in › "My organization isn't listed".
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which organization should we add for you?"
// 2. READERS: a newcomer from an organization the workspace doesn't have. Hardest: someone whose organization IS here under another name — the look-alikes catch them before they send. Not here: the administrator, who judges it on Organizations › Requested.
// 3. SERIES/SCALAR: scalars — name, type, website, a message.
// 4. IRREVERSIBLE: nothing; it is a request, withdrawn from the welcome page.
// 5. CUT: logo, visibility, how people join (the administrator's defaults; the new manager changes them), description.
//
// Spec: .scratch/access-requests/spec.md (decisions 2, 7, 8, 18). Adds are pages.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Firma2WelcomeFrame from '../../../components/welcome/firma2-welcome-frame.astro';
import Firma2OrganizationRequestForm from '../../../components/welcome/firma2-organization-request-form.astro';
---
<!-- manifest:
  layout: firma2-welcome-frame (center column, no app chrome)
  sections:
    - form -> firma2-organization-request-form
-->
<BaseLayout title="Request a new organization — ProjectFirma 2.0">
  <Firma2WelcomeFrame>
    <Firma2OrganizationRequestForm />
  </Firma2WelcomeFrame>
</BaseLayout>
