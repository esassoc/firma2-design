---
// A document — one entry from the rail's Pages group that is a file rather than
// written text, opened as ?id=….
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does this document say?" — read here when it is a PDF.
// 2. READERS: anyone in the workspace looking up a guide, form or plan someone filed. Hardest: a partner who only ever opens the one link a colleague sent them — the PDF opens in place, no download, no app. Not here: the person who filed it, who did that in Add document.
// 3. SERIES/SCALAR: one file, with a title and a folder.
// 4. IRREVERSIBLE: Delete document — behind the "…", and it asks first. Replace file keeps the document and its link.
// 5. CUT: previews of non-PDF formats, several files per document, versions and links to files kept elsewhere.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2CustomDocument from '../../../components/shared/firma2-custom-document.astro';
import Firma2CustomDocumentActions from '../../../components/shared/firma2-custom-document-actions.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - document    -> firma2-custom-document
-->
<AppLayout title="Pages — ProjectFirma 2.0">
  <div class="stack" data-gap="2xl">
    {/* The title is filled from the document's id once the script reads it,
        and renamed in place like any record's name. */}
    <Firma2PageHeader title="Document" editableTitle={{ field: 'pageTitle', label: 'Title' }}>
      <Firma2CustomDocumentActions slot="actions" />
    </Firma2PageHeader>
    <Firma2CustomDocument />
  </div>
</AppLayout>
