---
// Add document — Pages › Add document, from the + on the rail's Pages heading
// or a folder's "…".
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which file, and where does it sit?"
// 2. READERS: whoever keeps the workspace's shared know-how — a program lead filing a guide, a form or a plan that already exists as a file. Hardest: someone with a Word or Excel file — it is kept and offered as a download, since only a PDF is read on the site. Not here: the document's readers, who meet it from the rail.
// 3. SERIES/SCALAR: scalars only — one file, a title and a folder.
// 4. IRREVERSIBLE: nothing — the title, folder and file can all change later.
// 5. CUT: several files at once, links to files kept elsewhere, and versions.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2PageCreateForm from '../../../components/shared/firma2-page-create-form.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - form        -> firma2-page-create-form
-->
<AppLayout title="Add document — Pages — ProjectFirma 2.0" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Add document" />
    <Firma2PageCreateForm kind="document" />
  </div>
</AppLayout>
