---
// Add dashboard — one more progress dashboard, in the rail's Dashboards group
// beside the workspace's Progress Dashboard.
//
// The brief's questions (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is this dashboard called, and what does it start as?"
// 2. READERS: an administrator building a view for one audience — a funder, a
//    board, a plan goal's working group. Not here: that audience, who will be
//    sent its link and read it without ever seeing this form.
// 3. SERIES/SCALAR: two scalars — title and starting point. No series.
// 4. IRREVERSIBLE: nothing. The dashboard can be renamed, moved or deleted
//    from its row in the rail, and every chart on it changed.
// 5. CUT: choosing charts here. A dashboard is built on the dashboard, where
//    the figures can be seen; the form only decides where to start.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2PageCreateForm from '../../../components/shared/firma2-page-create-form.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - form        -> firma2-page-create-form
-->
<AppLayout title="Add dashboard — Dashboards — ProjectFirma 2.0" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Add dashboard" />
    <Firma2PageCreateForm kind="dashboard" />
  </div>
</AppLayout>
