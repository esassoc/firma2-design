---
// A custom page — one entry from the rail's Pages group, opened as ?id=….
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does this page say?"
// 2. READERS: anyone in the workspace looking up how the work is done. Hardest: a partner who only ever opens the one page a colleague sent them. Not here: the page's author, who wrote it in Add page.
// 3. SERIES/SCALAR: one block of formatted text, with its images and files in it (a PDF previewed in place). Files live only in the text — one way to add them, one way to read them.
// 4. IRREVERSIBLE: Delete page — so it sits behind the "…" and asks first.
// 5. CUT: tables, previews of non-PDF files, sharing, and version history.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2CustomPage from '../../../components/shared/firma2-custom-page.astro';
import Firma2CustomPageActions from '../../../components/shared/firma2-custom-page-actions.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - page body   -> firma2-custom-page
-->
<AppLayout title="Pages — ProjectFirma 2.0" width="reading">
  <div class="stack" data-gap="2xl">
    {/* The title is filled from the page's id once the script reads it, and
        renamed in place like any record's name. */}
    <Firma2PageHeader title="Page" editableTitle={{ field: 'pageTitle', label: 'Title' }}>
      <Firma2CustomPageActions slot="actions" />
    </Firma2PageHeader>
    <Firma2CustomPage />
  </div>
</AppLayout>
