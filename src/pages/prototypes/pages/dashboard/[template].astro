---
// A dashboard added to the Dashboards group, opened as ?id=…. The same screen as the
// workspace's Progress Dashboard (../../progress-dashboard.astro, whose header
// answers the brief's questions); what differs is that this one has a name of
// its own and a row in the rail that renames and deletes it.
//
// ONE ROUTE PER TEMPLATE, because a tile is server-rendered: the dashboard's
// route serves the tiles of what it started from (see
// src/data/firma2-dashboards.ts). Its name comes from the entry behind ?id.
import AppLayout from '../../../../layouts/AppLayout.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2Dashboard from '../../../../components/dashboard/firma2-dashboard.astro';
import Firma2DashboardEntry from '../../../../components/dashboard/firma2-dashboard-entry.astro';
import Firma2RecordMode from '../../../../components/shared/firma2-record-mode.astro';
import { DASHBOARD_TEMPLATES, dashboardTemplate } from '../../../../data/firma2-dashboards';

export function getStaticPaths() {
  return DASHBOARD_TEMPLATES.map((t) => ({ params: { template: t.slug } }));
}
const template = dashboardTemplate(Astro.params.template ?? '');
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header -> firma2-page-header
    - entry       -> firma2-dashboard-entry
    - dashboard   -> firma2-dashboard
-->
<AppLayout title="Dashboard — Dashboards — ProjectFirma 2.0">
  <div class="stack" data-gap="xl">
    <Firma2PageHeader title="Dashboard" editableTitle={{ field: 'pageTitle', label: 'Title' }}>
      <div slot="actions" class="cluster" data-gap="xs">
        <EsaButton variant="secondary" size="md" icon="plus" data-dashboard-add data-edit-only>Add chart</EsaButton>
        <Firma2RecordMode noun="Dashboard" />
      </div>
    </Firma2PageHeader>
    <Firma2DashboardEntry />
    <Firma2Dashboard template={template} />
  </div>
</AppLayout>
