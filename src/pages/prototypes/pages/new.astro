---
// Add page — Pages › Add page, from the + on the rail's Pages heading.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is this page called, and where does it sit?"
// 2. READERS: whoever keeps the workspace's shared know-how — a program lead writing down how the work is done. Hardest: someone with a long guide to paste — they write it on the page itself, where the formatting is. Not here: the readers of the page, who meet it from the rail.
// 3. SERIES/SCALAR: scalars only — a title and a folder.
// 4. IRREVERSIBLE: nothing — every field can change later.
// 5. CUT: the text (the page's own editor holds it), page icons, and nesting folders inside folders (the rail nests one level).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2PageCreateForm from '../../../components/shared/firma2-page-create-form.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - form        -> firma2-page-create-form
-->
<AppLayout title="Add page — Pages — ProjectFirma 2.0" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Add page" />
    <Firma2PageCreateForm kind="page" />
  </div>
</AppLayout>
