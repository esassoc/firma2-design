---
// Add folder — Pages › Add folder, from the + on the rail's Pages heading.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is this folder called?"
// 2. READERS: whoever keeps the workspace's pages in order. Hardest: someone grouping pages that already exist — they drag or Move pages in from the rail. Not here: page readers.
//    After the add: Add page, with the new folder chosen — an empty folder's next step is its first page.
// 3. SERIES/SCALAR: one scalar — the name.
// 4. IRREVERSIBLE: nothing.
// 5. CUT: picking pages to move in, and folders inside folders (the rail nests one level).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2PageCreateForm from '../../../components/shared/firma2-page-create-form.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - form        -> firma2-page-create-form
-->
<AppLayout title="Add folder — Pages — ProjectFirma 2.0" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Add folder" />
    <Firma2PageCreateForm kind="folder" />
  </div>
</AppLayout>
