---
// What's new — the prototype's changelog, dated, newest first. Linked from the
// Help sheet's footer and findable in search.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What changed since I was last here?"
// 2. READERS: the returning reporter, a few visits a year, and a client
//    reviewer catching up between demos. Hardest: the reporter, who knows
//    only the screens they use, so entries name the screen first.
// 3. SERIES/SCALAR: one series — days, each a short list of changes.
// 4. IRREVERSIBLE: nothing; it reads.
// 5. CUT: commit hashes and authors, categories (New / Improved / Fixed),
//    and an intro paragraph.
//
// Public: no setting, role or plan hides it.
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2ChangelogList from '../../components/shared/firma2-changelog-list.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - entries     -> firma2-changelog-list
-->
<AppLayout title="What’s new — ProjectFirma 2.0" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="What’s new" />
    <Firma2ChangelogList />
  </div>
</AppLayout>
