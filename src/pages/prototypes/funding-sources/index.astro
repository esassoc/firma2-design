---
// Funding sources index — every funding source in the workspace, who offers
// it, whether it is taking requests, and what it has put into projects.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Where does the money come from, and which sources can a
//    project still ask?"
// 2. READERS: program staff tracking who funds the portfolio; a sponsor
//    looking for a source that is taking requests. WHO IS NOT HERE: the public
//    (the public site has no funding page).
// 3. SERIES/SCALAR: a homogeneous set of funding sources — one sortable,
//    searchable table.
// 4. IRREVERSIBLE: nothing; the page reads.
// 5. CUT: a portfolio total across sources (the Progress Dashboard holds
//    funding secured), grouping by organization (sort the column), and spend
//    by source (the record holds spend by year for the whole project).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2FundingSourceGrid from '../../../components/funding/firma2-funding-source-grid.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header     -> firma2-page-header
    - funding sources -> firma2-funding-source-grid  (one row per funding source)
-->
<AppLayout title="Funding sources — ProjectFirma 2.0" active="funding-sources">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Funding sources" aliasableTitle />
    <Firma2FundingSourceGrid />
  </div>
</AppLayout>
