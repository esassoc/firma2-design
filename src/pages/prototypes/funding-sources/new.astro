---
// Add funding source — Funding sources › Add funding source.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is this funding source called, and who offers it?"
// 2. READERS: program staff adding a grant or program before recording it on
//    projects. Hardest: someone unsure whether it is already in the list — the
//    form refuses the same name under the same organization.
// 3. SERIES/SCALAR: scalars only — a name, an organization, a description.
// 4. IRREVERSIBLE: nothing. It funds no project until a project links to it.
// 5. CUT: the workspace's funding source fields (answered on the source once
//    it exists; editing a source is not built), and amounts (a project's
//    funding row carries those).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2FundingSourceCreateForm from '../../../components/funding/firma2-funding-source-create-form.astro';
import { withBase } from '../../../lib/base';

const crumbs = [
  { label: 'Funding sources', href: withBase('/prototypes/funding-sources'), aliasable: true },
  { label: 'Add funding source' },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - form        -> firma2-funding-source-create-form
-->
<AppLayout title="Add funding source — Funding sources — ProjectFirma 2.0" active="funding-sources" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Add funding source" crumbs={crumbs} />
    <Firma2FundingSourceCreateForm />
  </div>
</AppLayout>
