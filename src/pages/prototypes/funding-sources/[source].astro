---
// One funding source's page — what it is, whether it is taking requests, and
// every project that asked it for money or holds some.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What has this source put into our projects, and who is
//    still waiting on it?"
// 2. READERS: program staff running a call against this source, reading the
//    slate; a sponsor checking whether it is open and until when. Hardest
//    reader: a program manager preparing the list of requests for a decision.
// 3. SERIES/SCALAR: the description, three totals and the recorded facts are
//    scalars; the projects are a series — a sortable table.
// 4. IRREVERSIBLE: nothing. Closing to requests is undone by reopening.
// 5. CUT: scoring and ranking (decision 17: the outcome is recorded, the
//    committee scores where it does today), spend against this source (the
//    record holds spend by year for the whole project), and editing the
//    source's name or organization (not built).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2FundingSourceSummary from '../../../components/funding/firma2-funding-source-summary.astro';
import Firma2FundingSourceRequests from '../../../components/funding/firma2-funding-source-requests.astro';
import Firma2FundingSourceProjects from '../../../components/funding/firma2-funding-source-projects.astro';
import { fundingSources } from '../../../data/firma2-funding-sources';
import type { FundingSource } from '../../../data/firma2-funding-sources';
import { fundingSourceRollup } from '../../../data/firma2-funding-source-rollup';
import { withBase } from '../../../lib/base';

export function getStaticPaths() {
  return fundingSources.map((source) => ({ params: { source: source.slug }, props: { source } }));
}

interface Props {
  source: FundingSource;
}

const { source } = Astro.props;
const rollup = fundingSourceRollup(source);
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header -> firma2-page-header
    - summary     -> firma2-funding-source-summary   (description, three totals, recorded facts)
    - requests    -> firma2-funding-source-requests  (accepting requests, last day to submit)
    - projects    -> firma2-funding-source-projects  (each project's amount and status)
-->
<AppLayout title={`${source.name} — Funding sources — ProjectFirma 2.0`} active="funding-sources">
  <div class="stack" data-gap="xl">
    <Firma2PageHeader
      title={source.name}
      crumbs={[
        { label: 'Funding sources', href: withBase('/prototypes/funding-sources'), aliasable: true },
        { label: source.name },
      ]}
    />
    <Firma2FundingSourceSummary rollup={rollup} />
    <Firma2FundingSourceRequests source={source} />
    <Firma2FundingSourceProjects rollup={rollup} />
  </div>
</AppLayout>
