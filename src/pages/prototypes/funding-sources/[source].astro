---
// One funding source's page — what it is, and every project it funds.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What has this source put into our projects?"
// 2. READERS: program staff tracking who funds the portfolio; a funder or
//    partner sent the link. Hardest reader: a grants manager checking the
//    award's recorded terms against the projects drawing on it.
// 3. SERIES/SCALAR: the description, two totals and the recorded facts are
//    scalars; the projects are a series — a sortable table.
// 4. IRREVERSIBLE: nothing; the page reads.
// 5. CUT: requests and calls for proposals (not modelled, user 2026-11-24),
//    spend against this source (the record holds spend by year for the whole
//    project), and editing the source's name or organization (not built).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2FundingSourceSummary from '../../../components/funding/firma2-funding-source-summary.astro';
import Firma2FundingSourceProjects from '../../../components/funding/firma2-funding-source-projects.astro';
import { fundingSources } from '../../../data/firma2-funding-sources';
import type { FundingSource } from '../../../data/firma2-funding-sources';
import { fundingSourceRollup } from '../../../data/firma2-funding-source-rollup';
import { withBase } from '../../../lib/base';

export function getStaticPaths() {
  return fundingSources.map((source) => ({ params: { source: source.slug }, props: { source } }));
}

interface Props {
  source: FundingSource;
}

const { source } = Astro.props;
const rollup = fundingSourceRollup(source);
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header -> firma2-page-header
    - summary     -> firma2-funding-source-summary   (description, two totals, recorded facts)
    - projects    -> firma2-funding-source-projects  (each project's amount)
-->
<AppLayout title={`${source.name} — Funding sources — ProjectFirma 2.0`} active="funding-sources">
  <div class="stack" data-gap="xl">
    <Firma2PageHeader
      title={source.name}
      crumbs={[
        { label: 'Funding sources', href: withBase('/prototypes/funding-sources'), aliasable: true },
        { label: source.name },
      ]}
    />
    <Firma2FundingSourceSummary rollup={rollup} />
    <Firma2FundingSourceProjects rollup={rollup} />
  </div>
</AppLayout>
