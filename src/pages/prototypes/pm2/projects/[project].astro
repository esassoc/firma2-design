---
// A project's PM 2 measures — the card projectfirma2 leads its project page
// with (story 0010), on its own page so it can sit beside the original project
// page's Performance measures section without either one changing the other.
// Built for every project: an unseeded one is the branch's empty-but-asked case
// (every published measure, nothing reported, no targets).
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What has this project delivered against what was asked of
//    it, and what is still to report this period?"
// 2. READERS: the project editor who reports; the administrator who sets
//    targets; the reader who only looks. "Viewing as" switches between them.
// 3. SERIES/SCALAR: a series per measure — periods across.
// 4. IRREVERSIBLE: nothing; every write is logged and can be undone by
//    another.
// 5. CUT: the rest of the project page — it is a link away.
import AppLayout from '../../../../layouts/AppLayout.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { withBase } from '../../../../lib/base';
import { projects, projectHref, projectSlug } from '../../../../data/firma2-projects';
import type { Project } from '../../../../data/firma2-projects';
import { PM2_ROUTES } from '../../../../data/firma2-pm2';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2Pm2ProjectMeasures from '../../../../components/pm2/firma2-pm2-project-measures.astro';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { project: projectSlug(project) }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header      -> firma2-page-header
    - measures         -> firma2-pm2-project-measures
-->
<AppLayout title={`${project.projectName} — Performance measures (PM 2) — ProjectFirma 2.0`} active="projects">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader
      title={project.projectName}
      crumbs={[{ label: 'Performance measures (PM 2)', href: withBase(PM2_ROUTES.catalog) }, { label: project.projectName }]}
    >
      <EsaButton slot="actions" variant="secondary" icon="arrow-right" tag="a" href={withBase(projectHref(project))}>Open the project page</EsaButton>
    </Firma2PageHeader>

    <Firma2Pm2ProjectMeasures projectSlug={projectSlug(project)} />
  </div>
</AppLayout>
