---
// A workspace page or document on the public site — not built yet. The shell
// (PublicLayout) is real; the page is next (.scratch/public-views/inventory.md
// #11, #12).
import PublicLayout from '../../../../layouts/PublicLayout.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import { TENANT_NAME } from '../../../../data/firma2-project-types';
import { PUBLIC_PAGES } from '../../../../data/firma2-public-site';

export function getStaticPaths() {
  return PUBLIC_PAGES.map((page) => ({ params: { page: page.id }, props: { label: page.label } }));
}

const { label } = Astro.props;
---
<!-- manifest:
  layout: PublicLayout (header, page, footer)
  sections:
    - not built yet -> esa-empty-state
-->
<PublicLayout title={`${label} — ${TENANT_NAME}`} current="pages">
  <EsaEmptyState title="This page isn’t built yet" size="lg" />
</PublicLayout>
