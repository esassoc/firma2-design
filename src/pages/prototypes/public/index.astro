---
// Public home — the front door of a workspace's public site.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is this program, where is its work, and is it real?"
// 2. READERS: the public and funders, arrived from a search or a link with no
//    account, no task and no vocabulary — the brief's least-trained reader.
//    Hardest: the one who has never heard of the program. Not here: anyone
//    signed in, whose front door is the app.
// 3. SERIES/SCALAR: scalars first — the program's size in four figures; then
//    the series, as a picture (every public project's work areas on one map),
//    as totals (what they have reported) and as a short list (what changed
//    lately).
// 4. IRREVERSIBLE: nothing — the page reads.
// 5. CUT: a stock banner and a tagline, a search box (the finder owns it), and a
//    second Sign in (the bar's is the door).
//
// TWO KINDS OF SECTION (2026-11-20). COMPUTED — figures, map, results, goals,
// recently updated, partners: derived from public projects, never editable,
// the page's proof. AUTHORED — announcement, description, featured projects
// (PUBLIC_HOME): the program's story, each with an editor in step 3. An
// administrator chooses what appears and never types a number.
//
// THE WORKSPACE ARRANGES IT (2026-11-24, .scratch/public-site-settings/spec.md).
// Which sections show, in what order, and each one's few choices are the
// site's settings; so are the fonts, the bar and the footer. The page below is
// the default arrangement, and what a reader with no script gets.
//
// PUBLIC PROJECTS ONLY, AT PUBLISHED VALUES: everything here is derived from
// publicProjects() (src/data/firma2-public-site.ts).
import PublicLayout from '../../../layouts/PublicLayout.astro';
import Firma2PublicAnnouncement from '../../../components/public/firma2-public-announcement.astro';
import Firma2PublicBlock from '../../../components/public/firma2-public-block.astro';
import Firma2PublicHero from '../../../components/public/firma2-public-hero.astro';
import Firma2PublicMapBand from '../../../components/public/firma2-public-map-band.astro';
import Firma2PublicSection from '../../../components/public/firma2-public-section.astro';
import Firma2PublicGoals from '../../../components/public/firma2-public-goals.astro';
import Firma2PublicRecent from '../../../components/public/firma2-public-recent.astro';
import Firma2PublicPartners from '../../../components/public/firma2-public-partners.astro';
import { PUBLIC_HOME, PUBLIC_SITE_OWNER, publicFeatured, publicGoals, publicMeasureTotals, publicPartners, publicProjects, publicRecentPool } from '../../../data/firma2-public-site';

import { publicSitePartHref } from '../../../lib/public-site-config';

const shown = publicProjects();
const goals = publicGoals();
---
<!-- manifest:
  layout: PublicLayout (header, page, footer) > firma2-public-section, one per section, in the order the site's settings give
  sections:
    - announcement   -> firma2-public-announcement (one authored notice; hidden when there is none)
    - hero           -> firma2-public-hero       (name, sentence, results at poster size, featured projects as photographs)
    - map            -> firma2-public-map-band   (relief map edge to edge; a panel of figures, goal filter and project list drives it)
    - goals          -> firma2-public-goals      (each plan goal, one measure against its target)
    - recent         -> firma2-public-recent     (the most recently updated projects, under their photos)
    - partners       -> firma2-public-partners   (funders with their totals; lead organizations as tiles)
    - authored blocks -> firma2-public-block     (templates: text, image with text, button, custom page; the settings place them)
-->
{/* A signed-in reader's way to this page's settings, first in the header's
    account menu — as a project's public page offers "Open project". */}
<PublicLayout title={PUBLIC_SITE_OWNER.name} workspaceDoor={{ label: 'Edit home page', href: publicSitePartHref('home') }}>
  <Firma2PublicAnnouncement site />
  {/* THE ORDER BELOW IS THE DEFAULT. Workspace settings › Public site › Home
      reorders, removes and adds sections; src/lib/public-site-apply.ts moves
      these by id. Results and recent projects render more than the default
      shows, so the settings have something to choose among. */}
  <div data-public-home>
    <Firma2PublicSection id="hero"><Firma2PublicHero totals={publicMeasureTotals(12)} featured={publicFeatured()} /></Firma2PublicSection>
    <Firma2PublicSection id="map"><Firma2PublicMapBand projects={shown} goals={goals} /></Firma2PublicSection>
    <Firma2PublicSection id="goals" contained><Firma2PublicGoals goals={goals} /></Firma2PublicSection>
    <Firma2PublicSection id="recent" contained><Firma2PublicRecent projects={publicRecentPool(9)} count={3} featured={PUBLIC_HOME.featured} /></Firma2PublicSection>
    <Firma2PublicSection id="partners" contained><Firma2PublicPartners partners={publicPartners()} /></Firma2PublicSection>
  </div>
  <Firma2PublicBlock />
</PublicLayout>
