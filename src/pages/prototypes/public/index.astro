---
// Public home — the front door of a workspace's public site.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is this program, where is its work, and is it real?"
// 2. READERS: the public and funders, arrived from a search or a link with no
//    account, no task and no vocabulary — the brief's least-trained reader.
//    Hardest: the one who has never heard of the program. Not here: anyone
//    signed in, whose front door is the app.
// 3. SERIES/SCALAR: scalars first — the program's size in four figures; then
//    the series, as a picture (every public project's work areas on one map),
//    as totals (what they have reported) and as a short list (what changed
//    lately).
// 4. IRREVERSIBLE: nothing — the page reads.
// 5. CUT: a stock banner and a tagline, a search box (the finder owns it), and a
//    second Sign in (the bar's is the door).
//
// TWO KINDS OF SECTION (2026-11-20). COMPUTED — figures, map, results, goals,
// recently updated, partners: derived from public projects, never editable,
// the page's proof. AUTHORED — announcement, description, featured projects
// (PUBLIC_HOME): the program's story, each with an editor in step 3. An
// administrator chooses what appears and never types a number.
//
// PUBLIC PROJECTS ONLY, AT PUBLISHED VALUES: everything here is derived from
// publicProjects() (src/data/firma2-public-site.ts).
import PublicLayout from '../../../layouts/PublicLayout.astro';
import Firma2PublicAnnouncement from '../../../components/public/firma2-public-announcement.astro';
import Firma2PublicHero from '../../../components/public/firma2-public-hero.astro';
import Firma2PublicMapBand from '../../../components/public/firma2-public-map-band.astro';
import Firma2PublicColumn from '../../../components/public/firma2-public-column.astro';
import Firma2PublicGoals from '../../../components/public/firma2-public-goals.astro';
import Firma2PublicRecent from '../../../components/public/firma2-public-recent.astro';
import Firma2PublicPartners from '../../../components/public/firma2-public-partners.astro';
import { PUBLIC_SITE_OWNER, publicFeatured, publicGoals, publicMeasureTotals, publicPartners, publicProjects, publicRecentlyUpdated } from '../../../data/firma2-public-site';

const shown = publicProjects();
const goals = publicGoals();
---
<!-- manifest:
  layout: PublicLayout (header, page, footer) > full-width bands, then firma2-public-column
  sections:
    - announcement   -> firma2-public-announcement (one authored notice; nothing when there is none)
    - hero           -> firma2-public-hero       (name, sentence, results at poster size, featured projects as photographs)
    - map            -> firma2-public-map-band   (relief map edge to edge; a panel of figures, goal filter and project list drives it)
    - goals          -> firma2-public-goals      (each plan goal, one measure against its target)
    - recent         -> firma2-public-recent     (the three most recently updated projects, under their photos)
    - partners       -> firma2-public-partners   (funders with their totals; lead organizations as tiles)
-->
<PublicLayout title={PUBLIC_SITE_OWNER.name}>
  <Firma2PublicAnnouncement />
  <Firma2PublicHero totals={publicMeasureTotals(4)} featured={publicFeatured()} />
  <Firma2PublicMapBand projects={shown} goals={goals} />
  <Firma2PublicColumn>
    <Firma2PublicGoals goals={goals} />
    <Firma2PublicRecent projects={publicRecentlyUpdated(3)} />
    <Firma2PublicPartners partners={publicPartners()} />
  </Firma2PublicColumn>
</PublicLayout>
