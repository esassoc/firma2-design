---
// Public project page — one project as the public and its funders see it,
// with no account and no app chrome. Built by the project's type and worn in
// the tenant's brand. Ported from ProjectFirma2 hackathon team 3.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is this project, whose is it, and is it real?"
// 2. READERS: the public and funders — the brief's least-trained reader,
//    and here the only one. No editing affordance appears anywhere.
// 3. SERIES/SCALAR: scalars in the rail (Key facts plus the tenant's own
//    rail fields), series in the main column — the project page's split.
// 4. IRREVERSIBLE: nothing — this page reads.
// 5. CUT: the app shell, contacts and comments (internal), the record's
//    change history, and every Add button (the shared sections take
//    `readonly`).
//
// THE PUBLISHED STATE, NOT THE RECORD (user, 2026-10-09). Editors change the
// record freely; this page shows what a steward last reviewed and published.
// A project never published has no public page — the reader gets a plain
// "not public yet" in its place.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Firma2PublicProject from '../../../components/public/firma2-public-project.astro';
import Firma2PublicUnpublished from '../../../components/public/firma2-public-unpublished.astro';
import { projects, projectSlug } from '../../../data/firma2-projects';
import type { Project } from '../../../data/firma2-projects';
import { getProjectDetail } from '../../../data/firma2-project-detail';
import { TENANT_NAME } from '../../../data/firma2-project-types';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { project: projectSlug(project) },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const detail = getProjectDetail(project);
const { publishing } = detail;
---
<!-- manifest:
  layout: stack
  sections:
    - public page  -> firma2-public-project (the last PUBLISHED state, not the live record)
    - not yet public -> firma2-public-unpublished (a project never published)
-->
<BaseLayout title={`${project.projectName} — ${TENANT_NAME}`}>
  {publishing.publishedIso ? (
    <Firma2PublicProject detail={detail} published={publishing.published} />
  ) : (
    <Firma2PublicUnpublished slug={projectSlug(project)} keys={publishing.changes.map((c) => c.key)}>
      <Firma2PublicProject detail={detail} />
    </Firma2PublicUnpublished>
  )}
</BaseLayout>
