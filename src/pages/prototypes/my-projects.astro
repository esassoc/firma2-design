---
// My Projects — the project editor's landing page. Ported from ProjectFirma2
// hackathon team 5 (project updates), story 0007.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which of my projects do I need to update, and where are they?"
// 2. READERS: whoever edits projects — a landowner with one (Wade), a program
//    lead entering thirty on sponsors' behalf (Theo). WHO IS NOT HERE: a
//    read-only reader, who browses the Projects index instead.
// 3. SERIES/SCALAR: a short series of records, each a handful of scalars and a
//    picture of its place — cards, not a table.
// 4. IRREVERSIBLE: nothing; it is a way in.
// 5. CUT: the mockup's reporting-cycle header, submitted-of-total meter and
//    status pills (team 5 moved status to field grain), and the update screen
//    itself — Update opens this spoke's Record work sheet instead.
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2MyProjects from '../../components/projects/firma2-my-projects.astro';
import Firma2MyProjectsMap from '../../components/projects/firma2-my-projects-map.astro';
import Firma2VariantSwitch from '../../components/shared/firma2-variant-switch.astro';
import Firma2ProjectPeekLayout from '../../components/projects/firma2-project-peek-layout.astro';
import { CURRENT_USER } from '../../data/firma2-directory';

const firstName = CURRENT_USER.name.split(' ')[0];
---
<!-- manifest:
  layout: firma2-project-peek-layout(max=false) > stack(2xl)
  sections:
    - page header    -> firma2-page-header (+ firma2-variant-switch in actions)
    - cards          -> firma2-my-projects      (data-variant="original")
    - map-based view -> firma2-my-projects-map  (data-variant="map")
  note: the page takes the full pane (width="full") so the map-based view's
        map can reach the window's right and bottom edges, and so the
        original's grid can run four cards a row.
-->
<AppLayout title="My Projects — ProjectFirma 2.0" active="my-projects" width="full">
  <Firma2ProjectPeekLayout max={false}>
    <div class="stack" data-gap="2xl">
      <Firma2PageHeader title={`Welcome back, ${firstName}`}>
        <Firma2VariantSwitch
          slot="actions"
          initial="map"
          variants={[{ value: 'original', label: 'Original' }, { value: 'map', label: 'Map based' }]}
        />
      </Firma2PageHeader>
      <div data-variant="original" hidden><Firma2MyProjects /></div>
      <div data-variant="map"><Firma2MyProjectsMap /></div>
    </div>
  </Firma2ProjectPeekLayout>
</AppLayout>
