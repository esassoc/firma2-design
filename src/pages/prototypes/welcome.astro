---
// Welcome — a newcomer's first sign-in: which organization do they work for?
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which organization do you work for?"
// 2. READERS: someone who just made an account — a Viewer with no organization, who sees what the public sees. Hardest: a consultant at a firm the workspace has never heard of. Not here: anyone admitted by a verified email domain; they skip this.
// 3. SERIES/SCALAR: one choice, then that organization's door (join, request, or ask a named manager); their own requests below.
// 4. IRREVERSIBLE: nothing — a request can be withdrawn, and joining by an open door is undone from the organization's Members page.
// 5. CUT: the app's navigation (nothing behind it is theirs yet), a tour, a profile step.
//
// Spec: .scratch/access-requests/spec.md (decision 17). Shown as the invented
// newcomer in firma2-access-requests (NEWCOMER).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Firma2WelcomeFrame from '../../components/welcome/firma2-welcome-frame.astro';
import Firma2WelcomeOrganization from '../../components/welcome/firma2-welcome-organization.astro';
import Firma2MyRequests from '../../components/welcome/firma2-my-requests.astro';
---
<!-- manifest:
  layout: firma2-welcome-frame (center column, no app chrome)
  sections:
    - question     -> firma2-welcome-organization
    - your requests -> firma2-my-requests
-->
<BaseLayout title="Welcome — ProjectFirma 2.0">
  <Firma2WelcomeFrame>
    <Firma2WelcomeOrganization />
    <Firma2MyRequests />
  </Firma2WelcomeFrame>
</BaseLayout>
