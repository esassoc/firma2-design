---
// Request a new organization — from inside the app (Join an organization ›
// "My organization isn't listed"). The first sign-in's version lives at
// /prototypes/welcome/new-organization in the bare frame; this one keeps the
// app's nav and returns to /prototypes/join.
//
// The brief's five: see the welcome version — same form, same readers; only
// the frame and the way back differ.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2OrganizationRequestForm from '../../../components/welcome/firma2-organization-request-form.astro';
import { withBase } from '../../../lib/base';
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header -> firma2-page-header
    - form        -> firma2-organization-request-form (back="/prototypes/join")
-->
<AppLayout title="Request a new organization — ProjectFirma 2.0" width="reading">
  <div class="stack" data-gap="xl">
    <Firma2PageHeader
      title="Request a new organization"
      crumbs={[
        { label: 'Join an organization', href: withBase('/prototypes/join') },
        { label: 'Request a new organization' },
      ]}
    />
    <Firma2OrganizationRequestForm back="/prototypes/join" />
  </div>
</AppLayout>
