---
// Performance measures index — every published measure and how far the
// portfolio has got on it. The READING page, in the main menu; the catalog an
// administrator configures is Workspace settings › Projects › Performance
// measures. Two pages for one entity, as classifications have (user,
// 2026-10-09). Until then this URL redirected to the settings catalog.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "How much has the portfolio delivered on each measure?"
// 2. READERS: the executive and program manager reading progress; a funder
//    or partner sent the link. WHO IS NOT HERE: the administrator defining
//    measures — that is Workspace settings.
// 3. SERIES/SCALAR: a homogeneous set of measures — one sortable,
//    searchable table, a ring and figure per row. Cards went 2026-10-09: at
//    volume they are hard to scan, compare and find in (user).
// 4. IRREVERSIBLE: nothing; the page reads.
// 5. CUT: drafts and retired measures (settings' business), grouping by goal
//    (a measure serves several, so it would repeat — the Classifications
//    index already reads measures by goal), and portfolio totals across
//    measures (different units).
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2MeasureProgressGrid from '../../components/measures/firma2-measure-progress-grid.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - measures    -> firma2-measure-progress-grid  (one row per published measure)
-->
<AppLayout title="Performance measures — ProjectFirma 2.0" active="performance-measures">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Performance measures" aliasableTitle />
    <Firma2MeasureProgressGrid />
  </div>
</AppLayout>
