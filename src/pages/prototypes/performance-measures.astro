---
// Performance measures — the tenant's measure catalog, and where a new one
// starts.
//
// THIS SCREEN IS A PATTERN EXERCISE FIRST. Performance measures happen to be
// the entity being set up, but the reusable deliverable is the entity-setup
// model underneath it: firma2-entity-create-dialog knows nothing about
// measures, and Organizations, Funding Sources and Users are expected to reuse
// it unchanged.
//
// THE MODEL, AND WHY IT IS NOT A WIZARD. An earlier version of this flow was a
// four-step drawer. It was replaced because a wizard encodes an assumption that
// does not hold: that the user completes setup in one sitting. Defining a
// performance measure is part exploration and part consulting other people —
// what unit does the program actually report in, does the funder require a
// subcategory, is this wording the reporters will understand.
//
// So creating a measure asks exactly ONE question — its data type, the single
// answer that decides whether a unit even applies — and hands back a saved
// Draft with its own URL. Everything else is filled in on that page, over days,
// from a link you can bookmark and send to a colleague. The catalog below shows
// those drafts alongside finished measures, unnamed ones included, because a
// list that hid your half-finished work would defeat the point.
//
// The app chrome (top bar, omnibox, sidenav, account menu) and the page's
// padding come from AppLayout -> esa-app-shell, so this page is nothing but its
// spine and three sections. Zero page CSS.
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2MeasureTable from '../../components/measures/firma2-measure-table.astro';
import Firma2EntityCreateDialog from '../../components/setup/firma2-entity-create-dialog.astro';
import { DATA_TYPES } from '../../data/firma2-performance-measures';

const CREATE_DIALOG_ID = 'new-measure';

// What each data type means for the person about to pick one, in terms of the
// value a reporter will eventually type. The dialog folds these onto the option
// label (esa-radio-group has no per-option description field — a filed gap), so
// they stay short enough to read as one line.
const TYPE_DESCRIPTIONS: Record<(typeof DATA_TYPES)[number], string> = {
  Number: 'a count with a unit, like acres or barriers',
  Percent: 'a share out of 100, like a survival rate',
  Currency: 'an amount in dollars, like cost per acre',
};

const typeOptions = DATA_TYPES.map((value) => ({
  value,
  label: value,
  description: TYPE_DESCRIPTIONS[value],
}));

// WHERE "Create draft" LANDS. A live build would POST the answer and redirect to
// the new record's own id. This spoke is statically built, so the dialog carries
// the answer as ?type= to the one genuinely empty draft in the catalog — the
// record that exists precisely to show what a measure looks like the moment
// after it is created. The setup page reads that parameter and preselects the
// data type, so the answer given here is the answer shown there.
const DRAFT_ROUTE = '/prototypes/measures/draft-untitled-number-measure';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header   -> firma2-page-header
    - measure list  -> firma2-measure-table
    - create dialog -> firma2-entity-create-dialog
-->
<AppLayout title="Performance measures — ProjectFirma 2.0" active="performance-measures">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Performance measures">
      <!-- "New measure", not "New performance measure": the page title two lines
           up already establishes what kind of thing this makes, and the dialog
           that opens says the full noun in its own heading. esa-button spreads
           ...rest, so data-opens reaches the native <button> and the dialog's
           document-level listener picks it up — no page script. -->
      <EsaButton slot="actions" variant="primary" data-opens={CREATE_DIALOG_ID}>New measure</EsaButton>
    </Firma2PageHeader>

    <Firma2MeasureTable />

    <Firma2EntityCreateDialog
      id={CREATE_DIALOG_ID}
      heading="New performance measure"
      question="What kind of value does this measure record?"
      helpText="This sets whether the measure needs a unit, and it cannot change once projects start reporting."
      options={typeOptions}
      createLabel="Create draft"
      destination={DRAFT_ROUTE}
    />
  </div>
</AppLayout>
