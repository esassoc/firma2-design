---
// Performance measures — the tenant's measure catalog and its subcategory
// schemas, one page, two views, everything edited in side sheets.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does this program measure, and is each measure ready
//    to collect?" The Schemas view answers the same question one level down —
//    "what can those measurements be divided by" — which is why it is a second
//    view here and not a second screen: same readers, same maintenance visit.
// 2. READERS: program admins configure; the client decision-maker reads the
//    catalog cold. Hardest to serve: the admin's ABSENT counterpart — the
//    REPORTER, who meets every schema attached here as a dropdown they must
//    answer. Their burden is priced on screen: the sheet says "None are
//    required", system schemas say who fills them in, and Used by counts the
//    blast radius of an edit.
// 3. SERIES/SCALAR: two homogeneous lists — tables, not rails. Nothing scalar
//    leads.
// 4. IRREVERSIBLE: nothing is (drafts are browser-local patches), so nothing
//    gets a warning band; the closest thing — editing a shared schema other
//    measures use — gets the Used by line at the moment of editing.
// 5. CUT: the measure detail PAGE (claim sentence, split chart, per-measure
//    URL). A flat attribute list stopped earning a navigation destination; a
//    form over a table is a sheet. Also cut: the concept library dialog —
//    creation starts blank in the same sheet editing uses.
//
// SETUP IS STILL NOT A WIZARD (§4): the sheet saves a Draft in any state of
// completeness, and Active is gated — not the form. The one-question create
// dialog died with the library flow; the type fork is now a field like any
// other, changeable until the answers make it consequential.
//
// The app chrome and the page's padding come from AppLayout → esa-app-shell.
// The page is its manifest: a header whose action swaps with the active view,
// the two tables inside the tab lego's panels, and the two sheets.
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2MeasureTable from '../../components/measures/firma2-measure-table.astro';
import Firma2SchemaTable from '../../components/measures/firma2-schema-table.astro';
import Firma2MeasureSidesheet from '../../components/measures/firma2-measure-sidesheet.astro';
import Firma2SchemaSidesheet from '../../components/measures/firma2-schema-sidesheet.astro';

// The two views. "Measures" first — it is the page's name and the majority
// visit; schemas are the supporting vocabulary one level down.
const TABS = [{ label: 'Measures' }, { label: 'Subcategory schemas' }];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header      -> firma2-page-header  (action swaps with the view)
    - view tabs        -> esa-tab-layout
      - measures       -> firma2-measure-table
      - schemas        -> firma2-schema-table
    - measure sheet    -> firma2-measure-sidesheet
    - schema sheet     -> firma2-schema-sidesheet
-->
<AppLayout title="Performance measures — ProjectFirma 2.0" active="performance-measures">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Performance measures">
      <!-- One primary action at a time — the one that creates what the active
           view lists. Both are rendered and the script swaps `hidden`, so the
           header never reflows. The plain <div> wrappers exist because
           `hidden` has to land on an element with no author display rule:
           esa-button forwards rest props to its INNER native button, whose
           own display wins over the UA's [hidden] — the same trap the measure
           table documents on esa-filter-clear-button. data-open-* is the
           sheets' delegated seam. -->
      <div slot="actions" data-view-action="0">
        <EsaButton variant="primary" data-open-measure="new">New measure</EsaButton>
      </div>
      <div slot="actions" data-view-action="1" hidden>
        <EsaButton variant="primary" data-open-schema="new">New schema</EsaButton>
      </div>
    </Firma2PageHeader>

    <esa-tab-layout class="firma2-measures-views" size="md" tabs={JSON.stringify(TABS)}>
      <div slot="panel-0">
        <Firma2MeasureTable />
      </div>
      <div slot="panel-1">
        <Firma2SchemaTable />
      </div>
    </esa-tab-layout>

    <Firma2MeasureSidesheet />
    <Firma2SchemaSidesheet />
  </div>
</AppLayout>

<script>
  import '@esa/ecology/esa-tab-layout';

  // The header's action follows the active view. The buttons carry their tab
  // index; the lego's bubbling `tabchange` carries the new one.
  const views = document.querySelector('.firma2-measures-views');
  const actions = document.querySelectorAll<HTMLElement>('[data-view-action]');
  views?.addEventListener('tabchange', (event) => {
    const index = (event as CustomEvent<{ index: number }>).detail?.index ?? 0;
    actions.forEach((el) => {
      el.hidden = Number(el.dataset.viewAction) !== index;
    });
  });
</script>
