//
// 1. ONE QUESTION: "Is my name and email right?"
// 2. READERS: anyone with an account. Hardest: a reporter whose email changed and who stopped getting mail. Not here: the administrator who assigns organization and role — named in the footer, not faked as rows.
// 3. SERIES/SCALAR: two scalars, as form fields.
// 4. IRREVERSIBLE: nothing; email would need verifying on a live system.
// 5. CUT: avatar upload, phone, job title.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2SettingsAccount from '../../../components/settings/firma2-settings-account.astro';
---
