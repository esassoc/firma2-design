---
// Security & access — Settings › Personal.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "How do I sign in, where am I signed in, and what can I reach?"
// 2. READERS: anyone with an account. Hardest: someone who lost a phone and needs to know which sessions are open. Not here: the administrator who sets role and organization.
// 3. SERIES/SCALAR: sign-in controls (scalars), a short session list, two read-only facts.
// 4. IRREVERSIBLE: signing out other sessions ends them; it gets its own button, no switch.
// 5. CUT: API tokens, login history beyond open sessions, recovery codes.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2SettingsSecurity from '../../../components/settings/firma2-settings-security.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header      -> firma2-page-header
    - sign-in, access  -> firma2-settings-security
-->
<AppLayout title="Security & access — Settings — ProjectFirma 2.0" nav="workspace-settings" active="me-security" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Security & access" />
    <Firma2SettingsSecurity />
  </div>
</AppLayout>
