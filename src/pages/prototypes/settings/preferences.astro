---
// Preferences — Settings › Personal.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "How do I want this app to look and behave for me?"
// 2. READERS: anyone with an account. Hardest: the occasional reporter told the app is hard to read, who will not come back to check it worked — so the change applies on the spot. Not here: nobody; the only person who lives with this is the one choosing.
// 3. SERIES/SCALAR: three scalars — theme, link underlines, pointer cursors —
//    then one ordered list per table: the columns you see.
// 4. IRREVERSIBLE: nothing; a table's columns go back to the workspace's in one click.
// 5. CUT: Save (the page repaints as you choose), theme swatches (the page is the preview), the card around the one section.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2SettingsInterface from '../../../components/settings/firma2-settings-interface.astro';
import Firma2SettingsGridColumns from '../../../components/settings/firma2-settings-grid-columns.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - interface   -> firma2-settings-interface
    - columns     -> firma2-settings-grid-columns
-->
<AppLayout title="Preferences — Settings — ProjectFirma 2.0" nav="workspace-settings" active="me-preferences" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Preferences" />
    <Firma2SettingsInterface />
    <Firma2SettingsGridColumns />
  </div>
</AppLayout>
