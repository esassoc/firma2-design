---
// Team 5 sandbox · My Projects — the project editor's landing page as Team 5
// built it (stories 0007 and 0015): the projects you can change, as cards,
// each with Update and Open.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which projects are mine to update?"
// 2. READERS: a project editor who reports twice a year, with one project or
//    thirty. Hardest: the one with thirty — hence search and the stage filter.
//    An administrator sees every project.
// 3. SERIES/SCALAR: one series, the cards. The count is the only scalar.
// 4. IRREVERSIBLE: nothing; the page only links.
// 5. CUT: Team 5 already cut the reporting-cycle header, the submitted-of-
//    total meter and a per-project status pill. Their greeting is cut here
//    too: the title says whose projects these are.
//
// THIS SPOKE'S OWN VERSION of this page became Map (/prototypes/map), where
// the card opens the project and there is no Update button. Indexes that grow
// are tables here (AG Grid), not card grids — the cards are Team 5's.
//
// Zero page CSS.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2UpdateSandboxBar from '../../../components/project-updates/firma2-update-sandbox-bar.astro';
import Firma2MyProjects from '../../../components/projects/firma2-my-projects.astro';
import { UPDATES_BASE } from '../../../data/firma2-project-updates';
import { withBase } from '../../../lib/base';
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header      -> firma2-page-header
    - sandbox controls -> firma2-update-sandbox-bar
    - cards            -> firma2-my-projects (mode="update": facts, Update and Open)
-->
<AppLayout title="Your projects — Team 5 sandbox">
  <div class="stack" data-gap="xl">
    <Firma2PageHeader title="Your projects" crumbs={[{ label: 'Team 5 sandbox', href: withBase(UPDATES_BASE) }, { label: 'Your projects' }]} />
    <Firma2UpdateSandboxBar />
    <Firma2MyProjects mode="update" />
  </div>
</AppLayout>
