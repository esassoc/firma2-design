---
// Team 5 sandbox — what ProjectFirma2's hackathon team 5 ("Streamlined Project
// Updates") built, rebuilt on this spoke's components and kept apart from the
// rest of the prototype so each part can be kept or dropped.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What did Team 5 build, and where do I look at each part?"
// 2. READERS: the product owner deciding what to keep. Nobody else lands
//    here; it is not a product screen and is in no navigation.
// 3. SERIES/SCALAR: one series, the features. No scalars.
// 4. IRREVERSIBLE: nothing. Everything the sandbox changes is in this
//    browser, and Reset sandbox puts it back.
// 5. CUT: a keep/drop control per row (the decision is made in conversation,
//    not stored in a prototype), screenshots of the original, and Team 5's
//    back-end work (document parsing, the two change tables), which has no
//    screen to show.
//
// Zero page CSS.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2UpdateSandboxBar from '../../../components/project-updates/firma2-update-sandbox-bar.astro';
import Firma2UpdateFeatures from '../../../components/project-updates/firma2-update-features.astro';
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header      -> firma2-page-header
    - sandbox controls -> firma2-update-sandbox-bar (seat, review flag, assistant flag, reset)
    - features         -> firma2-update-features    (each Team 5 feature, linked to its screen)
-->
<AppLayout title="Team 5 sandbox — ProjectFirma 2.0" width="reading">
  <div class="stack" data-gap="xl">
    <Firma2PageHeader title="Team 5: project updates" />
    <Firma2UpdateSandboxBar />
    <Firma2UpdateFeatures />
  </div>
</AppLayout>
