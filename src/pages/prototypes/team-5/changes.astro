---
// Team 5 sandbox · Pending changes — every project's edits waiting for an
// administrator, as Team 5 built it (stories 0005 and 0013, their ADR-0005).
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which edits are waiting for me to approve or reject?"
// 2. READERS: an administrator. Hardest: the one facing a season's worth at
//    once — every row carries its project, its old and new value and who
//    proposed it, so a row can be decided without opening the project.
//    WHO IS NOT HERE: the editor who proposed the change; they see it marked
//    as waiting on the project page.
// 3. SERIES/SCALAR: one series, the pending rows.
// 4. IRREVERSIBLE: nothing. An approved change can be reverted from the
//    project's change log; a rejected one stays in that log.
// 5. CUT: Team 5's paragraph explaining approve and reject, bulk approve, and
//    filters.
//
// THIS SPOKE REVIEWS DIFFERENTLY (/prototypes/review): editors edit live, and
// a manager publishes each project's net diff. Here every change row is
// approved before it applies.
//
// Zero page CSS.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2UpdateSandboxBar from '../../../components/project-updates/firma2-update-sandbox-bar.astro';
import Firma2UpdateChanges from '../../../components/project-updates/firma2-update-changes.astro';
import { UPDATES_BASE } from '../../../data/firma2-project-updates';
import { withBase } from '../../../lib/base';
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header      -> firma2-page-header
    - sandbox controls -> firma2-update-sandbox-bar
    - queue            -> firma2-update-changes (scope="workspace": every project's pending rows)
-->
<AppLayout title="Pending changes — Team 5 sandbox" width="reading">
  <div class="stack" data-gap="xl">
    <Firma2PageHeader title="Pending changes" crumbs={[{ label: 'Team 5 sandbox', href: withBase(UPDATES_BASE) }, { label: 'Pending changes' }]} />
    <Firma2UpdateSandboxBar />
    <Firma2UpdateChanges scope="workspace" />
  </div>
</AppLayout>
