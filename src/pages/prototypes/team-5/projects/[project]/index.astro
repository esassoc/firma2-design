---
// Team 5 sandbox · project page — the parts of the project page Team 5 added
// or changed: performance measure tiles, money by funding source and year,
// photos, documents, and the change log with review.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What does this project hold, and what about it is waiting
//    for review?"
// 2. READERS: the project's editor checking what they filed, and an
//    administrator reviewing it. Hardest: the administrator — every pending
//    thing is marked where it sits (a figure, a photo, a document) and listed
//    again in Changes, so nothing has to be hunted for.
// 3. SERIES/SCALAR: five series (measures, money, photos, documents,
//    changes). Spent to date is the one scalar.
// 4. IRREVERSIBLE: removing a photo or a document, which asks first.
//    Approving is not: an approved value can be reverted from Changes.
// 5. CUT: everything Team 5 inherited rather than built — the key-facts rail,
//    the work-area map and the milestone timeline (which their wrap-up meant
//    to drop). The spoke's own record page has all three.
//
// THE SPOKE'S OWN RECORD PAGE is /prototypes/projects/<slug>; this page does
// not replace or touch it.
//
// Zero page CSS.
import AppLayout from '../../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../../components/shared/firma2-page-header.astro';
import Firma2UpdateSandboxBar from '../../../../../components/project-updates/firma2-update-sandbox-bar.astro';
import Firma2UpdateMeasures from '../../../../../components/project-updates/firma2-update-measures.astro';
import Firma2UpdateFinancials from '../../../../../components/project-updates/firma2-update-financials.astro';
import Firma2UpdatePhotos from '../../../../../components/project-updates/firma2-update-photos.astro';
import Firma2UpdateDocuments from '../../../../../components/project-updates/firma2-update-documents.astro';
import Firma2UpdateChanges from '../../../../../components/project-updates/firma2-update-changes.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { projects, projectSlug } from '../../../../../data/firma2-projects';
import type { Project } from '../../../../../data/firma2-projects';
import { UPDATES_BASE, sandboxProjectsHref, sandboxUpdateHref } from '../../../../../data/firma2-project-updates';
import { withBase } from '../../../../../lib/base';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { project: projectSlug(project) }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const slug = projectSlug(project);
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header          -> firma2-page-header (action: Update this project)
    - sandbox controls     -> firma2-update-sandbox-bar
    - performance measures -> firma2-update-measures
    - money                -> firma2-update-financials (funding sources; budgeted and spent by source and year)
    - photos               -> firma2-update-photos
    - documents            -> firma2-update-documents
    - changes              -> firma2-update-changes (scope="project": pending review, then history)
-->
<AppLayout title={`${project.projectName} — Team 5 sandbox`}>
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader
      title={project.projectName}
      crumbs={[
        { label: 'Team 5 sandbox', href: withBase(UPDATES_BASE) },
        { label: 'Your projects', href: withBase(sandboxProjectsHref) },
        { label: project.projectName },
      ]}
    >
      <EsaButton slot="actions" variant="primary" size="md" tag="a" href={withBase(sandboxUpdateHref(slug))}>Update this project</EsaButton>
    </Firma2PageHeader>
    <Firma2UpdateSandboxBar />
    <div id="measures"><Firma2UpdateMeasures slug={slug} /></div>
    <div id="financials"><Firma2UpdateFinancials slug={slug} /></div>
    <div id="photos"><Firma2UpdatePhotos slug={slug} /></div>
    <div id="documents"><Firma2UpdateDocuments slug={slug} /></div>
    <div id="changes"><Firma2UpdateChanges scope="project" slug={slug} /></div>
  </div>
</AppLayout>
