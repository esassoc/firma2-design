---
// Team 5 sandbox · update screen — the reporter's own screen as Team 5 built
// it (stories 0008, 0011, 0016 and wrap-up 0017): everything this project can
// be updated on, a box to describe the update in words, speech or files, and
// one Save for all of it.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is this project asking me for, and can I answer it
//    in one sitting?"
// 2. READERS: a project editor who reports twice a year — "three numbers and
//    a photo, in the ten minutes I have". Hardest: exactly that person, who
//    does not know which rows of the record hold their three numbers. An
//    administrator gets the same screen.
// 3. SERIES/SCALAR: one series, the fields, grouped by what they are (this
//    year's work, this year's money, the record). No scalars.
// 4. IRREVERSIBLE: nothing. Reading an update only fills boxes; Save writes,
//    or sends for review, and every saved value can be reverted.
// 5. CUT: Team 5's two introductory paragraphs, the cards around each group,
//    and the "open slots" for years with no expenditure row yet.
//
// THIS PAGE HAS A SAVE BUTTON AND THE SPOKE'S RECORD PAGE DOES NOT. The
// product brief calls a commit bar "friction wearing a safety costume";
// Team 5's argument for one here is that a season's report is one job, and a
// machine's proposal is not a value someone already knows. Kept as they built
// it, for the decision.
//
// Zero page CSS.
import AppLayout from '../../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../../components/shared/firma2-page-header.astro';
import Firma2UpdateSandboxBar from '../../../../../components/project-updates/firma2-update-sandbox-bar.astro';
import Firma2UpdateForm from '../../../../../components/project-updates/firma2-update-form.astro';
import { projects, projectSlug } from '../../../../../data/firma2-projects';
import type { Project } from '../../../../../data/firma2-projects';
import { UPDATES_BASE, sandboxProjectHref, sandboxProjectsHref } from '../../../../../data/firma2-project-updates';
import { withBase } from '../../../../../lib/base';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { project: projectSlug(project) }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const slug = projectSlug(project);
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header      -> firma2-page-header
    - sandbox controls -> firma2-update-sandbox-bar
    - update           -> firma2-update-form (composer, fields by group, one Save)
-->
<AppLayout title={`Update ${project.projectName} — Team 5 sandbox`} width="reading">
  <div class="stack" data-gap="xl">
    <Firma2PageHeader
      title="Update this project"
      crumbs={[
        { label: 'Team 5 sandbox', href: withBase(UPDATES_BASE) },
        { label: 'Your projects', href: withBase(sandboxProjectsHref) },
        { label: project.projectName, href: withBase(sandboxProjectHref(slug)) },
        { label: 'Update' },
      ]}
    />
    <Firma2UpdateSandboxBar />
    <Firma2UpdateForm slug={slug} />
  </div>
</AppLayout>
