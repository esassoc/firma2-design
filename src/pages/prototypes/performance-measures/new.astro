---
// New measure — draft a performance measure from what the program lead needs
// to tell their funder. Ported from ProjectFirma2 hackathon team 6.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What should this measure ask, given what I need to say?"
// 2. READERS: a program lead who knows the work and does not yet have the
//    sentence. Hardest to serve: that lead — the one who can recognise the
//    right claim and cannot compose it. And who is NOT here: every reporter
//    who will answer this measure, every year. Their cost is priced at the
//    moment the split is chosen, and again on the draft.
// 3. SERIES/SCALAR: neither yet — this page writes a definition, and the
//    definition is finished in the catalog's sheet.
// 4. IRREVERSIBLE: the split. It is the one choice priced while open.
// 5. CUT: the chooser dialog the hackathon put in front of two pages (both
//    doors share this page), its separate theme vocabulary (the chips are
//    the classifications projects already use), and the live reporter-form
//    preview (the brief retired form simulacra; the draft states the record).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2MeasureDrafter from '../../../components/measures/firma2-measure-drafter.astro';
import { withBase } from '../../../lib/base';

const crumbs = [
  { label: 'Performance measures', href: withBase('/prototypes/performance-measures') },
  { label: 'New measure' },
];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - drafter     -> firma2-measure-drafter
-->
<AppLayout title="New measure — ProjectFirma 2.0" active="performance-measures">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="New measure" crumbs={crumbs} />
    <Firma2MeasureDrafter />
  </div>
</AppLayout>
