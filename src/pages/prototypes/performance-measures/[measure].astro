---
// One performance measure's reading page — what it counts, the portfolio's
// figure, how it moved year by year, where it stands under each
// classification, where the work is, the projects that report it, and how it
// is asked. The door the index's rows open. Rebuilt 2026-10-09 from the
// section list agreed with the user. Its settings twin is Workspace settings › Performance
// measures › <measure>, one click away for an administrator (user,
// 2026-10-09).
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "How far along is this measure, and can I trust and
//    explain the number?"
// 2. READERS: program staff reading the total; a funder asking what an acre
//    "restored" means and how many there are. WHO IS NOT HERE: the
//    administrator — "Edit measure" takes them to settings.
// 3. SERIES/SCALAR: the definition and three figures are scalars, stated once
//    at the top (the third is last year's filing, so the total's completeness
//    is read before the total is quoted); the years are a series, charted;
//    the classifications and the projects are homogeneous sets.
// 4. IRREVERSIBLE: nothing; the page reads.
// 5. CUT: a by-breakdown split (the seeded project figures carry no
//    breakdown answers; a seam for when entries do), funders (a grant funds a
//    project, not a measure — crediting it here would double-count), and the
//    measure's claim (the author's own-voice note, wrong in front of a
//    funder).
//
// THE MEASURE'S OWN RECORD IS IN THE RAIL (user, 2026-10-09: "metadata of
// the entity should be on the rail, similarly to how it's handled for
// metadata of a project"): Key facts — status, unit, counting rule,
// breakdowns, reporter guidance — over Connections, as a project's rail
// stacks its facts over its graph. The definition stays the main column's
// lede: the figures are read against it.
//
// CONNECTIONS IN THE RAIL (user, 2026-10-09): the measure's goals and the
// projects reporting it, as a local graph — in firma2-project-peek-layout's
// rail slot, so a project opened from the table or the map takes the rail's
// track and gives it back on close (the organization page's construction).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2ProjectPeekLayout from '../../../components/projects/firma2-project-peek-layout.astro';
import Firma2MeasurePortfolio from '../../../components/measures/firma2-measure-portfolio.astro';
import Firma2MeasureHistory from '../../../components/measures/firma2-measure-history.astro';
import Firma2MeasureClassifications from '../../../components/measures/firma2-measure-classifications.astro';
import Firma2ProjectSetMap from '../../../components/shared/firma2-project-set-map.astro';
import Firma2MeasureProjects from '../../../components/measures/firma2-measure-projects.astro';
import Firma2MeasureFacts from '../../../components/measures/firma2-measure-facts.astro';
import { measurePortfolio } from '../../../data/firma2-classification-rollup';
import Firma2RecordRail from '../../../components/shared/firma2-record-rail.astro';
import Firma2EntityConnections from '../../../components/shared/firma2-entity-connections.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { measureGraph } from '../../../lib/entity-graph';
import { measures, measureDisplayName } from '../../../data/firma2-performance-measures';
import type { PerformanceMeasureDefinition } from '../../../data/firma2-performance-measures';
import { withBase } from '../../../lib/base';
import { MEASURES_INDEX, measureSettingsHref } from '../../../lib/measure-pages';

export function getStaticPaths() {
  return measures.map((measure) => ({ params: { measure: measure.slug }, props: { measure } }));
}

interface Props {
  measure: PerformanceMeasureDefinition;
}

const { measure } = Astro.props;
const name = measureDisplayName(measure);
const reporting = measurePortfolio(measure).contributions.map((c) => ({ project: c.project }));
---
<!-- manifest:
  layout: firma2-project-peek-layout > stack(2xl)
  sections:
    - project peek      -> firma2-project-peek-layout     (docked, opened from a project row or a map popup)
    - rail              -> firma2-record-rail             (slot="rail"; gives way to the peek)
      - key facts       -> firma2-measure-facts           (status, unit, counting rule, breakdowns, guidance)
      - connections     -> firma2-entity-connections      (goals + projects, local graph)
    - page header       -> firma2-page-header             (Edit measure → its settings page)
    - summary           -> firma2-measure-portfolio       (definition, reported, projects, last year's filing)
    - by year           -> firma2-measure-history         (reported vs planned; esa-chart + View as data)
    - by classification -> firma2-measure-classifications (progress against each classification's goal)
    - where             -> firma2-project-set-map         (the reporting projects' work areas)
    - projects          -> firma2-measure-projects        (sortable table)
-->
<AppLayout title={`${name} — Performance measures — ProjectFirma 2.0`} active="performance-measures" width="full">
  <Firma2ProjectPeekLayout>
    <Firma2RecordRail slot="rail" label="connections" sizeVar="--firma2-record-rail-width">
      <div class="stack" data-gap="2xl">
        <Firma2MeasureFacts measure={measure} />
        <Firma2EntityConnections graph={measureGraph(measure)} />
      </div>
    </Firma2RecordRail>
    <div class="stack" data-gap="2xl">
      <Firma2PageHeader
        title={name}
        crumbs={[
          { label: 'Performance measures', href: withBase(MEASURES_INDEX), aliasable: true },
          { label: name },
        ]}
      >
        <EsaButton slot="actions" variant="secondary" size="md" icon="settings" tag="a" href={withBase(measureSettingsHref(measure.slug))}>Edit measure</EsaButton>
      </Firma2PageHeader>
      <Firma2MeasurePortfolio measure={measure} />
      <Firma2MeasureHistory measure={measure} />
      <Firma2MeasureClassifications measure={measure} />
      <Firma2ProjectSetMap title="Where the work is" label={`Map of the projects reporting ${name}`} items={reporting} />
      <Firma2MeasureProjects measure={measure} />
    </div>
  </Firma2ProjectPeekLayout>
</AppLayout>
