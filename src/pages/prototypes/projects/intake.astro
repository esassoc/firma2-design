---
// A proposal — one intake project, opened as ?id=…: its steps while it is a
// draft or returned, its answers read back once submitted, with the steward's
// Approve and Return. Spec: .scratch/project-intake/spec.md.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Is this proposal ready, and what is it?"
// 2. READERS: the member filling it in, and the steward deciding on it.
//    Hardest: the member whose proposal came back — the steward's note sits
//    at the top, above the step it is about.
// 3. SERIES/SCALAR: the form's screens as steps, then a review.
// 4. IRREVERSIBLE: Submit, Approve and Return each change who acts next;
//    none deletes anything.
// 5. CUT: deleting a draft, sharing controls, a per-answer comment thread.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2IntakeFlow from '../../../components/projects/firma2-intake-flow.astro';
---
<!-- manifest:
  layout: stack(xl) (inside firma2-intake-flow)
  sections:
    - page header + steps or proposal -> firma2-intake-flow
-->
<AppLayout title="Proposal — ProjectFirma 2.0" active="projects" width="reading">
  <Firma2IntakeFlow mode="draft" />
</AppLayout>
