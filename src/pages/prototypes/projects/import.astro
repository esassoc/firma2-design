---
// Import projects — a program's own spreadsheet, many projects at once.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What will this file add to the workspace, and what does it
//    need from me first?"
// 2. READERS: an administrator moving a program's project list in, at setup or
//    when a partner joins. Hardest: the first import, from a sheet built for
//    people, not for this product. NOT HERE: every reader of a roll-up this
//    import feeds — a value matched wrong splits their totals — and each lead
//    organization, whose list gains projects it did not enter.
// 3. SERIES/SCALAR: series throughout — columns, values, rows. Each section
//    lists only what still needs a decision.
// 4. IRREVERSIBLE: nothing. Undo takes back everything one import wrote, so
//    the commit gets a count, not a warning.
// 5. CUT: an import history, scheduled imports, creating fields from a column
//    (fields are made in Custom fields), and mapping funding or expenditures,
//    which are their own imports.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2ProjectImport from '../../../components/projects/firma2-project-import.astro';
import { withBase } from '../../../lib/base';
---
<!-- manifest:
  sections:
    - import      -> firma2-project-import (four steps; its rail is firma2-side-panel; the commit is in its step footer)
    - page header -> firma2-page-header    (in the import's main column, beside the rail)
  note: the page takes the full pane (width="full") so the preview rail docks
        at the window's edge, as on the measure page.
-->
<AppLayout title="Import projects — ProjectFirma 2.0" active="projects" width="full">
  <Firma2ProjectImport>
    <Firma2PageHeader
      title="Import projects"
      hideTitle
      crumbs={[{ label: 'Projects', href: withBase('/prototypes/projects'), aliasable: true }, { label: 'Import projects' }]}
    />
  </Firma2ProjectImport>
</AppLayout>
