---
// Import work areas — one partner file, boundaries for many projects. Ported
// from ProjectFirma2 hackathon team 2 (geospatial).
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which of these shapes belongs to which of our projects?"
// 2. READERS: the program manager onboarding a partner's file. WHO IS NOT
//    HERE: each project's owner, whose page gains shapes they did not draw.
// 3. SERIES/SCALAR: two tables — what matched, and what did not.
// 4. IRREVERSIBLE: nothing; each added shape can be deleted on its project.
// 5. CUT: replacing a project's existing shapes (they are added beside), and
//    importing while the workspace subscribes (a second owner for a shape).
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2WorkAreaImport from '../../../components/projects/firma2-work-area-import.astro';
import { withBase } from '../../../lib/base';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - import      -> firma2-work-area-import
-->
<AppLayout title="Import work areas — ProjectFirma 2.0" active="projects" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader
      title="Import work areas"
      crumbs={[{ label: 'Projects', href: withBase('/prototypes/projects'), aliasable: true }, { label: 'Import work areas' }]}
    />
    <Firma2WorkAreaImport />
  </div>
</AppLayout>
