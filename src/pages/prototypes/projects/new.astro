---
// New project — the intake form's first screen. Continue saves a draft and
// moves to its own page (projects/intake?id=…); `?preview=1` is the builder's
// Preview and runs every screen without saving. Spec:
// .scratch/project-intake/spec.md.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What is this project, in the few answers that decide the rest?"
// 2. READERS: a member proposing work. Hardest: the one who has half the
//    answers today — Continue saves a draft they can come back to.
// 3. SERIES/SCALAR: scalars, one screen of the workspace's own questions.
// 4. IRREVERSIBLE: nothing. A draft counts nowhere until it is submitted.
// 5. CUT: everything after the first screen, until there is a draft to hang it on.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2IntakeFlow from '../../../components/projects/firma2-intake-flow.astro';
import Firma2PlanLimit from '../../../components/shared/firma2-plan-limit.astro';
---
<!-- manifest:
  layout: stack(xl) (inside firma2-intake-flow)
  sections:
    - project limit             -> firma2-plan-limit (wraps the flow; never on a preview)
    - page header + first screen -> firma2-intake-flow
-->
<AppLayout title="New project — ProjectFirma 2.0" active="projects" width="reading">
  <Firma2PlanLimit metric="projects" unlessParam="preview">
    <Firma2IntakeFlow mode="new" />
  </Firma2PlanLimit>
</AppLayout>
