---
// Classifications index — every goal the initiative tracks, and how its KPIs
// stand against it. The bird's-eye view: a classification is a goal (or
// another grouping, like a species), its performance measures are the KPIs,
// and this page reads all of them at once.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Is the work on track toward each of our goals?"
// 2. READERS: the executive and program manager reading progress; a funder
//    or partner sent the link. WHO IS NOT HERE: the administrator defining
//    goals and KPIs — that is Workspace settings and the measure catalog.
// 3. SERIES/SCALAR: a homogeneous set of goals, each a small set of KPIs —
//    cards in a grid, one meter per KPI.
// 4. IRREVERSIBLE: nothing; the page reads.
// 5. CUT: portfolio totals across goals (a project carries several goals, so
//    any total across them counts it more than once), cost and stage mix per
//    goal (on each goal's own page), and work types (becoming tags).
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2GoalBoard from '../../components/classifications/firma2-goal-board.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - goals       -> firma2-goal-board  (groups of firma2-goal-card)
-->
<AppLayout title="Classifications — ProjectFirma 2.0" active="classifications">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Classifications" aliasableTitle />
    <Firma2GoalBoard />
  </div>
</AppLayout>
