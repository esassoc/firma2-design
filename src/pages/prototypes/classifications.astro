---
// Classifications index — every goal the initiative tracks, and how its KPIs
// stand against it. The bird's-eye view: a classification is a goal (or
// another grouping, like a species), its performance measures are the KPIs,
// and this page reads all of them at once.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Is the work on track toward each of our goals?"
// 2. READERS: the executive and program manager reading progress; a funder
//    or partner sent the link. WHO IS NOT HERE: the administrator defining
//    goals and KPIs — that is Workspace settings and the measure catalog.
// 3. SERIES/SCALAR: a tree of groups and classifications, each classification
//    a small set of performance measures. TWO VIEWS, toggled (user,
//    2026-11-23): Outline, the whole tree as one table, and Browse, one group
//    at a time with every measure in full. The card board this page had is
//    now only on a group's own page.
// 4. IRREVERSIBLE: nothing; the page reads.
// 4b. PEEK (user, 2026-10-21): each classification's side-panel button opens
//    it beside the page (firma2-classification-peek) — the
//    project index's interaction, the same spine.
// 5. CUT: portfolio totals across goals (a project carries several goals, so
//    any total across them counts it more than once), cost and stage mix per
//    goal (on each goal's own page), and work types (now Project types).
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2ClassificationIndex from '../../components/classifications/firma2-classification-index.astro';
import Firma2ProjectPeekLayout from '../../components/projects/firma2-project-peek-layout.astro';
---
<!-- manifest:
  layout: firma2-project-peek-layout(peek=classification) > stack(2xl)
  sections:
    - classification peek -> firma2-project-peek-layout (docked rail, hidden until a
                                                   row's side-panel button opens it)
    - page header -> firma2-page-header
    - tree        -> firma2-classification-index  (Outline | Browse, toggled)
-->
<AppLayout title="Classifications — ProjectFirma 2.0" active="classifications" width="full">
  <Firma2ProjectPeekLayout peek="classification" panelWidth="34rem">
    <div class="stack" data-gap="2xl">
      <Firma2PageHeader title="Classifications" aliasableTitle />
      <Firma2ClassificationIndex />
    </div>
  </Firma2ProjectPeekLayout>
</AppLayout>
