---
// Performance measure setup — one page per measure.
//
// WHAT THIS PAGE IS FOR. A performance measure is a question asked of every
// project, forever: "tell me X about this project" (product brief §0, and
// docs/measure-model.md for the evidence). Setting one up is deciding what the
// program will be able to SAY later, and what it will make reporters DO to get
// it — the asset and the tax, priced together.
//
// ONE COLUMN, IN AUTHORING ORDER. The previous shape copied the project page's
// floor plan — facts rail beside card sections — and walking a first-time
// setup through it was the indictment: seven required settings scattered
// across four regions, the admin's path a Z, prose fields filed in an index
// card that visually says "reference", not "work remaining". The project
// rail is right for a record that arrives filled; a new measure is the
// opposite — everything is empty and all of it is the task. So consistency
// with the sibling page now means shared IDIOMS (editable title, click-to-edit
// rows, card chrome, one rhythm), not a shared floor plan. The column reads in
// the order the admin decides:
//   1. THE NAME — the h1, editable in place (the project page's own
//      choreography; the name is nowhere else on the page).
//   2. THE CLAIM (firma2-measure-claim) — the sentence the measure will let
//      the program say, undecided parts as blanks that ARE the readiness
//      checklist. A lede, not a card: the record stated as prose.
//   3. ABOUT (firma2-measure-about) — what the measure means: kind (a fact),
//      classifications, and the two authored paragraphs (definition, reporter
//      guidance). You cannot decide what is counted before deciding these.
//   4. THE STRUCTURE (firma2-measure-form-editor) — what data the measure
//      collects, stated directly as definition rows: the amounts and
//      subcategories reporters enter, then what the report gains
//      automatically. (It was a mockup of the reporter's form for one
//      release — see that component's header for why the proxy died.)
//   5. THE PAYOFF (firma2-measure-split-chart) — one breakdown drawn as a
//      split, so the vocabulary declarations stop being abstract.
//
// LIFECYCLE IS IN THE HEADER (firma2-measure-lifecycle): status pill plus the
// transitions honest for it — Publish gated by the readiness line beside it,
// Retire (never delete) for an active measure because filed entries must keep
// reporting, Delete only for a draft nothing was ever asked against.
//
// WHAT SURVIVES BEING WRONG still sorts the fields' weight: prose and names
// are fill-in-the-blank; the COUNTING RULE silently changes what every
// historical total means; a reported DIMENSION cannot be backfilled — entries
// filed before it existed never asked the question. The irreversible decisions
// live in the form editor's rows, where the claim's blanks point.
//
// THE SHAPE, AND WHY IT HAS CHANGED EIGHT TIMES. A wizard; four form cards; a
// live preview beside a config rail; a definition band over dimension lists;
// the claim over the editable form with an open-form rail; the same spine
// inside the project page's rail-and-cards anatomy; one column in authoring
// order; and now the same column with the form-simulacrum replaced by direct
// definition rows. The faults each change fixed, in order: wizards assume one
// sitting; empty inputs made the definition the hero; the rail starved the
// deliberative task of room; re-filing fields never fixed what being-a-form
// got wrong; a preview beside an editable copy of itself is the same artifact
// twice; a page right in a vacuum but alien beside its sibling taxes every
// visit; a borrowed floor plan scattered the seven required settings across
// four regions; and the mocked-up reporter form asked the admin to operate a
// picture of someone else's UI — the definition should be stated, not
// simulated. Anatomy follows the page's job: filling a record in.
//
// Every panel degrades rather than blocks on an incomplete draft, which is the
// state this page is in most often.
//
// ROUTE. getStaticPaths builds one page per measure from `measures`, keyed by
// the slug already on the record — the same slug measureHref() builds links
// from, so the catalog can never point at a page this route did not generate.
//
// ZERO PAGE CSS. Every section owns its own markup and CSS; the column is the
// stack primitive at the xl rhythm the cards keep between themselves.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2MeasureLifecycle from '../../../components/setup/firma2-measure-lifecycle.astro';
import Firma2MeasureClaim from '../../../components/measures/firma2-measure-claim.astro';
import Firma2MeasureAbout from '../../../components/measures/firma2-measure-about.astro';
import Firma2MeasureFormEditor from '../../../components/setup/firma2-measure-form-editor.astro';
import Firma2MeasureSplitChart from '../../../components/measures/firma2-measure-split-chart.astro';
import {
  measures,
  measureDisplayName,
  outstandingFields,
  outstandingLine,
} from '../../../data/firma2-performance-measures';
import type { PerformanceMeasureDefinition } from '../../../data/firma2-performance-measures';
import { withBase } from '../../../lib/base';

export function getStaticPaths() {
  return measures.map((measure) => ({
    params: { measure: measure.slug },
    props: { measure },
  }));
}

interface Props {
  measure: PerformanceMeasureDefinition;
}

const { measure } = Astro.props;

// A measure reaches this page before it has a name, so the title, the crumb and
// the document title all route through one fallback rather than each deciding
// separately what to do about an empty string. The editable title carries the
// STORED name as its editValue — the editor must open empty on an unnamed
// draft, or the fallback becomes the name the first time anyone commits.
const displayName = measureDisplayName(measure);
---
<!-- manifest:
  layout: stack(xl) — one column, authoring order
  sections:
    - page header           -> firma2-page-header    (sticky band; editableTitle
                                is the record's NAME; readiness line)
      - lifecycle              -> firma2-measure-lifecycle (status pill ·
                                  Publish / Retire / Reactivate / Delete draft)
    - the claim             -> firma2-measure-claim       (the lede sentence;
                                readiness blanks in place)
    - about                 -> firma2-measure-about       (kind · classifications
                                · definition · reporter guidance,
                                edit-on-click rows in a card)
    - the structure         -> firma2-measure-form-editor (two cards: what
                                reporters enter, then what the report gains
                                automatically — definition rows, no form mockup)
    - breakdown preview     -> firma2-measure-split-chart (the PAYOFF)
    - autosave failure      -> esa-snackbar-container     (silent on success)
  note: shares the project page's IDIOMS — editable title, click-to-edit rows,
        card chrome, xl rhythm — but not its rail: a setup page's fields are
        the work, not an index, so they live in the column in the order the
        admin decides them. The claim is the one page-level line: the record
        stated as prose, blanks marking what is undecided.
-->
<AppLayout title={`${displayName} — ProjectFirma 2.0`} active="performance-measures">
  <!-- data-firma2-measure-root marks the RECORD'S BOUNDARY. Every control that
       edits this measure is inside it and nothing in the app shell is, which is
       what the controller delegates its listeners to — see the note in
       src/lib/measure-editor.ts. It is on the wrapper rather than on any one
       section precisely so a control can move between sections without the
       panels going quiet. -->
  <!-- `xl` — the rhythm the cards keep between themselves, so the page reads
       as one interval; the header band is a direct child because
       position:sticky is bounded by its parent. -->
  <div class="stack" data-gap="xl" data-firma2-measure-root={measure.slug}>
    <!-- Two crumbs, not three: the sidenav already owns the way home, and the one
         thing a reader needs from here is the way back to the catalog. Crumb and
         title ride in the sticky band, so that way back stays on screen for the
         whole page rather than only its first screenful. -->
    <!-- THE TITLE IS A FIELD — the record's name, corrected where it is read,
         exactly as the project page's is. The name renders nowhere else: the
         old rail field duplicated it a column from a read-only h1, which was
         the page ignoring its own product's editing model. -->
    <Firma2PageHeader
      title={displayName}
      editableTitle={{ field: 'name', label: 'Measure name', editValue: measure.name }}
      crumbs={[
        { label: 'Performance measures', href: withBase('/prototypes/performance-measures') },
        { label: displayName },
      ]}
    >
      <!-- READINESS, BESIDE THE GATE IT EXPLAINS. This line is why the pill
           says Draft and why Publish is disabled — count and status are one
           fact at two levels of detail, and the lifecycle cluster beside it
           holds the button the count gates. Non-focusable text,
           server-rendered from the seed and kept live by measure-editor.ts
           through the same outstandingLine() — one copy of the sentence. -->
      <!-- Hidden at build for a complete published measure — the line is
           DRAFT vocabulary, and measure-editor.ts re-decides the same
           condition on every change (a blanked field on a live measure
           brings the count back). -->
      <span
        id="fmc-readiness"
        slot="actions"
        class="typography-label-md"
        hidden={measure.status !== 'Draft' && outstandingFields(measure).length === 0}
        >{outstandingLine(outstandingFields(measure).length)}</span
      >

      <Firma2MeasureLifecycle slot="actions" measure={measure} />

      <!-- NO SAVE, NO CANCEL — the draft persists without being asked
           (autosave on the same signals that keep the panels live; see
           measure-editor.ts). Publish is not Save: it is a lifecycle
           transition, the one explicit act this page keeps. -->
    </Firma2PageHeader>

    <!-- CLAIM → MEANING → ARTIFACT → PAYOFF. The column is the page's
         argument AND the admin's worklist, read top to bottom: the sentence
         the measure will let the program say (with a blank for every
         undecided part), what the measure means, the form a reporter will
         meet, and the chart the declarations buy. -->
    <Firma2MeasureClaim measure={measure} />
    <Firma2MeasureAbout measure={measure} />
    <Firma2MeasureFormEditor measure={measure} />
    <Firma2MeasureSplitChart measure={measure} />

    <!-- Autosave failure only — see the note in src/lib/measure-editor.ts. No
         `duration`: the lego documents auto-dismiss as an SC 2.2.1 (Timing
         Adjustable) failure unless the host supplies its own adjustment, and
         persistent-until-dismissed is the conforming default. -->
    <esa-snackbar-container></esa-snackbar-container>
  </div>
</AppLayout>

<script>
  // WIRING, not a section. The about rows, the title, the form editor and the
  // lifecycle cluster own the controls; the claim and chart render
  // consequences; none of them can own the record they share, so the page
  // holds the controller that reads the controls, layers local drafts, and
  // announces the working record. This block exists only because the page is
  // the one place that knows the seed record and that every section is present.
  import '@esa/ecology/esa-snackbar-container';
  import { initMeasureEditor } from '../../../lib/measure-editor';
  import { measures } from '../../../data/firma2-performance-measures';

  // The slug is read from the DOM rather than interpolated into the script,
  // because a define:vars script cannot use import statements. It rides on the
  // RECORD ROOT — the element that defines the controller's boundary — rather
  // than on any one panel, after a deleted panel once took the old carrier
  // attribute down with it and silently unwired the whole controller. The
  // root cannot be deleted without deleting the page.
  const slug = document
    .querySelector('[data-firma2-measure-root]')
    ?.getAttribute('data-firma2-measure-root');
  const seed = measures.find((m) => m.slug === slug);
  if (seed) initMeasureEditor({ seed });
</script>
