---
// Organization Reports — the reports one organization owes its funders and
// its board, and how much of each the records can already fill.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which reports do we produce, and are the projects behind
//    each one reported for its year?"
// 2. READERS: the program officer who assembles the report; the executive
//    asking whether it is ready. Hardest: the funder the report is FOR, who
//    never sees this page — which is why coverage leads: a report built on
//    missing values is a claim to them that turns out to be wrong (§0).
// 3. SERIES/SCALAR: one short list. Each report's scope is its description;
//    "reported" is computed from the measure series, never typed.
// 4. IRREVERSIBLE: nothing.
// 5. CUT: the report itself (what a report renders is the open question in
//    §7 — this page lists them and prices their readiness), a "last run"
//    date (nothing is run; every report reads live records), and a new-report
//    button until a report exists to make.
//
// Zero page CSS.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2SettingsTable from '../../../../components/settings/firma2-settings-table.astro';
import type { Organization } from '../../../../data/firma2-directory';
import { organizationNavKey, organizationPageHref, organizationReports, readerOrganizations } from '../../../../data/firma2-organization-pages';
import { withBase } from '../../../../lib/base';

export function getStaticPaths() {
  return readerOrganizations().map((organization) => ({ params: { organization: organization.slug }, props: { organization } }));
}

interface Props {
  organization: Organization;
}

const { organization } = Astro.props;
const rows = organizationReports(organization).map((report) => ({
  name: report.name,
  description: report.scope,
  cells: {
    year: report.year,
    reported: report.coverage.due ? `${report.coverage.reported} of ${report.coverage.due} project${report.coverage.due === 1 ? '' : 's'}` : 'None due',
    format: report.format,
    owner: report.owner,
  },
}));
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header -> firma2-page-header
    - reports     -> firma2-settings-table (one row per report: its scope, year, and how many projects reported)
-->
<AppLayout title={`Reports — ${organization.name} — ProjectFirma 2.0`} active={organizationNavKey(organization.slug, 'reports')}>
  <div class="stack" data-gap="xl">
    <Firma2PageHeader
      title="Reports"
      crumbs={[
        { label: organization.name, href: withBase(organizationPageHref(organization.slug)) },
        { label: 'Reports' },
      ]}
    />
    <Firma2SettingsTable
      label="Reports"
      nameLabel="Report"
      columns={[
        { key: 'year', label: 'Year', numeric: true },
        { key: 'reported', label: 'Reported' },
        { key: 'format', label: 'Format' },
        { key: 'owner', label: 'Owner' },
      ]}
      rows={rows}
    />
  </div>
</AppLayout>
