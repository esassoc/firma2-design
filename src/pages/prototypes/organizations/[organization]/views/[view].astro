---
// One saved view — the organization's projects that match it, in the
// portfolio grid. The page each row on Views opens.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which of our projects match this view today?"
// 2. READERS: whoever saved it, and the colleagues it is shared with.
// 3. SERIES/SCALAR: the view's filter is one scalar, under the title; the
//    projects are the series — the same grid as the Projects page, handed the
//    matches.
// 4. IRREVERSIBLE: nothing.
// 5. CUT: editing the view's filter (no grid save exists yet), and the
//    view's owner (the Views list carries it).
//
// Zero page CSS.
import AppLayout from '../../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../../components/shared/firma2-page-header.astro';
import Firma2ProjectPeekLayout from '../../../../../components/projects/firma2-project-peek-layout.astro';
import Firma2ProjectGrid from '../../../../../components/projects/firma2-project-grid.astro';
import EsaPill from '@esa/ecology/esa-pill.astro';
import type { Organization } from '../../../../../data/firma2-directory';
import type { SavedView } from '../../../../../data/firma2-organization-pages';
import {
  organizationNavKey,
  organizationPageHref,
  readerOrganizations,
  savedViews,
  viewProjects,
} from '../../../../../data/firma2-organization-pages';
import { withBase } from '../../../../../lib/base';

export function getStaticPaths() {
  return readerOrganizations().flatMap((organization) =>
    savedViews(organization).map((view) => ({ params: { organization: organization.slug, view: view.slug }, props: { organization, view } })),
  );
}

interface Props {
  organization: Organization;
  view: SavedView;
}

const { organization, view } = Astro.props;
---
<!-- manifest:
  layout: firma2-project-peek-layout > stack(2xl)
  sections:
    - project peek -> firma2-project-peek-layout (docked rail, opened from a grid row)
    - page header  -> firma2-page-header         (the view's filter as its status)
    - project grid -> firma2-project-grid        (the projects the view matches)
-->
<AppLayout title={`${view.name} — Views — ${organization.name} — ProjectFirma 2.0`} active={organizationNavKey(organization.slug, 'views')} width="full">
  <Firma2ProjectPeekLayout>
    <div class="stack" data-gap="2xl">
      <Firma2PageHeader
        title={view.name}
        crumbs={[
          { label: organization.name, href: withBase(organizationPageHref(organization.slug)) },
          { label: 'Views', href: withBase(organizationPageHref(organization.slug, 'views')) },
          { label: view.name },
        ]}
      >
        <span slot="status" class="visually-hidden">Filter</span>
        <EsaPill slot="status" label={view.filter} size="md" removable={false} />
      </Firma2PageHeader>
      <Firma2ProjectGrid projects={viewProjects(organization, view)} />
    </div>
  </Firma2ProjectPeekLayout>
</AppLayout>
