---
// Organization Review — one organization's sweep: every project it leads or
// funds, whether its public page is up to date, and the ones waiting to
// publish, oldest first.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which of our projects' public pages are behind, and have
//    we got to all of them?"
// 2. READERS: the organization's stewards, running the review on whatever
//    schedule they keep. Hardest: the steward who sweeps once a year and
//    needs to know where to start — oldest wait first. WHO IS NOT HERE: the
//    editors; between publishes they are trusted, and the project page is
//    theirs.
// 3. SERIES/SCALAR: three scalars (up to date, longest wait, schedule), then
//    two lists — waiting, and up to date.
// 4. IRREVERSIBLE: nothing here. Each project publishes from its own review
//    page, with the diff in front of the steward.
// 5. CUT: bulk publish, and setting the schedule here — it lives with the
//    organization's other settings (Organization settings › Review schedule).
//
// Zero page CSS.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2PlanLock from '../../../../components/shared/firma2-plan-lock.astro';
import Firma2ReviewQueue from '../../../../components/review/firma2-review-queue.astro';
import type { Organization } from '../../../../data/firma2-directory';
import { organizationNavKey, organizationPageHref, readerOrganizations } from '../../../../data/firma2-organization-pages';
import { withBase } from '../../../../lib/base';
import { organizationQueue } from '../../../../data/firma2-publishing';

export function getStaticPaths() {
  return readerOrganizations().map((organization) => ({ params: { organization: organization.slug }, props: { organization } }));
}

interface Props {
  organization: Organization;
}

const { organization } = Astro.props;
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header -> firma2-page-header
    - plan lock   -> firma2-plan-lock (wraps the sections below; read-only below Program)
    - queue       -> firma2-review-queue (organization scope: summary, waiting, up to date)
-->
<AppLayout title={`Review — ${organization.name} — ProjectFirma 2.0`} active={organizationNavKey(organization.slug, 'review')}>
  <div class="stack" data-gap="xl">
    <Firma2PageHeader
      title="Review"
      crumbs={[
        { label: organization.name, href: withBase(organizationPageHref(organization.slug)) },
        { label: 'Review' },
      ]}
    />
    <Firma2PlanLock gap="xl" needs="program" message="Upgrade to Program to review changes before they're published.">
      <Firma2ReviewQueue queue={organizationQueue(organization.name)} organization={organization.name} />
    </Firma2PlanLock>
  </div>
</AppLayout>
