---
// Organization Home — one organization's front page: how much work it is in,
// which of last year's reports did not come back, and what changed lately.
// The first of the five pages under each of the reader's organizations in the
// app rail (src/data/firma2-organization-pages.ts).
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Is our organization's work reported, and what has
//    happened on it lately?"
// 2. READERS: program staff at a funder or a lead organization, checking in;
//    the executive asking whether the organization's portfolio is in hand.
//    Hardest: the executive, who will not open a project to find out. WHO IS
//    NOT HERE: the reporter who owes the missing value — this page names the
//    gap; the project page is where it is filled.
// 3. SERIES/SCALAR: the totals are scalars, stated once at the top; the
//    missing reports and the latest updates are short lists; the map is the
//    one picture of where the projects are, coloured led or funded.
// 4. IRREVERSIBLE: nothing. The page reads; every figure is derived from the
//    project records.
// 5. CUT: the portfolio map's controls (color-by, tags, coverage — the Map
//    page has them; firma2-project-set-map is the canvas alone), a performance-measure
//    roll-up (the
//    classification pages answer it per goal), and a member list (Organization
//    settings › Members has it).
//
// CONNECTIONS IN THE RAIL (user, 2026-10-09): the projects the organization
// leads or funds, as a local graph. It shares the track with the project
// peek — the peek takes its place while open.
//
// TWO VIEWS, AS TABS (user, 2026-10-09): Overview is the page as it was;
// Map is the workspace Map page's map (firma2-portfolio-map) scoped to the
// projects the organization leads or funds, with led or funded as one more
// colour-by choice (user, 2026-10-20: "Map" must read the same everywhere —
// it was the My projects explorer, which looked like a different product).
// The export follows it, as on the Map page.
//
// Zero page CSS.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2ProjectPeekLayout from '../../../../components/projects/firma2-project-peek-layout.astro';
import Firma2OrgSummary from '../../../../components/organizations/firma2-org-summary.astro';
import Firma2OrgReportGaps from '../../../../components/organizations/firma2-org-report-gaps.astro';
import Firma2ProjectSetMap from '../../../../components/shared/firma2-project-set-map.astro';
import Firma2RecordRail from '../../../../components/shared/firma2-record-rail.astro';
import Firma2EntityConnections from '../../../../components/shared/firma2-entity-connections.astro';
import { organizationGraph } from '../../../../lib/entity-graph';
import Firma2PageTabs from '../../../../components/shared/firma2-page-tabs.astro';
import Firma2PortfolioMap from '../../../../components/map/firma2-portfolio-map.astro';
import Firma2PortfolioExport from '../../../../components/map/firma2-portfolio-export.astro';
import { projectSlug } from '../../../../data/firma2-projects';
import Firma2OrgUpdates from '../../../../components/organizations/firma2-org-updates.astro';
import type { Organization } from '../../../../data/firma2-directory';
import {
  LAST_CLOSED_YEAR,
  coverage,
  organizationNavKey,
  organizationPageHref,
  organizationProjects,
  organizationUpdates,
  readerOrganizations,
} from '../../../../data/firma2-organization-pages';

export function getStaticPaths() {
  return readerOrganizations().map((organization) => ({ params: { organization: organization.slug }, props: { organization } }));
}

interface Props {
  organization: Organization;
}

const { organization } = Astro.props;
const rows = organizationProjects(organization.name);
const lastYear = coverage(rows.map((r) => r.project), LAST_CLOSED_YEAR);
const ledOrFunded = Object.fromEntries(rows.map((r) => [projectSlug(r.project), r.leads ? 'Led' : 'Funded']));
---
<!-- manifest:
  layout: firma2-project-peek-layout > stack(xl)
  sections:
    - project peek   -> firma2-project-peek-layout (docked rail, opened from a missing-report row)
    - rail           -> firma2-record-rail         (slot="rail"; gives way to the peek)
      - connections  -> firma2-entity-connections  (led and funded projects, local graph)
    - page header    -> firma2-page-header        (export action: firma2-portfolio-export)
    - views          -> firma2-page-tabs          (Overview | Map, ?view=map)
      overview:
        - summary        -> firma2-org-summary        (projects, money, last year's reports)
        - missing report -> firma2-org-report-gaps    (who owes what for the last closed year)
        - map            -> firma2-project-set-map    (the organization's work areas, led vs funded)
        - latest updates -> firma2-org-updates        (newest five, linked to Updates)
      map:
        - map            -> firma2-portfolio-map      (the Map page's map, scoped; led or funded as a colour-by)
-->
<AppLayout title={`${organization.name} — ProjectFirma 2.0`} active={organizationNavKey(organization.slug, 'home')} width="full">
  <Firma2ProjectPeekLayout>
    <Firma2RecordRail slot="rail" label="connections" sizeVar="--firma2-record-rail-width">
      <Firma2EntityConnections graph={organizationGraph(organization.name)} />
    </Firma2RecordRail>
    <div class="stack" data-gap="xl">
      <Firma2PageHeader title={organization.name}>
        <Firma2PortfolioExport slot="actions" />
      </Firma2PageHeader>
      <Firma2PageTabs views={[{ key: 'overview', label: 'Overview' }, { key: 'map', label: 'Map' }]}>
        <div slot="overview" class="stack" data-gap="xl">
          <Firma2OrgSummary rows={rows} coverage={lastYear} />
          <Firma2OrgReportGaps coverage={lastYear} />
          <Firma2ProjectSetMap
            title="Where the work is"
            label="Map of this organization's projects"
            items={rows.map((r) => ({ project: r.project, group: r.leads ? 'led' : 'funded' }))}
            groups={[{ key: 'led', label: 'Led' }, { key: 'funded', label: 'Funded' }]}
          />
          <Firma2OrgUpdates updates={organizationUpdates(organization.name)} limit={5} allHref={organizationPageHref(organization.slug, 'updates')} />
        </div>
        <div slot="map">
          <Firma2PortfolioMap
            projects={rows.map((r) => r.project)}
            split={{ label: 'Led or funded', order: ['Led', 'Funded'], valueOf: ledOrFunded }}
            label="Map of this organization's projects"
          />
        </div>
      </Firma2PageTabs>
    </div>
  </Firma2ProjectPeekLayout>
</AppLayout>
