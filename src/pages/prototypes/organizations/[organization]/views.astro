---
// Organization Views — the saved slices of one organization's projects that
// its people come back to: "missing a report", "proposals to review".
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which saved lists of our projects are there, and how many
//    projects is each holding right now?"
// 2. READERS: program staff returning to a working list. WHO IS NOT HERE: the
//    colleague whose private views are theirs alone — only shared views and
//    the reader's own are listed.
// 3. SERIES/SCALAR: one short list. Each view's filter is its description,
//    stated in words, and its count is computed from the records, never stored.
// 4. IRREVERSIBLE: nothing.
// 5. CUT: creating a view here (a view is made by filtering a list, not by
//    filling in a form — the grid has no save yet, a seam for later), and
//    favourites.
//
// Zero page CSS.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2SettingsTable from '../../../../components/settings/firma2-settings-table.astro';
import type { Organization } from '../../../../data/firma2-directory';
import {
  organizationNavKey,
  organizationPageHref,
  organizationViewHref,
  readerOrganizations,
  savedViews,
  viewProjects,
} from '../../../../data/firma2-organization-pages';
import { withBase } from '../../../../lib/base';

export function getStaticPaths() {
  return readerOrganizations().map((organization) => ({ params: { organization: organization.slug }, props: { organization } }));
}

interface Props {
  organization: Organization;
}

const { organization } = Astro.props;
const rows = savedViews(organization).map((view) => ({
  name: view.name,
  href: withBase(organizationViewHref(organization.slug, view.slug)),
  description: view.filter,
  cells: {
    projects: viewProjects(organization, view).length,
    shared: view.sharedWith,
    createdBy: view.createdBy,
  },
}));
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header -> firma2-page-header
    - views       -> firma2-settings-table (one row per saved view, its filter in words)
-->
<AppLayout title={`Views — ${organization.name} — ProjectFirma 2.0`} active={organizationNavKey(organization.slug, 'views')}>
  <div class="stack" data-gap="xl">
    <Firma2PageHeader
      title="Views"
      crumbs={[
        { label: organization.name, href: withBase(organizationPageHref(organization.slug)) },
        { label: 'Views' },
      ]}
    />
    <Firma2SettingsTable
      label="Views"
      nameLabel="View"
      columns={[
        { key: 'projects', label: 'Projects', numeric: true },
        { key: 'shared', label: 'Shared with' },
        { key: 'createdBy', label: 'Created by' },
      ]}
      rows={rows}
    />
  </div>
</AppLayout>
