---
// Organization Updates — everything that changed on one organization's
// projects, newest first, grouped by month.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "What has happened on our projects, and when?"
// 2. READERS: program staff catching up after time away; a funder's officer
//    checking that values are coming in. Hardest: the one looking for a single
//    kind of change among many — hence the filter by kind.
// 3. SERIES/SCALAR: one series, the feed. No scalars.
// 4. IRREVERSIBLE: nothing. The feed is read from each project's change log
//    and comments; it edits nothing.
// 5. CUT: a project filter (the project page's own log answers "what changed
//    on this one"), avatars (a name is enough to recognise a colleague), and
//    replying in place (comments live on the record they are about).
//
// Zero page CSS.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2OrgUpdates from '../../../../components/organizations/firma2-org-updates.astro';
import type { Organization } from '../../../../data/firma2-directory';
import { organizationNavKey, organizationPageHref, organizationUpdates, readerOrganizations } from '../../../../data/firma2-organization-pages';
import { withBase } from '../../../../lib/base';

export function getStaticPaths() {
  return readerOrganizations().map((organization) => ({ params: { organization: organization.slug }, props: { organization } }));
}

interface Props {
  organization: Organization;
}

const { organization } = Astro.props;
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header -> firma2-page-header
    - feed        -> firma2-org-updates (every update, by month, filterable by kind)
-->
<AppLayout title={`Updates — ${organization.name} — ProjectFirma 2.0`} active={organizationNavKey(organization.slug, 'updates')} width="reading">
  <div class="stack" data-gap="xl">
    <Firma2PageHeader
      title="Updates"
      crumbs={[
        { label: organization.name, href: withBase(organizationPageHref(organization.slug)) },
        { label: 'Updates' },
      ]}
    />
    <Firma2OrgUpdates updates={organizationUpdates(organization.name)} />
  </div>
</AppLayout>
