---
// Organization Projects — every project one organization leads or funds, in
// the portfolio grid.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which projects are ours, and where does each stand?"
// 2. READERS: program staff finding a project to open; the executive scanning
//    stages. WHO IS NOT HERE: everyone else's projects — the workspace's
//    Projects index has them.
// 3. SERIES/SCALAR: one homogeneous list — the grid, handed the organization's
//    projects. Search, filters, CSV and the peek behave exactly as on the index.
// 4. IRREVERSIBLE: nothing.
// 5. CUT: Recently viewed (it is the reader's history, not the
//    organization's, and the index already carries it) and a leads/funds
//    column (the grid is shared; a role filter is a seam for later).
//
// Zero page CSS.
import AppLayout from '../../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../../components/shared/firma2-page-header.astro';
import Firma2ProjectPeekLayout from '../../../../components/projects/firma2-project-peek-layout.astro';
import Firma2ProjectGrid from '../../../../components/projects/firma2-project-grid.astro';
import type { Organization } from '../../../../data/firma2-directory';
import { organizationNavKey, organizationPageHref, organizationProjects, readerOrganizations } from '../../../../data/firma2-organization-pages';
import { withBase } from '../../../../lib/base';

export function getStaticPaths() {
  return readerOrganizations().map((organization) => ({ params: { organization: organization.slug }, props: { organization } }));
}

interface Props {
  organization: Organization;
}

const { organization } = Astro.props;
const projects = organizationProjects(organization.name).map((r) => r.project);
---
<!-- manifest:
  layout: firma2-project-peek-layout > stack(2xl)
  sections:
    - project peek -> firma2-project-peek-layout (docked rail, opened from a grid row)
    - page header  -> firma2-page-header
    - project grid -> firma2-project-grid        (the organization's projects)
-->
<AppLayout title={`Projects — ${organization.name} — ProjectFirma 2.0`} active={organizationNavKey(organization.slug, 'projects')} width="full">
  <Firma2ProjectPeekLayout>
    <div class="stack" data-gap="2xl">
      <Firma2PageHeader
        title="Projects"
        aliasableTitle
        crumbs={[
          { label: organization.name, href: withBase(organizationPageHref(organization.slug)) },
          { label: 'Projects', aliasable: true },
        ]}
      />
      <Firma2ProjectGrid projects={projects} />
    </div>
  </Firma2ProjectPeekLayout>
</AppLayout>
