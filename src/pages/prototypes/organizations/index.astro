---
// Organizations — every organization taking part in the workspace, and a door
// to each one's page. The READING list, in the app rail's More group; the list
// an administrator adds to and removes from is Workspace settings ›
// Organizations. Two pages for one entity, as classifications and performance
// measures have.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Who takes part here, and how much does each one do?"
// 2. READERS: program staff and executives looking an organization up; a
//    partner or newcomer working out who is in the program. Hardest: the
//    newcomer, who knows a name and not the type or the role it plays. WHO IS
//    NOT HERE: the administrator adding or removing an organization — that is
//    Workspace settings.
// 3. SERIES/SCALAR: a homogeneous list of records — one sortable, searchable
//    table, one row each (indexes are tables).
// 4. IRREVERSIBLE: nothing; the page reads.
// 5. CUT: Add organization (only administrators add one, in settings), the
//    administrator's columns (visibility, added by, created), the led / funded
//    split (on each organization's page), and organizations added in this
//    browser, which have no page yet.
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2OrganizationGrid from '../../../components/settings/firma2-organization-grid.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header -> firma2-page-header
    - list        -> firma2-organization-grid  (mode="directory": one row per organization the reader may see)
-->
<AppLayout title="Organizations — ProjectFirma 2.0" active="organizations">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="Organizations" aliasableTitle />
    <Firma2OrganizationGrid mode="directory" />
  </div>
</AppLayout>
