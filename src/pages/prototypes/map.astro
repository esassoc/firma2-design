---
// Map — the project editor's landing page: your projects on a map that fills
// the sheet edge to edge. Renamed from My Projects on 2026-11-02, when its
// map-based view became the whole page and the old portfolio map was archived
// (src/pages/prototypes/archive/portfolio-map.astro). Ported from
// ProjectFirma2 hackathon team 5 (project updates), story 0007.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which of my projects do I need to update, and where are they?"
// 2. READERS: whoever edits projects — a landowner with one (Wade), a program
//    lead entering thirty on sponsors' behalf (Theo). WHO IS NOT HERE: a
//    read-only reader, who browses the Projects index instead.
// 3. SERIES/SCALAR: a short series of records, each a handful of scalars and a
//    picture of its place — cards over the map, not a table.
// 4. IRREVERSIBLE: nothing; it is a way in.
// 5. CUT: the cards-only variant (the map is the page now), the proposals
//    list (drafts stay on Review and each organization's page), and the old
//    portfolio map's export and coverage charts (archived with it).
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2MyProjectsMap from '../../components/projects/firma2-my-projects-map.astro';
import Firma2ProjectPeekLayout from '../../components/projects/firma2-project-peek-layout.astro';
---
<!-- manifest:
  layout: firma2-project-peek-layout(max=false) > firma2-my-projects-map
  sections:
    - map, edge to edge -> firma2-my-projects-map
    - page header       -> firma2-page-header, in the map's floating head (slot="title"), h1 visually hidden
  note: width="full" so the map can reach every edge of the sheet.
-->
<AppLayout title="Map — ProjectFirma 2.0" active="map" width="full">
  <Firma2ProjectPeekLayout max={false} panelWidth="35rem">
    <Firma2MyProjectsMap>
      <Firma2PageHeader slot="title" title="Map" hideTitle />
    </Firma2MyProjectsMap>
  </Firma2ProjectPeekLayout>
</AppLayout>
