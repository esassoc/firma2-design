---
// Map — the portfolio on one map. Ported from ProjectFirma2 hackathon team 2
// (geospatial), story I (export) and the coverage panel.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Where is the work, and where is there none?"
// 2. READERS: the program manager sending her board one picture (Dana), the
//    biologist answering "what did we fund in this reach" (Theo), and the GIS
//    analyst who wants the shapes out (Marcus). WHO IS NOT HERE: the public —
//    this is the signed-in map; the public one is a feed, not a page.
// 3. SERIES/SCALAR: a map of series, a few scalars beside it, two charts of
//    the same numbers under it.
// 4. IRREVERSIBLE: nothing; it reads.
// 5. CUT: a separate filter-by control (the legend is the filter), budget by
//    stage (not a spatial question), and server-built shapefiles (stubbed).
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2PortfolioExport from '../../components/map/firma2-portfolio-export.astro';
import Firma2PortfolioMap from '../../components/map/firma2-portfolio-map.astro';
import Firma2ProjectPeekLayout from '../../components/projects/firma2-project-peek-layout.astro';
---
<!-- manifest:
  layout: firma2-project-peek-layout > stack(2xl)
  sections:
    - page header -> firma2-page-header (export action: firma2-portfolio-export)
    - map         -> firma2-portfolio-map (popups open a project in the side panel)
-->
<AppLayout title="Map — ProjectFirma 2.0" active="map" width="full">
  <!-- A narrower panel: the map and its filters need the room more than the
       Projects index's table does. -->
  <Firma2ProjectPeekLayout panelWidth="35rem">
    <div class="stack" data-gap="2xl">
      <Firma2PageHeader title="Map">
        <Firma2PortfolioExport slot="actions" />
      </Firma2PageHeader>
      <Firma2PortfolioMap />
    </div>
  </Firma2ProjectPeekLayout>
</AppLayout>
