---
// GIS subscriptions — project footprints kept current from the workspace's own
// GIS. Ported from ProjectFirma2 hackathon team 2 (geospatial), stories A, K
// and decision 22.
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Is our layer and this tracker saying the same thing?"
// 2. READERS: the GIS analyst (Marcus), who is often not a workspace
//    administrator. WHO IS NOT HERE: everyone whose project this changes —
//    each sync rewrites mapped fields on their records.
// 3. SERIES/SCALAR: one or two subscriptions, each a card of scalars and its
//    last run.
// 4. IRREVERSIBLE: nothing — a sync never deletes, and retiring keeps the shapes.
// 5. CUT: a "bring every field" switch, a credentialed non-Esri service, and
//    Survey123 field data (team 2's own list of what Marcus still cannot do).
import AppLayout from '../../layouts/AppLayout.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2GisSubscriptions from '../../components/gis/firma2-gis-subscriptions.astro';
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header   -> firma2-page-header
    - subscriptions -> firma2-gis-subscriptions
-->
<AppLayout title="GIS subscriptions — ProjectFirma 2.0" active="gis-subscriptions" width="reading">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader title="GIS subscriptions">
      <span slot="actions" data-add-subscription><EsaButton variant="primary" icon="plus">Add subscription</EsaButton></span>
    </Firma2PageHeader>
    <Firma2GisSubscriptions />
  </div>
</AppLayout>
