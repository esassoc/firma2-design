---
// Join an organization — the first sign-in's question, asked again from inside
// the app (account menu, Settings › Security, the pending-request notice).
//
// The brief's five (docs/product-brief.md §5):
//
// 1. ONE QUESTION: "Which organization do you work for?" — again, or another one.
// 2. READERS: anyone signed in. Mostly a newcomer who skipped, or one waiting on a request who came back to check it. Hardest: the consultant with requests out to two organizations.
// 3. SERIES/SCALAR: one choice and its door (join, or request); their own requests below.
// 4. IRREVERSIBLE: nothing — a request can be withdrawn.
// 5. CUT: Skip for now (they are already in the app; the nav is the way out).
//
// WHY A SECOND PAGE AND NOT THE WELCOME ONE (user, 2026-11-02: "why is there
// a unique page for this and there's no menu side bar?"). First sign-in keeps
// its bare frame — one question before anything else. Every later visit is a
// page of the app: the nav stays, so asking never feels like leaving.
// Same components, `context="app"`: they act for whoever is signed in.
//
// Spec: .scratch/access-requests/spec.md (decision 17, story 8).
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2WelcomeOrganization from '../../components/welcome/firma2-welcome-organization.astro';
import Firma2MyRequests from '../../components/welcome/firma2-my-requests.astro';
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - page header   -> firma2-page-header
    - question      -> firma2-welcome-organization (context="app")
    - your requests -> firma2-my-requests (context="app")
-->
<AppLayout title="Join an organization — ProjectFirma 2.0" width="reading">
  <div class="stack" data-gap="xl">
    <Firma2PageHeader title="Join an organization" />
    <Firma2WelcomeOrganization context="app" />
    <Firma2MyRequests context="app" />
  </div>
</AppLayout>
