---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Section from '@esa/docs/Section.astro';
import { withBase } from '../../lib/base';

// Scaffold "what's coming" cards. Replace with this spoke's planned patterns.
const planned = [
  { title: 'Application shell', body: 'Topbar and collapsible sidenav — the frame every prototype screen renders inside.' },
  { title: 'Data tables', body: 'List and detail grids with status pills and a slide-in detail drawer.' },
  { title: 'Form flows', body: 'Multi-step entry and edit flows, from first field to confirmation.' },
];
---
<DocsLayout title="Pattern Library — ProjectFirma 2.0" activeHref="/patterns">
  <nav class="crumbs"><a href={withBase('/')}>ProjectFirma 2.0</a> <span>/</span> <span>Pattern Library</span></nav>
  <h1>Pattern Library</h1>
  <p class="lede">
    Coming soon — multi-component patterns like app shells, tables, and flows, between single
    components and full screens. Working screens live as
    <a href={withBase('/')}>prototypes</a>.
  </p>

  <Section id="planned" title="What's coming">
    <div class="grid">
      {planned.map((p) => (
        <div class="card">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </Section>
</DocsLayout>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--spacing-400, 1rem); }
  .card { padding: var(--spacing-400, 1rem); border: 1px solid var(--color-border-default, #dcdcdc); border-radius: 10px; background: var(--color-background-elevation-raised, #fff); }
  .card h3 { margin: 0 0 var(--spacing-200, 0.5rem); font-size: 15px; color: var(--color-content-default, #3d3d3d); }
  .card p { margin: 0; font-size: 14px; line-height: 1.5; color: var(--color-content-default-secondary, #525252); }
</style>
