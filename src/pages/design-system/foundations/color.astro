---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import ColorFoundation from '@esa/docs/ColorFoundation.astro';

// The semantic roles + their live values come from @esa/docs and read from the
// active theme at runtime. The only spoke-specific part is this spoke's own
// primitive ramps, passed via `ramps` below.
//
// Both ramps are GENERATED, not picked — scripts/lib/theme-recipe.mjs derives
// them from the recipe in src/styles/theme-firma2.json. Edit the recipe and
// regenerate; never hand-edit theme-firma2.css.
//
// The brand ramp resolves to `var(--color-grass-*)` in light, because the seed
// (#46a758) IS Radix grass step 9 and the generator emits the primitive rather
// than restating its hex. In DARK it emits literals — grass-dark is one of the
// three scales whose shipped primitives drift from Radix, so it correctly fails
// the all-twelve-or-nothing match. Same token names either way.
//
// --firma2-neutral-0 is the one literal in light: it is step 1 darkened by an
// OKLCH factor, a rung that exists in no Radix scale.
const step = (scale: string, n: number) => ({ step: String(n), token: `firma2-${scale}-${n}` });

const ramps = [
  { name: 'Brand (Radix grass, seeded at step 9)', steps: Array.from({ length: 12 }, (_, i) => step('brand', i + 1)) },
  { name: 'Neutral (Radix olive)', steps: Array.from({ length: 13 }, (_, i) => step('neutral', i)) },
];
---
<DocsLayout title="Color — ProjectFirma 2.0" activeHref="/design-system/foundations/color">
  <ColorFoundation brand="ProjectFirma 2.0" ramps={ramps} />
</DocsLayout>
