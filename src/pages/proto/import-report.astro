---
// PROTOTYPE, TO BE DELETED. Four versions of Import a report's check step,
// behind a picker, at /proto/import-report. Nothing in the product links here
// or imports from src/components/proto/.
//
// The question being explored: what should a person LOOK AT to confirm that a
// report was read correctly, so that checking is faster than typing?
//
//   1 Side by side         every change in a list, the document in a pane (as built)
//   2 Exceptions first     only what needs a decision; the rest is one line
//   3 Annotated document   the report itself, changes in its margin
//   4 On the record        the project's sections, new values where they will land
//
// All four show the same invented funder report against the same project, with
// its worst cases: a figure with no unit, a funder the workspace does not hold,
// a line counted twice, and a count where hours are asked for.
//
// Zero page CSS.
import AppLayout from '../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2ReportImportActions from '../../components/projects/firma2-report-import-actions.astro';
import ProtoPicker from '../../components/proto/import-report/proto-picker.astro';
import ProtoActions from '../../components/proto/import-report/proto-actions.astro';
import ProtoSide from '../../components/proto/import-report/proto-side.astro';
import ProtoExceptions from '../../components/proto/import-report/proto-exceptions.astro';
import ProtoAnnotated from '../../components/proto/import-report/proto-annotated.astro';
import ProtoRecord from '../../components/proto/import-report/proto-record.astro';
import { buildProtoData } from '../../components/proto/import-report/model';
import { IMPORT_FIXTURES, SAMPLE_REPORT_NAME } from '../../data/firma2-report-import';
import { demoProjectSlug, projects, projectHref, projectSlug } from '../../data/firma2-projects';
import { getProjectDetail } from '../../data/firma2-project-detail';
import { organizations } from '../../data/firma2-directory';
import { withBase } from '../../lib/base';

const SLUG = demoProjectSlug('deer-creek-riparian-corridor-enhancement');
const project = projects.find((p) => projectSlug(p) === SLUG)!;
const data = buildProtoData(
  getProjectDetail(project),
  IMPORT_FIXTURES[SLUG].report!,
  SAMPLE_REPORT_NAME,
  organizations.map((organization) => organization.name),
);
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - page header + acts -> firma2-page-header (actions: firma2-report-import-actions for variant 1, proto-actions for the rest)
    - variant 1          -> proto-side (firma2-project-report-import, unchanged)
    - variant 2          -> proto-exceptions
    - variant 3          -> proto-annotated
    - variant 4          -> proto-record
    - picker             -> proto-picker
-->
<AppLayout title="Import a report, four versions — ProjectFirma 2.0" active="projects">
  <div class="stack" data-gap="2xl">
    <Firma2PageHeader
      title="Import a report"
      crumbs={[
        { label: 'Projects', href: withBase('/prototypes/projects'), aliasable: true },
        { label: project.projectName, href: withBase(projectHref(project)) },
        { label: 'Import a report' },
      ]}
    >
      <span slot="actions" data-proto-for="1"><Firma2ReportImportActions cancelHref={withBase(projectHref(project))} /></span>
      <span slot="actions" data-proto-for="2 3 4" hidden><ProtoActions /></span>
    </Firma2PageHeader>
    <script type="application/json" id="proto-import-data" set:html={JSON.stringify(data)} />
    <div data-proto-variant="side"><ProtoSide project={project} /></div>
    <div data-proto-variant="exceptions" hidden><ProtoExceptions data={data} /></div>
    <div data-proto-variant="annotated" hidden><ProtoAnnotated data={data} /></div>
    <div data-proto-variant="record" hidden><ProtoRecord data={data} /></div>
  </div>
  <ProtoPicker variants={['Side by side', 'Exceptions first', 'Annotated document', 'On the record']} />
</AppLayout>
