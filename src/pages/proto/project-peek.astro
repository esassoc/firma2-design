---
// PROTOTYPE HARNESS — /proto/project-peek. Throwaway: nothing in production
// imports this route or src/proto/project-peek/. Deleted once a direction is
// picked (emil-prototype Phase 7).
//
// The real Projects index with four peek panels docked in one track — the
// current firma2-project-peek and three arrangements of the Overview body
// (description, facts, filed under, map, progress) — of which the
// picker shows exactly one. All four open on the same row click, so flipping
// the picker compares them on the same project.
//
// bcn-lego-checked: prototype harness — the picker is emil-prototype's fixed chrome (PICKER.md, verbatim, deliberately not tokenized); the page itself composes the real projects-index sections
import AppLayout from '../../layouts/AppLayout.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import Firma2ProjectsActions from '../../components/projects/firma2-projects-actions.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2RecentProjects from '../../components/projects/firma2-recent-projects.astro';
import Firma2ProjectGrid from '../../components/projects/firma2-project-grid.astro';
import Firma2ProjectPeek from '../../components/projects/firma2-project-peek.astro';
import Firma2ProjectPeekButton from '../../components/projects/firma2-project-peek-button.astro';
import ProtoPeekShell from '../../proto/project-peek/proto-peek-shell.astro';
import { CONTENT_MAX } from '../../lib/content-width';

const VARIANTS = ['Current', 'Read down', 'Side by side', 'Map beside', 'Map beside + cards'];
---
<!-- manifest:
  layout: sidebar(end) > stack(2xl)
  sections:
    - peek: current   -> firma2-project-peek
    - peek: read-down    -> proto-peek-shell (body-overview layout=read-down)
    - peek: side-by-side -> proto-peek-shell (body-overview layout=side-by-side)
    - peek: map-beside   -> proto-peek-shell (body-overview layout=map-beside)
    - peek: map-beside-cards -> proto-peek-shell (body-overview-cards)
    - page header     -> firma2-page-header
    - recently viewed -> firma2-recent-projects
    - project grid    -> firma2-project-grid
    - picker          -> emil-prototype picker chrome (PICKER.md)
-->
<AppLayout title="Peek prototype — ProjectFirma 2.0" active="projects" width="full">
  <div class="sidebar firma2-project-peek-layout proto-peek-layout" data-side="end" style="--sidebar-width: 46rem; --sidebar-content-min: 20rem">
    <Firma2ProjectPeek />
    <ProtoPeekShell variant="read-down" n={2} width="40rem" />
    <ProtoPeekShell variant="side-by-side" n={3} width="46rem" />
    <ProtoPeekShell variant="map-beside" n={4} width="40rem" />
    <ProtoPeekShell variant="map-beside-cards" n={5} width="40rem" />
    <div>
      <EsaContainer maxWidth={CONTENT_MAX}>
        <div class="stack" data-gap="2xl">
          <Firma2PageHeader title="Projects" aliasableTitle>
            <Firma2ProjectsActions slot="actions" />
          </Firma2PageHeader>
          <Firma2RecentProjects />
          <Firma2ProjectGrid />
        </div>
      </EsaContainer>
    </div>
  </div>
  <template data-project-peek-button>
    <Firma2ProjectPeekButton slug="" name="" />
  </template>

  <nav class="proto-picker" aria-label="Prototype variants">
    <span class="proto-picker-highlight" aria-hidden="true"></span>
    {VARIANTS.map((v, i) => (
      <button class="proto-picker-item" type="button" data-active={i === 0 ? '' : undefined} aria-current={i === 0 ? 'true' : undefined}>{v}</button>
    ))}
  </nav>
</AppLayout>

<script>
  import { loadLeaflet } from '../../lib/leaflet';

  // REAL REFERENCE LAYERS, prototype-only. The workspace's configured layers
  // (Workspace settings › Map layers) are hand-drawn Tahoe-basin stand-ins
  // pointing at example.org; these are the public USGS services, drawn live:
  // HUC-12 subwatershed boundaries (Watershed Boundary Dataset) and NHD
  // streams + waterbodies. Neither service is tiled; see ONE IMAGE PER VIEW below.
  // They sit in a pane under the work
  // areas (overlay pane 400) and under the place labels (450): context, not
  // content. Hooked onto Leaflet itself so the production project map stays
  // untouched; only maps inside a prototype peek body get them.
  const USGS = 'https://hydro.nationalmap.gov/arcgis/rest/services';
  // RESTYLED AT THE SOURCE (`dynamicLayers`): the services' defaults are heavy
  // purple boundaries stamped with "HUC 12-160501020502" codes, which shouted
  // over the work areas and mean nothing to a reader. Boundaries become a thin
  // neutral line with no labels; streams and waterbodies a quiet water blue.
  const line = (rgba: number[], width: number) => ({ type: 'esriSLS', style: 'esriSLSSolid', color: rgba, width });
  const simple = (symbol: object) => ({ renderer: { type: 'simple', symbol }, showLabels: false });
  const WBD_HUC12 = [{
    id: 6, source: { type: 'mapLayer', mapLayerId: 6 },
    drawingInfo: simple({ type: 'esriSFS', style: 'esriSFSNull', outline: line([96, 104, 112, 170], 0.75) }),
  }];
  // NHD splits each feature class by scale: small-scale (4, 10) draws from
  // 1:578k to 1:73k, large-scale (6, 12) closer than that — the peek's maps
  // sit around zoom 10–11, so both pairs go in and the service picks.
  const waterbody = simple({ type: 'esriSFS', style: 'esriSFSSolid', color: [140, 180, 220, 110], outline: line([120, 165, 210, 160], 0.5) });
  const flowline = simple(line([80, 140, 205, 190], 0.9));
  const NHD_WATER = [10, 12].map((id) => ({ id, source: { type: 'mapLayer', mapLayerId: id }, drawingInfo: waterbody }))
    .concat([4, 6].map((id) => ({ id, source: { type: 'mapLayer', mapLayerId: id }, drawingInfo: flowline })));
  // ONE IMAGE PER VIEW, NOT TILES. A dynamic MapServer renders on request:
  // tiled, a map fired ~20 exports per layer, the browser queued them six at
  // a time, and tiles landed 6–17s late (one as an error page). Instead each
  // layer is a single image of the whole visible map, re-requested after a
  // pan, zoom or resize settles, preloaded off-screen and swapped in so the
  // old view stays up until the new one is ready. Two requests per map.
  loadLeaflet().then((L) => {
    const dynamicLayer = (map: any, url: string, dynamicLayers: object[], attribution: string) => {
      // Created on the first refresh: the init hook runs before setView, when
      // the map has no bounds to give.
      let overlay: any = null;
      let timer = 0;
      let latest = 0;
      const refresh = () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          const size = map.getSize();
          if (!size.x || !size.y) return;
          const bounds = map.getBounds();
          const sw = L.CRS.EPSG3857.project(bounds.getSouthWest());
          const ne = L.CRS.EPSG3857.project(bounds.getNorthEast());
          const ratio = Math.min(window.devicePixelRatio || 1, 2);
          const q = new URLSearchParams({
            bbox: `${sw.x},${sw.y},${ne.x},${ne.y}`, bboxSR: '3857', imageSR: '3857',
            size: `${Math.round(size.x * ratio)},${Math.round(size.y * ratio)}`, dpi: String(Math.round(96 * ratio)),
            format: 'png32', transparent: 'true', dynamicLayers: JSON.stringify(dynamicLayers), f: 'image',
          });
          const ticket = ++latest;
          const img = new Image();
          img.onload = () => {
            if (ticket !== latest) return;
            if (!overlay) overlay = L.imageOverlay(img.src, bounds, { pane: 'proto-reference', attribution, interactive: false }).addTo(map);
            else { overlay.setUrl(img.src); overlay.setBounds(bounds); }
          };
          img.src = `${url}/export?${q}`;
        }, 150);
      };
      map.on('moveend resize', refresh);
      map.whenReady(refresh);
    };
    L.Map.addInitHook(function (this: any) {
      const container: HTMLElement = this.getContainer();
      if (!container.closest('.proto-overview__map, .proto-cards__map')) return;
      const pane = this.createPane('proto-reference');
      pane.style.zIndex = '350';
      pane.style.pointerEvents = 'none';
      dynamicLayer(this, `${USGS}/nhd/MapServer`, NHD_WATER, 'USGS NHD');
      dynamicLayer(this, `${USGS}/wbd/MapServer`, WBD_HUC12, 'USGS WBD');
    });
  });

  // The peek layout's trapped-script rescue, verbatim (firma2-project-peek-layout).
  document.querySelectorAll('template').forEach((template) => {
    template.content.querySelectorAll('script[type="module"]').forEach((trapped) => {
      const script = document.createElement('script');
      for (const { name, value } of trapped.attributes) script.setAttribute(name, value);
      script.textContent = trapped.textContent;
      trapped.remove();
      document.body.append(script);
    });
  });

  const panels = [
    document.getElementById('firma2-project-peek')!,
    ...['read-down', 'side-by-side', 'map-beside', 'map-beside-cards'].map((v) => document.getElementById(`proto-peek-${v}`)!),
  ];
  panels.forEach((p) => p.classList.add('proto-peek-panel'));

  // Keep the four in step: closing the visible one closes the rest, so a
  // flip never reveals a panel still open on an earlier project.
  let syncing = false;
  panels.forEach((panel) =>
    panel.addEventListener('firma2:rail-closed', (e) => {
      if (e.target !== panel || syncing) return;
      syncing = true;
      panels.forEach((other) => other !== panel && !other.hidden && other.dispatchEvent(new CustomEvent('firma2:rail-close')));
      syncing = false;
    }),
  );

  // The map frames its shapes clear of a 96px head plate and a 132px legend —
  // sized for production's 21rem band. The prototype bands are shorter, so
  // re-frame them with margins that fit: the bare locator has no plates at
  // all; the 16rem bands keep the head plate and drop the legend.
  document.addEventListener('firma2:map-init', () => {
    setTimeout(() => {
      document.querySelectorAll<HTMLElement>('.proto-overview__map .firma2-project-map, .proto-cards__map .firma2-project-map').forEach((root) => {
        const bare = !!root.closest('.proto-overview__map--bare, .proto-cards__map');
        root.dispatchEvent(new CustomEvent('firma2-map:reflow', {
          detail: bare
            ? { paddingTopLeft: [12, 12], paddingBottomRight: [12, 12] }
            : { paddingTopLeft: [24, 80], paddingBottomRight: [24, 24] },
        }));
      });
    }, 50);
  });

  // THE ROW BEING PEEKED. The grid sets no row ids, but every row carries its
  // peek trigger, so the open slug finds its row; AG Grid splits a row across
  // the pinned and centre containers, so the tint goes on every .ag-row with
  // that row-index. Re-applied when the grid re-renders (sort, filter, scroll
  // recycling) and cleared when the panel closes.
  let peeked: string | null = null;
  const tint = document.createElement('style');
  document.head.append(tint);
  const paintPeeked = () => {
    const row = peeked
      ? document.querySelector(`.ag-row [data-open-project="${CSS.escape(peeked)}"]`)?.closest('.ag-row')
      : null;
    const index = row?.getAttribute('row-index');
    tint.textContent = index == null ? '' : `
      .ag-row[row-index="${index}"],
      .ag-row[row-index="${index}"].ag-row-hover { background-color: var(--color-background-brand-muted, #e6f7ed); }
      .ag-row[row-index="${index}"]::before { background-color: transparent !important; }`;
  };
  document.addEventListener('click', (e) => {
    const trigger = (e.target as Element).closest<HTMLElement>('[data-open-project]');
    if (trigger) { peeked = trigger.dataset.openProject ?? null; requestAnimationFrame(paintPeeked); }
  }, true);
  panels.forEach((panel) => panel.addEventListener('firma2:rail-closed', (e) => {
    if (e.target === panel) { peeked = null; paintPeeked(); }
  }));
  const gridBody = document.querySelector('.ag-body');
  if (gridBody) new MutationObserver(() => peeked && paintPeeked()).observe(gridBody, { childList: true, subtree: true });

  const picker = document.querySelector<HTMLElement>('.proto-picker')!;
  const highlight = picker.querySelector<HTMLElement>('.proto-picker-highlight')!;
  const items = [...picker.querySelectorAll<HTMLButtonElement>('.proto-picker-item')];
  let current = 0;

  function moveHighlight() {
    const el = items[current];
    highlight.style.width = `${el.offsetWidth}px`;
    highlight.style.transform = `translateX(${el.offsetLeft}px)`;
  }

  function mount(i: number) {
    panels.forEach((p, j) => p.classList.toggle('proto-peek-off', j !== i));
    // The newly shown record was laid out at display:none — re-announce it so
    // fields hydrate and the map measures its real box.
    const record = panels[i].querySelector('[data-peek-record-host]')?.firstElementChild;
    if (record) requestAnimationFrame(() => {
      record.dispatchEvent(new CustomEvent('firma2:field-hydrate', { bubbles: true }));
      record.dispatchEvent(new CustomEvent('firma2:map-init', { bubbles: true }));
    });
  }

  function setActive(i: number) {
    if (i < 0 || i >= items.length) return;
    current = i;
    items.forEach((el, j) => {
      el.toggleAttribute('data-active', j === i);
      if (j === i) el.setAttribute('aria-current', 'true');
      else el.removeAttribute('aria-current');
    });
    moveHighlight();
    const url = new URL(location.href);
    url.searchParams.set('v', String(i + 1));
    history.replaceState(null, '', url);
    mount(i);
  }

  items.forEach((el, i) => el.addEventListener('click', () => setActive(i)));
  window.addEventListener('resize', moveHighlight);
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable) return;
    if (t.closest('[role="grid"], [role="treegrid"], esa-dropdown-menu')) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const num = parseInt(e.key, 10);
    if (num >= 1 && num <= items.length) setActive(num - 1);
    else if (e.key === 'ArrowRight') setActive((current + 1) % items.length);
    else if (e.key === 'ArrowLeft') setActive((current - 1 + items.length) % items.length);
  });

  setActive((parseInt(new URLSearchParams(location.search).get('v') ?? '', 10) || 1) - 1);
  requestAnimationFrame(() => requestAnimationFrame(() => picker.setAttribute('data-ready', '')));
</script>

<style is:global>
  .proto-peek-layout > .proto-peek-panel { order: 2; }
  .proto-peek-layout > .proto-peek-panel.proto-peek-off { display: none !important; }

  /* PICKER.md — verbatim. */
  .proto-picker {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2147483647;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.82);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 8px 24px rgba(0, 0, 0, 0.24),
      0 2px 6px rgba(0, 0, 0, 0.12);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 13px;
    line-height: 1;
    -webkit-font-smoothing: antialiased;
    user-select: none;
    -webkit-user-select: none;
  }
  .proto-picker-highlight {
    position: absolute;
    top: 4px;
    left: 0;
    height: 28px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    will-change: transform;
  }
  .proto-picker[data-ready] .proto-picker-highlight {
    transition:
      transform 250ms cubic-bezier(0.23, 1, 0.32, 1),
      width 250ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .proto-picker[data-ready] .proto-picker-highlight { transition: none; }
  }
  .proto-picker-item {
    position: relative;
    display: flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    font: inherit;
    cursor: pointer;
    transition: color 150ms ease-out;
  }
  .proto-picker-item:hover { color: rgba(255, 255, 255, 0.85); }
  .proto-picker-item:active { transform: scale(0.97); }
  .proto-picker-item:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.4);
    outline-offset: 2px;
  }
  .proto-picker-item[data-active] { color: #fff; }
</style>
