---
// PROTOTYPE HARNESS — /proto/project-showcase/<project>. Throwaway: nothing
// in production imports this route or src/proto/project-showcase/. Deleted
// once a direction is picked (emil-prototype Phase 7).
//
// The public project page four ways, behind the picker: the page as built
// (Current), and three photo-led directions with charts — Listing (Airbnb),
// Activity (Monarch / Strava / Fitbit) and Story (editorial chapters). Every
// project has a route, so worst cases (one photo, no photos, eight measures,
// nothing spent) are a URL away.
//
// bcn-lego-checked: prototype harness — the picker is emil-prototype's fixed chrome (PICKER.md, verbatim, deliberately not tokenized)
import PublicLayout from '../../../layouts/PublicLayout.astro';
import Firma2PublicProject from '../../../components/public/firma2-public-project.astro';
import ProtoListing from '../../../proto/project-showcase/proto-listing.astro';
import ProtoActivity from '../../../proto/project-showcase/proto-activity.astro';
import ProtoStory from '../../../proto/project-showcase/proto-story.astro';
import ProtoPicker from '../../../proto/project-showcase/proto-picker.astro';
import { showcase } from '../../../proto/project-showcase/model';
import { projects, projectSlug } from '../../../data/firma2-projects';
import type { Project } from '../../../data/firma2-projects';
import { getProjectDetail } from '../../../data/firma2-project-detail';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { project: projectSlug(project) }, props: { project } }));
}
interface Props {
  project: Project;
}
const { project } = Astro.props;
const detail = getProjectDetail(project);
const s = showcase(project);
---
<!-- manifest:
  layout: PublicLayout > one variant at a time
  sections:
    - current   -> firma2-public-project
    - listing   -> proto-listing
    - activity  -> proto-activity
    - story     -> proto-story
    - picker    -> proto-picker
-->
<PublicLayout title={`Prototype — ${project.projectName}`} current="projects">
  <div data-variant-panel="0"><Firma2PublicProject detail={detail} published={detail.publishing.published} /></div>
  <div data-variant-panel="1" hidden><ProtoListing s={s} /></div>
  <div data-variant-panel="2" hidden><ProtoActivity s={s} /></div>
  <div data-variant-panel="3" hidden><ProtoStory s={s} /></div>
  <ProtoPicker variants={['Current', 'Listing', 'Activity', 'Story']} />
</PublicLayout>
