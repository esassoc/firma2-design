---
// PROTOTYPE HARNESS — /proto/map-style. Throwaway: nothing in production
// imports this route or src/proto/map-style/. Deleted once a direction is
// picked (emil-prototype Phase 7).
//
// Four ways for an administrator to style the workspace's maps, one shown at
// a time. All four write the same stores, so a change made in one is what the
// next opens on.
//
//   1 Current  the settings page as built: sections, then a form in a side sheet
//   2 Studio   every knob in a panel beside a live map   (kepler.gl, Mapbox Studio)
//   3 Legend   the map is the page; style from its legend, presets only (Felt, My Maps)
//
// ROUND TWO (2026-11-12): Legend picked, wanting Studio's always-visible base
// map switch. Themes dropped from the picker (its starting colours live on as
// the per-base starting sets). Two riffs on Legend:
//   4 Legend + base map   the switch pinned to the top of the legend
//   5 Per base map        the same, and every base map keeps its own style
//
// bcn-lego-checked: prototype harness — the picker is emil-prototype's fixed chrome (PICKER.md, verbatim, deliberately not tokenized); the swatch is the production settings swatch restated for runtime-built rows
import AppLayout from '../../layouts/AppLayout.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import Firma2PageHeader from '../../components/shared/firma2-page-header.astro';
import Firma2MapStyle from '../../components/settings/firma2-map-style.astro';
import Firma2MapLayers from '../../components/settings/firma2-map-layers.astro';
import ProtoStudio from '../../proto/map-style/proto-studio.astro';
import ProtoLegend from '../../proto/map-style/proto-legend.astro';
import { CONTENT_READING } from '../../lib/content-width';

const VARIANTS = ['Current', 'Studio', 'Legend', 'Legend + base map', 'Per base map'];
---
<!-- manifest:
  layout: stack(2xl)
  sections:
    - current: page header -> firma2-page-header
    - current: map style   -> firma2-map-style
    - current: layers      -> firma2-map-layers
    - studio               -> proto-studio
    - legend               -> proto-legend
    - legend + base map    -> proto-legend (base=switch)
    - per base map         -> proto-legend (base=per-base)
    - picker               -> emil-prototype picker chrome (PICKER.md)
-->
<AppLayout title="Map style prototype — ProjectFirma 2.0" nav="workspace-settings" active="ws-map-layers" width="full">
  <section class="proto-current" data-proto-variant>
    <EsaContainer maxWidth={CONTENT_READING}>
      <div class="stack" data-gap="2xl">
        <Firma2PageHeader title="Map layers" />
        <Firma2MapStyle />
        <Firma2MapLayers />
      </div>
    </EsaContainer>
  </section>
  <ProtoStudio />
  <ProtoLegend />
  <ProtoLegend base="switch" />
  <ProtoLegend base="per-base" />

  <nav class="proto-picker" aria-label="Prototype variants">
    <span class="proto-picker-highlight" aria-hidden="true"></span>
    {VARIANTS.map((v, i) => (
      <button class="proto-picker-item" type="button" data-active={i === 0 ? '' : undefined} aria-current={i === 0 ? 'true' : undefined}>{v}</button>
    ))}
  </nav>
</AppLayout>

<script>
  const sections = [...document.querySelectorAll<HTMLElement>('[data-proto-variant]')];
  const picker = document.querySelector<HTMLElement>('.proto-picker')!;
  const highlight = picker.querySelector<HTMLElement>('.proto-picker-highlight')!;
  const items = [...picker.querySelectorAll<HTMLButtonElement>('.proto-picker-item')];
  let current = 0;

  function moveHighlight() {
    const el = items[current];
    highlight.style.width = `${el.offsetWidth}px`;
    highlight.style.transform = `translateX(${el.offsetLeft}px)`;
  }

  // Shown one at a time; the hidden ones leave the tab order with `hidden`.
  // A variant's map measures its box on the event, not at load.
  function mount(i: number) {
    sections.forEach((s, j) => (s.hidden = j !== i));
    requestAnimationFrame(() => sections[i].dispatchEvent(new CustomEvent('proto:show')));
  }

  function setActive(i: number) {
    if (i < 0 || i >= items.length) return;
    current = i;
    items.forEach((el, j) => {
      el.toggleAttribute('data-active', j === i);
      if (j === i) el.setAttribute('aria-current', 'true');
      else el.removeAttribute('aria-current');
    });
    moveHighlight();
    const url = new URL(location.href);
    url.searchParams.set('v', String(i + 1));
    history.replaceState(null, '', url);
    mount(i);
  }

  items.forEach((el, i) => el.addEventListener('click', () => setActive(i)));
  window.addEventListener('resize', moveHighlight);
  document.addEventListener('keydown', (e) => {
    // Composed path: focus inside a lego's shadow root reports the host as target.
    const t = (e.composedPath()[0] ?? e.target) as HTMLElement;
    if (/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable) return;
    if (t.closest?.('[role="radiogroup"], [role="radio"], [role="listbox"], [role="slider"], .leaflet-container')) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const num = parseInt(e.key, 10);
    if (num >= 1 && num <= items.length) setActive(num - 1);
    else if (e.key === 'ArrowRight') setActive((current + 1) % items.length);
    else if (e.key === 'ArrowLeft') setActive((current - 1 + items.length) % items.length);
  });

  setActive((parseInt(new URLSearchParams(location.search).get('v') ?? '', 10) || 1) - 1);
  requestAnimationFrame(() => requestAnimationFrame(() => picker.setAttribute('data-ready', '')));
</script>

<style is:global>
  [data-proto-variant][hidden] { display: none !important; }
  .proto-current { padding-block: var(--spacing-800) 6rem; }

  /* The settings swatch, for rows built at runtime. */
  .proto-swatch {
    display: block;
    flex: none;
    inline-size: 2rem;
    block-size: 1.25rem;
    border-radius: var(--radius-sm, 0.25rem);
    background: var(--color-background-elevation-sunken, #f0f0f0);
    pointer-events: none;
  }
  details[open] > summary .proto-swatch,
  .proto-legend__row:hover .proto-swatch { background: var(--color-background-elevation-base, #fff); }
  .proto-swatch svg { display: block; inline-size: 100%; block-size: 100%; }
  .proto-swatch--icon { display: grid; place-items: center; background: none; color: var(--color-content-default-secondary, #646464); }
  .proto-swatch--icon svg { inline-size: 1.25rem; block-size: 1.25rem; }

  /* PICKER.md — verbatim. */
  /* PICKER.md — verbatim. */
  .proto-picker {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2147483647;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.82);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 8px 24px rgba(0, 0, 0, 0.24),
      0 2px 6px rgba(0, 0, 0, 0.12);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 13px;
    line-height: 1;
    -webkit-font-smoothing: antialiased;
    user-select: none;
    -webkit-user-select: none;
  }
  .proto-picker-highlight {
    position: absolute;
    top: 4px;
    left: 0;
    height: 28px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    will-change: transform;
  }
  .proto-picker[data-ready] .proto-picker-highlight {
    transition:
      transform 250ms cubic-bezier(0.23, 1, 0.32, 1),
      width 250ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .proto-picker[data-ready] .proto-picker-highlight { transition: none; }
  }
  .proto-picker-item {
    position: relative;
    display: flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    font: inherit;
    cursor: pointer;
    transition: color 150ms ease-out;
  }
  .proto-picker-item:hover { color: rgba(255, 255, 255, 0.85); }
  .proto-picker-item:active { transform: scale(0.97); }
  .proto-picker-item:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.4);
    outline-offset: 2px;
  }
  .proto-picker-item[data-active] { color: #fff; }
</style>
