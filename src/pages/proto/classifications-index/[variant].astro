---
// PROTOTYPE — one frame of /proto/classifications-index: the real
// Classifications page (app chrome, page header, docked classification peek)
// with one answer to "how is the tree of groups and goals shown". `cards` is
// the production board, unchanged — the baseline the others are read against.
// Throwaway; nothing in production imports it.
//
// FAKED: the three new variants are drawn from the build's data only; they do
// not follow groups or classifications edited in Workspace settings in this
// browser, as the production board does.
//
// bcn-lego-checked: prototype harness — composes the production layout, header and peek unchanged plus one proto-* variant
import AppLayout from '../../../layouts/AppLayout.astro';
import Firma2PageHeader from '../../../components/shared/firma2-page-header.astro';
import Firma2ProjectPeekLayout from '../../../components/projects/firma2-project-peek-layout.astro';
import Firma2GoalBoard from '../../../components/classifications/firma2-goal-board.astro';
import ProtoOutline from '../../../proto/classifications-index/proto-outline.astro';
import ProtoSections from '../../../proto/classifications-index/proto-sections.astro';
import ProtoColumns from '../../../proto/classifications-index/proto-columns.astro';
import ProtoKeyForward from '../../../proto/project-detail/proto-key-forward.astro';

export function getStaticPaths() {
  return ['cards', 'outline', 'sections', 'browse'].map((variant) => ({ params: { variant } }));
}

const variant = Astro.params.variant as 'cards' | 'outline' | 'sections' | 'browse';
---
<!-- manifest:
  layout: firma2-project-peek-layout(peek=classification) > stack(2xl)
  sections:
    - classification peek -> firma2-project-peek-layout
    - page header         -> firma2-page-header
    - variant             -> firma2-goal-board | proto-outline | proto-sections | proto-columns
    - key forwarding      -> proto-key-forward
-->
<AppLayout title="Classifications — prototype" active="classifications" width="full">
  <Firma2ProjectPeekLayout peek="classification" panelWidth="34rem">
    <div class="stack" data-gap="2xl">
      <Firma2PageHeader title="Classifications" aliasableTitle />
      {variant === 'cards' && <Firma2GoalBoard />}
      {variant === 'outline' && <ProtoOutline />}
      {variant === 'sections' && <ProtoSections />}
      {variant === 'browse' && <ProtoColumns />}
    </div>
  </Firma2ProjectPeekLayout>
  <ProtoKeyForward />
</AppLayout>
