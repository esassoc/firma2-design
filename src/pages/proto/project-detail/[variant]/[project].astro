---
// PROTOTYPE — one variant of the project record, as a full page. The harness
// at /proto/project-detail frames all four in iframes behind the picker.
// Throwaway; deleted with src/proto/project-detail/ (emil-prototype Phase 7).
//
// bcn-lego-checked: prototype route — composes the real record sections through src/proto/project-detail bodies; no page CSS
import AppLayout from '../../../../layouts/AppLayout.astro';
import ProtoShell from '../../../../proto/project-detail/proto-shell.astro';
import BodyCurrent from '../../../../proto/project-detail/body-current.astro';
import BodyField from '../../../../proto/project-detail/body-field.astro';
import BodyTabs from '../../../../proto/project-detail/body-tabs.astro';
import BodyBriefing from '../../../../proto/project-detail/body-briefing.astro';
import BodyGrid from '../../../../proto/project-detail/body-grid.astro';
import BodyUnfold from '../../../../proto/project-detail/body-unfold.astro';
import BodyWall from '../../../../proto/project-detail/body-wall.astro';
import BodyInbox from '../../../../proto/project-detail/body-inbox.astro';
import BodyChecklist from '../../../../proto/project-detail/body-checklist.astro';
import BodyPeriod from '../../../../proto/project-detail/body-period.astro';
import ProtoChecklist from '../../../../proto/project-detail/proto-checklist.astro';
import { projects, projectSlug } from '../../../../data/firma2-projects';
import type { Project } from '../../../../data/firma2-projects';
import { getProjectDetail } from '../../../../data/firma2-project-detail';

export function getStaticPaths() {
  return (['current', 'field', 'tabs', 'briefing', 'grid', 'unfold', 'wall', 'inbox', 'checklist', 'period'] as const).flatMap((variant) =>
    projects.map((project) => ({ params: { variant, project: projectSlug(project) }, props: { project } })),
  );
}

interface Props { project: Project }
const { project } = Astro.props;
const { variant } = Astro.params;
const detail = getProjectDetail(project);
const railless = variant === 'grid' || variant === 'unfold';
---
<!-- manifest:
  layout: proto-shell (record bar, rail, header) > variant body
  sections:
    - frame   -> proto-shell
    - body    -> body-current | body-briefing | body-grid | body-unfold | body-wall | body-inbox | body-checklist (+ proto-checklist in the rail) | body-period
-->
<AppLayout title={`${project.projectName} — proto`} active="projects" width="full">
  <ProtoShell detail={detail} rail={!railless} maxWidth={railless ? '80rem' : '60rem'}>
    {variant === 'current' && <BodyCurrent detail={detail} />}
    {variant === 'field' && <BodyField detail={detail} />}
    {variant === 'tabs' && <BodyTabs detail={detail} />}
    {variant === 'briefing' && <BodyBriefing detail={detail} />}
    {variant === 'grid' && <BodyGrid detail={detail} />}
    {variant === 'unfold' && <BodyUnfold detail={detail} />}
    {variant === 'wall' && <BodyWall detail={detail} />}
    {variant === 'inbox' && <BodyInbox detail={detail} />}
    {variant === 'checklist' && <ProtoChecklist slot="rail-top" detail={detail} />}
    {variant === 'checklist' && <BodyChecklist detail={detail} />}
    {variant === 'period' && <BodyPeriod detail={detail} />}
  </ProtoShell>
</AppLayout>
