---
// PROTOTYPE — one frame of /proto/public-session: the real public project
// page with one answer to "where do a signed-in reader's doors live".
// Throwaway; nothing in production imports it.
//
// bcn-lego-checked: prototype harness — composes the production public page unchanged plus proto-session
import PublicLayout from '../../../layouts/PublicLayout.astro';
import Firma2PublicProject from '../../../components/public/firma2-public-project.astro';
import Firma2PublicReviewNotice from '../../../components/public/firma2-public-review-notice.astro';
import ProtoSession from '../../../proto/public-session/proto-session.astro';
import { reviewHref } from '../../../data/firma2-publishing';
import { demoProjectSlug, projectHref, projects, projectSlug } from '../../../data/firma2-projects';
import { getProjectDetail } from '../../../data/firma2-project-detail';

const SLUG = demoProjectSlug('scott-river-fish-passage-barrier-removal');

export function getStaticPaths() {
  return ['current', 'menu', 'bar', 'dock'].map((variant) => ({ params: { variant } }));
}

const variant = Astro.params.variant as 'current' | 'menu' | 'bar' | 'dock';
const project = projects.find((p) => projectSlug(p) === SLUG)!;
const detail = getProjectDetail(project);
const keys = detail.publishing.changes.map((c) => c.key);
---
<!-- manifest:
  layout: PublicLayout
  sections:
    - session surface     -> proto-session (the variant under test)
    - unpublished changes -> firma2-public-review-notice
    - public page         -> firma2-public-project
-->
<PublicLayout title="Signed in on the public site — prototype" current="projects" workspaceDoor={{ label: 'Open project', href: projectHref(project) }}>
  <ProtoSession variant={variant} slug={SLUG} keys={keys} projectHref={projectHref(project)} reviewHref={reviewHref(project)} />
  <Firma2PublicReviewNotice slug={SLUG} keys={keys} reviewHref={reviewHref(project)} published />
  <Firma2PublicProject detail={detail} published={detail.publishing.published} />
</PublicLayout>
