---
// PROTOTYPE — one variant of the PUBLIC project page. The harness at
// /proto/public-project frames them behind the picker. Throwaway; deleted
// with src/proto/project-detail/ (emil-prototype Phase 7).
//
// bcn-lego-checked: prototype route — renders the real public page (current) or proto-public-wall; no page CSS
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Firma2PublicProject from '../../../../components/public/firma2-public-project.astro';
import Firma2PublicUnpublished from '../../../../components/public/firma2-public-unpublished.astro';
import ProtoPublicWall from '../../../../proto/project-detail/proto-public-wall.astro';
import ProtoKeyForward from '../../../../proto/project-detail/proto-key-forward.astro';
import { projects, projectSlug } from '../../../../data/firma2-projects';
import type { Project } from '../../../../data/firma2-projects';
import { getProjectDetail } from '../../../../data/firma2-project-detail';
import { TENANT_NAME } from '../../../../data/firma2-project-types';

export function getStaticPaths() {
  return (['current', 'wall'] as const).flatMap((variant) =>
    projects.map((project) => ({ params: { variant, project: projectSlug(project) }, props: { project } })),
  );
}

interface Props { project: Project }
const { project } = Astro.props;
const { variant } = Astro.params;
const detail = getProjectDetail(project);
const { publishing } = detail;
---
<!-- manifest:
  layout: stack
  sections:
    - public page -> firma2-public-project | proto-public-wall
-->
<BaseLayout title={`${project.projectName} — ${TENANT_NAME}`}>
  {!publishing.publishedIso ? (
    <Firma2PublicUnpublished slug={projectSlug(project)} keys={publishing.changes.map((c) => c.key)}>
      <Firma2PublicProject detail={detail} />
    </Firma2PublicUnpublished>
  ) : variant === 'wall' ? (
    <ProtoPublicWall detail={detail} />
  ) : (
    <Firma2PublicProject detail={detail} published={publishing.published} />
  )}
  <ProtoKeyForward />
</BaseLayout>
