---
// firma2-review-frame — how wide a project's review is: a reading column,
// until a document is open beside the diff.
//
// A DIFF IS READ, A COMPARISON IS SURVEYED. Rows of two short values sit in
// the reading width every settings page uses (CONTENT_READING, 48rem). Once a
// row's source is opened (firma2-review-changes, `data-source-open`) the page
// holds two columns, the diff and its document, and 48rem would give each
// half a phone's width. So the frame lets go of the cap from 64rem, where the
// two columns begin, and takes it back when the document closes.
//
// The page asks AppLayout for its default width and this frame applies the
// narrower one, because AppLayout's width is fixed at build time and this one
// follows what the reader opened.
//
// bcn-lego-checked: esa-container caps a width but centres one fixed maximum
// and has no state to widen on; AppLayout's `width` prop is build-time. Beacon
// is not cloned on this machine. This frame is one max-inline-size and its
// exception, nothing else.
import { CONTENT_READING } from '../../lib/content-width';
---
<div class="firma2-review-frame" style={`--_reading:${CONTENT_READING}`}>
  <slot />
</div>

<style>
  .firma2-review-frame {
    max-inline-size: var(--_reading);
    margin-inline: auto;
  }

  /* The whole selector is global: Astro emits `:has(:global(...))` invalid. */
  @media (min-width: 64rem) {
    :global(.firma2-review-frame:has(.firma2-review-changes[data-source-open])) {
      max-inline-size: none;
    }
  }
</style>
