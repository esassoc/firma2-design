---
// firma2-update-features — the Team 5 sandbox's index: each thing the team
// built, as a link to the screen that shows it, with a line where this spoke
// already has it or has decided otherwise.
//
// THE SECOND LINE IS THE REASON THE LIST EXISTS. The sandbox is here so each
// feature can be kept or dropped, and that call depends on what the spoke
// already does in its place. A feature with no second line is new here.
//
// bcn-lego-checked: a typography-composite link per row on the proposal-list
// row idiom (firma2-proposal-list). No esa- list fits a short list of links
// with a line each — esa-link-column is a footer column, and an AG Grid is for
// indexes that grow. Beacon is not cloned on this machine.
import { SANDBOX_FEATURES } from '../../data/firma2-project-updates';
import { withBase } from '../../lib/base';
---
<ul class="firma2-update-features" role="list">
  {SANDBOX_FEATURES.map((feature) => (
    <li class="firma2-update-features__row">
      <a class="typography-label-md-strong" href={withBase(feature.href)}>{feature.name}</a>
      {feature.spokeNote && <p class="firma2-update-features__note typography-body-sm">{feature.spokeNote}</p>}
    </li>
  ))}
</ul>

<style>
  .firma2-update-features {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .firma2-update-features__row {
    padding-block: var(--spacing-300);
    border-block-end: 1px solid var(--color-border-default);
  }

  .firma2-update-features__note {
    margin: var(--spacing-100) 0 0;
    color: var(--color-text-secondary);
  }
</style>
