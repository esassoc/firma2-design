---
// firma2-update-financials — the Team 5 sandbox's money on the project page:
// what each funding source committed, and what was budgeted and spent from
// each source in each year. Every figure is edited in place, and every edit
// goes into the change log (staged for review when the workspace reviews
// edits).
//
// PORTED FROM Team 5's ProjectFirma2 hackathon branch: story 0009 ("Enter
// project financials", the project-funding and project-expenditures
// components), story 0014 (financial changes are logged), and wrap-up 0017
// (editors get the same per-source grid as administrators). Rebuilt on this
// spoke's legos and the sandbox store (src/lib/update-sandbox.ts): figures
// render in the browser from currentTargets(slug) and repaint on every
// sandbox change, except a cell that is open for editing.
//
// STANDING CONFLICT, STATED PLAINLY: this spoke's data model says a project is
// budgeted ONCE and the budget is not divided into yearly allocations (see
// the `estimatedTotalCost` note in src/data/firma2-projects.ts). Team 5
// stores a Budgeted figure per funding source per year. The sandbox shows
// Team 5's model so the owner can keep or drop it; it is not a pattern to
// reuse elsewhere.
//
// CHANGED FROM TEAM 5, and why:
//   - No Add source, no remove source, no add/remove expenditure rows: the
//     sandbox store has no API for adding or removing targets.
//   - No esa-card: sections here are not cards. The grid is visible, not
//     inside an "Enter expenditures" collapsible.
//   - Saving: Enter validates with validateTarget and keeps the cell open on
//     an error. Leaving a cell with an invalid value reverts it quietly —
//     firma2-editable-field's blur convention, the spoke's rule for inline
//     edits.
//
// bcn-lego-checked: no esa-table lego exists, and these are small fixed
// record tables (one row per funding source, per year), not a growing index,
// so AG Grid's chrome buys nothing and a semantic <table> is the precedent
// (firma2-settings-table, Team 5's own tables). Every editable figure is
// firma2-editable-field (the spoke's inline editor over esa-text-field); the
// status mark is EsaBadge, the headline EsaStat, the chart esa-chart with its
// table alternative in EsaCollapsible, the empty state EsaEmptyState.
// Beacon is not cloned in this checkout.
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaStat from '@esa/ecology/esa-stat.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import EsaCollapsible from '@esa/ecology/esa-collapsible.astro';
import Firma2EditableField from '../shared/firma2-editable-field.astro';
import { formatTargetValue, targetsFor } from '../../data/firma2-project-updates';
import type { UpdateTarget } from '../../data/firma2-project-updates';
import { projects, projectSlug } from '../../data/firma2-projects';
import { getProjectDetail } from '../../data/firma2-project-detail';
import { currencyFormatter as currency } from '../../lib/format';

interface Props {
  /** The project's slug — the store key for its targets and change log. */
  slug: string;
}

const { slug } = Astro.props;

const project = projects.find((p) => projectSlug(p) === slug);
const sources = project ? getProjectDetail(project).funding : [];
const targets = targetsFor(slug);
const commitments = targets.filter((t) => t.column === 'commitment');
const byId = new Map(targets.map((t) => [t.id, t]));
const estimate = Number(byId.get('field:EstimatedTotalCost')?.value ?? project?.estimatedTotalCost ?? 0);

// Newest year first, so the current year is on top.
const years = [...new Set(targets.filter((t) => t.column === 'spent').map((t) => t.year!))].sort((a, b) => b - a);
const yearGroups = years.map((year) => ({
  year,
  rows: sources.map((source, i) => ({
    source,
    budgeted: byId.get(`budgeted:${i}:${year}`),
    spent: byId.get(`spent:${i}:${year}`),
  })),
}));

const spentSeed = targets.filter((t) => t.column === 'spent').reduce((sum, t) => sum + Number(t.value), 0);

/** The editable-field key: unique on the page, and the target id is recoverable from it. */
const fieldKey = (t: UpdateTarget): string => `t5fin:${slug}:${t.id}`;
const display = (t: UpdateTarget): string => formatTargetValue(t, t.value);

const uid = `update-financials-${slug}`;
const hasSources = commitments.length > 0;
---
<div class="firma2-update-financials stack" data-gap="xl" data-slug={slug}>
  <section class="stack" data-gap="sm" aria-labelledby={`${uid}-funding`}>
    <h2 class="typography-title-strong firma2-update-financials__title" id={`${uid}-funding`}>Funding sources</h2>

    {hasSources ? (
      <>
        <div class="firma2-update-financials__scroll">
          <table class="firma2-update-financials__table" aria-labelledby={`${uid}-funding`} aria-describedby={`${uid}-over`}>
            <thead>
              <tr>
                <th scope="col" class="typography-label-md-strong">Source</th>
                <th scope="col" class="typography-label-md-strong">Administered by</th>
                <th scope="col" class="firma2-update-financials__num typography-label-md-strong">Amount</th>
                <th scope="col" class="firma2-update-financials__num typography-label-md-strong">Share of total</th>
              </tr>
            </thead>
            <tbody>
              {commitments.map((t) => (
                <tr>
                  <th scope="row" class="typography-body-md">{sources[t.sourceIndex!]?.name ?? t.label}</th>
                  <td class="typography-body-md">{sources[t.sourceIndex!]?.organization ?? ''}</td>
                  <td class="firma2-update-financials__num firma2-update-financials__money" data-target-cell={t.id}>
                    <Firma2EditableField
                      as="block"
                      labelHidden
                      field={fieldKey(t)}
                      label={`Amount from ${t.label}`}
                      value={display(t)}
                      editValue={t.value}
                      control="number"
                      format="currency"
                    />
                    <span class="firma2-update-financials__pending" data-pending hidden>
                      <EsaBadge variant="warning" size="sm" value="Awaiting review" />
                      <span class="typography-body-sm" data-proposed></span>
                    </span>
                  </td>
                  <td class="firma2-update-financials__num firma2-update-financials__computed typography-body-md" data-share={t.id}></td>
                </tr>
              ))}
              <tr data-remainder hidden>
                <th scope="row" class="typography-body-md">No funding source identified</th>
                <td></td>
                <td class="firma2-update-financials__num firma2-update-financials__computed typography-body-md" data-remainder-amount></td>
                <td class="firma2-update-financials__num firma2-update-financials__computed typography-body-md" data-remainder-share></td>
              </tr>
            </tbody>
            <tfoot>
              <tr>
                <th scope="row" colspan="2" class="typography-label-md-strong">Estimated total cost</th>
                <td class="firma2-update-financials__num firma2-update-financials__computed typography-label-md-strong" data-estimate>{currency.format(estimate)}</td>
                <td class="firma2-update-financials__num firma2-update-financials__computed typography-label-md-strong" data-total-share></td>
              </tr>
            </tfoot>
          </table>
        </div>
        <p class="firma2-update-financials__over typography-body-sm" id={`${uid}-over`} data-over hidden></p>
      </>
    ) : (
      <EsaEmptyState title="No funding sources" size="sm" />
    )}
  </section>

  {hasSources && (
    <section class="stack" data-gap="md" aria-labelledby={`${uid}-expenditures`}>
      <h2 class="typography-title-strong firma2-update-financials__title" id={`${uid}-expenditures`}>Expenditures</h2>

      <div data-stat>
        <EsaStat value={currency.format(spentSeed)} label="Spent to date" sub={`of ${currency.format(estimate)} estimated cost`} />
      </div>

      <div class="firma2-update-financials__scroll">
        <table class="firma2-update-financials__table" aria-label="Expenditures by funding source and year">
          <thead>
            <tr>
              <th scope="col" class="typography-label-md-strong">Funding source</th>
              <th scope="col" class="typography-label-md-strong">Year</th>
              <th scope="col" class="firma2-update-financials__num typography-label-md-strong">Budgeted</th>
              <th scope="col" class="firma2-update-financials__num typography-label-md-strong">Spent</th>
            </tr>
          </thead>
          {yearGroups.map((group) => (
            <tbody class="firma2-update-financials__year">
              {group.rows.map((row) => (
                <tr>
                  <th scope="row" class="typography-body-md">{row.source.name}</th>
                  <td class="firma2-update-financials__year-cell typography-body-md">{group.year}</td>
                  {[row.budgeted, row.spent].map((t) =>
                    t ? (
                      <td class="firma2-update-financials__num firma2-update-financials__money" data-target-cell={t.id}>
                        <Firma2EditableField
                          as="block"
                          labelHidden
                          field={fieldKey(t)}
                          label={`${t.column === 'budgeted' ? 'Budgeted for' : 'Spent from'} ${row.source.name} in ${group.year}`}
                          value={display(t)}
                          editValue={t.value}
                          control="number"
                          format="currency"
                        />
                        <span class="firma2-update-financials__pending" data-pending hidden>
                          <EsaBadge variant="warning" size="sm" value="Awaiting review" />
                          <span class="typography-body-sm" data-proposed></span>
                        </span>
                      </td>
                    ) : (
                      <td></td>
                    ),
                  )}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>

      <esa-chart class="firma2-update-financials__chart" label="Budgeted and spent by year" data-chart></esa-chart>

      <EsaCollapsible title="View as data" flush>
        <div class="firma2-update-financials__scroll">
          <table class="firma2-update-financials__table" aria-label="Budgeted and spent by year">
            <thead>
              <tr>
                <th scope="col" class="typography-label-md-strong">Year</th>
                <th scope="col" class="firma2-update-financials__num typography-label-md-strong">Budgeted</th>
                <th scope="col" class="firma2-update-financials__num typography-label-md-strong">Spent</th>
              </tr>
            </thead>
            <tbody>
              {years.map((year) => (
                <tr data-year-row={year}>
                  <th scope="row" class="typography-body-md">{year}</th>
                  <td class="firma2-update-financials__num firma2-update-financials__computed typography-body-md" data-year-budgeted></td>
                  <td class="firma2-update-financials__num firma2-update-financials__computed typography-body-md" data-year-spent></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </EsaCollapsible>
    </section>
  )}
</div>

<style>
  .firma2-update-financials [hidden] {
    display: none !important;
  }

  .firma2-update-financials__title {
    margin: 0;
  }

  /* position: relative so the visually-hidden field labels inside the cells
     stay inside this box instead of widening the pane. */
  .firma2-update-financials__scroll {
    position: relative;
    overflow-x: auto;
  }

  .firma2-update-financials__table {
    inline-size: 100%;
    border-collapse: collapse;
  }

  .firma2-update-financials__table th,
  .firma2-update-financials__table td {
    padding-block: var(--spacing-100, 0.25rem);
    padding-inline: var(--spacing-200, 0.5rem);
    text-align: start;
    vertical-align: middle;
    border-block-end: var(--border-width-default, 1px) solid var(--color-border-default, #cecece);
  }

  .firma2-update-financials__table thead th {
    padding-block: var(--spacing-200, 0.5rem);
    color: var(--color-content-default-secondary, #646464);
    white-space: nowrap;
  }

  .firma2-update-financials__table tbody th {
    font-weight: inherit;
  }

  .firma2-update-financials__table tfoot th,
  .firma2-update-financials__table tfoot td {
    border-block-end: 0;
    padding-block: var(--spacing-200, 0.5rem);
  }

  /* Money and shares: end-aligned, tabular figures, one line. */
  .firma2-update-financials__table .firma2-update-financials__num {
    text-align: end;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    inline-size: 1%;
  }

  /* Plain figures sit on the same x as the editable ones: the field's text
     is inset by its border + --spacing-300. */
  .firma2-update-financials__table .firma2-update-financials__computed {
    padding-inline-end: calc(var(--spacing-200, 0.5rem) + var(--spacing-300, 0.75rem) + var(--border-width-default, 1px));
  }

  .firma2-update-financials__money {
    min-inline-size: 9rem;
  }

  /* The field's display box is flex; its value goes to the end edge. The
     editor's input is end-aligned by the script, so the figure does not move
     when the cell opens. */
  .firma2-update-financials__money :global(.firma2-editable-field__display) {
    justify-content: flex-end;
  }

  .firma2-update-financials__pending {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--spacing-100, 0.25rem);
    padding-inline-end: calc(var(--spacing-300, 0.75rem) + var(--border-width-default, 1px));
    padding-block-end: var(--spacing-100, 0.25rem);
  }

  .firma2-update-financials__year-cell {
    font-variant-numeric: tabular-nums;
  }

  /* A heavier rule between years, so each year reads as one group. */
  .firma2-update-financials__year:not(:last-child) tr:last-child > * {
    border-block-end-width: calc(var(--border-width-default, 1px) * 2);
  }

  .firma2-update-financials__over {
    margin: 0;
    color: var(--color-content-default, #202020);
  }

  .firma2-update-financials__chart {
    display: block;
  }
</style>

<script>
  import '@esa/ecology/esa-chart';
  import '@esa/ecology/esa-text-field';
  import { editableSlugs, normalizeDraft, validateTarget } from '../../data/firma2-project-updates';
  import type { UpdateTarget } from '../../data/firma2-project-updates';
  import { commitUpdate, currentTargets, onSandboxChange, pendingChanges, readSettings } from '../../lib/update-sandbox';
  import { currencyFormatter as currency } from '../../lib/format';

  type Control = HTMLElement & { value?: unknown; errorText?: string; updateComplete?: Promise<unknown> };
  type ChartElement = HTMLElement & Record<string, unknown>;

  const compactCurrency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', notation: 'compact', maximumFractionDigits: 1 });

  /** Floor every share, then hand the leftover points to the largest fractions, so the column sums to 100. */
  const toOneHundred = (raw: number[]): number[] => {
    const whole = raw.map(Math.floor);
    const leftover = Math.max(0, 100 - whole.reduce((a, b) => a + b, 0));
    const order = raw.map((v, i) => ({ i, f: v - Math.floor(v) })).sort((a, b) => b.f - a.f);
    for (let k = 0; k < Math.min(leftover, order.length); k += 1) whole[order[k].i] += 1;
    return whole;
  };

  document.querySelectorAll<HTMLElement>('.firma2-update-financials').forEach((root) => {
    const slug = root.dataset.slug!;
    const prefix = `t5fin:${slug}:`;

    const rowOf = (el: Element | null): HTMLElement | null => {
      const row = el?.closest<HTMLElement>('[data-editable-field]') ?? null;
      return row && root.contains(row) && row.dataset.field?.startsWith(prefix) ? row : null;
    };
    const targetIdOf = (row: HTMLElement): string => row.dataset.field!.slice(prefix.length);
    const targetOf = (id: string): UpdateTarget | undefined => currentTargets(slug).find((t) => t.id === id);

    const text = (selector: string, value: string): void => {
      const el = root.querySelector<HTMLElement>(selector);
      if (el) el.textContent = value;
    };

    const chart = root.querySelector<ChartElement>('[data-chart]');
    let chartReady = false;

    const render = (): void => {
      const targets = currentTargets(slug);
      const value = (t: UpdateTarget): number => Number(t.value) || 0;
      const estimate = Number(targets.find((t) => t.id === 'field:EstimatedTotalCost')?.value) || 0;
      const editable = editableSlugs(readSettings().role).includes(slug);

      // ---- every editable figure: value, lock, and its pending proposal ----
      const pending = new Map<string, string>();
      // Newest first: the first row per target is the latest proposal.
      pendingChanges(slug).forEach((c) => {
        if (!pending.has(c.targetId)) pending.set(c.targetId, c.toLabel);
      });
      root.querySelectorAll<HTMLElement>('[data-editable-field]').forEach((row) => {
        if (!row.dataset.field?.startsWith(prefix)) return;
        const target = targets.find((t) => t.id === targetIdOf(row));
        if (!target) return;
        row.toggleAttribute('data-locked', !editable);
        // Routed through the field's own paint, which skips a row that is open.
        document.dispatchEvent(new CustomEvent('firma2:field-set', { detail: { field: row.dataset.field, raw: target.value } }));
        const cell = row.closest<HTMLElement>('[data-target-cell]');
        const badge = cell?.querySelector<HTMLElement>('[data-pending]');
        const proposed = pending.get(target.id);
        if (badge) {
          badge.hidden = proposed === undefined;
          const label = badge.querySelector<HTMLElement>('[data-proposed]');
          if (label) label.textContent = proposed ?? '';
        }
      });

      // ---- funding: shares, the unidentified remainder, over-commitment ----
      const commitments = targets.filter((t) => t.column === 'commitment');
      if (commitments.length) {
        const amounts = commitments.map(value);
        const committed = amounts.reduce((a, b) => a + b, 0);
        const residual = estimate - committed;
        const hasResidual = estimate > 0 && Math.round(residual) > 0;
        const over = estimate > 0 && Math.round(committed) > Math.round(estimate);
        let percents: (number | null)[] = amounts.map(() => null);
        let residualPercent: number | null = null;
        if (estimate > 0) {
          const raw = amounts.map((a) => (a / estimate) * 100);
          const withResidual = hasResidual ? [...raw, (residual / estimate) * 100] : raw;
          // Over-committed: nothing to reconcile to, so each share rounds on its own.
          const rounded = over ? withResidual.map(Math.round) : toOneHundred(withResidual);
          percents = hasResidual ? rounded.slice(0, -1) : rounded;
          residualPercent = hasResidual ? rounded[rounded.length - 1] : null;
        }
        const pct = (p: number | null): string => (p === null ? '—' : `${p}%`);
        commitments.forEach((t, i) => text(`[data-share="${CSS.escape(t.id)}"]`, pct(percents[i])));

        const remainder = root.querySelector<HTMLElement>('[data-remainder]');
        if (remainder) remainder.hidden = !hasResidual;
        text('[data-remainder-amount]', hasResidual ? currency.format(residual) : '');
        text('[data-remainder-share]', pct(residualPercent));
        text('[data-estimate]', currency.format(estimate));
        const total = [...percents, residualPercent].reduce<number>((a, b) => a + (b ?? 0), 0);
        text('[data-total-share]', estimate > 0 ? `${total}%` : '—');

        const overLine = root.querySelector<HTMLElement>('[data-over]');
        if (overLine) {
          overLine.hidden = !over;
          overLine.textContent = over ? `Commitments exceed the estimated cost by ${currency.format(committed - estimate)}.` : '';
        }
      }

      // ---- expenditures: the headline, the by-year table, the chart ----
      const spent = targets.filter((t) => t.column === 'spent');
      const budgeted = targets.filter((t) => t.column === 'budgeted');
      text('[data-stat] .esa-stat__value', currency.format(spent.reduce((a, t) => a + value(t), 0)));
      text('[data-stat] .esa-stat__sub', `of ${currency.format(estimate)} estimated cost`);

      const years = [...new Set(spent.map((t) => t.year!))].sort((a, b) => a - b);
      const byYear = years.map((year) => ({
        year: String(year),
        budgeted: budgeted.filter((t) => t.year === year).reduce((a, t) => a + value(t), 0),
        spent: spent.filter((t) => t.year === year).reduce((a, t) => a + value(t), 0),
      }));
      byYear.forEach((y) => {
        text(`[data-year-row="${y.year}"] [data-year-budgeted]`, currency.format(y.budgeted));
        text(`[data-year-row="${y.year}"] [data-year-spent]`, currency.format(y.spent));
      });
      if (chart && chartReady) chart.data = byYear;
    };

    // ---- the chart: properties only after the element is defined ----
    if (chart) {
      void customElements.whenDefined('esa-chart').then(() => {
        const tooltip = (key: 'budgeted' | 'spent') => ({
          renderer: (p: { title?: string; yName?: string; datum: Record<string, number> }) => ({
            title: p.title,
            data: [{ label: p.yName ?? '', value: currency.format(p.datum[key]) }],
          }),
        });
        chart.series = [
          { type: 'bar', xKey: 'year', yKey: 'budgeted', yName: 'Budgeted', cornerRadius: 4, tooltip: tooltip('budgeted') },
          { type: 'bar', xKey: 'year', yKey: 'spent', yName: 'Spent', cornerRadius: 4, tooltip: tooltip('spent') },
        ];
        chart.options = {
          axes: {
            x: { type: 'category', position: 'bottom' },
            y: { type: 'number', position: 'left', label: { formatter: (p: { value: unknown }) => compactCurrency.format(Number(p.value)) } },
          },
        };
        chartReady = true;
        render();
      });
    }

    // ---- end-align the editors' input, so an opening cell moves nothing ----
    // esa-text-field has no `align`; its shadow root is open (see legoGap).
    void customElements.whenDefined('esa-text-field').then(() => {
      root.querySelectorAll<Control>('[data-field-input]').forEach(async (control) => {
        await control.updateComplete;
        const input = control.shadowRoot?.querySelector<HTMLInputElement>('input');
        if (input) input.style.textAlign = 'end';
      });
    });

    // ---- saving ----
    // Enter: validate before the field commits; an error keeps the cell open.
    // Window capture runs ahead of the field's document-capture handler.
    window.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Enter') return;
        const row = rowOf(event.target as Element | null);
        if (!row || !row.hasAttribute('data-editing')) return;
        const target = targetOf(targetIdOf(row));
        const control = row.querySelector<Control>('[data-field-input]');
        if (!target || !control) return;
        const error = validateTarget(target, String(control.value ?? ''));
        if (!error) return;
        control.errorText = error;
        event.preventDefault();
        event.stopImmediatePropagation();
      },
      true,
    );

    // The field announces a changed value; the store decides what it becomes.
    root.addEventListener('firma2:field-save', (event) => {
      const row = rowOf(event.target as Element | null);
      if (!row) return;
      const raw = String((event as CustomEvent<{ raw?: unknown }>).detail?.raw ?? '');
      const target = targetOf(targetIdOf(row));
      // A repaint from the store echoes its own value back: nothing to do.
      if (!target || raw === target.value) return;
      if (validateTarget(target, raw) === null) {
        commitUpdate(slug, [{ targetId: target.id, to: normalizeDraft(target, raw), source: 'Direct' }]);
      }
      // After the field closes: paint the stored value back (an invalid draft
      // left on blur, or a staged edit that does not change the value yet).
      queueMicrotask(render);
    });

    onSandboxChange(render);
    // Once more after every module has run: the field's firma2:field-set
    // listener may register after this script, and the first paint must land.
    setTimeout(render, 0);
  });
</script>
