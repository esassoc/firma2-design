---
// firma2-goal-board — the classifications index body: every goal, grouped by
// classification group, each a card of its KPIs against their goals. The
// bird's-eye view of an initiative — how the work is tracking toward what it
// set out to do.
//
// GROUPS SORT IT. Each group gets its heading and its stored description, and
// its goals in a grid of scan cards from the leading edge. The first grid
// paired cards of unequal KPI counts into ragged rows (user, 2026-10-21); the
// cards are one height now (firma2-goal-card), so the grid is back.
//
// GROUPS COLLAPSE (user, 2026-10-21): each is an esa-collapsible, open on
// first visit; the ones this reader closed stay closed (localStorage, a
// convenience — every group opens when storage is unavailable). The lego's
// summary is a label; here it is restated in the title-strong tokens so the
// group still reads above its cards' titles. A <summary> is a button to
// assistive tech, so the group's name labels its <section> instead of an h2.
//
// SETTINGS EDITS SHOW HERE. Goals added, renamed or removed in Workspace
// settings, KPIs linked or unlinked, and targets changed are applied in the
// browser over the build's figures (src/lib/goal-kpis.ts); a goal added in
// this browser joins its group with no projects, so its KPIs read "Not
// reported" until projects take it on.
//
// GROUPS FOLLOW SETTINGS TOO: a group added there gets a section here (a copy
// of the first, emptied) once a goal sits in it; renamed and re-described
// groups update; groups and the goals within each follow the order arranged
// in settings; a group with no goals left is hidden.
import EsaCollapsible from '@esa/ecology/esa-collapsible.astro';
import Firma2GoalCard from './firma2-goal-card.astro';
import Firma2KpiProgress from './firma2-kpi-progress.astro';
import { CLASSIFICATION_GROUPS, classificationsInGroup } from '../../data/firma2-classifications';
import { kpiFigureTable, rollupClassification } from '../../data/firma2-classification-rollup';
import { measures } from '../../data/firma2-performance-measures';
import { projectHref } from '../../data/firma2-projects';
import { withBase } from '../../lib/base';

// Every seeded group renders, even an empty one — the script hides what has
// no goals, and a group can gain goals in this browser.
const groups = CLASSIFICATION_GROUPS.map((group) => ({
  group,
  rollups: classificationsInGroup(group.slug).map(rollupClassification),
}));
const data = {
  seeded: kpiFigureTable((p) => withBase(projectHref(p))),
  catalog: Object.fromEntries(measures.map((m) => [m.slug, { name: m.name, unit: m.unit ?? '', decimals: m.decimalPlaces }])),
};
---
<div class="firma2-goal-board stack" data-gap="lg" data-goal-board data-goals={JSON.stringify(data)}>
  {groups.map(({ group, rollups }) => (
    <section class="firma2-goal-board__group" aria-label={group.name} data-group={group.slug}>
      <EsaCollapsible title={group.name} open flush>
        <p class="firma2-goal-board__description typography-body-md" data-group-desc>{group.description}</p>
        <div class="firma2-goal-board__grid grid" data-gap="lg" data-cards>
          {rollups.map((rollup) => <Firma2GoalCard rollup={rollup} />)}
        </div>
      </EsaCollapsible>
    </section>
  ))}
  <template data-kpi-row>
    <li>
      <Firma2KpiProgress compact name="" unit="" decimals={0} reported={null} committed={null} from={[]} />
    </li>
  </template>
</div>

<style>
  .firma2-goal-board__description {
    margin: 0;
    color: var(--color-content-default-secondary, #646464);
  }

  /* `.stack` sets display, which would outrank the UA's [hidden]. */
  .firma2-goal-board section[hidden] {
    display: none;
  }

  .firma2-goal-board__description:empty {
    display: none;
  }

  /* CONTENT_READING (src/lib/content-width.ts), held on the leading edge —
     width="reading" would centre the column under a left-aligned header. */
  /* auto-FILL, not the primitive's auto-fit: a group with one goal keeps a
     card the width of its neighbours' instead of stretching across the row.
     20rem holds a measure name of ~28 characters beside its share. */
  .firma2-goal-board__grid {
    --grid-min: 20rem;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--grid-min), 100%), 1fr));
  }

  .firma2-goal-board__group :global(.esa-collapsible__summary) {
    font-family: var(--typography-title-strong-font-family);
    font-size: var(--typography-title-strong-font-size);
    font-weight: var(--typography-title-strong-font-weight);
    line-height: var(--typography-title-strong-line-height);
    letter-spacing: var(--typography-title-strong-letter-spacing);
  }
</style>

<script>
  import { entries } from '../../lib/taxonomy-edits';
  import { recordHref } from '../../lib/taxonomy-record';
  import { renderKpis } from '../../lib/goal-kpis';
  import type { GoalData } from '../../lib/goal-kpis';

  document.querySelectorAll<HTMLElement>('[data-goal-board]').forEach((board) => {
    const data: GoalData = JSON.parse(board.dataset.goals ?? '{}');
    const template = board.querySelector<HTMLTemplateElement>('template[data-kpi-row]')!;
    const current = entries('classification');
    const groups = entries('classificationGroup');
    // Copies to clone from, taken before anything is removed: any card, and a
    // section emptied of its cards.
    const cardTemplate = board.querySelector<HTMLElement>('[data-goal-card]')?.cloneNode(true) as HTMLElement | undefined;
    const sectionTemplate = board.querySelector<HTMLElement>('section[data-group]')?.cloneNode(true) as HTMLElement | undefined;
    sectionTemplate?.querySelectorAll('[data-goal-card]').forEach((c) => c.remove());

    const sections = new Map([...board.querySelectorAll<HTMLElement>('section[data-group]')].map((s) => [s.dataset.group ?? '', s]));
    for (const [slug, section] of sections) if (!groups.some((g) => g.slug === slug)) section.remove();
    const anchor = board.querySelector('template[data-kpi-row]')!;
    for (const g of groups) {
      let section = sections.get(g.slug);
      if (!section) {
        if (!sectionTemplate) continue;
        section = sectionTemplate.cloneNode(true) as HTMLElement;
        section.dataset.group = g.slug;
      }
      section.setAttribute('aria-label', g.name);
      const name = section.querySelector('.esa-collapsible__title');
      if (name) name.textContent = g.name;
      const desc = section.querySelector('[data-group-desc]');
      if (desc) desc.textContent = g.description;
      board.insertBefore(section, anchor); // in stored group order
    }

    board.querySelectorAll<HTMLElement>('section[data-group]').forEach((section) => {
      const grid = section.querySelector<HTMLElement>('[data-cards]')!;
      const cards = [...grid.querySelectorAll<HTMLElement>('[data-goal-card]')];
      const inGroup = current.filter((e) => e.group === section.dataset.group);
      const shown = new Set(cards.map((c) => c.dataset.slug));

      // Goals moved here from another group keep their card — its figures
      // are real. Goals added in this browser get a copy of a card, emptied.
      for (const e of inGroup.filter((x) => !shown.has(x.slug))) {
        const moved = board.querySelector<HTMLElement>(`[data-goal-card][data-slug="${CSS.escape(e.slug)}"]`);
        if (moved) {
          grid.append(moved);
          cards.push(moved);
          continue;
        }
        if (!cardTemplate) break;
        const card = cardTemplate.cloneNode(true) as HTMLElement;
        card.dataset.slug = e.slug;
        const h3 = card.querySelector('h3');
        h3?.setAttribute('id', `goal-${e.slug}`);
        card.querySelector('[data-kpi-list]')?.setAttribute('aria-labelledby', `goal-${e.slug}`);
        const link = card.querySelector<HTMLAnchorElement>('[data-card-link]');
        // No goal page exists for it yet; its settings page is where it lives.
        if (link) link.href = recordHref('/prototypes/workspace-settings/classifications', e.slug);
        // Nor a peek: the panel's records are the build's.
        card.querySelector('.firma2-peek-button')?.remove();
        const count = card.querySelector('[data-card-count]');
        if (count) count.textContent = '0 projects';
        const funders = card.querySelector('[data-card-funders]');
        if (funders) funders.textContent = '0 funders';
        grid.append(card);
        cards.push(card);
      }

      for (const card of cards) {
        const e = inGroup.find((x) => x.slug === card.dataset.slug);
        if (!e) {
          // Removed goals go; a goal now in another group waits for that
          // group's section to take its card.
          if (!current.some((x) => x.slug === card.dataset.slug)) card.remove();
          continue;
        }
        const name = card.querySelector('[data-card-name]');
        if (name) name.textContent = e.name;
        card.querySelector('.firma2-peek-button [aria-label]')?.setAttribute('aria-label', `Preview ${e.name}`);
        const swatch = card.querySelector<HTMLElement>('[data-card-swatch]');
        if (swatch && e.color) swatch.style.background = e.color;
        const list = card.querySelector<HTMLElement>('[data-kpi-list]')!;
        const desc = card.querySelector('[data-card-desc]');
        if (desc && e.description != null) desc.textContent = e.description;
        const n = renderKpis(list, template, e.slug, data);
        const empty = card.querySelector<HTMLElement>('[data-kpi-empty]');
        if (empty) empty.hidden = n > 0;
        // The card shows three (its CSS); the line counts the rest.
        const more = card.querySelector<HTMLElement>('[data-kpi-more]');
        if (more) {
          more.hidden = n <= 3;
          more.textContent = `+${n - 3} more ${n - 3 === 1 ? 'measure' : 'measures'}`;
        }
      }

      // Stored order within the group; a group with no goals is not shown.
      for (const e of inGroup) {
        const card = grid.querySelector<HTMLElement>(`[data-goal-card][data-slug="${CSS.escape(e.slug)}"]`);
        if (card) grid.append(card);
      }
      section.hidden = inGroup.length === 0;
    });

    // Closed groups, remembered per reader. `toggle` does not bubble.
    const KEY = 'firma2:goal-board:closed';
    let closed: string[] = [];
    try {
      closed = JSON.parse(localStorage.getItem(KEY) ?? '[]');
    } catch {}
    board.querySelectorAll<HTMLElement>('section[data-group]').forEach((section) => {
      const details = section.querySelector('details');
      if (details && closed.includes(section.dataset.group ?? '')) details.open = false;
    });
    board.addEventListener('toggle', () => {
      const now = [...board.querySelectorAll<HTMLElement>('section[data-group]')]
        .filter((s) => !s.querySelector('details')?.open)
        .map((s) => s.dataset.group ?? '');
      try {
        localStorage.setItem(KEY, JSON.stringify(now));
      } catch {}
    }, true);
  });
</script>
