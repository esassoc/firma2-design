---
// firma2-class-mark — what leads a classification's or group's name in a list:
// its icon, tinted in its colour, or the colour's square when it has no icon
// (user, 2026-11-24: a classification can wear an icon). Decorative: the name
// beside it says what it is.
//
// bcn-lego-checked: no esa- lego draws a tinted glyph or colour square (esa-icon
// takes a registry name, not stored markup); the markup is the same inner-SVG
// a stage's icon uses. Checked Beacon (not cloned here).
interface Props {
  color: string;
  /** Inner-SVG markup of the chosen Hugeicons glyph; absent → the colour square. */
  paths?: string;
}
const { color, paths } = Astro.props;
---
{paths ? (
  <svg class="firma2-class-mark firma2-class-mark--icon" viewBox="0 0 24 24" width="16" height="16" fill="none" style={`color:${color}`} aria-hidden="true" set:html={paths} />
) : (
  <span class="firma2-class-mark firma2-class-mark--square" style={`background:${color}`} aria-hidden="true"></span>
)}
<style>
  .firma2-class-mark { flex: none; }
  .firma2-class-mark--icon { width: 1rem; height: 1rem; }
  .firma2-class-mark--square { display: inline-block; width: 0.75rem; height: 0.75rem; border-radius: var(--radius-sm, 2px); }
</style>
