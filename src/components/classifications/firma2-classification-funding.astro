---
// firma2-classification-funding — who pays for the projects carrying one
// classification: one bar per funder, its total across these projects, and the
// grants behind each bar in the table underneath.
//
// THE READER IS THE FUNDER. This is the page a program manager sends a funder
// who asks "what has the partnership done for salmon?", and the next question
// is "and how much of that was us?". The KPIs above answer the first; this
// answers the second, and who else is in it alongside them.
//
// BARS, NOT A SANKEY. Funders → projects is a many-to-many flow, and a sankey
// was the first idea. It loses here on three counts: AG Charts draws sankey only
// in Enterprise (esa-chart wraps Community; sankey support is a hub lego
// request, never a spoke build); at this scale (up to 17 funders by 11
// projects) the local-match ribbons turn into hairlines; and a flow diagram labelled with a goal reads as money that went TO
// the goal, which is the one thing this data cannot say (see the note below).
// A ranked bar answers "who funds this, and how much" exactly; which funder
// funds which project is the table's job, where it can be read row by row.
//
// WHOLE-PROJECT DOLLARS. A grant funds a project, and a project carries several
// classifications; nothing on the record splits a grant between them. So every
// bar is the full value of that funder's sources on these projects, and the same
// dollars appear on every other classification those projects carry. The note
// says so, wired to the chart with `described-by` — same mechanism and the same
// primary ink as firma2-project-expenditures' caveat. Gated on there being any
// overlap at all: on a classification whose projects carry nothing else, the
// caveat would be describing a problem the page does not have.
//
// ONE SERIES, so esa-chart draws no legend and colour encodes nothing; sorted
// largest first, so rank is read from position. No direct labels — the tooltip
// and the table carry exact figures.
//
// NO CARD (user, 2026-10-03): a section with a heading, like the projects
// grid above it.
import EsaCollapsible from '@esa/ecology/esa-collapsible.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import type { FunderTotal } from '../../data/firma2-classification-rollup';
import type { Project } from '../../data/firma2-projects';

interface Props {
  funding: FunderTotal[];
  /** The projects the funding is summed over — read only for the overlap note. */
  projects: Project[];
}

const { funding, projects } = Astro.props;
const overlaps = projects.some((p) => p.classifications.length > 1);
const noteId = 'firma2-classification-funding-note';

// Bars are 24px; the rest of each band is the gap between them, plus room for
// the value axis underneath.
const chartHeight = `${Math.max(160, funding.length * 36 + 56)}px`;

const rows = funding.flatMap((f) =>
  f.grants.map((g) => ({ funder: f.organization, program: g.program, project: g.project.projectName, amount: g.amount })),
);
---
<section class="stack" data-gap="md" aria-labelledby="firma2-classification-funding-title">
  <h2 id="firma2-classification-funding-title" class="typography-title-sm-strong">Funders</h2>
  {funding.length === 0 ? (
    <EsaEmptyState
      size="sm"
      title="No funding yet"
      description="Funders appear here once a project with this classification lists a funding source."
    />
  ) : (
    <div class="firma2-classification-funding stack" data-gap="lg">
      <!-- Minted by the script on load: esa-chart dynamically imports
           ag-charts-community, so the element arrives with its data rather than
           rendering empty first. Same reasoning as firma2-project-expenditures. -->
      <div
        data-firma2-funding-chart
        data-height={chartHeight}
        data-described-by={overlaps ? noteId : undefined}
        data-payload={JSON.stringify(funding.map((f) => ({ funder: f.organization, amount: f.amount, projects: f.projectCount })))}
      ></div>

      {overlaps && (
        <p id={noteId} class="firma2-classification-funding__note typography-body-sm">
          Whole-project amounts. A project under several classifications counts in full under each one,
          so totals across classifications overlap.
        </p>
      )}

      <!-- The chart's text alternative, and the half of the answer the bars
           leave out: which funder pays for which project, through which program.
           Long form rather than a funder × project matrix — eleven project
           columns would scroll sideways and leave most cells empty. -->
      <EsaCollapsible title="View as data" flush>
        <div data-firma2-funding-grid></div>
        <script type="application/json" data-firma2-funding-rows set:html={JSON.stringify(rows)}></script>
      </EsaCollapsible>
    </div>
  )}
</section>

<script>
  import '@esa/ecology/esa-chart';
  import { currencyFormatter as currency } from '../../lib/format';

  type ChartElement = HTMLElement & Record<string, unknown>;
  interface Datum {
    funder: string;
    amount: number;
    projects: number;
  }
  interface Row {
    funder: string;
    program: string;
    project: string;
    amount: number;
  }

  // Short figures on the axis, exact ones in the tooltip and table — the split
  // firma2-project-expenditures draws.
  const compactCurrency = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    notation: 'compact',
    maximumFractionDigits: 1,
  });

  document.querySelectorAll<HTMLElement>('.firma2-classification-funding').forEach((root) => {
    const slot = root.querySelector<HTMLElement>('[data-firma2-funding-chart]');
    const gridHost = root.querySelector<HTMLElement>('[data-firma2-funding-grid]');
    const rowsPayload = root.querySelector<HTMLScriptElement>('[data-firma2-funding-rows]');
    if (!slot) return;
    const data: Datum[] = JSON.parse(slot.dataset.payload ?? '[]');

    void customElements.whenDefined('esa-chart').then(() => {
      const el = document.createElement('esa-chart') as ChartElement;
      el.setAttribute('label', 'Funding by funder');
      el.setAttribute('height', slot.dataset.height ?? '320px');
      if (slot.dataset.describedBy) el.setAttribute('described-by', slot.dataset.describedBy);
      el.data = data;
      el.series = [
        {
          type: 'bar',
          direction: 'horizontal',
          xKey: 'funder',
          yKey: 'amount',
          yName: 'Funding',
          // The dataviz mark spec: 4px rounded data-end, bars capped at 24px.
          cornerRadius: 4,
          width: 24,
          tooltip: {
            renderer: (params: { datum: Datum }) => ({
              title: params.datum.funder,
              data: [
                { label: 'Funding', value: currency.format(params.datum.amount) },
                { label: 'Projects', value: String(params.datum.projects) },
              ],
            }),
          },
        },
      ];
      // Axes is a dictionary keyed by direction on ag-charts-community 14.1.0
      // (see firma2-project-expenditures). Horizontal: funders down the left,
      // dollars along the bottom. No axis titles — the heading names the subject
      // and every tick carries a dollar sign.
      el.options = {
        axes: {
          y: { type: 'category', position: 'left' },
          x: {
            type: 'number',
            position: 'bottom',
            label: { formatter: (params: { value: unknown }) => compactCurrency.format(Number(params.value)) },
          },
        },
      };
      slot.replaceChildren(el);
    });

    // Mounted on first open: a grid built inside a closed <details> measures
    // zero width and commits to it.
    const details = gridHost?.closest('details');
    let built = false;
    const buildGrid = async (): Promise<void> => {
      if (!gridHost || !rowsPayload || built) return;
      built = true;
      const { createCardGrid, gridCurrencyFormatter: money } = await import('../shared/grid-chrome');
      createCardGrid<Row>(gridHost, {
        rowData: JSON.parse(rowsPayload.textContent ?? '[]'),
        suppressHorizontalScroll: true,
        // Unlike a project's own three sources, this table is interrogated —
        // "show me everything on the Lower Deer Creek project" — so it sorts.
        defaultColDef: { sortable: true, resizable: false, suppressHeaderMenuButton: true, suppressMovable: true },
        columnDefs: [
          { headerName: 'Funder', field: 'funder', flex: 2, minWidth: 180 },
          { headerName: 'Program', field: 'program', flex: 2, minWidth: 180 },
          { headerName: 'Project', field: 'project', flex: 2, minWidth: 180 },
          {
            headerName: 'Amount',
            field: 'amount',
            flex: 1,
            minWidth: 120,
            type: 'rightAligned',
            valueFormatter: (p: { value: unknown }) => (p.value == null ? '' : money.format(Number(p.value))),
          },
        ],
      });
    };
    if (details) {
      details.addEventListener('toggle', () => { if (details.open) void buildGrid(); });
      if (details.open) void buildGrid();
    }
  });
</script>

<style>
  .firma2-classification-funding__note {
    margin: 0;
    max-inline-size: 60ch;
    color: var(--color-content-default, #202020);
  }
</style>
