---
// firma2-classification-projects — every project carrying one classification,
// in the portfolio grid. The SAME grid the Projects index renders, handed a
// filtered list: search, the Stage filter, CSV and the peek all behave here
// exactly as they do there, so nothing on this page is a second dialect of
// the table.
//
// The heading is what this wrapper adds. On the index the page title names
// the table; here the page title names the classification, and the table
// needs its own signpost under the measures section above it.
import Firma2ProjectGrid from '../projects/firma2-project-grid.astro';
import type { Project } from '../../data/firma2-projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---
<section class="stack" data-gap="md" aria-labelledby="firma2-classification-projects-title">
  <h2 id="firma2-classification-projects-title" class="typography-title-sm-strong">Projects</h2>
  <Firma2ProjectGrid projects={projects} />
</section>
