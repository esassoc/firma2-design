---
// firma2-kpi-progress — one KPI's progress against its goal, drawn the way
// progress against a performance measure is drawn everywhere else in the
// system: bcn-progress-ring at the xs rung beside the measure's name, and
// "reported of target" as the figure. A project's measure row
// (firma2-project-measure-row) and its peek use the same ring and the same
// figure, so a reader moving from a goal to one of its projects reads one
// picture, not two.
//
// TWO GREENS (user, 2026-10-03): the solid arc is what was reported, the
// lighter arc under it what the projects planned, and the grey left over is
// the part of the goal nobody has planned yet — the gap a classification
// exists to show. With no goal the ring measures against the plan, so the
// lighter arc has nothing to add and stays empty.
//
// THE TARGET IS THE GOAL. With no goal set the ring and figure fall back to
// what the projects committed — the comparison a project's own row makes —
// and the note says "No goal set". Committed and the goal year live in the
// note, which a bar could carry as a second fill but a ring cannot. The
// arithmetic and wording are src/lib/kpi-row.ts, shared with the browser
// repaint (paintKpiProgress in src/lib/goal-kpis.ts).
//
// The board's compact form. A classification's own page draws the same
// figures as a table with the projects as child rows
// (firma2-classification-measures).
//
// bcn-lego-checked: bcn-progress-ring is the ring (no esa- radial meter exists
// — see its header); the rest is repel/cluster layout and typography
// composites. Replaces bcn-goal-meter so progress has one look system-wide.
// Beacon is not cloned on this machine.
import BcnProgressRing from '../shared/bcn-progress-ring.astro';
import { kpiRowView } from '../../lib/kpi-row';
import type { KpiRowInput } from '../../lib/kpi-row';

interface Props extends KpiRowInput {
  name: string;
}

const { name, ...input } = Astro.props;
const v = kpiRowView(input);
---
<div class="firma2-kpi-progress stack" data-gap="2xs" data-kpi-progress>
  <div class="firma2-kpi-progress__head">
    <BcnProgressRing value={v.percent} secondary={v.plannedPercent} size="xs" />
    <span class="firma2-kpi-progress__name typography-body-md" data-kpi-name>{name}</span>
  </div>
  <p class="firma2-kpi-progress__readout">
    <span class="firma2-kpi-progress__total typography-body-md" data-kpi-total>{v.totalText}</span>
    <span class="firma2-kpi-progress__note typography-body-sm" data-kpi-note hidden={!v.lead}>{v.lead}</span>
  </p>
</div>

<style>
  /* THE FIGURE SITS UNDER ITS NAME (user, 2026-10-03). It used to be pushed
     to the row's far end, where on a full-width page it read as divorced from
     the measure it counts. Ring and name on one line; the figure — the one
     bold thing — directly under the name, with what is not yet planned
     beside it. */
  .firma2-kpi-progress__head {
    display: flex;
    align-items: center;
    gap: var(--spacing-200, 0.5rem);
  }

  .firma2-kpi-progress__name {
    min-inline-size: 0;
    color: var(--color-content-default-secondary, #646464);
  }

  /* Starts where the name does: past the ring's 1.5rem and its 0.5rem gap. */
  .firma2-kpi-progress__readout {
    margin: 0;
    padding-inline-start: 2rem;
  }

  .firma2-kpi-progress__total {
    font-weight: var(--font-weight-semibold, 600);
    font-variant-numeric: tabular-nums;
  }

  .firma2-kpi-progress__note {
    color: var(--color-content-default-secondary, #646464);
  }

  .firma2-kpi-progress__note::before {
    content: ' · ';
  }

  .firma2-kpi-progress__note[hidden] {
    display: none;
  }

</style>
