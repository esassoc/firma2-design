---
// firma2-recent-projects — the projects you opened most recently, under the
// Projects table's search box. Focus the search while it is empty and they
// drop under it; typing hides them and the table filters as it always does.
//
// IN SEARCH, NOT A ROW OF CARDS (user, 2026-11-24, picked from four in
// /proto/recent-projects — .scratch/projects-index/spec.md #1). The card row
// cost ~220px above the table on every visit, including the visits made to
// search; the search box is where a person already goes to find a project.
//
// WHERE THE LIST COMES FROM. This browser's history of app pages
// (src/lib/recent-pages.ts, recorded by AppLayout) — the same one the global
// search shows as Recent — kept to the projects in this table, newest first,
// with when you last opened each. A browser with no project in its history
// shows the seeded row (recentlyViewed) instead, so a first visit to the
// prototype still demonstrates the list.
//
// HOW IT IS BUILT. Every project in the table is rendered here once, hidden;
// the script shows the recent ones in history order. Server-rendered rows
// keep esa-pill a real lego rather than a string rebuilt in JS. The grid
// mounts this inside its search wrapper (firma2-project-grid, `recents`).
//
// KEYBOARD: ↓ from the search moves into the list, ↑/↓ walk it, ↑ from the
// first row returns to the search, Esc closes and returns, Tab leaves.
//
// bcn-lego-checked: esa-combobox clears its typed text on blur and reports "no results" while you type — both wrong for a field whose text is the table's filter; esa-popover opens on click or hover, not on focus of a field it does not own; esa-entity-search is a modal omnibox. A list of links under the grid's own esa-text-field, with esa-pill for stage, is the reusable home. Beacon is not cloned here.
import EsaPill from '@esa/ecology/esa-pill.astro';
import { projects as defaultProjects, recentlyViewed, projectHref, STAGE_TONE } from '../../data/firma2-projects';
import type { Project } from '../../data/firma2-projects';
import { withBase } from '../../lib/base';

interface Props {
  /** The table's projects — only these can be listed. */
  projects?: Project[];
}

const { projects = defaultProjects } = Astro.props;
const seed = recentlyViewed.map(({ project, viewedAt }) => ({ href: withBase(projectHref(project)), viewedAt }));
---
<div class="firma2-recent-projects" data-recent-projects data-seed={JSON.stringify(seed)} hidden>
  <p class="typography-body-sm firma2-recent-projects__head" id="firma2-recent-projects-head">Recently viewed</p>
  <ul class="firma2-recent-projects__list" role="list" aria-labelledby="firma2-recent-projects-head">
    {projects.map((project) => (
      <li data-href={withBase(projectHref(project))} hidden>
        <a class="firma2-recent-projects__item" href={withBase(projectHref(project))}>
          <span class="stack" data-gap="3xs">
            <span class="typography-label-md-strong firma2-recent-projects__name">{project.projectName}</span>
            <span class="typography-body-sm firma2-recent-projects__quiet">{project.leadOrganization}</span>
          </span>
          <EsaPill label={project.stage} variant={STAGE_TONE[project.stage]} size="sm" removable={false} />
          <span class="typography-body-sm firma2-recent-projects__quiet firma2-recent-projects__when"><span class="visually-hidden">Viewed </span><span data-when></span></span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .firma2-recent-projects {
    position: absolute;
    inset-block-start: calc(100% + var(--spacing-100));
    inset-inline-start: 0;
    z-index: 20;
    inline-size: min(34rem, calc(100vw - 2rem));
    padding: var(--spacing-200);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-background-elevation-floating);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
    transform-origin: top left;
    animation: firma2-recent-projects-in 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  /* Author display rules beat the UA [hidden]; say it outright. */
  .firma2-recent-projects[hidden],
  .firma2-recent-projects li[hidden] {
    display: none;
  }
  @keyframes firma2-recent-projects-in {
    from { opacity: 0; scale: 0.97; }
  }
  .firma2-recent-projects__head {
    margin: 0;
    padding: var(--spacing-100) var(--spacing-200) var(--spacing-200);
    color: var(--color-content-default-secondary);
  }
  .firma2-recent-projects__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .firma2-recent-projects__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 5.5rem;
    align-items: center;
    gap: var(--spacing-300);
    padding: var(--spacing-200);
    border-radius: var(--radius-sm);
    color: var(--color-content-default);
    text-decoration: none;
  }
  .firma2-recent-projects__item:focus-visible {
    background: var(--color-background-default-hover);
    outline: 2px solid var(--color-border-brand);
    outline-offset: -2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .firma2-recent-projects__item:hover {
      background: var(--color-background-default-hover);
    }
  }
  .firma2-recent-projects__item:active {
    background: var(--color-background-default-hover);
  }
  .firma2-recent-projects__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .firma2-recent-projects__quiet {
    color: var(--color-content-default-secondary);
  }
  .firma2-recent-projects__when {
    text-align: end;
  }
  /* A phone keeps the name and when; the stage is one tap away. */
  @media (max-width: 45rem) {
    .firma2-recent-projects__item {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .firma2-recent-projects__item > :nth-child(2) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .firma2-recent-projects {
      animation: none;
    }
  }
</style>

<script>
  import { readRecentVisits, viewedLabel } from '../../lib/recent-pages';

  const LIMIT = 5;

  document.querySelectorAll<HTMLElement>('[data-recent-projects]').forEach((pop) => {
    const anchor = pop.parentElement;
    const field = anchor?.querySelector<HTMLElement & { value?: string }>('[data-projects-search]');
    if (!anchor || !field) return;

    // Which rows, in what order: this browser's history, else the seed.
    const rows = new Map(Array.from(pop.querySelectorAll<HTMLElement>('li[data-href]')).map((li) => [li.dataset.href!, li]));
    const pathOf = (href: string) => href.split('?')[0].replace(/\/$/, '');
    const fromHistory = readRecentVisits()
      .map((v) => ({ href: pathOf(v.href), viewedAt: viewedLabel(v.at) }))
      .filter((v) => rows.has(v.href));
    const seed: { href: string; viewedAt: string }[] = JSON.parse(pop.dataset.seed ?? '[]');
    const shown = (fromHistory.length ? fromHistory : seed).filter((v) => rows.has(v.href)).slice(0, LIMIT);
    if (!shown.length) return;
    const list = pop.querySelector('ul')!;
    for (const { href, viewedAt } of shown) {
      const li = rows.get(href)!;
      li.querySelector('[data-when]')!.textContent = viewedAt;
      li.hidden = false;
      list.append(li); // history order
    }

    const items = () => Array.from(pop.querySelectorAll<HTMLElement>('li:not([hidden]) a'));
    const empty = () => !(field.value ?? '').trim();
    // Focus handed back by Esc or ↑ must not reopen what was just closed.
    let quiet = false;
    const open = () => { if (quiet) { quiet = false; return; } pop.hidden = !empty(); };
    const refocus = () => { quiet = true; field.focus(); };
    const close = () => { pop.hidden = true; };

    field.addEventListener('focusin', open);
    field.addEventListener('input', open);
    field.addEventListener('keydown', (e) => {
      if (pop.hidden) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); items()[0]?.focus(); }
      else if (e.key === 'Escape') close();
    });
    pop.addEventListener('keydown', (e) => {
      const all = items();
      const i = all.indexOf(document.activeElement as HTMLElement);
      if (e.key === 'ArrowDown') { e.preventDefault(); all[Math.min(i + 1, all.length - 1)]?.focus(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); if (i <= 0) field.focus(); else all[i - 1].focus(); }
      else if (e.key === 'Escape') { close(); refocus(); }
    });
    // Closes once focus or a press lands outside the search and the list.
    document.addEventListener('focusin', (e) => { if (!anchor.contains(e.target as Node)) close(); });
    document.addEventListener('pointerdown', (e) => { if (!anchor.contains(e.target as Node)) close(); });
  });
</script>
