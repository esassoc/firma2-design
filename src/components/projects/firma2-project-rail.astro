---
// firma2-project-rail — WHAT THE PROJECT RECORD'S RAIL HOLDS, in two MODES the
// top bar's icons switch between (firma2-rail-modes; user, 2026-10-22):
//   details  Key facts, then Contacts.
//   map      the work areas map with its list — the map alone, at a height
//            that reads, rather than a strip squeezed between the facts.
// Pinned, one mode shows at a time; unpinned (tablet, phone) both stack under
// the page, details first. `workAreas={false}` (the map-first page, whose pane
// is the map) renders the details alone, with no modes.
//
// THE RAIL IS WHAT YOU SET (user, 2026-10-22, after Linear's project page). The
// record sorts its content by Linear's test rather than the earlier "series vs
// scalar" one: things you READ — the description, the conversation, the
// tracked tables — go in the main column; things you SET — values picked from a
// list, the people on the record, the shapes on the ground — go in the rail.
// Linear's sidebar is exactly that list: properties, members, and a read-only
// progress graph for the thing the main column tracks. Ours is the same, with
// the map where the graph is. (A Connections graph — the record's one-hop
// links — sat last in this column from 2026-10-09 until the user removed it
// from the product on 2026-10-22.)
//
// MODES, NOT TABS, AND NOT ONE STACK. The rail was three tabs (Key facts,
// Contacts, Comments), then one stack (facts, map, contacts). The stack put an
// 18rem map between the facts and the people, too small to read the ground
// and big enough to push Contacts off the screen. As its own mode the map gets
// the room a map needs and the details read as one sheet. The switch is in the
// page's top bar, not a tab row inside the rail, so it is there even when the
// rail is closed (user, 2026-10-22).
//
// WORK AREAS ARE THE MAP. It comes WHOLE (firma2-work-areas at its `rail`
// size, tools and all), not as a thumbnail linking somewhere else, because
// there is no second map for a thumbnail to stand in for. Linear keeps its
// progress graph in the sidebar beside the document for the same reason.
// `workAreas={false}` is for the one surface where the rail floats over a map
// already: the map-first page.
//
// EVERY SECTION IS A COMPONENT, and this file is their manifest — it owns the
// stack and nothing else. Each section renders its own heading now that no tab
// names it.
//
// bcn-lego-checked: the stack is the hub's `.stack` primitive; every section
// is a spoke component composed of legos (firma2-rail-section, firma2-editable-
// field, esa-badge, esa-button …). The tab lego this file used to compose
// (esa-tab-layout) is gone with the tabs, not re-implemented.
import Firma2ProjectFacts from './firma2-project-facts.astro';
import Firma2ProjectGisFields from '../gis/firma2-project-gis-fields.astro';
import Firma2WorkAreas from './firma2-work-areas.astro';
import Firma2ProjectContacts from './firma2-project-contacts.astro';
import type { ProjectDetail } from '../../data/firma2-project-detail';

interface Props {
  detail: ProjectDetail;
  /** Whether the Work areas map is in the stack. False on the map-first page, whose pane is the map. */
  workAreas?: boolean;
}

const { detail, workAreas = true } = Astro.props;
---
<div class="firma2-project-rail stack" data-gap="2xl">
  <!-- DETAILS. Key facts carries every property; the four the main column
       repeats in its strip (Stage, Timeline, Estimated cost, Lead
       organization) are here too, on purpose — the rail is the complete
       sheet, the strip is the identity. The description is NOT here: it is a
       section of the main column (firma2-project-description). Shown first
       server-side; firma2-rail-modes switches to a remembered mode. -->
  <!-- `md` between the facts and Contacts: Contacts folds like the facts'
       groups, so it keeps their rhythm rather than a section's. -->
  <div class="stack" data-gap="md" data-rail-mode-panel={workAreas ? 'details' : undefined} data-active>
    <div class="stack" data-gap="2xl">
      <Firma2ProjectFacts detail={detail} showDescription={false} />
      <!-- Renders nothing until a GIS subscription has brought a field across. -->
      <Firma2ProjectGisFields project={detail.project} />
    </div>
    <Firma2ProjectContacts contacts={detail.contacts} />
  </div>

  <!-- MAP. The work areas and nothing else: the map, its tools in Edit mode,
       and the list of areas under it. -->
  {workAreas && (
    <div data-rail-mode-panel="map">
      <Firma2WorkAreas project={detail.project} variant="rail" />
    </div>
  )}
</div>
