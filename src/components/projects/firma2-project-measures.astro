---
// firma2-project-measures — the performance-measures section of a project's
// detail page: every measure asked of the project, the target it committed
// to on each, what it has reported against each one, and — when a reader
// asks — what it reported in each period.
//
// EVERY PUBLISHED MEASURE IS ASKED OF EVERY PROJECT (PM 2, reconciled
// 2026-10-09). There is no choosing step: the project's own seeded rows come
// first, then every published catalog measure. A TARGET — one number for the
// project's life, never per period — is what commits the project; a row with
// none reads "no target yet". Periods are shown by their NAME
// (REPORTING_PERIODS), and every target and entry write lands in the change
// log (src/lib/measure-changes.ts).
//
// ONE TABLE, MEASURES DOWN, YEARS ACROSS. Every measure on a project is built
// from the same window — buildMeasures() walks
// implementationStartYear..completionYear for all of them — so the years are one
// shared axis, and a shared axis belongs in a header row with every measure's
// figures underneath it. That is what lets a reader run their eye DOWN 2025 and
// see which measures moved and which did not. Earlier versions gave each measure
// its own unlabelled strip of marks; nothing told a reader the strips lined up,
// and nothing let them read a year.
//
// THE YEAR COLUMNS ARE COLLAPSED BY DEFAULT. At a glance a reader wants one
// thing from a measure: how much of what was promised has been delivered. So the
// table opens as two columns — measure, and reported-of-target — and the
// per-year columns arrive only when someone asks for them. This is the whole
// reason the section is a table rather than a card of tiles: columns are a thing
// you can take away and put back without the rows moving.
//
// ONE CONTROL FOR THE CARD, not one per row. The years are a shared axis, so
// changing to them is a single act; per-row disclosures would let a reader put
// the card into a state where some rows have a year axis and others do not,
// which is the one arrangement that makes the columns meaningless.
//
// AND IT IS A VIEW SWITCH, NOT A DISCLOSURE. It used to be a caret button at
// the card's FOOT reading "Reporting by year" — a downward chevron under a
// table, which is the universal sign for "more rows below". What it actually
// did was add COLUMNS to the RIGHT. The gesture promised one axis and delivered
// the other, and `aria-expanded` told assistive technology the same untruth:
// nothing expands, the table changes shape. A segmented esa-button-toggle in
// the card's action row states the real thing — two views of one table, both
// named, the current one shown — and it changes horizontally, like the result.
// It also retires a hand-rolled <button> with a CSS-border caret for a lego.
//
// NO SEPARATE "VIEW AS DATA". The table IS the data view — the figures are in
// the cells. An earlier version paired a strip of coloured marks with a hidden
// table that restated them, which is two representations of one thing and two
// places for them to disagree. Expanding the years is now the same act as asking
// for the numbers, because they are the same numbers.
//
// NO COLOUR ANYWHERE IN THE CELLS, and so no legend to key. The year cells were
// briefly tinted by share of target; the numbers were already there to be read,
// the tint made a plain table look like a heatmap, and a figure that is both
// printed and shaded is being said twice. Reading down a column of tabular
// numerals is what a table is for.
//
// NO ADD, NO REMOVE. This section is a COLLECTION, but not one the project
// curates: publishing a measure is what puts it here, and retiring it is what
// takes it away. What the project owns on each row is its target — set and
// cleared on the row itself.
//
// THE AUTHORED ORDER IS NEVER RE-SORTED. A project's measure list has an
// authored order — the headline measure first, its supporting measures after —
// and sorting by percent complete would put the least-delivered measure at the
// top of every card, a judgement this section is not making. At eight rows the
// temptation is stronger and the answer is the same.
//
// THE ZERO CASE IS NOT AN EMPTY STATE. A project in Proposal or Planning & Design
// has reported nothing against any measure, which is most of the portfolio at any
// moment. The targets are still the information — what this project has promised
// to do — so the rows render with an empty ring and "0 of 96 acres". There are no
// year columns to collapse and no control offered, because no period has closed.
// Nothing here says work has not started; the stage pill in the page header
// already says it.
import EsaCard from '@esa/ecology/esa-card.astro';
import '../shared/firma2-card-section.css';
import Firma2ProjectMeasureRow from './firma2-project-measure-row.astro';
import Firma2ProjectReportImport from './firma2-project-report-import.astro';
import { IMPORT_FIXTURES } from '../../data/firma2-report-import';
// esa-icon-button is the name in the house convention for this affordance, but
// reading it shows it was deprecated (2026-08-14) into a shim that forwards
// verbatim to `<EsaButton variant="chrome" iconOnly>` and console.warns on every
// render. Calling the real component renders byte-identical markup without the
// build noise.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import type { PerformanceMeasure } from '../../data/firma2-project-detail';
import { isClosedPeriod } from '../../data/firma2-project-detail';
import { periodName } from '../../data/firma2-performance-measures';

interface Props {
  /** The project's measures, in the order the project reports them. */
  measures: PerformanceMeasure[];
  /**
   * The project's slug — the key measures ADDED in this browser are stored
   * under (src/lib/project-measure-draft.ts). Optional so existing callers
   * degrade to a read-only section rather than breaking.
   */
  projectSlug?: string;
}

const { measures, projectSlug = '' } = Astro.props;

// THE AXIS IS READ OFF THE FIRST MEASURE because every measure carries the same
// one — buildMeasures() builds all of them from the project's single window. Not
// re-derived from the project here: this component is handed measures, and taking
// the years from the data it was actually given means the header cannot disagree
// with the cells underneath it.
//
// CLOSED PERIODS ONLY: a record has no column for a period that has not happened.
// Before this filter, 37% of every cell drawn was a placeholder for a year that
// had not arrived, and a Proposal project drew nothing else.
const years = measures[0]?.series.filter(isClosedPeriod).map((period) => period.year) ?? [];
const hasYears = years.length > 0;

// THE NAME COLUMN IS SIZED TO THE NAMES IT ACTUALLY HOLDS. A flat cap truncated
// "Acres of riparian floodplain planted" on a project whose table had visible
// empty space beside it, which reads as a bug — a fixed width cannot know that
// this project's longest name is short. It cannot be `auto` either: the column
// is sticky, and the column pinned beside it needs a resolved offset to sit at.
// So it is computed, once, from the longest name on this project.
//
// `ch` is the width of a "0", which in a proportional face runs a little wider
// than the lowercase this column is mostly made of — so the estimate errs long,
// which is the safe direction: a column slightly wider than its content wastes
// a few pixels, one slightly narrower truncates a name.
//
// The `+ 2rem` is the ring's footprint — 1.5rem of mark plus its 0.5rem gap —
// which shares this column with the name. Omitting it under-allocated every
// short-name project by exactly the ring's width and squeezed the text.
//
// THE UPPER CLAMP IS THE POINT, not a safety rail. Letting the column take
// whatever the longest name wants pushed the year columns off the table — a
// three-year project that used to fit without scrolling started clipping "2024"
// to "4". Names that exceed 18rem truncate, as they did before; what changed is
// that a project whose names are SHORTER than that no longer gets an 18rem
// column with empty space in it, which is the case that read as a bug.
//
// The cost, stated plainly: with the ring in this column the longest names —
// "Miles of livestock exclusion fencing" and up — no longer fit 18rem and
// truncate, where without it they just did. Raising the cap to fit them puts a
// three-year project over its container and starts it scrolling, which is the
// worse trade. The `title` carries the full string.
const longestName = Math.max(0, ...measures.map((measure) => measure.name.length));

// The document-first door, offered only where a reading exists to show.
const canImport = Boolean(IMPORT_FIXTURES[projectSlug]);
const unitsByName = Object.fromEntries(measures.map((measure) => [measure.name, measure.unit]));
// The clone source for rows added in the browser, when the record has none to
// clone — a project nobody has asked anything yet (team 6's empty state).
const placeholderMeasure: PerformanceMeasure = { name: '', unit: '', expected: 0, reported: 0, series: [] };
---
{(measures.length > 0 || projectSlug) && (
  <div class="firma2-project-measures" data-aliasable-title data-view="total">
  <EsaCard title="Performance measures">
    <!-- RECORD WORK is the reporter's door, and it is ACTIVITY-FIRST: the
         sheet opens on "What did you do?" — a search over every subcategory
         option AND measure name on this project — because reporters think
         "40 acres of pile burning", not in catalog buckets. Picking the
         activity resolves the measure and pre-answers the question; the
         predecessor's 20% Default/Default filler is what measure-first
         forms did to these users. The per-row Record button remains the
         measure-first path for fluent reporters.

         There is NO "Add measure" or "Choose measures" control (PM 2,
         reconciled 2026-10-09): every PUBLISHED measure is asked of every
         project, so every one is already a row. A TARGET is what commits the
         project to an amount — set it on the row's Progress cell, clear it the
         same way; clearing is never refused and the row stays. -->
    <EsaButton slot="actions" variant="chrome" size="sm" icon="notepad-text" data-firma2-pm-record-work>Record work</EsaButton>
    <!-- THE DOCUMENT-FIRST DOOR (hackathon team 6): the crew log or grant
         report the reporter already keeps, read against these measures. -->
    {canImport && (
      <EsaButton slot="actions" variant="chrome" size="sm" icon="upload" data-open-report-import>Import a report</EsaButton>
    )}

    <!-- THE VIEW SWITCH. Both views named, the current one filled — a reader
         never has to press it to learn what the other one is, which is the
         thing a lone disclosure control can never say. Offered only when a
         period has closed: with no years there is no second view, and a
         control whose other half is empty is worse than no control.

         No visible group label. The two segments name themselves under a card
         headed "Performance measures", and a "Show" label above them would be
         the ornamental micro-label the house rules ban. The lego has no
         hidden-label prop, so the script names the radiogroup for assistive
         technology instead — see the note there. -->
    <!-- THREE VIEWS: Report (team 6 — one period, entered in place), Total
         and By year (the history table). Total stays the default. -->
    <esa-button-toggle
      slot="actions"
      size="sm"
      data-firma2-measure-view
      data-has-years={hasYears ? '' : undefined}
    ></esa-button-toggle>

    <div class="firma2-project-measures__body stack" data-gap="md" data-firma2-pm-section data-project-slug={projectSlug}>
      <!-- NOTHING ASKED YET — only when the program has published no measure
           at all. Never an invitation to DEFINE one: that is the program
           lead's job, on the catalog. PM 2's own copy. -->
      <!-- WHAT IS DUE (user, 2026-10-09): the reporter's first question is
           "is my record in good shape?", so the card opens on the last closed
           period's count over the measures this project has committed to,
           names what is missing, and offers the way in — the Report view on
           that period. Hidden when nothing is committed. -->
      <div class="firma2-project-measures__due repel" data-gap="sm" data-pm-due hidden>
        <p class="typography-body-md" data-pm-due-text></p>
        <EsaButton variant="secondary" size="md" data-pm-due-report>Report</EsaButton>
      </div>

      <div data-pm-empty hidden>
        <EsaEmptyState size="sm" headingLevel={4} title="Nothing is being asked of this project yet" description="Once your program publishes a performance measure, it will appear here for you to report against." />
      </div>

      <!-- REPORT: one period at a time (team 6). Segments rather than a
           dropdown, because a reporter arriving from a reminder is reporting
           for THIS period and the others are context. -->
      <div class="firma2-project-measures__report stack" data-gap="lg" data-pm-report>
        <div class="firma2-project-measures__report-head stack" data-gap="sm">
          <esa-button-toggle size="sm" data-pm-period aria-label="Reporting period"></esa-button-toggle>
          <p class="typography-label-md firma2-project-measures__report-progress" data-pm-progress></p>
        </div>
        <div class="stack" data-gap="lg" data-pm-report-list></div>
      </div>
      <!-- The scroller is the ONLY place this card may scroll, and only once the
           year columns are showing: a fifteen-year window plus a measure name and
           its total cannot fit the 22rem map panel at any type size, and the
           alternatives are worse — shrinking figures past the dense floor, or
           letting the card itself overflow, which is the exact failure
           firma2-project-atlas records for the funding table. Collapsed, the two
           columns always fit and it never scrolls. -->
      <div
        class="firma2-project-measures__scroller"
        data-firma2-measure-years="hidden"
        style={`--firma2-measure-name-ch: ${longestName}`}
      >
        <table class="firma2-project-measures__table">
          <caption class="visually-hidden">Performance measures, reported by year</caption>
          <thead>
            <tr>
              <th scope="col">Measure</th>
              <!-- "Progress", not "Reported": the cell under it holds the
                   reported figure AND the target it is measured against, and a
                   header should name what is in the column rather than half of
                   it. -->
              <th scope="col" class="firma2-project-measures__num">Progress</th>
              {years.map((year) => (
                <th scope="col" class="firma2-project-measures__num firma2-project-measures__year" data-year={year}>
                  {periodName(year)}
                </th>
              ))}
              <!-- Empty on purpose — see the spacer note in the stylesheet. It
                   carries no header text because it labels nothing. -->
              <td class="firma2-project-measures__spacer"></td>
            </tr>
          </thead>
          <tbody>
            {measures.map((measure) => (
              <Firma2ProjectMeasureRow measure={measure} />
            ))}
          </tbody>
        </table>
      </div>
      <!-- COMMITTED FIRST (user, 2026-10-09). Every published measure can be
           committed to on every project (PM 2), but a riparian project's card
           was two-thirds fuels and levees it will never report. Measures with
           no target and nothing filed fold behind this one line; opening it
           shows them with Set target. Offered only to someone allowed to set
           targets, while editing. -->
      <div data-pm-others data-edit-only hidden>
        <EsaButton variant="ghost" size="md" icon="plus" data-pm-others-toggle>Other measures</EsaButton>
      </div>
    </div>
  </EsaCard>

  <!-- bcn-lego-checked: everything below IS legos — esa-side-dialog,
       esa-select, esa-text-field, esa-combobox, esa-button — composed with
       layout primitives; the classes are query hooks, not bespoke skins. The
       button templates are the lego-clone trick the data grids use for
       pills/peeks: real esa-buttons server-rendered once and cloned into rows
       the script builds. Beacon is not cloned on this machine. -->

  <!-- THE ENTRY SHEET — where an observation is recorded against one of this
       project's measures, and the PRIMARY design of the reporting
       interaction (the measure catalog's admin preview mirrors this form).
       One entry is the model's atom: a period, the figure, and the reporter's
       answers to the measure's breakdowns — each optional, at most one option
       per question. SAVE KEEPS THE SHEET OPEN:
       recording is a batch act (80 acres of thinning and 40 of burning are
       two entries in one sitting), so Save appends to the log below and
       clears for the next; Done is how a sitting ends. Entries live in this
       browser (src/lib/entry-draft.ts) and the log's heading says so. -->
  <esa-side-dialog class="firma2-project-measures__entry-sheet" heading="Record an entry" size="md" position="right">
    <div class="firma2-project-measures__entry stack" data-gap="lg">
      <!-- The activity-first door. Hidden on the per-row path; on Record
           work it is the whole opening move, and the rest of the form
           appears once the pick has resolved which measure this files
           under. -->
      <esa-combobox
        data-entry-activity
        label="What did you do?"
        size="md"
        placeholder="e.g. pile burning"
        hidden
      ></esa-combobox>
      <p class="firma2-project-measures__entry-lede typography-meta" data-entry-lede></p>
      <!-- What this measure said last period, so this period's figure is typed
           beside the last one rather than from memory (team 6). -->
      <p class="firma2-project-measures__entry-previous typography-body-sm" data-entry-previous hidden></p>
      <div class="stack" data-gap="lg" data-entry-body>
        <esa-select data-entry-year label="Reporting period" size="md"></esa-select>
        <div class="stack" data-gap="md" data-entry-questions></div>
        <esa-text-field data-entry-amount label="Amount" size="md" inputmode="decimal" required></esa-text-field>
        <!-- ONE AMOUNT PER OPTION when the first question is answered with
             several (team 6's pivot): planting AND fencing in one sitting, each
             with its own figure, each saved as its own entry. -->
        <div class="stack" data-gap="md" data-entry-split hidden></div>
        <section class="stack" data-gap="2xs" data-entry-log-block hidden>
          <h3 class="firma2-project-measures__entry-log-title typography-label-sm">Recorded in this browser</h3>
          <ul class="firma2-project-measures__entry-log stack" data-gap="2xs" data-entry-log></ul>
        </section>
      </div>
    </div>
    <div slot="footer" class="firma2-project-measures__entry-footer repel">
      <EsaButton variant="ghost" size="md" data-entry-done>Done</EsaButton>
      <EsaButton variant="primary" size="md" data-entry-save>Save entry</EsaButton>
    </div>
  </esa-side-dialog>

  <!-- Row affordance templates, cloned into name cells by the script:
       Record on every row, Clear target on every row that has one. -->
  <template data-pm-seed-template>
    <table><tbody><Firma2ProjectMeasureRow measure={placeholderMeasure} /></tbody></table>
  </template>
  <esa-confirm-dialog class="firma2-project-measures__bin" variant="danger" heading="Remove these figures?" confirm-label="Remove" cancel-label="Keep them"></esa-confirm-dialog>
  <div data-pm-bin-template hidden aria-hidden="true">
    <EsaButton variant="ghost" iconOnly icon="trash-2" size="sm" aria-label="Remove these figures">Remove these figures</EsaButton>
  </div>
  <div data-pm-clear-template hidden aria-hidden="true">
    <EsaButton variant="ghost" iconOnly icon="x" size="sm" aria-label="Clear this entry">Clear this entry</EsaButton>
  </div>
  <div data-firma2-pm-divide-template hidden aria-hidden="true">
    <EsaButton variant="chrome" iconOnly icon="chevron-down" size="sm" aria-label="Show how it divides">Show how it divides</EsaButton>
  </div>
  <div data-firma2-pm-record-template hidden aria-hidden="true">
    <EsaButton variant="chrome" iconOnly icon="plus" size="sm" aria-label="Record an entry">Record an entry</EsaButton>
  </div>
  <!-- The visible way in to a target, on rows with none — double-clicking
       the Progress cell does the same, but nothing on screen says so. -->
  <div data-firma2-pm-set-target-template hidden aria-hidden="true">
    <EsaButton variant="ghost" size="md" icon="plus">Set target</EsaButton>
  </div>
  <div data-firma2-pm-remove-template hidden aria-hidden="true">
    <EsaButton variant="chrome" iconOnly icon="x" size="sm" aria-label="Clear target">Clear target</EsaButton>
  </div>
  {canImport && (
    <Firma2ProjectReportImport projectSlug={projectSlug} years={[...years].reverse()} units={unitsByName} />
  )}
  </div>
)}

<style>
  /* Uncommitted measures fold away until asked for (see data-pm-others). */
  .firma2-project-measures:not([data-show-others]) :global(tr[data-uncommitted]) {
    display: none;
  }

  /* A retired measure: its tag in quiet ink; nothing new can be recorded or
     targeted on it. */
  .firma2-project-measures :global(.firma2-project-measures__retired-tag) {
    margin-inline-start: var(--spacing-200, 0.5rem);
    color: var(--color-content-default-secondary, #646464);
    white-space: nowrap;
  }
  .firma2-project-measures :global(.firma2-project-measures__retired-tag[hidden]) {
    display: none;
  }
  .firma2-project-measures :global(tr[data-retired-measure] :is(.firma2-project-measures__record, .firma2-project-measures__remove, .firma2-project-measures__set-target)) {
    display: none !important;
  }

  /* No ring where there is nothing to measure against. */
  .firma2-project-measures :global(tr[data-no-target] .bcn-progress-ring) {
    visibility: hidden;
  }

  /* Without the right to set targets, neither door shows — "No target"
     stays as plain text even while editing. */
  .firma2-project-measures[data-targets-locked] :global(:is(.firma2-project-measures__set-target, .firma2-project-measures__remove)) {
    display: none !important;
  }
  :global(html[data-record-mode='edit']) .firma2-project-measures[data-targets-locked] :global(.firma2-project-measures__no-target) {
    display: inline;
  }

  .firma2-project-measures__due p {
    margin: 0;
  }

  .firma2-project-measures [data-pm-due][hidden],
  .firma2-project-measures [data-pm-others][hidden] {
    display: none !important;
  }

  /* The container the scroller's own query reads. It goes on the WRAPPER, not on
     the scroller: an element cannot query its own container, and a rule written
     that way matches nothing at all — silently. */
  .firma2-project-measures__body {
    container-type: inline-size;
    container-name: firma2-measures;
  }

  .firma2-project-measures__scroller {
    /* Only reachable with the year columns showing — see the markup note. */
    overflow-x: auto;
    /* ONE DEFINITION of the pinned name column's width, read by the cap on that
       column AND by the sticky offset of the total beside it. Two numbers that
       have to agree should be one number. The `ch` count comes from the longest
       name on this project — see the frontmatter. */
    --firma2-measure-name-max: 18rem;
    --firma2-measure-name-width: clamp(
      10rem,
      calc(var(--firma2-measure-name-ch, 26) * 1ch + 2rem),
      var(--firma2-measure-name-max)
    );
  }

  /* In the map panel there is no room for an 18rem name column beside a pinned
     total; the name gives way first, because it ellipsizes gracefully and the
     figure does not. */
  @container firma2-measures (max-width: 34rem) {
    .firma2-project-measures__scroller {
      /* 8rem, not 9: measured against the widest total in the portfolio —
         "220,900 of 410,000 cubic yards" at ~250px — which put a 9rem name
         column 7px over the panel and started it scrolling while collapsed. The
         figure cannot wrap without making every row two lines tall, so the name
         column is what gives. */
      --firma2-measure-name-width: 8rem;
    }
  }

  /* At the atlas panel's 22rem floor the name gives way again. Measured, not
     guessed: "178 of 380 assessments" is the widest total in the portfolio at
     ~175px and it cannot wrap without making every row two lines tall, so the
     name column gets what is left. 6rem is heavy truncation — the `title`
     carries the full string — and it is the price of the promise this card makes
     everywhere else: collapsed, it never scrolls. */
  @container firma2-measures (max-width: 21rem) {
    .firma2-project-measures__scroller {
      --firma2-measure-name-width: 6rem;
    }
  }

  /* The table chrome below is firma2-project-expenditures.astro:292-332, rule for
     rule — collapsed borders, flush outer padding, secondary column heads,
     tabular numerals aligned to the end. Copied rather than imported because it
     is component-scoped there too; extracting a shared record-table stylesheet is
     a follow-up, not a reason to diverge here in the meantime. */
  .firma2-project-measures__table {
    inline-size: 100%;
    /* SEPARATE, NOT COLLAPSE — and this is what makes the sticky seam work at
       all. Under `border-collapse: collapse` a border between two cells belongs
       to the TABLE, not to either cell: the browser resolves the conflict once
       and paints the winner in table space. So the rule after the pinned figures
       scrolled away with the year columns, which is the opposite of the one
       thing it is for — marking where the years begin while you scroll them.
       In the separate model each cell owns its own borders and a sticky cell
       carries them along. `border-spacing: 0` keeps the cells flush, and nothing
       doubles because every rule below sets a single side. */
    border-collapse: separate;
    border-spacing: 0;
  }

  .firma2-project-measures__table :global(th),
  .firma2-project-measures__table :global(td) {
    text-align: start;
    vertical-align: middle;
    padding-block: var(--spacing-200, 0.5rem);
    padding-inline: var(--spacing-300, 0.75rem);
  }

  .firma2-project-measures__table :global(th:first-child),
  .firma2-project-measures__table :global(td:first-child) { padding-inline-start: 0; }
  .firma2-project-measures__table :global(th:last-child),
  .firma2-project-measures__table :global(td:last-child) { padding-inline-end: 0; }

  .firma2-project-measures__table thead th {
    color: var(--color-content-default-secondary, #646464);
    font-weight: var(--font-weight-semibold, 600);
    white-space: nowrap;
    border-block-end: var(--border-width-default, 1px) solid var(--color-border-default, #cecece);
  }

  /* The row header carries the measure's name, and a name is not a heading —
     inherit the body weight so the only bold thing in the row is the figure the
     reader came for. The name column takes the slack; every other column is
     content-sized. */
  .firma2-project-measures__table :global(tbody th) {
    font-weight: inherit;
    color: var(--color-content-default-secondary, #646464);
  }

  .firma2-project-measures__table :global(tbody tr + tr th),
  .firma2-project-measures__table :global(tbody tr + tr td) {
    border-block-start: var(--border-width-default, 1px) solid
      var(--color-border-default-subtle, #d9d9d9);
  }

  /* NUMERIC COLUMNS ALIGN TO THEIR END, and this rule has to live HERE, after
     the generic cell rule above, because that one wins on specificity: Astro
     scopes both compounds, so `.table[cid] td` (0,2,1) outranks the row
     component's own `.row__num[cid]` (0,2,0) and quietly left-aligned every
     figure in the table. Digits that do not line up are the one thing a column
     of numbers must not do — 10,727 and 98 have to share a right edge to be
     comparable at a glance. Matching specificity, later in the sheet, wins. */
  .firma2-project-measures__table thead th.firma2-project-measures__num,
  .firma2-project-measures__table :global(.firma2-project-measure-row__num) {
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  /* THE TWO SUMMARY COLUMNS STAY PUT WHILE THE YEARS SCROLL. Seven year columns
     plus a measure name do not fit a 41rem main column, let alone a 22rem map
     panel, so the table scrolls — and a cross-tab whose row header scrolls out
     of view is a grid of anonymous numbers. Pinning the name and the total means
     a reader dragging out to 2025 still knows which measure they are reading and
     what it adds up to.

     The background is esa-card's own token (esa-card.astro:114), not a literal:
     the pinned cells have to paint over what slides under them, and a hardcoded
     white would tear the moment a card variant or a dark scheme changed the
     surface. */
  .firma2-project-measures__table :global(th:first-child) {
    position: sticky;
    inset-inline-start: 0;
    z-index: 1;
    background: var(--card-bg, var(--color-background-elevation-raised, #fcfcfc));
  }

  .firma2-project-measures__table :global(.firma2-project-measure-row__total),
  .firma2-project-measures__table thead th:nth-child(2) {
    position: sticky;
    /* THE OFFSET IS MEASURED, NOT DECLARED. It has to equal the name column's
       RENDERED width, and a table's auto layout treats `inline-size` on a cell
       as a suggestion — it hands the column whatever the algorithm resolves,
       which is close to the request but not equal to it. Pinning this column at
       the requested width left a sliver of ungoverned space between the two, and
       a scrolled year column bled up through it: on the twenty-five-year project
       a phantom "20" and a stray "C" sat between Measure and Progress.
       The script measures the real width after layout and publishes it here; the
       declared width is the fallback for the moment before it runs. */
    inset-inline-start: var(--firma2-measure-sticky-offset, var(--firma2-measure-name-width, 18rem));
    z-index: 1;
    background: var(--card-bg, var(--color-background-elevation-raised, #fcfcfc));
  }

  /* THE SEAM AFTER THE FIGURES, and it earns its keep in both views. In By
     year it is the edge the year columns scroll against, so the pinned pair
     reads as an edge rather than as columns that happen to be still. In Total
     it says the table continues past the figures — no longer the ONLY hint
     that it does, now that the card header names both views, but still the
     thing that makes the pinned pair look deliberate.

     A border rather than the box-shadow this started as — inside a
     border-collapse table the shadow painted under the neighbouring cells and
     never showed at all. Which is also why the leftmost year column simply
     reads as clipped when the axis opens at its recent end: the conventional
     occlusion shadow is not available here, and a partial column at a scroll
     edge is what every scrolled table looks like. */
  .firma2-project-measures__table :global(.firma2-project-measure-row__total),
  .firma2-project-measures__table thead th:nth-child(2) {
    border-inline-end: var(--border-width-default, 1px) solid
      var(--color-border-default, #cecece);
  }

  /* THE NAME COLUMN IS CAPPED, not slack-taking, once it has to be pinned: a
     sticky column has to have a width the offset above can name, and an `auto`
     column sized to the longest measure name would push the years off screen
     before the reader ever saw one. Long names ellipsize — the full string is on
     the row's `title`. */
  .firma2-project-measures__table :global(tbody th),
  .firma2-project-measures__table thead th:first-child {
    inline-size: var(--firma2-measure-name-width, 18rem);
    max-inline-size: var(--firma2-measure-name-width, 18rem);
  }

  /* THE COLLAPSE, and it is the whole of it: the year columns are removed from
     the table rather than hidden inside it, so the remaining columns re-flow to
     the full width instead of leaving a gap where the years were.

     Trailing `:global()` reaches into the row component from a scoped ancestor,
     which is the direction Astro's scoping supports. A LEADING `:global()`
     silently loses its ancestor — the compiler emits the local compound alone —
     and a rule written that way fires unconditionally. Written down here so it
     does not have to be rediscovered. */
  [data-firma2-measure-years='hidden'] .firma2-project-measures__year,
  [data-firma2-measure-years='hidden'] :global(.firma2-project-measure-row__year) {
    display: none;
  }

  /* A TRAILING SPACER COLUMN, and it is the only reason the seam is visible. The
     table is full-width, so the leftover width has to land somewhere: give it to
     the figures and they stretch to the card's right edge, putting the border
     flush against the card's own outline where it reads as a doubled line; give
     it to the name and the figures get pushed there instead. A zero-content
     column at the end takes it, so the name and the figures both keep their own
     widths, the seam lands immediately after the numbers, and the space beyond
     it is what says the table continues. Expanded, it collapses to nothing the
     moment the year columns need the room. */
  .firma2-project-measures__spacer {
    inline-size: 100%;
    padding: 0;
  }

  /* THE NAME CAP IS ONLY THERE TO PROTECT THE YEAR COLUMNS, so it lifts when
     there are none. Collapsed, the table has slack to spare — it is sitting
     right there past the seam — and truncating a name into it is the exact
     defect this column was resized to fix. Expanded, 18rem comes back, because
     then the slack is what the years need. The cost is that the figures shift
     when the control is used; the alternative is a permanently truncated name
     column in the view a reader actually spends their time in.
     It raises the CAP, not the width. Setting the cell to `max-content` also
     lifts the cap — and takes the container queries below with it, which
     overflowed the 22rem map panel by 180px. The clamp still governs. */
  .firma2-project-measures__scroller[data-firma2-measure-years='hidden'] {
    --firma2-measure-name-max: 26rem;
  }

  /* A row with no target says so while the record is read; while it is
     edited the Set target button takes the same place instead. */
  :global(html[data-record-mode='edit']) .firma2-project-measures :global(.firma2-project-measures__no-target) {
    display: none;
  }

  .firma2-project-measures :global(.firma2-project-measures__set-target) {
    display: inline-flex;
    vertical-align: middle;
  }

  /* ROW AFFORDANCES — Record on every row, Clear target on every row that
     has a target. Built by cloning the server-rendered templates, so the rules
     reach through :global (injected content has no scope hash). Quiet until
     the row is hovered or focused: opacity, not display, so the pinned name
     column never reflows, and the buttons stay in the tab order. */
  .firma2-project-measures__table :global(.firma2-project-measures__record),
  .firma2-project-measures__table :global(.firma2-project-measures__remove) {
    opacity: 0;
    transition: opacity 120ms ease;
    flex: none;
    line-height: 0;
  }

  .firma2-project-measures__table :global(tr:hover .firma2-project-measures__record),
  .firma2-project-measures__table :global(tr:focus-within .firma2-project-measures__record),
  .firma2-project-measures__table :global(tr:hover .firma2-project-measures__remove),
  .firma2-project-measures__table :global(tr:focus-within .firma2-project-measures__remove) {
    opacity: 1;
  }

  @media (hover: none) {
    .firma2-project-measures__table :global(.firma2-project-measures__record),
    .firma2-project-measures__table :global(.firma2-project-measures__remove) {
      opacity: 1;
    }
  }

  .firma2-project-measures__table :global(.firma2-project-measures__record .esa-button__native),
  .firma2-project-measures__table :global(.firma2-project-measures__remove .esa-button__native) {
    block-size: 24px;
    inline-size: 24px;
    padding: 0;
  }

  /* THE TARGET EDITOR takes the whole Progress cell it replaces. */
  .firma2-project-measures__table :global(.firma2-project-measure-row__total esa-text-field) {
    display: block;
    inline-size: 100%;
    text-align: start;
  }

  /* COLLAPSED, THE SCROLLER MUST NOT CLIP: nothing can overflow sideways in
     the two-column state, and a field's error line under the last row must
     not be cut at the table's foot. Only the expanded state actually
     scrolls, so only it pays the clipping cost. */
  .firma2-project-measures__scroller[data-firma2-measure-years='hidden'] {
    overflow-x: visible;
  }

  /* THE CARD MUST NOT CLIP EITHER — esa-card ships overflow:hidden for its
     rounded corners, and a dropdown near its foot (the Report view's
     breakdown selects; position:absolute in the lego) was being decapitated
     at the card's bottom edge; the card was the ONLY clipping ancestor on
     the chain (measured). The clip exists for
     full-bleed children; everything in this card is padded, so releasing it
     costs nothing — the radius still paints, it just no longer clips a list
     that needs to fall past the card. */
  .firma2-project-measures :global(.esa-card) {
    overflow: visible;
  }

  /* THE ENTRY SHEET. Slightly wider than the md rung for the question
     dropdowns; the lego's own token pierces the shadow root. */
  .firma2-project-measures__entry-sheet {
    --side-dialog-width: 480px;
  }

  .firma2-project-measures__entry-lede,
  .firma2-project-measures__entry-log-title {
    margin: 0;
  }

  .firma2-project-measures__entry-lede {
    color: var(--color-content-default-secondary, #646464);
  }

  .firma2-project-measures__entry-log {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .firma2-project-measures__entry-footer {
    inline-size: 100%;
  }

  .firma2-project-measures :global(.firma2-project-measures__entry-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-200, 0.5rem);
    padding-block: var(--spacing-100, 0.25rem);
    border-block-end: 1px solid var(--color-border-default-subtle, #d9d9d9);
  }

  .firma2-project-measures :global(.firma2-project-measures__entry-remove .esa-button__native) {
    block-size: 24px;
    inline-size: 24px;
    padding: 0;
  }

  /* MAKE `hidden` MEAN HIDDEN for the sheet's toggled blocks — the log
     section carries a layout utility whose display outranks the UA's
     [hidden] rule, the same trap the sidesheets document. Scoped to this
     component's own hooks so it cannot touch the scroller's
     data-firma2-measure-years="hidden" ATTRIBUTE VALUE, which is unrelated. */
  .firma2-project-measures :global([data-entry-log-block][hidden]),
  .firma2-project-measures :global([data-entry-body][hidden]),
  .firma2-project-measures :global([data-entry-activity][hidden]),
  .firma2-project-measures :global([data-entry-lede][hidden]) {
    display: none !important;
  }

  /* THE ACTIONS AND A THREE-WAY SWITCH no longer fit beside the title at
     this column width; they wrap to a second line, trailing-aligned, rather
     than running past the card's edge. */
  .firma2-project-measures :global(.esa-card__actions) {
    flex-wrap: wrap;
    justify-content: flex-end;
    min-inline-size: 0;
  }

  /* ---- report view (team 6) ---------------------------------------------- */
  .firma2-project-measures:not([data-view='report']) [data-pm-report] {
    display: none;
  }
  .firma2-project-measures[data-view='report'] .firma2-project-measures__scroller {
    display: none;
  }
  .firma2-project-measures[data-empty] .firma2-project-measures__scroller,
  .firma2-project-measures[data-empty] [data-pm-report] {
    display: none;
  }
  .firma2-project-measures__report-progress {
    margin: 0;
  }
  :global(.firma2-project-measures__rm) {
    padding-block-end: var(--spacing-500);
    border-block-end: 1px solid var(--color-border-default);
  }
  :global(.firma2-project-measures__rm:last-child) {
    border-block-end: 0;
  }
  :global(.firma2-project-measures__rm-head) {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-300);
  }
  :global(.firma2-project-measures__rm-head h4) {
    margin: 0;
  }
  :global(.firma2-project-measures__rm-done) {
    color: var(--color-content-brand, #2a7e3b);
  }
  :global(.firma2-project-measures__rm-meta) {
    margin: 0;
    color: var(--color-content-default-secondary, #646464);
  }
  /* A block: the questions on one line, the amounts under them, and the
     block's own remove control in the corner, out of the questions' way. */
  :global(.firma2-project-measures__block) {
    position: relative;
    display: grid;
    gap: var(--spacing-300);
    padding: var(--spacing-400);
    padding-inline-end: var(--spacing-800, 3rem);
    border: 1px solid var(--color-border-default-subtle, #d9d9d9);
    border-radius: var(--radius-md, 0.5rem);
  }
  :global(.firma2-project-measures__block--blank) {
    border-style: dashed;
  }
  :global(.firma2-project-measures__block-row) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--spacing-300);
  }
  :global(.firma2-project-measures__block-corner) {
    position: absolute;
    inset-block-start: var(--spacing-200);
    inset-inline-end: var(--spacing-200);
  }
  /* ---- team 6 additions -------------------------------------------------- */
  .firma2-project-measures [hidden] {
    display: none !important;
  }
  .firma2-project-measures__entry-previous {
    margin: 0;
    color: var(--color-content-default-secondary, #646464);
  }
  /* A breakdown row reads as part of its measure: indented, secondary ink. */
  .firma2-project-measures__table :global(tr[data-breakdown-of] th) {
    padding-inline-start: var(--spacing-700, 2rem);
    color: var(--color-content-default-secondary, #646464);
  }
  .firma2-project-measures__table :global(tr[data-breakdown-of] td) {
    color: var(--color-content-default-secondary, #646464);
  }
  .firma2-project-measures__table :global(.firma2-project-measures__divide[aria-expanded='true'] svg) {
    transform: rotate(180deg);
  }
</style>

<script>
  import { isViewMode } from '../../lib/record-mode';
  import '@esa/ecology/esa-button-toggle';

  // THE WHOLE OF THE VIEW SWITCH. It writes one attribute on the scroller; every
  // appearance change — the year header cells, the year data cells, the name
  // column's cap — is a CSS consequence of that attribute. Nothing is rendered
  // here, so there is no state to keep in sync and no layout the script can get
  // wrong.
  //
  // Scoped per card via closest(), not a document-wide selector: the atlas page
  // can put this section on screen beside other cards, and a switch that reached
  // every table on the page would be a bug the moment a second one appears.
  // The pinned figure column has to start exactly where the measure column ends,
  // and only layout knows where that is — see the CSS note. Measured after the
  // columns exist, and again whenever the table is resized, because the measure
  // column's width tracks the container.
  const syncStickyOffset = (scroller: HTMLElement): void => {
    const first = scroller.querySelector<HTMLElement>('thead th:first-child');
    if (first) scroller.style.setProperty('--firma2-measure-sticky-offset', `${first.offsetWidth}px`);
  };

  document.querySelectorAll<HTMLElement>('[data-firma2-measure-years]').forEach((scroller) => {
    syncStickyOffset(scroller);
    new ResizeObserver(() => syncStickyOffset(scroller)).observe(scroller);
  });

  /**
   * THE TWO VIEWS, named. "Total" is the running figure against its target —
   * the one thing a reader wants at a glance and the reason it is the default.
   * "By year" adds one column per closed reporting period.
   */
  const VIEW_TOTAL = 'total';
  const VIEW_YEARS = 'years';
  const VIEW_REPORT = 'report';
  // REPORT is team 6's view: one period, entered in place. It sits beside the
  // history table rather than replacing it — Total stays the default.
  const viewOptions = (hasYears: boolean) => [
    { label: 'Report', value: VIEW_REPORT },
    { label: 'Total', value: VIEW_TOTAL },
    ...(hasYears ? [{ label: 'By year', value: VIEW_YEARS }] : []),
  ];

  /** Names the radiogroup for assistive technology, since it shows no label. */
  const VIEW_GROUP_NAME = 'Figures shown';

  type Toggle = HTMLElement & { options?: unknown; value?: string };

  document.querySelectorAll<Toggle>('[data-firma2-measure-view]').forEach((toggle) => {
    const scroller = toggle
      .closest('.firma2-project-measures')
      ?.querySelector<HTMLElement>('[data-firma2-measure-years]');
    if (!scroller) return;

    // Options are an array, so they are a PROPERTY, not an attribute — and safe
    // to assign before the element upgrades: Lit reclaims a property set on an
    // un-upgraded element when it defines it.
    toggle.options = viewOptions(toggle.hasAttribute('data-has-years'));
    toggle.value = VIEW_TOTAL;
    const section = toggle.closest<HTMLElement>('.firma2-project-measures');

    // THE GROUP'S ACCESSIBLE NAME. The lego names its radiogroup from its
    // VISIBLE label and offers no hidden-label prop, and a visible label here
    // would be the ornamental micro-label the house rules ban — so the name is
    // written onto the group directly. Reaching into a lego's shadow root is
    // this spoke's established seam (src/lib/side-dialog-fix.ts adopts a
    // stylesheet into one); optional chaining means a renamed internal costs
    // the name, never a thrown error. Worth a /request-lego for a real
    // `label-hidden` prop.
    customElements.whenDefined('esa-button-toggle').then(() => {
      requestAnimationFrame(() => {
        toggle.shadowRoot?.querySelector('[role="radiogroup"]')
          ?.setAttribute('aria-label', VIEW_GROUP_NAME);
      });
    });

    toggle.addEventListener('change', () => {
      if (section) section.dataset.view = String(toggle.value ?? VIEW_TOTAL);
      section?.dispatchEvent(new CustomEvent('firma2:pm-view'));
      const years = toggle.value === VIEW_YEARS;
      scroller.dataset.firma2MeasureYears = years ? 'shown' : 'hidden';

      // OPEN ON THE MOST RECENT YEAR. The columns run oldest-to-newest because
      // that is how a time series reads, but a project that has run for
      // twenty-five years is 1,917px of table in a 661px column — opening at
      // the left edge shows 1999 and asks the reader to drag 1,250px to reach
      // the year they almost certainly came for. Chronological order, recent
      // end in view.
      //
      // No smooth scroll: this is not an animation the reader asked for, it is
      // the initial position of a thing that has only just appeared, and
      // animating it would draw the eye across twenty columns of numbers for
      // no reason.
      if (years) {
        syncStickyOffset(scroller);
        scroller.scrollLeft = scroller.scrollWidth;
      }
    });
  });

  // ---------------------------------------------------------------------------
  // THE REPORTING SURFACE. Two acts live here, both persisted browser-locally:
  //
  //   SET A TARGET — every PUBLISHED catalog measure is a row on every
  //   project (PM 2, reconciled 2026-10-09): the project's own seeded rows
  //   first, in their authored order, then the measures it has a target on,
  //   then the rest of the published catalog with no target yet. A target is
  //   one number for the project's life; setting it commits the project,
  //   clearing it is never refused, and the row stays. Draft and Retired
  //   measures appear only where a target or entries already exist.
  //
  //   RECORD AN ENTRY — every row carries a quiet Record affordance opening
  //   the entry sheet above: period, figure, the measure's own breakdown
  //   questions. Entries are layered over each row's base figures (the
  //   data-* attributes the row component publishes) by ONE painter, so the
  //   total, the ring and the year cells always agree.
  //
  // Aggregation is honest-for-a-prototype: a measure that sums adds entries
  // up; one that does not takes the latest entry, because entries here carry
  // no place to group by.
  //
  // EVERY TARGET AND ENTRY WRITE IS LOGGED (src/lib/measure-changes.ts) —
  // entries by the entry store itself, targets here, where the old value is
  // known. Nothing reads the log yet, as on the branch.
  // ---------------------------------------------------------------------------
  import '@esa/ecology/esa-side-dialog';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-combobox';
  import '@esa/ecology/esa-checkbox';
  import '@esa/ecology/esa-confirm-dialog';
  import '@esa/ecology/esa-button-toggle';
  import {
    askedBreakdowns,
    isSummable,
    liveOptions,
    measures as catalogSeeds,
    measureDisplayName,
    periodName,
  } from '../../data/firma2-performance-measures';
  import type { PerformanceMeasureDefinition } from '../../data/firma2-performance-measures';
  import { draftedSlugs, isLocalMeasureSlug, withDraft } from '../../lib/measure-draft';
  import {
    addProjectMeasure,
    readProjectMeasures,
    readTargetOverrides,
    removeProjectMeasure,
    setTargetOverride,
  } from '../../lib/project-measure-draft';
  import { addEntry, logEntry, readEntries, removeEntry } from '../../lib/entry-draft';
  import { logChange } from '../../lib/measure-changes';
  import { can } from '../../lib/workspace-permissions';
  import { fixSideDialog } from '../../lib/side-dialog-fix';

  type Control = HTMLElement & {
    value?: unknown;
    options?: unknown;
    helpText?: string;
    errorText?: string;
  };
  type Sheet = HTMLElement & { show: () => void; close: () => void; heading?: string };

  const fmtNum = (n: number): string => n.toLocaleString('en-US');

  /** The whole catalog as this browser sees it: seeds with drafts laid over,
   *  plus measures minted here. */
  const catalogAll = (): PerformanceMeasureDefinition[] => [
    ...catalogSeeds.map((m) => withDraft(m.slug)),
    ...draftedSlugs()
      .filter(isLocalMeasureSlug)
      .map((slug) => withDraft(slug)),
  ];


  /** Resolve a row's measure key back to its catalog record, if it has one.
   *  Seed rows key by name — the seam where a real backend keys by id. */
  const catalogFor = (key: string): PerformanceMeasureDefinition | null =>
    key.startsWith('name:')
      ? catalogAll().find(
          (m) => measureDisplayName(m).toLowerCase() === key.slice(5).toLowerCase(),
        ) ?? null
      : catalogAll().find((m) => m.slug === key) ?? null;

  /** Whether a row's entries add up. A row with no catalog record is a count. */
  const sumsFor = (key: string): boolean => {
    const cat = catalogFor(key);
    return cat ? isSummable(cat) : true;
  };

  /** The questions a new entry asks: the measure's live breakdowns, by question. */
  const questionsOf = (cat: PerformanceMeasureDefinition | null): { name: string; options: string[] }[] =>
    (cat ? askedBreakdowns(cat) : []).map((b) => ({ name: b.question, options: liveOptions(b) }));

  document.querySelectorAll<HTMLElement>('.firma2-project-measures').forEach((root) => {
    const body = root.querySelector<HTMLElement>('[data-firma2-pm-section]');
    const slug = body?.dataset.projectSlug ?? '';
    const tbody = root.querySelector<HTMLElement>('.firma2-project-measures__table tbody');
    const recordTemplate = root.querySelector<HTMLElement>('[data-firma2-pm-record-template]');
    const removeTemplate = root.querySelector<HTMLElement>('[data-firma2-pm-remove-template]');
    const setTargetTemplate = root.querySelector<HTMLElement>('[data-firma2-pm-set-target-template]');
    // WHO MAY COMMIT THE PROJECT: Security's "Set project targets" threshold
    // (administrators by default). Without it, targets read but never edit.
    const canSetTargets = can('perm-targets');
    root.toggleAttribute('data-targets-locked', !canSetTargets);
    const sheet = root.querySelector<Sheet>('.firma2-project-measures__entry-sheet');
    if (!body || !slug || !tbody || !sheet) return;
    void fixSideDialog(sheet);

    // The clone source, captured before any injection so it is always a seed.
    const seedRow =
      tbody.querySelector('tr') ??
      root.querySelector<HTMLTemplateElement>('[data-pm-seed-template]')?.content.querySelector('tr') ??
      null;
    if (!seedRow) return;

    const realRows = (): HTMLElement[] =>
      [...tbody.querySelectorAll<HTMLElement>('tr:not([data-breakdown-of])')];

    const nameOf = (tr: HTMLElement): string =>
      (
        tr.querySelector('.firma2-project-measure-row__name')?.textContent ??
        tr.querySelector('th')?.textContent ??
        ''
      ).trim();

    const rowKey = (tr: HTMLElement): string =>
      tr.dataset.addedMeasure ?? `name:${nameOf(tr)}`;

    const rowNames = (): string[] => realRows().map((tr) => nameOf(tr).toLowerCase());

    /** The table's year axis, read off its own header (the cells show period names). */
    const axisYears = (): number[] =>
      [...root.querySelectorAll<HTMLElement>('thead .firma2-project-measures__year')]
        .map((th) => Number(th.dataset.year))
        .filter((y) => Number.isFinite(y));

    // ---- the one painter --------------------------------------------------
    const DASH = '<span aria-hidden="true">\u2014</span><span class="visually-hidden">Not reported</span>';

    const paintRow = (tr: HTMLElement) => {
      const key = rowKey(tr);
      const entries = readEntries(slug).filter((e) => e.measureKey === key);
      const total = tr.querySelector<HTMLElement>('.firma2-project-measure-row__total');
      if (!total) return;
      const baseReported = Number(total.dataset.reported || 0);
      // The GOAL is the built value unless this browser edited it — added
      // rows carry edits on their own record, so their data-expected is
      // already current; seed rows read the override store.
      const expected = readTargetOverrides(slug)[key] ?? Number(total.dataset.expected || 0);
      const unit = total.dataset.unit ?? '';
      const summing = sumsFor(key);
      // COMMITTED: a target, or anything reported. The rest fold away.
      tr.toggleAttribute('data-uncommitted', !(expected > 0 || baseReported > 0 || entries.length > 0));
      // RETIRED IN THE CATALOG (user, 2026-10-09): the row keeps its figures
      // and target, says so, and takes nothing new — no Record, no target,
      // and it leaves the report, Record work and the due count.
      const retiredMeasure = catalogFor(key)?.status === 'Retired';
      tr.toggleAttribute('data-retired-measure', retiredMeasure);
      const nameCell = tr.querySelector<HTMLElement>('.firma2-project-measure-row__name');
      let tag = tr.querySelector<HTMLElement>('.firma2-project-measures__retired-tag');
      if (retiredMeasure && !tag && nameCell) {
        tag = document.createElement('span');
        tag.className = 'firma2-project-measures__retired-tag typography-body-sm';
        tag.textContent = 'Retired';
        nameCell.after(tag);
      }
      if (tag) tag.hidden = !retiredMeasure;

      const reported = summing
        ? baseReported + entries.reduce((sum, e) => sum + e.amount, 0)
        : entries.length > 0
          ? entries[entries.length - 1].amount
          : baseReported;
      // A published measure the project has set no target on: "of 0" would
      // read as a target of zero, so it says so instead, with a Set target
      // button while editing. A measure whose values do not add up has no
      // total and no "X of Y" (PM 2's "Not a total"): it shows its latest
      // reading, and the target beside it rather than under it.
      const hasReading = entries.length > 0 || baseReported > 0;
      const reading = summing
        ? hasReading ? `${fmtNum(reported)} ${unit}`.trim() : ''
        : hasReading ? `Latest ${fmtNum(reported)} ${unit}`.trim() : 'No reading yet';
      if (expected > 0) {
        total.textContent = summing
          ? `${fmtNum(reported)} of ${fmtNum(expected)} ${unit}`.trim()
          : `${reading} · target ${fmtNum(expected)} ${unit}`.trim();
      } else {
        // No target: the reading (if any), then "No target" while the record
        // is read, or the Set target button while it is edited — never both,
        // so the Progress column stays the width of a figure.
        total.replaceChildren();
        if (reading) total.append(reading);
        const none = document.createElement('span');
        none.className = 'firma2-project-measures__no-target';
        none.textContent = reading ? ' · No target' : 'No target';
        total.append(none);
        const set = canSetTargets && !retiredMeasure ? (setTargetTemplate?.firstElementChild?.cloneNode(true) as HTMLElement | null) : null;
        if (set) {
          set.classList.add('firma2-project-measures__set-target');
          set.dataset.editOnly = '';
          set.querySelector('button')?.setAttribute('aria-label', `Set a target for ${nameOf(tr)}`);
          total.append(set);
        }
      }
      tr.toggleAttribute('data-no-target', !(expected > 0));
      // Clear target is offered only where there is a target to clear.
      const clear = tr.querySelector<HTMLElement>('.firma2-project-measures__remove');
      if (clear) clear.style.display = expected > 0 ? '' : 'none';

      // The ring follows — same never-reads-full-until-it-is rule the row
      // component states: the fraction is clamped, not rounded up.
      const fill = tr.querySelector<SVGElement>('.bcn-progress-ring__fill');
      const dash = Number(fill?.getAttribute('stroke-dasharray'));
      if (fill && Number.isFinite(dash) && expected > 0) {
        // No ring progress for a reading: a latest value is not part of a total.
        const p = summing ? Math.min(1, Math.max(0, reported / expected)) : 0;
        fill.setAttribute('stroke-dashoffset', String(dash * (1 - p)));
      }

      tr.querySelectorAll<HTMLElement>('.firma2-project-measure-row__year').forEach((td) => {
        const year = Number(td.dataset.year);
        const inYear = entries.filter((e) => e.year === year);
        const base = td.dataset.value === '' || td.dataset.value === undefined ? null : Number(td.dataset.value);
        let value: number | null;
        if (summing) {
          const extra = inYear.reduce((sum, e) => sum + e.amount, 0);
          value = base === null && inYear.length === 0 ? null : (base ?? 0) + extra;
        } else {
          value = inYear.length > 0 ? inYear[inYear.length - 1].amount : base;
        }
        if (value === null) {
          td.classList.add('firma2-project-measure-row__year--none');
          td.innerHTML = DASH;
        } else {
          td.classList.remove('firma2-project-measure-row__year--none');
          td.textContent = fmtNum(value);
        }
      });
    };

    /** The rows this project has committed to and can still report — what the report, Record work and the due line ask about. */
    const committedRows = (): HTMLElement[] =>
      realRows().filter((tr) => !tr.hasAttribute('data-uncommitted') && !tr.hasAttribute('data-retired-measure'));

    // The fold over uncommitted measures: one line, offered only to someone
    // who may set targets (data-edit-only hides it while the record is read).
    const othersBox = root.querySelector<HTMLElement>('[data-pm-others]');
    const paintOthers = () => {
      const n = realRows().filter((tr) => tr.hasAttribute('data-uncommitted')).length;
      if (othersBox) othersBox.hidden = !canSetTargets || n === 0;
      const label = othersBox?.querySelector<HTMLElement>('.esa-button__label');
      if (label) {
        label.textContent = root.hasAttribute('data-show-others')
          ? 'Hide other measures'
          : `Show ${n} other ${n === 1 ? 'measure' : 'measures'} you can commit to`;
      }
    };
    othersBox?.querySelector('button')?.addEventListener('click', () => {
      root.toggleAttribute('data-show-others');
      paintOthers();
    });

    const paintAllRows = () => {
      realRows().forEach(paintRow);
      paintOthers();
      paintBreakdowns();
      syncEmpty();
      paintReport();
    };

    // ---- nothing asked yet (team 6) ---------------------------------------
    const syncEmpty = () => {
      const empty = realRows().length === 0;
      root.toggleAttribute('data-empty', empty);
      const box = root.querySelector<HTMLElement>('[data-pm-empty]');
      if (box) box.hidden = !empty;
      root
        .querySelectorAll<HTMLElement>('[data-firma2-pm-record-work], [data-open-report-import], [data-firma2-measure-view]')
        .forEach((el) => {
          const host = (el.closest('.esa-button') as HTMLElement | null) ?? el;
          host.style.display = empty ? 'none' : '';
        });
    };

    // ---- report: one period, in place (team 6) ----------------------------
    // ONE SHAPE FOR ENTERING AND CORRECTING. Each block is one combination of
    // a measure's earlier questions, its last question answered with as many
    // options as apply, and an amount against each. A block holding figures
    // already filed looks exactly like the blank one at the foot — its amounts
    // are simply already in it. Amounts commit on leaving the field; clearing
    // one removes the entry, because "we did not work there after all" has to
    // be sayable, and a 0 would claim the work happened and achieved nothing.
    const PRESENT = 2026;
    const periodToggle = root.querySelector<Control>('[data-pm-period]');
    const reportList = root.querySelector<HTMLElement>('[data-pm-report-list]');
    const progressLine = root.querySelector<HTMLElement>('[data-pm-progress]');
    const binDialog = root.querySelector<Control & { show: () => void; message?: string }>('.firma2-project-measures__bin');
    const binTemplate = root.querySelector<HTMLElement>('[data-pm-bin-template]');
    const clearTemplate = root.querySelector<HTMLElement>('[data-pm-clear-template]');

    const reportPeriods = (): number[] => [...new Set([...axisYears(), PRESENT])].sort((a, b) => a - b).slice(-5);
    let period = PRESENT;
    type Blank = { fixed: Record<string, string>; picks: string[] };
    const blanks = new Map<string, Blank>();
    const extraPicks = new Map<string, string[]>();
    let pendingBin: (() => void) | null = null;

    const baseValue = (tr: HTMLElement, year: number): number | null => {
      const td = tr.querySelector<HTMLElement>(`.firma2-project-measure-row__year[data-year="${year}"]`);
      return td && td.dataset.value !== undefined && td.dataset.value !== '' ? Number(td.dataset.value) : null;
    };

    const entriesFor = (key: string, year: number) => readEntries(slug).filter((e) => e.measureKey === key && e.year === year);

    const matches = (e: { answers: Record<string, string> }, fixed: Record<string, string>, pivot: string | null, option?: string) =>
      Object.entries(fixed).every(([k, v]) => (e.answers[k] ?? '') === v) && (pivot === null || option === undefined || (e.answers[pivot] ?? '') === option);

    /**
     * Replace whatever this block holds for one option with one figure (or
     * none). One act, so one change-log row: filed, corrected or cleared.
     */
    const setAmount = (key: string, fixed: Record<string, string>, pivot: string | null, option: string, amount: number | null) => {
      const old = entriesFor(key, period).filter((e) => matches(e, fixed, pivot, pivot === null ? undefined : option));
      old.forEach((e) => removeEntry(slug, e.id, { log: false }));
      const next = amount !== null && amount > 0 ? amount : null;
      if (next !== null) {
        addEntry(slug, { measureKey: key, year: period, amount: next, answers: pivot === null ? { ...fixed } : { ...fixed, [pivot]: option } }, { log: false });
      }
      logEntry(slug, { measureKey: key, year: period }, old.length ? old.reduce((t, e) => t + e.amount, 0) : null, next);
    };

    const field = (label: string, value: string, unit: string, fk: string) => {
      const f = document.createElement('esa-text-field') as Control;
      f.setAttribute('label', unit ? `${label} (${unit})` : label);
      f.setAttribute('size', 'sm');
      f.setAttribute('inputmode', 'decimal');
      f.dataset.fk = fk;
      f.value = value;
      return f;
    };

    const select = (label: string, options: string[], value: string | string[], fk: string, multiple = false) => {
      const el = document.createElement('esa-select') as Control & { multiple?: boolean; disabled?: boolean };
      el.setAttribute('label', label);
      el.setAttribute('size', 'sm');
      el.setAttribute('placeholder', 'Choose…');
      el.dataset.fk = fk;
      if (multiple) el.multiple = true;
      el.options = options.map((o) => ({ label: o, value: o }));
      el.value = value;
      return el;
    };

    /** Commit an amount when its field is left (or Enter), then repaint. */
    const onCommit = (f: Control, commit: (amount: number | null) => void) => {
      const go = () => {
        const raw = String(f.value ?? '').replace(/,/g, '').trim();
        const n = raw === '' ? null : Number(raw);
        if (n !== null && (!Number.isFinite(n) || n < 0)) {
          f.errorText = 'A figure of zero or more.';
          return;
        }
        commit(n);
        paintAllRows();
      };
      f.addEventListener('focusout', go);
      f.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter') (e.target as HTMLElement).blur();
      });
    };

    // ---- what is due ------------------------------------------------------
    const dueBox = root.querySelector<HTMLElement>('[data-pm-due]');
    const dueText = root.querySelector<HTMLElement>('[data-pm-due-text]');
    const dueButton = root.querySelector<HTMLElement>('[data-pm-due-report]');
    let duePeriod: number | null = null;
    const paintDue = () => {
      if (!dueBox || !dueText) return;
      const rows = committedRows();
      const closed = axisYears().filter((y) => y < PRESENT);
      duePeriod = closed.length ? closed[closed.length - 1] : null;
      dueBox.hidden = rows.length === 0 || duePeriod === null;
      if (dueBox.hidden || duePeriod === null) return;
      const y = duePeriod;
      const missing = rows.filter((tr) => baseValue(tr, y) === null && entriesFor(rowKey(tr), y).length === 0);
      const n = rows.length;
      const names = missing.map(nameOf);
      const list = names.length > 3 ? `${names.slice(0, 2).join(', ')} and ${names.length - 2} more` : names.join(', ').replace(/, ([^,]*)$/, ' and $1');
      dueText.textContent =
        missing.length === 0
          ? `${periodName(y)}: all ${n} ${n === 1 ? 'measure' : 'measures'} reported.`
          : `${periodName(y)}: ${n - missing.length} of ${n} ${n === 1 ? 'measure' : 'measures'} reported. Missing: ${list}.`;
      const host = (dueButton?.closest('.esa-button') as HTMLElement | null) ?? dueButton;
      if (host) host.style.display = missing.length === 0 ? 'none' : '';
      const label = dueButton?.querySelector<HTMLElement>('.esa-button__label') ?? dueButton;
      if (label) label.textContent = `Report ${periodName(y)}`;
    };
    // The way in: the Report view, on the period that is due.
    dueButton?.addEventListener('click', () => {
      if (duePeriod === null) return;
      period = duePeriod;
      const view = root.querySelector<HTMLElement & { value?: string }>('[data-firma2-measure-view]');
      if (view) {
        view.value = 'report';
        view.dispatchEvent(new Event('change'));
      }
      paintReport();
      root.querySelector<HTMLElement>('[data-pm-report]')?.scrollIntoView({ block: 'start' });
    });

    const paintReport = () => {
      paintDue();
      if (!reportList || !periodToggle || !progressLine) return;
      const periods = reportPeriods();
      if (!periods.includes(period)) period = periods[periods.length - 1];
      periodToggle.options = periods.map((y) => ({ label: y === PRESENT ? `${periodName(y)} (now)` : periodName(y), value: String(y) }));
      periodToggle.value = String(period);
      if (root.dataset.view !== 'report') return;

      // Keep focus where the reader was going when a commit repaints.
      const focusKey = (document.activeElement as HTMLElement | null)?.closest<HTMLElement>('[data-fk]')?.dataset.fk;
      const rows = committedRows();
      let reportedCount = 0;

      reportList.replaceChildren(
        ...rows.map((tr) => {
          const key = rowKey(tr);
          const name = nameOf(tr);
          const cat = catalogFor(key);
          const unit = tr.querySelector<HTMLElement>('.firma2-project-measure-row__total')?.dataset.unit ?? cat?.unit ?? '';
          const questions = questionsOf(cat);
          const pivot = questions.length ? questions[questions.length - 1] : null;
          const fixedQs = questions.slice(0, -1);
          const entries = entriesFor(key, period);
          const base = baseValue(tr, period);
          const reported = base !== null || entries.length > 0;
          if (reported) reportedCount += 1;

          const sec = document.createElement('section');
          sec.className = 'firma2-project-measures__rm stack';
          sec.dataset.gap = 'sm';
          sec.innerHTML = `<div class="firma2-project-measures__rm-head"><h4 class="typography-label-lg"></h4>${reported ? '<span class="typography-label-sm firma2-project-measures__rm-done">Reported</span>' : ''}</div>`;
          sec.querySelector('h4')!.textContent = name;
          const meta = (text: string) => {
            const p = document.createElement('p');
            p.className = 'typography-body-sm firma2-project-measures__rm-meta';
            p.textContent = text;
            sec.append(p);
          };
          if (cat?.reporterGuidance?.trim()) meta(cat.reporterGuidance.trim());
          // LAST PERIOD, as a hint and never pre-filled: the system remembers,
          // the person still commits.
          const prevYear = periods.filter((y) => y < period).pop();
          if (prevYear !== undefined) {
            const prevBase = baseValue(tr, prevYear);
            const prevEntries = entriesFor(key, prevYear).reduce((t, e) => t + e.amount, 0);
            const prev = (prevBase ?? 0) + prevEntries;
            if (prevBase !== null || prevEntries) meta(`Last period (${periodName(prevYear)}): ${fmtNum(prev)} ${unit}`.trim());
          }
          if (base !== null) meta(`Filed for ${periodName(period)}: ${fmtNum(base)} ${unit}${questions.length ? ', without a breakdown' : ''}. Amounts below are added to it.`);

          // ---- the blocks ----
          const blocks: HTMLElement[] = [];
          const blockFor = (opts: { fixed: Record<string, string>; picks: string[]; amounts: Record<string, string>; filed: boolean; gk: string }) => {
            const b = document.createElement('div');
            b.className = `firma2-project-measures__block${opts.filed ? '' : ' firma2-project-measures__block--blank'}`;
            const row = document.createElement('div');
            row.className = 'firma2-project-measures__block-row';
            const fixedDone = fixedQs.every((q) => opts.fixed[q.name]);
            fixedQs.forEach((q) => {
              const el = select(q.name, q.options, opts.fixed[q.name] ?? '', `${key}|${opts.gk}|q|${q.name}`);
              el.addEventListener('change', () => {
                const next = { ...opts.fixed, [q.name]: String(el.value ?? '') };
                if (opts.filed) {
                  // Re-key every figure in the block to the new answer. The
                  // amounts do not change, so the change log has nothing to say.
                  entries.filter((e) => matches(e, opts.fixed, null)).forEach((e) => {
                    removeEntry(slug, e.id, { log: false });
                    addEntry(slug, { measureKey: key, year: period, amount: e.amount, answers: { ...e.answers, [q.name]: next[q.name] } }, { log: false });
                  });
                  paintAllRows();
                } else {
                  blanks.set(key, { ...(blanks.get(key) ?? { fixed: {}, picks: [] }), fixed: next });
                  paintReport();
                }
              });
              row.append(el);
            });
            if (pivot) {
              const el = select(pivot.name, pivot.options, opts.picks, `${key}|${opts.gk}|pivot`, true) as Control & { disabled?: boolean };
              if (!fixedDone) {
                el.disabled = true;
                el.setAttribute('placeholder', 'Answer the first question');
              }
              el.addEventListener('change', () => {
                const picks = Array.isArray(el.value) ? (el.value as string[]) : [];
                if (opts.filed) {
                  // An option taken out takes its figure with it.
                  opts.picks.filter((o) => !picks.includes(o)).forEach((o) => setAmount(key, opts.fixed, pivot.name, o, null));
                  extraPicks.set(`${key}|${opts.gk}`, picks);
                  paintAllRows();
                } else {
                  blanks.set(key, { fixed: opts.fixed, picks });
                  paintReport();
                }
              });
              row.append(el);
            }
            if (row.childElementCount) b.append(row);

            const amounts = document.createElement('div');
            amounts.className = 'firma2-project-measures__block-row';
            const targets = pivot ? opts.picks : [''];
            targets.forEach((option) => {
              const f = field(pivot ? option : base !== null ? 'Add an amount' : 'Amount', opts.amounts[option] ?? '', unit, `${key}|${opts.gk}|a|${option}`);
              onCommit(f, (amount) => {
                if (fixedQs.length && !fixedDone) return;
                setAmount(key, opts.fixed, pivot?.name ?? null, option, amount);
                if (!opts.filed) {
                  const gk = JSON.stringify(opts.fixed);
                  extraPicks.set(`${key}|${gk}`, opts.picks);
                  blanks.delete(key);
                }
              });
              amounts.append(f);
            });
            if (amounts.childElementCount) b.append(amounts);

            // TWO CORNER CONTROLS, deliberately different: a filed block gets a
            // bin (deletes figures, after saying how many); the blank block a
            // cross once touched (discards choices, never data).
            const corner = document.createElement('div');
            corner.className = 'firma2-project-measures__block-corner';
            if (opts.filed) {
              const bin = cloneButton(binTemplate, 'firma2-project-measures__bin-btn', `Remove these ${name} figures`);
              bin?.addEventListener('click', () => {
                const doomed = entries.filter((e) => matches(e, opts.fixed, null));
                pendingBin = () => doomed.forEach((e) => removeEntry(slug, e.id));
                if (binDialog) {
                  binDialog.message = `${doomed.length === 1 ? 'This figure is' : `These ${doomed.length} figures are`} deleted from ${periodName(period)}. The measure stays on the project.`;
                  binDialog.show();
                }
              });
              if (bin) corner.append(bin);
            } else if (Object.keys(opts.fixed).length || opts.picks.length) {
              const clear = cloneButton(clearTemplate, 'firma2-project-measures__clear-btn', 'Clear this entry');
              clear?.addEventListener('click', () => {
                blanks.delete(key);
                paintReport();
              });
              if (clear) corner.append(clear);
            }
            if (corner.childElementCount) b.append(corner);
            return b;
          };

          if (!pivot && !fixedQs.length) {
            // No questions: one figure for the period.
            const sum = entries.reduce((t, e) => t + e.amount, 0);
            blocks.push(blockFor({ fixed: {}, picks: [], amounts: { '': sum ? String(sum) : '' }, filed: false, gk: 'single' }));
          } else {
            const groups = new Map<string, { fixed: Record<string, string>; amounts: Record<string, number> }>();
            entries.forEach((e) => {
              const fixed = Object.fromEntries(fixedQs.map((q) => [q.name, e.answers[q.name] ?? '']));
              const gk = JSON.stringify(fixed);
              const g = groups.get(gk) ?? { fixed, amounts: {} };
              const option = pivot ? e.answers[pivot.name] ?? '' : '';
              g.amounts[option] = (g.amounts[option] ?? 0) + e.amount;
              groups.set(gk, g);
            });
            groups.forEach((g, gk) => {
              const filedPicks = Object.keys(g.amounts);
              const picks = [...new Set([...filedPicks, ...(extraPicks.get(`${key}|${gk}`) ?? [])])];
              blocks.push(
                blockFor({
                  fixed: g.fixed,
                  picks,
                  amounts: Object.fromEntries(Object.entries(g.amounts).map(([o, n]) => [o, String(n)])),
                  filed: true,
                  gk,
                }),
              );
            });
            const blank = blanks.get(key) ?? { fixed: {}, picks: [] };
            blocks.push(blockFor({ fixed: blank.fixed, picks: blank.picks, amounts: {}, filed: false, gk: 'blank' }));
          }
          sec.append(...blocks);
          return sec;
        }),
      );
      progressLine.textContent = `${reportedCount} of ${rows.length} ${rows.length === 1 ? 'measure' : 'measures'} reported for ${periodName(period)}`;

      if (focusKey) {
        const target = reportList.querySelector<HTMLElement>(`[data-fk="${CSS.escape(focusKey)}"]`);
        requestAnimationFrame(() => (target?.shadowRoot?.querySelector<HTMLElement>('input, button') ?? target)?.focus());
      }
    };

    periodToggle?.addEventListener('change', () => {
      period = Number(periodToggle.value ?? PRESENT);
      blanks.clear();
      paintReport();
    });
    root.addEventListener('firma2:pm-view', () => paintReport());
    binDialog?.addEventListener('resolved', (e) => {
      if ((e as CustomEvent<{ confirmed: boolean }>).detail.confirmed) pendingBin?.();
      pendingBin = null;
      paintAllRows();
    });

    // ---- how a measure divides (team 6) -------------------------------------
    // A measure's figure is the sum of answers to its questions; opening it
    // shows the split by its first answered question, period by period. Only
    // entries carry answers — the seeded history is a single figure — so the
    // control appears once something has been recorded with an answer.
    const divideTemplate = root.querySelector<HTMLElement>('[data-firma2-pm-divide-template]');
    const openBreakdowns = new Set<string>();

    const splitOf = (key: string) => {
      const entries = readEntries(slug).filter((e) => e.measureKey === key && Object.keys(e.answers).length);
      if (!entries.length) return null;
      const order = questionsOf(catalogFor(key)).map((q) => q.name);
      const answered = [...new Set(entries.flatMap((e) => Object.keys(e.answers)))];
      const schema = order.find((n) => answered.includes(n)) ?? answered[0];
      const options = [...new Set(entries.map((e) => e.answers[schema]).filter(Boolean))];
      return { schema, options, entries: entries.filter((e) => e.answers[schema]) };
    };

    const paintBreakdowns = () => {
      tbody.querySelectorAll('tr[data-breakdown-of]').forEach((tr) => tr.remove());
      realRows().forEach((tr) => {
        const key = rowKey(tr);
        const split = splitOf(key);
        const dock = tr.querySelector('.firma2-project-measure-row__measure-inner') ?? tr.querySelector('th');
        let toggle = tr.querySelector<HTMLElement>('.firma2-project-measures__divide');
        if (!split) {
          toggle?.remove();
          openBreakdowns.delete(key);
          return;
        }
        if (!toggle && dock) {
          toggle = cloneButton(divideTemplate, 'firma2-project-measures__divide', `Show how ${nameOf(tr)} divides`);
          if (toggle) dock.append(toggle);
        }
        const open = openBreakdowns.has(key);
        toggle?.setAttribute('aria-expanded', String(open));
        toggle?.querySelector('button')?.setAttribute('aria-expanded', String(open));
        if (!open) return;
        const unit = tr.querySelector<HTMLElement>('.firma2-project-measure-row__total')?.dataset.unit ?? '';
        const summing = sumsFor(key);
        let after: Element = tr;
        split.options.forEach((option) => {
          const mine = split.entries.filter((e) => e.answers[split.schema] === option);
          const row = tr.cloneNode(true) as HTMLElement;
          row.dataset.breakdownOf = key;
          delete row.dataset.addedMeasure;
          delete row.dataset.kpi;
          row.querySelectorAll('.bcn-progress-ring, .firma2-project-measures__record, .firma2-project-measures__remove, .firma2-project-measures__divide').forEach((el) => el.remove());
          const name = row.querySelector<HTMLElement>('.firma2-project-measure-row__name');
          if (name) {
            name.textContent = option;
            name.setAttribute('title', `${split.schema}: ${option}`);
          }
          const figure = (list: typeof mine) => (summing ? list.reduce((t, e) => t + e.amount, 0) : list[list.length - 1]?.amount ?? 0);
          const total = row.querySelector<HTMLElement>('.firma2-project-measure-row__total');
          if (total) total.textContent = `${fmtNum(figure(mine))} ${unit}`.trim();
          row.querySelectorAll<HTMLElement>('.firma2-project-measure-row__year').forEach((td) => {
            const inYear = mine.filter((e) => e.year === Number(td.dataset.year));
            if (inYear.length) {
              td.classList.remove('firma2-project-measure-row__year--none');
              td.textContent = fmtNum(figure(inYear));
            } else {
              td.classList.add('firma2-project-measure-row__year--none');
              td.innerHTML = DASH;
            }
          });
          after.after(row);
          after = row;
        });
      });
    };

    // ---- row affordances --------------------------------------------------
    const cloneButton = (
      template: HTMLElement | null,
      cls: string,
      aria: string,
    ): HTMLElement | null => {
      const el = template?.firstElementChild?.cloneNode(true) as HTMLElement | null;
      if (!el) return null;
      el.classList.add(cls);
      el.querySelector('button')?.setAttribute('aria-label', aria);
      return el;
    };

    const ensureRowControls = () => {
      realRows().forEach((tr) => {
        const dock = tr.querySelector('.firma2-project-measure-row__measure-inner') ?? tr.querySelector('th');
        if (!dock) return;
        if (!tr.querySelector('.firma2-project-measures__record')) {
          const record = cloneButton(
            recordTemplate,
            'firma2-project-measures__record',
            `Record an entry for ${nameOf(tr)}`,
          );
          if (record) dock.append(record);
        }
        // Every row can carry a target, so every row can clear one; the
        // painter hides the control where there is none.
        if (!tr.querySelector('.firma2-project-measures__remove')) {
          const remove = cloneButton(
            removeTemplate,
            'firma2-project-measures__remove',
            `Clear the target for ${nameOf(tr)}`,
          );
          // Hidden while the record is read (firma2-record-mode).
          if (remove) {
            remove.dataset.editOnly = '';
            dock.append(remove);
          }
        }
      });
    };

    // ---- catalog rows: targets, and every published measure ------------------
    // Seeded rows are built data and stay first, in their authored order.
    // After them: the catalog measures this project has a TARGET on, in the
    // order the targets were set; then every other PUBLISHED measure, with no
    // target yet. A Draft or Retired measure shows only where a target or
    // entries already exist — what was committed or filed is never hidden.
    // A catalog measure a seeded row already reports toward (its data-kpi, or
    // the same name) is not offered a second time.
    const paintAdded = () => {
      tbody.querySelectorAll('[data-added-measure]').forEach((tr) => tr.remove());
      const takenNames = new Set(rowNames());
      const takenSlugs = new Set(realRows().map((tr) => tr.dataset.kpi).filter(Boolean) as string[]);
      const filed = new Set(readEntries(slug).map((e) => e.measureKey));

      const addRow = (m: PerformanceMeasureDefinition, target: number) => {
        const name = measureDisplayName(m);
        if (takenSlugs.has(m.slug) || takenNames.has(name.toLowerCase())) return;
        takenSlugs.add(m.slug);
        takenNames.add(name.toLowerCase());
        const tr = seedRow.cloneNode(true) as HTMLElement;
        tr.dataset.addedMeasure = m.slug;
        delete tr.dataset.kpi;

        const nameSpan = tr.querySelector<HTMLElement>('.firma2-project-measure-row__name');
        if (nameSpan) {
          nameSpan.textContent = name;
          nameSpan.setAttribute('title', name);
        }
        // Cloned affordances belong to the seed row it came from — rebuilt
        // for this row by ensureRowControls with this row's own name.
        tr.querySelectorAll('.firma2-project-measures__record, .firma2-project-measures__remove').forEach((b) => b.remove());

        const total = tr.querySelector<HTMLElement>('.firma2-project-measure-row__total');
        if (total) {
          total.dataset.reported = '0';
          total.dataset.expected = String(target);
          total.dataset.unit = m.unit ?? '';
        }
        tr.querySelectorAll<HTMLElement>('.firma2-project-measure-row__year').forEach((td) => {
          td.dataset.value = '';
        });
        tbody.append(tr);
      };

      for (const entry of readProjectMeasures(slug).filter((e) => e.target > 0)) {
        addRow(withDraft(entry.measureSlug), entry.target);
      }
      for (const m of catalogAll()) {
        if (m.status === 'Published' || filed.has(m.slug)) addRow(m, 0);
      }
      ensureRowControls();
      paintAllRows();
    };

    // ---- setting and clearing a target ------------------------------------
    /**
     * The one write path for a target, so every set, change and clear is
     * logged once with its old value. A catalog row keeps its target on its
     * own record (removing the record IS clearing it — the row stays while
     * the measure is published); a seeded row's edit is a browser-local
     * override, and editing it back to the built value clears the override.
     */
    const writeTarget = (tr: HTMLElement, next: number | null) => {
      const key = rowKey(tr);
      const td = tr.querySelector<HTMLElement>('.firma2-project-measure-row__total');
      const built = Number(td?.dataset.expected || 0);
      const before = tr.dataset.addedMeasure ? built : readTargetOverrides(slug)[key] ?? built;
      if (tr.dataset.addedMeasure) {
        if (next !== null && next > 0) {
          addProjectMeasure(slug, { measureSlug: tr.dataset.addedMeasure, target: next });
          if (td) td.dataset.expected = String(next);
        } else {
          removeProjectMeasure(slug, tr.dataset.addedMeasure);
          if (td) td.dataset.expected = '0';
        }
      } else {
        const value = next !== null && next > 0 ? next : 0;
        setTargetOverride(slug, key, value === built ? null : value);
      }
      logChange({
        projectSlug: slug,
        measureSlug: key,
        periodName: null,
        field: 'TargetValue',
        oldValue: before > 0 ? before : null,
        newValue: next !== null && next > 0 ? next : null,
      });
    };

    // Clear target — never refused, and the row stays.
    tbody.addEventListener('click', (event) => {
      const btn = (event.target as Element).closest('.firma2-project-measures__remove');
      const tr = btn?.closest<HTMLElement>('tr');
      if (!tr || tr.dataset.breakdownOf !== undefined) return;
      writeTarget(tr, null);
      paintAllRows(); // the due line and the fold count targets too
    });

    // ---- editing the GOAL where it lays -----------------------------------
    // Double-click the Progress cell (the catalog grid's own edit convention)
    // and the target becomes a field in place, in the same cell the number
    // lives in. Enter/blur commits, Escape restores, and an emptied field (or
    // 0) clears the target through writeTarget.
    const editTarget = (td: HTMLElement) => {
      const tr = td.closest<HTMLElement>('tr');
      if (!tr || tr.dataset.breakdownOf !== undefined || tr.hasAttribute('data-retired-measure') || td.querySelector('esa-text-field')) return;
      const key = rowKey(tr);
      const unit = td.dataset.unit ?? '';
      const current = readTargetOverrides(slug)[key] ?? Number(td.dataset.expected || 0);

      const field = document.createElement('esa-text-field') as Control;
      field.setAttribute('label', 'Target');
      field.setAttribute('size', 'md');
      field.setAttribute('inputmode', 'decimal');
      if (unit) field.setAttribute('suffix', unit);
      field.value = current > 0 ? String(current) : '';
      td.replaceChildren(field);

      let closed = false;
      const finish = (commit: boolean) => {
        if (closed) return;
        closed = true;
        if (commit) {
          const raw = String(field.value ?? '').replace(/,/g, '').trim();
          const next = raw === '' ? null : Number(raw);
          if (next === null || (Number.isFinite(next) && next >= 0)) {
            if ((next ?? 0) !== (current > 0 ? current : 0)) writeTarget(tr, next);
          }
        }
        paintAllRows(); // the due line and the fold count targets too
      };

      field.addEventListener('keydown', (event) => {
        const k = (event as KeyboardEvent).key;
        if (k === 'Enter') {
          event.preventDefault();
          event.stopPropagation();
          finish(true);
        } else if (k === 'Escape') {
          event.preventDefault();
          event.stopPropagation();
          finish(false);
        }
      });
      field.addEventListener('focusout', () => finish(true));

      requestAnimationFrame(() => {
        const input = field.shadowRoot?.querySelector<HTMLInputElement>('input');
        input?.focus();
        input?.select();
      });
    };

    tbody.addEventListener('click', (event) => {
      const set = (event.target as Element).closest('.firma2-project-measures__set-target');
      const td = set?.closest<HTMLElement>('.firma2-project-measure-row__total');
      if (td) editTarget(td);
    });

    tbody.addEventListener('dblclick', (event) => {
      if (isViewMode() || !canSetTargets) return;
      const td = (event.target as Element).closest<HTMLElement>('.firma2-project-measure-row__total');
      if (td) editTarget(td);
    });

    // ---- the entry sheet --------------------------------------------------
    const lede = root.querySelector<HTMLElement>('[data-entry-lede]');
    const yearField = root.querySelector<Control>('[data-entry-year]');
    const amountField = root.querySelector<Control>('[data-entry-amount]');
    const questions = root.querySelector<HTMLElement>('[data-entry-questions]');
    const logBlock = root.querySelector<HTMLElement>('[data-entry-log-block]');
    const log = root.querySelector<HTMLElement>('[data-entry-log]');

    const activity = root.querySelector<Control>('[data-entry-activity]');
    const entryBody = root.querySelector<HTMLElement>('[data-entry-body]');

    let entryKey = '';
    let entryUnit = '';
    let activityMode = false;

    /**
     * THE COMBINED VOCABULARY this project can file work under: every
     * breakdown option of every measure on the project, disambiguated by
     * the measure it files into, plus the measure names themselves for the
     * reporter who does think in catalog terms. Alphabetical, so the list
     * reads the same way twice.
     */
    const activityOptions = (): { label: string; value: string }[] => {
      const opts: { label: string; value: string }[] = [];
      for (const tr of committedRows()) {
        const key = rowKey(tr);
        const name = nameOf(tr);
        opts.push({ label: name, value: `m|${key}` });
        const cat = catalogFor(key);
        for (const q of questionsOf(cat)) {
          for (const option of q.options) {
            opts.push({ label: `${option} — ${name}`, value: `o|${key}|${q.name}|${option}` });
          }
        }
      }
      return opts.sort((a, b) => a.label.localeCompare(b.label));
    };

    const paintLog = () => {
      if (!log || !logBlock) return;
      const entries = readEntries(slug).filter((e) => e.measureKey === entryKey);
      logBlock.hidden = entries.length === 0;
      log.replaceChildren();
      for (const e of entries) {
        const li = document.createElement('li');
        li.className = 'firma2-project-measures__entry-row';
        li.dataset.entryId = e.id;
        const text = document.createElement('span');
        text.className = 'typography-body-sm';
        const answers = Object.values(e.answers).join(' \u00b7 ');
        text.textContent = `${periodName(e.year)} \u00b7 ${fmtNum(e.amount)} ${entryUnit}${answers ? ` \u00b7 ${answers}` : ''}`;
        li.append(text);
        const remove = cloneButton(
          removeTemplate,
          'firma2-project-measures__entry-remove',
          `Remove the ${periodName(e.year)} entry of ${fmtNum(e.amount)} ${entryUnit}`,
        );
        if (remove) li.append(remove);
        log.append(li);
      }
    };

    const openEntryFor = (tr: HTMLElement, prefill?: { schemaName: string; option: string }) => {
      if (!yearField || !amountField || !questions || !lede || !entryBody) return;
      entryKey = rowKey(tr);
      const catalog = catalogFor(entryKey);
      const total = tr.querySelector<HTMLElement>('.firma2-project-measure-row__total');
      entryUnit = total?.dataset.unit || catalog?.unit || '';

      sheet.heading = nameOf(tr);
      // The lede belongs to the activity-first opening move; once a measure
      // is resolved the sheet's heading names it, and nothing more is said.
      lede.hidden = true;
      entryBody.hidden = false;

      const years = axisYears();
      yearField.options = [...years].reverse().map((y) => ({ label: periodName(y), value: String(y) }));
      yearField.value = years.length > 0 ? String(years[years.length - 1]) : '';

      amountField.value = '';
      amountField.errorText = '';
      if (entryUnit) amountField.setAttribute('suffix', entryUnit);
      else amountField.removeAttribute('suffix');
      const guidance = catalog?.reporterGuidance?.trim() ?? '';
      if (guidance) amountField.setAttribute('help-text', guidance);
      else amountField.removeAttribute('help-text');

      // The measure's own questions — one optional dropdown per breakdown
      // still asked, retired options left out. An activity pick arrives with
      // its question ALREADY answered.
      questions.replaceChildren();
      for (const q of questionsOf(catalog)) {
        const select = document.createElement('esa-select') as Control;
        select.setAttribute('label', q.name);
        select.setAttribute('size', 'md');
        select.setAttribute('placeholder', 'Optional');
        select.setAttribute('data-entry-question', q.name);
        select.options = q.options.map((o) => ({ label: o, value: o }));
        if (prefill && prefill.schemaName === q.name) select.value = prefill.option;
        questions.append(select);
      }

      // LAST PERIOD, read off the row as painted — the seeded history and
      // this browser's entries, through the same painter the table uses.
      const previous = root.querySelector<HTMLElement>('[data-entry-previous]');
      if (previous) {
        const last = [...tr.querySelectorAll<HTMLElement>('.firma2-project-measure-row__year')]
          .reverse()
          .find((td) => !td.classList.contains('firma2-project-measure-row__year--none'));
        previous.hidden = !last;
        if (last) previous.textContent = `Last period, ${periodName(Number(last.dataset.year))}: ${last.textContent?.trim()} ${entryUnit}`.trim();
      }

      // The FIRST question may take several answers; picking two or more
      // swaps the one Amount for an amount per answer.
      const first = questions.querySelector<Control & { multiple?: boolean }>('[data-entry-question]');
      if (first) {
        first.multiple = true;
        first.setAttribute('help-text', 'Pick several to enter an amount for each.');
        if (prefill && prefill.schemaName === first.getAttribute('data-entry-question')) first.value = [prefill.option];
        first.addEventListener('change', paintSplit);
      }
      paintSplit();
      paintLog();
    };

    const splitBox = root.querySelector<HTMLElement>('[data-entry-split]');
    const splitPicks = (): { schema: string; options: string[] } | null => {
      const first = questions?.querySelector<Control>('[data-entry-question]');
      const picked = Array.isArray(first?.value) ? (first!.value as string[]).filter(Boolean) : [];
      return first && picked.length >= 2 ? { schema: first.getAttribute('data-entry-question') ?? '', options: picked } : null;
    };
    function paintSplit() {
      if (!splitBox || !amountField) return;
      const picks = splitPicks();
      splitBox.hidden = !picks;
      amountField.hidden = Boolean(picks);
      if (!picks) return splitBox.replaceChildren();
      // Keep what was already typed for an option that stays picked.
      const typed = new Map([...splitBox.querySelectorAll<Control>('[data-split-option]')].map((f) => [f.getAttribute('data-split-option') ?? '', String(f.value ?? '')]));
      splitBox.replaceChildren(
        ...picks.options.map((option) => {
          const field = document.createElement('esa-text-field') as Control;
          field.setAttribute('label', option);
          field.setAttribute('size', 'md');
          field.setAttribute('inputmode', 'decimal');
          field.setAttribute('data-split-option', option);
          if (entryUnit) field.setAttribute('suffix', entryUnit);
          field.value = typed.get(option) ?? '';
          return field;
        }),
      );
    }

    /** The per-row, measure-first path. */
    const openEntry = (tr: HTMLElement) => {
      activityMode = false;
      if (activity) activity.hidden = true;
      openEntryFor(tr);
      sheet.show();
    };

    /**
     * The section-level, ACTIVITY-FIRST path: the sheet opens on the one
     * question a reporter can always answer — what they did — and the rest
     * of the form appears once that answer has resolved the measure.
     */
    const openRecorder = () => {
      if (!activity || !entryBody || !lede) return;
      activityMode = true;
      entryKey = '';
      activity.hidden = false;
      activity.value = '';
      activity.options = activityOptions();
      entryBody.hidden = true;
      lede.hidden = false;
      lede.textContent = 'Say what you did — it files under the right measure.';
      sheet.heading = 'Record work';
      sheet.show();
      requestAnimationFrame(() => {
        (activity.shadowRoot?.querySelector<HTMLElement>('input') ?? activity).focus();
      });
    };

    activity?.addEventListener('change', () => {
      const raw = String(activity.value ?? '');
      if (!raw) return;
      const parts = raw.split('|');
      const key = parts[1];
      const tr = realRows().find((r) => rowKey(r) === key);
      if (!tr) return;
      openEntryFor(
        tr,
        parts[0] === 'o' ? { schemaName: parts[2], option: parts.slice(3).join('|') } : undefined,
      );
      requestAnimationFrame(() => {
        (amountField?.shadowRoot?.querySelector<HTMLElement>('input') ?? amountField)?.focus();
      });
    });

    root
      .querySelector('[data-firma2-pm-record-work]')
      ?.addEventListener('click', () => openRecorder());

    // THE DEEP LINK. The Projects index's peek sheet carries a "Record work"
    // primary that lands here as <project>#record-work — the recorder is this
    // section's, so arriving with intent opens it the same way the header
    // button does. The hash is cleared once honoured: reload should show the
    // page, not re-open a sheet the reader already dismissed.
    if (window.location.hash === '#record-work') {
      history.replaceState(null, '', window.location.pathname + window.location.search);
      requestAnimationFrame(() => openRecorder());
    }

    tbody.addEventListener('click', (event) => {
      const divide = (event.target as Element).closest('.firma2-project-measures__divide');
      const divideRow = divide?.closest<HTMLElement>('tr');
      if (divideRow) {
        const key = rowKey(divideRow);
        if (openBreakdowns.has(key)) openBreakdowns.delete(key);
        else openBreakdowns.add(key);
        paintBreakdowns();
        return;
      }
      const btn = (event.target as Element).closest('.firma2-project-measures__record');
      const tr = btn?.closest<HTMLElement>('tr');
      if (tr) openEntry(tr);
    });

    root.querySelector('[data-entry-done]')?.addEventListener('click', () => sheet.close());

    root.querySelector('[data-entry-save]')?.addEventListener('click', () => {
      if (!yearField || !amountField || !questions) return;
      const picks = splitPicks();
      if (picks && splitBox) {
        const year = Number(String(yearField.value ?? ''));
        const others: Record<string, string> = {};
        questions.querySelectorAll<Control>('[data-entry-question]').forEach((q, i) => {
          const v = String(q.value ?? '');
          const name = q.getAttribute('data-entry-question') ?? '';
          if (i > 0 && v && name) others[name] = v;
        });
        const fields = [...splitBox.querySelectorAll<Control>('[data-split-option]')];
        const filled = fields.map((f) => ({ f, amount: Number(String(f.value ?? '').replace(/,/g, '')) })).filter(({ amount }) => Number.isFinite(amount) && amount > 0);
        fields.forEach((f) => (f.errorText = ''));
        if (!filled.length) {
          if (fields[0]) fields[0].errorText = 'Enter a figure for at least one of these.';
          return;
        }
        filled.forEach(({ f, amount }) =>
          addEntry(slug, { measureKey: entryKey, year, amount, answers: { ...others, [picks.schema]: f.getAttribute('data-split-option') ?? '' } }),
        );
        paintLog();
        paintAllRows();
        fields.forEach((f) => (f.value = ''));
        return;
      }
      const amount = Number(String(amountField.value ?? '').replace(/,/g, ''));
      if (!Number.isFinite(amount) || amount <= 0) {
        amountField.errorText = 'Enter the figure for this period.';
        return;
      }
      amountField.errorText = '';
      const year = Number(String(yearField.value ?? ''));
      const answers: Record<string, string> = {};
      questions.querySelectorAll<Control>('[data-entry-question]').forEach((q) => {
        const v = String(q.value ?? '');
        const name = q.getAttribute('data-entry-question') ?? '';
        if (v && name) answers[name] = v;
      });
      addEntry(slug, { measureKey: entryKey, year, amount, answers });

      // Batch-friendly: the entry lands in the log and the table, the figure
      // clears for the next one, the period holds. On the activity path the
      // answers hold too — the picked activity IS the answer, and the next
      // load of the same work should not have to restate it.
      paintLog();
      paintAllRows();
      amountField.value = '';
      if (!activityMode) {
        questions.querySelectorAll<Control>('[data-entry-question]').forEach((q) => {
          q.value = Array.isArray(q.value) ? [] : '';
        });
      }
      amountField.focus();
    });

    log?.addEventListener('click', (event) => {
      const btn = (event.target as Element).closest('.firma2-project-measures__entry-remove');
      const li = btn?.closest<HTMLElement>('[data-entry-id]');
      if (!li?.dataset.entryId) return;
      removeEntry(slug, li.dataset.entryId);
      paintLog();
      paintAllRows();
    });

    // Entries filed from elsewhere — the report import — land in the same
    // store; repaint so the table shows them without a reload.
    document.addEventListener('firma2:entries-change', () => {
      paintAllRows();
      paintLog();
    });

    // ---- boot -------------------------------------------------------------
    paintAdded();
  });
</script>
