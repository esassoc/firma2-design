---
// firma2-project-measures — the performance-measures section of a project's
// detail page: every measure the project committed to, what it has reported
// against each one, and — when a reader asks — what it reported in each year.
//
// ONE TABLE, MEASURES DOWN, YEARS ACROSS. Every measure on a project is built
// from the same window — buildMeasures() walks
// implementationStartYear..completionYear for all of them — so the years are one
// shared axis, and a shared axis belongs in a header row with every measure's
// figures underneath it. That is what lets a reader run their eye DOWN 2025 and
// see which measures moved and which did not. Earlier versions gave each measure
// its own unlabelled strip of marks; nothing told a reader the strips lined up,
// and nothing let them read a year.
//
// THE YEAR COLUMNS ARE COLLAPSED BY DEFAULT. At a glance a reader wants one
// thing from a measure: how much of what was promised has been delivered. So the
// table opens as two columns — measure, and reported-of-target — and the
// per-year columns arrive only when someone asks for them. This is the whole
// reason the section is a table rather than a card of tiles: columns are a thing
// you can take away and put back without the rows moving.
//
// ONE CONTROL FOR THE CARD, not one per row. The years are a shared axis, so
// changing to them is a single act; per-row disclosures would let a reader put
// the card into a state where some rows have a year axis and others do not,
// which is the one arrangement that makes the columns meaningless.
//
// AND IT IS A VIEW SWITCH, NOT A DISCLOSURE. It used to be a caret button at
// the card's FOOT reading "Reporting by year" — a downward chevron under a
// table, which is the universal sign for "more rows below". What it actually
// did was add COLUMNS to the RIGHT. The gesture promised one axis and delivered
// the other, and `aria-expanded` told assistive technology the same untruth:
// nothing expands, the table changes shape. A segmented esa-button-toggle in
// the card's action row states the real thing — two views of one table, both
// named, the current one shown — and it changes horizontally, like the result.
// It also retires a hand-rolled <button> with a CSS-border caret for a lego.
//
// NO SEPARATE "VIEW AS DATA". The table IS the data view — the figures are in
// the cells. An earlier version paired a strip of coloured marks with a hidden
// table that restated them, which is two representations of one thing and two
// places for them to disagree. Expanding the years is now the same act as asking
// for the numbers, because they are the same numbers.
//
// NO COLOUR ANYWHERE IN THE CELLS, and so no legend to key. The year cells were
// briefly tinted by share of target; the numbers were already there to be read,
// the tint made a plain table look like a heatmap, and a figure that is both
// printed and shaded is being said twice. Reading down a column of tabular
// numerals is what a table is for.
//
// ADD, NOT EDIT. This section is a COLLECTION, and that is what separates it
// from Key facts and Description: those hold scalar values, so each got a
// per-field affordance that appears on hover and edits in place, and their
// section pencils went away. A set has no single field to hover — you add to it,
// remove from it, reorder it — so the section keeps one control and it names the
// act it actually performs.
//
// THE AUTHORED ORDER IS NEVER RE-SORTED. A project's measure list has an
// authored order — the headline measure first, its supporting measures after —
// and sorting by percent complete would put the least-delivered measure at the
// top of every card, a judgement this section is not making. At eight rows the
// temptation is stronger and the answer is the same.
//
// THE ZERO CASE IS NOT AN EMPTY STATE. A project in Proposal or Planning & Design
// has reported nothing against any measure, which is most of the portfolio at any
// moment. The targets are still the information — what this project has promised
// to do — so the rows render with an empty ring and "0 of 96 acres". There are no
// year columns to collapse and no control offered, because no period has closed.
// Nothing here says work has not started; the stage pill in the page header
// already says it.
import EsaCard from '@esa/ecology/esa-card.astro';
import '../shared/firma2-card-section.css';
import Firma2ProjectMeasureRow from './firma2-project-measure-row.astro';
// esa-icon-button is the name in the house convention for this affordance, but
// reading it shows it was deprecated (2026-08-14) into a shim that forwards
// verbatim to `<EsaButton variant="chrome" iconOnly>` and console.warns on every
// render. Calling the real component renders byte-identical markup without the
// build noise.
import EsaButton from '@esa/ecology/esa-button.astro';
import type { PerformanceMeasure } from '../../data/firma2-project-detail';
import { isClosedPeriod } from '../../data/firma2-project-detail';

interface Props {
  /** The project's measures, in the order the project reports them. */
  measures: PerformanceMeasure[];
  /**
   * The project's slug — the key measures ADDED in this browser are stored
   * under (src/lib/project-measure-draft.ts). Optional so existing callers
   * degrade to a read-only section rather than breaking.
   */
  projectSlug?: string;
}

const { measures, projectSlug = '' } = Astro.props;

// THE AXIS IS READ OFF THE FIRST MEASURE because every measure carries the same
// one — buildMeasures() builds all of them from the project's single window. Not
// re-derived from the project here: this component is handed measures, and taking
// the years from the data it was actually given means the header cannot disagree
// with the cells underneath it.
//
// CLOSED PERIODS ONLY: a record has no column for a period that has not happened.
// Before this filter, 37% of every cell drawn was a placeholder for a year that
// had not arrived, and a Proposal project drew nothing else.
const years = measures[0]?.series.filter(isClosedPeriod).map((period) => period.year) ?? [];
const hasYears = years.length > 0;

// THE NAME COLUMN IS SIZED TO THE NAMES IT ACTUALLY HOLDS. A flat cap truncated
// "Acres of riparian floodplain planted" on a project whose table had visible
// empty space beside it, which reads as a bug — a fixed width cannot know that
// this project's longest name is short. It cannot be `auto` either: the column
// is sticky, and the column pinned beside it needs a resolved offset to sit at.
// So it is computed, once, from the longest name on this project.
//
// `ch` is the width of a "0", which in a proportional face runs a little wider
// than the lowercase this column is mostly made of — so the estimate errs long,
// which is the safe direction: a column slightly wider than its content wastes
// a few pixels, one slightly narrower truncates a name.
//
// The `+ 2rem` is the ring's footprint — 1.5rem of mark plus its 0.5rem gap —
// which shares this column with the name. Omitting it under-allocated every
// short-name project by exactly the ring's width and squeezed the text.
//
// THE UPPER CLAMP IS THE POINT, not a safety rail. Letting the column take
// whatever the longest name wants pushed the year columns off the table — a
// three-year project that used to fit without scrolling started clipping "2024"
// to "4". Names that exceed 18rem truncate, as they did before; what changed is
// that a project whose names are SHORTER than that no longer gets an 18rem
// column with empty space in it, which is the case that read as a bug.
//
// The cost, stated plainly: with the ring in this column the longest names —
// "Miles of livestock exclusion fencing" and up — no longer fit 18rem and
// truncate, where without it they just did. Raising the cap to fit them puts a
// three-year project over its container and starts it scrolling, which is the
// worse trade. The `title` carries the full string.
const longestName = Math.max(0, ...measures.map((measure) => measure.name.length));
---
{measures.length > 0 && (
  <div class="firma2-project-measures">
  <EsaCard title="Performance measures">
    <!-- RECORD WORK is the reporter's door, and it is ACTIVITY-FIRST: the
         sheet opens on "What did you do?" — a search over every subcategory
         option AND measure name on this project — because reporters think
         "40 acres of pile burning", not in catalog buckets. Picking the
         activity resolves the measure and pre-answers the question; the
         predecessor's 20% Default/Default filler is what measure-first
         forms did to these users. The per-row Record button remains the
         measure-first path for fluent reporters.

         There is NO "Add measure" button: the GHOST ROW at the table's foot
         is the affordance, permanently — the same rule bcn-tag-editor's add
         slot states ("the empty row IS the affordance"). -->
    <EsaButton slot="actions" variant="chrome" size="sm" icon="notepad-text" data-firma2-pm-record-work>Record work</EsaButton>

    <!-- THE VIEW SWITCH. Both views named, the current one filled — a reader
         never has to press it to learn what the other one is, which is the
         thing a lone disclosure control can never say. Offered only when a
         period has closed: with no years there is no second view, and a
         control whose other half is empty is worse than no control.

         No visible group label. The two segments name themselves under a card
         headed "Performance measures", and a "Show" label above them would be
         the ornamental micro-label the house rules ban. The lego has no
         hidden-label prop, so the script names the radiogroup for assistive
         technology instead — see the note there. -->
    {hasYears && (
      <esa-button-toggle
        slot="actions"
        size="sm"
        data-firma2-measure-view
      ></esa-button-toggle>
    )}

    <div class="firma2-project-measures__body stack" data-gap="md" data-firma2-pm-section data-project-slug={projectSlug}>
      <!-- The scroller is the ONLY place this card may scroll, and only once the
           year columns are showing: a fifteen-year window plus a measure name and
           its total cannot fit the 22rem map panel at any type size, and the
           alternatives are worse — shrinking figures past the dense floor, or
           letting the card itself overflow, which is the exact failure
           firma2-project-atlas records for the funding table. Collapsed, the two
           columns always fit and it never scrolls. -->
      <div
        class="firma2-project-measures__scroller"
        data-firma2-measure-years="hidden"
        style={`--firma2-measure-name-ch: ${longestName}`}
      >
        <table class="firma2-project-measures__table">
          <caption class="visually-hidden">Performance measures, reported by year</caption>
          <thead>
            <tr>
              <th scope="col">Measure</th>
              <!-- "Progress", not "Reported": the cell under it holds the
                   reported figure AND the target it is measured against, and a
                   header should name what is in the column rather than half of
                   it. -->
              <th scope="col" class="firma2-project-measures__num">Progress</th>
              {years.map((year) => (
                <th scope="col" class="firma2-project-measures__num firma2-project-measures__year">
                  {year}
                </th>
              ))}
              <!-- Empty on purpose — see the spacer note in the stylesheet. It
                   carries no header text because it labels nothing. -->
              <td class="firma2-project-measures__spacer"></td>
            </tr>
          </thead>
          <tbody>
            {measures.map((measure) => (
              <Firma2ProjectMeasureRow measure={measure} />
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </EsaCard>

  <!-- bcn-lego-checked: everything below IS legos — esa-side-dialog,
       esa-select, esa-text-field, esa-combobox, esa-button — composed with
       layout primitives; the classes are query hooks, not bespoke skins. The
       button templates are the lego-clone trick the data grids use for
       pills/peeks: real esa-buttons server-rendered once and cloned into rows
       the script builds. Beacon is not cloned on this machine. -->

  <!-- THE ENTRY SHEET — where an observation is recorded against one of this
       project's measures, and the PRIMARY design of the reporting
       interaction (the measure catalog's admin preview mirrors this form).
       One entry is the model's atom: a period, the figure, and the reporter's
       answers to the measure's subcategory schemas — the system-answered
       splits are named at the foot, never asked. SAVE KEEPS THE SHEET OPEN:
       recording is a batch act (80 acres of thinning and 40 of burning are
       two entries in one sitting), so Save appends to the log below and
       clears for the next; Done is how a sitting ends. Entries live in this
       browser (src/lib/entry-draft.ts) and the log's heading says so. -->
  <esa-side-dialog class="firma2-project-measures__entry-sheet" heading="Record an entry" size="md" position="right">
    <div class="firma2-project-measures__entry stack" data-gap="lg">
      <!-- The activity-first door. Hidden on the per-row path; on Record
           work it is the whole opening move, and the rest of the form
           appears once the pick has resolved which measure this files
           under. -->
      <esa-combobox
        data-entry-activity
        label="What did you do?"
        size="md"
        placeholder="e.g. pile burning"
        hidden
      ></esa-combobox>
      <p class="firma2-project-measures__entry-lede typography-meta" data-entry-lede></p>
      <div class="stack" data-gap="lg" data-entry-body>
        <esa-select data-entry-year label="Reporting year" size="md"></esa-select>
        <esa-text-field data-entry-amount label="Amount" size="md" inputmode="decimal" required></esa-text-field>
        <div class="stack" data-gap="md" data-entry-questions></div>
        <p class="firma2-project-measures__entry-autos typography-meta" data-entry-autos hidden></p>
        <section class="stack" data-gap="2xs" data-entry-log-block hidden>
          <h3 class="firma2-project-measures__entry-log-title typography-label-sm">Recorded in this browser</h3>
          <ul class="firma2-project-measures__entry-log stack" data-gap="2xs" data-entry-log></ul>
        </section>
      </div>
    </div>
    <div slot="footer" class="firma2-project-measures__entry-footer repel">
      <EsaButton variant="ghost" size="md" data-entry-done>Done</EsaButton>
      <EsaButton variant="primary" size="md" data-entry-save>Save entry</EsaButton>
    </div>
  </esa-side-dialog>

  <!-- Row affordance templates, cloned into name cells by the script:
       Record on every row, Remove only on rows added in this browser. -->
  <div data-firma2-pm-record-template hidden aria-hidden="true">
    <EsaButton variant="chrome" iconOnly icon="plus" size="sm" aria-label="Record an entry">Record an entry</EsaButton>
  </div>
  <div data-firma2-pm-remove-template hidden aria-hidden="true">
    <EsaButton variant="chrome" iconOnly icon="x" size="sm" aria-label="Remove measure">Remove measure</EsaButton>
  </div>
  </div>
)}

<style>
  /* The container the scroller's own query reads. It goes on the WRAPPER, not on
     the scroller: an element cannot query its own container, and a rule written
     that way matches nothing at all — silently. */
  .firma2-project-measures__body {
    container-type: inline-size;
    container-name: firma2-measures;
  }

  .firma2-project-measures__scroller {
    /* Only reachable with the year columns showing — see the markup note. */
    overflow-x: auto;
    /* ONE DEFINITION of the pinned name column's width, read by the cap on that
       column AND by the sticky offset of the total beside it. Two numbers that
       have to agree should be one number. The `ch` count comes from the longest
       name on this project — see the frontmatter. */
    --firma2-measure-name-max: 18rem;
    --firma2-measure-name-width: clamp(
      10rem,
      calc(var(--firma2-measure-name-ch, 26) * 1ch + 2rem),
      var(--firma2-measure-name-max)
    );
  }

  /* In the map panel there is no room for an 18rem name column beside a pinned
     total; the name gives way first, because it ellipsizes gracefully and the
     figure does not. */
  @container firma2-measures (max-width: 34rem) {
    .firma2-project-measures__scroller {
      /* 8rem, not 9: measured against the widest total in the portfolio —
         "220,900 of 410,000 cubic yards" at ~250px — which put a 9rem name
         column 7px over the panel and started it scrolling while collapsed. The
         figure cannot wrap without making every row two lines tall, so the name
         column is what gives. */
      --firma2-measure-name-width: 8rem;
    }
  }

  /* At the atlas panel's 22rem floor the name gives way again. Measured, not
     guessed: "178 of 380 assessments" is the widest total in the portfolio at
     ~175px and it cannot wrap without making every row two lines tall, so the
     name column gets what is left. 6rem is heavy truncation — the `title`
     carries the full string — and it is the price of the promise this card makes
     everywhere else: collapsed, it never scrolls. */
  @container firma2-measures (max-width: 21rem) {
    .firma2-project-measures__scroller {
      --firma2-measure-name-width: 6rem;
    }
  }

  /* The table chrome below is firma2-project-expenditures.astro:292-332, rule for
     rule — collapsed borders, flush outer padding, secondary column heads,
     tabular numerals aligned to the end. Copied rather than imported because it
     is component-scoped there too; extracting a shared record-table stylesheet is
     a follow-up, not a reason to diverge here in the meantime. */
  .firma2-project-measures__table {
    inline-size: 100%;
    /* SEPARATE, NOT COLLAPSE — and this is what makes the sticky seam work at
       all. Under `border-collapse: collapse` a border between two cells belongs
       to the TABLE, not to either cell: the browser resolves the conflict once
       and paints the winner in table space. So the rule after the pinned figures
       scrolled away with the year columns, which is the opposite of the one
       thing it is for — marking where the years begin while you scroll them.
       In the separate model each cell owns its own borders and a sticky cell
       carries them along. `border-spacing: 0` keeps the cells flush, and nothing
       doubles because every rule below sets a single side. */
    border-collapse: separate;
    border-spacing: 0;
  }

  .firma2-project-measures__table :global(th),
  .firma2-project-measures__table :global(td) {
    text-align: start;
    vertical-align: middle;
    padding-block: var(--spacing-200, 0.5rem);
    padding-inline: var(--spacing-300, 0.75rem);
  }

  .firma2-project-measures__table :global(th:first-child),
  .firma2-project-measures__table :global(td:first-child) { padding-inline-start: 0; }
  .firma2-project-measures__table :global(th:last-child),
  .firma2-project-measures__table :global(td:last-child) { padding-inline-end: 0; }

  .firma2-project-measures__table thead th {
    color: var(--color-content-default-secondary, #646464);
    font-weight: var(--font-weight-semibold, 600);
    white-space: nowrap;
    border-block-end: var(--border-width-default, 1px) solid var(--color-border-default, #cecece);
  }

  /* The row header carries the measure's name, and a name is not a heading —
     inherit the body weight so the only bold thing in the row is the figure the
     reader came for. The name column takes the slack; every other column is
     content-sized. */
  .firma2-project-measures__table :global(tbody th) {
    font-weight: inherit;
    color: var(--color-content-default-secondary, #646464);
  }

  .firma2-project-measures__table :global(tbody tr + tr th),
  .firma2-project-measures__table :global(tbody tr + tr td) {
    border-block-start: var(--border-width-default, 1px) solid
      var(--color-border-default-subtle, #d9d9d9);
  }

  /* NUMERIC COLUMNS ALIGN TO THEIR END, and this rule has to live HERE, after
     the generic cell rule above, because that one wins on specificity: Astro
     scopes both compounds, so `.table[cid] td` (0,2,1) outranks the row
     component's own `.row__num[cid]` (0,2,0) and quietly left-aligned every
     figure in the table. Digits that do not line up are the one thing a column
     of numbers must not do — 10,727 and 98 have to share a right edge to be
     comparable at a glance. Matching specificity, later in the sheet, wins. */
  .firma2-project-measures__table thead th.firma2-project-measures__num,
  .firma2-project-measures__table :global(.firma2-project-measure-row__num) {
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  /* THE TWO SUMMARY COLUMNS STAY PUT WHILE THE YEARS SCROLL. Seven year columns
     plus a measure name do not fit a 41rem main column, let alone a 22rem map
     panel, so the table scrolls — and a cross-tab whose row header scrolls out
     of view is a grid of anonymous numbers. Pinning the name and the total means
     a reader dragging out to 2025 still knows which measure they are reading and
     what it adds up to.

     The background is esa-card's own token (esa-card.astro:114), not a literal:
     the pinned cells have to paint over what slides under them, and a hardcoded
     white would tear the moment a card variant or a dark scheme changed the
     surface. */
  .firma2-project-measures__table :global(th:first-child) {
    position: sticky;
    inset-inline-start: 0;
    z-index: 1;
    background: var(--card-bg, var(--color-background-elevation-raised, #fcfcfc));
  }

  .firma2-project-measures__table :global(.firma2-project-measure-row__total),
  .firma2-project-measures__table thead th:nth-child(2) {
    position: sticky;
    /* THE OFFSET IS MEASURED, NOT DECLARED. It has to equal the name column's
       RENDERED width, and a table's auto layout treats `inline-size` on a cell
       as a suggestion — it hands the column whatever the algorithm resolves,
       which is close to the request but not equal to it. Pinning this column at
       the requested width left a sliver of ungoverned space between the two, and
       a scrolled year column bled up through it: on the twenty-five-year project
       a phantom "20" and a stray "C" sat between Measure and Progress.
       The script measures the real width after layout and publishes it here; the
       declared width is the fallback for the moment before it runs. */
    inset-inline-start: var(--firma2-measure-sticky-offset, var(--firma2-measure-name-width, 18rem));
    z-index: 1;
    background: var(--card-bg, var(--color-background-elevation-raised, #fcfcfc));
  }

  /* THE SEAM AFTER THE FIGURES, and it earns its keep in both views. In By
     year it is the edge the year columns scroll against, so the pinned pair
     reads as an edge rather than as columns that happen to be still. In Total
     it says the table continues past the figures — no longer the ONLY hint
     that it does, now that the card header names both views, but still the
     thing that makes the pinned pair look deliberate.

     A border rather than the box-shadow this started as — inside a
     border-collapse table the shadow painted under the neighbouring cells and
     never showed at all. Which is also why the leftmost year column simply
     reads as clipped when the axis opens at its recent end: the conventional
     occlusion shadow is not available here, and a partial column at a scroll
     edge is what every scrolled table looks like. */
  .firma2-project-measures__table :global(.firma2-project-measure-row__total),
  .firma2-project-measures__table thead th:nth-child(2) {
    border-inline-end: var(--border-width-default, 1px) solid
      var(--color-border-default, #cecece);
  }

  /* THE NAME COLUMN IS CAPPED, not slack-taking, once it has to be pinned: a
     sticky column has to have a width the offset above can name, and an `auto`
     column sized to the longest measure name would push the years off screen
     before the reader ever saw one. Long names ellipsize — the full string is on
     the row's `title`. */
  .firma2-project-measures__table :global(tbody th),
  .firma2-project-measures__table thead th:first-child {
    inline-size: var(--firma2-measure-name-width, 18rem);
    max-inline-size: var(--firma2-measure-name-width, 18rem);
  }

  /* THE COLLAPSE, and it is the whole of it: the year columns are removed from
     the table rather than hidden inside it, so the remaining columns re-flow to
     the full width instead of leaving a gap where the years were.

     Trailing `:global()` reaches into the row component from a scoped ancestor,
     which is the direction Astro's scoping supports. A LEADING `:global()`
     silently loses its ancestor — the compiler emits the local compound alone —
     and a rule written that way fires unconditionally. Written down here so it
     does not have to be rediscovered. */
  [data-firma2-measure-years='hidden'] .firma2-project-measures__year,
  [data-firma2-measure-years='hidden'] :global(.firma2-project-measure-row__year) {
    display: none;
  }

  /* A TRAILING SPACER COLUMN, and it is the only reason the seam is visible. The
     table is full-width, so the leftover width has to land somewhere: give it to
     the figures and they stretch to the card's right edge, putting the border
     flush against the card's own outline where it reads as a doubled line; give
     it to the name and the figures get pushed there instead. A zero-content
     column at the end takes it, so the name and the figures both keep their own
     widths, the seam lands immediately after the numbers, and the space beyond
     it is what says the table continues. Expanded, it collapses to nothing the
     moment the year columns need the room. */
  .firma2-project-measures__spacer {
    inline-size: 100%;
    padding: 0;
  }

  /* THE NAME CAP IS ONLY THERE TO PROTECT THE YEAR COLUMNS, so it lifts when
     there are none. Collapsed, the table has slack to spare — it is sitting
     right there past the seam — and truncating a name into it is the exact
     defect this column was resized to fix. Expanded, 18rem comes back, because
     then the slack is what the years need. The cost is that the figures shift
     when the control is used; the alternative is a permanently truncated name
     column in the view a reader actually spends their time in.
     It raises the CAP, not the width. Setting the cell to `max-content` also
     lifts the cap — and takes the container queries below with it, which
     overflowed the 22rem map panel by 180px. The clamp still governs. */
  .firma2-project-measures__scroller[data-firma2-measure-years='hidden'] {
    --firma2-measure-name-max: 26rem;
  }

  /* ROW AFFORDANCES — Record on every row, Remove on rows added in this
     browser. Built by cloning the server-rendered templates, so the rules
     reach through :global (injected content has no scope hash). Quiet until
     the row is hovered or focused: opacity, not display, so the pinned name
     column never reflows, and the buttons stay in the tab order. */
  .firma2-project-measures__table :global(.firma2-project-measures__record),
  .firma2-project-measures__table :global(.firma2-project-measures__remove) {
    opacity: 0;
    transition: opacity 120ms ease;
    flex: none;
    line-height: 0;
  }

  .firma2-project-measures__table :global(tr:hover .firma2-project-measures__record),
  .firma2-project-measures__table :global(tr:focus-within .firma2-project-measures__record),
  .firma2-project-measures__table :global(tr:hover .firma2-project-measures__remove),
  .firma2-project-measures__table :global(tr:focus-within .firma2-project-measures__remove) {
    opacity: 1;
  }

  @media (hover: none) {
    .firma2-project-measures__table :global(.firma2-project-measures__record),
    .firma2-project-measures__table :global(.firma2-project-measures__remove) {
      opacity: 1;
    }
  }

  .firma2-project-measures__table :global(.firma2-project-measures__record .esa-button__native),
  .firma2-project-measures__table :global(.firma2-project-measures__remove .esa-button__native) {
    block-size: 24px;
    inline-size: 24px;
    padding: 0;
  }

  /* THE GHOST ROW's controls take their cells; the combobox needs the whole
     pinned name column and the target the whole Progress column. */
  .firma2-project-measures__table :global(tr[data-ghost] esa-combobox),
  .firma2-project-measures__table :global(tr[data-ghost] esa-text-field) {
    display: block;
    inline-size: 100%;
    text-align: start;
  }

  /* The resting invitation — placeholder ink in the row's own type, the
     option-list grammar: a blank row that says what it does, and nothing
     else until asked. */
  .firma2-project-measures__table :global(.firma2-project-measures__ghost-invite) {
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    color: var(--color-content-default-secondary, #646464);
    cursor: pointer;
  }

  .firma2-project-measures__table :global(.firma2-project-measures__ghost-invite:hover) {
    color: var(--color-content-default, #202020);
  }

  .firma2-project-measures__table :global(.firma2-project-measures__ghost-invite:focus-visible) {
    outline: 2px solid var(--color-border-default-focus, #46a758);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* COLLAPSED, THE SCROLLER MUST NOT CLIP: nothing can overflow sideways in
     the two-column state, and the ghost row's combobox has to drop its list
     past the table's foot — an overflow-x:auto box clips it. Only the
     expanded state actually scrolls, so only it pays the clipping cost. */
  .firma2-project-measures__scroller[data-firma2-measure-years='hidden'] {
    overflow-x: visible;
  }

  /* THE CARD MUST NOT CLIP EITHER — esa-card ships overflow:hidden for its
     rounded corners, and the ghost row's dropdown (position:absolute in the
     lego) was being decapitated at the card's bottom edge; the card was the
     ONLY clipping ancestor on the chain (measured). The clip exists for
     full-bleed children; everything in this card is padded, so releasing it
     costs nothing — the radius still paints, it just no longer clips a list
     that needs to fall past the card. */
  .firma2-project-measures :global(.esa-card) {
    overflow: visible;
  }

  /* THE ENTRY SHEET. Slightly wider than the md rung for the question
     dropdowns; the lego's own token pierces the shadow root. */
  .firma2-project-measures__entry-sheet {
    --side-dialog-width: 480px;
  }

  .firma2-project-measures__entry-lede,
  .firma2-project-measures__entry-autos,
  .firma2-project-measures__entry-log-title {
    margin: 0;
  }

  .firma2-project-measures__entry-lede,
  .firma2-project-measures__entry-autos {
    color: var(--color-content-default-secondary, #646464);
  }

  .firma2-project-measures__entry-log {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .firma2-project-measures__entry-footer {
    inline-size: 100%;
  }

  .firma2-project-measures :global(.firma2-project-measures__entry-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-200, 0.5rem);
    padding-block: var(--spacing-100, 0.25rem);
    border-block-end: 1px solid var(--color-border-default-subtle, #d9d9d9);
  }

  .firma2-project-measures :global(.firma2-project-measures__entry-remove .esa-button__native) {
    block-size: 24px;
    inline-size: 24px;
    padding: 0;
  }

  /* MAKE `hidden` MEAN HIDDEN for the sheet's toggled blocks — the log
     section carries a layout utility whose display outranks the UA's
     [hidden] rule, the same trap the sidesheets document. Scoped to this
     component's own hooks so it cannot touch the scroller's
     data-firma2-measure-years="hidden" ATTRIBUTE VALUE, which is unrelated. */
  .firma2-project-measures :global([data-entry-log-block][hidden]),
  .firma2-project-measures :global([data-entry-autos][hidden]),
  .firma2-project-measures :global([data-entry-body][hidden]),
  .firma2-project-measures :global([data-entry-activity][hidden]),
  .firma2-project-measures :global([data-entry-lede][hidden]) {
    display: none !important;
  }
</style>

<script>
  import '@esa/ecology/esa-button-toggle';

  // THE WHOLE OF THE VIEW SWITCH. It writes one attribute on the scroller; every
  // appearance change — the year header cells, the year data cells, the name
  // column's cap — is a CSS consequence of that attribute. Nothing is rendered
  // here, so there is no state to keep in sync and no layout the script can get
  // wrong.
  //
  // Scoped per card via closest(), not a document-wide selector: the atlas page
  // can put this section on screen beside other cards, and a switch that reached
  // every table on the page would be a bug the moment a second one appears.
  // The pinned figure column has to start exactly where the measure column ends,
  // and only layout knows where that is — see the CSS note. Measured after the
  // columns exist, and again whenever the table is resized, because the measure
  // column's width tracks the container.
  const syncStickyOffset = (scroller: HTMLElement): void => {
    const first = scroller.querySelector<HTMLElement>('thead th:first-child');
    if (first) scroller.style.setProperty('--firma2-measure-sticky-offset', `${first.offsetWidth}px`);
  };

  document.querySelectorAll<HTMLElement>('[data-firma2-measure-years]').forEach((scroller) => {
    syncStickyOffset(scroller);
    new ResizeObserver(() => syncStickyOffset(scroller)).observe(scroller);
  });

  /**
   * THE TWO VIEWS, named. "Total" is the running figure against its target —
   * the one thing a reader wants at a glance and the reason it is the default.
   * "By year" adds one column per closed reporting period.
   */
  const VIEW_TOTAL = 'total';
  const VIEW_YEARS = 'years';
  const VIEW_OPTIONS = [
    { label: 'Total', value: VIEW_TOTAL },
    { label: 'By year', value: VIEW_YEARS },
  ];

  /** Names the radiogroup for assistive technology, since it shows no label. */
  const VIEW_GROUP_NAME = 'Figures shown';

  type Toggle = HTMLElement & { options?: unknown; value?: string };

  document.querySelectorAll<Toggle>('[data-firma2-measure-view]').forEach((toggle) => {
    const scroller = toggle
      .closest('.firma2-project-measures')
      ?.querySelector<HTMLElement>('[data-firma2-measure-years]');
    if (!scroller) return;

    // Options are an array, so they are a PROPERTY, not an attribute — and safe
    // to assign before the element upgrades: Lit reclaims a property set on an
    // un-upgraded element when it defines it.
    toggle.options = VIEW_OPTIONS;
    toggle.value = VIEW_TOTAL;

    // THE GROUP'S ACCESSIBLE NAME. The lego names its radiogroup from its
    // VISIBLE label and offers no hidden-label prop, and a visible label here
    // would be the ornamental micro-label the house rules ban — so the name is
    // written onto the group directly. Reaching into a lego's shadow root is
    // this spoke's established seam (src/lib/side-dialog-fix.ts adopts a
    // stylesheet into one); optional chaining means a renamed internal costs
    // the name, never a thrown error. Worth a /request-lego for a real
    // `label-hidden` prop.
    customElements.whenDefined('esa-button-toggle').then(() => {
      requestAnimationFrame(() => {
        toggle.shadowRoot?.querySelector('[role="radiogroup"]')
          ?.setAttribute('aria-label', VIEW_GROUP_NAME);
      });
    });

    toggle.addEventListener('change', () => {
      const years = toggle.value === VIEW_YEARS;
      scroller.dataset.firma2MeasureYears = years ? 'shown' : 'hidden';

      // OPEN ON THE MOST RECENT YEAR. The columns run oldest-to-newest because
      // that is how a time series reads, but a project that has run for
      // twenty-five years is 1,917px of table in a 661px column — opening at
      // the left edge shows 1999 and asks the reader to drag 1,250px to reach
      // the year they almost certainly came for. Chronological order, recent
      // end in view.
      //
      // No smooth scroll: this is not an animation the reader asked for, it is
      // the initial position of a thing that has only just appeared, and
      // animating it would draw the eye across twenty columns of numbers for
      // no reason.
      if (years) {
        syncStickyOffset(scroller);
        scroller.scrollLeft = scroller.scrollWidth;
      }
    });
  });

  // ---------------------------------------------------------------------------
  // THE REPORTING SURFACE. Two acts live here, both persisted browser-locally:
  //
  //   ADD A MEASURE — a GHOST ROW at the table's foot, not a dialog: the row
  //   being created is a row of this table, so it is authored where it will
  //   live. The name cell is a search-as-you-type combobox over the tenant's
  //   Active catalog (browser drafts included); picking one surfaces its
  //   definition right there and puts its unit on the target field. Enter
  //   commits and a fresh ghost appears — the self-extending pattern — and
  //   Escape withdraws it.
  //
  //   RECORD AN ENTRY — every row carries a quiet Record affordance opening
  //   the entry sheet above: period, figure, the measure's own subcategory
  //   questions. Entries are layered over each row's base figures (the
  //   data-* attributes the row component publishes) by ONE painter, so the
  //   total, the ring and the year cells always agree.
  //
  // Aggregation is honest-for-a-prototype: sum-family rules add entries up;
  // reading-family rules (latest/average per place) take the latest entry,
  // because entries here carry no place to group by.
  // ---------------------------------------------------------------------------
  import '@esa/ecology/esa-side-dialog';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-combobox';
  import {
    measures as catalogSeeds,
    measureDisplayName,
    measureKind,
  } from '../../data/firma2-performance-measures';
  import type { PerformanceMeasureDefinition } from '../../data/firma2-performance-measures';
  import { allSchemas } from '../../lib/schema-draft';
  import { draftedSlugs, isLocalMeasureSlug, withDraft } from '../../lib/measure-draft';
  import {
    addProjectMeasure,
    readProjectMeasures,
    readTargetOverrides,
    removeProjectMeasure,
    setTargetOverride,
  } from '../../lib/project-measure-draft';
  import { addEntry, readEntries, removeEntry } from '../../lib/entry-draft';
  import { fixSideDialog } from '../../lib/side-dialog-fix';

  type Control = HTMLElement & {
    value?: unknown;
    options?: unknown;
    helpText?: string;
    errorText?: string;
  };
  type Sheet = HTMLElement & { show: () => void; close: () => void; heading?: string };

  const fmtNum = (n: number): string => n.toLocaleString('en-US');

  /** The whole catalog as this browser sees it: seeds with drafts laid over,
   *  plus measures minted here. */
  const catalogAll = (): PerformanceMeasureDefinition[] => [
    ...catalogSeeds.map((m) => withDraft(m.slug)),
    ...draftedSlugs()
      .filter(isLocalMeasureSlug)
      .map((slug) => withDraft(slug)),
  ];

  const catalogActive = () => catalogAll().filter((m) => m.status === 'Active');

  /** Resolve a row's measure key back to its catalog record, if it has one.
   *  Seed rows key by name — the seam where a real backend keys by id. */
  const catalogFor = (key: string): PerformanceMeasureDefinition | null =>
    key.startsWith('name:')
      ? catalogAll().find(
          (m) => measureDisplayName(m).toLowerCase() === key.slice(5).toLowerCase(),
        ) ?? null
      : catalogAll().find((m) => m.slug === key) ?? null;

  const SUM_RULES = new Set(['sum', 'spatial-union', 'distinct-places']);

  document.querySelectorAll<HTMLElement>('.firma2-project-measures').forEach((root) => {
    const body = root.querySelector<HTMLElement>('[data-firma2-pm-section]');
    const slug = body?.dataset.projectSlug ?? '';
    const tbody = root.querySelector<HTMLElement>('.firma2-project-measures__table tbody');
    const recordTemplate = root.querySelector<HTMLElement>('[data-firma2-pm-record-template]');
    const removeTemplate = root.querySelector<HTMLElement>('[data-firma2-pm-remove-template]');
    const sheet = root.querySelector<Sheet>('.firma2-project-measures__entry-sheet');
    if (!body || !slug || !tbody || !sheet) return;
    void fixSideDialog(sheet);

    // The clone source, captured before any injection so it is always a seed.
    const seedRow = tbody.querySelector('tr');
    if (!seedRow) return;

    const realRows = (): HTMLElement[] =>
      [...tbody.querySelectorAll<HTMLElement>('tr:not([data-ghost])')];

    const nameOf = (tr: HTMLElement): string =>
      (
        tr.querySelector('.firma2-project-measure-row__name')?.textContent ??
        tr.querySelector('th')?.textContent ??
        ''
      ).trim();

    const rowKey = (tr: HTMLElement): string =>
      tr.dataset.addedMeasure ?? `name:${nameOf(tr)}`;

    const rowNames = (): string[] => realRows().map((tr) => nameOf(tr).toLowerCase());

    /** The table's year axis, read off its own header. */
    const axisYears = (): number[] =>
      [...root.querySelectorAll('thead .firma2-project-measures__year')]
        .map((th) => Number(th.textContent?.trim()))
        .filter((y) => Number.isFinite(y));

    // ---- the one painter --------------------------------------------------
    const DASH = '<span aria-hidden="true">\u2014</span><span class="visually-hidden">Not reported</span>';

    const paintRow = (tr: HTMLElement) => {
      const key = rowKey(tr);
      const entries = readEntries(slug).filter((e) => e.measureKey === key);
      const total = tr.querySelector<HTMLElement>('.firma2-project-measure-row__total');
      if (!total) return;
      const baseReported = Number(total.dataset.reported || 0);
      // The GOAL is the built value unless this browser edited it — added
      // rows carry edits on their own record, so their data-expected is
      // already current; seed rows read the override store.
      const expected = readTargetOverrides(slug)[key] ?? Number(total.dataset.expected || 0);
      const unit = total.dataset.unit ?? '';
      const rule = catalogFor(key)?.countingRule ?? 'sum';
      const summing = SUM_RULES.has(rule);

      const reported = summing
        ? baseReported + entries.reduce((sum, e) => sum + e.amount, 0)
        : entries.length > 0
          ? entries[entries.length - 1].amount
          : baseReported;
      total.textContent = `${fmtNum(reported)} of ${fmtNum(expected)} ${unit}`.trim();

      // The ring follows — same never-reads-full-until-it-is rule the row
      // component states: the fraction is clamped, not rounded up.
      const fill = tr.querySelector<SVGElement>('.bcn-progress-ring__fill');
      const dash = Number(fill?.getAttribute('stroke-dasharray'));
      if (fill && Number.isFinite(dash) && expected > 0) {
        const p = Math.min(1, Math.max(0, reported / expected));
        fill.setAttribute('stroke-dashoffset', String(dash * (1 - p)));
      }

      tr.querySelectorAll<HTMLElement>('.firma2-project-measure-row__year').forEach((td) => {
        const year = Number(td.dataset.year);
        const inYear = entries.filter((e) => e.year === year);
        const base = td.dataset.value === '' || td.dataset.value === undefined ? null : Number(td.dataset.value);
        let value: number | null;
        if (summing) {
          const extra = inYear.reduce((sum, e) => sum + e.amount, 0);
          value = base === null && inYear.length === 0 ? null : (base ?? 0) + extra;
        } else {
          value = inYear.length > 0 ? inYear[inYear.length - 1].amount : base;
        }
        if (value === null) {
          td.classList.add('firma2-project-measure-row__year--none');
          td.innerHTML = DASH;
        } else {
          td.classList.remove('firma2-project-measure-row__year--none');
          td.textContent = fmtNum(value);
        }
      });
    };

    const paintAllRows = () => realRows().forEach(paintRow);

    // ---- row affordances --------------------------------------------------
    const cloneButton = (
      template: HTMLElement | null,
      cls: string,
      aria: string,
    ): HTMLElement | null => {
      const el = template?.firstElementChild?.cloneNode(true) as HTMLElement | null;
      if (!el) return null;
      el.classList.add(cls);
      el.querySelector('button')?.setAttribute('aria-label', aria);
      return el;
    };

    const ensureRowControls = () => {
      realRows().forEach((tr) => {
        const dock = tr.querySelector('.firma2-project-measure-row__measure-inner') ?? tr.querySelector('th');
        if (!dock) return;
        if (!tr.querySelector('.firma2-project-measures__record')) {
          const record = cloneButton(
            recordTemplate,
            'firma2-project-measures__record',
            `Record an entry for ${nameOf(tr)}`,
          );
          if (record) dock.append(record);
        }
        if (tr.dataset.addedMeasure && !tr.querySelector('.firma2-project-measures__remove')) {
          const remove = cloneButton(
            removeTemplate,
            'firma2-project-measures__remove',
            `Remove ${nameOf(tr)} from this project`,
          );
          if (remove) dock.append(remove);
        }
      });
    };

    // ---- rows added in this browser --------------------------------------
    const paintAdded = () => {
      tbody.querySelectorAll('[data-added-measure]').forEach((tr) => tr.remove());
      const taken = rowNames();
      for (const entry of readProjectMeasures(slug)) {
        const m = withDraft(entry.measureSlug);
        const name = measureDisplayName(m);
        if (taken.includes(name.toLowerCase())) continue;
        const tr = seedRow.cloneNode(true) as HTMLElement;
        tr.dataset.addedMeasure = entry.measureSlug;

        const nameSpan = tr.querySelector<HTMLElement>('.firma2-project-measure-row__name');
        if (nameSpan) {
          nameSpan.textContent = name;
          nameSpan.setAttribute('title', name);
        }
        // Cloned affordances belong to the seed row it came from — rebuilt
        // for this row by ensureRowControls with this row's own name.
        tr.querySelectorAll('.firma2-project-measures__record, .firma2-project-measures__remove').forEach((b) => b.remove());

        const total = tr.querySelector<HTMLElement>('.firma2-project-measure-row__total');
        if (total) {
          total.dataset.reported = '0';
          total.dataset.expected = String(entry.target);
          total.dataset.unit = m.unit ?? '';
        }
        tr.querySelectorAll<HTMLElement>('.firma2-project-measure-row__year').forEach((td) => {
          td.dataset.value = '';
        });
        tbody.append(tr);
      }
      ensureRowControls();
      paintAllRows();
      refreshGhost();
    };

    // ---- the ghost row ----------------------------------------------------
    // PERMANENT AND QUIET — the original option-list grammar: the table's
    // last row IS the add affordance, wearing placeholder ink until asked
    // for. Clicking the invitation swaps the editor (catalog combobox +
    // target) into the same cells; Enter commits and the editor stays,
    // cleared, for the next commitment; Escape folds it back to the
    // invitation. The row hides only when every Active measure is already
    // attached, and it always stays last.
    const ghostRow = (): HTMLElement | null => tbody.querySelector<HTMLElement>('tr[data-ghost]');

    const ghostOptions = () => {
      const taken = new Set(rowNames());
      return catalogActive()
        .filter((m) => !taken.has(measureDisplayName(m).toLowerCase()))
        .map((m) => ({ label: measureDisplayName(m), value: m.slug }));
    };

    /** Keep the ghost current: options while editing, visibility, position. */
    const refreshGhost = () => {
      const tr = ghostRow();
      if (!tr) return;
      const options = ghostOptions();
      const combo = tr.querySelector<Control>('esa-combobox');
      if (combo) combo.options = options;
      tr.hidden = options.length === 0;
      tbody.append(tr);
    };

    /** The resting shape: one quiet invitation where the name would be. */
    const foldGhost = () => {
      const tr = ghostRow();
      if (!tr) return;
      const th = tr.querySelector('th');
      if (th) {
        const invite = document.createElement('button');
        invite.type = 'button';
        invite.className = 'firma2-project-measures__ghost-invite';
        invite.textContent = 'Add a measure';
        th.replaceChildren(invite);
      }
      tr.querySelector<HTMLElement>('.firma2-project-measure-row__total')?.replaceChildren();
      refreshGhost();
    };

    /** Commit whatever the editing ghost holds; the editor stays for the next. */
    const commitGhost = () => {
      const tr = ghostRow();
      const combo = tr?.querySelector<Control>('esa-combobox');
      const target = tr?.querySelector<Control>('esa-text-field');
      if (!tr || !combo || !target) return;
      const picked = String(combo.value ?? '');
      if (!picked) {
        combo.errorText = 'Pick a measure.';
        return;
      }
      const amount = Number(String(target.value ?? '').replace(/,/g, ''));
      if (!Number.isFinite(amount) || amount <= 0) {
        target.errorText = 'Enter the committed amount.';
        return;
      }
      addProjectMeasure(slug, { measureSlug: picked, target: amount });
      combo.value = '';
      combo.helpText = '';
      combo.errorText = '';
      target.value = '';
      target.errorText = '';
      target.removeAttribute('suffix');
      paintAdded();
      requestAnimationFrame(() => {
        (combo.shadowRoot?.querySelector<HTMLElement>('input') ?? combo).focus();
      });
    };

    /** The editing shape: catalog combobox + target, in the same cells. */
    const editGhost = () => {
      const tr = ghostRow();
      if (!tr || tr.querySelector('esa-combobox')) return;

      const combo = document.createElement('esa-combobox') as Control;
      combo.setAttribute('label', 'Measure');
      combo.setAttribute('size', 'md');
      combo.setAttribute('placeholder', 'Search the catalog');
      tr.querySelector('th')?.replaceChildren(combo);

      const target = document.createElement('esa-text-field') as Control;
      target.setAttribute('label', 'Target');
      target.setAttribute('size', 'md');
      target.setAttribute('inputmode', 'decimal');
      target.setAttribute('placeholder', 'e.g. 250');
      tr.querySelector<HTMLElement>('.firma2-project-measure-row__total')?.replaceChildren(target);

      // Picking a measure surfaces its definition where the choice is being
      // made, and puts its unit on the target — the two facts the judgment
      // needs, without leaving the row.
      combo.addEventListener('change', () => {
        const picked = catalogAll().find((m) => m.slug === String(combo.value ?? ''));
        combo.helpText = picked?.definition ?? '';
        if (picked?.unit) target.setAttribute('suffix', picked.unit);
        else target.removeAttribute('suffix');
        combo.errorText = '';
      });

      refreshGhost();
      requestAnimationFrame(() => {
        (combo.shadowRoot?.querySelector<HTMLElement>('input') ?? combo).focus();
      });
    };

    /** Build the row once; state swaps happen inside its cells. */
    const ensureGhost = () => {
      if (ghostRow()) {
        refreshGhost();
        return;
      }
      const tr = seedRow.cloneNode(true) as HTMLElement;
      tr.dataset.ghost = '';
      delete tr.dataset.addedMeasure;
      const totalCell = tr.querySelector<HTMLElement>('.firma2-project-measure-row__total');
      if (totalCell) {
        delete totalCell.dataset.reported;
        delete totalCell.dataset.expected;
        delete totalCell.dataset.unit;
        totalCell.replaceChildren();
      }
      tr.querySelectorAll<HTMLElement>('.firma2-project-measure-row__year').forEach((td) => {
        td.classList.remove('firma2-project-measure-row__year--none');
        td.replaceChildren();
      });
      tr.querySelectorAll('.firma2-project-measures__record, .firma2-project-measures__remove').forEach((b) => b.remove());

      tr.addEventListener('click', (event) => {
        if ((event.target as Element).closest('.firma2-project-measures__ghost-invite')) editGhost();
      });
      tr.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && tr.querySelector('esa-combobox')) {
          event.preventDefault();
          commitGhost();
        } else if (event.key === 'Escape') {
          event.preventDefault();
          foldGhost();
        }
      });

      tbody.append(tr);
      foldGhost();
    };

    // Removal — only rows added in this browser carry the control.
    tbody.addEventListener('click', (event) => {
      const btn = (event.target as Element).closest('.firma2-project-measures__remove');
      const tr = btn?.closest<HTMLElement>('[data-added-measure]');
      if (!tr?.dataset.addedMeasure) return;
      removeProjectMeasure(slug, tr.dataset.addedMeasure);
      paintAdded();
    });

    // ---- editing the GOAL where it lays -----------------------------------
    // Double-click the Progress cell (the catalog grid's own edit convention)
    // and the target becomes a field in place — the same esa-text-field the
    // ghost row uses, in the same cell the number lives in. Enter/blur
    // commits, Escape restores. An added row's edit replaces its record; a
    // seed row's edit is a browser-local override, and editing it back to
    // the built value clears the override entirely.
    const editTarget = (td: HTMLElement) => {
      const tr = td.closest<HTMLElement>('tr');
      if (!tr || tr.dataset.ghost !== undefined || td.querySelector('esa-text-field')) return;
      const key = rowKey(tr);
      const unit = td.dataset.unit ?? '';
      const current = readTargetOverrides(slug)[key] ?? Number(td.dataset.expected || 0);

      const field = document.createElement('esa-text-field') as Control;
      field.setAttribute('label', 'Target');
      field.setAttribute('size', 'md');
      field.setAttribute('inputmode', 'decimal');
      if (unit) field.setAttribute('suffix', unit);
      field.value = String(current);
      td.replaceChildren(field);

      let closed = false;
      const finish = (commit: boolean) => {
        if (closed) return;
        closed = true;
        if (commit) {
          const next = Number(String(field.value ?? '').replace(/,/g, ''));
          if (Number.isFinite(next) && next > 0) {
            if (tr.dataset.addedMeasure) {
              addProjectMeasure(slug, { measureSlug: tr.dataset.addedMeasure, target: next });
              td.dataset.expected = String(next);
            } else {
              const base = Number(td.dataset.expected || 0);
              setTargetOverride(slug, key, next === base ? null : next);
            }
          }
        }
        paintRow(tr);
      };

      field.addEventListener('keydown', (event) => {
        const k = (event as KeyboardEvent).key;
        if (k === 'Enter') {
          event.preventDefault();
          event.stopPropagation();
          finish(true);
        } else if (k === 'Escape') {
          event.preventDefault();
          event.stopPropagation();
          finish(false);
        }
      });
      field.addEventListener('focusout', () => finish(true));

      requestAnimationFrame(() => {
        const input = field.shadowRoot?.querySelector<HTMLInputElement>('input');
        input?.focus();
        input?.select();
      });
    };

    tbody.addEventListener('dblclick', (event) => {
      const td = (event.target as Element).closest<HTMLElement>('.firma2-project-measure-row__total');
      if (td) editTarget(td);
    });

    // ---- the entry sheet --------------------------------------------------
    const lede = root.querySelector<HTMLElement>('[data-entry-lede]');
    const yearField = root.querySelector<Control>('[data-entry-year]');
    const amountField = root.querySelector<Control>('[data-entry-amount]');
    const questions = root.querySelector<HTMLElement>('[data-entry-questions]');
    const autos = root.querySelector<HTMLElement>('[data-entry-autos]');
    const logBlock = root.querySelector<HTMLElement>('[data-entry-log-block]');
    const log = root.querySelector<HTMLElement>('[data-entry-log]');

    const activity = root.querySelector<Control>('[data-entry-activity]');
    const entryBody = root.querySelector<HTMLElement>('[data-entry-body]');

    let entryKey = '';
    let entryUnit = '';
    let activityMode = false;

    /** The measure's hand-answered schemas, resolved through the live store. */
    const reportedSchemasOf = (cat: PerformanceMeasureDefinition | null) =>
      (cat?.subcategorySchemaIds ?? [])
        .map((id) => allSchemas().find((sch) => sch.id === id))
        .filter((sch): sch is NonNullable<typeof sch> => Boolean(sch));

    /**
     * THE COMBINED VOCABULARY this project can file work under: every
     * subcategory option of every measure on the project, disambiguated by
     * the measure it files into, plus the measure names themselves for the
     * reporter who does think in catalog terms. Alphabetical, so the list
     * reads the same way twice.
     */
    const activityOptions = (): { label: string; value: string }[] => {
      const opts: { label: string; value: string }[] = [];
      for (const tr of realRows()) {
        const key = rowKey(tr);
        const name = nameOf(tr);
        opts.push({ label: name, value: `m|${key}` });
        const cat = catalogFor(key);
        for (const schema of reportedSchemasOf(cat).filter((sch) => sch.origin !== 'system')) {
          for (const option of schema.options) {
            opts.push({ label: `${option} — ${name}`, value: `o|${key}|${schema.name}|${option}` });
          }
        }
      }
      return opts.sort((a, b) => a.label.localeCompare(b.label));
    };

    const paintLog = () => {
      if (!log || !logBlock) return;
      const entries = readEntries(slug).filter((e) => e.measureKey === entryKey);
      logBlock.hidden = entries.length === 0;
      log.replaceChildren();
      for (const e of entries) {
        const li = document.createElement('li');
        li.className = 'firma2-project-measures__entry-row';
        li.dataset.entryId = e.id;
        const text = document.createElement('span');
        text.className = 'typography-body-sm';
        const answers = Object.values(e.answers).join(' \u00b7 ');
        text.textContent = `${e.year} \u00b7 ${fmtNum(e.amount)} ${entryUnit}${answers ? ` \u00b7 ${answers}` : ''}`;
        li.append(text);
        const remove = cloneButton(
          removeTemplate,
          'firma2-project-measures__entry-remove',
          `Remove the ${e.year} entry of ${fmtNum(e.amount)} ${entryUnit}`,
        );
        if (remove) li.append(remove);
        log.append(li);
      }
    };

    const openEntryFor = (tr: HTMLElement, prefill?: { schemaName: string; option: string }) => {
      if (!yearField || !amountField || !questions || !autos || !lede || !entryBody) return;
      entryKey = rowKey(tr);
      const catalog = catalogFor(entryKey);
      const total = tr.querySelector<HTMLElement>('.firma2-project-measure-row__total');
      entryUnit = total?.dataset.unit || catalog?.unit || '';

      sheet.heading = nameOf(tr);
      lede.hidden = false;
      entryBody.hidden = false;
      lede.textContent = `Filed by ${catalog ? measureKind(catalog.kind).reportedBy : 'the project'}.`;

      const years = axisYears();
      yearField.options = [...years].reverse().map((y) => ({ label: String(y), value: String(y) }));
      yearField.value = years.length > 0 ? String(years[years.length - 1]) : '';

      amountField.value = '';
      amountField.errorText = '';
      if (entryUnit) amountField.setAttribute('suffix', entryUnit);
      else amountField.removeAttribute('suffix');
      const guidance = catalog?.reporterGuidance?.trim() ?? '';
      if (guidance) amountField.setAttribute('help-text', guidance);
      else amountField.removeAttribute('help-text');

      // The measure's own questions — one optional dropdown per subcategory
      // schema the reporter answers by hand; the system's are named, not
      // asked. An activity pick arrives with its question ALREADY answered.
      questions.replaceChildren();
      const schemas = reportedSchemasOf(catalog);
      for (const schema of schemas.filter((s) => s.origin !== 'system')) {
        const select = document.createElement('esa-select') as Control;
        select.setAttribute('label', schema.name);
        select.setAttribute('size', 'md');
        select.setAttribute('placeholder', 'Optional');
        select.setAttribute('data-entry-question', schema.name);
        select.options = schema.options.map((o) => ({ label: o, value: o }));
        if (prefill && prefill.schemaName === schema.name) select.value = prefill.option;
        questions.append(select);
      }
      const free = schemas.filter((s) => s.origin === 'system');
      autos.hidden = free.length === 0;
      autos.textContent =
        free.length > 0 ? `Added automatically: ${free.map((s) => s.name).join(', ')}.` : '';

      paintLog();
    };

    /** The per-row, measure-first path. */
    const openEntry = (tr: HTMLElement) => {
      activityMode = false;
      if (activity) activity.hidden = true;
      openEntryFor(tr);
      sheet.show();
    };

    /**
     * The section-level, ACTIVITY-FIRST path: the sheet opens on the one
     * question a reporter can always answer — what they did — and the rest
     * of the form appears once that answer has resolved the measure.
     */
    const openRecorder = () => {
      if (!activity || !entryBody || !lede) return;
      activityMode = true;
      entryKey = '';
      activity.hidden = false;
      activity.value = '';
      activity.options = activityOptions();
      entryBody.hidden = true;
      lede.hidden = false;
      lede.textContent = 'Say what you did — it files under the right measure.';
      sheet.heading = 'Record work';
      sheet.show();
      requestAnimationFrame(() => {
        (activity.shadowRoot?.querySelector<HTMLElement>('input') ?? activity).focus();
      });
    };

    activity?.addEventListener('change', () => {
      const raw = String(activity.value ?? '');
      if (!raw) return;
      const parts = raw.split('|');
      const key = parts[1];
      const tr = realRows().find((r) => rowKey(r) === key);
      if (!tr) return;
      openEntryFor(
        tr,
        parts[0] === 'o' ? { schemaName: parts[2], option: parts.slice(3).join('|') } : undefined,
      );
      requestAnimationFrame(() => {
        (amountField?.shadowRoot?.querySelector<HTMLElement>('input') ?? amountField)?.focus();
      });
    });

    root
      .querySelector('[data-firma2-pm-record-work]')
      ?.addEventListener('click', () => openRecorder());

    // THE DEEP LINK. The Projects index's peek sheet carries a "Record work"
    // primary that lands here as <project>#record-work — the recorder is this
    // section's, so arriving with intent opens it the same way the header
    // button does. The hash is cleared once honoured: reload should show the
    // page, not re-open a sheet the reader already dismissed.
    if (window.location.hash === '#record-work') {
      history.replaceState(null, '', window.location.pathname + window.location.search);
      requestAnimationFrame(() => openRecorder());
    }

    tbody.addEventListener('click', (event) => {
      const btn = (event.target as Element).closest('.firma2-project-measures__record');
      const tr = btn?.closest<HTMLElement>('tr');
      if (tr) openEntry(tr);
    });

    root.querySelector('[data-entry-done]')?.addEventListener('click', () => sheet.close());

    root.querySelector('[data-entry-save]')?.addEventListener('click', () => {
      if (!yearField || !amountField || !questions) return;
      const amount = Number(String(amountField.value ?? '').replace(/,/g, ''));
      if (!Number.isFinite(amount) || amount <= 0) {
        amountField.errorText = 'Enter the figure for this period.';
        return;
      }
      amountField.errorText = '';
      const year = Number(String(yearField.value ?? ''));
      const answers: Record<string, string> = {};
      questions.querySelectorAll<Control>('[data-entry-question]').forEach((q) => {
        const v = String(q.value ?? '');
        const name = q.getAttribute('data-entry-question') ?? '';
        if (v && name) answers[name] = v;
      });
      addEntry(slug, { measureKey: entryKey, year, amount, answers });

      // Batch-friendly: the entry lands in the log and the table, the figure
      // clears for the next one, the period holds. On the activity path the
      // answers hold too — the picked activity IS the answer, and the next
      // load of the same work should not have to restate it.
      paintLog();
      paintAllRows();
      amountField.value = '';
      if (!activityMode) {
        questions.querySelectorAll<Control>('[data-entry-question]').forEach((q) => {
          q.value = '';
        });
      }
      amountField.focus();
    });

    log?.addEventListener('click', (event) => {
      const btn = (event.target as Element).closest('.firma2-project-measures__entry-remove');
      const li = btn?.closest<HTMLElement>('[data-entry-id]');
      if (!li?.dataset.entryId) return;
      removeEntry(slug, li.dataset.entryId);
      paintLog();
      paintAllRows();
    });

    // ---- boot -------------------------------------------------------------
    paintAdded();
    ensureGhost();
  });
</script>
