---
// firma2-project-measures — the performance-measures section of a project's
// detail page: every measure the project committed to, and what it has
// reported against that commitment. It is the section a reader uses to judge
// delivery, which is why the number leads: "8.6 of 8.6 miles shaded" is the
// fact that settles an argument, and a ring on its own throws the magnitude
// away.
//
// RING, NOT A BAR. A linear esa-progress-bar was the row here; a circular
// bcn-progress-ring (../shared/bcn-progress-ring.astro) is now — the same
// completion ratio, read as a shape a reader takes in at a glance rather
// than a number they have to read off an axis. See that component's own
// header for why it is hand-built rather than esa-chart's `donut` type, and
// why it matches esa-progress-bar's exact fill/track tokens.
//
// THE VALUE LEADS; THE RING SUPPORTS IT. esa-stat renders "34.1 acres" at
// display-sm — the biggest thing in the row — with the measure's own name
// underneath it and "of 62 acres expected" below that. The ring sits beside
// it at a supporting size. That ordering is the point of this redesign: the
// two raw numbers are what settle an argument about delivery, the ring is a
// glance-able summary of the same fact, and glance-able is not the same as
// important.
//
// THE RING IS DECORATIVE, ON PURPOSE — `decorative` defaults true and is left
// at its default here. Everything the ring shows is already stated more
// precisely as text two inches to its right: "34.1 of 62 acres" IS the ratio
// the ring draws, to more decimal places than a rounded arc could. Giving the
// ring its own accessible name as well — the way the bar it replaces had to,
// because the bar WAS the only place the ratio lived — would read the
// measure's name twice in a row to anyone using a screen reader. Nothing is
// lost by hiding a shape that duplicates adjacent text; see bcn-progress-
// ring's own header for the fuller version of this argument.
//
// UNDER-DELIVERY IS STILL NOT AN ALARM. Same call the bar made: no variant
// prop turns the ring amber or red past some threshold. The two numbers are
// the finding, and colouring the ring would be this component editorialising
// about a project it knows nothing about.
//
// THE ZERO CASE IS STILL NOT AN EMPTY STATE. A project in Proposal or
// Planning & Design has reported nothing against any measure, which is most
// of the portfolio at any moment. The targets are still the information —
// what this project has promised to do — so the rows render with the ring
// empty and the value reading "0 acres". Nothing here says work has not
// started: the stage pill in the page header already says it.
import EsaCard from '@esa/ecology/esa-card.astro';
import '../shared/firma2-card-section.css';
import EsaStat from '@esa/ecology/esa-stat.astro';
import BcnProgressRing from '../shared/bcn-progress-ring.astro';
// esa-icon-button is the name in the house convention for this affordance, but
// reading it shows it was deprecated (2026-08-14) into a shim that forwards
// verbatim to `<EsaButton variant="chrome" iconOnly>` and console.warns on every
// render. Calling the real component renders byte-identical markup without the
// build noise.
import EsaButton from '@esa/ecology/esa-button.astro';
import type { PerformanceMeasure } from '../../data/firma2-project-detail';

interface Props {
  /**
   * The project's measures, in the order the project reports them. Deliberately
   * not re-sorted here: a project's measure list has an authored order (the
   * headline measure first, its supporting measures after) and sorting by
   * percent complete would put the least-delivered measure at the top of every
   * card, which is a judgement this section is not making.
   */
  measures: PerformanceMeasure[];
}

const { measures } = Astro.props;

// Thousands separators, and NO fixed fraction count. `reported` carries one
// decimal for continuous units (acres, miles, acre-feet, cfs) and a whole
// number for counts, and the two live in the same column — force two decimals
// and "4 crossings" becomes "4.00 crossings", which reads as fabricated data.
// Intl's default (up to 3 fraction digits, none padded) prints each as authored.
const fmt = (n: number): string => n.toLocaleString('en-US');

// Percent for the ring's fill. Rounded, because an unrounded 55.16129032258065
// would be a false precision the ring cannot even render — but never rounded UP
// to a full ring: 99.6% of a target is not delivered, and a ring that reads full
// while the numbers beside it disagree is the kind of small lie that costs a
// prototype its credibility.
const percentOf = ({ reported, expected }: PerformanceMeasure): number => {
  if (expected <= 0) return 0;
  const raw = (reported / expected) * 100;
  if (raw >= 100) return 100;
  const rounded = Math.round(raw);
  return rounded === 100 ? 99 : rounded;
};
---
{measures.length > 0 && (
  <EsaCard title="Performance measures">
    <!-- ADD, not edit. This section is a COLLECTION, and that is what separates
         it from Key facts and Description: those hold scalar values, so each one
         got a per-field affordance that appears on hover and edits in place,
         and their section pencils went away. A set has no single field to
         hover — you add to it, remove from it, reorder it — so the section
         keeps one control and it names the act it actually performs. "Edit
         <section>" was the old pencil's label and it was vague about which of
         those it meant.

         Still inert: nothing is wired behind it yet. It is a real, enabled
         <button> so the eventual handler has somewhere to land, and
         deliberately not `disabled` — disabled claims the action is
         unavailable to THIS user, which is a different and false statement.
         Per-row editing and removal inside this section are not built yet. -->
    <EsaButton slot="actions" variant="chrome" size="sm" icon="plus">Add measure</EsaButton>

    <!-- A <ul>: this is a countable set of peers, and the list role is what
         tells a screen-reader user there are three of these before they start
         through them. `role="list"` is not redundant — Safari drops list
         semantics from a <ul> the moment `list-style: none` is applied, which
         is exactly what the CSS below does. -->
    <ul class="firma2-project-measures__list stack" data-gap="lg" role="list">
      {measures.map((measure) => (
        <li class="firma2-project-measures__measure cluster" data-gap="md">
          <BcnProgressRing value={percentOf(measure)} />
          <!-- ONE expression, not `{a} of {b} {unit}`. A whitespace-only text
               node sitting between two adjacent expressions is dropped by the
               compiler, so the separated form rendered "34.1 of 62acres" — the
               " of " survived because it is text WITH content, and the lone
               space before the unit did not. A template literal puts the
               spacing inside the expression where nothing can collapse it. -->
          <EsaStat
            value={`${fmt(measure.reported)} ${measure.unit}`}
            label={measure.name}
            sub={`of ${fmt(measure.expected)} ${measure.unit} expected`}
          />
        </li>
      ))}
    </ul>
  </EsaCard>
)}

<style>
  /* .stack is the engine; this only strips the list chrome that comes with
     choosing <ul> for its semantics. layouts.css already zeroes the UA margin
     at :where(), but not the padding-inline-start that carries the markers. */
  .firma2-project-measures__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The two knobs .cluster exposes to its own children, and nothing else — a
     wrapping flex row, centred on the cross axis so the ring lines up against
     the stat block's VALUE line rather than its vertical middle (esa-stat's
     three stacked lines make "vertical middle" land somewhere inside the
     label, which reads as misaligned). No bespoke flex is authored here. */
  .firma2-project-measures__measure {
    align-items: center;
  }
</style>
