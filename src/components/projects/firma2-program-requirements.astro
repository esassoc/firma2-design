---
// firma2-program-requirements — on a project shared with a program, that
// program's minimum as a checklist: what is done, what is missing, and the
// missing answers filled in right here (.scratch/connected-orgs/spec.md,
// decision 7: "items the organization doesn't track appear as a program
// section on the project").
//
// THE FIVE QUESTIONS (brief §5).
// 1. The question: what does this program still need from this project?
// 2. Readers: the organization's Contributor who reports to the program, and a
//    manager checking a project before a program deadline. Hardest is the
//    Contributor who never saw the program's requirements — so the section
//    carries the program's name in its title and its own guide one click away.
//    Not here: the program's staff, who read the same answers live in their
//    workspace, and see the project marked incomplete there until it is
//    answered (decision 9).
// 3. Series or scalar: scalars — each item is one value. It sits in the main
//    column, not the rail, because it is READ as a list of what is left; the
//    rail is the property sheet, and these are the program's properties.
// 4. Irreversible: nothing. Answers save like every record field.
// 5. Cut: a lead sentence explaining the program; six rows for core facts the
//    record already holds (they fold into one); per-item icons beyond the
//    done/missing mark.
//
// GENERATED, NEVER AUTHORED. The rows come from the program's minimum
// (src/data/firma2-program-requirements.ts): core facts checked against the
// record, the program's own fields against the stored answers, its measures
// against the project's own measures by catalog measure. A program that adds a
// field adds a row here (decision 10).
//
// ANSWERED IN PLACE, WITH THE RECORD'S IDIOM. An organization field is a
// firma2-editable-field like every other record value: read-only until Edit,
// then click, type, leave. A funder-owned field (decision 12) is read here and
// set by the program. Core facts and measures are answered where they live
// on the page, so their rows only report.
//
// bcn-lego-checked: esa-card is the section (the main column's convention,
// firma2-card-section.css), esa-badge the status, esa-icon the done/missing
// marks (the same glyphs firma2-project-timeline uses), esa-button the guide
// link, firma2-editable-field every answer. No esa- lego is a checklist. The
// only CSS is the marker column and the read-only rows' alignment with the
// editable rows' glyphs. Beacon is not cloned on this machine.
import EsaCard from '@esa/ecology/esa-card.astro';
import '../shared/firma2-card-section.css';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import Firma2EditableField from '../shared/firma2-editable-field.astro';
import { programSections } from '../../data/firma2-program-requirements';
import type { ProjectDetail } from '../../data/firma2-project-detail';
import { withBase } from '../../lib/base';

interface Props {
  detail: ProjectDetail;
}

const sections = programSections(Astro.props.detail);
// Every open row counts, not only the ones answered here: a performance measure the
// program needs is still missing until a figure is reported in Performance measures.
const toAnswer = (items: { done: boolean }[]) => items.filter((i) => !i.done).length;

const CIRCLE = '<circle cx="12" cy="12" r="10"></circle>';
---
{sections.map(({ program, items }) => (
  <section class="firma2-program-requirements" data-program={program.id}>
    <EsaCard title={`${program.name} requirements`}>
      <span slot="actions" class="cluster" data-gap="sm">
        <span data-program-open style={toAnswer(items) ? undefined : 'display: none'}>
          <EsaBadge value={`${toAnswer(items)} missing`} variant="warning" size="md" />
        </span>
        <span data-program-complete style={toAnswer(items) ? 'display: none' : undefined}>
          <EsaBadge value="Complete" variant="success" size="md" />
        </span>
        {program.guide && (
          <EsaButton variant="chrome" size="sm" tag="a" href={withBase(program.guide.href)}>Program guide</EsaButton>
        )}
      </span>

      <ul class="firma2-program-requirements__list stack" data-gap="sm" role="list">
        {items.map((item) => (
          <li
            class="firma2-program-requirements__item"
            data-requirement={item.key}
            data-answerable={item.answerable ? '' : undefined}
            data-done={item.done ? '' : undefined}
          >
            <span class="firma2-program-requirements__marker">
              <span class="firma2-program-requirements__done"><EsaIcon name="circle-check" size="sm" label="Done" /></span>
              <span class="firma2-program-requirements__missing"><EsaIcon name="circle" paths={CIRCLE} size="sm" label="Missing" /></span>
            </span>
            {item.answerable ? (
              <dl class="firma2-program-requirements__row">
                <Firma2EditableField
                  field={item.key}
                  label={item.label}
                  value={item.value}
                  control={item.control}
                  options={item.options}
                  placeholder="Not answered"
                />
              </dl>
            ) : (
              <dl class="firma2-program-requirements__row firma2-program-requirements__fixed stack" data-gap="2xs">
                <dt class="typography-label-sm">{item.label}</dt>
                <dd class:list={['typography-body-md', !item.done && 'firma2-program-requirements__unset']}>
                  {item.done
                    ? item.value
                    : item.programOwned
                      ? `${program.name} fills this in.`
                      : 'Not tracked on this project'}
                </dd>
              </dl>
            )}
          </li>
        ))}
      </ul>
    </EsaCard>
  </section>
))}

<style>
  .firma2-program-requirements__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* marker | row. The marker sits on the label's line, which is where the eye
     starts each row. */
  .firma2-program-requirements__item {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: var(--spacing-200, 0.5rem);
    align-items: start;
  }
  .firma2-program-requirements__marker {
    display: flex;
    /* Centres the 16px mark on the label-sm line above the value. */
    padding-block-start: var(--spacing-050, 0.125rem);
  }
  .firma2-program-requirements__item:not([data-done]) .firma2-program-requirements__done,
  .firma2-program-requirements__item[data-done] .firma2-program-requirements__missing {
    display: none;
  }
  .firma2-program-requirements__done {
    color: var(--color-content-brand, #2a7e3b);
  }
  .firma2-program-requirements__missing {
    color: var(--color-content-default-secondary, #60655f);
  }

  .firma2-program-requirements__row {
    margin: 0;
  }

  /* READ-ONLY ROWS ALIGN WITH THE EDITABLE ONES. An editable value sits inside
     the md control's invisible box — its border plus --spacing-300 of padding —
     and its label is indented to the same glyph edge. These rows have no box,
     so they take the same inset, and the label column reads as one line down
     the list (inline-edit geometry continuity). */
  .firma2-program-requirements__fixed > dt,
  .firma2-program-requirements__fixed > dd {
    margin: 0;
    padding-inline: calc(var(--spacing-300, 0.75rem) + var(--form-border-width, 1px));
  }
  .firma2-program-requirements__fixed > dt {
    color: var(--color-content-default-secondary, #646464);
  }
  .firma2-program-requirements__fixed > dd {
    min-block-size: 40px;
    display: flex;
    align-items: center;
  }
  .firma2-program-requirements__unset {
    color: var(--color-content-default-secondary, #646464);
  }
</style>

<script>
  // An answer committed in place ticks its row and recounts what is left.
  // firma2-editable-field announces every commit as firma2:field-save.
  document.addEventListener('firma2:field-save', (event) => {
    const { field = '', raw = '' } = (event as CustomEvent<{ field?: string; raw?: string }>).detail ?? {};
    if (!field.startsWith('program:')) return;
    const row = document.querySelector<HTMLElement>(`[data-requirement="${CSS.escape(field)}"]`);
    const section = row?.closest<HTMLElement>('.firma2-program-requirements');
    if (!row || !section) return;
    row.toggleAttribute('data-done', raw.trim() !== '');
    const left = section.querySelectorAll('[data-requirement]:not([data-done])').length;
    const open = section.querySelector<HTMLElement>('[data-program-open]')!;
    const complete = section.querySelector<HTMLElement>('[data-program-complete]')!;
    open.style.display = left ? '' : 'none';
    complete.style.display = left ? 'none' : '';
    const text = open.querySelector('.esa-badge__text');
    if (text) text.textContent = `${left} missing`;
  });
</script>
