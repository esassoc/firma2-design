---
// firma2-project-facts — the project record's PROPERTIES: the structured
// attributes that live on the ProjectFirma project RECORD (stage, project type,
// classifications, lead organization, county, timeline, estimated cost)
// and nothing else. It is the row from the Projects table, turned on its side
// for the one project you opened. Two layouts, one list of fields:
//
//   list   — the "Key facts" section of the record rail: every property,
//            labels above values, one column, at 22rem.
//   strip  — the four a reader needs to place the numbers (Stage, Timeline,
//            Estimated cost, Lead organization), in one row under the page
//            title. The main column's own copy of what the rail holds.
//
// THE STRIP REPEATS THE RAIL ON PURPOSE (user, 2026-10-22, after Linear's
// project overview). Linear's main column opens with a strip of the properties
// that identify the project — status, lead, dates — and its sidebar carries the
// same properties as the complete, labelled sheet. Both edit through the same
// control. The strip is what the main column reads against when the rail is
// collapsed or has unpinned on a narrow screen; the rail is the full record.
// Neither is a copy of the other's markup: both render THIS component, and the
// same firma2-editable-field rows, so a commit in one repaints the other
// (firma2-editable-field's mirrorSave) and there is one edit path, not two.
//
// WHAT THE STRIP DOES NOT CARRY. County, Project type and Classifications
// stay rail-only: the strip's job is identity at a glance, not
// completeness, and the rail is one click away. No "…" overflow either —
// Linear's strip has one, and ours stops at four because the full list is
// already on screen beside it.
//
// THE DESCRIPTION IS NOT A PROPERTY. It was the last row of this panel for
// two releases, and it has left for the main column — firma2-project-description
// says why. `showDescription` keeps it here for the one surface that has no
// main column to put it in: the project peek.
//
// SUBTRACTIVE. Only fields that already exist on the record are here. No derived
// roll-ups, no counts of things rendered further down the page. A panel that
// restated the funding section's total or the milestone section's next date
// would be a second, worse copy of them.
//
// THE LABELS ARE THE TABLE'S COLUMN HEADERS, VERBATIM — "Classifications",
// "Lead organization", "County", "Timeline", "Estimated cost" all appear as
// `headerName`s in firma2-project-grid. Same datum, same word, in both
// places: a reader who filtered the index by Classification should not have
// to work out that this panel's differently-named row is the field they
// filtered on.
//
// LAYOUT (list) — labels ABOVE values, one column. This panel renders inside the
// page's record rail at roughly 22rem. Beside-style label/value columns
// would split that into ~10rem each, and the real values are long
// ("Meadow & wetland restoration", "Deer Creek Watershed Alliance"): every
// other pair would wrap to three or four ragged lines. Stacked, each value
// gets the full column and most fit on one line.
//
// LAYOUT (strip) — the same label-over-value pairs, side by side in a
// `.cluster`: each pair takes the width its value needs and the row wraps
// where it runs out, which is how Linear's strip behaves. An equal-column
// `.grid` was tried first (2026-10-22) and at 704px it gave every pair 158px,
// which folded "Deer Creek Watershed Alliance" into three lines beside three
// one-line values. Content-sized, the four fit one row in the main column and
// fall two and two on a phone.
//
// NOT A CARD, and firma2-rail-section owns that argument: the rail is already a
// bounded column, so a card in here drew a second box one step inside the
// first. What is left is the rows and the space between them. The strip is not
// a card either, for the same reason the page title above it is not: it is
// part of the record's header, not a section of its body.
//
// STAGE LEADS THE LIST, READ-ONLY. It spent 2026-08 to 2026-10-19 beside the
// title in the page header instead, and so was cut from here; when the header
// became the thin top bar it sat among the bar's controls, and the user ruled
// it out of the bar (2026-10-19). So it is back where this panel always said it
// belonged without a header: a labelled pair, the label answering whether
// "Implementation" is a stage or a type. It is a badge, not an editable field,
// because stage moves through the review workflow, not by retyping it. The
// peek passes `showStage={false}` — its own header already carries the pill.
//
// bcn-lego-checked: every row IS a lego or a spoke component — firma2-editable-
// field for the values, esa-badge for the stage, firma2-rail-section for the
// list's shell; the strip's arrangement is the hub's `.grid` primitive with its
// own `--grid-min` knob. No esa- lego renders a property strip (walked the
// catalog: esa-stat is a metric tile, esa-page-header has no property slot);
// Beacon is not cloned on this machine. Nothing here is hand-rolled flex.
import Firma2RailSection from '../shared/firma2-rail-section.astro';
import Firma2EditableField from '../shared/firma2-editable-field.astro';
import Firma2ProjectDescription from './firma2-project-description.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaCollapsible from '@esa/ecology/esa-collapsible.astro';
import { projects, projectSlug, STAGE_TONE } from '../../data/firma2-projects';
import { badgeTone } from '../../lib/badge-tone';
import { CLASSIFICATIONS, CLASSIFICATION_GROUPS } from '../../data/firma2-classifications';
import { PROJECT_TYPES } from '../../data/firma2-project-types';
import { classificationHref } from '../../data/firma2-classification-rollup';
import { withBase } from '../../lib/base';
import type { ProjectDetail } from '../../data/firma2-project-detail';

interface Props {
  /** The whole detail record; this section reads only `detail.project`. */
  detail: ProjectDetail;
  /**
   * `list` (default) is the rail's full Key facts section. `strip` is the
   * four-property row under the page title — no heading, no description, no
   * section shell.
   */
  layout?: 'list' | 'strip';
  /**
   * Whether the "Key facts" heading is visually hidden. False by default: the
   * rail stacks its sections, so the heading is what says where this one
   * begins. True only on a surface where something else already names it.
   */
  titleHidden?: boolean;
  /** Whether the Stage row leads the list. False where a header already shows the stage (the peek). */
  showStage?: boolean;
  /**
   * Whether the description closes the list. True by default for the peek,
   * which has no main column; the record page passes false, because there the
   * description is a section of the main column (firma2-project-description).
   */
  showDescription?: boolean;
}

const {
  detail,
  layout = 'list',
  titleHidden = false,
  showStage = true,
  showDescription = true,
} = Astro.props;
const { project } = detail;
const strip = layout === 'strip';

// Whole-dollar currency from the shared, side-effect-free formatter module.
// NOT from shared/grid-chrome.ts, which exports the identical Intl.NumberFormat
// but imports ag-grid-community and calls
// `ModuleRegistry.registerModules([AllCommunityModule])` at module scope — so
// reading one formatter off it would pull the whole grid runtime into this
// page's build for four lines of number formatting. That is why src/lib/format.ts
// exists; grid-chrome re-exports from it under the old grid-prefixed names.
import { currencyFormatter as money } from '../../lib/format';

// Options in vocabulary order, and the shown set in the same order, so an
// edited record and an untouched one read alike.
const classificationOptions = CLASSIFICATIONS.map((c) => c.name);
const shownClassifications = classificationOptions.filter((n) => project.classifications.includes(n));

// Hover-card context for EVERY classification in the vocabulary, not just this
// project's — a member added in the editor needs its card the moment it lands.
// The count is real, derived from the portfolio, and it is the one fact that
// makes the card worth raising: "how much of the portfolio shares this goal"
// is exactly the roll-up question classifications exist to answer.
const classificationHrefs = Object.fromEntries(CLASSIFICATIONS.map((c) => [c.name, withBase(classificationHref(c.slug))]));
const groupName = (slug: string) => CLASSIFICATION_GROUPS.find((g) => g.slug === slug)?.name ?? 'Classification';
const classificationCards = Object.fromEntries(
  CLASSIFICATIONS.map((c) => {
    const count = projects.filter((p) => p.classifications.includes(c.name)).length;
    return [
      c.name,
      {
        kind: groupName(c.group),
        title: c.name,
        lines: [`${count} of ${projects.length} projects`],
      },
    ];
  }),
);
---
{strip ? (
  <!-- THE STRIP. A named region rather than a heading: "Key facts" is the
       rail's heading for the full list, and printing it over four values the
       reader can see is the ornamental micro-label design-principles bans.
       The <dl> is a `.cluster` — the same term/value pairs as the list, laid
       side by side at their own widths, wrapping where the row runs out.
       Contents-only wrapper: the field labels name renameable nouns. -->
  <div data-aliasable-labels style="display: contents">
    <section class="firma2-project-facts-strip" aria-label="Key facts">
      <!-- --align: start is the primitive's own knob: the stage pair is shorter
           than a field pair (a 28px badge under its label against a 40px
           box), and centred it sat its label 7px below the other three. -->
      <dl class="firma2-project-facts cluster" data-gap="lg" style="--align: start">
        <div class="firma2-project-facts__stage stack" data-gap="2xs">
          <dt class="typography-label-sm">Stage</dt>
          <dd><EsaBadge value={project.stage} variant={badgeTone(STAGE_TONE[project.stage])} size="md" /></dd>
        </div>
        <Firma2EditableField
          field="timeline"
          label="Timeline"
          value={`${project.implementationStartYear}–${project.completionYear}`}
          editValue={`${project.implementationStartYear},${project.completionYear}`}
          control="year-range"
          format="year-range"
        />
        <Firma2EditableField
          field="estimatedTotalCost"
          label="Estimated cost"
          value={money.format(project.estimatedTotalCost)}
          editValue={String(project.estimatedTotalCost)}
          control="number"
          format="currency"
        />
        <Firma2EditableField
          field="leadOrganization"
          label="Lead organization"
          value={project.leadOrganization}
          href={withBase('/prototypes/projects')}
        />
      </dl>
    </section>
  </div>
) : (
<!-- Contents-only wrapper: the field labels name renameable nouns (src/lib/vocabulary.ts). -->
<div data-aliasable-labels style="display: contents">
<Firma2RailSection title="Key facts" titleHidden={titleHidden}>
  <!-- NO SECTION-LEVEL EDIT CONTROL. There was a pencil here, and it went when
       the fields themselves became editable: every row below now carries its
       own affordance, revealed on hover and on focus, so a section button
       offering "edit the five things underneath" would be a second route to the
       same act — the redundancy design-principles cuts. The collection sections
       on this page (Work areas, Performance measures, Funding sources,
       Milestones) DO keep a header control, because a set has no single field
       to hover: theirs says "Add", which is the thing a per-field affordance
       cannot do. -->

  <!-- A <dl>, because these ARE term/value pairs — the list semantics, the
       dt/dd association, and the "5 items" announcement come free and correct.
       The <div> wrappers are the spec's own grouping form for a dl, and they
       are what lets each pair be a TIGHT stack (label sitting on its value)
       inside a list that breathes between pairs. Two nested .stacks, no
       bespoke flex.

       No margin reset here: layouts.css already zeroes dl/dd at :where(), so
       the UA's `margin: 1em 0` and `dd { margin-inline-start: 40px }` are gone
       before this component loads. Re-declaring them would be dead CSS. -->
  <!-- ONE STACK, ONE STEP. The <dl> spaces its own pairs `md` apart and this
       wrapper repeats that value so the description (peek only) lands exactly
       one row further on. The description cannot simply join the <dl>: it is a
       label, a value AND a disclosure button, and a <dl> grouping <div> admits
       only <dt> and <dd>. -->
  <div class="stack" data-gap="md">
    <!-- GROUPED, AND EACH GROUP FOLDS (user, 2026-10-22: "can we make groups
         of the items in the key facts section, and within those groups the
         ability to collapse or expand them?"). Three groups by what a reader
         is asking: where the work stands and what it costs; who leads it and
         where it is; and how the portfolio files it. Each is the hub's
         esa-collapsible (native details/summary), open by default; a group a
         reader closes stays closed for them (script below). Each keeps its own
         <dl>: the pairs are still term/value.
         BORDERED, the lego's default, not flush (user, 2026-10-23: "can we
         make the sections on the project rail have a border?"): each group
         reads as its own box, so a closed one is still visibly a section. -->
    <div data-facts-group="status">
      <EsaCollapsible title="Status and budget" open>
        <dl class="firma2-project-facts stack" data-gap="md">
          {showStage && (
            <div class="firma2-project-facts__stage stack" data-gap="2xs">
              <dt class="typography-label-sm">Stage</dt>
              <dd><EsaBadge value={project.stage} variant={badgeTone(STAGE_TONE[project.stage])} size="md" /></dd>
            </div>
          )}
          <!-- One row, two controls. The en dash is the range visually; screen readers
               do not reliably voice it, so the component keeps the spoken " to "
               beside an aria-hidden dash — the dash carries the meaning for eyes, the
               word for ears, and only one is ever perceived at a time. Editing opens
               two labelled year boxes, because "2023–2027" is not a string a person
               should have to retype correctly. -->
          <Firma2EditableField
            field="timeline"
            label="Timeline"
            value={`${project.implementationStartYear}–${project.completionYear}`}
            editValue={`${project.implementationStartYear},${project.completionYear}`}
            control="year-range"
            format="year-range"
          />

          <Firma2EditableField
            field="estimatedTotalCost"
            label="Estimated cost"
            value={money.format(project.estimatedTotalCost)}
            editValue={String(project.estimatedTotalCost)}
            control="number"
            format="currency"
          />
        </dl>
      </EsaCollapsible>
    </div>
    <div data-facts-group="organization">
      <EsaCollapsible title="Organization and location" open>
        <dl class="firma2-project-facts stack" data-gap="md">
          <!-- THE VALUE IS ALSO A DOOR. The organization behind this name is a
               record of its own, so the row carries `href` and the field renders
               its ↗ open-link beside the editable value (the Notion/Airtable
               resolution — click edits everywhere, navigation gets its own <a>).
               The spoke has no organization page yet, so the door opens on the
               Projects index — the one page where the org's work is visible; a
               real app resolves the organization's own detail route here. -->
          <Firma2EditableField
            field="leadOrganization"
            label="Lead organization"
            value={project.leadOrganization}
            href={withBase('/prototypes/projects')}
          />

          <Firma2EditableField field="county" label="County" value={project.county} />
        </dl>
      </EsaCollapsible>
    </div>
    <div data-facts-group="classification">
      <EsaCollapsible title="Classification" open>
        <dl class="firma2-project-facts stack" data-gap="md">
          <!-- PROJECT TYPE LEADS THE EDITABLE ROWS: what kind of work this is, and so
               what this record asks and how its page is built (one per project —
               src/data/firma2-project-types.ts). A scalar picked from a closed
               list, so a plain select; changing it changes the fields asked. -->
          <Firma2EditableField
            field="projectType"
            label="Project type"
            value={project.projectType}
            control="select"
            options={PROJECT_TYPES.map((t) => t.name)}
          />

          <!-- CLASSIFICATIONS: the goals this project works toward — the
               portfolio's roll-up axis, each with KPIs that this project's
               measures report into. THE ONE ROW THAT EDITS A SET OF ENTITIES.
               The display is quiet chips (`default` variant, resting 4px
               corner), one per line, because a classification is vocabulary, not
               a state — the colored pill on this page is the Stage row above,
               and it should stay the only one. EACH CHIP IS A LINK to the goal's
               page, and hovering it raises a card with the goal's portfolio
               context — an entity value's most-wanted act is "take me to it", so
               navigation gets the click and editing gets the box: clicking the
               line's empty space (or the keyboard's hidden Edit button) opens the
               multi-select combobox, constrained to the vocabulary: a free-typed
               classification is how a roll-up bucket silently splits in two. -->
          {/* memberHrefs: keyed over the whole vocabulary so a member added in
              the editor arrives with its door. */}
          <Firma2EditableField
            field="classifications"
            label="Classifications"
            value={shownClassifications.join(', ')}
            values={shownClassifications}
            control="multi-select"
            format="list"
            options={classificationOptions}
            memberHrefs={classificationHrefs}
            memberCards={classificationCards}
          />
        </dl>
      </EsaCollapsible>
    </div>

    <!-- PEEK ONLY. The record page has a main column for the description and
         passes showDescription={false}; the peek has nowhere else to put it.
         Renders nothing at all for a record whose sponsor has not written one —
         the component's own guard, so this panel never shows a labelled empty
         box. -->
    {showDescription && <Firma2ProjectDescription description={detail.projectDescription} inline />}
  </div>
</Firma2RailSection>
</div>
)}

<style>
  /* Deliberately no rules for the editable rows' labels or figures. Both moved
     into firma2-editable-field when those rows became editable: it renders the
     same <dt> at `label-sm` / content-default-secondary, and applies
     tabular-nums to the currency and year-range values itself. Restating them
     here would be two declarations that agree today and drift the first time
     one side changes — and the component has to own them anyway, because the
     value it writes back after an edit is built by its own script, not by this
     file.

     That now includes the classifications set: its chips-and-combobox handling
     is the component's format="list" / control="multi-select" mode, so the
     bespoke pair this file briefly carried — and the label/inset rules it had
     to restate for it — are gone with it. */

  /* THE STAGE ROW IS THE ONE PAIR NOT BUILT BY firma2-editable-field, so it
     restates that component's label colour and glyph inset — the expression
     is copied from .firma2-editable-field__head so the labels share one x. */
  .firma2-project-facts__stage {
    padding-inline-start: calc(var(--spacing-300, 0.75rem) + var(--form-border-width, 1px));
  }
  .firma2-project-facts__stage dt {
    color: var(--color-content-default-secondary, #646464);
  }

  /* IN THE STRIP A PAIR IS AS WIDE AS ITS VALUE, which is right at rest and
     wrong the moment a row opens: the text field does not inherit the
     display's width and came up at ~183px, clipping "Deer Creek Watershed
     Alliance" mid-word (measured 2026-10-22). A floor on the edit region keeps
     the whole value in view; the cluster wraps the row if it has to, which is
     what an opened editor may do and a resting one never does. */
  .firma2-project-facts-strip :global([data-field-edit-region]) {
    min-inline-size: 16rem;
  }
</style>

<script>
  // No type guidance on the record: a helper line under the open select would
  // grow the row, and record fields never change size when they open
  // (inline-edit geometry continuity). Guidance shows where types are first
  // chosen — the intake form and New project.

  // A CLOSED GROUP STAYS CLOSED for this reader, on every project and in the
  // peek: Key facts' groups are the same three everywhere, so the choice is
  // per group, not per record. `toggle` does not bubble, so it is heard in
  // the capture phase; groups cloned later (the peek) are set as they appear.
  const GROUPS_KEY = 'firma2-facts-groups-closed';
  const closedGroups = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(GROUPS_KEY) ?? '[]');
    } catch {
      return [];
    }
  };
  const applyGroups = (root: ParentNode = document): void => {
    const closed = closedGroups();
    root.querySelectorAll<HTMLElement>('[data-facts-group]').forEach((group) => {
      const details = group.querySelector('details');
      if (details && closed.includes(group.dataset.factsGroup ?? '')) details.open = false;
    });
  };
  applyGroups();
  new MutationObserver((records) => {
    records.forEach((r) => r.addedNodes.forEach((n) => n instanceof Element && applyGroups(n)));
  }).observe(document.body, { childList: true, subtree: true });
  document.addEventListener(
    'toggle',
    (event) => {
      const details = event.target as HTMLDetailsElement;
      const key = details.closest<HTMLElement>('[data-facts-group]')?.dataset.factsGroup;
      if (!key || !(details instanceof HTMLDetailsElement)) return;
      const closed = new Set(closedGroups());
      if (details.open) closed.delete(key);
      else closed.add(key);
      try {
        localStorage.setItem(GROUPS_KEY, JSON.stringify([...closed]));
      } catch {
        /* private window: the choice lasts as long as the page */
      }
    },
    true,
  );
</script>
