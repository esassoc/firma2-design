---
// firma2-project-facts — the "Key facts" panel in the project detail page's
// aside: the structured attributes that live on the ProjectFirma project RECORD
// (project type, classifications, tags, lead organization, county, timeline,
// estimated cost) and the sponsor's own description of the work, and nothing else. It is
// the row from the Projects table, turned on its side for the one project you
// opened.
//
// SUBTRACTIVE. Only fields that already exist on the record are here. No derived
// roll-ups, no counts of things rendered further down the page. A panel that
// restated the funding section's total or the milestone section's next date
// would be a second, worse copy of them.
//
// THE DESCRIPTION IS THE LAST ROW, and it is delegated rather than inlined —
// firma2-project-description owns it, because it is the one field here that does
// not fit on a line and so carries a measured three-line clamp and a disclosure
// of its own. That component states why the description belongs in this panel at
// all, and why it comes last. This file only places it.
//
// THE LABELS ARE THE TABLE'S COLUMN HEADERS, VERBATIM — "Classifications",
// "Lead organization", "County", "Timeline", "Estimated cost" all appear as
// `headerName`s in firma2-project-grid. Same datum, same word, in both
// places: a reader who filtered the index by Classification should not have
// to work out that this panel's differently-named row is the field they
// filtered on.
//
// LAYOUT — labels ABOVE values, one column. This panel renders inside the
// page's record rail at roughly 22rem. Beside-style label/value columns
// would split that into ~10rem each, and the real values are long
// ("Meadow & wetland restoration", "Deer Creek Watershed Alliance"): every
// other pair would wrap to three or four ragged lines. Stacked, each value
// gets the full column and most fit on one line.
//
// NOT A CARD, and firma2-rail-section owns that argument: the rail is already a
// bounded column, so a card in here drew a second box one step inside the
// first. What is left is the rows and the space between them — the title now
// rides on the tab above (see `titleHidden` on the section below).
//
// STAGE IS NOT HERE, AND THAT IS A PAGE-LEVEL DECISION, not an oversight.
// This panel originally opened with a labelled "Stage" pair, on the reasoning
// that stage is a field on the record exactly like the other five and that an
// unlabelled pill invites a reader to guess whether "Implementation" is a
// lifecycle stage or a project type. That reasoning is sound and the label
// survives — it just moved. The project's stage now renders once, beside the
// title in the page header, where it is the record's headline status and stays
// with the name a reader arrived looking for; the header carries a
// visually-hidden "Stage" so the pill is never an unlabelled colour to a
// screen reader. Rendering it in both places would have been the same fact
// twice on one screen, which design-principles cuts.
//
// If this panel is ever reused on a surface with no page header — a drawer, a
// comparison column — the stage pair belongs back at the top of the list.
import Firma2RailSection from '../shared/firma2-rail-section.astro';
import Firma2EditableField from '../shared/firma2-editable-field.astro';
import Firma2ProjectDescription from './firma2-project-description.astro';
import { projects, projectSlug } from '../../data/firma2-projects';
import { CLASSIFICATIONS, CLASSIFICATION_GROUPS } from '../../data/firma2-classifications';
import { PROJECT_TYPES } from '../../data/firma2-project-types';
import { TAGS } from '../../data/firma2-tags';
import { classificationHref } from '../../data/firma2-classification-rollup';
import { withBase } from '../../lib/base';
import type { ProjectDetail } from '../../data/firma2-project-detail';

interface Props {
  /** The whole detail record; this section reads only `detail.project`. */
  detail: ProjectDetail;
  /**
   * Whether the "Key facts" heading is visually hidden. True on the detail
   * page, where the rail tab above the panel already reads "Key facts" (see
   * the note on the markup); false on a surface with no tab naming it — the
   * project peek sheet — where the heading is the only thing that says where
   * the progress rows end and the record's facts begin.
   */
  titleHidden?: boolean;
}

const { detail, titleHidden = true } = Astro.props;
const { project } = detail;

// Whole-dollar currency from the shared, side-effect-free formatter module.
// NOT from shared/grid-chrome.ts, which exports the identical Intl.NumberFormat
// but imports ag-grid-community and calls
// `ModuleRegistry.registerModules([AllCommunityModule])` at module scope — so
// reading one formatter off it would pull the whole grid runtime into this
// page's build for four lines of number formatting. That is why src/lib/format.ts
// exists; grid-chrome re-exports from it under the old grid-prefixed names.
import { currencyFormatter as money } from '../../lib/format';

// Options in vocabulary order, and the shown set in the same order, so an
// edited record and an untouched one read alike.
const classificationOptions = CLASSIFICATIONS.map((c) => c.name);
const shownClassifications = classificationOptions.filter((n) => project.classifications.includes(n));
const tagOptions = TAGS.map((t) => t.name);
const shownTags = tagOptions.filter((n) => project.tags.includes(n));

// Hover-card context for EVERY classification in the vocabulary, not just this
// project's — a member added in the editor needs its card the moment it lands.
// The count is real, derived from the portfolio, and it is the one fact that
// makes the card worth raising: "how much of the portfolio shares this goal"
// is exactly the roll-up question classifications exist to answer.
const classificationHrefs = Object.fromEntries(CLASSIFICATIONS.map((c) => [c.name, withBase(classificationHref(c.slug))]));
const groupName = (slug: string) => CLASSIFICATION_GROUPS.find((g) => g.slug === slug)?.name ?? 'Classification';
const classificationCards = Object.fromEntries(
  CLASSIFICATIONS.map((c) => {
    const count = projects.filter((p) => p.classifications.includes(c.name)).length;
    return [
      c.name,
      {
        kind: groupName(c.group),
        title: c.name,
        lines: [`${count} of ${projects.length} projects work toward this goal`],
      },
    ];
  }),
);
---
<!-- TITLE HIDDEN by default: this panel is the first tab of the record rail,
     and the tab above it already reads "Key facts". The heading stays in the
     document so the region is still named for a screen reader — see the prop's
     note in firma2-rail-section. A surface with no tab (the project peek
     sheet) passes titleHidden={false} and the heading comes back. -->
<!-- Contents-only wrapper: the field labels name renameable nouns (src/lib/vocabulary.ts). -->
<div data-aliasable-labels data-tags-project={projectSlug(project)} style="display: contents">
<Firma2RailSection title="Key facts" titleHidden={titleHidden}>
  <!-- NO SECTION-LEVEL EDIT CONTROL. There was a pencil here, and it went when
       the fields themselves became editable: every row below now carries its
       own affordance, revealed on hover and on focus, so a section button
       offering "edit the five things underneath" would be a second route to the
       same act — the redundancy design-principles cuts. The collection sections
       on this page (Work areas, Performance measures, Funding sources,
       Milestones) DO keep a header control, because a set has no single field
       to hover: theirs says "Add", which is the thing a per-field affordance
       cannot do. -->

  <!-- A <dl>, because these ARE term/value pairs — the list semantics, the
       dt/dd association, and the "5 items" announcement come free and correct.
       The <div> wrappers are the spec's own grouping form for a dl, and they
       are what lets each pair be a TIGHT stack (label sitting on its value)
       inside a list that breathes between pairs. Two nested .stacks, no
       bespoke flex.

       No margin reset here: layouts.css already zeroes dl/dd at :where(), so
       the UA's `margin: 1em 0` and `dd { margin-inline-start: 40px }` are gone
       before this component loads. Re-declaring them would be dead CSS. -->
  <!-- ONE STACK, ONE STEP. The <dl> spaces its own pairs `md` apart and this
       wrapper repeats that value so the description below lands exactly one row
       further on — six rows at one rhythm, not five rows and an appendix. The
       description cannot simply join the <dl>: it is a label, a value AND a
       disclosure button, and a <dl> grouping <div> admits only <dt> and <dd>. So
       the list keeps the five pairs it can express honestly and the stack is
       what carries the last. -->
  <div class="stack" data-gap="md">
    <dl class="firma2-project-facts stack" data-gap="md">
      <!-- PROJECT TYPE LEADS THE PANEL: what kind of work this is, and so
           what this record asks and how its page is built (one per project —
           src/data/firma2-project-types.ts). A scalar picked from a closed
           list, so a plain select; changing it changes the fields asked. -->
      <Firma2EditableField
        field="projectType"
        label="Project type"
        value={project.projectType}
        control="select"
        options={PROJECT_TYPES.map((t) => t.name)}
      />

      <!-- CLASSIFICATIONS: the goals this project works toward — the
           portfolio's roll-up axis, each with KPIs that this project's
           measures report into. THE ONE ROW THAT EDITS A SET OF ENTITIES.
           The display is quiet chips (`default` variant, resting 4px
           corner), one per line, because a classification is vocabulary, not
           a state — the colored pill on this page is the stage in the header,
           and it should stay the only one. EACH CHIP IS A LINK to the goal's
           page, and hovering it raises a card with the goal's portfolio
           context — an entity value's most-wanted act is "take me to it", so
           navigation gets the click and editing gets the box: clicking the
           line's empty space (or the keyboard's hidden Edit button) opens the
           multi-select combobox, constrained to the vocabulary: a free-typed
           classification is how a roll-up bucket silently splits in two. -->
      {/* memberHrefs: keyed over the whole vocabulary so a member added in
          the editor arrives with its door. */}
      <Firma2EditableField
        field="classifications"
        label="Classifications"
        value={shownClassifications.join(', ')}
        values={shownClassifications}
        control="multi-select"
        format="list"
        options={classificationOptions}
        memberHrefs={classificationHrefs}
        memberCards={classificationCards}
      />

      <!-- TAGS: functional labels with no KPIs (src/data/firma2-tags.ts). A
           set like classifications, so the same chips and combobox — but no
           door and no card: a tag has no page of its own, and the Projects
           grid's Tags filter is where "which projects are tagged this" is
           answered. Chips without a destination are the field's own edit
           buttons. -->
      <Firma2EditableField
        field="tags"
        label="Tags"
        value={shownTags.join(', ')}
        values={shownTags}
        control="multi-select"
        format="list"
        options={tagOptions}
        placeholder="No tags"
      />

      <!-- THE VALUE IS ALSO A DOOR. The organization behind this name is a
           record of its own, so the row carries `href` and the field renders
           its ↗ open-link beside the editable value (the Notion/Airtable
           resolution — click edits everywhere, navigation gets its own <a>).
           The spoke has no organization page yet, so the door opens on the
           Projects index — the one page where the org's work is visible; a
           real app resolves the organization's own detail route here. -->
      <Firma2EditableField
        field="leadOrganization"
        label="Lead organization"
        value={project.leadOrganization}
        href={withBase('/prototypes/projects')}
      />

      <Firma2EditableField field="county" label="County" value={project.county} />

      <!-- One row, two controls. The en dash is the range visually; screen readers
           do not reliably voice it, so the component keeps the spoken " to "
           beside an aria-hidden dash — the dash carries the meaning for eyes, the
           word for ears, and only one is ever perceived at a time. Editing opens
           two labelled year boxes, because "2023–2027" is not a string a person
           should have to retype correctly. -->
      <Firma2EditableField
        field="timeline"
        label="Timeline"
        value={`${project.implementationStartYear}–${project.completionYear}`}
        editValue={`${project.implementationStartYear},${project.completionYear}`}
        control="year-range"
        format="year-range"
      />

      <Firma2EditableField
        field="estimatedTotalCost"
        label="Estimated cost"
        value={money.format(project.estimatedTotalCost)}
        editValue={String(project.estimatedTotalCost)}
        control="number"
        format="currency"
      />
    </dl>

    <!-- LAST, and it renders nothing at all for a record whose sponsor has not
         written one — the component's own guard, so this panel never shows a
         labelled empty box. -->
    <Firma2ProjectDescription description={detail.projectDescription} />
  </div>
</Firma2RailSection>
</div>

<style>
  /* Deliberately no rules for the editable rows' labels or figures. Both moved
     into firma2-editable-field when those rows became editable: it renders the
     same <dt> at `label-sm` / content-default-secondary, and applies
     tabular-nums to the currency and year-range values itself. Restating them
     here would be two declarations that agree today and drift the first time
     one side changes — and the component has to own them anyway, because the
     value it writes back after an edit is built by its own script, not by this
     file.

     That now includes the classifications set: its chips-and-combobox handling
     is the component's format="list" / control="multi-select" mode, so the
     bespoke pair this file briefly carried — and the label/inset rules it had
     to restate for it — are gone with it. */
</style>

<script>
  // TAGS ARE KEPT, from either side. The Tags row offers the tags list as
  // Workspace settings has it now (added and renamed ones included), shows
  // this project's tags as saved in this browser, and saves a change the
  // moment the row commits — the same store a tag's own settings page writes
  // when it assigns projects (src/lib/project-tags.ts).
  import { currentTags, setProjectTags, tagSlugsFromNames, tagsOfProject } from '../../lib/project-tags';

  document.querySelectorAll<HTMLElement>('[data-tags-project]').forEach((root) => {
    // The peek sheet clones this panel from a template per project; only a
    // live panel with its own row is wired here.
    if (root.closest('template')) return;
    const slug = root.dataset.tagsProject ?? '';
    const row = root.querySelector<HTMLElement>('[data-editable-field][data-field="tags"]');
    const input = row?.querySelector<HTMLElement & { options?: unknown }>('[data-field-input]');
    if (!row || !input) return;

    const options = currentTags().map((t) => ({ value: t.name, label: t.name }));
    input.dataset.options = JSON.stringify(options);
    customElements.whenDefined(input.localName).then(() => (input.options = options));

    const held = JSON.stringify(tagsOfProject(slug).map((t) => t.name));
    if (held !== row.dataset.raw) {
      document.dispatchEvent(new CustomEvent('firma2:field-set', { detail: { field: 'tags', raw: held } }));
    }

    row.addEventListener('firma2:field-save', (event) => {
      const raw = (event as CustomEvent<{ raw?: string }>).detail?.raw ?? '[]';
      let names: string[] = [];
      try {
        names = JSON.parse(raw);
      } catch {
        names = [];
      }
      setProjectTags(slug, tagSlugsFromNames(names));
    });
  });
</script>
