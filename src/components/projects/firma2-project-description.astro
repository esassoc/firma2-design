---
// firma2-project-description — the project's OWN description, as its lead
// organization typed it into ProjectFirma. It is the last row of the Key facts
// card in the rail, three lines deep, with the rest a click away.
//
// WHY IT LIVES IN BASICS. It briefly sat on its own band under the project's
// title, on the reasoning that it is the one scalar answering "what IS this
// project" and so earns the page's most valuable inches. It does not. Under the
// title it read as a LEDE — a paragraph explaining the screen — which is the
// one thing design-principles bans there, and it pushed the tracked data (the
// measures, the dollars, the milestones this page exists to answer for) a
// screenful down to do it. It is a SCALAR: a stored fact, correctable, with no
// history worth reading. The rail is where this record's scalars live and the
// Key facts card is the index card, so the description is a row on it — the
// narrative row, beside the lead organization and the program and the county.
//
// LAST ROW, NOT FIRST. The five pairs above it are short and scannable and are
// what a reader uses to PLACE the project; the narrative is what they read if
// they want it, so it comes after. It also puts the disclosure at the bottom
// edge of the card: expanding grows the card downward into empty rail, and
// never shoves a fact the reader was looking at off its line.
//
// IT IS A DATUM, NOT COPY. Worth stating plainly because the section it sits in
// is otherwise all short labelled values: this renders ProjectFirma's
// `ProjectDescription` field, authored by the project's sponsor and editable by
// anyone with permission on the record. Deleting it would delete data.
//
// THREE LINES, THEN A CHOICE. A description runs as long as its author wanted,
// and the rail is 22rem wide — unclamped, a four-sentence one would make the
// index card taller than the section it is meant to annotate. Clamped, it
// spends a fixed three lines and hands the rest to a reader who wants it. The
// toggle is MEASURED, not assumed: a two-sentence description that never
// overflows renders no button at all, so the affordance appears only when there
// is something behind it.
//
// SUBTRACTIVE. The paragraph, and a way to see the rest of it. No byline, no
// "last updated", no source line, no character count, no word count on the
// toggle. None of that is in ProjectDetail, and all of it would be text about the
// text — the exact failure mode the header audit caught.
//
// bcn-lego-checked: no esa- lego clamps text or expands it — walked the catalog
// (`ls node_modules/@esa/ecology/src/components/`); esa-collapsible is the
// adjacent one and is a titled disclosure PANEL (its own header, its own chevron,
// a region that opens BELOW the summary), which is a different thing from a
// paragraph that shows its own first three lines. esa-card is not this
// component's business either way — the Key facts section owns the card and this
// renders as a row inside it. Beacon is not cloned in this checkout. The two
// pieces that ARE legos are used as legos: the value is a firma2-editable-field
// (so the description is corrected in place like every other row in Key facts) and
// the toggle is an esa-button in the same quiet `chrome` register the section
// headers use for "Add measure".
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2EditableField from '../shared/firma2-editable-field.astro';

interface Props {
  /**
   * The stored ProjectDescription — two sentences from the lead organization on
   * what the work is and why. Pass `detail.projectDescription`.
   */
  description: string;
}

const { description } = Astro.props;

// A sponsor who has not written a description yet is a real state on a real
// record, and an empty three-line box under the title is a worse answer than no
// section at all — the page's remaining sections still say what the project is.
// Trimmed, because whitespace is not content.
const text = description?.trim() ?? '';
---
{text && (
  <!-- data-collapsed is the STATE, and it starts on: three lines is the resting
       shape, and a reader who wants the rest asks for it. The script only ever
       adds and removes this one attribute; every visual difference between the
       two states is CSS reading it. -->
  <div class="firma2-project-description stack" data-gap="2xs" data-project-description data-collapsed>
    <!-- THE LABEL IS VISIBLE HERE, and was not when this sat under the title:
         there, the paragraph's position directly beneath the project's name said
         what it was and the word would have been printed over it for nothing.
         In Key facts it is the seventh row under six labelled ones, so an unlabelled
         block of prose is the odd one out — and "Description" is the record's own
         field name, the same rule the rows above follow (they take the Projects
         table's column headers verbatim).

         as="block", NOT "dl-pair", even though it renders identically: this row
         sits OUTSIDE the <dl> above it, because the disclosure button below is a
         third child and a <dl> grouping <div> may contain only <dt> and <dd>.
         The label/value shape is class-driven, so the row still matches its five
         siblings to the pixel. -->
    <Firma2EditableField
      field="projectDescription"
      label="Description"
      as="block"
      control="textarea"
      value={text}
    />

    <!-- HIDDEN UNTIL MEASURED. The button ships `hidden` and the script reveals
         it only for a description that actually overflows three lines — a
         "Show more" over text that is already whole is a control that does
         nothing, and a reader cannot tell that by looking.

         The chevron is `iconRight` because it says where the action GOES, and it
         is the same glyph in both states: CSS rotates it rather than the script
         swapping icons, so there is no second markup path to keep in step. -->
    <div class="firma2-project-description__more" hidden>
      <EsaButton
        variant="chrome"
        size="sm"
        iconRight="chevron-down"
        data-description-toggle
        aria-expanded="false"
      >
        Show more
      </EsaButton>
    </div>
  </div>
)}

<style>
  /* NO WIDTH, NO MARGIN, NO POSITION. Both used to be here and both were about
     the band under the page title: a 29rem measure, so a paragraph would not run
     the full width of a 1440px content column, and a negative block-start that
     cancelled the page stack's step so the text sat on the h1. In the rail
     neither has a job — the 22rem column IS the measure, and the Key facts card's
     own stack owns the step above this row. Re-adding either would be a
     component reaching for a page it no longer sits on. */

  /* text-wrap: pretty rebalances the last line so the paragraph does not end on a
     single-word orphan. A hint, not a requirement — browsers without it get the
     normal greedy wrap and lose nothing.

     Scoped through :global() because the paragraph is rendered by the child
     component, and Astro's scoped selectors do not reach a child's root. The
     :global is contained by the ancestor class, so it cannot leak to the five
     sibling rows sharing this card. */
  .firma2-project-description :global(.firma2-editable-field__value) {
    text-wrap: pretty;
  }

  /* THE CLAMP. `-webkit-box` is still the interoperable way to clamp to a line
     count — the unprefixed `line-clamp` is declared alongside it so this file
     needs no edit the day the standard property is everywhere.

     It lands on the VALUE span, not on the display button that wraps it:
     firma2-editable-field hides the BUTTON while the row is being edited, and a
     clamp on the button would be a `display` declaration fighting that
     component's own `[hidden] { display: none }` guard.

     [data-measuring] is the script's escape hatch — see the script for why the
     clamp has to come off to be measured at all. It swaps the clamp for a plain
     block rather than simply dropping it: the value is a <span>, so with no
     clamp it is INLINE, and an inline box does not report its own full height
     the way a block one does. Measuring it inline is what made every
     description look like it fit. */
  .firma2-project-description[data-measuring] :global(.firma2-editable-field__value) {
    display: block;
  }
  .firma2-project-description[data-collapsed]:not([data-measuring])
    :global(.firma2-editable-field__value) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  /* The glyph points the way the text will move. 180deg, not a different icon:
     one element, one attribute, and nothing for a script to author.
     Reached by the button's own data attribute rather than a class, because
     esa-button renders the same .esa-icon for a leading and a trailing glyph —
     this button carries only the trailing one, and the attribute says so. */
  .firma2-project-description :global([data-description-toggle] .esa-icon) {
    transition: transform 120ms ease;
  }
  .firma2-project-description:not([data-collapsed]) :global([data-description-toggle] .esa-icon) {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .firma2-project-description :global([data-description-toggle] .esa-icon) {
      transition: none;
    }
  }

  /* GONE WHILE THE ROW IS BEING EDITED. The textarea already holds the whole
     description, so "Show more" would offer to reveal what is on screen. Removed
     rather than disabled: there is nothing to explain and nothing to mis-click.
     :has() on the state the field already sets — a second flag kept in step with
     it is a second thing to get wrong. */
  .firma2-project-description:has([data-editing]) .firma2-project-description__more {
    display: none;
  }

  /* The button's own box sits flush with the paragraph's left edge; esa-button
     brings its own padding, so this pulls the label back onto the text column
     rather than indenting the toggle a step in from everything above it. */
  .firma2-project-description__more {
    margin-inline-start: calc(var(--spacing-200, 0.5rem) * -1);
  }
  .firma2-project-description__more[hidden] {
    display: none;
  }
</style>

<script>
  // WHETHER THE TOGGLE EXISTS IS A MEASUREMENT, NOT A GUESS. There is no character
  // count that predicts three rendered lines — the same 260 characters clamps at
  // 400px and does not at 464, and the fonts that decide it are not loaded when
  // the markup is written. So the test is the rendered one.
  //
  // AND IT CANNOT BE scrollHeight vs clientHeight. A `-webkit-box` clamp CLIPS:
  // the lines past the third are not laid out, so the element reports
  // scrollHeight === clientHeight and every description looks like it fits. (It
  // does not: the ellipsis on screen is the proof.) The honest measurement is to
  // take the clamp OFF for the read — [data-measuring] does exactly that — and
  // compare the text's full height against three of its own lines. The attribute
  // goes on and comes off inside one synchronous block, so the browser never
  // paints the unclamped state.
  //
  // It re-runs on three things: the width changing (a re-wrap can cross the
  // threshold in either direction), the fonts finishing (a fallback face wraps
  // differently from the real one), and the field being SAVED — an edited
  // description is a different length, and the component that owns the edit
  // already announces it with `firma2:field-save`, so nothing new is invented here
  // to hear about it.
  const ROOT = '[data-project-description]';

  // The VALUE node, not the display button around it: the button is what
  // firma2-editable-field hides while editing, the span is what holds the text
  // and survives a save (the field writes into it).
  const displayOf = (root: HTMLElement) =>
    root.querySelector<HTMLElement>('[data-field-value]') ??
    root.querySelector<HTMLElement>('[data-field-display]');
  const toggleBoxOf = (root: HTMLElement) =>
    root.querySelector<HTMLElement>('.firma2-project-description__more');
  const toggleOf = (root: HTMLElement) =>
    root.querySelector<HTMLElement>('[data-description-toggle]');

  const LINES = 3;

  const measure = (root: HTMLElement): void => {
    const display = displayOf(root);
    const box = toggleBoxOf(root);
    if (!display || !box) return;
    // NOT WHILE THE ROW IS OPEN. firma2-editable-field hides the display for the
    // duration of an edit, and a hidden element measures zero — which reads as
    // "this fits in three lines" and takes the toggle away. Every path back into
    // this function re-fires once the row closes (the ResizeObserver alone does
    // it, when the display comes back and its box changes), so skipping here
    // costs nothing and is self-healing.
    if (root.querySelector('[data-editing]')) return;

    root.setAttribute('data-measuring', '');
    // getBoundingClientRect, not scrollHeight: the value is a <span>, and only the
    // [data-measuring] rule above makes it a block for the length of this read.
    const full = display.getBoundingClientRect().height;
    const lineHeight = parseFloat(getComputedStyle(display).lineHeight);
    root.removeAttribute('data-measuring');

    // 1px of slack: sub-pixel line heights make a paragraph that fills its three
    // lines exactly report a fraction more than three times one of them.
    const overflows =
      Number.isFinite(lineHeight) && lineHeight > 0 && full > lineHeight * LINES + 1;
    box.hidden = !overflows;
    // A description that no longer overflows — shortened by an edit — must not be
    // left EXPANDED with no control to collapse it. It reads identically either
    // way at this length, so the resting state is the honest one to return to.
    if (!overflows) setExpanded(root, false);
  };

  const setExpanded = (root: HTMLElement, expanded: boolean): void => {
    const toggle = toggleOf(root);
    if (expanded) root.removeAttribute('data-collapsed');
    else root.setAttribute('data-collapsed', '');
    if (!toggle) return;
    toggle.setAttribute('aria-expanded', String(expanded));
    // The LABEL changes and the icon does not — the chevron is rotated by CSS.
    // Written as text into the label esa-button already rendered; no markup is
    // built here.
    const label = toggle.querySelector('.esa-button__label');
    if (label) label.textContent = expanded ? 'Show less' : 'Show more';
  };

  const hydrate = (root: ParentNode = document): void => {
    root.querySelectorAll<HTMLElement>(ROOT).forEach((el) => {
      if (el.dataset.f2Description !== undefined) return;
      el.dataset.f2Description = '';

      // aria-controls is wired here rather than in the markup because the element
      // it points at is rendered by firma2-editable-field, which takes no id. The
      // id is unique per instance by construction: one description per record, and
      // the count only ever grows if a page renders two.
      const display = displayOf(el);
      const toggle = toggleOf(el);
      if (display && toggle) {
        const id = display.id || `firma2-description-${document.querySelectorAll(ROOT).length}`;
        display.id = id;
        toggle.setAttribute('aria-controls', id);
      }

      measure(el);
      if (display) new ResizeObserver(() => measure(el)).observe(display);
      // A FRAME LATER, deliberately: the field announces a save while the row is
      // still open (it closes on the next statement), so measuring on the event
      // itself would measure a hidden display. One frame puts it after the close.
      el.addEventListener('firma2:field-save', () =>
        requestAnimationFrame(() => measure(el))
      );
      document.fonts?.ready.then(() => measure(el));
    });
  };

  const onClick = (event: MouseEvent): void => {
    const target = event.target as Element | null;
    const toggle = target?.closest<HTMLElement>('[data-description-toggle]');
    const root = toggle?.closest<HTMLElement>(ROOT);
    if (!root) return;
    setExpanded(root, root.hasAttribute('data-collapsed'));
  };

  // ONE delegated listener however many descriptions render, and a flag so a second
  // evaluation of this module is a no-op rather than a double-fire that would
  // expand and immediately re-collapse.
  const w = window as Window & { __firma2Description?: boolean };
  if (!w.__firma2Description) {
    w.__firma2Description = true;
    document.addEventListener('click', onClick);
    document.addEventListener('astro:page-load', () => hydrate());
  }
  hydrate();
</script>
