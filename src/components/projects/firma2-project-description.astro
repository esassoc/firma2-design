---
// firma2-project-description — the project's OWN description, as its lead
// organization typed it into ProjectFirma. A section of the main column,
// directly under the property strip and ahead of every tracked section.
//
// WHY IT IS IN THE MAIN COLUMN NOW (user, 2026-10-22). The record page sorts
// its content by Linear's test — things you READ go in the main column, things
// you SET go in the rail — and the description is the one field on the record
// that is read rather than set: a paragraph the sponsor wrote, not a value
// picked from a list. It spent two releases as the last row of Key facts in the
// rail, on the earlier "series vs scalar" rule, where a paragraph at 22rem read
// as a column of ragged lines under six short labelled values. Under the new
// rule it is the document's opening, where Linear puts a project's description:
// title, properties, then the description, then milestones.
//
// WHAT THE EARLIER REVERSAL PROTECTED STILL HOLDS. The description once sat
// under the title and was sent back because that position pushed every tracked
// number below the fold (brief §4, "Room and position are different
// currencies"). The property strip above this card is what makes the position
// affordable now: Stage, Timeline, Estimated cost and Lead organization stay
// above the fold whatever this paragraph's length, so the numbers the page
// exists to answer for are placed before the reader reaches them.
//
// NO CARD, AND A SMALL LABEL (user, 2026-10-22: first "do we need to label
// it as description?", then "I want that to have a description label now"). It was an esa-card titled "Description" for one release,
// matching its carded siblings. But the title only named what the reader was
// already reading: a paragraph directly under the title and the property strip
// IS the project's description. Linear sets it the same way: no box, and a
// small muted "Description" over the text rather than a title. That is what
// this does — a field label in the page's label ink, then the document.
//
// IT IS A DATUM, NOT COPY. Worth stating plainly because this is a card of
// prose on a page otherwise made of short labelled values and tables: this
// renders ProjectFirma's `ProjectDescription` field, authored by the project's
// sponsor and editable by anyone with permission on the record. Deleting it
// would delete data.
//
// A DOCUMENT, NOT A FIELD (user, 2026-10-22: "it's not just a field that
// opens, it's essentially just the text ready to be edited like a custom
// page"). On the record it is firma2-rich-text, the custom pages' editor: no
// click-to-open textarea, no three-line clamp, no Show more. Reading, it is
// the whole text, formatted. In Edit mode the same text takes a caret where
// you click, `/` offers headings, lists and files, and selecting text raises
// the formatting bar. Nothing opens; the text you read is the text you edit.
// It follows the record's Edit and Update (src/lib/record-mode.ts), as every
// other control on the page does, and each change is a field save, so Update
// confirms it like any other.
//
// THE STORED FIELD IS PLAIN TEXT TODAY, so it goes in as paragraphs (one per
// blank-line block) and comes back out as HTML. The editor's schema cleans
// what it is given, so stored HTML is safe to render.
//
// MEASURE: capped at 34rem, about 70 characters a line — the long-form rule
// (user, 2026-10-22: 45 to 79 characters). The cap is on the root so the
// formatting bar and inserts anchor to the text column, not the card's.
//
// `inline` IS THE PEEK'S MODE: the old shape, a labelled prose row with no
// card, rendering nothing when the sponsor has not written one. The peek has no
// main column, so the description stays the last row of its Key facts there.
import Firma2ProseField from '../shared/firma2-prose-field.astro';
import Firma2RichText from '../shared/firma2-rich-text.astro';
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  /**
   * The stored ProjectDescription — two sentences from the lead organization on
   * what the work is and why. Pass `detail.projectDescription`.
   */
  description: string;
  /** The peek's labelled row, no card, absent when empty. */
  inline?: boolean;
}

const { description, inline = false } = Astro.props;

// Trimmed, because whitespace is not content.
const text = description?.trim() ?? '';

// Plain text in, paragraphs out: a blank line is a paragraph break, a single
// newline a line break. Stored HTML (a description already written here) is
// passed through for the editor's schema to clean.
const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const html = /<[a-z][\s\S]*>/i.test(text)
  ? text
  : text.split(/\n\s*\n/).map((para) => `<p>${escape(para.trim()).replace(/\n/g, '<br>')}</p>`).join('');
---
{inline ? (
  text && (
    <!-- THE LABEL IS VISIBLE HERE: in the peek's Key facts it is the last row
         under six labelled ones, so an unlabelled block of prose would be the
         odd one out — and "Description" is the record's own field name, the
         same rule the rows above follow. -->
    <Firma2ProseField field="projectDescription" label="Description" value={text} />
  )
) : (
  <section class="firma2-project-description stack" data-gap="xs" data-project-description data-html={html} data-collapsed aria-labelledby="firma2-project-description-label">
    <h2 id="firma2-project-description-label" class="firma2-project-description__label typography-label-sm">Description</h2>
    <div id="firma2-project-description-text">
      <Firma2RichText label="Description" placeholder="Add a description. Type / for headings, lists and files" canvas />
    </div>
    <!-- Hidden until measured: shown only when the text runs past two lines,
         and never in Edit mode (the whole text is open while you write). -->
    <div class="firma2-project-description__more" hidden>
      <EsaButton
        variant="chrome"
        size="sm"
        iconRight="chevron-down"
        data-description-toggle
        aria-expanded="false"
        aria-controls="firma2-project-description-text"
      >
        Show more
      </EsaButton>
    </div>
  </section>
)}

<style>
  .firma2-project-description {
    max-inline-size: 34rem;
  }

  /* THE LABEL IS A FIELD LABEL, NOT A CARD TITLE (user, 2026-10-22: "I want
     that to have a description label now"). Linear's small muted
     "Description" over the document: the same role and ink as every field
     label on the record (firma2-editable-field's label-sm in secondary), so
     it names the text without competing with the h1 above it. A real <h2>,
     because it begins a section of the page as the card titles below do. */
  /* COLLAPSED TO TWO LINES (user, 2026-10-22: "when collapsed it should
     only show about 2 lines of text"). The prose field's clamp, at two: the
     editor's own block (Tiptap's .ProseMirror) becomes a clamped box, which
     counts lines through its paragraphs, headings and lists alike and ends the
     second on an ellipsis. Global because Tiptap renders that block. */
  .firma2-project-description[data-collapsed] :global(.ProseMirror) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  /* The chevron points the way the text will move; CSS turns it. */
  .firma2-project-description :global([data-description-toggle] .esa-icon) {
    transition: transform 120ms ease;
  }
  .firma2-project-description:not([data-collapsed]) :global([data-description-toggle] .esa-icon) {
    transform: rotate(180deg);
  }

  .firma2-project-description__label {
    margin: 0;
    color: var(--color-content-default-secondary, #646464);
  }
</style>

<script>
  import { isViewMode, onRecordMode } from '../../lib/record-mode';

  document.querySelectorAll<HTMLElement>('[data-project-description]').forEach((host) => {
    const text = host.querySelector<HTMLElement>('[data-rich-text]');
    if (!text) return;
    let last = host.dataset.html ?? '';
    // Reading a project with no description, the section steps aside: a
    // read-only editor shows no placeholder, so it would be a blank gap.
    const isEmpty = (h: string) => {
      const tpl = document.createElement('template');
      tpl.innerHTML = h;
      return !tpl.content.textContent?.trim() && !tpl.content.querySelector('img, [data-file-embed]');
    };
    // ---- expand and collapse ----
    const more = host.querySelector<HTMLElement>('.firma2-project-description__more')!;
    const toggle = host.querySelector<HTMLElement>('[data-description-toggle]');
    let editing = false;
    const setExpanded = (expanded: boolean) => {
      host.toggleAttribute('data-collapsed', !expanded);
      toggle?.setAttribute('aria-expanded', String(expanded));
      const label = toggle?.querySelector('.esa-button__label');
      if (label) label.textContent = expanded ? 'Show less' : 'Show more';
    };
    // Shown only for text that runs past two lines: measured with the clamp
    // off, against the clamped height, so a short description gets no
    // control that does nothing.
    const measure = () => {
      const pm = text.querySelector<HTMLElement>('.ProseMirror');
      if (!pm || editing) { more.hidden = true; return; }
      const wasCollapsed = host.hasAttribute('data-collapsed');
      host.setAttribute('data-collapsed', '');
      const clamped = pm.clientHeight;
      const full = pm.scrollHeight;
      host.toggleAttribute('data-collapsed', wasCollapsed);
      const overflows = full > clamped + 1;
      more.hidden = !overflows;
      if (!overflows) setExpanded(false);
    };
    toggle?.addEventListener('click', () => {
      setExpanded(host.hasAttribute('data-collapsed'));
    });

    const editable = (on: boolean) => {
      text.dispatchEvent(new CustomEvent('firma2:rich-text-editable', { detail: { editable: on } }));
      host.style.display = !on && isEmpty(last) ? 'none' : '';
      // Writing opens the whole text; reading starts collapsed again.
      editing = on;
      setExpanded(on);
      requestAnimationFrame(measure);
    };

    // The editor mounts from its own module script; wait for it rather than
    // depend on which script the bundle runs first.
    const ready = () => {
      if (!text.hasAttribute('data-mounted')) return requestAnimationFrame(ready);
      text.dispatchEvent(new CustomEvent('firma2:rich-text-set', { detail: { html: last } }));
      editable(!isViewMode());
      new ResizeObserver(() => measure()).observe(text);
    };
    ready();
    onRecordMode((mode) => editable(mode === 'edit'));

    // Each settled change is a field save: Update's confirmation counts it,
    // and anything listening for projectDescription hears the new text.
    text.addEventListener('firma2:rich-text-change', (event) => {
      const html = (event as CustomEvent<{ html: string }>).detail.html;
      if (html === last) return;
      last = html;
      document.dispatchEvent(new CustomEvent('firma2:field-save', { detail: { field: 'projectDescription', raw: html } }));
    });
  });
</script>
