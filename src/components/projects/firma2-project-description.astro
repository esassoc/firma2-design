---
// firma2-project-description — the project's OWN description, as its lead
// organization typed it into ProjectFirma. Top of the detail page's main
// column, above the map.
//
// WHY THIS IS NOT THE BANNED "LEDE". design-principles bans text ABOUT the
// page, and esa-page-header deliberately carries no description slot for
// exactly that reason — the audit of 2026-08-16 found every real fill of its
// former `lede` prop was a sentence explaining the screen to its reader. This
// section is the opposite of that: it renders a STORED DATUM, ProjectFirma's
// `ProjectDescription` field, authored by the project's sponsor and editable by
// anyone with permission on the record. Deleting it would delete data, not
// copy. That distinction is the whole reason the component exists, so it is
// written down here rather than left for a reviewer to rediscover.
//
// The `description` prop is named for ProjectFirma's own field, not for a genre
// of writing — it is the record's column name, and the page passes
// `detail.projectDescription` straight into it. It is never a slot for page
// copy; nothing but stored text goes here.
//
// SUBTRACTIVE. One paragraph and nothing else: no byline, no "last updated",
// no source line, no character count. None of that is in ProjectDetail, and all
// of it would be text about the text — the exact failure mode the header audit
// caught.
import EsaCard from '@esa/ecology/esa-card.astro';
import '../shared/firma2-card-section.css';
import Firma2EditableField from '../shared/firma2-editable-field.astro';

interface Props {
  /**
   * The stored ProjectDescription — two sentences from the lead organization on
   * what the work is and why. Pass `detail.projectDescription`.
   */
  description: string;
}

const { description } = Astro.props;

// A sponsor who has not written a description yet is a real state on a real
// record, and an empty framed box with an edit button is a worse answer than
// no section at all — the page's remaining sections still say what the project
// is. Trimmed, because whitespace is not content.
const text = description?.trim() ?? '';
---
{text && (
  <EsaCard title="Description">
    <!-- NO SECTION EDIT BUTTON. There was a pencil in the card header; it went
         when the description became editable in place. The field IS the target
         now — hover or focus it and its own affordance appears — so a header
         control would be a second door to the same room.

         labelHidden, because this row's label would be the word "Description"
         directly beneath a card header that already says "Description". The
         label still exists in the DOM and still names the textarea; it is only
         hidden from sight, which is what keeps the control from announcing as
         an unlabelled edit box.

         as="block": the Basics panel renders its fields inside a <dl>, so the
         component's default emits <div><dt><dd></div>. There is no list here —
         one field, no term/value pairing to express — so the plain-div shape is
         the honest one. -->
    <!-- The wrapper exists only so the measure rule below has an element this
         component owns to hang off: esa-card accepts no `class`, and Astro's
         scoped selectors do not reach a child component's root. -->
    <div class="firma2-project-description">
      <Firma2EditableField
        field="projectDescription"
        label="Description"
        labelHidden
        as="block"
        control="textarea"
        value={text}
      />
    </div>
  </EsaCard>
)}

<style>
  /* The measure lives here rather than in firma2-editable-field, and on purpose:
     it is a property of THIS section — a two-sentence description in a wide main
     column — not of editable fields in general. The Basics panel's fields are in
     an 18rem rail where a max-inline-size would never bind.

     `ch` is measured on the "0" glyph, so ~68ch lands near the 65–75 CHARACTER
     target for comfortable line length once the narrower letters average out.
     `max-` only, so it still shrinks with the column. text-wrap: pretty
     rebalances the last lines so two sentences do not end on an orphan; it is a
     hint, and browsers without it get the normal greedy wrap and lose nothing.

     Scoped through :global() because the paragraph is rendered by the child
     component, and Astro's scoped selectors do not reach a child's root. The
     :global is contained by the ancestor class, so it cannot leak to the fields
     in Basics. */
  .firma2-project-description :global(.firma2-editable-field__value) {
    max-inline-size: 68ch;
    text-wrap: pretty;
  }
</style>
