---
// firma2-project-contacts — WHO TO CALL about this project: the three people on
// the record, each led by what they ARE to it rather than by their name. The
// second tab of the project's record rail.
//
// THE ROLE IS THE LOOKUP KEY, WHICH IS WHY IT IS THE LABEL. Nobody opens a
// contacts panel knowing the name they want — they arrive with a question ("who
// signs off on the in-water work window?", "who do I ask about the invoice?")
// and the role is what answers it. So a contact renders in the SAME shape every
// other fact on this record renders in: the term above the value, the term being
// the role and the value being the person. Key facts and Contacts are then one
// column with two contents rather than two designs, which is the whole reason
// the tabs can sit on top of each other.
//
// THE PERSON IS ONE LINE, NOT FOUR — and firma2-contact-card owns that argument.
// This panel spent a release printing name, organization and address as three
// stacked lines under the role, which is four lines per person and twelve for a
// record whose contacts a reader mostly does not need. A contact is an ENTITY,
// like a classification and unlike a county: the name carries the whole person,
// live as a mailto, and hovering or focusing it raises the card with the rest.
// The panel is now three rows deep instead of twelve and every one of them is
// actionable.
//
// SO THIS FILE IS A MANIFEST AND ALMOST NOTHING ELSE, which is the point: the
// row is a label and a card, both components, and the only decision left here
// is the order of the three.
//
// bcn-lego-checked: no esa- contact/person/roster lego — walked the catalog
// (`ls node_modules/@esa/ecology/src/components/`, 67 files): esa-avatar is a
// glyph, not a row, and it is deliberately NOT used here (an initials disc for
// an invented person spends 32px of a 22rem column on decoration); esa-card is
// the main column's section surface and the rail already supplies one; esa-stat
// is a figure with a label, not a person. Beacon is not cloned on this machine.
// Everything composable IS composed: firma2-rail-section is the panel shell,
// firma2-contact-card is the person (and esa-popover inside it is the card),
// esa-button is the Add affordance, `.stack` is the only layout, and the type
// roles are composites. The two rules at the bottom are ink and one shared
// inset, not a layout.
import Firma2RailSection from '../shared/firma2-rail-section.astro';
import Firma2ContactCard from '../shared/firma2-contact-card.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import type { ProjectContact } from '../../data/firma2-project-detail';

interface Props {
  contacts: ProjectContact[];
}

const { contacts } = Astro.props;
---
<!-- TITLE HIDDEN: the tab above this panel already says "Contacts", and saying
     it twice one line apart is the redundancy design-principles cuts. The
     heading stays in the document so the panel is still named in the heading
     list — see the prop's own note in firma2-rail-section. -->
<Firma2RailSection title="Contacts" titleHidden>
  <div class="stack" data-gap="md">
    <!-- A <dl>: these ARE term/value pairs, exactly as the Key facts tab's rows
         are, and the list semantics come free and correct. The <div> wrappers
         are the spec's grouping form, and they are what lets each pair be a
         TIGHT stack inside a list that breathes between pairs — two nested
         .stacks, no bespoke flex. layouts.css zeroes the UA margins on dl/dd
         at :where(), so there is nothing to undo. -->
    <dl class="firma2-project-contacts stack" data-gap="md">
      {contacts.map((contact) => (
        <div class="stack" data-gap="2xs">
          <dt class="typography-label-sm">{contact.role}</dt>
          <dd>
            <Firma2ContactCard contact={contact} />
          </dd>
        </div>
      ))}
    </dl>

    <!-- INERT, AND DELIBERATELY NOT `disabled`. Same stance as every other Add
         on this page: a greyed-out control claims the action is unavailable to
         this reader, which is a different and false claim from "not wired yet".
         It renders, focuses, takes a click, and nothing happens. -->
    <div>
      <EsaButton variant="chrome" size="sm" icon="plus">Add contact</EsaButton>
    </div>
  </div>
</Firma2RailSection>

<style>
  /* THE LIST STANDS ON THE SAME x AS THE OTHER TWO TABS. Key facts renders its
     rows inside firma2-editable-field's quiet field box, whose text is inset by
     the md control's own inline padding plus its border — so a list flush with
     the column's edge puts this tab's content 13px left of that one's, and
     switching tabs jogs the whole column sideways. Three tabs share one column;
     they share its left edge. Same expression the field itself uses (and the
     comments thread restates for the same reason): the three must not drift.

     This is the ONLY rule the file needs, because the rows themselves are
     components — the inset used to arrive for free with the editable field this
     panel no longer renders. */
  .firma2-project-contacts {
    padding-inline-start: calc(var(--spacing-300, 0.75rem) + var(--form-border-width, 1px));
  }

  /* The role reads as the same term the Key facts tab's labels are: the label
     composite is on the element in the markup, and the ink is the one thing the
     composite does not carry. */
  dt {
    color: var(--color-content-default-secondary, #646464);
  }
</style>
