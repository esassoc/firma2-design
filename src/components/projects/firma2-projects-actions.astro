---
// firma2-projects-actions — the Projects index's page actions, and what a
// workspace's project source does to them (hackathon team 2, decision 15).
//
// WITHHELD, NOT DISABLED. When projects are kept current from a GIS
// subscription, a sync creates them, so New project would make a record no
// layer knows — and Import work areas would give shapes a second owner. Both
// leave rather than grey out: a disabled button invites "why", and the answer
// lives in workspace settings, not here.
//
// IMPORT IS THE SECONDARY ONE. It is an onboarding act — a partner's file of
// boundaries for many projects — where the everyday path is Upload shapes on a
// single project's page.
//
// bcn-lego-checked: two esa-buttons in a cluster; spans carry the toggle
// because a hidden attribute on esa-button's own root does not hold.
import EsaButton from '@esa/ecology/esa-button.astro';
import { withBase } from '../../lib/base';
---
<span class="firma2-projects-actions cluster" data-gap="xs">
  <span data-app-only><EsaButton variant="secondary" appearance="outline" icon="upload" tag="a" href={withBase('/prototypes/projects/import-work-areas')}>Import work areas</EsaButton></span>
  <span data-app-only><EsaButton variant="primary" data-aliasable>New project</EsaButton></span>
</span>

<style>
  .firma2-projects-actions [hidden] {
    display: none !important;
  }
</style>

<script>
  import { onGeoChange, readProjectSource } from '../../lib/work-areas';

  const paint = () =>
    document.querySelectorAll<HTMLElement>('.firma2-projects-actions [data-app-only]').forEach((el) => {
      el.hidden = readProjectSource() !== 'app';
    });
  onGeoChange(paint);
  paint();
</script>
