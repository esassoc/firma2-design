---
// firma2-project-funding — the "who is paying for this" section of the project
// detail page: every funding source behind the project, what each contributes,
// and the sum, which is the project's estimated total cost.
//
// THE AMOUNTS ARE GIVEN, NOT DERIVED. firma2-project-detail.ts builds funding so
// the sources sum to estimatedTotalCost to the dollar (every source but the last
// rounds to $500; the last absorbs the remainder). So this component renders the
// authored total rather than re-adding the column: summing here would produce a
// second source of truth that agrees today and drifts the first time the data
// module changes its rounding. The one thing that IS computed here is how the
// SHARE percentages round for display — see PERCENTAGES below.
//
// THIS IS WHERE A COMMITMENT IS ENTERED. dbo.ProjectFundingSource, one project,
// one funding source, one amount, spent a release on the Funding sources setup
// milestone beside the list it points at, and moved here on 2026-09-18: setup
// configures the list of funds a program draws on, and attaching one to a
// project is the product's ongoing work (Andy: "individual data connections
// between a project and funding source feel like the ongoing maintenance and
// use of the platform"). So Add source opens a sheet whose Funding source field
// is a pick over the sources confirmed in setup (src/lib/setup-draft.ts), and
// the row it writes goes to src/lib/funding-commitment-draft.ts, keyed by
// project, the way recorded spend does. The rows the reader added merge into
// the grid beneath the authored ones and carry their own share of the estimate;
// the authored rows and the total do not move.
//
// WHY A PLAIN <table> AND NOT AG GRID. This spoke's precedent for tabular data is
// AG Grid with the full standard chrome (src/components/shared/grid-chrome.ts,
// firma2-data-grid-chrome.css) — search, filters, CSV export, record count. That
// precedent is for the PORTFOLIO table, hundreds of rows a user has to hunt
// through. Two or three funders on a detail page is a set the eye takes in whole:
// there is nothing to search, nothing to filter, nothing worth exporting, and a
// record count would be counting to three. Wrapping that chrome around three rows
// costs a grid runtime and a toolbar and buys the reader nothing, so the scale
// is what makes the precedent not apply, not a disagreement with it.
//
// NO PROGRESS BAR IN THE SHARE COLUMN, DELIBERATELY. esa-progress-bar exists and
// would render a share as a proportional bar — but the performance-measures
// section of this same page is already using progress bars, where a bar means
// "how far along toward a target". A funding share is not progress toward
// anything; it is one slice of a whole that is already fully committed. Same
// visual, two meanings, one screen, and the reader has to work out which is which
// on every glance. The percentages carry the fact on their own, and polish is
// subtractive — so the column is numbers.
import EsaCard from '@esa/ecology/esa-card.astro';
import '../shared/firma2-card-section.css';
// NOT esa-icon-button: as of 2026-08-14 that lego is a deprecated shim that
// forwards to exactly this and console.warn()s on every build. Going straight to
// the button keeps the build quiet and matches where the hub landed.
import EsaButton from '@esa/ecology/esa-button.astro';
import type { FundingSource } from '../../data/firma2-project-detail';

interface Props {
  /** The project's funding sources, in the order the data module authored them. */
  funding: FundingSource[];
  /**
   * The project's estimated total cost. Equals the sum of `funding` amounts by
   * construction — passed in rather than re-added here (see the note above).
   */
  estimatedTotalCost: number;
  /**
   * Keys the browser-local commitments to this project. Without it the section
   * is read-only: Add source renders but has nothing to write to. The detail
   * page always passes it; the prop is optional so the section can still be
   * composed on a surface with no record behind it.
   */
  projectSlug?: string;
}

const { funding, estimatedTotalCost, projectSlug } = Astro.props;

// Whole dollars: these are budget figures, not ledger entries, and cents on a
// $1.2M grant are noise in every column they appear in.
//
// Imported from src/lib/format.ts, NOT from shared/grid-chrome.ts. grid-chrome
// exports the identical Intl.NumberFormat, but its module imports
// ag-grid-community at the top level AND calls ModuleRegistry.registerModules()
// as an import side effect, so reading one formatter off it would pull the whole
// grid runtime into this page's build graph for four lines of number formatting.
// format.ts is the dependency-free home; grid-chrome re-exports from it under
// the old grid-prefixed names, so the grids are unaffected.
import { currencyFormatter as currency } from '../../lib/format';

// PERCENTAGES — largest-remainder rounding, so the column always sums to 100.
//
// The underlying shares are exact (each is amount / total, and the amounts sum to
// the total), so the true shares sum to 1. Rounding each one independently to a
// whole percent does not preserve that: 45.4 + 33.4 + 21.2 renders as 45 + 33 + 21
// = 99, under a footer that says 100%, and the table looks broken even though the
// data is right. Largest remainder floors every value and hands the leftover
// points to the entries with the biggest fractions, so what the reader adds up is
// what the total row claims. This changes only how the numbers are DISPLAYED —
// the amounts are untouched.
const rawPercents = funding.map((source) => source.share * 100);
const percents = rawPercents.map(Math.floor);
// Guarded on length: with no sources the leftover would be a full 100 points to
// hand out and the distribution loop would index an empty array and throw at
// build time. The data module never authors an empty list, but a section that
// takes down the build rather than rendering nothing is the wrong failure.
const leftover = funding.length > 0 ? 100 - percents.reduce((sum, whole) => sum + whole, 0) : 0;
// Sort is stable, so equal fractions keep the data module's authored order and
// the same input always renders the same output.
const byRemainder = rawPercents
  .map((percent, index) => ({ index, fraction: percent - Math.floor(percent) }))
  .sort((a, b) => b.fraction - a.fraction);
for (let i = 0; i < leftover; i += 1) {
  percents[byRemainder[i % byRemainder.length].index] += 1;
}

// The table needs an accessible name. esa-card renders its title as an <h3> with
// no id, so there is nothing to point aria-labelledby at without taking over the
// whole header slot — which would mean re-implementing the header the other
// sections get for free. A <caption> is the table's own naming mechanism anyway,
// and it is visually hidden because printing "Funding sources" directly under a
// card header that already says "Funding sources" is text about the page.
---
<!-- A CARD, AND IN THE MAIN COLUMN. This section spent a release in the record
     rail, uncarded, and came back: the rail is for facts short enough to read at
     a glance and narrow enough to live at 22rem, and a four-column table of
     funders is neither — it overflowed the column it was in. It sits directly
     after Expenditures, which is where the page explains the pairing. -->
<EsaCard title="Funding sources">
  <!-- ADD, not edit. This section is a COLLECTION, and that is what separates
       it from Key facts and Description: those hold scalar values, so each one got
       a per-field affordance that appears on hover and edits in place, and their
       section pencils went away. A set has no single field to hover — you add to
       it, remove from it, reorder it — so the section keeps one control and it
       names the act it actually performs. "Edit <section>" was the old pencil's
       label and it was vague about which of those it meant.

       `size="sm"` is not a local taste call — it is the size every section's
       header control renders at, and the card headers down this page have to
       agree exactly in height. Change it here only if it changes in all of them.

       Wired to the sheet below when the page gives a project slug; the script
       finds it through the card, the way the Expenditures card finds Record
       spend. Removal of a row the reader added lives in the sheet's log; the
       authored rows have no remove, because they are the record, not a draft. -->
  <EsaButton slot="actions" variant="chrome" size="sm" icon="plus" data-firma2-funding-add>Add source</EsaButton>

  <!-- AN AG GRID, not the hand-rolled <table> this was. The earlier note here
       walked the Ecology catalog, found no esa-table, and concluded "a native
       <table> IS the semantic primitive" — which was right about Ecology and
       wrong about the spoke, because AG Grid is a first-class dependency with a
       house wrapper (shared/grid-chrome.ts) and a token-mapped theme. That note
       also said the grid was "scoped to the portfolio table"; it is not scoped,
       it was simply unused here.
       The reason to move is consistency rather than capability: this table is
       four columns and three rows and needs nothing AG Grid provides. The
       project detail page is adopting the grid for its measures section, which
       genuinely does need pinned columns and toggleable ones, so the page pays
       for the runtime either way — and one tabular surface on a page reads
       better than three hand-rolled ones that each solved alignment, numeric
       formatting and total rows their own way.
       The COLUMN SEMANTICS are unchanged: the funder still names its row, the
       amounts still align to their end, and the estimated total cost still sits
       under them as a footer rather than a fourth data row. -->
  <div class="firma2-project-funding" data-project-slug={projectSlug}>
    <div class="firma2-project-funding__grid" data-firma2-funding-grid></div>

    <script
      type="application/json"
      data-firma2-funding-rows
    set:html={JSON.stringify({
      rows: funding.map((source, index) => ({
        name: source.name,
        organization: source.organization,
        amount: source.amount,
        share: percents[index],
      })),
      estimatedTotalCost,
      })}
    ></script>

    <!-- THE SHEET. Same lego, same size, same footer rhythm as the Expenditures
         card's Record spend: a pick, a figure, Save keeps the sheet open for the
         next one, Done closes it. The Funding source field is a SELECT over the
         sources confirmed in setup, minus the ones already on this project,
         because a commitment points at a dbo.FundingSource row and typing a
         name here would mint a second copy of it. -->
    <esa-side-dialog
      class="firma2-project-funding__sheet"
      heading="Add funding source"
      size="md"
      position="right"
    >
      <div class="stack" data-gap="lg">
        <esa-select data-funding-source label="Funding source" size="md" required></esa-select>
        <esa-text-field
          data-funding-amount
          label="Amount"
          size="md"
          inputmode="decimal"
          prefix="$"
          required
        ></esa-text-field>
        <!-- THE LOG SAYS WHERE THIS LIVES, in its heading: nothing in this
             prototype reaches a server, and a reader who attaches three grants
             deserves to know that before they close the tab. Same sentence
             shape and placement as the Expenditures sheet's. -->
        <section class="stack" data-gap="2xs" data-funding-log-block hidden>
          <h3 class="typography-label-sm">Recorded in this browser</h3>
          <ul class="firma2-project-funding__log stack" data-gap="2xs" data-funding-log></ul>
        </section>
      </div>
      <div slot="footer" class="repel">
        <EsaButton variant="ghost" size="md" data-funding-done>Done</EsaButton>
        <EsaButton variant="primary" size="md" data-funding-save>Save source</EsaButton>
      </div>
    </esa-side-dialog>

    <!-- A rendered esa-button the script clones per log row: the lego-clone
         trick the Expenditures sheet and the data grids use, so a script-built
         row carries a real esa-button rather than a hand-rolled lookalike. -->
    <div data-funding-remove-template hidden aria-hidden="true">
      <EsaButton variant="chrome" iconOnly icon="x" size="sm" aria-label="Remove source">Remove source</EsaButton>
    </div>
  </div>
</EsaCard>

<style>
  /* The grid draws its own surface from firma2GridTheme, which is already mapped
     onto this spoke's tokens, so there is nothing left to style but the box. No
     border and no radius: it sits inside a card that has both, and grid-chrome's
     theme turns AG Grid's own wrapper border off for exactly this reason.
     Everything the old stylesheet here did — collapsed borders, tabular numerals,
     shrink-to-fit numeric columns, the nowrap floor under the numeric headers —
     is now the theme's job or a column definition's. */
  .firma2-project-funding__grid {
    inline-size: 100%;
  }

  /* KNOWN, UNRESOLVED: AG Grid enforces a 150px floor under an auto-height
     grid's body so its "no rows" overlay has somewhere to sit, and on a card
     with two funding sources that leaves ~32px of empty band between the last
     row and the total. It is set from JS during the auto-height layout pass and
     survives everything CSS can say about it — min-height and height, with
     !important, on .ag-body and .ag-body-viewport, all computed correctly and
     changed nothing. Those attempts are removed rather than left in place as
     dead weight. A card grid always has rows, so the floor buys nothing here;
     the fix belongs upstream or in a grid option, not in more CSS.
     (If a third card grid appears, the wrap rule below belongs in the shared
     grid stylesheet rather than repeated per component.) */

  /* WRAPPED CELLS NEED THEIR OWN LINE-HEIGHT, and this is not cosmetic tuning.
     AG Grid sets a cell's `line-height` to the ROW HEIGHT so single-line text
     centres vertically without flex — a sound trick until `wrapText` turns the
     cell into real prose, at which point that same value becomes the leading
     between every wrapped line. Measured here: 39px of leading under 14px text,
     so "Watershed Resilience / Grant Program" rendered as two lines a thumb
     apart. An explicit line-height restores normal prose leading, and the
     vertical padding is what `autoHeight` then measures the row against. */
  .firma2-project-funding :global(.ag-cell-wrap-text) {
    line-height: 1.45;
    padding-block: var(--spacing-200, 0.5rem);
  }

  /* The total row is a SUMMATION, not a fourth funding source, so it reads at
     label weight against the same hairline the old <tfoot> drew. AG Grid renders
     a pinned bottom row into its own section; this is the only thing that
     section needs said about it. */
  .firma2-project-funding :global(.ag-floating-bottom) {
    font-weight: var(--font-weight-semibold, 600);
    border-block-start: var(--border-width-default, 1px) solid var(--color-border-default, #cecece);
  }

  /* .stack is the layout engine for the log; this only strips the list chrome
     that comes with choosing <ul> for its semantics. */
  .firma2-project-funding__log {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The rows are built at runtime, so they never carry this file's scope hash;
     the authored <ul> does, and :global lets the rule reach down from it. */
  .firma2-project-funding__log :global(.firma2-project-funding__log-row) {
    align-items: center;
  }

  [data-funding-log-block][hidden] {
    display: none;
  }
</style>

<script>
  import '@esa/ecology/esa-side-dialog';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-text-field';
  import { createCardGrid, gridCurrencyFormatter as currency } from '../shared/grid-chrome';
  import type { ColDef, GridApi } from 'ag-grid-community';
  import { confirmedFundingSources } from '../../lib/setup-draft';
  import {
    addFundingCommitment,
    readFundingCommitments,
    removeFundingCommitment,
    type FundingCommitmentDraft,
  } from '../../lib/funding-commitment-draft';
  // esa-side-dialog lands flush-left and content-tall in Chrome without this;
  // same fix the Expenditures and measures sheets apply.
  import { fixSideDialog } from '../../lib/side-dialog-fix';

  interface FundingRow {
    name: string;
    organization: string;
    amount: number;
    share: number;
  }

  /** The slices of the legos this file touches. */
  type Control = HTMLElement & { value?: unknown; options?: unknown; errorText?: string };
  type Sheet = HTMLElement & { show: () => void; close: () => void };

  document.querySelectorAll<HTMLElement>('.firma2-project-funding').forEach((root) => {
    const host = root.querySelector<HTMLElement>('[data-firma2-funding-grid]');
    const payload = root.querySelector<HTMLScriptElement>('[data-firma2-funding-rows]');
    if (!host || !payload) return;

    const { rows: authored, estimatedTotalCost } = JSON.parse(payload.textContent ?? '{}') as {
      rows: FundingRow[];
      estimatedTotalCost: number;
    };
    const slug = root.dataset.projectSlug ?? '';

    // ---- the rows the reader added -----------------------------------------
    // A commitment names a setup-draft source by id and the card resolves the
    // name at render. A source removed from the program after the fact leaves a
    // commitment pointing at nothing, and that row is dropped rather than shown
    // under a name the card cannot vouch for.
    const resolved = (): { commitment: FundingCommitmentDraft; row: FundingRow }[] => {
      if (!slug) return [];
      const byId = new Map(confirmedFundingSources().map((source) => [source.id, source]));
      return readFundingCommitments(slug).flatMap((commitment) => {
        const source = byId.get(commitment.fundingSourceId);
        if (!source) return [];
        return [
          {
            commitment,
            row: {
              name: source.name,
              organization: source.organizationName,
              amount: commitment.amount,
              // A reader's row is priced against the same estimate the authored
              // rows were, so the column stays one comparison. It is rounded on
              // its own, not by largest remainder with the authored set: the
              // authored shares are the record and do not move when a row is
              // added beneath them.
              share: Math.round((commitment.amount / estimatedTotalCost) * 100),
            },
          },
        ];
      });
    };

    const allRows = (): FundingRow[] => [...authored, ...resolved().map((entry) => entry.row)];

    const columnDefs: ColDef<FundingRow>[] = [
      // The funder names the row. `flex` on the two text columns, because grant
      // programs and administering bodies are long and variable and the numbers
      // beside them are not — the same division of space the old table's
      // `table-layout: auto` plus `width: 1%` numeric columns achieved.
      // WRAP, DO NOT TRUNCATE. The old table used `table-layout: auto` precisely
      // so "Watershed Resilience Grant Program" and "California Watershed
      // Restoration Board" could wrap instead of forcing a horizontal scroller,
      // and an ellipsis in a funder's name is worse than a second line: it is
      // the identifying field. `autoHeight` lets the row grow to fit.
      {
        headerName: 'Source', field: 'name', colId: 'name',
        flex: 2, minWidth: 160, wrapText: true, autoHeight: true,
      },
      // "Administered by", not "Agency" or "Organization": the funders are a mix
      // of boards, trusts and alliances, and a Local Sponsor Match is
      // administered by the project's own lead organization. The relationship is
      // the fact worth naming; the entity type is not.
      {
        headerName: 'Administered by', field: 'organization', colId: 'organization',
        flex: 2, minWidth: 160, wrapText: true, autoHeight: true,
      },
      {
        headerName: 'Amount', field: 'amount', colId: 'amount',
        width: 140, type: 'rightAligned',
        valueFormatter: (p) => (p.value == null ? '' : currency.format(Number(p.value))),
      },
      // "Share of total" rather than "Share" — it names the denominator, so the
      // percentage is readable before the reader reaches the total row.
      {
        headerName: 'Share of total', field: 'share', colId: 'share',
        width: 140, type: 'rightAligned',
        valueFormatter: (p) => (p.value == null ? '' : `${p.value}%`),
      },
    ];

    const api: GridApi<FundingRow> = createCardGrid<FundingRow>(host, {
      rowData: allRows(),
      columnDefs,
      // This grid never scrolls sideways — four columns, two of them flexed —
      // so the reserved scrollbar gutter was pure empty band between the last
      // funder and the total row. Set per call, not in createCardGrid: the
      // measures grid's whole point is horizontal scrolling.
      suppressHorizontalScroll: true,
      // RE-MEASURE ONCE THE ROWS EXIST. `autoHeight` columns are measured from
      // rendered text, but the grid sizes its body viewport before that text has
      // been laid out — so it kept a stale 150px viewport over 118px of actual
      // rows and left an empty band above the total. The CSS min-height override
      // is not enough on its own: this height is set from JS, not a stylesheet.
      onFirstDataRendered: (e) => {
        e.api.resetRowHeights();
      },
      // Named for what the sum IS, not that it is a sum. "Total" would only tell
      // the reader the column was added up, which they can see; naming it the
      // estimated total cost says the committed funding covers the project's
      // estimate — the fact this section exists to deliver.
      //
      // A pinned bottom row rather than a fourth data row: it is not a funding
      // source, and the old markup made the same distinction with <tfoot>.
      pinnedBottomRowData: [
        {
          name: 'Estimated total cost',
          organization: '',
          amount: estimatedTotalCost,
          share: 100,
        },
      ],
    });

    const paintGrid = (): void => {
      api.setGridOption('rowData', allRows());
    };

    // ---- the sheet -----------------------------------------------------------
    const sheet = root.querySelector<Sheet>('.firma2-project-funding__sheet');
    const trigger = root
      .closest('.esa-card, esa-card')
      ?.querySelector<HTMLElement>('[data-firma2-funding-add]');
    const sourceField = root.querySelector<Control>('[data-funding-source]');
    const amountField = root.querySelector<Control>('[data-funding-amount]');
    const logBlock = root.querySelector<HTMLElement>('[data-funding-log-block]');
    const log = root.querySelector<HTMLElement>('[data-funding-log]');
    const removeTemplate = root.querySelector<HTMLElement>('[data-funding-remove-template]');

    if (!sheet || !slug || !sourceField || !amountField || !log || !logBlock) return;
    void fixSideDialog(sheet);

    /** The sources still open to this project: confirmed in setup, not yet on the table. */
    const openSources = () => {
      const taken = new Set(readFundingCommitments(slug).map((c) => c.fundingSourceId));
      return confirmedFundingSources().filter((source) => !taken.has(source.id));
    };

    const paintOptions = (): void => {
      sourceField.options = openSources().map((source) => ({ label: source.name, value: source.id }));
      sourceField.value = null;
      sourceField.errorText = '';
    };

    const cloneButton = (label: string): HTMLElement | null => {
      const btn = removeTemplate?.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
      if (!btn) return null;
      btn.classList.add('firma2-project-funding__log-remove');
      btn.setAttribute('aria-label', label);
      return btn;
    };

    const paintLog = (): void => {
      const entries = resolved();
      logBlock.hidden = entries.length === 0;
      log.replaceChildren(
        ...entries.map(({ commitment, row }) => {
          const li = document.createElement('li');
          li.className = 'firma2-project-funding__log-row repel';
          li.dataset.commitmentId = commitment.id;

          const name = document.createElement('span');
          name.className = 'typography-body-sm';
          name.textContent = row.name;

          const end = document.createElement('span');
          end.className = 'cluster';
          end.dataset.gap = 'xs';
          const amount = document.createElement('span');
          amount.className = 'typography-body-sm';
          amount.textContent = currency.format(row.amount);
          end.append(amount);
          const remove = cloneButton(`Remove ${row.name}`);
          if (remove) end.append(remove);

          li.append(name, end);
          return li;
        }),
      );
    };

    const openSheet = (): void => {
      paintOptions();
      amountField.value = '';
      amountField.errorText = '';
      paintLog();
      sheet.show();
    };

    trigger?.addEventListener('click', openSheet);
    root.querySelector('[data-funding-done]')?.addEventListener('click', () => sheet.close());

    root.querySelector('[data-funding-save]')?.addEventListener('click', () => {
      const fundingSourceId = typeof sourceField.value === 'string' ? sourceField.value : '';
      if (!fundingSourceId) {
        sourceField.errorText =
          openSources().length === 0 ? 'Confirm a funding source in Setup first.' : 'Pick a funding source.';
        return;
      }
      sourceField.errorText = '';
      // Commas are what a person types into a money field, and "$40,000" is what
      // they paste out of a spreadsheet — both are the figure, so both parse.
      const amount = Number(String(amountField.value ?? '').replace(/[$,\s]/g, ''));
      if (!Number.isFinite(amount) || amount <= 0) {
        amountField.errorText = 'Enter the amount committed to this project.';
        return;
      }
      amountField.errorText = '';
      addFundingCommitment(slug, { fundingSourceId, amount });

      // Batch-friendly: the row lands in the log and the grid, the fields clear
      // for the next source, the sheet stays open.
      paintLog();
      paintGrid();
      paintOptions();
      amountField.value = '';
      sourceField.focus();
    });

    log.addEventListener('click', (event) => {
      const btn = (event.target as Element).closest('.firma2-project-funding__log-remove');
      const li = btn?.closest<HTMLElement>('[data-commitment-id]');
      if (!li?.dataset.commitmentId) return;
      removeFundingCommitment(slug, li.dataset.commitmentId);
      paintLog();
      paintGrid();
      paintOptions();
    });
  });
</script>
