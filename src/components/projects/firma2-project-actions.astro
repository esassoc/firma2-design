---
// firma2-project-actions — the record-level actions in the project header:
// Review changes (when the public page is behind), Import a report (when the
// project has a reading), Public page (once published), Share, Fact sheet, and the change history. Slotted
// into firma2-page-header's
// "toolbar" slot by the page, so they ride the BREADCRUMB row — the
// page's chrome strip — rather than the title's own bar, and stay on screen
// with the sticky band for the whole page.
//
// WHY THE HEADER CARRIES THESE WHEN IT REFUSED "EDIT PROJECT". The deleted
// button claimed a MODE — a state the record enters and leaves — and this site
// has no modes (the brief's §3: always editable, always saved). These three
// are different in kind: none of them touches the record. Share hands the page
// to someone else, the fact sheet takes it away as a file, the history reads
// what happened to it. They are actions on the WHOLE record, which is why they
// sit beside its name rather than on any section — a section affordance names
// what it adds to; these have no section.
//
// WHAT IS LIVE AND WHAT IS INERT, honestly split. Share is live: handing this
// URL to the OS share sheet, or the clipboard where no sheet exists, is real
// behavior a static prototype can deliver. History is live: the log is real
// derived record data and the sheet opens on it. Fact sheet is INERT — the
// artifact is composed server-side in a real tenant, and a fake download would
// claim more than the prototype has. Real, enabled, un-`disabled`, per the
// page's standing stance on unwired affordances.
//
// IMPORT A REPORT IS THE ONE THAT DOES CHANGE THE RECORD, and it is here
// anyway (.scratch/project-updates/spec.md, decision 8: an item in the project
// page's "…" menu). It is a LINK to the import page, like Review changes: it
// acts on the whole record, has no single section, and nothing changes until
// that page's own button is pressed. Under 45rem it folds into the bar's "…"
// with the rest, which is the menu item the decision names.
//
// PUBLIC PAGE IS THE DOOR TO WHAT READERS SEE (user, 2026-11-23): a link to the
// project's page on the public site, with the glyph and name the review pages
// already use for it. Offered only once the project has been published — by
// the seed or in this browser — because before that there is no public page to
// open, and the status row already says "Not public yet".
//
// THE HISTORY NAMES THE DOCUMENT (decision 5). Each import in this browser
// (src/lib/report-imports.ts) is a row above the seeded log, newest first:
// how many changes, from which document, who and when. The rows repaint when
// the store changes, so Undo takes its row away.
//
// ICON-ONLY CHROME BUTTONS, since 2026-10-20 (user — refining the top bar):
// in the bar, only Edit/Update keeps a label, because it is the one workflow
// act on the record; these touch nothing, so they step down to glyphs with
// their names as aria-label and an esa-tooltip (firma2-icon-action). The registry now carries all four
// (share-2, download, history, git-compare), which is what retired the old
// text-only stance (no glyph for share, a ragged set). Chrome, like the bar's
// own "…" menus, and md — the bar pins every icon-only button to a 32px
// square. All four match exactly, per the sibling-match rule. Under 45rem the
// bar folds them into its "…" menu, named by the same labels.
//
// bcn-lego-checked: everything interactive here is a lego — esa-button +
// esa-tooltip via firma2-icon-action (the actions), bcn-side-sheet (the history sheet), esa-snackbar-container
// (the copy confirmation). The bespoke part is the change-log <table> inside
// the sheet: no esa-table exists (walked the catalog 2026-08-25), and the
// spoke's AG Grid chrome (grid-chrome.ts) is priced for searchable
// portfolio-scale surfaces — search, filters, CSV export — none of which a
// seven-row chronological log in an overlay can use. Beacon is not cloned on
// this machine. firma2-project-actions is the home because the table exists
// only as this sheet's content.
import Firma2IconAction from '../shared/firma2-icon-action.astro';
import type { AuditEntry } from '../../data/firma2-project-detail';
import '../settings/firma2-settings-table.css';

interface Props {
  /** The record's change log, newest first — the order buildAudit() emits. */
  audit: AuditEntry[];
  /**
   * The project's review page, when its public page is behind the record.
   * Hidden by firma2-project-publish-state once this browser has published.
   */
  reviewHref?: string;
  /** The project's Import a report page. Set only for a project with a reading. */
  importHref?: string;
  /** The project's page on the public site. */
  publicHref?: string;
  /** Whether the seed has published the project; this browser's publishes are read by the script. */
  published?: boolean;
  /** The project's slug: the key the history reads this browser's imports by. */
  slug?: string;
}

const { audit, reviewHref, importHref, publicHref, published = false, slug } = Astro.props;
---
{reviewHref && <Firma2IconAction icon="git-compare" label="Review changes" href={reviewHref} data-project-review />}
{importHref && <Firma2IconAction icon="upload" label="Import a report" href={importHref} data-project-import />}
{publicHref && (
  <Firma2IconAction
    icon="globe"
    label="Public page"
    href={publicHref}
    data-project-public
    data-project-public-pending={published ? undefined : ''}
    data-slug={slug}
  />
)}
<Firma2IconAction icon="share-2" label="Share" data-project-share />
<Firma2IconAction icon="download" label="Fact sheet" data-project-fact-sheet />
<Firma2IconAction icon="history" label="History" data-project-history />

{/* "Change history", not "Audit log": the public reader is the widest one this
    page serves, and "audit" is compliance vocabulary — precise to staff, alarm
    bells to a visitor. What the sheet holds is exactly a history of changes,
    and the columns underneath say the rest. The BUTTON is one word because the
    cluster prices width; the sheet, with room, states its full name. */}
<bcn-side-sheet class="firma2-project-actions__sheet" heading="Change history" position="right" data-slug={slug}>
  <div class="firma2-settings-table-scroll">
    <table class="firma2-project-actions__log">
    <caption class="visually-hidden">Change history</caption>
    <thead>
      <tr>
        <th scope="col" class="typography-label-sm-strong">Date</th>
        <th scope="col" class="typography-label-sm-strong">User</th>
        <th scope="col" class="typography-label-sm-strong">Change</th>
      </tr>
    </thead>
    {/* One row per import in this browser, filled by the script. Its own
        <tbody> so a repaint replaces these rows and never the seeded log. */}
    <tbody data-import-log></tbody>
    <tbody>
      {audit.map((entry) => (
        <tr>
          <td class="firma2-project-actions__log-date typography-body-sm">{entry.date}</td>
          <td class="typography-body-sm">{entry.user}</td>
          <td class="typography-body-sm">{entry.change}</td>
        </tr>
      ))}
    </tbody>
  </table>
  </div>
  {/* The log's own row, for the script to clone: same cells, same classes. */}
  <template data-import-log-row>
    <tr>
      <td class="firma2-project-actions__log-date typography-body-sm"></td>
      <td class="typography-body-sm"></td>
      <td class="typography-body-sm"></td>
    </tr>
  </template>
</bcn-side-sheet>

<esa-snackbar-container class="firma2-project-actions__toasts"></esa-snackbar-container>

<style>
  /* Review changes leaves the row once this browser has published. */
  :global(.esa-button[hidden]) {
    display: none !important;
  }

  /* Public page stays out until the project is published; the script keeps it
     for a publish made in this browser and removes it otherwise. */
  :global(.esa-button:has(> [data-project-public-pending])) {
    display: none !important;
  }

  /* The sheet host is an inline element sitting in the header's actions flex
     cluster; fixed takes it out of flow so it does not claim a gap slot beside
     the buttons. Its panel positions itself against the viewport regardless.
     (esa-snackbar-container needs no such rule — its host is display:contents.) */
  .firma2-project-actions__sheet {
    position: fixed;
    /* Wider than the lego's 400px default: three columns, one of them a
       sentence. The lego publishes this hook for exactly this. */
    --side-dialog-width: 600px;
  }

  .firma2-project-actions__log {
    inline-size: 100%;
    border-collapse: collapse;
  }

  .firma2-project-actions__log th {
    text-align: start;
    padding-block-end: var(--spacing-200, 0.5rem);
    padding-inline-end: var(--spacing-400, 1rem);
    color: var(--color-content-default-secondary, #60655f);
    border-block-end: var(--border-width-default, 1px) solid var(--color-border-default, #cccfcc);
  }

  .firma2-project-actions__log td {
    vertical-align: top;
    padding-block: var(--spacing-300, 0.75rem);
    padding-inline-end: var(--spacing-400, 1rem);
    border-block-end: var(--border-width-default, 1px) solid
      var(--color-border-default-subtle, #e3e5e2);
  }

  .firma2-project-actions__log th:last-child,
  .firma2-project-actions__log td:last-child {
    padding-inline-end: 0;
  }

  /* The last rule would close the table against the sheet's own bottom edge —
     the sheet ends where the content does, and a trailing hairline under the
     oldest entry ("Project created") draws a boundary nothing sits below. */
  .firma2-project-actions__log tbody:last-of-type tr:last-child td {
    border-block-end: none;
  }

  /* A document's name is one unbroken token; it wraps rather than widening
     the sheet past a phone. */
  .firma2-project-actions__log td:last-child {
    overflow-wrap: anywhere;
  }

  /* A date is one token, and the column scans because the years stack. */
  .firma2-project-actions__log-date {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--color-content-default-secondary, #60655f);
  }
</style>

<script>
  import '../shared/bcn-side-sheet';
  import '@esa/ecology/esa-snackbar-container';
  import { shareRecord } from '../../lib/share-record';
  import { IMPORTS_EVENT, readImports } from '../../lib/report-imports';
  import { readPublishing } from '../../lib/publish-store';

  type Dialog = HTMLElement & { show: () => void; close: () => void };
  type Snackbar = HTMLElement & {
    show: (config: { message: string; variant?: string }) => void;
  };

  // One instance per page (there is one header); document scope is the seam,
  // matching how the measure sheets are found by their openers.
  const sheet = document.querySelector<Dialog>('.firma2-project-actions__sheet');
  const toasts = document.querySelector<Snackbar>('.firma2-project-actions__toasts');

  // PUBLIC PAGE, for a project the seed has not published: it stays if this
  // browser published it, and otherwise leaves the DOM — tooltip and all — so
  // the bar's "…" fold under 45rem never lists a door to a page that is not there.
  const publicLink = document.querySelector<HTMLElement>('[data-project-public-pending]');
  if (publicLink) {
    if (readPublishing().published[publicLink.dataset.slug ?? '']) {
      publicLink.removeAttribute('data-project-public-pending');
    } else {
      (publicLink.closest('esa-tooltip') ?? publicLink.closest('.esa-button') ?? publicLink).remove();
    }
  }

  if (sheet) {
    document
      .querySelector('[data-project-history]')
      ?.addEventListener('click', () => sheet.show());
  }

  // WHAT THIS BROWSER IMPORTED, above the seeded log and newest first. The
  // dates are the fixture's present, in the log's own "12 August 2026" form.
  const slug = sheet?.dataset.slug;
  const importLog = sheet?.querySelector<HTMLElement>('[data-import-log]');
  const importRow = sheet?.querySelector<HTMLTemplateElement>('template[data-import-log-row]');
  if (slug && importLog && importRow) {
    const day = (iso: string): string =>
      new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
    const paintImports = (): void => {
      importLog.replaceChildren(
        ...readImports(slug)
          .reverse()
          .map((record) => {
            const row = importRow.content.firstElementChild!.cloneNode(true) as HTMLElement;
            const [date, user, change] = row.querySelectorAll('td');
            const n = record.changes.length;
            date.textContent = day(record.iso);
            user.textContent = record.by;
            change.textContent = `${n} change${n === 1 ? '' : 's'} from ${
              record.document.kind === 'text' ? 'pasted text' : record.document.name
            }`;
            return row;
          }),
      );
    };
    paintImports();
    document.addEventListener(IMPORTS_EVENT, paintImports);
  }

  // SHARE SHEET FIRST, CLIPBOARD SECOND. Where the platform offers a real
  // share surface (navigator.share — macOS/iOS sheets, Android intents) the
  // button hands over title + URL and the OS takes it from there; the toast
  // would be noise on top of the OS's own UI, so none shows. Everywhere else
  // the URL lands on the clipboard and the toast is the only evidence anything
  // happened, which is what makes it required. A dismissed share sheet
  // (AbortError) is the user changing their mind, not a failure to fall back
  // from. The gesture itself lives in src/lib/share-record.ts, shared with the
  // project peek sheet — one record, one Share behaviour, however it is reached.
  document.querySelector('[data-project-share]')?.addEventListener('click', () => {
    void shareRecord({ title: document.title, url: window.location.href }, toasts);
  });
</script>
