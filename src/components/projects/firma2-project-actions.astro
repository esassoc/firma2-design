---
// firma2-project-actions — the record-level actions in the project header:
// Share, Fact sheet, and the change history. Slotted into firma2-page-header's
// "toolbar" slot by the page, so the three ride the BREADCRUMB row — the
// page's chrome strip — rather than the title's own bar, and stay on screen
// with the sticky band for the whole page.
//
// WHY THE HEADER CARRIES THESE WHEN IT REFUSED "EDIT PROJECT". The deleted
// button claimed a MODE — a state the record enters and leaves — and this site
// has no modes (the brief's §3: always editable, always saved). These three
// are different in kind: none of them touches the record. Share hands the page
// to someone else, the fact sheet takes it away as a file, the history reads
// what happened to it. They are actions on the WHOLE record, which is why they
// sit beside its name rather than on any section — a section affordance names
// what it adds to; these have no section.
//
// WHAT IS LIVE AND WHAT IS INERT, honestly split. Share is live: handing this
// URL to the OS share sheet, or the clipboard where no sheet exists, is real
// behavior a static prototype can deliver. History is live: the log is real
// derived record data and the sheet opens on it. Fact sheet is INERT — the
// artifact is composed server-side in a real tenant, and a fake download would
// claim more than the prototype has. Real, enabled, un-`disabled`, per the
// page's standing stance on unwired affordances.
//
// TEXT-ONLY BUTTONS, deliberately. The registry has glyphs for two of the
// three (download, history) and none for share; two icons and a bare label
// would read as a ragged set, and three labels carry the whole meaning anyway
// — polish is subtractive. `sm`, the same rung every card-section header
// control on this page renders at ("Add milestone", "Add source", …), because
// these live on the CRUMB ROW — the page's chrome strip, whose own text is
// meta-scale — and md boxes there outweigh the crumb they sit beside
// (user-directed 2026-08-25; they sat beside the title at md for one pass).
// Known cost, carried by the whole sm rung on this page: the label renders
// 12px, under the 13px floor — the incomplete-sm hub gap, filed, and the fix
// is the hub finishing the rung, not this spoke hand-sizing one cluster.
// All three match exactly, per the sibling-match rule. Secondary outline,
// because a primary is reserved for a creating action and none of these
// creates anything.
//
// bcn-lego-checked: everything interactive here is a lego — esa-button (the
// three actions), esa-side-dialog (the history sheet), esa-snackbar-container
// (the copy confirmation). The bespoke part is the change-log <table> inside
// the sheet: no esa-table exists (walked the catalog 2026-08-25), and the
// spoke's AG Grid chrome (grid-chrome.ts) is priced for searchable
// portfolio-scale surfaces — search, filters, CSV export — none of which a
// seven-row chronological log in an overlay can use. Beacon is not cloned on
// this machine. firma2-project-actions is the home because the table exists
// only as this sheet's content.
import EsaButton from '@esa/ecology/esa-button.astro';
import type { AuditEntry } from '../../data/firma2-project-detail';

interface Props {
  /** The record's change log, newest first — the order buildAudit() emits. */
  audit: AuditEntry[];
}

const { audit } = Astro.props;
---
<EsaButton variant="secondary" appearance="outline" size="sm" data-project-share>Share</EsaButton>
<EsaButton variant="secondary" appearance="outline" size="sm" data-project-fact-sheet>Fact sheet</EsaButton>
<EsaButton variant="secondary" appearance="outline" size="sm" data-project-history>History</EsaButton>

{/* "Change history", not "Audit log": the public reader is the widest one this
    page serves, and "audit" is compliance vocabulary — precise to staff, alarm
    bells to a visitor. What the sheet holds is exactly a history of changes,
    and the columns underneath say the rest. The BUTTON is one word because the
    cluster prices width; the sheet, with room, states its full name. */}
<esa-side-dialog class="firma2-project-actions__sheet" heading="Change history" position="right">
  <table class="firma2-project-actions__log">
    <caption class="visually-hidden">Change history</caption>
    <thead>
      <tr>
        <th scope="col" class="typography-label-sm-strong">Date</th>
        <th scope="col" class="typography-label-sm-strong">User</th>
        <th scope="col" class="typography-label-sm-strong">Change</th>
      </tr>
    </thead>
    <tbody>
      {audit.map((entry) => (
        <tr>
          <td class="firma2-project-actions__log-date typography-body-sm">{entry.date}</td>
          <td class="typography-body-sm">{entry.user}</td>
          <td class="typography-body-sm">{entry.change}</td>
        </tr>
      ))}
    </tbody>
  </table>
</esa-side-dialog>

<esa-snackbar-container class="firma2-project-actions__toasts"></esa-snackbar-container>

<style>
  /* The sheet host is an inline element sitting in the header's actions flex
     cluster; fixed takes it out of flow so it does not claim a gap slot beside
     the buttons. Its panel positions itself against the viewport regardless.
     (esa-snackbar-container needs no such rule — its host is display:contents.) */
  .firma2-project-actions__sheet {
    position: fixed;
    /* Wider than the lego's 400px default: three columns, one of them a
       sentence. The lego publishes this hook for exactly this. */
    --side-dialog-width: 600px;
  }

  .firma2-project-actions__log {
    inline-size: 100%;
    border-collapse: collapse;
  }

  .firma2-project-actions__log th {
    text-align: start;
    padding-block-end: var(--spacing-200, 0.5rem);
    padding-inline-end: var(--spacing-400, 1rem);
    color: var(--color-content-default-secondary, #60655f);
    border-block-end: var(--border-width-default, 1px) solid var(--color-border-default, #cccfcc);
  }

  .firma2-project-actions__log td {
    vertical-align: top;
    padding-block: var(--spacing-300, 0.75rem);
    padding-inline-end: var(--spacing-400, 1rem);
    border-block-end: var(--border-width-default, 1px) solid
      var(--color-border-default-subtle, #e3e5e2);
  }

  .firma2-project-actions__log th:last-child,
  .firma2-project-actions__log td:last-child {
    padding-inline-end: 0;
  }

  /* The last rule would close the table against the sheet's own bottom edge —
     the sheet ends where the content does, and a trailing hairline under the
     oldest entry ("Project created") draws a boundary nothing sits below. */
  .firma2-project-actions__log tbody tr:last-child td {
    border-block-end: none;
  }

  /* A date is one token, and the column scans because the years stack. */
  .firma2-project-actions__log-date {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--color-content-default-secondary, #60655f);
  }
</style>

<script>
  import '@esa/ecology/esa-side-dialog';
  import '@esa/ecology/esa-snackbar-container';
  import { fixSideDialog } from '../../lib/side-dialog-fix';
  import { shareRecord } from '../../lib/share-record';

  type Dialog = HTMLElement & { show: () => void; close: () => void };
  type Snackbar = HTMLElement & {
    show: (config: { message: string; variant?: string }) => void;
  };

  // One instance per page (there is one header); document scope is the seam,
  // matching how the measure sheets are found by their openers.
  const sheet = document.querySelector<Dialog>('.firma2-project-actions__sheet');
  const toasts = document.querySelector<Snackbar>('.firma2-project-actions__toasts');

  if (sheet) {
    void fixSideDialog(sheet);
    document
      .querySelector('[data-project-history]')
      ?.addEventListener('click', () => sheet.show());
  }

  // SHARE SHEET FIRST, CLIPBOARD SECOND. Where the platform offers a real
  // share surface (navigator.share — macOS/iOS sheets, Android intents) the
  // button hands over title + URL and the OS takes it from there; the toast
  // would be noise on top of the OS's own UI, so none shows. Everywhere else
  // the URL lands on the clipboard and the toast is the only evidence anything
  // happened, which is what makes it required. A dismissed share sheet
  // (AbortError) is the user changing their mind, not a failure to fall back
  // from. The gesture itself lives in src/lib/share-record.ts, shared with the
  // project peek sheet — one record, one Share behaviour, however it is reached.
  document.querySelector('[data-project-share]')?.addEventListener('click', () => {
    void shareRecord({ title: document.title, url: window.location.href }, toasts);
  });
</script>
