---
// firma2-project-peek-button — the "open in the side panel" button that sits
// beside a project's link anywhere a project is listed. The link is the door
// to the full page; this opens firma2-project-peek beside the current page
// instead (user, 2026-10-03: "carry that ability to all instances where a
// project can be opened").
//
// It is the project grid's peek, lifted out so every list wears the same
// affordance: a chrome esa-button with the panel-right glyph, inside a span
// carrying data-open-project — the delegated seam firma2-project-peek
// listens on. A SIBLING of the link, never inside it (a button in a link is
// invalid HTML and a double announcement).
//
// QUIET UNTIL ASKED FOR, where the list says so: inside an ancestor marked
// [data-peek-row] it shows on that row's hover or focus, like the grid's;
// anywhere else it is always visible. On a device with no hover it always
// shows. Styles are a plain stylesheet, not scoped, because rows built at
// runtime clone this markup (src/lib/project-peek.ts).
//
// The page needs the panel: wrap it in firma2-project-peek-layout.
//
// bcn-lego-checked: esa-button (icon-only) is the lego; the wrapper span is
// the data hook and a hover reveal. Beacon is not cloned on this machine.
import EsaButton from '@esa/ecology/esa-button.astro';
import './firma2-project-peek-button.css';

interface Props {
  slug: string;
  /** The project's name, for the button's accessible name. */
  name: string;
}

const { slug, name } = Astro.props;
---
<span class="firma2-peek-button" data-open-project={slug}>
  <EsaButton variant="chrome" size="sm" iconOnly icon="panel-right" label={`Preview ${name}`} />
</span>
