---
// firma2-project-import-actions — the import page's commit, in the pinned top
// bar so it stays in reach however long the review below it runs.
//
// THE BUTTON STATES THE SPLIT. "Create 13, update 2" is the whole confirmation:
// the page above it lists every one, and Undo takes them all back, so there is
// no second "Are you sure?". It is disabled only when it would be untrue —
// nothing to import, a required field without a column, or a plan limit — and
// the page says which, beside the cause.
//
// It paints from firma2-project-import's state event and sends the commit back
// as one; the two never reach into each other's markup.
//
// bcn-lego-checked: two esa-buttons in a cluster; the spans carry `hidden`
// because esa-button's own display rule beats [hidden].
import EsaButton from '@esa/ecology/esa-button.astro';
---
<span class="firma2-project-import-actions cluster" data-gap="xs">
  <span data-restart-wrap hidden><EsaButton variant="ghost" size="md" data-restart>Change file</EsaButton></span>
  <span data-commit-wrap hidden><EsaButton variant="primary" size="md" data-commit>Import projects</EsaButton></span>
</span>

<style>
  .firma2-project-import-actions [hidden] {
    display: none !important;
  }

  /* "Create 13, update 2" changes as decisions land: equal-width digits keep
     the button from changing width with every count. */
  .firma2-project-import-actions :global(.esa-button__label) {
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import { label } from '../../lib/vocabulary';

  document.querySelectorAll<HTMLElement>('.firma2-project-import-actions').forEach((root) => {
    const restartWrap = root.querySelector<HTMLElement>('[data-restart-wrap]')!;
    const commitWrap = root.querySelector<HTMLElement>('[data-commit-wrap]')!;
    const commit = root.querySelector<HTMLButtonElement>('[data-commit]')!;
    const commitButton = commitWrap.querySelector<HTMLElement>('.esa-button')!;
    const commitLabel = commit.querySelector('.esa-button__label') ?? commit;

    document.addEventListener('firma2:project-import-state', (event) => {
      const { phase, created, updated, ready } = (event as CustomEvent<{ phase: string; created: number; updated: number; ready: boolean }>).detail;
      restartWrap.hidden = phase !== 'review';
      commitWrap.hidden = phase !== 'review';
      // Both kinds: the verbs carry it. One kind: the noun says what is counted.
      const n = (x: number) => x.toLocaleString('en-US');
      const noun = (x: number) => (x === 1 ? 'project' : 'projects');
      commitLabel.textContent = label(
        created && updated ? `Create ${n(created)}, update ${n(updated)}`
          : created ? `Create ${n(created)} ${noun(created)}`
          : updated ? `Update ${n(updated)} ${noun(updated)}`
          : 'Import projects',
      );
      commit.disabled = !ready;
      commitButton.classList.toggle('esa-button--disabled', !ready);
    });

    commit.addEventListener('click', () => document.dispatchEvent(new Event('firma2:project-import-commit')));
    root.querySelector('[data-restart]')!.addEventListener('click', () => document.dispatchEvent(new Event('firma2:project-import-restart')));
  });
</script>
