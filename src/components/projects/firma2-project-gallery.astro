---
// firma2-project-gallery — the photos on the project record: what the work
// looks like on the ground, dated and captioned, for the reader the map and the
// measures cannot reach. A member of the public judging "is this real" trusts a
// photo of a working landscape before any number on this page; the gallery is
// that answer, and its captions are stored record data, not page copy.
//
// STOCK STAND-INS, HOTLINKED FROM UNSPLASH (user-directed 2026-08-25; the
// first pass drew illustrated SVG scenes). No real project photography can
// appear here — the repo and its deployed site are public, and a photo of a
// real client site is exactly what mock data must never borrow — so each photo
// record renders a LANDSCAPE PHOTOGRAPH from Unsplash's library instead:
// generic California-plausible ground, no people identifiable, no client
// anything. The Unsplash License (unsplash.com/license) grants free use
// without attribution. Determinism holds because the pools below are FIXED
// photo IDs picked by the record's own seed — same record, same image, every
// build; no API, no search, no randomness.
//
// THE POOL IS KEYED BY THE PHOTO'S SCENE KIND (stream / meadow / forest /
// channel, assigned per program in the data module), so a fuels project shows
// conifer country and a riparian project shows moving water. Within one
// project no image repeats: buildPhotos spaces sibling seeds 11 apart, and 11
// is coprime with every pool length below, so consecutive picks walk the pool
// without landing twice — a gallery with the same photograph twice reads as a
// data bug. Across projects images DO repeat, which is what stock is.
//
// THE CAPTION STAYS THE RECORD'S DATUM. A stand-in photograph will never
// literally show "browse protection on first-season plantings" — that gap is
// inherent to stock and accepted for a prototype; the caption is the field a
// real tenant stores with an upload and the thing this section actually
// demonstrates.
//
// THE LIGHTBOX (user-directed 2026-08-25). A tile is a 234px index of a
// photograph, not the photograph; hovering (or keyboard-focusing) a tile
// raises one quiet expand control, and opening it hands the photo a modal
// viewer at screen size — esa-dialog, so Esc, the scrim, light-dismiss, focus
// containment and the close button are the lego's, not reimplemented here.
// The viewer is a CAROUSEL over the record's own photo list: chevrons and
// arrow keys walk it, wrapping at the ends, with the caption, date and the
// "N of M" position under the frame. One dialog per gallery, re-pointed by
// script — its skeleton is authored HERE as markup; the script only swaps
// src and textContent, never builds elements.
//
// bcn-lego-checked: no esa- lego renders an image grid, a lightbox or a
// carousel — walked the catalog (`ls node_modules/@esa/ecology/src/
// components/`, 2026-08-25): esa-dialog is the modal surface and IS the
// lightbox shell here; esa-button (iconOnly) is every control; esa-card,
// esa-empty-state, the .grid primitive and typography composites carry the
// rest. The bespoke parts are the <figure> tile and the carousel wiring
// (index state + arrow keys), and firma2-project-gallery is their reusable
// home. Beacon is not cloned on this machine.
import EsaCard from '@esa/ecology/esa-card.astro';
import '../shared/firma2-card-section.css';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import type { ProjectPhoto } from '../../data/firma2-project-detail';

interface Props {
  /** The record's photos, oldest first — the order buildPhotos() emits. */
  photos: ProjectPhoto[];
}

const { photos } = Astro.props;

// Curated Unsplash photo IDs per scene kind — every one fetched and REVIEWED
// on a rendered contact sheet before earning its slot (an ID that 404s or
// resolves to a beach would ship 24 broken galleries). Ordering within a pool
// is deliberate: the most scene-typical frames first, context frames (uplands,
// access roads, valley floors) later, because low-index picks are the ones
// short galleries land on. Some IDs serve two pools — a valley oak is both a
// meadow and a floodplain — which is fine across projects; uniqueness only
// matters within one gallery, and the seed stride guarantees that per pool.
const SCENE_IMAGES: Record<ProjectPhoto['scene'], string[]> = {
  stream: [
    '1506744038136-46273834b3fb', // river across a granite valley floor
    '1473448912268-2022ce9509d8', // river running through conifer forest
    '1432405972618-c60b0225b8f9', // creek falls into a boulder pool
    '1433086966358-54859d0ed716', // falls in a forested gorge
    '1502082553048-f009c37129b9', // lone valley oak on a grassland floodplain
    '1426604966848-d7adac402bff', // pines on a valley floor below granite
  ],
  meadow: [
    '1470071459604-3b5ec3a7fe05', // green hills under first light
    '1465146344425-f00d5f5c8f07', // poppies through dry grass
    '1502082553048-f009c37129b9', // lone valley oak on open grassland
    '1469474968028-56623f02e42e', // rocky upland meadow at dusk
    '1439066615861-d1af74d74000', // still pond with a monitoring platform
    '1444927714506-8492d94b4e3d', // hazy blue ridgelines
  ],
  forest: [
    '1441974231531-c6227db76b6e', // sunlit trail through mixed conifer
    '1418065460487-3e41a6c84dc5', // mist over a conifer ridge
    '1425913397330-cf8af2ff40a1', // sunbeams through a pine stand
    '1476231682828-37e571bc172f', // aerial: road curving through forest
    '1473773508845-188df298d2d1', // aerial: unbroken conifer canopy
    '1426604966848-d7adac402bff', // valley-floor pines below a granite wall
    '1448375240586-882707db888b', // closed-canopy stand, pre-treatment dark
  ],
  channel: [
    '1473448912268-2022ce9509d8', // river through conifers
    '1439066615861-d1af74d74000', // basin holding still water
    '1432405972618-c60b0225b8f9', // creek falls and boulder pool
    '1470071459604-3b5ec3a7fe05', // green hills above the corridor
    '1476231682828-37e571bc172f', // aerial: road through forest
    '1444927714506-8492d94b4e3d', // hazy ridgelines above the watershed
  ],
};

const imageId = (photo: ProjectPhoto): string => {
  const pool = SCENE_IMAGES[photo.scene];
  return pool[photo.seed % pool.length];
};

// Exact 4:3 crops from the CDN, so both surfaces get uniform frames whatever
// the source's native shape: 2× the ~234px tile for the grid, and a
// screen-size 1600×1200 for the lightbox — the SAME crop at two resolutions,
// so opening a photo enlarges it rather than reframing it.
const srcFor = (photo: ProjectPhoto): string =>
  `https://images.unsplash.com/photo-${imageId(photo)}?auto=format&fit=crop&w=640&h=480&q=60`;
const fullFor = (photo: ProjectPhoto): string =>
  `https://images.unsplash.com/photo-${imageId(photo)}?auto=format&fit=crop&w=1600&h=1200&q=70`;

const hasPhotos = photos.length > 0;
const hasCarousel = photos.length > 1;
---
<EsaCard title="Photos">
  <!-- ADD, not edit — this section is a COLLECTION, the same rule every
       collection section on this page states in full on its own header (see
       firma2-project-timeline). sm is the shared section-header control size;
       inert, not disabled, per the page's standing stance on unwired
       affordances. -->
  <EsaButton slot="actions" variant="chrome" size="sm" icon="plus">Add photo</EsaButton>

  {!hasPhotos ? (
    <!-- REACHABLE, by construction: buildPhotos gives some proposals nothing,
         because a record with no photos is a real state on any tenant. The
         description is the recovery action, not an apology for the feature. -->
    <EsaEmptyState size="sm" title="No photos yet" description="Add site photos as the work begins." />
  ) : (
    <ul class="firma2-project-gallery grid" data-gap="md" role="list">
      {photos.map((photo, i) => (
        <li>
          <figure class="firma2-project-gallery__figure">
            <div class="firma2-project-gallery__frame">
              {/* alt="" is a decision, not an omission: the figcaption directly
                  below says what the photo shows — the one description a real
                  upload would store — and an alt repeating it would announce
                  every frame twice. loading="lazy" because this card sits five
                  sections down; the images are the page's only external
                  requests and none should compete with the record itself. */}
              <img
                class="firma2-project-gallery__image"
                src={srcFor(photo)}
                alt=""
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
              />
              {/* ONE affordance per tile, and it is a real button. Hidden at
                  rest and raised by hover — or by keyboard focus, which is the
                  half hover-revealed controls usually forget — and always
                  visible where hover does not exist (touch), because an
                  invisible tap target is a control nobody was told about. The
                  label carries the caption so eight tiles do not announce as
                  eight identical "View photo" buttons. */}
              <EsaButton
                class="firma2-project-gallery__expand"
                variant="secondary"
                size="sm"
                iconOnly
                icon="expand"
                label={`View photo: ${photo.caption}`}
                data-lightbox-open={String(i)}
              />
            </div>
            <figcaption class="firma2-project-gallery__caption">
              <span class="typography-body-sm">{photo.caption}</span>
              <span class="firma2-project-gallery__date typography-meta">{photo.date}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  )}

  {hasPhotos && (
    <>
      {/* THE VIEWER — one dialog, re-pointed to whichever photo opened it.
          heading="Photos" names the dialog for a screen reader and puts the
          lego's own close button in reach; everything below the header is the
          photograph at the largest size the viewport allows, with the record's
          caption under it where the tile put it. The chevrons ride the frame's
          edges (the carousel idiom), wrap at the ends, and only exist at all
          when there is more than one photo — a one-photo "carousel" is a
          button that goes nowhere. */}
      <esa-dialog class="firma2-project-gallery__lightbox" heading="Photos" show-close-button>
        <figure class="firma2-project-gallery__stage-figure">
          <div class="firma2-project-gallery__stage">
            <img
              class="firma2-project-gallery__stage-image"
              data-lightbox-image
              src={fullFor(photos[0])}
              alt=""
              width="1600"
              height="1200"
              decoding="async"
            />
            {hasCarousel && (
              <>
                <EsaButton
                  class="firma2-project-gallery__nav firma2-project-gallery__nav--prev"
                  variant="secondary"
                  size="md"
                  iconOnly
                  icon="chevron-left"
                  label="Previous photo"
                  data-lightbox-prev
                />
                <EsaButton
                  class="firma2-project-gallery__nav firma2-project-gallery__nav--next"
                  variant="secondary"
                  size="md"
                  iconOnly
                  icon="chevron-right"
                  label="Next photo"
                  data-lightbox-next
                />
              </>
            )}
          </div>
          <figcaption class="firma2-project-gallery__stage-caption repel" data-gap="md">
            <span class="firma2-project-gallery__stage-text">
              <span class="typography-body-md" data-lightbox-caption></span>
              <span class="firma2-project-gallery__date typography-meta" data-lightbox-date></span>
            </span>
            {hasCarousel && (
              <span class="firma2-project-gallery__count typography-meta" data-lightbox-count></span>
            )}
          </figcaption>
        </figure>
      </esa-dialog>

      <script
        type="application/json"
        data-lightbox-photos
        set:html={JSON.stringify(
          photos.map((photo) => ({ full: fullFor(photo), caption: photo.caption, date: photo.date })),
        )}
      />
    </>
  )}
</EsaCard>

<style>
  /* The .grid primitive flows the tiles; the min is what decides how many sit
     abreast. 13rem lands three-up in the content column at desktop widths and
     wraps to two, then one, as the column narrows — no media query to hold.

     auto-FILL, overriding the primitive's one auto-FIT line. The difference
     only shows when there are fewer photos than the row fits: auto-fit
     collapses the unused tracks and stretches the real ones, so a two-photo
     gallery grew 500px tracks around 4:3 photos — and the first cure tried
     (capping the FIGURE at 22rem) just moved the damage: the photo stopped
     growing but its track did not, and the ~150px of track slack between
     tiles read as unexplained padding (measured at 1800px, gap 16px declared,
     167px rendered). auto-fill keeps the empty tracks, so every real tile
     stays photo-sized, the rendered gap IS the declared gap at every count,
     and a full gallery is identical under either keyword. Same minmax, same
     --grid-min — one keyword differs. The primitive has no knob for this
     (checked layouts.css 2026-08-25); a data-fill variant on .grid is a
     /request-lego candidate. */
  .firma2-project-gallery {
    --grid-min: 13rem;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--grid-min), 100%), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .firma2-project-gallery__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200, 0.5rem);
  }

  /* The expand control's positioning context. Nothing else — the frame takes
     its size from the image, so the tile's geometry is exactly what it was
     before the control existed. */
  .firma2-project-gallery__frame {
    position: relative;
  }

  /* One aspect for every frame — a gallery scans as a gallery because the
     frames agree, and 4:3 is the shape a field photo actually arrives in. The
     CDN crop already delivers 4:3; aspect-ratio + object-fit restate it so the
     box holds its shape BEFORE the image arrives (no reflow on lazy-load) and
     even if a pool entry ever ships un-cropped. The hairline does for a photo
     what a mat does for a print: says where it ends on a near-white card. */
  .firma2-project-gallery__image {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #e3e5e2);
    border-radius: var(--radius-sm, 4px);
    /* The frame keeps its ground while the photo loads — the sunken step, the
       same role the map canvas rests on, so an empty frame reads as loading
       rather than broken. */
    background: var(--color-background-elevation-sunken, #f4f5f4);
  }

  /* Hidden at rest, raised by pointer hover on the frame or by keyboard focus
     on the button itself (:focus-within, because the focusable is the lego's
     inner native button). opacity, not display, so the control is focusable
     while invisible — a Tab stop that exists only on hover would be
     unreachable by exactly the users who cannot hover.

     :global() because the class rides an esa-button's wrapper, which carries
     the lego's scope hash, not this file's; containment under the frame (this
     file's element) keeps the reach local. */
  .firma2-project-gallery__frame :global(.firma2-project-gallery__expand) {
    position: absolute;
    inset-block-start: var(--spacing-200, 0.5rem);
    inset-inline-end: var(--spacing-200, 0.5rem);
    opacity: 0;
    transition: opacity var(--transition-base, 0.2s ease);
  }

  .firma2-project-gallery__frame:hover :global(.firma2-project-gallery__expand),
  .firma2-project-gallery__frame :global(.firma2-project-gallery__expand:focus-within) {
    opacity: 1;
  }

  /* No hover, no reveal moment — the control is simply there. */
  @media (hover: none) {
    .firma2-project-gallery__frame :global(.firma2-project-gallery__expand) {
      opacity: 1;
    }
  }

  .firma2-project-gallery__caption {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050, 0.125rem);
    color: var(--color-content-default, #1d211c);
  }

  .firma2-project-gallery__date {
    color: var(--color-content-default-secondary, #60655f);
  }

  /* ── The viewer ────────────────────────────────────────────────────────── */

  /* fit-content, because the photograph is what sizes this dialog: the image
     states its own bounds below (viewport-derived, 4:3 held), and the lego's
     fixed 480px default would either letterbox it or crop it. The hook is the
     lego's published re-skin surface, not a reach into its shadow. */
  .firma2-project-gallery__lightbox {
    --dialog-width: fit-content;
  }

  .firma2-project-gallery__stage-figure {
    margin: 0;
    padding: var(--spacing-400, 1rem);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300, 0.75rem);
  }

  .firma2-project-gallery__stage {
    position: relative;
  }

  /* As large as the viewport honestly allows while the whole dialog — header,
     caption row included — stays on screen. The height bound starts from the
     lego's own 85vh dialog ceiling and SUBTRACTS the ~12rem the header bar,
     the caption row and the paddings spend, then converts to width through
     the 4:3 ratio — budgeting the image against the viewport alone was the
     first version, and the dialog's overflow:hidden answered by clipping the
     caption off the bottom. A fixed aspect means every photo in the carousel
     lands in the IDENTICAL box, so paging never resizes the dialog — the
     stable-frame rule, applied to a surface whose content changes on every
     click. */
  .firma2-project-gallery__stage-image {
    display: block;
    inline-size: min(86vw, calc((85vh - 14rem) * 4 / 3), 64rem);
    /* Explicit, because the width/height ATTRIBUTES map to presentational
       width/height styles on a replaced element — without this line the
       attribute's 1200px wins over the aspect-ratio and the frame renders
       portrait. Same trap the grid tile hit, same fix. */
    block-size: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-sm, 4px);
    background: var(--color-background-elevation-sunken, #f4f5f4);
  }

  /* The chevrons ride the frame's vertical center — the carousel idiom, where
     the eye already is. Solid secondary buttons rather than chrome ghosts:
     a transparent glyph over a photograph has whatever contrast the sky
     happens to give it. :global() for the same wrapper-scope reason as the
     expand control. */
  .firma2-project-gallery__stage :global(.firma2-project-gallery__nav) {
    position: absolute;
    inset-block-start: 50%;
    translate: 0 -50%;
  }

  .firma2-project-gallery__stage :global(.firma2-project-gallery__nav--prev) {
    inset-inline-start: var(--spacing-300, 0.75rem);
  }

  .firma2-project-gallery__stage :global(.firma2-project-gallery__nav--next) {
    inset-inline-end: var(--spacing-300, 0.75rem);
  }

  .firma2-project-gallery__stage-caption {
    align-items: baseline;
  }

  .firma2-project-gallery__stage-text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050, 0.125rem);
  }

  .firma2-project-gallery__count {
    color: var(--color-content-default-secondary, #60655f);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>

<script>
  import '@esa/ecology/esa-dialog';

  type Dialog = HTMLElement & { show: () => void; close: () => void; open: boolean };

  interface LightboxPhoto {
    full: string;
    caption: string;
    date: string;
  }

  // One gallery per page today (the project detail route); document scope is
  // the same seam the record-actions sheet uses. The payload is server-
  // rendered JSON — the script re-points a skeleton authored as markup and
  // never constructs an element.
  const lightbox = document.querySelector<Dialog>('.firma2-project-gallery__lightbox');
  const payload = document.querySelector<HTMLScriptElement>('[data-lightbox-photos]');

  if (lightbox && payload) {
    const photos = JSON.parse(payload.textContent ?? '[]') as LightboxPhoto[];
    const image = lightbox.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const caption = lightbox.querySelector<HTMLElement>('[data-lightbox-caption]');
    const date = lightbox.querySelector<HTMLElement>('[data-lightbox-date]');
    const count = lightbox.querySelector<HTMLElement>('[data-lightbox-count]');
    let index = 0;

    const render = (): void => {
      const photo = photos[index];
      if (!photo || !image) return;
      image.src = photo.full;
      if (caption) caption.textContent = photo.caption;
      if (date) date.textContent = photo.date;
      if (count) count.textContent = `${index + 1} of ${photos.length}`;
      // The neighbors warm the cache while the current photo is being looked
      // at, so paging swaps instantly instead of restating the network.
      [index + 1, index - 1].forEach((n) => {
        const neighbor = photos[(n + photos.length) % photos.length];
        if (neighbor) new Image().src = neighbor.full;
      });
    };

    const step = (delta: number): void => {
      index = (index + delta + photos.length) % photos.length;
      render();
    };

    document.querySelectorAll<HTMLElement>('[data-lightbox-open]').forEach((opener) => {
      opener.addEventListener('click', () => {
        index = Number(opener.getAttribute('data-lightbox-open')) || 0;
        render();
        lightbox.show();
      });
    });

    lightbox.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => step(-1));
    lightbox.querySelector('[data-lightbox-next]')?.addEventListener('click', () => step(1));

    // Arrow keys page the carousel while the dialog is open — the keyboard
    // twin of the chevrons, listening on the dialog host so it works wherever
    // focus sits inside (Esc and Tab stay the lego's business).
    lightbox.addEventListener('keydown', (event) => {
      if (photos.length < 2 || !lightbox.open) return;
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      }
    });
  }
</script>
