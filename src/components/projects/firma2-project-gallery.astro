---
// firma2-project-gallery — the photos on the project record: what the work
// looks like on the ground, for the reader the map and the measures cannot
// reach. A member of the public judging "is this real" trusts a photo of a
// working landscape before any number on this page; the gallery is that answer.
//
// WHAT A PHOTO CARRIES (2026-11-24, .scratch/project-photos/spec.md). Beyond
// caption and date, the record stores where in the work it was taken (Before /
// During / After), the named photo point it was taken from, an optional
// collection, whether the public may see it, the real day it was taken, the
// work area in frame, credit, and alt text. Featured is one of those facts,
// not a separate store. Before-and-after pairs are not a flag: they are two
// photos at one photo point (src/lib/photo-meta.ts: pointsOf).
//
// THE GALLERY IS BUILT TWICE. At build time from the seed, so the page is
// right before any script runs and a peek (whose scripts never run — see the
// template-script trap) still shows photos. At runtime the script lays this
// browser's edits over the seed (src/lib/photo-meta.ts), reorders and hides
// tiles, and clones the tile <template> for a photo added in the browser.
//
// EDITING. A tile's pencil opens the docked bcn-side-sheet beside the grid;
// every field saves as it changes (the record has no Save). The grid reorders
// by drag (bcn-sortable-list, layout="grid") or by the grip's menu. Reordering
// is switched off while a filter hides tiles: moving a photo past ones you
// cannot see is not a move you can check.
//
// ADDING. "Add photos" and a drop on the card take many files at once. Each
// file's EXIF fills the day taken and, when it has a GPS position, the nearest
// work area; the bar above the grid then sets stage or collection for the
// whole batch. FAKED: an added photo's pixels are a blob URL, so it lasts until
// the page reloads (see photo-meta.ts).
//
// STOCK STAND-INS, HOTLINKED FROM UNSPLASH (user-directed 2026-08-25). No real
// project photography can appear in this public repo, so each seeded photo
// renders a landscape from a fixed pool by its own seed (src/lib/
// project-photos.ts). The caption stays the record's datum.
//
// bcn-lego-checked: no esa- lego renders an image grid or a lightbox (catalog
// walked 2026-11-24). Everything else is one: esa-card, esa-button,
// esa-button-toggle (stage), esa-select (collection, point, work area),
// esa-text-field, esa-textarea, esa-date-picker, esa-switch-toggle,
// esa-confirm-dialog, esa-empty-state, bcn-side-sheet, bcn-sortable-list and
// the app-wide firma2-lightbox. The bespoke part is the tile
// (firma2-photo-tile) and the wiring here. Beacon is not cloned on this
// machine.
import EsaCard from '@esa/ecology/esa-card.astro';
import '../shared/firma2-card-section.css';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import type { ProjectPhoto } from '../../data/firma2-project-detail';
import { photoSrc } from '../../lib/project-photos';
import { stageLabel } from '../../lib/photo-meta';
import Firma2PhotoTile from './firma2-photo-tile.astro';

interface Props {
  /** The record's photos, oldest first — the order buildPhotos() emits. */
  photos: ProjectPhoto[];
  /** The public project page renders this same section for readers who cannot edit. */
  readonly?: boolean;
  /** The project's slug. Omitted, the record page's route supplies it; with neither (a peek) there are no edit controls. */
  slug?: string;
  /** The project's work areas, with a centre point each, so a photo's GPS can name the one it is near. */
  workAreas?: { label: string; center: [number, number] }[];
  /** A preview (the peek rail): shows every photo, offers no edit controls, runs no script. */
  inert?: boolean;
}

const { photos, readonly = false, slug, workAreas = [], inert = false } = Astro.props;

// The seeded photos as the script reads them: the same records plus both
// crops, so a tile and the viewer show one picture at two sizes.
const seed = photos.map((photo, i) => ({
  ...photo,
  id: `p${i}`,
  thumb: photoSrc(photo, 640, 480),
  full: photoSrc(photo, 1600, 1200, 70),
}));

// Build time shows the seed's public photos to a visitor and all of them to an
// editor; the script corrects either from this browser's edits.
const shown = seed.filter((photo) => !readonly || photo.public);
const hasPhotos = seed.length > 0;
const editable = !readonly && !inert;
---
<EsaCard title="Photos">
  {editable && (
    <EsaButton slot="actions" variant="chrome" size="sm" icon="plus" data-edit-only data-photo-add>Add photos</EsaButton>
  )}

  <div class="firma2-project-gallery stack" data-gap="md" data-gallery data-readonly={readonly ? '' : undefined} data-inert={inert ? '' : undefined} data-slug={slug}>
    {editable && <input class="visually-hidden" type="file" accept="image/*" multiple tabindex="-1" aria-hidden="true" data-photo-input />}

    {/* The bar above the grid. Filters show once there is something to filter;
        the batch row shows only right after a drop. */}
    {!inert && (
      <div class="firma2-project-gallery__filters cluster" data-gap="md" data-align="end" data-filters hidden>
        <esa-button-toggle size="md" label="Stage" data-filter-stage></esa-button-toggle>
        <div class="firma2-project-gallery__collection" data-collection-wrap hidden>
          <esa-select size="md" label="Collection" data-filter-collection></esa-select>
        </div>
      </div>
    )}

    {editable && (
      <div class="firma2-project-gallery__batch cluster" data-gap="md" data-align="end" data-batch hidden>
        <p class="typography-body-sm firma2-project-gallery__batch-note" data-batch-note></p>
        <esa-button-toggle size="md" label="Stage for all" data-batch-stage></esa-button-toggle>
        <EsaButton variant="secondary" appearance="outline" size="md" data-batch-done>Done</EsaButton>
      </div>
    )}

    <div class="firma2-project-gallery__empty" data-empty hidden={shown.length > 0 || undefined}>
      <EsaEmptyState size="sm" title="No photos yet" description={editable ? 'Drop photos here, or choose Add photos.' : undefined} />
    </div>

    {editable ? (
      <bcn-sortable-list layout="grid" label="Photos" data-sortable>
        <template data-sort-handle><EsaButton variant="secondary" size="sm" iconOnly icon="menu" aria-label="Move" data-edit-only>Move</EsaButton></template>
        <ol class="firma2-project-gallery__grid grid" data-gap="md" role="list" data-tiles>
          {shown.map((photo, i) => (
            <Firma2PhotoTile id={photo.id} index={i} src={photo.thumb} caption={photo.caption} alt={photo.alt} date={photo.date} stageLabel={stageLabel(photo.stage)} point={photo.point} readonly={false} editable />
          ))}
        </ol>
      </bcn-sortable-list>
    ) : (
      <ol class="firma2-project-gallery__grid grid" data-gap="md" role="list" data-tiles>
        {shown.map((photo, i) => (
          <Firma2PhotoTile id={photo.id} index={i} src={photo.thumb} caption={photo.caption} alt={photo.alt} date={photo.date} stageLabel={stageLabel(photo.stage)} point={photo.point} readonly editable={false} />
        ))}
      </ol>
    )}

    {/* The tile a photo added in the browser (or one a visitor's filter
        brought back) is cloned from. */}
    {!inert && (
      <template data-tile-template>
        <Firma2PhotoTile id="" index={0} src="" caption="" alt="" date="" stageLabel="" readonly={!editable} editable={editable} />
      </template>
    )}

    {/* Data for the script: the seed and the work areas. The viewer's payload
        is built at click time, so a filter scopes the carousel. */}
    <script type="application/json" data-photos-seed set:html={JSON.stringify(seed)} />
    <script type="application/json" data-work-areas set:html={JSON.stringify(workAreas)} />

    {editable && (
      <bcn-side-sheet class="firma2-project-gallery__sheet" heading="Photo details" position="right" data-photo-sheet>
        <div class="stack" data-gap="md">
          <esa-text-field size="md" label="Caption" data-f="caption"></esa-text-field>
          <esa-textarea size="md" label="Description for screen readers" rows="2" help-text="What is visible in the picture, not what the work is." data-f="alt"></esa-textarea>
          <esa-button-toggle size="md" label="Stage" data-f="stage"></esa-button-toggle>
          <div class="stack" data-gap="sm">
            <esa-select size="md" label="Photo point" help-text="Photos from one point can be compared over time." data-f="point"></esa-select>
            <div data-new-wrap="point" hidden><esa-text-field size="md" label="New photo point" placeholder="e.g. Culvert, looking upstream" data-new="point"></esa-text-field></div>
          </div>
          <div class="stack" data-gap="sm">
            <esa-select size="md" label="Collection" help-text="A set shown together, like a planting day." data-f="collection"></esa-select>
            <div data-new-wrap="collection" hidden><esa-text-field size="md" label="New collection" placeholder="e.g. Planting day" data-new="collection"></esa-text-field></div>
          </div>
          <esa-date-picker size="md" label="Taken on" data-f="takenOn"></esa-date-picker>
          <esa-select size="md" label="Work area" data-f="workArea"></esa-select>
          <esa-text-field size="md" label="Credit" data-f="credit"></esa-text-field>
          <esa-switch-toggle size="md" label="Show on the public page" data-f="public"></esa-switch-toggle>
          <div class="cluster" data-gap="sm" data-align="center">
            <EsaButton variant="secondary" appearance="outline" size="md" icon="star" data-sheet-feature>Make featured</EsaButton>
            <span class="typography-meta firma2-project-gallery__feature-note" data-feature-note hidden>Leads the public page.</span>
          </div>
        </div>
        <div slot="footer" class="cluster" data-gap="xs">
          <EsaButton variant="secondary" appearance="outline" size="md" icon="trash-2" data-sheet-remove>Remove photo</EsaButton>
        </div>
      </bcn-side-sheet>
    )}

    {/* Its own wrapper: two sibling custom-element dialogs can come out nested. */}
    {editable && <div class="firma2-project-gallery__confirm"><esa-confirm-dialog variant="danger" confirm-label="Remove" data-confirm></esa-confirm-dialog></div>}
  </div>
</EsaCard>

<style>
  /* auto-FILL, not the primitive's auto-FIT: with fewer photos than a row
     fits, auto-fit stretches the real tracks and the slack reads as padding
     (measured 2026-08-25). Same minmax, one keyword differs. */
  .firma2-project-gallery__grid {
    --grid-min: 13rem;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--grid-min), 100%), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .firma2-project-gallery__batch-note {
    margin: 0;
    flex: 1 1 14rem;
  }

  /* A filtered or empty gallery keeps its ground: the empty state sits where
     the grid was, at the grid's own width. */
  .firma2-project-gallery [hidden] {
    display: none !important;
  }

  .firma2-project-gallery__grid > :global([hidden]) {
    display: none !important;
  }

  /* The sheet host is inline; fixed takes it out of the card's flow. */
  .firma2-project-gallery__sheet {
    position: fixed;
    --side-dialog-width: 400px;
  }

  .firma2-project-gallery__feature-note {
    color: var(--color-content-default-secondary, #60655f);
  }

  /* The sort grip is placed in the tile's slot; the tile's own opacity rules
     reveal it, so the slot only needs to hold the button. */
  .firma2-project-gallery__grid :global(.bcn-sort-grip) {
    position: static;
  }

  /* Locked while a filter hides tiles: no grips, no drag. */
  .firma2-project-gallery[data-filtered] :global([data-sort-grip-slot]) {
    display: none;
  }
</style>

<script>
  import '@esa/ecology/esa-button-toggle';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-textarea';
  import '@esa/ecology/esa-date-picker';
  import '@esa/ecology/esa-switch-toggle';
  import '@esa/ecology/esa-confirm-dialog';
  import '../shared/bcn-side-sheet';
  import '../shared/bcn-sortable-list';
  import { announce } from '@esa/ecology/announcer';
  import { openLightbox, type LightboxImage } from '../../lib/lightbox';
  import { FEATURED_EVENT, slugFromLocation } from '../../lib/featured-photo';
  import { readExif, monthLabel } from '../../lib/exif';
  import { nameButton } from '../../lib/name-button';
  import {
    PHOTO_META_EVENT,
    STAGES,
    addPhoto,
    featurePhoto,
    namesOf,
    orderPhotos,
    patchPhoto,
    patchPhotos,
    removePhoto,
    resolvePhotos,
    stageLabel,
    type PhotoMetaPatch,
    type ResolvedPhoto,
  } from '../../lib/photo-meta';

  type Field = HTMLElement & { value: string; checked?: boolean; options?: { value: string; label: string }[] };
  type Sheet = HTMLElement & { show: () => void; close: () => void };
  type Confirm = HTMLElement & { show: () => void; heading: string; message: string };

  const NONE = '';
  const NEW = '__new__';
  const ALL = 'all';

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const readonly = root.hasAttribute('data-readonly');
    const slug = root.dataset.slug || slugFromLocation();
    const card = root;
    if (root.hasAttribute('data-inert')) return;
    const q = <T extends HTMLElement>(selector: string): T | null => card.querySelector<T>(selector);

    const seed = JSON.parse(q<HTMLScriptElement>('[data-photos-seed]')?.textContent ?? '[]') as (ResolvedPhoto & { thumb: string; full: string })[];
    const areas = JSON.parse(q<HTMLScriptElement>('[data-work-areas]')?.textContent ?? '[]') as { label: string; center: [number, number] }[];
    const grid = q<HTMLElement>('[data-tiles]');
    // No project to act on (a peek, whose scripts never run in practice): the
    // server-rendered tiles stand and the tiles open the viewer from the seed.
    if (!grid) return;

    const images = new Map<string, { thumb: string; full: string }>(seed.map((p) => [p.id, { thumb: p.thumb, full: p.full }]));
    const filters = q<HTMLElement>('[data-filters]')!;
    const stageFilter = q<Field>('[data-filter-stage]')!;
    const collectionWrap = q<HTMLElement>('[data-collection-wrap]')!;
    const collectionFilter = q<Field>('[data-filter-collection]')!;
    const empty = q<HTMLElement>('[data-empty]')!;
    const template = q<HTMLTemplateElement>('[data-tile-template]');

    let photos: ResolvedPhoto[] = [];
    let stage = ALL;
    let collection = ALL;

    const visible = (): ResolvedPhoto[] =>
      photos.filter((p) => (!readonly || p.public) && (stage === ALL || p.stage === stage) && (collection === ALL || p.collection === collection));

    // -- painting one tile from its record ----------------------------------

    const tileFor = (id: string): HTMLElement | null => grid.querySelector<HTMLElement>(`:scope > [data-photo-id="${id}"]`);

    const setText = (tile: HTMLElement, hook: string, text: string): void => {
      const el = tile.querySelector<HTMLElement>(hook);
      if (el && el.textContent !== text) el.textContent = text;
    };

    const paintTile = (tile: HTMLElement, photo: ResolvedPhoto): void => {
      const img = tile.querySelector<HTMLImageElement>('[data-photo-image]')!;
      const src = images.get(photo.id)?.thumb ?? '';
      if (src && img.getAttribute('src') !== src) img.src = src;
      img.alt = photo.alt || '';
      setText(tile, '[data-photo-caption]', photo.caption);
      setText(tile, '[data-photo-stage]', stageLabel(photo.stage));
      setText(tile, '[data-photo-date]', photo.date);
      const sep = tile.querySelector<HTMLElement>('[data-photo-sep]');
      if (sep) sep.hidden = !photo.date;
      const point = tile.querySelector<HTMLElement>('[data-photo-point]');
      if (point) {
        point.textContent = photo.point ?? '';
        point.hidden = !photo.point;
      }
      const featuredBadge = tile.querySelector<HTMLElement>('[data-featured-badge]');
      if (featuredBadge) featuredBadge.hidden = !photo.featured;
      const wrap = tile.querySelector<HTMLElement>('[data-feature-wrap]');
      if (wrap) wrap.hidden = photo.featured || !photo.id.startsWith('p');
      const internal = tile.querySelector<HTMLElement>('[data-internal-badge]');
      if (internal) internal.hidden = photo.public;
      tile.dataset.sortKey = photo.id;
      tile.dataset.sortLabel = photo.caption || 'Photo';
      const named = (hook: string, label: string): void => {
        const el = tile.querySelector<HTMLElement>(hook);
        if (el) nameButton(el, label);
      };
      named('[data-photo-expand]', `View photo: ${photo.caption}`);
      named('[data-photo-feature]', `Make featured: ${photo.caption}`);
      named('[data-photo-edit]', `Edit details: ${photo.caption}`);
    };

    const paint = (): void => {
      photos = resolvePhotos(slug, seed);
      const shown = visible();
      const ids = new Set(shown.map((p) => p.id));

      // A removed photo's tile leaves; a filtered one is only hidden, so the
      // filter can bring it back without a template.
      const all = new Set(photos.filter((p) => !readonly || p.public).map((p) => p.id));
      grid.querySelectorAll<HTMLElement>(':scope > [data-photo-id]').forEach((tile) => {
        if (!all.has(tile.dataset.photoId ?? '')) tile.remove();
      });
      let cursor = 0;
      photos.forEach((photo) => {
        if (readonly && !photo.public && !tileFor(photo.id)) return;
        let tile = tileFor(photo.id);
        if (!tile) {
          tile = template?.content.firstElementChild?.cloneNode(true) as HTMLElement | null;
          if (!tile) return;
          tile.dataset.photoId = photo.id;
        }
        // Placing an in-grid node moves it: this is the reorder.
        const at = grid.children[cursor];
        cursor += 1;
        if (at !== tile) grid.insertBefore(tile, at ?? null);
        tile.hidden = !ids.has(photo.id);
        paintTile(tile, photo);
      });

      // The filters show when there is a choice to make.
      const stages = new Set(photos.map((p) => p.stage));
      const collections = namesOf(photos, 'collection');
      filters.hidden = photos.length < 2 || (stages.size < 2 && collections.length === 0);
      collectionWrap.hidden = collections.length === 0;
      if (collection !== ALL && !collections.includes(collection)) collection = ALL;
      collectionFilter.options = [{ value: ALL, label: 'All collections' }, ...collections.map((c) => ({ value: c, label: c }))];
      collectionFilter.value = collection;

      empty.hidden = shown.length > 0;
      root.toggleAttribute('data-filtered', stage !== ALL || collection !== ALL);
      // A filter hides tiles, so the grid cannot be reordered through it.
      grid.querySelectorAll<HTMLElement>(':scope > li').forEach((li) => li.toggleAttribute('data-sort-locked', root.hasAttribute('data-filtered')));
    };

    // -- filters --------------------------------------------------------------

    void customElements.whenDefined('esa-button-toggle').then(() => {
      const options = [{ value: ALL, label: 'All' }, ...STAGES];
      (stageFilter as unknown as { options: unknown }).options = options;
      stageFilter.value = ALL;
      stageFilter.addEventListener('change', (e) => {
        stage = (e as CustomEvent<{ value: string }>).detail.value || ALL;
        paint();
      });
    });
    collectionFilter.addEventListener('change', (e) => {
      collection = (e as CustomEvent<{ value: string }>).detail.value || ALL;
      paint();
    });

    // -- the viewer -----------------------------------------------------------

    const toImage = (p: ResolvedPhoto): LightboxImage => ({
      src: images.get(p.id)?.full ?? '',
      caption: p.caption,
      alt: p.alt || undefined,
      date: p.date,
      tag: [stageLabel(p.stage), p.point].filter(Boolean).join(' · '),
    });
    const showViewer = (index: number): void => {
      const list = visible();
      openLightbox({ images: list.map(toImage), index, heading: collection !== ALL ? collection : 'Photos' });
    };
    grid.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const tile = target.closest<HTMLElement>(':scope > li') ?? target.closest<HTMLElement>('[data-photo-id]');
      if (!tile || !grid.contains(tile)) return;
      if (target.closest('[data-photo-edit]')) return openSheet(tile.dataset.photoId ?? '');
      if (target.closest('[data-photo-feature]')) return makeFeatured(tile.dataset.photoId ?? '');
      if (target.closest('[data-photo-expand]') || target.closest('[data-photo-image]')) {
        showViewer([...grid.children].filter((li) => !(li as HTMLElement).hidden).indexOf(tile));
      }
    });

    if (readonly) {
      window.addEventListener(PHOTO_META_EVENT, paint);
      window.addEventListener(FEATURED_EVENT, paint);
      paint();
      return;
    }

    // -- featured -------------------------------------------------------------

    const makeFeatured = (id: string): void => {
      featurePhoto(slug, id);
      const photo = photos.find((p) => p.id === id);
      announce(`${photo?.caption ?? 'Photo'} now leads the public page`);
    };

    // -- reorder --------------------------------------------------------------

    q<HTMLElement>('[data-sortable]')?.addEventListener('sort-change', (event) => {
      const moved = (event as CustomEvent<{ order: string[] }>).detail.order;
      // The grid holds every photo when no filter is on, so its order is the record's.
      if (!root.hasAttribute('data-filtered')) orderPhotos(slug, moved);
    });

    // -- the details sheet ----------------------------------------------------

    const sheet = q<Sheet>('[data-photo-sheet]')!;
    const confirm = q<Confirm>('[data-confirm]')!;
    const field = (name: string): Field => sheet.querySelector<Field>(`[data-f="${name}"]`)!;
    const newWrap = (name: string): HTMLElement => sheet.querySelector<HTMLElement>(`[data-new-wrap="${name}"]`)!;
    const newField = (name: string): Field => sheet.querySelector<Field>(`[data-new="${name}"]`)!;
    let editing = '';
    let opener: HTMLElement | null = null;

    const current = (): ResolvedPhoto | undefined => photos.find((p) => p.id === editing);

    const choices = (key: 'point' | 'collection', none: string, add: string) => [
      { value: NONE, label: none },
      ...namesOf(photos, key).map((n) => ({ value: n, label: n })),
      { value: NEW, label: add },
    ];

    const fillSheet = (): void => {
      const p = current();
      if (!p) return;
      field('caption').value = p.caption;
      field('alt').value = p.alt;
      field('stage').value = p.stage;
      field('point').options = choices('point', 'None', 'New photo point…');
      field('point').value = p.point ?? NONE;
      field('collection').options = choices('collection', 'None', 'New collection…');
      field('collection').value = p.collection ?? NONE;
      newWrap('point').hidden = true;
      newWrap('collection').hidden = true;
      field('takenOn').value = p.takenOn;
      field('workArea').options = [{ value: NONE, label: 'None' }, ...areas.map((a) => ({ value: a.label, label: a.label }))];
      field('workArea').value = p.workArea ?? NONE;
      field('credit').value = p.credit ?? '';
      field('public').checked = p.public;
      const featuredHere = p.featured;
      const canFeature = p.id.startsWith('p');
      const featureButton = sheet.querySelector<HTMLElement>('[data-sheet-feature]')!;
      featureButton.hidden = featuredHere || !canFeature;
      sheet.querySelector<HTMLElement>('[data-feature-note]')!.hidden = !featuredHere;
    };

    const openSheet = (id: string): void => {
      editing = id;
      opener = tileFor(id)?.querySelector<HTMLElement>('[data-photo-edit] button, [data-photo-edit]') ?? null;
      void Promise.all(
        ['esa-select', 'esa-text-field', 'esa-textarea', 'esa-button-toggle', 'esa-date-picker', 'esa-switch-toggle'].map((tag) => customElements.whenDefined(tag)),
      ).then(() => {
        (field('stage') as unknown as { options: unknown }).options = STAGES;
        fillSheet();
        sheet.show();
      });
    };

    const save = (patch: PhotoMetaPatch): void => {
      if (editing) patchPhoto(slug, editing, patch);
    };

    const on = (name: string, handler: (value: string, event: CustomEvent) => void): void => {
      field(name).addEventListener('change', (e) => handler((e as CustomEvent<{ value: string }>).detail?.value ?? '', e as CustomEvent));
    };
    on('caption', (v) => save({ caption: v.trim() }));
    on('alt', (v) => save({ alt: v.trim() }));
    on('stage', (v) => v && save({ stage: v as ResolvedPhoto['stage'] }));
    on('takenOn', (v) => save({ takenOn: v, date: monthLabel(v) || current()?.date || '' }));
    on('workArea', (v) => save({ workArea: v || undefined }));
    on('credit', (v) => save({ credit: v.trim() || undefined }));
    field('public').addEventListener('change', (e) => save({ public: (e as CustomEvent<{ checked: boolean }>).detail.checked }));

    // A name that is not in the list yet is typed in, then saved on commit.
    (['point', 'collection'] as const).forEach((key) => {
      on(key, (v) => {
        const isNew = v === NEW;
        newWrap(key).hidden = !isNew;
        if (isNew) return newField(key).focus();
        save({ [key]: v || undefined });
      });
      const commit = (): void => {
        const name = newField(key).value.trim();
        if (!name) return;
        save({ [key]: name });
        announce(`${key === 'point' ? 'Photo point' : 'Collection'} ${name} saved`);
        requestAnimationFrame(fillSheet);
      };
      newField(key).addEventListener('change', commit);
    });

    sheet.querySelector('[data-sheet-feature]')?.addEventListener('click', () => {
      if (editing) makeFeatured(editing);
    });
    sheet.addEventListener('close', () => {
      editing = '';
      opener?.focus?.();
    });

    sheet.querySelector('[data-sheet-remove]')?.addEventListener('click', () => {
      const p = current();
      if (!p) return;
      confirm.heading = `Remove ${p.caption || 'this photo'}?`;
      confirm.message = 'The photo leaves this record and its public page.';
      confirm.addEventListener(
        'resolved',
        (e) => {
          if (!(e as CustomEvent<{ confirmed: boolean }>).detail.confirmed) return;
          removePhoto(slug, p.id);
          sheet.close();
          announce(`${p.caption || 'Photo'} removed`);
        },
        { once: true },
      );
      confirm.show();
    });

    // -- adding many at once --------------------------------------------------

    const input = q<HTMLInputElement>('[data-photo-input]')!;
    const addButton = q<HTMLElement>('[data-photo-add]');
    const batch = q<HTMLElement>('[data-batch]')!;
    const batchNote = q<HTMLElement>('[data-batch-note]')!;
    const batchStage = q<Field>('[data-batch-stage]')!;
    let batchIds: string[] = [];

    const metersApart = (a: [number, number], b: [number, number]): number => {
      const k = Math.PI / 180;
      const x = (b[1] - a[1]) * k * Math.cos(((a[0] + b[0]) / 2) * k);
      const y = (b[0] - a[0]) * k;
      return Math.hypot(x, y) * 6371000;
    };

    const nearestArea = (position: [number, number]): string | undefined => {
      const ranked = areas
        .map((a) => ({ label: a.label, d: metersApart(position, a.center) }))
        .sort((a, b) => a.d - b.d)[0];
      // A work area is a footprint, not a point: past a few kilometres the photo is not of it.
      return ranked && ranked.d < 3000 ? ranked.label : undefined;
    };

    const addFiles = async (files: File[]): Promise<void> => {
      const pictures = files.filter((f) => f.type.startsWith('image/'));
      if (!pictures.length) return;
      let read = 0;
      batchIds = [];
      for (const file of pictures) {
        const exif = await readExif(file);
        if (exif.takenOn || exif.position) read += 1;
        const url = URL.createObjectURL(file);
        const photo = addPhoto(slug, {
          thumb: url,
          full: url,
          caption: file.name.replace(/\.[^.]+$/, '').replace(/[_-]+/g, ' ').trim(),
          takenOn: exif.takenOn ?? new Date().toISOString().slice(0, 10),
          date: monthLabel(exif.takenOn ?? new Date().toISOString().slice(0, 10)),
          workArea: exif.position ? nearestArea(exif.position) : undefined,
        });
        images.set(photo.id, { thumb: url, full: url });
        batchIds.push(photo.id);
        // addPhoto painted before its pixels were known; paint once more with them.
        paint();
      }
      batchNote.textContent =
        `${pictures.length} ${pictures.length === 1 ? 'photo' : 'photos'} added. ` +
        (read ? `Date or location read from ${read} of ${pictures.length}.` : 'None had a date or location to read.');
      batch.hidden = false;
      (batchStage as unknown as { value: string }).value = '';
      announce(batchNote.textContent);
    };

    addButton?.addEventListener('click', () => input.click());
    input.addEventListener('change', () => {
      void addFiles([...(input.files ?? [])]);
      input.value = '';
    });
    void customElements.whenDefined('esa-button-toggle').then(() => {
      (batchStage as unknown as { options: unknown }).options = STAGES;
      batchStage.addEventListener('change', (e) => {
        const v = (e as CustomEvent<{ value: string }>).detail.value;
        if (v && batchIds.length) patchPhotos(slug, batchIds, { stage: v as ResolvedPhoto['stage'] });
      });
    });
    q<HTMLElement>('[data-batch-done]')?.addEventListener('click', () => {
      batch.hidden = true;
      batchIds = [];
    });

    // The whole card is the drop target.
    let depth = 0;
    card.addEventListener('dragenter', (e) => {
      if (!(e as DragEvent).dataTransfer?.types.includes('Files')) return;
      depth += 1;
      root.setAttribute('data-dragging', '');
    });
    card.addEventListener('dragleave', () => {
      depth = Math.max(depth - 1, 0);
      if (!depth) root.removeAttribute('data-dragging');
    });
    card.addEventListener('dragover', (e) => {
      if ((e as DragEvent).dataTransfer?.types.includes('Files')) e.preventDefault();
    });
    card.addEventListener('drop', (e) => {
      const files = [...((e as DragEvent).dataTransfer?.files ?? [])];
      if (!files.length) return;
      e.preventDefault();
      depth = 0;
      root.removeAttribute('data-dragging');
      void addFiles(files);
    });

    window.addEventListener(PHOTO_META_EVENT, () => {
      paint();
      if (editing) fillSheetValues();
    });
    window.addEventListener(FEATURED_EVENT, paint);

    // A save repaints the grid; the sheet's own fields already show what was
    // typed, so only the featured controls need to follow.
    const fillSheetValues = (): void => {
      const p = current();
      if (!p) return;
      sheet.querySelector<HTMLElement>('[data-sheet-feature]')!.hidden = p.featured || !p.id.startsWith('p');
      sheet.querySelector<HTMLElement>('[data-feature-note]')!.hidden = !p.featured;
    };

    paint();
  });
</script>

<style is:global>
  /* Files dragged over the card: the card is the target. */
  .firma2-project-gallery[data-dragging] {
    outline: var(--border-width-emphasis, 2px) dashed var(--color-border-brand, #46a758);
    outline-offset: var(--spacing-200, 0.5rem);
    border-radius: var(--radius-sm, 4px);
  }
</style>
