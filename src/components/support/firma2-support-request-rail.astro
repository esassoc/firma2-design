---
// firma2-support-request-rail — the selected support request's details beside
// the inbox, as the selected project's Key facts sit beside Review
// (firma2-review-project-rail).
//
// ONE PANEL PER REQUEST, one shown. The inbox says which on
// firma2:inbox-select ({ key }). Requests sent in this browser share one blank
// panel, which fills itself (firma2-support-request-details). With nothing
// selected — an empty view — every panel hides and the rail says so in a line.
//
// It sits in firma2-side-panel's slot (firma2-rail): the corner toggle
// collapses it and the reader's choice is remembered there.
//
// bcn-lego-checked: each panel is firma2-support-request-details; the rail is
// firma2-rail via firma2-side-panel. This file only chooses which panel shows.
// The only CSS makes `hidden` hold.
import Firma2SupportRequestDetails from './firma2-support-request-details.astro';
import { supportRequestSlug, supportRequests } from '../../data/firma2-support-requests';
---
<div class="firma2-support-request-rail" data-support-rail>
  {supportRequests.map((r) => (
    <div data-rail-request={supportRequestSlug(r.id)} hidden>
      <Firma2SupportRequestDetails request={r} />
    </div>
  ))}
  <div data-rail-request="*" hidden>
    <Firma2SupportRequestDetails />
  </div>
  <p class="typography-body-md" data-rail-none hidden>No request selected.</p>
</div>

<style>
  .firma2-support-request-rail [hidden] {
    display: none !important;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-support-rail]').forEach((root) => {
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-rail-request]'));
    document.addEventListener('firma2:inbox-select', (event) => {
      const key = (event as CustomEvent<{ key: string }>).detail.key;
      const own = panels.some((p) => p.dataset.railRequest === key);
      panels.forEach((p) => (p.hidden = !key || (p.dataset.railRequest === '*' ? own : p.dataset.railRequest !== key)));
      root.querySelector<HTMLElement>('[data-rail-none]')!.hidden = !!key;
    });
  });
</script>
