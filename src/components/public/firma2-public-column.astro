---
// firma2-public-column — the reading column of a public page: the public
// project page's 76rem measure and the frame's gutter, with the page's
// sections stacked inside. Every public template below its masthead sits in
// one of these, so their left edges agree.
//
// bcn-lego-checked: esa-container is this with a fixed 2rem gutter; the public
// frame's gutter narrows on a phone (--firma2-public-gutter, PublicLayout) and
// a container that ignores it puts the page 16px off its own header.
---
<div class="firma2-public-column stack" data-gap="2xl">
  <slot />
</div>

<style>
  .firma2-public-column {
    box-sizing: border-box;
    inline-size: 100%;
    max-inline-size: 76rem;
    margin-inline: auto;
    padding-inline: var(--firma2-public-gutter, var(--spacing-600));
    padding-block: var(--spacing-700) var(--spacing-900);
  }
</style>
