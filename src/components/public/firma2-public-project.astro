<script>
  import { fieldRows, resolveSections } from '../../data/firma2-project-types';
  import { allFields, isProjectTypeKey, withProjectTypeDraft } from '../../lib/project-type-draft';
  import { applyBrand, readBrand, TENANT_BRAND_KEY } from '../../lib/tenant-brand';

  const esc = (s: string): string =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  document.querySelectorAll<HTMLElement>('.firma2-public-project').forEach((root) => {
    const slug = root.dataset.projectTypeSlug ?? '';
    const project = JSON.parse(root.dataset.project ?? '{}');

    /** Fold the project type's current state over the page — the studio's preview runs this too. */
    const resolve = () => {
      const projectType = withProjectTypeDraft(slug);
      if (!projectType) return;
      resolveSections(projectType.sections).forEach(({ section, visible }, index) => {
        const el = root.querySelector<HTMLElement>(`[data-section="${section.key}"]`);
        if (!el) return;
        el.style.order = String(index);
        el.hidden = !visible;
      });
      const defs = allFields();
      (['rail', 'details'] as const).forEach((placement) => {
        const dl = root.querySelector<HTMLElement>(`[data-fields="${placement}"]`);
        if (!dl) return;
        dl.innerHTML = fieldRows(projectType, project, defs, placement)
          .map(
            (r) =>
              `<div><dt>${esc(r.label)}</dt><dd>${r.value ? esc(r.value) : '<span class="firma2-public-project__none">Not answered</span>'}</dd></div>`,
          )
          .join('');
      });
    };

    resolve();
    // The studio and the branding screen write in another window; this one follows.
    window.addEventListener('storage', (event) => {
      if (isProjectTypeKey(event.key)) resolve();
      if (event.key === TENANT_BRAND_KEY) applyBrand(readBrand());
    });
  });
</script>

<script>
  // THE FEATURED PHOTO AND THE PAIR, as this browser last edited them on the
  // record: this browser's metadata laid over the seed the gallery carries.
  import { PHOTO_META_EVENT, leadPair, leadPhoto, resolvePhotos, type ResolvedPhoto } from '../../lib/photo-meta';
  import { FEATURED_EVENT } from '../../lib/featured-photo';

  const apply = (): void => {
    const seedEl = document.querySelector<HTMLScriptElement>('[data-photos-seed]');
    const figure = document.querySelector<HTMLElement>('[data-featured-slug]');
    const compare = document.querySelector<HTMLElement>('[data-compare]');
    const slug = figure?.dataset.featuredSlug ?? document.querySelector<HTMLElement>('[data-gallery]')?.dataset.slug ?? '';
    if (!seedEl || !slug) return;
    const photos: ResolvedPhoto[] = resolvePhotos(slug, JSON.parse(seedEl.textContent ?? '[]'));

    if (figure) {
      const leads: { id: string; src: string; caption: string; date: string }[] = JSON.parse(figure.dataset.featuredPhotos ?? '[]');
      const chosen = leadPhoto(photos);
      const photo = leads.find((l) => l.id === chosen?.id);
      const img = figure.querySelector<HTMLImageElement>('[data-featured-image]');
      if (photo && img && img.getAttribute('src') !== photo.src) {
        img.src = photo.src;
        figure.querySelector('[data-featured-caption]')!.textContent = photo.caption;
        figure.querySelector('[data-featured-date]')!.textContent = photo.date;
      }
    }

    if (compare) {
      const wide: Record<string, string> = JSON.parse(compare.dataset.wide ?? '{}');
      const pair = leadPair(photos);
      const usable = !!pair && !!wide[pair.before.id] && !!wide[pair.after.id];
      compare.hidden = !usable;
      if (usable && pair) {
        const set = (hook: string, attr: 'src' | 'alt', value: string): void => {
          const el = compare.querySelector<HTMLImageElement>(hook);
          if (el && el[attr] !== value) el[attr] = value;
        };
        set('[data-compare-before]', 'src', wide[pair.before.id]);
        set('[data-compare-after]', 'src', wide[pair.after.id]);
        set('[data-compare-before]', 'alt', pair.before.alt || pair.before.caption);
        set('[data-compare-after]', 'alt', pair.after.alt || pair.after.caption);
        compare.querySelector('[data-compare-before-date]')!.textContent = pair.before.date;
        compare.querySelector('[data-compare-after-date]')!.textContent = pair.after.date;
        compare.querySelector('[data-compare-caption]')!.textContent =
          `${pair.before.caption} (${pair.before.date}) · ${pair.after.caption} (${pair.after.date})`;
      }
    }
  };

  apply();
  window.addEventListener(PHOTO_META_EVENT, apply);
  window.addEventListener(FEATURED_EVENT, apply);
</script>

<script>
  // BEFORE AND AFTER. The split follows a fine pointer across the photo 1:1,
  // a finger dragging across it, and the arrow keys through the range input.
  document.querySelectorAll<HTMLElement>('[data-wipe]').forEach((wipe) => {
    const range = wipe.querySelector<HTMLInputElement>('[data-wipe-range]')!;
    const set = (percent: number) => {
      const p = Math.min(100, Math.max(0, percent));
      wipe.style.setProperty('--split', `${p.toFixed(2)}%`);
      range.value = String(Math.round(p));
    };
    const fromPointer = (e: PointerEvent) => {
      const box = wipe.getBoundingClientRect();
      set(((e.clientX - box.left) / box.width) * 100);
    };
    wipe.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse' || e.buttons) fromPointer(e);
    });
    wipe.addEventListener('pointerdown', fromPointer);
    range.addEventListener('input', () => set(Number(range.value)));
  });
</script>

<script>
  // Figures count up from zero while the pointer is on them (src/lib/count-up).
  import { countUpOnHover } from '../../lib/count-up';
  countUpOnHover();
</script>

<script>
  // A publish made in this browser brings the page up to the record: each
  // value the publish covered swaps to its current text, and each row it
  // added appears. Reverted changes never do — the public value IS the record.
  import { readPublishing } from '../../lib/publish-store';

  document.querySelectorAll<HTMLElement>('.firma2-public-project[data-publish-slug]').forEach((root) => {
    const done = new Set(readPublishing().published[root.dataset.publishSlug!]?.keys ?? []);
    if (!done.size) return;
    root.querySelectorAll<HTMLElement>('[data-publish-key]').forEach((el) => {
      if (!done.has(el.dataset.publishKey!)) return;
      if (el.hasAttribute('data-reveal')) el.hidden = false;
      else if (el.dataset.current !== undefined) el.textContent = el.dataset.current;
    });
  });
</script>
