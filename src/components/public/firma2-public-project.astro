---
// firma2-public-project — a project's public page, built by its project
// type and worn in the tenant's brand. Ported from ProjectFirma2 hackathon team 3.
//
// WHO READS THIS: the brief's hardest reader — the public or a funder,
// arrived from a link with no account, no task and no vocabulary. Their first
// question is "what is this, whose is it, and is it real?". The tenant's name
// is the public header's (firma2-public-header), above this; the page states
// facts rather than offering edits.
//
// REWORKED 2026-11-20 IN THE PUBLIC HOME'S LANGUAGE (user: "taking
// inspiration with some of the design choices we made in the main home
// page"). What it borrows, and where:
//   - THE DARK HERO: name and two facts at poster size on the left, the
//     record's Featured photo running to the window's edge on the right.
//   - SECTIONS AS BANDS, NOT CARDS IN A COLUMN: each section is the page's
//     width with its own heading; no rail. The rail's facts are a strip under
//     the hero.
//   - EACH SECTION SHOWS ITS DATA IN ITS OWN SHAPE: results as figure cards
//     with a year-by-year bar of reported against planned; funding as a
//     TREEMAP (area = dollars, src/lib/treemap.ts); spending as a column per
//     year; photos open on a BEFORE-AND-AFTER the reader drags across.
//   - GOALS WEAR THEIR ICONS (the home's goal icons).
//   - Hover motion answers the pointer only, and each section moves in its
//     own way; reduced motion keeps colour and drops movement.
//
// THE PROJECT TYPE BUILDS THE PAGE. Which sections appear, in what
// order, and which of the tenant's own fields sit in the facts strip ("rail")
// or under Project details all come from the project's type
// (src/data/firma2-project-types.ts). The sections render once at build;
// the script folds its current delta over them — the same resolver the
// studio's preview runs, because the preview IS this page, in a frame. The
// hooks it needs (data-section + order, data-fields, data-aliasable-*) are
// kept on the same elements.
//
// THE PUBLISHED STATE, NOT THE RECORD: values a publish has not covered carry
// data-publish-key + data-current, and the last script swaps them in once this
// browser has published that change.
//
// WITHHELD, NOT HIDDEN — in production. The hackathon's sharpest point: a
// section switched off is pruned from the data the page is served, so it
// cannot be found in dev tools. A static prototype cannot prune; it hides.
// Said here so nobody mistakes the prototype's mechanism for the design.
import { iconSvg } from '@esa/ecology/icon-registry';
import Firma2ProjectTimeline from '../projects/firma2-project-timeline.astro';
import Firma2ProjectGallery from '../projects/firma2-project-gallery.astro';
import Firma2ProjectMap from '../projects/firma2-project-map.astro';
import Firma2VerifiedMark from '../shared/firma2-verified-mark.astro';
import { organizations } from '../../data/firma2-directory';
import { classificationNamed, isGoal } from '../../data/firma2-classifications';
import type { ProjectDetail } from '../../data/firma2-project-detail';
import type { PublishedSnapshot } from '../../data/firma2-publish-history';
import { projectSlug } from '../../data/firma2-projects';
import { latestReport } from '../../data/firma2-project-detail';
import { publicGoalHref, publicGoalIcon } from '../../data/firma2-public-site';
import {
  FIELD_DEFINITIONS,
  PAGE_SECTIONS,
  fieldRows,
  resolveSections,
  projectTypeFor,
} from '../../data/firma2-project-types';
import type { FieldRow } from '../../data/firma2-project-types';
import { withBase } from '../../lib/base';
import { currencyFormatter } from '../../lib/format';
import { photoSrc } from '../../lib/project-photos';
import { treemap } from '../../lib/treemap';
import { leadPair, leadPhoto, plainPhotos } from '../../lib/photo-meta';

interface Props {
  detail: ProjectDetail;
  /**
   * The public page's own route passes this: the page shows the last PUBLISHED
   * state of the record, not the record (the review-and-publish workflow,
   * user 2026-10-09). Where the two differ, the element carries the change's
   * key and its current value, and the script swaps the value in once this
   * browser has published that change. The project-type studio's preview
   * omits it — the preview shows the record as it is.
   */
  published?: PublishedSnapshot;
}

const { detail, published } = Astro.props;
const { project } = detail;
const leadOrg = organizations.find((o) => o.name === project.leadOrganization);
const projectType = projectTypeFor(project);
const years = `${project.implementationStartYear}–${project.completionYear}`;
const fmt = (n: number, decimals = 1) => n.toLocaleString('en-US', { maximumFractionDigits: decimals });
const compactUsd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', notation: 'compact', maximumFractionDigits: 1 });

// What the public sees, and what each differing value becomes after a publish.
const shown = {
  cost: currencyFormatter.format(published?.estimatedTotalCost ?? project.estimatedTotalCost),
  years: published ? `${published.implementationStartYear}–${published.completionYear}` : years,
  county: published?.county ?? project.county,
  stage: published?.stage ?? project.stage,
  description: published?.description ?? detail.projectDescription,
};
const current = {
  cost: currencyFormatter.format(project.estimatedTotalCost),
  years,
  county: project.county,
  stage: project.stage,
  description: detail.projectDescription,
};
/** data-publish-key + data-current where the public value is behind the record. */
const pending = (key: string, publicValue: string, currentValue: string) =>
  publicValue === currentValue ? {} : { 'data-publish-key': key, 'data-current': currentValue };
const withheldReport = (name: string, year: number) =>
  Boolean(published?.withheldReports.some((r) => r.measure === name && r.year === year));

// ---- Results: each measure as published (a withheld filing is not in its
// total, its last year or its bar), with its year-by-year series.
const results = detail.measures.map((m) => {
  const withheld = m.series.find((p) => withheldReport(m.name, p.year));
  const visible = m.reported - (withheld?.value ?? 0);
  const series = m.series.map((p) => ({ ...p, value: withheldReport(m.name, p.year) ? null : p.value }));
  const top = Math.max(1, ...series.map((p) => Math.max(p.planned ?? 0, p.value ?? 0)));
  return {
    name: m.name,
    unit: m.unit,
    figure: fmt(visible),
    figureNow: fmt(m.reported),
    percent: m.expected > 0 ? Math.min(100, Math.round((visible / m.expected) * 100)) : 0,
    expected: fmt(m.expected),
    last: String(latestReport(m.series.filter((p) => !withheldReport(m.name, p.year)))?.year ?? '—'),
    lastNow: String(latestReport(m.series)?.year ?? '—'),
    key: withheld ? `report:${m.name}:${withheld.year}` : '',
    bars: series.map((p) => ({
      year: p.year,
      planned: ((p.planned ?? 0) / top) * 100,
      reported: p.value === null ? null : (p.value / top) * 100,
      label: `${p.year}: ${p.value === null ? 'not reported' : `${fmt(p.value)} reported`}${p.planned ? ` of ${fmt(p.planned)} planned` : ''}`,
    })),
  };
});

// ---- Funding: a treemap of the sources the public sees; a source withheld
// from the last publish is listed after it, hidden, until a publish reveals it.
const sources = detail.funding.filter((row) => row.status === 'secured').sort((a, b) => b.amount - a.amount);
const shownSources = sources.filter((f) => !published?.withheldFunding.includes(f.name));
const withheldSources = sources.filter((f) => published?.withheldFunding.includes(f.name));
const fundingTotal = shownSources.reduce((sum, f) => sum + f.amount, 0);
// Fewer sources read as a band; more need height to stay near square.
const FUND_WIDE = shownSources.length <= 2 ? 4.5 : shownSources.length === 3 ? 3.4 : 2.6;
const FUND_TALL = 0.8;
const fundWide = treemap(shownSources.map((f) => f.amount), FUND_WIDE);
const fundTall = treemap(shownSources.map((f) => f.amount), FUND_TALL);
const pct = (n: number) => `${(n * 100).toFixed(3)}%`;
const fundPlace = (i: number) =>
  `--x:${pct(fundWide[i].x)};--y:${pct(fundWide[i].y)};--w:${pct(fundWide[i].w)};--h:${pct(fundWide[i].h)};--tx:${pct(fundTall[i].x)};--ty:${pct(fundTall[i].y)};--tw:${pct(fundTall[i].w)};--th:${pct(fundTall[i].h)};--pad:${fundWide[i].w < 0.14 ? 'var(--spacing-300)' : 'var(--spacing-500)'}`;

// ---- Spending: one column per year with money spent.
const spent = detail.expenditures.filter((e) => e.spent > 0);
const spentTotal = spent.reduce((sum, e) => sum + e.spent, 0);
const spentTop = Math.max(1, ...spent.map((e) => e.spent));

// ---- Goals: the plan goals this project works toward, with their icons.
const goals = project.classifications
  .map((name) => classificationNamed(name))
  .filter((c): c is NonNullable<typeof c> => !!c && isGoal(c));

const rows = (placement: 'rail' | 'details'): FieldRow[] =>
  fieldRows(projectType, project, FIELD_DEFINITIONS, placement);

/** One <div><dt><dd></div> per row — the markup the script rebuilds, identically. */
const rowsHtml = (list: FieldRow[]) =>
  list
    .map(
      (r) =>
        `<div><dt>${r.label}</dt><dd>${r.value || '<span class="firma2-public-project__none">Not answered</span>'}</dd></div>`,
    )
    .join('');

// Build-time resolution, so the page is right before the script runs.
const resolved = resolveSections(projectType.sections);
const orderIndex = new Map(resolved.map((r, i) => [r.section.key, i]));
const hiddenAtBuild = new Set(resolved.filter((r) => !r.visible).map((r) => r.section.key));
const label = (key: string) => PAGE_SECTIONS.find((s) => s.key === key)?.label ?? key;

// The Featured photo, tall, for the hero's right half. Every candidate's URL
// rides along so this browser's choice can swap in without a rebuild.
const slug = projectSlug(project);
const seedPhotos = plainPhotos(slug, detail.photos);
// A private photo never leads the page, and never fills the compare: the
// seed's choice here, this browser's edits laid over it by the script below.
const featuredId = leadPhoto(seedPhotos)?.id;
const leadPhotos = detail.photos.map((photo, i) => ({ id: `p${i}`, public: photo.public, src: photoSrc(photo, 1100, 1240, 70), caption: photo.caption, date: photo.date }));
const lead = featuredId && !hiddenAtBuild.has('gallery') ? leadPhotos.find((p) => p.id === featuredId) : undefined;

// Before and after: two photos at one photo point, a Before and an After.
// The wide crops of every photo ride along so an edit made in this browser
// can re-pick the pair without a rebuild.
const pair = leadPair(seedPhotos);
const before = pair?.before;
const after = pair?.after;
const wide = Object.fromEntries(detail.photos.map((photo, i) => [`p${i}`, photoSrc(photo, 1600, 800, 70)]));
---
<!-- bcn-lego-checked: the bands, hero, facts strip, result cards, treemap and
     spending columns are layout for this page's sections — no esa- component
     draws a treemap or a column chart (esa-chart is bars/lines/pies on a
     canvas, and these must be plain, linkable markup); esa-badge is the
     stage; the timeline, photos and map are the project page's own section
     components. Beacon is not cloned on this machine. -->
<article
  class="firma2-public-project"
  data-project-type-slug={projectType.slug}
  data-publish-slug={published ? projectSlug(project) : undefined}
  data-project={JSON.stringify({ projectName: project.projectName, implementationStartYear: project.implementationStartYear })}
>
  <header class:list={['firma2-public-project__hero', !lead && 'firma2-public-project__hero--text']}>
    <div class="firma2-public-project__hero-text stack" data-gap="xl">
      <div class="stack" data-gap="md">
        {projectType && <p class="firma2-public-project__type typography-label-lg-strong">{projectType.name}</p>}
        <h1 class="typography-display">{project.projectName}</h1>
        <p class="firma2-public-project__meta cluster typography-body-lg" data-gap="sm">
          <span class="firma2-public-project__stage" {...pending('stage', shown.stage, current.stage)}>{shown.stage}</span>
          <span><span {...pending('county', shown.county, current.county)}>{shown.county}</span> County</span>
        </p>
      </div>
      <dl class="firma2-public-project__poster">
        <div data-count-host>
          <dt class="typography-label-lg">Estimated cost</dt>
          <dd {...pending('estimatedTotalCost', shown.cost, current.cost)} data-count={shown.cost === current.cost ? '' : undefined}>{shown.cost}</dd>
        </div>
        <div>
          <dt class="typography-label-lg">Timeline</dt>
          <dd {...pending('timeline', shown.years, current.years)}>{shown.years}</dd>
        </div>
      </dl>
    </div>
    {lead && (
      <figure class="firma2-public-project__featured" data-featured-slug={slug} data-featured-photos={JSON.stringify(leadPhotos)}>
        {/* alt="" because the caption on it says what it shows. */}
        <img src={lead.src} alt="" width="1100" height="1240" decoding="async" fetchpriority="high" data-featured-image />
        <figcaption class="typography-body-sm"><span data-featured-caption>{lead.caption}</span> · <span data-featured-date>{lead.date}</span></figcaption>
      </figure>
    )}
  </header>

  <!-- The facts strip: who leads it, plus the tenant's own questions the
       project type places here ("rail" fields). -->
  <div class="firma2-public-project__strip" data-aliasable-labels>
    <div class="firma2-public-project__strip-inner">
      <dl class="firma2-public-project__strip-fields">
        <div><dt>Lead organization</dt><dd>{project.leadOrganization}{leadOrg && <> <Firma2VerifiedMark organization={leadOrg} /></>}</dd></div>
      </dl>
      <dl class="firma2-public-project__strip-fields" data-fields="rail" set:html={rowsHtml(rows('rail'))}></dl>
    </div>
  </div>

  <div class="firma2-public-project__sections" data-sections>
    <section data-section="details" data-aliasable-title class="firma2-public-project__band" style={`order:${orderIndex.get('details')}`} hidden={hiddenAtBuild.has('details')} aria-labelledby="firma2-pp-details">
      <div class="firma2-public-project__col stack" data-gap="lg">
        <h2 id="firma2-pp-details" class="typography-heading-lg">{label('details')}</h2>
        <div class="firma2-public-project__about">
          <p class="firma2-public-project__description typography-body-lg" {...pending('description', shown.description, current.description)}>{shown.description}</p>
          <dl class="firma2-public-project__facts" data-fields="details" set:html={rowsHtml(rows('details'))}></dl>
        </div>
        {goals.length > 0 && (
          <div class="stack" data-gap="sm">
            <h3 class="typography-title-sm-strong" id="firma2-pp-goals">Goals it works toward</h3>
            <ul class="firma2-public-project__goals cluster" data-gap="sm" aria-labelledby="firma2-pp-goals">
              {goals.map((g) => (
                <li>
                  <a href={withBase(publicGoalHref(g))}>
                    <span class="firma2-public-project__goal-icon" aria-hidden="true" set:html={iconSvg(publicGoalIcon(g), 28) ?? ''} />
                    <span class="typography-label-md-strong">{g.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

    <section data-section="measures" data-aliasable-title class="firma2-public-project__band" style={`order:${orderIndex.get('measures')}`} hidden={hiddenAtBuild.has('measures')} aria-labelledby="firma2-pp-measures">
      <div class="firma2-public-project__col stack" data-gap="lg">
        <h2 id="firma2-pp-measures" class="typography-heading-lg">{label('measures')}</h2>
        {results.length === 0 ? (
          <p class="firma2-public-project__quiet typography-body-md">No performance measures yet.</p>
        ) : (
          <ul class="firma2-public-project__results">
            {results.map((r) => (
              <li class="firma2-public-project__result" data-count-host>
                <div class="stack" data-gap="2xs">
                  <span class="firma2-public-project__figure">
                    <span data-count {...(r.key ? { 'data-publish-key': r.key, 'data-current': r.figureNow } : {})}>{r.figure}</span>
                  </span>
                  <span class="typography-label-md-strong">{r.name}</span>
                  <span class="firma2-public-project__quiet typography-body-sm">
                    of {r.expected} {r.unit} planned · last reported <span {...(r.key ? { 'data-publish-key': r.key, 'data-current': r.lastNow } : {})}>{r.last}</span>
                  </span>
                </div>
                <div class="firma2-public-project__share" role="img" aria-label={`${r.percent}% of planned`}>
                  <span style={`--share:${r.percent / 100}`}></span>
                </div>
                <ol class="firma2-public-project__years" aria-label="Reported and planned, by year">
                  {r.bars.map((b) => (
                    <li title={b.label}>
                      <span class="firma2-public-project__planned" style={`--h:${b.planned.toFixed(1)}%`}></span>
                      {b.reported !== null && <span class="firma2-public-project__reported" style={`--h:${b.reported.toFixed(1)}%`}></span>}
                      <span class="visually-hidden">{b.label}</span>
                    </li>
                  ))}
                </ol>
                <span class="firma2-public-project__year-span typography-body-sm" aria-hidden="true">
                  <span>{r.bars[0]?.year}</span><span>{r.bars[r.bars.length - 1]?.year}</span>
                </span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <section data-section="funding" data-aliasable-title class="firma2-public-project__band" style={`order:${orderIndex.get('funding')}`} hidden={hiddenAtBuild.has('funding')} aria-labelledby="firma2-pp-funding">
      <div class="firma2-public-project__col stack" data-gap="lg">
        <h2 id="firma2-pp-funding" class="typography-heading-lg">{label('funding')}</h2>
        {shownSources.length > 0 && (
          <ul class="firma2-public-project__treemap" style={`--wide:${FUND_WIDE};--tall:${FUND_TALL}`}>
            {shownSources.map((f, i) => (
              <li style={fundPlace(i)}>
                <div class="firma2-public-project__tile">
                  <span class="firma2-public-project__tile-amount">{currencyFormatter.format(f.amount)}</span>
                  <span class="firma2-public-project__tile-name">{f.name}</span>
                  <span class="firma2-public-project__tile-from">{f.organization} · {Math.round((f.amount / fundingTotal) * 100)}%</span>
                </div>
              </li>
            ))}
          </ul>
        )}
        {withheldSources.map((f) => (
          <p class="typography-body-md" hidden data-publish-key={`funding:${f.name}`} data-reveal>
            {f.name} · {f.organization} · {currencyFormatter.format(f.amount)}
          </p>
        ))}
      </div>
    </section>

    <section data-section="expenditures" data-aliasable-title class="firma2-public-project__band" style={`order:${orderIndex.get('expenditures')}`} hidden={hiddenAtBuild.has('expenditures')} aria-labelledby="firma2-pp-spent">
      <div class="firma2-public-project__col stack" data-gap="lg">
        <h2 id="firma2-pp-spent" class="typography-heading-lg">{label('expenditures')}</h2>
        {spent.length === 0 ? (
          <p class="firma2-public-project__quiet typography-body-md">Nothing spent yet.</p>
        ) : (
          <div class="firma2-public-project__spending">
            <div class="stack" data-gap="2xs" data-count-host>
              <span class="firma2-public-project__figure" data-count>{currencyFormatter.format(spentTotal)}</span>
              <span class="typography-label-md-strong">Spent to date</span>
              <span class="firma2-public-project__quiet typography-body-sm">
                {Math.round((spentTotal / project.estimatedTotalCost) * 100)}% of the {compactUsd.format(project.estimatedTotalCost)} estimated cost
              </span>
            </div>
            <ol class="firma2-public-project__columns">
              {spent.map((e) => (
                <li>
                  <span class="firma2-public-project__column-value typography-label-sm-strong">{compactUsd.format(e.spent)}</span>
                  <span class="firma2-public-project__column" style={`--h:${((e.spent / spentTop) * 100).toFixed(1)}%`}></span>
                  <span class="firma2-public-project__column-year typography-body-sm">{e.year}</span>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>
    </section>

    <section data-section="timeline" data-aliasable-title class="firma2-public-project__band" style={`order:${orderIndex.get('timeline')}`} hidden={hiddenAtBuild.has('timeline')}>
      <div class="firma2-public-project__col">
        <Firma2ProjectTimeline milestones={detail.milestones} readonly />
      </div>
    </section>

    <section data-section="gallery" data-aliasable-title class="firma2-public-project__band" style={`order:${orderIndex.get('gallery')}`} hidden={hiddenAtBuild.has('gallery')}>
      <div class="firma2-public-project__col stack" data-gap="lg">
        <figure class="firma2-public-project__compare stack" data-gap="sm" data-compare data-wide={JSON.stringify(wide)} hidden={!(before && after)}>
          <div class="firma2-public-project__wipe" data-wipe style="--split: 50%">
            <img src={after ? wide[after.id] : ''} alt={after?.alt || after?.caption || ''} width="1600" height="800" loading="lazy" decoding="async" data-compare-after />
            <img class="firma2-public-project__wipe-before" src={before ? wide[before.id] : ''} alt={before?.alt || before?.caption || ''} width="1600" height="800" loading="lazy" decoding="async" data-compare-before />
            <span class="firma2-public-project__wipe-line" aria-hidden="true"><span></span></span>
            <span class="firma2-public-project__when firma2-public-project__when--before typography-label-sm-strong" aria-hidden="true" data-compare-before-date>{before?.date}</span>
            <span class="firma2-public-project__when firma2-public-project__when--after typography-label-sm-strong" aria-hidden="true" data-compare-after-date>{after?.date}</span>
            <input class="firma2-public-project__wipe-range" type="range" min="0" max="100" value="50" aria-label={before && after ? `Compare ${before.date} with ${after.date}` : 'Compare before and after'} data-wipe-range />
          </div>
          <figcaption class="firma2-public-project__quiet typography-body-sm" data-compare-caption>{before && after ? `${before.caption} (${before.date}) · ${after.caption} (${after.date})` : ''}</figcaption>
        </figure>
        <Firma2ProjectGallery photos={detail.photos} readonly slug={slug} />
      </div>
    </section>

    <section data-section="map" data-aliasable-title class="firma2-public-project__band firma2-public-project__band--bleed" style={`order:${orderIndex.get('map')}`} hidden={hiddenAtBuild.has('map')}>
      <Firma2ProjectMap detail={detail} readonly />
    </section>
  </div>
</article>

<style>
  .firma2-public-project [hidden] {
    display: none !important;
  }
  .firma2-public-project {
    --_gutter: var(--firma2-public-gutter, var(--spacing-600));
    --_ease: cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* The page column: the public site's 76rem measure and the frame's gutter. */
  .firma2-public-project__col {
    box-sizing: border-box;
    max-inline-size: 76rem;
    margin-inline: auto;
    padding-inline: var(--_gutter);
  }
  .firma2-public-project h1,
  .firma2-public-project h2,
  .firma2-public-project h3,
  .firma2-public-project p,
  .firma2-public-project dl,
  .firma2-public-project dd,
  .firma2-public-project figure {
    margin: 0;
  }
  .firma2-public-project h1,
  .firma2-public-project h2 {
    text-wrap: balance;
  }
  .firma2-public-project__quiet {
    color: var(--color-content-default-secondary);
  }

  /* ---- The hero: the public home's dark band. Dark in both themes. ---- */
  .firma2-public-project__hero {
    --_ground: var(--color-background-inverse);
    --_ink: var(--color-content-inverse);
