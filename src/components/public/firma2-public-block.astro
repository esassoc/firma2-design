---
// firma2-public-block — the sections an administrator WRITES for the public
// home, as templates: text, an image with text, a button, and a custom page
// shown in place. The one-of-a-kind sections are computed from published
// projects; these are the program's own words between them, and one kind can
// be added more than once (Workspace settings › Public site › Home).
//
// TEMPLATES, NOT SECTIONS. Which blocks exist, and where, is the site's
// settings, read in the browser — so the home carries one template per kind
// (and one per custom page), and src/lib/public-site-apply.ts clones and fills
// them. Text goes in as text: nothing an administrator types is read as markup.
// A custom page's body is the page's own stored rich text.
//
// PLAIN ON PURPOSE. A block is the program talking, so it is set as the page's
// own prose — a heading, paragraphs, at most one picture or one button — with
// no card and no band of its own.
//
// bcn-lego-checked: esa-button is the button; firma2-public-section is the
// column each block sits in. esa-card has no media slot and would box the
// program's prose; esa-empty-state is a placeholder, not content. The classes
// set the prose measure and the picture's column. Beacon is not cloned on this
// machine.
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2PublicSection from './firma2-public-section.astro';
import { PUBLIC_PAGES } from '../../data/firma2-public-site';
import { seedEntries } from '../../data/firma2-pages';
import { withBase } from '../../lib/base';

const pages = PUBLIC_PAGES.map((page) => ({
  ...page,
  body: (seedEntries.find((entry) => entry.id === page.id) as { body?: string } | undefined)?.body ?? '',
}));
---
<template data-block-template="text">
  <Firma2PublicSection contained>
    <section class="firma2-public-block stack" data-gap="md">
      <h2 class="typography-heading-lg" data-block-heading></h2>
      <div class="firma2-public-block__prose typography-body-lg stack" data-gap="sm" data-block-body></div>
    </section>
  </Firma2PublicSection>
</template>

<template data-block-template="image-text">
  <Firma2PublicSection contained>
    <section class="firma2-public-block firma2-public-block--media">
      <img class="firma2-public-block__image" alt="" loading="lazy" decoding="async" data-block-image />
      <div class="stack" data-gap="md">
        <h2 class="typography-heading-lg" data-block-heading></h2>
        <div class="firma2-public-block__prose typography-body-lg stack" data-gap="sm" data-block-body></div>
      </div>
    </section>
  </Firma2PublicSection>
</template>

<template data-block-template="button">
  <Firma2PublicSection contained>
    <section class="firma2-public-block firma2-public-block--action stack" data-gap="md">
      <h2 class="typography-heading-lg" data-block-heading></h2>
      <div class="firma2-public-block__prose typography-body-lg stack" data-gap="sm" data-block-body></div>
      <div data-block-button><EsaButton variant="primary" size="lg" href="#" iconRight="arrow-right">Button</EsaButton></div>
    </section>
  </Firma2PublicSection>
</template>

{pages.map((page) => (
  <template data-block-template={`page:${page.id}`}>
    <Firma2PublicSection contained>
      <section class="firma2-public-block stack" data-gap="md">
        <div class="repel" data-align="center">
          <h2 class="typography-heading-lg">{page.label}</h2>
          <EsaButton variant="ghost" href={withBase(page.href)} iconRight="arrow-right">Open page</EsaButton>
        </div>
        <div class="firma2-public-block__prose typography-body-lg stack" data-gap="sm" set:html={page.body} />
      </section>
    </Firma2PublicSection>
  </template>
))}

<style>
  .firma2-public-block :global([hidden]) {
    display: none;
  }
  .firma2-public-block :global(h2),
  .firma2-public-block__prose :global(:is(p, h2, h3, ol, ul)) {
    margin: 0;
  }
  .firma2-public-block :global(h2) {
    text-wrap: balance;
  }
  .firma2-public-block__prose {
    max-inline-size: 68ch;
    text-wrap: pretty;
  }
  .firma2-public-block--media {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--spacing-700);
    align-items: center;
  }
  /* The picture's side is the block's own setting; the document order (picture,
     then words) does not change, so a reader of the markup meets them the same way. */
  .firma2-public-block--media[data-side='end'] .firma2-public-block__image {
    order: 1;
  }
  .firma2-public-block__image {
    display: block;
    inline-size: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: var(--color-background-elevation-sunken);
  }
  .firma2-public-block--action {
    align-items: center;
    text-align: center;
  }
  @media (max-width: 45rem) {
    .firma2-public-block--media {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--spacing-500);
    }
    .firma2-public-block--media[data-side='end'] .firma2-public-block__image {
      order: 0;
    }
  }
</style>
