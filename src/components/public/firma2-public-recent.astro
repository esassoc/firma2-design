---
// firma2-public-recent — the three projects whose public pages changed most
// recently, each under its Featured photo, with the date it changed.
//
// WHAT IT IS FOR: proof the program is alive, and a way in for a returning
// visitor. It was a five-row list of links (2026-11-20, user: "interesting,
// but useful?") — a list is a change log, which the public site deliberately
// does not have (inventory §C). Three photographs with dates say "this is
// current" at a glance and are still doors. Featured projects are left out;
// the hero shows them.
//
// THE PHOTO IS A BEFORE-AND-AFTER (2026-11-20, user: one hover idea repeated
// on every section "looks stale" — each section now moves in its own way,
// from its own content). Under a fine pointer, moving across a card's photo
// WIPES between the record's oldest photo and its Featured one; the split
// follows the pointer exactly and each side wears its date. Restoration is a
// before-and-after story, and the record already holds both pictures. A
// project with one photo just pushes in. Touch and reduced motion see the
// Featured photo, still.
//
// "Updated", not "published": publishing is the workspace's word for its own
// review step; what the reader sees is that the page changed.
//
// bcn-lego-checked: esa-card has no media slot, so a photo can only sit inside
// its padding; this card is the picture with its lines under it. The door to
// the finder is an EsaButton. Beacon is not cloned on this machine.
import EsaButton from '@esa/ecology/esa-button.astro';
import type { PublicFeatured } from '../../data/firma2-public-site';
import { PUBLIC_NAV } from '../../data/firma2-public-site';
import { labelOfIso } from '../../data/firma2-publish-history';
import { projectSlug } from '../../data/firma2-projects';
import { withBase } from '../../lib/base';
import { photoSrc } from '../../lib/project-photos';

interface Props {
  /** The pool the settings choose from, newest first. */
  projects: PublicFeatured[];
  /** How many show, and which are left out because the introduction features them, until the settings say otherwise. */
  count?: number;
  featured?: string[];
}

const { projects, count = projects.length, featured = [] } = Astro.props;
const eligible = projects.filter((p) => !featured.includes(projectSlug(p.project))).slice(0, count);
const projectsHref = PUBLIC_NAV.find((item) => item.key === 'projects')!.href;
---
{projects.length > 0 && (
  <section class="firma2-public-recent stack" data-gap="lg" aria-labelledby="firma2-public-recent-title" data-recent hidden={eligible.length === 0}>
    <div class="repel" data-align="center">
      <h2 id="firma2-public-recent-title" class="typography-heading-lg">Recently updated</h2>
      <EsaButton variant="ghost" href={withBase(projectsHref)} iconRight="arrow-right">All projects</EsaButton>
    </div>
    <ul class="firma2-public-recent__list grid" data-gap="lg">
      {projects.map((p) => (
        <li class="firma2-public-recent__card stack" data-gap="sm" data-slug={projectSlug(p.project)} hidden={!eligible.includes(p)}>
          <span class="firma2-public-recent__frame" data-wipe={p.before ? '' : undefined}><img src={photoSrc(p.photo, 800, 533, 65)} alt={p.photo.caption} width="800" height="533" loading="lazy" decoding="async" />{p.before && (
            <>
              <img class="firma2-public-recent__before" src={photoSrc(p.before, 800, 533, 65)} alt={p.before.caption} width="800" height="533" loading="lazy" decoding="async" />
              <span class="firma2-public-recent__split" aria-hidden="true"></span>
              <span class="firma2-public-recent__when firma2-public-recent__when--before typography-label-sm-strong" aria-hidden="true">{p.before.date}</span>
              <span class="firma2-public-recent__when firma2-public-recent__when--after typography-label-sm-strong" aria-hidden="true">{p.photo.date}</span>
            </>
          )}</span>
          <div class="stack" data-gap="2xs">
            <h3 class="typography-title-sm-strong"><a href={withBase(p.href)}>{p.project.projectName}<span class="firma2-public-recent__arrow" aria-hidden="true"> →</span></a></h3>
            <span class="typography-body-sm">{p.stage} · {p.project.leadOrganization}</span>
            <span class="firma2-public-recent__date typography-body-sm">Updated <time datetime={p.publishedIso}>{labelOfIso(p.publishedIso)}</time></span>
          </div>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .firma2-public-recent h2,
  .firma2-public-recent h3 {
    margin: 0;
    text-wrap: balance;
  }
  .firma2-public-recent__list {
    --grid-min: 16rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .firma2-public-recent__card {
    position: relative;
  }
  /* The frame holds still and clips; the picture inside it moves. */
  .firma2-public-recent__frame {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-background-elevation-sunken);
    outline: 1px solid var(--color-border-subtle);
    outline-offset: -1px;
  }
  .firma2-public-recent__card img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: scale 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* The wipe: the older photo lies over the Featured one, clipped at --split
     (set from the pointer's x, so it tracks 1:1; it eases only on the way in
     and out). */
  .firma2-public-recent__frame {
    position: relative;
    --split: 0%;
  }
  .firma2-public-recent__card img.firma2-public-recent__before {
    position: absolute;
    inset: 0;
    block-size: 100%;
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
    transition: clip-path 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .firma2-public-recent__split {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--split);
    inline-size: 2px;
    margin-inline-start: -1px;
    background: var(--color-content-inverse);
    opacity: 0;
    transition: inset-inline-start 360ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease;
  }
  .firma2-public-recent__when {
    position: absolute;
    inset-block-end: var(--spacing-200);
    padding: var(--spacing-050) var(--spacing-200);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-background-inverse) 80%, transparent);
    color: var(--color-content-inverse);
    opacity: 0;
    transition: opacity 200ms ease;
    pointer-events: none;
  }
  .firma2-public-recent__when--before {
    inset-inline-start: var(--spacing-200);
  }
  .firma2-public-recent__when--after {
    inset-inline-end: var(--spacing-200);
  }
  /* While the pointer is tracking, the split follows it without easing. */
  .firma2-public-recent__frame[data-tracking] .firma2-public-recent__before {
    transition: none;
  }
  .firma2-public-recent__frame[data-tracking] .firma2-public-recent__split {
    transition: opacity 200ms ease;
    opacity: 1;
  }
  .firma2-public-recent__frame[data-tracking] .firma2-public-recent__when {
    opacity: 1;
  }
  .firma2-public-recent__arrow {
    display: inline-block;
    opacity: 0;
    translate: -6px 0;
    transition: opacity 200ms ease, translate 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .firma2-public-recent__card a:focus-visible .firma2-public-recent__arrow {
    opacity: 1;
    translate: 0 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .firma2-public-recent__card:hover .firma2-public-recent__frame:not([data-wipe]) img {
      scale: 1.06;
    }
    .firma2-public-recent__card:hover h3 a {
      color: var(--color-content-brand);
    }
    .firma2-public-recent__card:hover .firma2-public-recent__arrow {
      opacity: 1;
      translate: 0 0;
    }
  }
  .firma2-public-recent__card:active img {
    scale: 1.02;
  }
  @media (prefers-reduced-motion: reduce) {
    .firma2-public-recent__card img {
      transition: none;
      scale: 1 !important;
    }
    .firma2-public-recent__arrow {
      transition: opacity 200ms ease;
      translate: 0 0;
    }
  }
  .firma2-public-recent__card a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }
  /* The name's hit area is the card. */
  .firma2-public-recent__card a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .firma2-public-recent__date {
    color: var(--color-content-default-secondary);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  // The before/after split follows the pointer across the photo. Fine pointers
  // only, and not under reduced motion.
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('.firma2-public-recent__card').forEach((card) => {
    const frame = card.querySelector<HTMLElement>('[data-wipe]');
    if (!frame) return;
    const follow = (e: PointerEvent) => {
      if (!fine.matches || still.matches) return;
      const box = frame.getBoundingClientRect();
      const x = Math.min(1, Math.max(0, (e.clientX - box.left) / box.width));
      frame.style.setProperty('--split', `${(x * 100).toFixed(2)}%`);
    };
    // The whole card is the door, so the card is what the pointer is over.
    card.addEventListener('pointerenter', (e) => {
      follow(e);
      // Ease to the pointer first, then track it exactly.
      setTimeout(() => card.matches(':hover') && fine.matches && !still.matches && frame.setAttribute('data-tracking', ''), 200);
    });
    card.addEventListener('pointermove', follow);
    card.addEventListener('pointerleave', () => {
      frame.removeAttribute('data-tracking');
      frame.style.setProperty('--split', '0%');
    });
  });
</script>
