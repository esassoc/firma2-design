---
// firma2-public-unpublished — the public address of a project that has never
// been published: a plain statement that it is not public yet, in the
// tenant's frame.
//
// A REAL TENANT WOULD SERVE NOTHING. The record of an unpublished project is
// not sent to a signed-out reader at all; the prototype holds the page in a
// hidden slot only so a Publish made in this browser (src/lib/publish-store.ts)
// can show it — the same honest-mechanism note firma2-public-project makes
// about withheld sections.
//
// bcn-lego-checked: the statement is esa-empty-state inside esa-container —
// legos, composed unchanged. The <style> only restates [hidden] and gives the
// statement the page's breathing room.
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import { TENANT_NAME } from '../../data/firma2-project-types';

interface Props {
  slug: string;
  keys: string[];
}

const { slug, keys } = Astro.props;
---
<div class="firma2-public-unpublished" data-slug={slug} data-keys={JSON.stringify(keys)}>
  <div class="firma2-public-unpublished__note" data-note>
    <EsaContainer>
      <EsaEmptyState title="This project isn't public yet" description={`${TENANT_NAME} hasn't published it.`} />
    </EsaContainer>
  </div>
  <div data-page hidden>
    <slot />
  </div>
</div>

<style>
  .firma2-public-unpublished [hidden] {
    display: none !important;
  }
  .firma2-public-unpublished__note {
    padding-block: var(--spacing-900);
  }
</style>

<script>
  import { readPublishing } from '../../lib/publish-store';

  document.querySelectorAll<HTMLElement>('.firma2-public-unpublished').forEach((root) => {
    const published = readPublishing().published[root.dataset.slug!];
    if (!published) return;
    root.querySelector<HTMLElement>('[data-note]')!.hidden = true;
    root.querySelector<HTMLElement>('[data-page]')!.hidden = false;
    // The map measured a hidden box at load; a resize makes it measure again.
    window.dispatchEvent(new Event('resize'));
  });
</script>
