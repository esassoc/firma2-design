---
// firma2-public-announcement — the one current notice a program wants every
// visitor to see: a deadline, a meeting, a new report. A full-width strip
// under the navigation bar, one sentence and one door.
//
// AUTHORED, AND OFF BY DEFAULT (PUBLIC_HOME.announcement is null for a new
// workspace): the strip renders nothing without one, so a program with no
// news shows no empty banner.
//
// bcn-lego-checked: esa-alert-box is a boxed, icon-led alert for a condition
// the user must act on inside a page; this is a site notice spanning the
// frame, with the frame's gutter. Its door is a plain link in a sentence.
// Beacon is not cloned on this machine.
//
// A SECOND SENTENCE CAN WEAR THE STRIP: pass `notice` and it carries that
// instead of the program's announcement — firma2-public-review-notice does,
// for the signed-in reader's "unpublished changes". The sentence sits in its
// own span so a script can restate it.
import { PUBLIC_HOME } from '../../data/firma2-public-site';
import { withBase } from '../../lib/base';

interface Props {
  /** The sentence and its door. Defaults to the program's announcement. */
  notice?: { text: string; linkLabel: string; href: string } | null;
  /** The strip's accessible name. */
  label?: string;
  /**
   * Keep the strip in the document, hidden, when there is no notice: the home's
   * own announcement, which the site's settings can put up later
   * (src/lib/public-site-apply.ts).
   */
  site?: boolean;
}

const { notice = PUBLIC_HOME.announcement, label = 'Announcement', site = false } = Astro.props;
---
{(notice || site) && (
  <aside class="firma2-public-announcement typography-body-md" aria-label={label} hidden={!notice} data-site-announcement={site ? '' : undefined}>
    <p>
      <span data-notice-text>{notice?.text}</span>{' '}<a href={notice ? withBase(notice.href) : '#'}>{notice?.linkLabel}</a>
    </p>
  </aside>
)}

<style>
  .firma2-public-announcement {
    padding: var(--spacing-300) var(--firma2-public-gutter, var(--spacing-600));
    background: var(--color-background-elevation-sunken);
    border-block-end: 1px solid var(--color-border-subtle);
    text-align: center;
  }
  .firma2-public-announcement p {
    margin: 0;
    text-wrap: balance;
  }
  .firma2-public-announcement a {
    color: var(--color-content-link);
    font-weight: var(--typography-font-weight-medium);
  }
</style>
