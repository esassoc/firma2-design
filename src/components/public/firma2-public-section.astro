---
// firma2-public-section — one section of the public home, as something the
// site's settings can move, remove and add (Workspace settings › Public site ›
// Home; src/lib/public-site-apply.ts reorders these by `id`).
//
// TWO WIDTHS. A band (the introduction, the map) runs the width of the window
// and brings its own spacing. A `contained` section sits in the page's reading
// column — the 76rem measure and the frame's gutter — with a step of space
// above and below, so any order of sections keeps one rhythm.
//
// A section whose content rendered nothing (no goals yet, no partners yet)
// takes no space.
//
// bcn-lego-checked: esa-container is a fixed 2rem gutter; the public frame's
// gutter narrows on a phone (--firma2-public-gutter, PublicLayout), as
// firma2-public-column found. This is that column, one section at a time.
// Beacon is not cloned on this machine.
interface Props {
  /** The section's id in the site's settings: a built-in section's name, or a block's key. */
  id?: string;
  contained?: boolean;
}

const { id, contained = false } = Astro.props;
---
<div class:list={['firma2-public-section', contained && 'firma2-public-section--contained']} data-home-section={id}>
  <slot />
</div>

<style>
  .firma2-public-section:not(:has(> :not([hidden]))) {
    display: none;
  }
  .firma2-public-section--contained {
    box-sizing: border-box;
    inline-size: 100%;
    max-inline-size: 76rem;
    margin-inline: auto;
    padding-inline: var(--firma2-public-gutter, var(--spacing-600));
    padding-block: var(--spacing-700);
  }
  .firma2-public-section--contained:last-child {
    padding-block-end: var(--spacing-900);
  }
</style>
