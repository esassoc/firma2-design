---
// firma2-public-footer — the foot of every public page: who to ask, and what
// the site runs on.
//
// TWO FACTS, NO SITEMAP. The header's five links are one scroll away and a
// second copy of them here would be decoration. What the page above cannot
// say is who to contact about it — the workspace's own contact address
// (Workspace settings › Workspace), never a person's: the public site's
// "Contact details" switch governs people, and requesters never see managers.
//
// WHAT A WORKSPACE CAN ADD (Public site settings › Footer): its own links,
// its social accounts, and a line naming its funders. All three are empty
// until an administrator fills them, and an empty one draws nothing. The
// contact line can be turned off; the name and the credit cannot.
//
// bcn-lego-checked: esa-app-bar is the footer shell (as="footer"); the classes
// below wrap its row on a phone, lay out the added lines and quiet the credit.
// esa-link-column was considered and cut with the sitemap: these are two short
// rows of links, not titled columns. Beacon is not cloned on this machine.
import EsaAppBar from '@esa/ecology/esa-app-bar.astro';
import { PUBLIC_SITE_OWNER, publicPartners } from '../../data/firma2-public-site';

const funders = publicPartners().funding.map((o) => o.name);
---
<EsaAppBar as="footer" tone="surface" class="firma2-public-footer">
  <div slot="start" class="firma2-public-footer__start">
    <p class="firma2-public-footer__owner typography-body-sm">
      <span data-site-name>{PUBLIC_SITE_OWNER.name}</span><span data-footer-contact> · <a href={`mailto:${PUBLIC_SITE_OWNER.contact}`}>{PUBLIC_SITE_OWNER.contact}</a></span>
    </p>
    {funders.length > 0 && <p class="firma2-public-footer__quiet typography-body-sm" hidden data-footer-funders>Funded by {funders.join(', ')}</p>}
    <nav class="firma2-public-footer__links typography-body-sm" aria-label="More links" hidden data-footer-links></nav>
    <nav class="firma2-public-footer__links typography-body-sm" aria-label="Social accounts" hidden data-footer-social></nav>
  </div>
  <p slot="end" class="firma2-public-footer__credit typography-body-sm">ProjectFirma by ESA</p>
</EsaAppBar>

<style>
  :global(.firma2-public-footer) {
    border-block-start: 1px solid var(--color-border-subtle);
  }

  :global(.firma2-public-footer > .esa-app-bar__row) {
    padding-inline: var(--firma2-public-gutter, var(--spacing-600));
  }

  .firma2-public-footer__start {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100);
  }
  .firma2-public-footer__start [hidden] {
    display: none;
  }
  .firma2-public-footer__start p,
  .firma2-public-footer__credit {
    margin: 0;
  }
  .firma2-public-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-100) var(--spacing-400);
  }
  .firma2-public-footer__quiet,
  .firma2-public-footer__credit {
    color: var(--color-content-default-secondary);
  }
  :global(.firma2-public-footer > .esa-app-bar__row) {
    align-items: flex-end;
  }
  /* The lego's start region never shrinks; a line naming a dozen funders has
     to wrap inside the bar instead of pushing the page wide. */
  :global(.firma2-public-footer .esa-app-bar__start) {
    flex: 1 1 0;
    min-width: 0;
  }
  .firma2-public-footer__start {
    min-inline-size: 0;
    max-inline-size: 72ch;
  }
  .firma2-public-footer__credit {
    white-space: nowrap;
  }

  @media (max-width: 45rem) {
    :global(.firma2-public-footer > .esa-app-bar__row) {
      flex-wrap: wrap;
      gap: var(--spacing-200);
    }
    :global(.firma2-public-footer .esa-app-bar__end) {
      margin-left: 0;
    }
  }
</style>
