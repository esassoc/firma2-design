---
// firma2-public-hero — the opening of the public home: what the program is,
// what it has done, and three of its projects to walk into.
//
// THE HERO IS MADE OF THE PROGRAM'S OWN MATERIAL (2026-11-20, user: "it needs
// to be attention grabbing"). No stock banner and no decoration — two earlier
// tries, a tinted band and a generated contour plate, were "plain" and "really
// bad". What is loud here is what is true:
//
//   - THE RESULTS, AT POSTER SIZE. The totals the public projects have
//     reported are the biggest type on the site, in the brand's colour. Each
//     is a door to its measure. COMPUTED (publicMeasureTotals) — nobody types
//     these.
//   - THE FEATURED PROJECTS, AS THE PICTURE. The projects the program picked
//     (PUBLIC_HOME.featured) stand as three tall photographs running to the
//     window's edge, each a door to its project. AUTHORED — the program's
//     choice of what to lead with.
//
// MOTION ANSWERS THE POINTER, AND ONLY THE POINTER (2026-11-20, user: hover
// effects "flashier" on this page). Under a fine pointer: the photograph
// pointed at widens and its picture pushes in while its neighbours dim, and an
// arrow slides in beside its name; a result's figure lifts, counts up from zero, and a
// rule draws under its label. Keyboard focus widens a photograph too. Nothing moves on
// scroll or by itself; reduced motion keeps the colour changes and drops the
// movement; touch gets none of it.
//
// DARK ON PURPOSE, IN BOTH THEMES: so the figures and the photographs carry
// all the colour. In the light theme that is the inverse surface; in the dark
// theme "inverse" is LIGHT, so the band takes the page's deepest surface
// instead (--_ground / --_ink below). Captions over photographs are always
// light-on-scrim.
//
// The text's left edge is the page column's (76rem, the frame's gutter); the
// photographs bleed right. Below 64rem they stack under the text as bands.
//
// bcn-lego-checked: esa-stat is a fixed display-sm figure with its label
// beneath and no door; these are linked, poster-size figures. esa-card has no
// media slot. The classes lay out the band; no control is styled here. Beacon
// is not cloned on this machine.
import type { PublicFeatured, PublicMeasureTotal } from '../../data/firma2-public-site';
import { PUBLIC_HOME, PUBLIC_NAV, PUBLIC_SITE_OWNER } from '../../data/firma2-public-site';
import { withBase } from '../../lib/base';
import { photoSrc } from '../../lib/project-photos';

interface Props {
  totals: PublicMeasureTotal[];
  featured: PublicFeatured[];
}

const { totals, featured } = Astro.props;
const measuresHref = PUBLIC_NAV.find((item) => item.key === 'performance-measures')!.href;
const figure = (t: PublicMeasureTotal) =>
  t.reported.toLocaleString('en-US', { maximumFractionDigits: t.reported >= 100 ? 0 : t.measure.decimalPlaces });
---
<header class="firma2-public-hero">
  <div class="firma2-public-hero__text stack" data-gap="xl">
    <div class="stack" data-gap="md">
      <h1 class="typography-display">{PUBLIC_SITE_OWNER.name}</h1>
      {PUBLIC_HOME.description && <p class="firma2-public-hero__description typography-body-lg">{PUBLIC_HOME.description}</p>}
    </div>
    {totals.length > 0 && (
      <ul class="firma2-public-hero__results" aria-label="Results to date">
        {totals.map((t) => (
          <li>
            <a href={withBase(measuresHref)} data-count-host>
              <span class="firma2-public-hero__figure" data-count>{figure(t)}</span>
              <span class="firma2-public-hero__measure typography-label-lg">{t.measure.name}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
  {featured.length > 0 && (
    <ul class="firma2-public-hero__projects" aria-label="Featured projects">
      {featured.map((p, i) => (
        <li>
          <a href={withBase(p.href)}>
            <img
              src={photoSrc(p.photo, 720, 1080, 65)}
              alt={p.photo.caption}
              width="720"
              height="1080"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              decoding="async"
            />
            <span class="firma2-public-hero__caption stack" data-gap="2xs">
              <span class="firma2-public-hero__name typography-label-lg-strong">{p.project.projectName}<span class="firma2-public-hero__arrow" aria-hidden="true"> →</span></span>
              <span class="typography-body-sm">{p.stage} · {p.project.leadOrganization}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
</header>

<style>
  .firma2-public-hero {
    /* The brand's solid step reads as a bright ink on the inverse ground. */
    --_accent: var(--color-background-brand);
    --_gutter: var(--firma2-public-gutter, var(--spacing-600));
    --_ground: var(--color-background-inverse);
    --_ink: var(--color-content-inverse);
    display: grid;
    grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
    min-block-size: min(46rem, calc(100dvh - 7rem));
    background: var(--_ground);
    color: var(--_ink);
  }
  :global(html[data-scheme='dark']) .firma2-public-hero {
    --_ground: var(--color-background-elevation-sunken);
    --_ink: var(--color-content-default);
  }
  .firma2-public-hero__text {
    box-sizing: border-box;
    align-content: center;
    justify-content: center;
    /* The page column's left edge, whatever the window's width. */
    padding-block: var(--spacing-900);
    padding-inline: max(var(--_gutter), calc((100vw - 76rem) / 2 + var(--_gutter))) var(--spacing-800);
  }
  .firma2-public-hero h1,
  .firma2-public-hero__description {
    margin: 0;
  }
  .firma2-public-hero h1 {
    text-wrap: balance;
  }
  .firma2-public-hero__description {
    max-inline-size: 52ch;
    text-wrap: pretty;
  }

  .firma2-public-hero__results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-600) var(--spacing-700);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .firma2-public-hero__results a {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100);
    color: inherit;
    text-decoration: none;
  }
  .firma2-public-hero__figure {
    font-family: var(--typography-font-family-display);
    font-weight: var(--typography-font-weight-bold);
    font-size: clamp(3.25rem, 6.2vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--_accent);
  }
  .firma2-public-hero__measure {
    max-inline-size: 22ch;
    text-wrap: balance;
  }
  .firma2-public-hero__figure {
    transition: translate 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* A rule that draws under the label, from its leading edge. */
  .firma2-public-hero__measure {
    position: relative;
    inline-size: fit-content;
    padding-block-end: var(--spacing-100);
  }
  .firma2-public-hero__measure::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    block-size: 2px;
    background: var(--_accent);
    scale: 0 1;
    transform-origin: left;
    transition: scale 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .firma2-public-hero__results a:focus-visible .firma2-public-hero__measure::after {
    scale: 1 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .firma2-public-hero__results a:hover .firma2-public-hero__figure {
      translate: 0 -4px;
    }
    .firma2-public-hero__results a:hover .firma2-public-hero__measure::after {
      scale: 1 1;
    }
  }

  .firma2-public-hero__projects {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: 2px;
  }
  .firma2-public-hero__projects li {
    flex: 1 1 0;
    min-inline-size: 0;
    transition: flex-grow 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .firma2-public-hero__projects img {
    transition: scale 600ms cubic-bezier(0.22, 1, 0.36, 1), opacity 250ms ease;
  }
  .firma2-public-hero__arrow {
    display: inline-block;
    opacity: 0;
    translate: -6px 0;
    transition: opacity 200ms ease, translate 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .firma2-public-hero__projects a {
    position: relative;
    display: block;
    block-size: 100%;
    color: var(--_ink);
    text-decoration: none;
    overflow: hidden;
  }
  .firma2-public-hero__projects img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    background: var(--_ground);
  }
  .firma2-public-hero__caption {
    position: absolute;
    inset: auto 0 0;
    padding: var(--spacing-900) var(--spacing-400) var(--spacing-500);
    /* A scrim so the name reads over any photograph. */
    background: linear-gradient(to top, rgb(0 0 0 / 0.78), rgb(0 0 0 / 0.45) 55%, transparent);
    text-wrap: balance;
  }
  .firma2-public-hero__projects li:focus-within {
    flex-grow: 1.7;
  }
  .firma2-public-hero__projects a:focus-visible .firma2-public-hero__arrow {
    opacity: 1;
    translate: 0 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .firma2-public-hero__projects li:hover {
      flex-grow: 1.7;
    }
    .firma2-public-hero__projects li:hover img {
      scale: 1.06;
    }
    /* The photographs not pointed at step back. */
    .firma2-public-hero__projects:hover li:not(:hover) img {
      opacity: 0.55;
    }
    .firma2-public-hero__projects li:hover .firma2-public-hero__arrow {
      opacity: 1;
      translate: 0 0;
    }
  }
  .firma2-public-hero__projects a:active img {
    scale: 1.02;
  }
  @media (prefers-reduced-motion: reduce) {
    .firma2-public-hero__projects li,
    .firma2-public-hero__figure,
    .firma2-public-hero__measure::after {
      transition: none;
    }
    .firma2-public-hero__projects img {
      transition: opacity 200ms ease;
      scale: 1 !important;
    }
    .firma2-public-hero__arrow {
      transition: opacity 200ms ease;
      translate: 0 0;
    }
    .firma2-public-hero__figure {
      translate: 0 0 !important;
    }
  }

  /* Tablet and down: the photographs become three bands under the text. */
  @media (max-width: 64rem) {
    .firma2-public-hero {
      grid-template-columns: minmax(0, 1fr);
      min-block-size: 0;
    }
    .firma2-public-hero__text {
      padding-block: var(--spacing-800);
      padding-inline: var(--_gutter);
    }
    .firma2-public-hero__projects {
      block-size: 22rem;
    }
  }
  @media (max-width: 45rem) {
    .firma2-public-hero__projects {
      flex-direction: column;
      block-size: auto;
    }
    .firma2-public-hero__projects li {
      flex: none;
      block-size: 11rem;
    }
    .firma2-public-hero__caption {
      padding-block-start: var(--spacing-700);
    }
  }
</style>

<script>
  import { countUpOnHover } from '../../lib/count-up';
  countUpOnHover();
</script>
