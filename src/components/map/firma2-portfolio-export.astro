---
// firma2-portfolio-export — the portfolio leaves as a file a GIS opens. A
// PAGE action beside the title, not a control among the filters, because it
// acts on what the page shows. Its label counts what it will export, because
// the export follows the legend filter and a reader who narrowed the map
// needs to know whether they are about to get those shapes or all of them.
//
// Five formats, team 2's list: GeoJSON (QGIS, ArcGIS Pro, anything), a
// zipped shapefile, a zipped file geodatabase, KML (Google Earth) and CSV
// with coordinates (a spreadsheet). The menu dispatches; the map component
// owns the data and builds the file.
//
// bcn-lego-checked: esa-dropdown-menu + esa-button, nothing bespoke.
import EsaButton from '@esa/ecology/esa-button.astro';
---
<esa-dropdown-menu class="firma2-portfolio-export" position="below-end">
  <EsaButton variant="primary" size="md" iconRight="chevron-down"><span data-export-label>Export</span></EsaButton>
</esa-dropdown-menu>

<script>
  import '@esa/ecology/esa-dropdown-menu';

  type Menu = HTMLElement & { items?: unknown };

  document.querySelectorAll<Menu>('.firma2-portfolio-export').forEach((menu) => {
    customElements.whenDefined('esa-dropdown-menu').then(() => {
      menu.items = [
        { label: 'GeoJSON — for QGIS or ArcGIS Pro', action: 'geojson' },
        { label: 'Shapefile (.zip)', action: 'shapefile' },
        { label: 'File geodatabase (.zip)', action: 'gdb' },
        { label: 'KML — for Google Earth', action: 'kml' },
        { label: 'CSV with coordinates', action: 'csv' },
      ];
    });
    menu.addEventListener('menu-action', (event) => {
      document.dispatchEvent(new CustomEvent('firma2:portfolio-export', { detail: (event as CustomEvent<string>).detail }));
    });
  });
</script>
