---
// firma2-measure-about — the measure's identity, as a CARD in the setup
// column: kind (a fact), classifications, and the two authored paragraphs
// (definition, reporter guidance), all edit-in-place. It replaces
// firma2-measure-facts, which held the same rows in a "Key facts" rail copied
// from the project page.
//
// WHY THE RAIL DIED. The project rail works because a project's facts arrive
// mostly filled and get touched once — an index card beside the numbers. A new
// measure is the opposite: everything is empty and ALL of it is the task, so
// the rail split the seven required settings across two columns and made the
// admin's path a Z (header → main column → rail → header). Walked step by
// step, the setup flow was its own indictment (2026-08-20). Consistency with
// the sibling page now means shared IDIOMS — the click-to-edit rows, the card
// chrome, the title choreography — not a shared floor plan.
//
// POSITION: directly under the claim, before the structure cards — the
// authoring order. An admin cannot decide what is counted before deciding
// what the measure means, and the definition is the prose of which the claim
// is the grammar. Reporter guidance lives here too, beside the definition:
// they are the record's two authored paragraphs (one read by reviewers, one
// by reporters). It briefly sat inside the entry card as "the form's
// preamble" — an argument that only held while that card was a mockup of the
// reporter's form; with the mockup gone (the card states the definition
// directly), the preamble position was the metaphor's last tenant.
//
// KIND IS A FACT, NOT A FIELD — a plain dt/dd with no affordance, the absence
// of an editor beside editable siblings saying "set at creation" in zero
// words. The kinds are explained where they are CHOSEN (the create dialog).
//
// EVERY LABEL IS A LOAD-BEARING STRING. outstandingFields() reports gaps by
// these exact words — "Definition", "Classifications" — and the readiness line
// counts them; the placeholders repeat the same nouns.
//
// CLASSIFICATIONS IS THE PROJECTS' OWN VOCABULARY, re-exported by the data
// module — a measure and a project must offer the same list or a roll-up
// across the two splits a bucket in half. Same component, same chips, same
// hover cards (counting measures here, projects there), same door to the
// index.
//
// WIRING. Rows announce commits as `firma2:field-save` (bubbling) and accept
// controller restores as `firma2:field-set` — firma2-editable-field's own
// contract. src/lib/measure-editor.ts reads each row's truth off data-raw.
import EsaCard from '@esa/ecology/esa-card.astro';
import '../shared/firma2-card-section.css';
import Firma2EditableField from '../shared/firma2-editable-field.astro';
import Firma2ProseField from '../shared/firma2-prose-field.astro';
import {
  CLASSIFICATIONS,
  measures,
  measureKind,
} from '../../data/firma2-performance-measures';
import type { PerformanceMeasureDefinition } from '../../data/firma2-performance-measures';
import { withBase } from '../../lib/base';

interface Props {
  /** The measure being configured. Every field on it may be empty or unset. */
  measure: PerformanceMeasureDefinition;
}

const { measure } = Astro.props;

const kind = measureKind(measure.kind);

// Hover-card context for EVERY classification in the vocabulary, not just this
// measure's — a member added in the editor needs its card the moment it lands.
// The count is the measure-side twin of the project row's card: "how many
// measures report toward this goal" is the roll-up question the shared
// vocabulary exists to answer.
const classificationCards = Object.fromEntries(
  CLASSIFICATIONS.map((goal) => [
    goal,
    {
      kind: 'Portfolio goal',
      title: goal,
      lines: [
        `${measures.filter((m) => m.classifications.includes(goal)).length} of ${measures.length} measures report toward this goal`,
      ],
    },
  ]),
);

// Sorted at render for the same reason the component re-sorts on commit: one
// canonical order (the vocabulary's own) however the set was assembled.
const picked = (CLASSIFICATIONS as readonly string[]).filter((c) =>
  measure.classifications.includes(c as (typeof measure.classifications)[number]),
);
---
<EsaCard title="About this measure">
  <!-- TWO CELLS ON THE CARD'S OWN GRID — the same fill-the-card arithmetic the
       form card uses for its rows: the scannable facts (kind, classifications)
       and the definition prose sit side by side where the width allows and
       stack where it does not. -->
  <div class="firma2-measure-about grid" data-gap="lg">
    <dl class="firma2-measure-about__facts stack" data-gap="md">
      <!-- THE KIND — stated, not offered. "{name} measure" rather than the
           bare vocabulary word: read cold, "Output" alone is a value with no
           subject; the noun costs one word. -->
      <div class="stack" data-gap="2xs">
        <dt class="firma2-measure-about__label typography-label-sm">Kind</dt>
        <dd class="firma2-measure-about__value typography-body-md">{kind.name} measure</dd>
      </div>

      <!-- THE ONE ROW THAT EDITS A SET — the project page's classifications
           row, on this record. Chips are doors (hover for the goal's context,
           click to see its measures); the line's empty space opens the
           multi-select combobox, constrained to the shared vocabulary. -->
      <Firma2EditableField
        field="classifications"
        label="Classifications"
        value={picked.join(', ')}
        values={picked}
        control="multi-select"
        format="list"
        options={[...CLASSIFICATIONS]}
        memberHref={withBase('/prototypes/performance-measures')}
        memberCards={classificationCards}
        placeholder="Add classifications"
      />
    </dl>

    <!-- THE PROSE PAIR — the record's two authored paragraphs, each clamped
         to three lines with the rest a click away (the project description's
         own machinery, shared). Empty rows still RENDER: both are required
         before the record can publish, so the place to add them has to
         stand. Placeholders repeat outstandingFields()' nouns. -->
    <div class="stack" data-gap="md">
      <Firma2ProseField
        field="definition"
        label="Definition"
        value={measure.definition}
        placeholder="Add a definition"
      />
      <Firma2ProseField
        field="reporterGuidance"
        label="Reporter guidance"
        value={measure.reporterGuidance}
        placeholder="Add reporter guidance"
      />
    </div>
  </div>
</EsaCard>

<style>
  .firma2-measure-about {
    --grid-min: 22rem;
  }

  .firma2-measure-about__facts {
    margin: 0;
  }

  /* The editable rows inset their label and value by the display box's own
     inline padding plus its border, so the glyphs stand where the editor's
     text will stand (firma2-editable-field__head states the sum). The static
     Kind pair matches it exactly, or it reads one step left of every sibling. */
  .firma2-measure-about__label,
  .firma2-measure-about__value {
    padding-inline-start: calc(var(--spacing-300, 0.75rem) + var(--form-border-width, 1px));
  }
  .firma2-measure-about__label {
    color: var(--color-content-default-secondary, #646464);
  }
  .firma2-measure-about__value {
    margin: 0;
    color: var(--color-content-default, #202020);
  }

  /* Prose takes a measure — the grid cell can run wider than comfortable
     reading at full page width. ch, because the limit is about characters. */
  .firma2-measure-about :global(.firma2-prose-field) {
    max-inline-size: 70ch;
  }
</style>
