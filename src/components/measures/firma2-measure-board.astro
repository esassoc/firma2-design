---
// firma2-measure-board — the Performance measures index body: every published
// measure as a card of its portfolio figure. The reading twin of the measure
// catalog in Workspace settings, as the Classifications index is the reading
// twin of Settings › Classifications (user, 2026-10-09: "a normal index page
// vs a settings page for that same entity").
//
// ONE CARD PER MEASURE, IN THE GOAL CARD'S GRAMMAR (firma2-goal-card): the
// name as the card's door to the measure's own page, how many projects report
// it, and its figure as firma2-kpi-progress — the same ring and "reported of
// planned" a goal's measures and a project's rows draw, so a reader moving
// between the three reads one picture. Under it, the goals it reports toward,
// each a door to its classification.
//
// PUBLISHED ONLY. A draft is not asked of anyone yet and a retired measure
// takes no new values; both are the administrator's business, in settings.
// The build knows the seeded statuses; a measure retired in this browser is
// hidden by the script below, so the index follows settings (2026-10-09).
// Alphabetical: there is no ranking here, only finding.
//
// bcn-lego-checked: esa-card, firma2-kpi-progress (ring + figure), the hub
// .grid primitive. The only CSS is the grid's auto-fill floor and link ink,
// copied from firma2-goal-board / firma2-goal-card. Beacon is not cloned.
import EsaCard from '@esa/ecology/esa-card.astro';
import Firma2KpiProgress from '../classifications/firma2-kpi-progress.astro';
import { measures, measureDisplayName } from '../../data/firma2-performance-measures';
import { classificationHref, goalsOf, measurePortfolio } from '../../data/firma2-classification-rollup';
import { withBase } from '../../lib/base';
import { measurePageHref } from '../../lib/measure-pages';

const cards = measures
  .filter((m) => m.status === 'Published')
  .sort((a, b) => measureDisplayName(a).localeCompare(measureDisplayName(b)))
  .map((m) => ({ m, progress: measurePortfolio(m), goals: goalsOf(m) }));
---
<div class="firma2-measure-board grid" data-gap="lg">
  {cards.map(({ m, progress, goals }) => {
    const titleId = `measure-${m.slug}`;
    const n = progress.contributions.length;
    return (
      <div class="firma2-measure-board__card" data-measure-slug={m.slug}>
        <EsaCard>
          <div slot="header" class="firma2-measure-board__header repel" data-gap="sm">
            <h2 class="firma2-measure-board__title typography-title-sm-strong" id={titleId}>
              <a class="firma2-measure-board__link" href={withBase(measurePageHref(m.slug))}>{measureDisplayName(m)}</a>
            </h2>
            <span class="firma2-measure-board__quiet typography-body-sm">{n === 0 ? 'No projects yet' : `${n} ${n === 1 ? 'project' : 'projects'}`}</span>
          </div>
          <div class="stack" data-gap="md" aria-labelledby={titleId}>
            <Firma2KpiProgress
              name="All projects"
              unit={progress.unit}
              decimals={m.decimalPlaces}
              additive={progress.additive}
              reported={progress.reported}
              committed={progress.committed}
              goalNote={false}
              from={[]}
            />
            {goals.length > 0 && (
              <p class="firma2-measure-board__goals typography-body-sm">
                <span class="firma2-measure-board__quiet">Reports toward </span>
                <Fragment set:html={goals.map((g) => `<a href="${withBase(classificationHref(g.slug))}">${g.name.replace(/&/g, '&amp;')}</a>`).join(', ')} />
              </p>
            )}
          </div>
        </EsaCard>
      </div>
    );
  })}
</div>

<script>
  import { withDraft } from '../../lib/measure-draft';

  // Retired (or un-published) in this browser: off the index, as the build
  // leaves off the seeded ones.
  document.querySelectorAll<HTMLElement>('.firma2-measure-board__card[data-measure-slug]').forEach((card) => {
    if (withDraft(card.dataset.measureSlug!).status !== 'Published') card.hidden = true;
  });
</script>

<style>
  .firma2-measure-board__card[hidden] {
    display: none;
  }

  /* auto-FILL, as on the goal board: a lone card keeps its neighbours' width. */
  .firma2-measure-board {
    --grid-min: min(24rem, 100%);
    grid-template-columns: repeat(auto-fill, minmax(min(var(--grid-min), 100%), 1fr));
  }

  .firma2-measure-board__header {
    inline-size: 100%;
  }

  .firma2-measure-board__title,
  .firma2-measure-board__goals {
    margin: 0;
    min-inline-size: 0;
  }

  .firma2-measure-board__link {
    color: inherit;
    text-decoration: none;
  }

  .firma2-measure-board__link:hover {
    text-decoration: underline;
  }

  .firma2-measure-board__quiet {
    color: var(--color-content-default-secondary, #646464);
  }
</style>
