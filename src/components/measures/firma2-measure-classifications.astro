---
// firma2-measure-classifications — one performance measure under each
// classification it reports toward: the projects carrying that
// classification, and their progress against THAT classification's goal.
//
// THIS IS WHERE "THE MEASURE'S GOAL" LIVES. A measure has no goal of its own;
// a goal target is set on a classification for one measure, so the same
// measure can be 40% of the way to one classification's target and have no
// target under another. Each row says which, side by side — never one
// combined goal, which would add targets set for overlapping project sets.
//
// The rows are firma2-kpi-progress, the same ring and "reported of goal"
// figure the classification's own page draws, so following the link lands on
// the same number. A classification with no target says "No goal set" and
// measures against what its projects planned.
//
// bcn-lego-checked: firma2-kpi-progress per row, the hub .grid primitive.
// Beacon is not cloned on this machine.
import Firma2KpiProgress from '../classifications/firma2-kpi-progress.astro';
import type { PerformanceMeasureDefinition } from '../../data/firma2-performance-measures';
import { classificationHref, goalsOf, kpiProgress } from '../../data/firma2-classification-rollup';
import { withBase } from '../../lib/base';

interface Props {
  measure: PerformanceMeasureDefinition;
}

const { measure } = Astro.props;
const rows = goalsOf(measure).map((c) => {
  const target = c.targets?.find((t) => t.measure === measure.slug);
  return { c, target, progress: kpiProgress(c.name, measure, target) };
});
---
{rows.length > 0 && (
  <section class="stack" data-gap="md" aria-labelledby="firma2-measure-classifications-title">
    <h2 id="firma2-measure-classifications-title" class="typography-title-sm-strong">By classification</h2>
    <ul class="firma2-measure-classifications grid" data-gap="lg">
      {rows.map(({ c, target, progress }) => (
        <li>
          <Firma2KpiProgress
            name={c.name}
            href={withBase(classificationHref(c.slug))}
            unit={progress.unit}
            decimals={measure.decimalPlaces}
            additive={progress.additive}
            reported={progress.reported}
            committed={progress.committed}
            goal={target?.value}
            goalYear={target?.year}
            from={[]}
          />
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .firma2-measure-classifications {
    --grid-min: 18rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
