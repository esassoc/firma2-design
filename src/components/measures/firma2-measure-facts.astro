---
// firma2-measure-facts — the "Key facts" panel in a performance measure's
// record rail: the attributes stored on the measure itself — status, unit,
// whether its values add up, the guidance reporters see, and the breakdown
// questions with their options. The project page's Key facts, for a measure
// (user, 2026-10-09: "metadata of the entity should be on the rail, similarly
// to how it's handled for metadata of a project").
//
// THIS IS WHERE "HOW IT'S REPORTED" WENT. It began as a folded section at the
// foot of the main column; it is the measure's own record, so it sits beside
// the figures it explains, held at the fold, as a project's facts do.
//
// READ-ONLY, unlike the project's rows: this is the reading page and the
// measure is edited on its settings page ("Edit measure" in the header). So
// the rows are plain dt/dd at the editable field's own display roles —
// label-sm in secondary ink over a body-md value — and look the same.
//
// NOT HERE: the definition (the main column's lede — the figures are read
// against it), the classifications (Connections, under this panel, and the
// By classification section both carry them; a third copy is noise), and the
// claim (the author's own-voice note).
//
// bcn-lego-checked: firma2-rail-section (the rail's section, as the project's
// facts use), esa-pill for status (the settings table's tone map); the rows
// are a <dl> with the .stack primitive, the project facts' construction.
// Beacon is not cloned on this machine.
import EsaPill from '@esa/ecology/esa-pill.astro';
import Firma2RailSection from '../shared/firma2-rail-section.astro';
import type { PerformanceMeasureDefinition } from '../../data/firma2-performance-measures';
import { COUNTING_RULES, MEASURE_STATUS_TONE, withUnspecified } from '../../data/firma2-performance-measures';

interface Props {
  measure: PerformanceMeasureDefinition;
}

const { measure } = Astro.props;
const rule = COUNTING_RULES.find((r) => r.id === measure.countingRule);
const breakdowns = measure.breakdowns
  .filter((b) => !b.retired)
  .map((b) => ({ question: b.question, options: withUnspecified(b.options.filter((o) => !b.retiredOptions?.includes(o))) }));
---
<Firma2RailSection title="Key facts">
  <dl class="firma2-measure-facts stack" data-gap="md" data-measure-slug={measure.slug}>
    <div class="stack" data-gap="2xs">
      <dt class="firma2-measure-facts__label typography-label-sm">Status</dt>
      <dd><EsaPill label={measure.status} variant={MEASURE_STATUS_TONE[measure.status]} size="sm" removable={false} /></dd>
    </div>
    <div class="stack" data-gap="2xs">
      <dt class="firma2-measure-facts__label typography-label-sm">Unit</dt>
      <dd class="typography-body-md">{measure.unit ?? 'Not set'}</dd>
    </div>
    {rule && (
      <div class="stack" data-gap="2xs">
        <dt class="firma2-measure-facts__label typography-label-sm">Values add up</dt>
        <dd class="typography-body-md">{rule.id === 'sum' ? 'Yes' : 'No'}</dd>
      </div>
    )}
    {breakdowns.map((b) => (
      <div class="stack" data-gap="2xs">
        <dt class="firma2-measure-facts__label typography-label-sm">{b.question}</dt>
        <dd class="typography-body-md">{b.options.join(', ')}</dd>
      </div>
    ))}
    {measure.reporterGuidance && (
      <div class="stack" data-gap="2xs">
        <dt class="firma2-measure-facts__label typography-label-sm">Guidance reporters see</dt>
        <dd class="typography-body-md">{measure.reporterGuidance}</dd>
      </div>
    )}
  </dl>
</Firma2RailSection>

<style>
  /* The editable field's label role, so these rows read as the project's. */
  .firma2-measure-facts__label {
    color: var(--color-content-default-secondary, #646464);
  }
</style>
