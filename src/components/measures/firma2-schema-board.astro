---
// firma2-schema-board — a measure's breakdowns and their options, set up the
// way the Tags board sets up tag groups and tags (user, 2026-10-08). The
// file keeps its "schema" name from before the PM 2 reconciliation
// (2026-10-09), when breakdowns were shared subcategory schemas.
//
// ONE GRID, GROUPED. Each breakdown is a heading row — its question and a "…"
// menu — and its options are the rows under it, indented one grip's width: a
// tree read as a table. Same tracks, same subgrid construction as
// firma2-tag-board.
//
// ADDING IS ADDING A ROW. "Add option" at the foot of a breakdown opens an
// empty row with the cursor in it; Enter keeps it and opens the next. A row
// left with no name is dropped. A new breakdown opens as an empty heading;
// Enter on its question goes straight to its first option.
//
// "UNSPECIFIED" IS APPENDED, as PM 2 does — added, never demanded. Every
// breakdown ends with it, as plain text with no field, grip or menu, and it
// stays last.
//
// MOVING IS ONE GRIP. Breakdowns reorder by the grip beside their heading
// (the first one is the reporter's multi-pick); options reorder by theirs and,
// dragged over another breakdown, drop into it. The grip's menu does the same
// without dragging (bcn-sortable-list, linked lists).
//
// WHAT DIFFERS FROM TAGS, on purpose: no colour (an option is never shown as
// a mark), and no "when to use it" or usage column (an option is a bare
// string in the measure model).
//
// PUBLISHED MEASURES (user, 2026-10-08): options still add, rename, reorder
// and move; removing one RETIRES it — a "Retired" pill, no longer offered to
// reporters, kept for the entries that used it, restorable. A whole breakdown
// is the same: it cannot be added or removed once published, so its "…"
// RETIRES it — read-only under a "Retired" pill, no longer asked, restorable.
// Adding or removing one waits for a draft.
//
// The behaviour lives in src/lib/schema-board.ts, mounted by
// firma2-measure-editor, which owns saving the measure.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaPill from '@esa/ecology/esa-pill.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
---
<!-- bcn-lego-checked: every control is a lego (esa-text-field, esa-button,
     esa-dropdown-menu, esa-pill, esa-empty-state) or the spoke's
     bcn-sortable-list (reorders and moves rows between linked lists — no esa-
     list does either; esassoc/ecology#39). The classes only lay rows on one
     shared column grid, which no esa- component does. Beacon is not cloned on
     this machine. Same row construction as firma2-tag-board. -->
<div class="firma2-schema-board" data-schema-board>
  <bcn-sortable-list data-group-sort>
    <template data-sort-handle><EsaButton variant="chrome" size="md" iconOnly icon="menu" aria-label="Move">Move</EsaButton></template>
    <ol class="firma2-schema-board__groups" data-groups></ol>
  </bcn-sortable-list>

  <!-- Clone sources: real legos, copied by the script per row. -->
  <template data-tpl-grip><EsaButton variant="chrome" size="md" iconOnly icon="menu" aria-label="Move">Move</EsaButton></template>
  <template data-tpl-menu><esa-dropdown-menu position="below-end"><EsaButton variant="chrome" size="md" iconOnly icon="ellipsis" label="Actions" /></esa-dropdown-menu></template>
  <template data-tpl-add><EsaButton variant="ghost" size="md" icon="plus">Add option</EsaButton></template>
  <template data-tpl-marker><span class="firma2-schema-board__marker"><EsaPill label="" size="sm" removable={false} /></span></template>
  <template data-tpl-empty><EsaEmptyState size="sm" title="No options yet" /></template>
</div>

<style>
  /* ONE COLUMN GRID FOR EVERY ROW. Each breakdown's section lays four
     tracks — option grip | name | "Retired" pill | "…" — and every row inside it
     takes them by subgrid. The breakdown's own grip sits outside, in front. */
  .firma2-schema-board {
    --schema-board-tracks: 2.5rem minmax(0, 1fr) auto 2.5rem;
  }

  .firma2-schema-board :global([hidden]) {
    display: none !important;
  }

  .firma2-schema-board__groups,
  .firma2-schema-board :global(.firma2-schema-board__options) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .firma2-schema-board__groups:empty {
    display: none;
  }

  /* A breakdown: its grip (added by bcn-sortable-list) in the first track,
     the section across the rest. */
  .firma2-schema-board__groups > :global(li) {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: var(--spacing-200);
    align-items: start;
    padding-block: var(--spacing-400);
    border-block-end: 1px solid var(--color-border-default);
  }

  .firma2-schema-board__groups > :global(li:first-child) {
    border-block-start: 1px solid var(--color-border-default);
  }

  .firma2-schema-board :global(section) {
    grid-column: 2;
    display: grid;
    grid-template-columns: var(--schema-board-tracks);
    column-gap: var(--spacing-200);
    row-gap: var(--spacing-200);
  }

  .firma2-schema-board :global(section) > :global(*),
  .firma2-schema-board :global(.firma2-schema-board__options) > :global(li) {
    grid-column: 1 / -1;
  }

  .firma2-schema-board :global(section) > :global(bcn-sortable-list),
  .firma2-schema-board :global(.firma2-schema-board__options),
  .firma2-schema-board :global(.firma2-schema-board__row),
  .firma2-schema-board :global(.firma2-schema-board__head) {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    column-gap: var(--spacing-200);
    align-items: center;
  }

  .firma2-schema-board :global(.firma2-schema-board__options) {
    row-gap: var(--spacing-200);
  }

  /* Heading: the question starts in the options' grip track — one step out
     from its options — then the "Retired" pill, then "…". */
  .firma2-schema-board :global(.firma2-schema-board__head) > :global(.firma2-schema-board__name) {
    grid-column: 1 / -3;
  }
  .firma2-schema-board :global(.firma2-schema-board__marker) {
    grid-column: -3;
    line-height: 0;
  }
  .firma2-schema-board :global(.firma2-schema-board__row) > :global(.firma2-schema-board__name) {
    grid-column: 2 / -3;
  }
  .firma2-schema-board :global(.firma2-schema-board__menu) {
    grid-column: -2;
  }

  /* What a heading or row says instead of a field: read-only text on the
     same 40px line the fields take. */
  .firma2-schema-board :global(.firma2-schema-board__static) {
    display: flex;
    align-items: center;
    min-block-size: 40px;
    margin: 0;
  }

  /* EXCEPT A READ-ONLY OPTION. A retired breakdown's options are text that
     never becomes a field, so there is no field line to share and the 40px
     only spaced the list out — 24px of text on a 48px pitch. They take their
     own line height and a 4px gap, a ~28px pitch. The heading keeps the 40px
     line: its pill and "…" sit on it. Editable options keep 8px: two bordered
     fields closer than that read as one box. Unspecified, text in an editable
     list, keeps the 40px line so it sits on the same pitch as the fields. */
  .firma2-schema-board__groups > :global(li:not([data-editable])) :global(.firma2-schema-board__row) > :global(.firma2-schema-board__static) {
    min-block-size: 0;
  }
  .firma2-schema-board__groups > :global(li:not([data-editable])) :global(.firma2-schema-board__options) {
    row-gap: var(--spacing-100);
  }

  /* Unspecified, in an editable list, lines up with the fields' text. */
  .firma2-schema-board__groups > :global(li[data-editable]) :global(.firma2-schema-board__row) > :global(.firma2-schema-board__static) {
    padding-inline: var(--spacing-300, 0.75rem);
    color: var(--color-content-default-secondary, #646464);
  }

  /* A new breakdown's "what it still needs" line, once met: kept as an
     invisible line so nothing under it moves mid-click. */
  .firma2-schema-board :global(.firma2-schema-board__meta[data-done]) {
    visibility: hidden;
  }

  /* A retired breakdown recedes: its question and options in the secondary
     colour, the pill and the line under it saying why. */
  .firma2-schema-board__groups > :global(li[data-retired]) :global(.firma2-schema-board__static) {
    color: var(--color-content-default-secondary, #646464);
  }

  .firma2-schema-board :global(:is(.firma2-schema-board__meta, .firma2-schema-board__error)) {
    grid-column: 1 / -1;
    margin: 0;
  }
  .firma2-schema-board :global(.firma2-schema-board__meta) {
    color: var(--color-content-default-secondary, #646464);
  }
  .firma2-schema-board :global(.firma2-schema-board__error) {
    color: var(--color-content-utility-danger, #ce2c31);
  }

  .firma2-schema-board :global(.firma2-schema-board__add) {
    grid-column: 2 / -1;
    justify-self: start;
  }

  /* GRIP AND "…" SHOW ON THE ROW YOU'RE ON — the firma2-tag-board rule:
     opacity, not visibility, so both stay in the tab order; focus, an open
     menu, a drag and a device without hover show them outright. */
  .firma2-schema-board :global(.firma2-schema-board__row) > :global(:is([data-sort-grip], .firma2-schema-board__menu)),
  .firma2-schema-board :global(.firma2-schema-board__head) > :global(.firma2-schema-board__menu),
  .firma2-schema-board__groups > :global(li) > :global([data-sort-grip]) {
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .firma2-schema-board :global(.firma2-schema-board__row:is(:hover, :focus-within, [data-dragging])) > :global(:is([data-sort-grip], .firma2-schema-board__menu)),
  .firma2-schema-board :global(.firma2-schema-board__head:is(:hover, :focus-within)) > :global(.firma2-schema-board__menu),
  .firma2-schema-board__groups > :global(li:is(:has(> section > .firma2-schema-board__head:hover), [data-dragging])) > :global([data-sort-grip]),
  .firma2-schema-board__groups > :global(li) > :global([data-sort-grip]:focus-within),
  .firma2-schema-board :global(:is([data-sort-grip], .firma2-schema-board__menu)[open]) {
    opacity: 1;
  }

  @media (hover: none) {
    .firma2-schema-board :global(.firma2-schema-board__row) > :global(:is([data-sort-grip], .firma2-schema-board__menu)),
    .firma2-schema-board :global(.firma2-schema-board__head) > :global(.firma2-schema-board__menu),
    .firma2-schema-board__groups > :global(li) > :global([data-sort-grip]) {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .firma2-schema-board :global(:is([data-sort-grip], .firma2-schema-board__menu)) {
      transition: none;
    }
  }
</style>

<script>
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-dropdown-menu';
  import '../shared/bcn-sortable-list';
</script>
