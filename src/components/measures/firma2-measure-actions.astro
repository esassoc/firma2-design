---
// firma2-measure-actions — a performance measure's lifecycle, for the page
// header's `actions` slot: Publish while it is a draft, Retire while it is
// published, Reactivate once retired. "The lifecycle in the actions cluster" is
// a record-page idiom (product brief, "The sibling record page is the spec").
//
// PUBLISH IS INERT, NOT HIDDEN, while the definition is short of complete:
// disabled, described by the status line beside the pill, which names what is
// still needed (brief §4 — disabled must tell the truth, with the reason in
// view). It asks first: publishing fixes the counted structure.
//
// Painted and wired by firma2-measure-editor, which owns the record and the
// confirm dialog.
//
// bcn-lego-checked: esa-button for each act. Beacon is not cloned here.
import EsaButton from '@esa/ecology/esa-button.astro';
---
<span class="firma2-measure-actions cluster" data-gap="xs" data-measure-actions>
  <span data-publish-wrap><EsaButton variant="primary" size="md" aria-describedby="measure-status-note" data-editor-publish>Publish</EsaButton></span>
  <span data-retire-wrap hidden><EsaButton variant="secondary" appearance="outline" size="md" data-editor-retire>Retire</EsaButton></span>
  <span data-reactivate-wrap hidden><EsaButton variant="secondary" appearance="outline" size="md" data-editor-reactivate>Reactivate</EsaButton></span>
</span>

<style>
  .firma2-measure-actions [hidden] {
    display: none !important;
  }
</style>
