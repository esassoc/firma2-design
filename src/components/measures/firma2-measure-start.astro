---
// firma2-measure-start — New measure, and the question team 6 asks before it:
// "How would you like to start?" Two doors, named for what the person has in
// hand — a vague sense of the work, or the sentence their funder wants — and
// both end on the drafting page, which keeps both doors on one screen for
// anyone who arrives there directly.
//
// bcn-lego-checked: esa-button opens an esa-dialog. The two doors are large
// two-line choice buttons (a title and what happens next); esa-button carries
// one label and no description, and an esa-card is not a control, so they are
// native <button>s styled from the floating-surface tokens. Beacon is not
// cloned here.
import EsaButton from '@esa/ecology/esa-button.astro';
import { withBase } from '../../lib/base';

const newHref = withBase('/prototypes/performance-measures/new');
---
<span class="firma2-measure-start">
  <EsaButton variant="primary" icon="plus" data-measure-start>New measure</EsaButton>
  <esa-dialog class="firma2-measure-start__dialog" heading="How would you like to start?" size="md">
    <div class="stack" data-gap="md">
      <button type="button" class="firma2-measure-start__door" data-door={`${newHref}#guided`}>
        <span class="typography-label-md">Help me work out what to measure</span>
        <span class="typography-body-sm firma2-measure-start__note">A couple of short questions about your program, with answers to pick from. Ends with the measure drafted.</span>
      </button>
      <button type="button" class="firma2-measure-start__door" data-door={`${newHref}#claim`}>
        <span class="typography-label-md">I know what I need to say</span>
        <span class="typography-body-sm firma2-measure-start__note">Write the claim you need to make to your funder, and the measure is drafted from it.</span>
      </button>
    </div>
    <!-- The third way in, for someone who wants the form: the catalog's own
         sheet, opened on a blank measure through its data-open-measure seam. -->
    <div slot="footer" class="cluster" data-gap="xs">
      <EsaButton variant="ghost" size="md" data-open-measure="new" data-blank>Start from a blank measure</EsaButton>
    </div>
  </esa-dialog>
</span>

<style>
  .firma2-measure-start__door {
    display: grid;
    gap: var(--spacing-100);
    inline-size: 100%;
    padding: var(--spacing-400);
    border: 1px solid var(--color-border-default, #cecece);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--color-background-elevation-raised, #fcfcfc);
    color: var(--color-content-default, #202020);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .firma2-measure-start__door:hover {
    border-color: var(--color-border-brand, #46a758);
    background: var(--color-background-default-hover, #f0f0f0);
  }

  .firma2-measure-start__door:focus-visible {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, #3e9b4f);
    outline-offset: var(--focus-ring-offset, 2px);
  }

  .firma2-measure-start__note {
    color: var(--color-content-default-secondary, #646464);
  }
</style>

<script>
  import '@esa/ecology/esa-dialog';

  document.querySelectorAll<HTMLElement>('.firma2-measure-start').forEach((root) => {
    const dialog = root.querySelector<HTMLElement & { show: () => void }>('.firma2-measure-start__dialog');
    root.querySelector('[data-measure-start]')?.addEventListener('click', () => dialog?.show());
    root.querySelector('[data-blank]')?.addEventListener('click', () => (dialog as HTMLElement & { close?: () => void })?.close?.());
    root.querySelectorAll<HTMLElement>('[data-door]').forEach((door) =>
      door.addEventListener('click', () => window.location.assign(door.dataset.door!)),
    );
  });
</script>
