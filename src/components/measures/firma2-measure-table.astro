---
// firma2-measure-table — the Performance Measures index: the tenant's whole
// catalog of measures as one scannable, searchable, filterable table, with the
// Type/Classifications/Status filter dropdowns, quick search, Clear all,
// record-count footer and CSV export this spoke's data grids share.
//
// THE COLUMNS ARE THE MEASURE'S ATTRIBUTE LIST — name, status, type,
// classifications, unit, counting rule — read-only, the way every settings
// list is. THE NAME IS A DOOR to the measure's own page (Workspace settings ›
// Performance measures › <measure>), where everything is edited: the grid
// used to edit cells in place and open a side sheet, and both went when setup
// moved to settings (2026-10-08) — one editor per record, and publishing goes
// through its confirm instead of a status cell. Status sits beside the name
// rather than at the far edge; it is the first fact a reader wants about a
// row ("is this collecting values?").
//
// Deliberately absent: definition, reporter guidance, decimal places. All real
// fields, none SCANNABLE — a paragraph in a cell is a wall. Definition still
// reaches the reader, as the Measure column's tooltip.
//
// Search and filters live INSIDE this component rather than beside it: both feed
// the same AG Grid instance (quick filter and external filter), so splitting
// them into a sibling section would mean plumbing a gridApi across a component
// boundary for no gain. Same seam firma2-project-grid uses.
//
// bcn-lego-checked: ecology has NO table/grid/data-grid lego — checked the full
// node_modules/@esa/ecology/src/components catalog. esa-grid is a
// documentation-only reference page for Beacon's Angular AG Grid wrapper with no
// .astro or .ts implementation to import. Beacon is not cloned on this machine,
// so tier 2 is unavailable. AG Grid Community is the established tabular
// surface across this spoke family, and shared/firma2-data-grid-chrome.css is
// the reusable home for its frame — reused here verbatim, not forked. Every
// other control IS a lego: esa-text-field for search, esa-filter-container +
// esa-filter-dropdown for the Type, Classifications and Status filters,
// esa-filter-clear-button for Clear all, esa-button for the CSV download,
// esa-empty-state for the no-results overlay, and the Status cells clone real
// server-rendered esa-pill markup rather than restyling a chip by hand.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaPill from '@esa/ecology/esa-pill.astro';
import EsaFilterContainer from '@esa/ecology/esa-filter-container.astro';
import EsaFilterClearButton from '@esa/ecology/esa-filter-clear-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import '../shared/firma2-data-grid-chrome.css';
import { measuresByName, MEASURE_KINDS, MEASURE_STATUS_TONE, CLASSIFICATION_NAMES } from '../../data/firma2-performance-measures';
import type { MeasureStatus, PerformanceMeasureDefinition } from '../../data/firma2-performance-measures';

interface Props {
  measures?: PerformanceMeasureDefinition[];
}

const { measures = measuresByName() } = Astro.props;

// The dot colour each esa-pill variant paints, so a status option in the panel
// reads as the same thing as its pill in the Status column. All five are the
// `content-*` (grass/gray step 11) rung of their ramp, so the dots sit at one
// saturation instead of mixing a solid-fill step in among text steps.
const TONE_DOT: Record<(typeof MEASURE_STATUS_TONE)[MeasureStatus], string> = {
  default: 'var(--color-content-default-tertiary)',
  info: 'var(--color-content-utility-info)',
  primary: 'var(--color-content-brand)',
  success: 'var(--color-content-utility-success)',
  warning: 'var(--color-content-utility-warning)',
};

// Lifecycle order, not alphabetical — and taken from the tone record's own key
// order rather than typed again here, so a fourth status added to the data
// module arrives in this control (and in its sort) with a pill colour already
// attached. Alphabetical would put Draft before Active, which is backwards for
// a lifecycle.
const STATUS_ORDER = Object.keys(MEASURE_STATUS_TONE) as MeasureStatus[];

// Only statuses actually present are offered, so the control never presents a
// filter that returns nothing. RETIRED IS NOT SPECIAL-CASED OUT and nothing is
// pre-selected: an empty selection already IS all, which is exactly what keeps
// retired measures visible in the catalog at rest. A retired measure is quiet,
// not hidden — it still carries the values projects reported against it.
const statusOptions = STATUS_ORDER.filter((s) => measures.some((m) => m.status === s)).map((s) => ({
  value: s,
  label: s,
  color: TONE_DOT[MEASURE_STATUS_TONE[s]],
}));

// Classification options come from the portfolio's vocabulary (CLASSIFICATION_NAMES),
// narrowed to the branches this catalog actually uses — same "never offer an
// empty filter" convention as the status list. No dots: a classification is a
// goal, not a status, and nothing else on the screen colours it.
const classificationOptions = CLASSIFICATION_NAMES.filter((c) =>
  measures.some((m) => m.classifications.includes(c)),
).map((p) => ({
  value: p,
  label: p,
}));

// "Show me the outcomes" is a question about the whole catalog, and outcomes
// are the minority of it. Values are the stored ids ('output'), labels the
// module's own names ('Output'), order MEASURE_KINDS' declared one.
const typeOptions = MEASURE_KINDS.filter((k) => measures.some((m) => m.kind === k.id)).map((k) => ({
  value: k.id,
  label: k.name,
}));
---
<section class="firma2-measure-table stack" data-gap="md">
  <!-- Search, the three filters and Clear all are ONE row; Download CSV alone
       at the right. See firma2-project-grid for the shared layout reasoning;
       size="md" everywhere because the sm rung is unfinished across the form
       family (filed as esassoc/ecology#31). -->
  <div class="firma2-data-grid__controls repel">
    <div class="firma2-data-grid__controls-filters cluster">
      <div class="firma2-data-grid__search">
        <esa-text-field
          label="Search measures"
          placeholder="Name, unit, or classification"
          size="md"
          data-measures-search
        ></esa-text-field>
      </div>

      <EsaFilterContainer>
        <!-- Type leads the three, matching the column order: it is the
             coarsest cut in the catalog. -->
        <esa-filter-dropdown
          data-measures-type-filter
          name="type"
          label="Type"
          size="md"
          multiple
          placeholder="Search types"
          options={JSON.stringify(typeOptions)}
        ></esa-filter-dropdown>
        <esa-filter-dropdown
          data-measures-classification-filter
          name="classifications"
          label="Classifications"
          size="md"
          multiple
          placeholder="Search classifications"
          options={JSON.stringify(classificationOptions)}
        ></esa-filter-dropdown>
        <esa-filter-dropdown
          data-measures-status-filter
          name="status"
          label="Status"
          size="md"
          multiple
          placeholder="Search statuses"
          options={JSON.stringify(statusOptions)}
        ></esa-filter-dropdown>
      </EsaFilterContainer>

      <!-- Clear all sits OUTSIDE esa-filter-container on purpose — the
           container centres its children and this must bottom-align with the
           triggers. It clears the FILTERS and leaves the search box alone:
           the lego hard-codes aria-label="Clear all filters". Selected by the
           lego's own hook, [data-esa-filter-clear]. -->
      <EsaFilterClearButton />
    </div>

    <EsaButton variant="chrome" iconOnly icon="download" label="Download CSV" size="sm" data-measures-csv />
  </div>

  <!-- AG Grid mounts here. autoHeight grows with rows so the page (not an inner
       pane) owns vertical scroll; the wrapper owns the framed surface. -->
  <div class="firma2-data-grid__grid" data-measures-grid></div>

  <footer class="firma2-data-grid__footer">
    <span class="typography-meta" data-measures-count>
      {measures.length} measures
    </span>
  </footer>

  <!-- Real esa-pill markup, server-rendered once per status and cloned into grid
       cells, so the status chips in the table ARE the lego rather than a
       hand-rolled copy of it. ALL statuses render, including any absent from the
       current data, so a measure that changes status still finds its pill. -->
  <div data-measures-pill-templates hidden aria-hidden="true">
    {STATUS_ORDER.map((s) => (
      <span data-status={s}>
        <EsaPill label={s} variant={MEASURE_STATUS_TONE[s]} size="sm" removable={false} />
      </span>
    ))}
  </div>


  <!-- The no-match empty state, server-rendered once and handed to AG Grid as
       its overlayNoRowsTemplate — the lego, not the grid's built-in string. -->
  <div data-measures-empty hidden aria-hidden="true">
    <EsaEmptyState
      size="sm"
      title="No matching measures"
      description="Try a different search, or clear the filters above."
    />
  </div>

  <!-- Row data, serialized so the client module (which imports ag-grid-community)
       hydrates without a second fetch. -->
  <script type="application/json" data-measures-data set:html={JSON.stringify(measures)}></script>
</section>

<style>
  /* bcn-lego-checked: every rule below adjusts a lego in place — no bespoke
     control. Clear-all height + hidden are the esa-filter-clear-button
     adjustments documented in this table since the lego shipped. */
  .firma2-measure-table :global(.esa-filter-clear-button) {
    height: 40px;
  }

  .firma2-measure-table :global(.esa-filter-clear-button[hidden]) {
    display: none;
  }
</style>

<script>
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-filter-dropdown';
  import { escGridHtml as esc, wireDataGrid } from '../shared/grid-chrome';
  import { label } from '../../lib/vocabulary';
  import { watchGridDefault } from '../../lib/grid-defaults';
  import { draftedSlugs, isLocalMeasureSlug, mergeDraft, readDraft, withDraft } from '../../lib/measure-draft';
  import { recordHref } from '../../lib/taxonomy-record';
  import {
    COUNTING_RULES,
    MEASURE_KINDS,
    MEASURE_STATUS_TONE,
    measureDisplayName,
  } from '../../data/firma2-performance-measures';
  import type { PerformanceMeasureDefinition } from '../../data/firma2-performance-measures';
  import type { ColDef } from 'ag-grid-community';

  /** What an unanswered optional field shows. An em dash, not a blank cell. */
  const UNSET = '—';

  /**
   * Sort a closed vocabulary in the order the vocabulary itself declares, not
   * alphabetically: Status is a lifecycle (Active → Draft → Retired), the
   * counting rules run output rules then outcome rules, and Type only LOOKS
   * alphabetical ('outcome' sorts before 'output' on a string compare, which
   * would lead the catalog with its minority kind). Anything not in the list
   * sorts last, which is also how an unset optional lands at the bottom.
   */
  const rankBy = (order: readonly string[]) => (a: string, b: string) => {
    const at = order.indexOf(a);
    const bt = order.indexOf(b);
    return (at === -1 ? order.length : at) - (bt === -1 ? order.length : bt);
  };

  const STATUS_ORDER = Object.keys(MEASURE_STATUS_TONE);
  const COUNTING_RULE_ORDER = COUNTING_RULES.map((r) => r.id as string);
  const COUNTING_RULE_NAME = new Map(COUNTING_RULES.map((r) => [r.id as string, r.name] as const));
  const TYPE_ORDER = MEASURE_KINDS.map((k) => k.id as string);
  // Base-less; recordHref() adds the base and picks the seeded or draft route.
  const LIST_PATH = '/prototypes/workspace-settings/performance-measures';
  const TYPE_NAME = new Map(MEASURE_KINDS.map((k) => [k.id as string, k.name] as const));

  function initMeasureTable(root: HTMLElement) {
    const emptyState = root.querySelector<HTMLElement>('[data-measures-empty] > *');
    const typeFilter = root.querySelector<HTMLElement>('[data-measures-type-filter]');
    const classificationFilter = root.querySelector<HTMLElement>('[data-measures-classification-filter]');
    const statusFilter = root.querySelector<HTMLElement>('[data-measures-status-filter]');
    const clearButton = root.querySelector<HTMLElement>('[data-esa-filter-clear]');

    // Pre-clone the real esa-pill markup per status (server-rendered with the
    // design-system scope hash) so grid cells reuse the lego verbatim.
    const pillHTML = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[data-measures-pill-templates] [data-status]').forEach((el) => {
      pillHTML.set(el.dataset.status ?? '', el.innerHTML);
    });

    let typeValues: string[] = [];
    let classificationValues: string[] = [];
    let statusValues: string[] = [];

    // THE ROWS ARE SEEDS + DRAFTS, recomputed as one list: every seed with its
    // local draft laid over it, then every measure minted in this browser.
    // LOCAL DRAFTS WIN OVER THE SEED — rename a measure on its page, and a table
    // still showing "Untitled measure" would read as a bug.
    const seedNode = root.querySelector<HTMLElement>('[data-measures-data]');
    let seeded: PerformanceMeasureDefinition[] = [];
    try {
      seeded = JSON.parse(seedNode?.textContent ?? '[]') as PerformanceMeasureDefinition[];
    } catch {
      // A malformed payload is a build bug; degrading to an empty catalog at
      // least renders the empty state instead of throwing.
    }
    const currentRows = (): PerformanceMeasureDefinition[] => [
      ...seeded.map((seed) => mergeDraft(seed, readDraft(seed.slug))),
      ...draftedSlugs()
        .filter(isLocalMeasureSlug)
        .map((slug) => withDraft(slug)),
    ];

    // The merged rows are written back into the payload BEFORE wireDataGrid
    // parses it — one data path, no second write racing the first.
    if (seedNode) seedNode.textContent = JSON.stringify(currentRows());

    const handle = wireDataGrid<PerformanceMeasureDefinition>({
      root,
      gridSelector: '[data-measures-grid]',
      dataSelector: '[data-measures-data]',
      searchSelector: '[data-measures-search]',
      countSelector: '[data-measures-count]',
      csvSelector: '[data-measures-csv]',
      countNoun: 'measures',
      csvFileName: 'projectfirma-performance-measures.csv',
      columnDefs: [
        // Widths are explicit on every fixed column: AG Grid's `minWidth` is only
        // a floor, and a column without `width` defaults to 200px, which silently
        // pushes the last column off-screen at 1280.
        //
        // The name is the widest column because it is what people scan for,
        // and it is the DOOR: a link to the measure's page, the way every
        // settings list opens its records (firma2-organization-grid). Escaped
        // through esc() on every interpolation: a cellRenderer takes a string
        // of HTML and unescaped interpolation here is an injection point.
        //
        // The text is measureDisplayName(), never the raw name: a measure made
        // in this browser can reach this catalog before it is named, and a
        // blank link would be indistinguishable from a rendering fault. The
        // tooltip is the stored DEFINITION — what counts and what does not is
        // the fact a reader is missing here.
        {
          headerName: 'Measure', field: 'name', colId: 'name',
          flex: 2, minWidth: 220, cellClass: 'firma2-grid-name', tooltipField: 'definition',
          getQuickFilterText: (p) => (p.data ? measureDisplayName(p.data) : ''),
          cellRenderer: (p: { data?: PerformanceMeasureDefinition }) =>
            p.data
              ? `<a class="firma2-grid-link" href="${esc(recordHref(LIST_PATH, p.data.slug))}">${esc(measureDisplayName(p.data))}</a>`
              : '',
        },
        // Status beside the name, not at the far edge: "is this collecting
        // values?" is the first question about a row, and the measure's page
        // leads with it too. The cloned esa-pill — a badge, never a coloured
        // row edge. The tooltip explains the vocabulary, not any row.
        {
          headerName: 'Status', field: 'status', colId: 'status', width: 135,
          headerTooltip: 'Draft: not collecting yet. Active: reporters file values. Retired: keeps past values, takes no new ones.',
          comparator: rankBy(STATUS_ORDER),
          cellRenderer: (p: { value: string }) =>
            `<span class="firma2-grid-status">${pillHTML.get(p.value) ?? esc(p.value)}</span>`,
        },
        // Output or outcome. PLAIN TEXT, NOT A SECOND PILL: the Status pill is
        // the only saturated thing in the grid, which is exactly why it reads
        // at a glance, and two values distinguished by hue is unreadable to a
        // colourblind reader anyway. The cell spends the module's name
        // ("Output"), never the stored id; the Type filter dropdown and the
        // declared-order sort are the answers to the shared-four-letters
        // scanning cost.
        {
          headerName: 'Type', field: 'kind', colId: 'kind', width: 110,
          headerTooltip: 'Outputs record work a project did. Outcomes record a condition a monitoring effort measured — so the two allow different counting rules.',
          comparator: rankBy(TYPE_ORDER),
          valueFormatter: (p) => (p.value ? TYPE_NAME.get(p.value) ?? p.value : UNSET),
        },
        // UNSET IS A REAL STATE, not a missing value: a measure minted from the
        // blank page genuinely has not answered these yet, and the em dash
        // says "not answered" where an empty cell would read as a fault.
        // A SET IN A CELL, joined once in the valueGetter so the sort, the
        // tooltip and the text all read the same string.
        {
          headerName: label('Classifications'), colId: 'classifications',
          valueGetter: (p) => (p.data?.classifications ?? []).join(', '),
          flex: 1, minWidth: 170,
          getQuickFilterText: (p) => p.value ?? '',
          tooltipValueGetter: (p) => p.value || undefined,
          valueFormatter: (p) => p.value || UNSET,
        },
        // Just the unit: the Measure column already says of what, because a
        // measure's name is its number's label.
        {
          headerName: 'Unit', colId: 'unit', width: 130,
          valueGetter: (p) => p.data?.unit ?? '',
          getQuickFilterText: (p) => p.value ?? '',
          valueFormatter: (p) => p.value || UNSET,
        },
        // The counting rule decides what a total MEANS, so the cell spends the
        // rule's whole name rather than its stored id. Sorted in
        // COUNTING_RULES' declared order, which clusters by type for free.
        {
          headerName: 'Counting rule', colId: 'countingRule', width: 180,
          headerTooltip: 'How entries combine into a total. Outputs add up or merge on the map; outcome readings keep the latest or the average.',
          valueGetter: (p) => p.data?.countingRule ?? '',
          comparator: rankBy(COUNTING_RULE_ORDER),
          valueFormatter: (p) => (p.value ? COUNTING_RULE_NAME.get(p.value) ?? p.value : UNSET),
        },
      ] satisfies ColDef[],
      gridOptions: {
        overlayNoRowsTemplate: emptyState?.outerHTML,
        isExternalFilterPresent: () =>
          typeValues.length > 0 || classificationValues.length > 0 || statusValues.length > 0,
        doesExternalFilterPass: (node) =>
          (typeValues.length === 0 || typeValues.includes(node.data?.kind ?? '')) &&
          // A ROW MATCHES IF IT CARRIES ANY SELECTED CLASSIFICATION — `some`,
          // not equality: selecting two classifications widens the result,
          // which is what every other filter on this bar already means.
          (classificationValues.length === 0 ||
            (node.data?.classifications ?? []).some((c) => classificationValues.includes(c))) &&
          (statusValues.length === 0 || statusValues.includes(node.data?.status ?? '')),
      },
    });
    if (!handle) return;
    // The workspace's column layout (Workspace settings → Grid defaults).
    watchGridDefault(handle.gridApi, 'performance-measures');
    const { gridApi } = handle;

    // Clear all is only in the row when there is something to clear.
    const syncClearVisibility = () => {
      if (clearButton) {
        clearButton.hidden =
          typeValues.length === 0 && classificationValues.length === 0 && statusValues.length === 0;
      }
    };
    syncClearVisibility();

    const onSelection = (apply: (values: string[]) => void) => (event: Event) => {
      apply((event as CustomEvent<{ value?: string[] }>).detail?.value ?? []);
      gridApi.onFilterChanged();
      syncClearVisibility();
    };
    typeFilter?.addEventListener('selection-change', onSelection((v) => { typeValues = v; }));
    classificationFilter?.addEventListener('selection-change', onSelection((v) => { classificationValues = v; }));
    statusFilter?.addEventListener('selection-change', onSelection((v) => { statusValues = v; }));

    // esa-filter-clear-button is presentational: it emits a bubbling
    // `esa-filter-clear` and expects whoever owns the filter state to act.
    // Emptying a dropdown means writing its `_selected` state directly — the
    // lego has no public clear(); writing the reactive property re-renders but
    // does NOT emit selection-change, so the local arrays reset here too.
    root.addEventListener('esa-filter-clear', () => {
      [typeFilter, classificationFilter, statusFilter].forEach((el) => {
        const dropdown = el as (HTMLElement & { _selected?: string[] }) | null;
        if (dropdown) dropdown._selected = [];
      });
      typeValues = [];
      classificationValues = [];
      statusValues = [];
      gridApi.onFilterChanged();
      syncClearVisibility();
    });
  }

  document.querySelectorAll<HTMLElement>('.firma2-measure-table').forEach(initMeasureTable);
</script>
