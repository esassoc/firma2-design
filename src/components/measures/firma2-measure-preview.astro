---
// firma2-measure-preview — what a measure asks of the people who file it: the
// burden level, what it buys, and one entry as reporters will see it. The
// content of the measure page's side panel (firma2-side-panel), beside the
// form that shapes it.
//
// BESIDE THE FORM, NOT UNDER IT (user, 2026-10-08). The brief's compliance
// loop: the author has to feel the reporter's burden at the moment they
// impose it. At the bottom of a one-column page, the cost of a schema edit
// was a scroll away from the edit; in the panel it repaints in view.
//
// PAINTED BY firma2-measure-editor, which owns the definition: it finds these
// targets by their data hooks under [data-measure-preview], wherever on the
// page this sits. A LABELLED, INERT derivation — no example value is invented
// (brief §4, "never simulate someone else's UI").
//
// Same sections as every settings panel: firma2-rail-section.
import Firma2RailSection from '../shared/firma2-rail-section.astro';
import Firma2ReporterBurden from './firma2-reporter-burden.astro';
---
<div class="firma2-measure-preview stack" data-gap="2xl" data-measure-preview>
  <Firma2RailSection title="Burden">
    <div class="stack" data-gap="md">
      <Firma2ReporterBurden bare />
      <p class="firma2-measure-preview__note typography-body-sm" data-preview-payoff></p>
    </div>
  </Firma2RailSection>

  <Firma2RailSection title="Entry form">
    <div class="stack" data-gap="md">
      <p class="firma2-measure-preview__note typography-body-sm">
        One entry as reporters will file it. It follows your edits; nothing typed here is saved.
      </p>
      <div class="firma2-measure-preview__card" data-preview-card></div>
    </div>
  </Firma2RailSection>
</div>

<style>
  /* The example entry, on the raised surface a real form card sits on, so it
     reads as somebody else's form rather than more of this one. Its inner
     classes are built by the editor's script, hence :global. */
  .firma2-measure-preview__card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300, 0.75rem);
    padding: var(--spacing-400, 1rem);
    background: var(--color-background-elevation-raised, #fff);
    border: 1px solid var(--color-border-default, #d9d9d9);
    border-radius: var(--radius-md, 8px);
  }

  .firma2-measure-preview :global(.firma2-measure-editor__preview-title) {
    margin: 0;
  }

  .firma2-measure-preview__note,
  .firma2-measure-preview :global(.firma2-measure-editor__preview-meta) {
    margin: 0;
    color: var(--color-content-default-secondary, #646464);
  }

  .firma2-measure-preview :global([hidden]) {
    display: none !important;
  }
</style>
