---
// firma2-measure-drafter — a performance measure drafted from what the
// program lead needs to tell their funder. Ported from ProjectFirma2's
// hackathon team 6 and reworked against this spoke's measure model.
//
// TWO DOORS, ONE SURFACE. The hackathon put a chooser dialog in front of two
// separate pages: "I know what I need to say" and "Help me work out what to
// measure". Here both doors are on screen at once, in the order a reader
// meets them: the claim box first (one sentence, one click), and under it a
// searchable list of the work (firma2-work-picker) for the author who does
// not have that sentence yet. Nobody has to
// classify themselves before they can start, and the chooser's extra click
// is gone.
//
// THE INTERVIEW IS TWO CLICKS. The first is a row in the work list, which
// names the goal and the work at once (they were two turns, theme then work,
// until 2026-10-08). The second is the cost question, asked as competing sentences the author would actually say,
// with what each costs a reporter written under it WHILE THE CHOICE IS OPEN.
// That line is the reason the interview exists: the brief's compliance loop
// says the burden is invisible at the moment it is imposed, and here it is
// not. Typing is offered at every turn and required at none.
//
// THE CLAIM IS READ BACK before anything is drafted, editable, because it is
// the author's and the measure is built from it.
//
// THE DRAFT IS STATED, NOT SIMULATED. The review shows the sentence a
// reporter completes and the definition as plain rows — never a mockup of
// the reporter's form (product brief, "State the record; price the burden").
// Every split says where its answer comes from: a shared list this program
// already keeps, a list the system fills in, or a new one.
//
// NOTHING IS SAVED UNTIL "Save as draft". That hands the draft to the
// measure's own settings page as an ordinary Draft, where it is finished
// like any other — this page drafts, that page defines.
//
// SCRIPTED. There is no model in a static prototype; see
// src/data/firma2-measure-drafting.ts for what stands in for it and why.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import EsaPill from '@esa/ecology/esa-pill.astro';
import Firma2RailSection from '../shared/firma2-rail-section.astro';
import EsaLoadingSpinner from '@esa/ecology/esa-loading-spinner.astro';
import Firma2WorkPicker from './firma2-work-picker.astro';
import Firma2ReporterBurden from './firma2-reporter-burden.astro';
import { withBase } from '../../lib/base';

const measuresPath = '/prototypes/workspace-settings/performance-measures';
// The measure's own page: a draft made here opens on the draft route.
const draftHref = withBase(`${measuresPath}/draft`);
---
<!-- bcn-lego-checked: sections are firma2-rail-section (the settings
     section); controls are legos (esa-textarea, esa-button, esa-alert-box,
     esa-pill, esa-loading-spinner) or spoke components (firma2-work-picker,
     firma2-reporter-burden). Bespoke: the funder-question choice (see its
     style rule), and layout for the transcript and definition rows. Beacon is
     not cloned on this machine. -->
<div class="firma2-measure-drafter" data-draft-href={draftHref}>
  <!-- ===== START: the two doors =====
       UNBOXED SETTINGS SECTIONS (2026-10-08), like the measure page this
       hands off to: firma2-rail-section, not esa-card. -->
  <div class="stack" data-gap="2xl" data-stage="start">
    <Firma2RailSection title="What do you need to tell your funder?">
      <div class="stack" data-gap="md">
        <esa-textarea
          data-claim
          aria-label="What you need to tell your funder"
          rows="3"
          placeholder="e.g. I need to tell my funder how many acres of streamside habitat we planted each year, and how."
        ></esa-textarea>
        <div class="cluster" data-gap="sm">
          <EsaButton variant="ai" size="md" data-draft-claim>Draft the measure</EsaButton>
        </div>
        <div data-no-match hidden>
          <EsaAlertBox variant="info" title="No work found in that claim">
            Name the work itself — planting, thinning, trail building — or pick it from the list below.
          </EsaAlertBox>
        </div>
      </div>
    </Firma2RailSection>

    <Firma2RailSection title="Not sure how to say it?">
      <div class="stack" data-gap="md">
        <p class="typography-body-md">Pick the work your program does, then answer one question.</p>
        <Firma2WorkPicker />
      </div>
    </Firma2RailSection>

    <div>
      <EsaButton variant="ghost" size="md" tag="a" href={draftHref}>Start from a blank measure</EsaButton>
    </div>
  </div>

  <!-- ===== INTERVIEW ===== -->
  <div data-stage="interview" hidden>
    <!-- Titled with the goal the picked work serves; the script writes it. -->
    <Firma2RailSection title="Your measure" data-interview>
      <EsaButton slot="actions" variant="ghost" size="md" data-restart>Start over</EsaButton>
      <div class="stack" data-gap="lg">

        <!-- The conversation so far, kept on screen: at the end it is the
             record of what the claim was built from. -->
        <ol class="firma2-measure-drafter__transcript stack" data-gap="sm" data-transcript></ol>

        <div class="stack" data-gap="md" data-turn>
          <h4 class="firma2-measure-drafter__h typography-title" data-question></h4>
          <div class="stack" data-gap="sm" data-answers></div>
          <p class="firma2-measure-drafter__cost typography-body-md" data-cost hidden></p>
          <div>
            <EsaButton variant="ghost" size="md" data-own-toggle>None of these — I’ll describe it</EsaButton>
          </div>
          <div class="stack" data-gap="sm" data-own hidden>
            <esa-textarea data-own-text label="In your own words" rows="2"></esa-textarea>
            <div class="cluster" data-gap="sm">
              <EsaButton variant="secondary" size="md" data-own-continue>Continue</EsaButton>
            </div>
          </div>
        </div>

        <div class="stack" data-gap="md" data-claim-block hidden>
          <h4 class="firma2-measure-drafter__h typography-title">Here’s what you need to say</h4>
          <esa-textarea
            data-claim-readback
            aria-label="Your claim"
            rows="3"
            help-text="The measure is built from this claim. Change anything that isn’t right."
          ></esa-textarea>
          <div class="cluster" data-gap="sm">
            <EsaButton variant="ai" size="md" data-draft-readback>Draft the measure</EsaButton>
            <EsaButton variant="ghost" size="md" data-back>Back</EsaButton>
          </div>
        </div>
      </div>
    </Firma2RailSection>
  </div>

  <!-- ===== DRAFTING ===== -->
  <div data-stage="drafting" hidden>
    <div class="cluster" data-gap="sm" role="status">
      <EsaLoadingSpinner size="sm" decorative />
      <p class="typography-body-md">Drafting your measure…</p>
    </div>
  </div>

  <!-- ===== THE DRAFT ===== -->
  <div class="stack" data-gap="2xl" data-stage="draft" hidden tabindex="-1">
    <Firma2RailSection title="What a reporter will say, every year">
      <div class="stack" data-gap="sm">
        <p class="firma2-measure-drafter__sentence typography-heading-md" data-sentence></p>
        <p class="typography-body-sm">From your claim: <q data-claim-echo></q></p>
      </div>
    </Firma2RailSection>

    <!-- THE BURDEN LEADS the reporter's section, and the section comes
         straight after the sentence: what a definition costs the people who
         file it is the first thing to weigh, before its own fields. -->
    <Firma2RailSection title="What reporters answer">
      <div class="stack" data-gap="lg">
        <Firma2ReporterBurden />
        <dl class="firma2-measure-drafter__rows" data-answers-def></dl>
        <div class="stack" data-gap="2xs">
          <p class="typography-label-md">What you can report</p>
          <p class="typography-body-md" data-payoff-line></p>
        </div>
      </div>
    </Firma2RailSection>

    <Firma2RailSection title="The measure">
      <dl class="firma2-measure-drafter__rows" data-definition></dl>
    </Firma2RailSection>

    <div data-warnings hidden>
      <EsaAlertBox variant="warning" title="Check these before you publish">
        <ul class="firma2-measure-drafter__warnings stack" data-gap="xs" data-warning-list></ul>
      </EsaAlertBox>
    </div>

    <div class="cluster" data-gap="sm">
      <EsaButton variant="primary" size="md" data-open-setup>Save as draft</EsaButton>
      <EsaButton variant="ghost" size="md" data-revise>Change the claim</EsaButton>
    </div>
  </div>

  <!-- Clone sources: real legos rendered once, copied by the script. -->
  <!-- One answer to the funder question: what it is, in two or three words
       first (the difference between answers leads), the sentence it commits
       to under it, and what it costs a reporter as a level. -->
  <template data-answer-template>
    <button type="button" class="firma2-measure-drafter__choice">
      <span class="stack" data-gap="3xs">
        <span class="typography-label-md-strong" data-choice-title></span>
        <span class="firma2-measure-drafter__choice-sentence typography-body-sm" data-choice-sentence></span>
      </span>
      <Firma2ReporterBurden compact />
    </button>
  </template>
  <!-- Where a split's list comes from. Quiet neutral tags: an origin is not a
       severity, and the word carries it (the measure page's schema markers). -->
  <template data-badge-shared><EsaPill label="Shared list" size="sm" removable={false} /></template>
  <template data-badge-system><EsaPill label="Filled in automatically" size="sm" removable={false} /></template>
  <template data-badge-new><EsaPill label="New list" size="sm" removable={false} /></template>
</div>

<style>
  /* Layout primitives set `display`, which beats the UA's [hidden]. Steps
     and blocks here toggle `hidden`, so it has to win inside this component. */
  .firma2-measure-drafter [hidden] {
    display: none !important;
  }

  /* bcn-lego-checked: an answer is a two-line choice with a burden level —
     esa-button carries one unwrapped label (the long sentences ran out of the
     column) and esa-radio-group selects on arrow keys, so it cannot advance
     the interview on a pick. Native button, bordered like the inputs above
     it, full width, wrapping. Beacon is not cloned on this machine. */
  .firma2-measure-drafter :global(.firma2-measure-drafter__choice) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-400, 1rem);
    inline-size: 100%;
    padding: var(--spacing-300, 0.75rem) var(--spacing-400, 1rem);
    border: 1px solid var(--color-border-default, #cecece);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--color-background-elevation-raised, #fcfcfc);
    color: var(--color-content-default, #202020);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .firma2-measure-drafter :global(.firma2-measure-drafter__choice:hover) {
    border-color: var(--color-border-brand, #46a758);
    background: var(--color-background-default-hover, #f0f0f0);
  }

  .firma2-measure-drafter :global(.firma2-measure-drafter__choice:focus-visible) {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, #3e9b4f);
    outline-offset: var(--focus-ring-offset, 2px);
  }

  .firma2-measure-drafter :global(.firma2-measure-drafter__choice-sentence) {
    color: var(--color-content-default-secondary, #646464);
  }

  /* The level never squeezes the words: it keeps its width and sits right. */
  .firma2-measure-drafter :global(.firma2-measure-drafter__choice .firma2-reporter-burden) {
    flex: none;
  }

  .firma2-measure-drafter__h {
    margin: 0;
  }

  .firma2-measure-drafter__transcript {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .firma2-measure-drafter__transcript :global(li) {
    padding-block-end: var(--spacing-200);
    border-block-end: 1px solid var(--color-border-default);
  }

  .firma2-measure-drafter__transcript:empty {
    display: none;
  }

  .firma2-measure-drafter__cost {
    color: var(--color-text-secondary);
  }

  /* The blank a reporter fills, set apart from the words around it. */
  .firma2-measure-drafter__sentence :global(.firma2-measure-drafter__blank) {
    padding-inline: var(--spacing-100);
    border-radius: var(--radius-sm);
    background: var(--color-background-elevation-sunken);
  }

  /* Definition rows: term and value side by side, one rhythm for every row. */
  .firma2-measure-drafter__rows {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) 1fr;
    gap: var(--spacing-200) var(--spacing-600);
    margin: 0;
  }

  .firma2-measure-drafter__rows :global(dt) {
    color: var(--color-text-secondary);
  }

  .firma2-measure-drafter__rows :global(dd) {
    margin: 0;
  }

  .firma2-measure-drafter__warnings {
    margin: 0;
    padding-inline-start: var(--spacing-600);
  }
</style>

<script>
  import '@esa/ecology/esa-textarea';
  import {
    claimFor,
    costOfSplit,
    draftFromClaim,
    FUNDER_QUESTION,
    funderAnswers,
    getActivity,
    payoff,
    reporterPicks,
    sentenceFor,
  } from '../../data/firma2-measure-drafting';
  import { paintBurden, reporterBurden } from '../../lib/reporter-burden';
  import type { DraftActivity, MeasureDraftResult } from '../../data/firma2-measure-drafting';
  import { COUNTING_RULES, getSchema, kindName } from '../../data/firma2-performance-measures';
  import { nextLocalMeasureSlug, writeDraft } from '../../lib/measure-draft';
  import { writeMeasureWarnings } from '../../lib/measure-notes';
  import { nextLocalSchemaId, writeLocalSchema } from '../../lib/schema-draft';

  type Field = HTMLElement & { value?: string; options?: unknown; errorText?: string };

  /** How long the stand-in "model" takes. Long enough to read as work, short enough to demo. */
  const DRAFT_DELAY_MS = 1400;

  const esc = (s: string): string =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  document.querySelectorAll<HTMLElement>('.firma2-measure-drafter').forEach((root) => {
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const stages = [...root.querySelectorAll<HTMLElement>('[data-stage]')];
    const show = (name: string) => stages.forEach((s) => (s.hidden = s.dataset.stage !== name));

    const claimField = $<Field>('[data-claim]');
    const noMatch = $('[data-no-match]');
    // The interview section's own heading: the goal of the work picked.
    const themeHeading = $('[data-interview] .firma2-rail-section__title');
    const transcript = $('[data-transcript]');
    const turn = $('[data-turn]');
    const question = $('[data-question]');
    const answers = $('[data-answers]');
    const cost = $('[data-cost]');
    const own = $('[data-own]');
    const ownText = $<Field>('[data-own-text]');
    const claimBlock = $('[data-claim-block]');
    const readback = $<Field>('[data-claim-readback]');
    const answerTemplate = $<HTMLTemplateElement>('[data-answer-template]');

    // ARRIVING. "New measure" in the catalog links straight here (its
    // "How would you like to start?" dialog went 2026-10-08 — this page
    // already offers both doors), so the cursor starts in the claim, the
    // first field, as every settings add page starts in its first.
    customElements.whenDefined('esa-textarea').then(() =>
      requestAnimationFrame(() => (claimField.shadowRoot?.querySelector<HTMLElement>('textarea') ?? claimField).focus()),
    );

    // ---- interview state ----------------------------------------------------
    let theme = '';
    let activity: DraftActivity | undefined;
    let draft: MeasureDraftResult | undefined;
    /** Where "Change the claim" returns to. */
    let cameFrom: 'start' | 'interview' = 'start';

    const addTranscript = (q: string, a: string) => {
      const li = document.createElement('li');
      li.innerHTML = `<p class="typography-body-sm">${esc(q)}</p><p class="typography-body-md">${esc(a)}</p>`;
      transcript.append(li);
    };

    type Choice = { title: string; sentence: string; picks: number; pick: () => void };

    const answerButton = (choice: Choice): HTMLElement => {
      const node = answerTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
      node.querySelector('[data-choice-title]')!.textContent = choice.title;
      node.querySelector('[data-choice-sentence]')!.textContent = choice.sentence;
      paintBurden(node.querySelector<HTMLElement>('[data-reporter-burden]'), reporterBurden(choice.picks));
      node.addEventListener('click', choice.pick);
      return node;
    };

    const ask = (text: string, options: Choice[], costLine?: string) => {
      turn.hidden = false;
      claimBlock.hidden = true;
      own.hidden = true;
      ownText.value = '';
      question.textContent = text;
      answers.replaceChildren(...options.map(answerButton));
      cost.hidden = !costLine;
      cost.textContent = costLine ?? '';
      requestAnimationFrame(() => answers.querySelector('button')?.focus());
    };

    /** The cost question. Skipped when the work has no split to price. */
    const askFunder = () => {
      if (!activity) return;
      const choices = funderAnswers(activity);
      if (choices.length === 1) return readBack(false);
      const work = activity;
      ask(
        FUNDER_QUESTION,
        choices.map((c) => ({
          // The difference leads: "One total" or "Split by barrier type".
          title: c.split && work.split ? `Split by ${work.split.label}` : 'One total',
          sentence: c.label,
          // A split the system fills in costs the reporter nothing.
          picks: c.split && work.split && work.split.source !== 'system' ? 1 : 0,
          pick: () => {
            addTranscript(FUNDER_QUESTION, c.label);
            readBack(c.split);
          },
        })),
        costOfSplit(activity),
      );
    };

    const readBack = (split: boolean) => {
      if (!activity) return;
      turn.hidden = true;
      claimBlock.hidden = false;
      readback.value = claimFor(activity, split);
      requestAnimationFrame(() => readback.focus());
    };

    // A row in the work list names the goal and the work at once, so the
    // interview opens on the funder question with the work already answered.
    root.addEventListener('firma2:work-pick', (event) => {
      const picked = getActivity((event as CustomEvent<{ id: string }>).detail.id);
      if (!picked) return;
      theme = picked.theme;
      transcript.replaceChildren();
      themeHeading.textContent = theme;
      show('interview');
      // The work was picked from the list, not asked — so the transcript
      // names it as what it is, not as an answer to a question.
      addTranscript('The work', picked.activity);
      activity = picked;
      askFunder();
    });

    $('[data-own-toggle]').addEventListener('click', () => {
      own.hidden = false;
      requestAnimationFrame(() => ownText.focus());
    });

    // Typed instead of clicked: on the funder question it IS the claim, in
    // the author's words, so it goes straight to the read-back.
    $('[data-own-continue]').addEventListener('click', () => {
      const text = String(ownText.value ?? '').trim();
      if (!text) return;
      {
        addTranscript(FUNDER_QUESTION, text);
        turn.hidden = true;
        claimBlock.hidden = false;
        readback.value = `I need to tell my funder ${text.replace(/^i need to tell (my|our) funder\s*/i, '')}`;
      }
    });

    // Back undoes the last answer. A measure with nothing to split skipped the
    // funder question, so its last answer was the work itself.
    $('[data-back]').addEventListener('click', () => {
      transcript.lastElementChild?.remove();
      if (activity && funderAnswers(activity).length > 1) {
        askFunder();
      } else {
        // The work was the first answer; it was picked from the list.
        activity = undefined;
        show('start');
      }
    });

    $('[data-restart]').addEventListener('click', () => {
      show('start');
    });

    // ---- drafting ------------------------------------------------------------
    const runDraft = (claim: string, known?: DraftActivity) => {
      const outcome = draftFromClaim(claim, known);
      if (!outcome.ok) {
        noMatch.hidden = false;
        return;
      }
      noMatch.hidden = true;
      draft = outcome.draft;
      show('drafting');
      window.setTimeout(() => {
        paintDraft(outcome.draft);
        show('draft');
        $('[data-stage="draft"]').focus();
      }, DRAFT_DELAY_MS);
    };

    $('[data-draft-claim]').addEventListener('click', () => {
      const claim = String(claimField.value ?? '').trim();
      if (!claim) {
        claimField.errorText = 'Write your claim first, or pick the work below.';
        return;
      }
      claimField.errorText = '';
      cameFrom = 'start';
      runDraft(claim);
    });

    $('[data-draft-readback]').addEventListener('click', () => {
      const claim = String(readback.value ?? '').trim();
      if (!claim) return;
      cameFrom = 'interview';
      runDraft(claim, activity);
    });

    $('[data-revise]').addEventListener('click', () => show(cameFrom));

    // ---- the review --------------------------------------------------------------
    const row = (term: string, valueHtml: string) => `<dt>${esc(term)}</dt><dd>${valueHtml}</dd>`;
    const badge = (kind: 'shared' | 'system' | 'new') =>
      ($<HTMLTemplateElement>(`[data-badge-${kind}]`).innerHTML ?? '').trim();

    const paintDraft = (d: MeasureDraftResult) => {
      const a = d.activity;
      $('[data-sentence]').innerHTML = esc(sentenceFor(d)).replace(
        '[N]',
        '<span class="firma2-measure-drafter__blank">N</span>',
      );
      $('[data-claim-echo]').textContent = d.claim;

      const rule = COUNTING_RULES.find((r) => r.id === a.countingRule);
      $('[data-definition]').innerHTML = [
        row('Name', esc(a.name)),
        row('Type', esc(kindName(a.kind))),
        row('Unit', a.unit ? esc(a.unit) : '<em>Not set — see below</em>'),
        row('Counting rule', esc(rule?.name ?? '')),
        row('Definition', esc(a.definition)),
        row('Reporter guidance', esc(a.reporterGuidance)),
      ].join('');

      // "each" is a count, not a unit to name: "One count per entry".
      const number = !a.unit ? 'One figure per entry' : a.unit === 'each' ? 'One count per entry' : `One figure per entry, in ${a.unit}`;
      const rows = [row('The number', esc(number))];
      if (d.split && a.split) {
        const s = a.split;
        const name = s.source === 'new' ? s.name : getSchema(s.schemaId)?.name ?? '';
        const options = s.source === 'new' ? s.options : getSchema(s.schemaId)?.options ?? [];
        rows.push(
          row(
            name,
            `<div class="stack" data-gap="2xs"><div>${badge(s.source)}</div><span>${esc(options.join(' · '))}</span></div>`,
          ),
        );
      }
      const autos = a.automatic.map((id) => getSchema(id)?.name).filter(Boolean) as string[];
      if (autos.length) rows.push(row('Filled in automatically', esc(autos.join(', '))));
      $('[data-answers-def]').innerHTML = rows.join('');

      // Scoped to the draft stage: each funder-question choice carries a
      // compact burden of its own, earlier in the DOM.
      paintBurden(root.querySelector<HTMLElement>('[data-stage="draft"] [data-reporter-burden]'), reporterBurden(reporterPicks(d)));
      $('[data-payoff-line]').textContent = payoff(d);

      $('[data-warnings]').hidden = d.warnings.length === 0;
      $('[data-warning-list]').innerHTML = d.warnings.map((w) => `<li>${esc(w)}</li>`).join('');
    };

    // ---- hand-off ------------------------------------------------------------------
    // The draft becomes an ordinary browser-local Draft in the catalog, and its
    // own page opens on it. A NEW split list is written to the
    // shared-list store first, so the measure references it rather than
    // carrying a private copy — the same rule every other list follows.
    $('[data-open-setup]').addEventListener('click', () => {
      if (!draft) return;
      const a = draft.activity;
      const schemaIds: string[] = [];
      if (draft.split && a.split) {
        if (a.split.source === 'new') {
          const id = nextLocalSchemaId(a.split.name);
          writeLocalSchema({ id, name: a.split.name, origin: 'user', options: a.split.options });
          schemaIds.push(id);
        } else {
          schemaIds.push(a.split.schemaId);
        }
      }
      a.automatic.forEach((id) => {
        if (!schemaIds.includes(id)) schemaIds.push(id);
      });

      const slug = nextLocalMeasureSlug();
      writeDraft(slug, {
        kind: a.kind,
        name: a.name,
        definition: a.definition,
        classifications: [a.theme],
        unit: a.unit,
        decimalPlaces: a.decimalPlaces,
        countingRule: a.countingRule,
        subcategorySchemaIds: schemaIds,
        reporterGuidance: a.reporterGuidance,
        status: 'Draft',
      });
      // The warnings travel with the draft, to the page where publishing is decided.
      writeMeasureWarnings(slug, draft.warnings);
      window.location.assign(`${root.dataset.draftHref}?slug=${encodeURIComponent(slug)}`);
    });
  });
</script>
