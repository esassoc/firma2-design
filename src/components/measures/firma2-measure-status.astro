---
// firma2-measure-status — a performance measure's state, for the page
// header's `status` slot: the Draft / Published / Retired pill under the title,
// and one line beside it saying what that state means for this measure —
// what is still needed to publish, or how much has been filed.
//
// IN THE HEADER, LIKE EVERY RECORD'S STATE (2026-10-08). It was a Status
// section in the page body, with its buttons; the project page puts Stage
// here and the page header documents the slot for exactly this. Its act —
// Publish, Retire, Reactivate — is firma2-measure-actions, in `actions`.
//
// Painted by firma2-measure-editor, which owns the record. The server render
// is the seeded status, so a seed never flashes the wrong pill.
//
// bcn-lego-checked: the pill is esa-pill in the catalog's status tones (the
// list's Status column speaks the same). Beacon is not cloned on this machine.
import EsaPill from '@esa/ecology/esa-pill.astro';
import { MEASURE_STATUS_TONE } from '../../data/firma2-performance-measures';
import type { MeasureStatus } from '../../data/firma2-performance-measures';

interface Props {
  /** The status known at build time; a draft route starts at Draft. */
  status?: MeasureStatus;
}

const { status = 'Draft' } = Astro.props;
const STATUSES = Object.keys(MEASURE_STATUS_TONE) as MeasureStatus[];
---
<span class="firma2-measure-status cluster" data-gap="sm" data-measure-status>
  <!-- Named for a screen reader, which meets the pill without the position
       that tells a sighted reader what it is — the project page's Stage. -->
  <span class="visually-hidden">Status</span>
  {STATUSES.map((s) => (
    <span class="firma2-measure-status__pill" data-status-pill={s} hidden={s !== status}>
      <EsaPill label={s} variant={MEASURE_STATUS_TONE[s]} size="md" removable={false} />
    </span>
  ))}
  <span class="firma2-measure-status__note typography-body-sm" id="measure-status-note" data-status-note></span>
</span>

<style>
  .firma2-measure-status__pill {
    line-height: 0;
  }

  .firma2-measure-status__note {
    color: var(--color-content-default-secondary, #646464);
  }

  .firma2-measure-status [hidden] {
    display: none !important;
  }
</style>
