---
// firma2-measure-portfolio — the top of one performance measure's reading
// page: what it counts and the portfolio's figures. The sections under it —
// by year, by classification, where, projects, how it is reported — are their
// own components (the page's manifest). The measure-shaped twin of
// firma2-classification-summary: same esa-stat figures.
//
// WHAT IT COUNTS COMES FIRST: the definition, as the classification page
// leads with its description. A reader sent here by a funder needs to know
// what an acre "restored" means before the number means anything.
//
// THE FIGURES FOLLOW THE COUNTING RULE ([[measure-counting-rule-framing]]): a
// measure that sums shows a total against what projects planned; one that
// does not shows the average of the latest readings and never a total.
//
// THE LAST YEAR'S FILING IS A FIGURE, because it says whether the total is
// whole: "9 of 11 filed for 2025" before anyone quotes the number. Counted
// from the same per-year arithmetic as the chart (src/lib/measure-reading).
//
// THE CLAIM IS NOT SHOWN. It is the author's sentence in their own voice
// ("I need to tell my funder…") — guidance for whoever defines the measure,
// wrong in front of the funder it is about.
//
// bcn-lego-checked: esa-stat for the figures, esa-alert-box for the retired
// note, the hub .grid primitive. CSS is layout and ink only. Beacon is not
// cloned on this machine.
import EsaStat from '@esa/ecology/esa-stat.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import type { PerformanceMeasureDefinition } from '../../data/firma2-performance-measures';
import { measurePortfolio } from '../../data/firma2-classification-rollup';
import { projects as portfolio } from '../../data/firma2-projects';
import { LAST_CLOSED_YEAR } from '../../data/firma2-organization-pages';
import { measureByYear } from '../../lib/measure-reading';

interface Props {
  measure: PerformanceMeasureDefinition;
}

const { measure } = Astro.props;
const progress = measurePortfolio(measure);
const unit = progress.unit;
const fmt = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: measure.decimalPlaces });
const withUnit = (n: number) => (unit === 'percent' ? `${fmt(n)}%` : unit === 'each' || !unit ? fmt(n) : `${fmt(n)} ${unit}`);
const count = progress.contributions.length;
const lastYear = measureByYear(progress).find((y) => y.year === LAST_CLOSED_YEAR);

const reportedStat = progress.additive
  ? { value: progress.reported == null ? '—' : withUnit(progress.reported), label: 'Reported', sub: progress.committed ? `of ${withUnit(progress.committed)} planned` : 'No project has set a target' }
  : { value: progress.reported == null ? '—' : withUnit(progress.reported), label: 'Average latest reading', sub: 'These values do not add up, so there is no total' };

const filingStat = lastYear && lastYear.owed > 0
  ? {
      value: `${lastYear.filed} of ${lastYear.owed}`,
      label: `Filed for ${LAST_CLOSED_YEAR}`,
      sub: lastYear.filed === lastYear.owed ? 'Every project filed' : `${lastYear.owed - lastYear.filed} still missing`,
    }
  : { value: 'None due', label: `Filed for ${LAST_CLOSED_YEAR}`, sub: undefined };
---
<div class="firma2-measure-portfolio stack" data-gap="lg" data-measure-slug={measure.slug}>
  <!-- A RETIRED MEASURE says so before its figures (user, 2026-10-09):
       they are history, not progress still being made. Shown by the build
       for a seeded retired measure, and by the script for one retired in
       this browser. -->
  <div data-retired-note hidden={measure.status !== 'Retired'}>
    <EsaAlertBox variant="info" title="Retired">This measure takes no new figures. What projects reported before it was retired is below.</EsaAlertBox>
  </div>
  {measure.definition && <p class="firma2-measure-portfolio__lede typography-body-lg">{measure.definition}</p>}
  <div class="firma2-measure-portfolio__figures grid" data-gap="md">
    <EsaStat value={reportedStat.value} label={reportedStat.label} sub={reportedStat.sub} />
    <EsaStat value={count} label="Projects" sub={`of ${portfolio.length} in the portfolio`} />
    <EsaStat value={filingStat.value} label={filingStat.label} sub={filingStat.sub} />
  </div>
</div>

<script>
  import { withDraft } from '../../lib/measure-draft';

  document.querySelectorAll<HTMLElement>('.firma2-measure-portfolio[data-measure-slug]').forEach((root) => {
    const note = root.querySelector<HTMLElement>('[data-retired-note]');
    if (note) note.hidden = withDraft(root.dataset.measureSlug!).status !== 'Retired';
  });
</script>

<style>
  .firma2-measure-portfolio [data-retired-note][hidden] {
    display: none;
  }

  .firma2-measure-portfolio__lede {
    margin: 0;
  }

  .firma2-measure-portfolio__figures {
    --grid-min: 13rem;
  }
</style>
