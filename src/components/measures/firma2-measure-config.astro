---
// firma2-measure-config — the CONFIGURATION RAIL of the performance-measure
// setup screen. The centre of that screen is a live preview of the measure as a
// reporter will meet it; this is the dense, scannable definition sitting beside
// it, and the two are read together.
//
// WHY THIS REPLACED FOUR FORM CARDS. The first design of this screen was four
// stacked cards — Identity, Measurement, Subcategories, Reporting — each a full
// form section with its own header, its own Save, and its own column of labelled
// inputs. It worked and it was wrong for the job. Four cards is roughly two and a
// half screens of scrolling, so the preview and the setting that changes it were
// never visible at the same time; and an input renders the same whether it holds
// an answer or nothing, so a measure eight-tenths finished looked exactly like a
// measure not started. The rail inverts both: every ANSWERED setting collapses to
// one line reading `label · value`, so the whole definition fits beside the
// preview, and an unanswered one is the only thing on its line that is not a
// value. You read the record, not the form.
//
// TOP TO BOTTOM, and every position is load-bearing:
//   1. DATA TYPE, distinct and first. It is the one question creating a measure
//      asks, so it is answered before this screen exists — and it decides whether
//      a UNIT even applies. Steep keeps the equivalent visible and changeable at
//      the top rather than burying it in a form; so does this. The Unit row below
//      appears and disappears from it, live.
//   2. The outstanding COUNT. One line, no list — see the note on it below.
//   3. The measure NAME, bare. No card, no second caption: the field's own label
//      is the caption, which is also the only thing a screen reader can use.
//   4. SETTING ROWS, one per line, each collapsing to `icon · label · value`.
//   5. SUBCATEGORIES, a repeating structure with its own add affordance.
//   6. PROSE, at the bottom, as real textareas. Definition and Reporter guidance
//      run to two or three sentences of authored English; squeezing those into a
//      one-line row that expands to a box would be denser and worse, because the
//      collapsed line could never show the value the way every row above it does.
//      Steep handles its Description the same way, and it is the reason the rail
//      is not uniformly chip-like.
//
// COMPOSED, NOT BUILT. Nothing here is a hand-rolled control. The row atom is
// firma2-config-row (a sibling in setup/), the repeating structure is
// firma2-option-repeater, and every value-collecting control is a Lit lego —
// esa-select, esa-text-field, esa-textarea, esa-switch-toggle — registered in the
// client script below and used as a custom element. The only CSS this file owns
// is the top band's fill and the spine's rhythm.
//
// EVERY LABEL IS A LOAD-BEARING STRING, not a copy choice. outstandingFields() in
// the data module reports what a measure still needs by these exact words —
// "Measure name", "Definition", "Program", "Unit", "Aggregation", "Reporting
// frequency", "Reporter guidance". A reader told "Reporter guidance" is missing
// must not have to work out which of these fields that is. Change one here
// without changing it there and the count at the top starts pointing at nothing.
//
// EVERY VOCABULARY IS IMPORTED. DATA_TYPES, AGGREGATIONS, REPORTING_FREQUENCIES,
// PROGRAMS and UNIT_SUGGESTIONS come from the data module and are never retyped.
// Retyping "Most recent" as "Latest" would not fail a build — it would quietly
// produce a measure the index table renders blank.
//
// SHADOW DOM IS WHY EVERY LABEL SITS ON ITS CONTROL. The Lit controls render into
// shadow DOM and carry their own label / help-text / required. A <label> outside a
// shadow root can never be associated with the input inside it, so nothing here is
// wrapped in esa-form-field and no row's chrome supplies a control's name — the
// row owns the collapsed line, the control owns its own field chrome.
// (Hub pattern: ecology/apps/site/src/pages/patterns/form-section.astro,
// "Composition notes".)
//
// ONE CONTROL SIZE: md, everywhere, no exceptions. The rail is dense and the
// density comes entirely from the ROW CHROME — a collapsed row is one line
// regardless of how tall the control it hides is. Shrinking the controls to sm
// would buy nothing (they are only ever visible one at a time, expanded) and cost
// the thing sm always costs. No two controls share a line anywhere in this file,
// which is also why none of them needs AppLayout's height-matching shim.
import Firma2ConfigRow from '../setup/firma2-config-row.astro';
import Firma2OptionRepeater from '../setup/firma2-option-repeater.astro';
import type { PerformanceMeasureDefinition } from '../../data/firma2-performance-measures';
import {
  UNIT_SUGGESTIONS,
  measureDisplayName,
  outstandingFields,
} from '../../data/firma2-performance-measures';

interface Props {
  /** The measure being configured. Every field on it may be empty or unset. */
  measure: PerformanceMeasureDefinition;
}

const { measure } = Astro.props;

// THE ONE FIELD THAT IS ALWAYS ALREADY ANSWERED, and the reason it sits above
// everything else: creating a measure asks for its data type and nothing else, so
// `dataType` is populated on every record in the catalog — including the untitled
// draft — and outstandingFields() never reports it missing. It is also what
// decides whether a unit applies at all.
const unitApplies = measure.dataType === 'Number';

// Units already in the catalog, named as EXAMPLES rather than offered as a closed
// list. The data module is explicit about why: a new measure may legitimately need
// a unit no existing measure uses, and routing that through an admin request is the
// friction people work around by picking a wrong unit that is already there. Three,
// not all of them — a hint that lists a catalog stops being a hint — sliced from the
// sorted source so the string is deterministic and grows on its own.
const unitExamples = UNIT_SUGGESTIONS.slice(0, 3).join(', ');

// Both halves of the Unit field's help text, rendered as data attributes so the
// SERVER picks the initial one and the client script swaps between the same two
// strings. The alternative — the script holding its own copies — is two places to
// edit one sentence, and the copy that drifts is always the one nobody sees until
// a reviewer changes the data type.
const unitHelpApplies = `Lowercase plural, like ${unitExamples}. Any unit is accepted.`;
const unitHelpNotApplicable = 'Percent and currency carry their own unit.';

// THE COUNT, AND WHY THERE IS NO LIST UNDER IT.
//
// The four-card design carried a separate readiness card that named every
// outstanding field. In this rail that card would be the same fact printed twice:
// an unset setting is already the only row on the screen showing an affordance
// where its neighbours show a value, and the two empty textareas at the bottom are
// visibly empty. The rows ARE the checklist. So the summary is a single line, and
// it sits directly above the first thing it counts so a reader never has to guess
// what "3" is 3 of.
const outstanding = outstandingFields(measure).length;
const outstandingLine =
  outstanding === 0
    ? 'Ready to publish'
    : `${outstanding} setting${outstanding === 1 ? '' : 's'} needed before publishing`;
---

<!-- A region with a name, but no VISIBLE title. On a two-column setup screen the
     page header already names the measure, and a rail captioned "Measure
     settings" beside a preview would be a label on something a reader can see the
     whole of — the text-about-the-page the house style cuts. The name still has to
     exist for a screen reader choosing between the preview and the rail, so it is
     a visually-hidden heading rather than an aria-label: a heading also lands in
     the rotor's heading list, which is how anyone actually navigates a long page,
     and it gives "Subcategories" below a level to hang off.

     It is built from measureDisplayName() rather than `measure.name` so an unnamed
     draft announces "Settings for Untitled measure" instead of "Settings for" —
     the same fallback string the record's other surfaces use. -->
<section class="firma2-measure-config stack" data-gap="md" aria-labelledby="fmc-region-name">
  <h2 id="fmc-region-name" class="visually-hidden">Settings for {measureDisplayName(measure)}</h2>

  <!-- 1 · DATA TYPE.
       Distinct by SURFACE, not by colour: one step down the neutral elevation ramp,
       which lifts the white field box sitting on it forward without tinting anything
       brand. (Steep tints the equivalent block; the house rule is that containers
       stay neutral, so this takes the value layer and leaves the hue alone.)
       esa-select's trigger is already a button with a chevron, so the affordance
       Steep draws by hand comes free from the lego. -->
  <div class="firma2-measure-config__type">
    <esa-select
      id="fmc-data-type"
      label="Data type"
      required
      size="md"
      data-initial={measure.dataType}
      help-text="Number takes a unit; percent and currency carry their own."></esa-select>
  </div>

  <!-- 2 · THE COUNT. Deliberately unadorned — no container, no icon, no colour.
       A measure mid-setup is a draft, not a fault, and an alert box or a warning
       tint at the top of the rail would report a problem where there is only
       unfinished work. `label-md` gives it a shade more weight than the rows
       beneath it and keeps it at the dense floor at full width; the content
       colour is the darkest one, because small text earns legibility by getting
       darker, never by getting louder. -->
  <p class="firma2-measure-config__outstanding typography-label-md">{outstandingLine}</p>

  <!-- 3 · NAME. Bare: no row chrome, no wrapper, no second caption. The field's own
       `label` IS the small caption above the box — one string, rendered inside the
       shadow root where it is actually associated with the input.

       It stays size="md" like everything else. Prominence here comes from position
       and from being the only unwrapped control in the rail, not from inflating one
       field's type past the scale every other control is on. -->
  <esa-text-field
    id="fmc-name"
    label="Measure name"
    required
    size="md"
    value={measure.name}
    placeholder="e.g. Acres of riparian habitat restored"></esa-text-field>

  <!-- 4 · THE SETTING ROWS.
       Order mirrors outstandingFields() exactly — Program, Unit, Aggregation,
       Reporting frequency — so the count above and the rows below are read in the
       same sequence, and someone working down the rail finishes the record in the
       order the readiness check evaluates it. Decimal places sits with Unit because
       both describe the shape of one reported value; the required flag closes the
       group because it is about the reporting rule the two lines above it set up.

       Rhythm only. Every row's chrome — its icon, its label, its value, its
       disclosure — belongs to firma2-config-row; this file sets the space between
       rows and nothing else, so a change to the row atom lands in one place.

       No row is `open`. The collapsed line is the whole point: opening the unset
       ones on load would re-create the column of empty inputs the rail exists to
       get rid of, and the affordance on an unset row already says where to click.

       ICON CHOICES ARE APPROXIMATE ON TWO ROWS, honestly. The shared registry
       (@esa/ecology icon-registry) ships no `ruler`, `hash`, `percent` or `sigma`,
       which are the four glyphs this rail actually wants. `folder`, `calendar`,
       `trending-up` and `circle-check` are exact; `activity` for Unit and `expand`
       for Decimal places are the nearest available and are filed as a gap. -->
  <div class="firma2-measure-config__rows stack" data-gap="xs">
    <!-- PROGRAM. The taxonomy branch the measure rolls up into. The options are the
         programs actually present in the portfolio — PROGRAMS is derived from the
         project data, never retyped — so the help line states that constraint
         rather than restating the label. -->
    <Firma2ConfigRow icon="folder" label="Program" value={measure.program ?? ''} id="measure-program">
      <esa-select
        id="fmc-program"
        label="Program"
        required
        size="md"
        placeholder="Select a program"
        data-initial={measure.program ?? ''}
        help-text="Only programs that already carry projects."></esa-select>
    </Firma2ConfigRow>

    <!-- UNIT — PRESENT ONLY FOR NUMBER, and that is the whole reason data type sits
         at the top of this rail.
         The data model leaves `unit` empty for Percent and Currency because both
         carry their own, and outstandingFields() demands a unit for Number alone. A
         rail that showed a disabled Unit row on a percent measure would be spending
         a line on a setting that does not exist for this record; removing the row
         says "does not apply" with no dead chrome at all, which is the honest
         version of the greyed-out box the four-card design used.

         The wrapper exists purely to give the script something to hide — a config
         row is a component, and `hidden` needs an element this file owns. `hidden`
         is `display: none`, so a hidden row contributes no gap to the stack. -->
    <div id="fmc-unit-row" hidden={!unitApplies}>
      <Firma2ConfigRow icon="activity" label="Unit" value={measure.unit} id="measure-unit">
        <esa-text-field
          id="fmc-unit"
          label="Unit"
          required
          size="md"
          value={measure.unit}
          placeholder="e.g. acres"
          data-help-applies={unitHelpApplies}
          data-help-na={unitHelpNotApplicable}
          help-text={unitApplies ? unitHelpApplies : unitHelpNotApplicable}></esa-text-field>
      </Firma2ConfigRow>
    </div>

    <!-- DECIMAL PLACES. Not in outstandingFields() and not `required`: 0 is a real,
         complete answer and every record carries one, so this row always shows a
         value and never shows an unset affordance. -->
    <Firma2ConfigRow
      icon="expand"
      label="Decimal places"
      value={String(measure.decimalPlaces)}
      id="measure-decimals"
    >
      <esa-select
        id="fmc-decimals"
        label="Decimal places"
        size="md"
        placeholder="Select 0 to 3"
        data-initial={String(measure.decimalPlaces)}
        help-text="Rounds every reported value to this precision."></esa-select>
    </Firma2ConfigRow>

    <!-- AGGREGATION. The term is kept, not plain-washed — it is the word the data
         model, the index table and program staff all use, and a vaguer synonym
         would cost the fluent reader accuracy while helping nobody. The help line
         is what serves the occasional reader: it decodes the word into the decision
         being made instead of restating it.

         `aggregation` is optional on the record and undefined on a fresh draft, so
         this renders unset rather than pre-picking Sum. A guessed default here is a
         wrong program total nobody chose. -->
    <Firma2ConfigRow
      icon="trending-up"
      label="Aggregation"
      value={measure.aggregation ?? ''}
      id="measure-aggregation"
    >
      <esa-select
        id="fmc-aggregation"
        label="Aggregation"
        required
        size="md"
        placeholder="Select an aggregation"
        data-initial={measure.aggregation ?? ''}
        help-text="How project values combine into one program total."></esa-select>
    </Firma2ConfigRow>

    <!-- REPORTING FREQUENCY. A select rather than a radio group, and that is a rail
         decision rather than a house one: three radios stack to three lines and a
         legend inside a disclosure that is open one at a time, where a select is one
         line showing the same answer. The hub pattern's radio group is right on a
         full-width form; this column is 20rem.

         No help text. The three options — Annually, Quarterly, On completion — say
         what they mean, and a help line here could only restate the label, which is
         the one thing help text is not for. -->
    <Firma2ConfigRow
      icon="calendar"
      label="Reporting frequency"
      value={measure.reportingFrequency ?? ''}
      id="measure-frequency"
    >
      <esa-select
        id="fmc-frequency"
        label="Reporting frequency"
        required
        size="md"
        placeholder="Select a frequency"
        data-initial={measure.reportingFrequency ?? ''}></esa-select>
    </Firma2ConfigRow>

    <!-- THE REPORTING RULE. `required` is a boolean, so this row is never unset and
         never shows the affordance — Yes / No is always a complete answer, which is
         also why outstandingFields() leaves it out.

         The row label is "Required reporting" and not "Reporting requirement"
         because "Reporting frequency" is the line directly above it: two rows whose
         first word is identical are two rows a reader has to finish before telling
         apart. The SWITCH carries the full statement instead, in the form a switch
         label has to take — a sentence that is true when it is on. "Required" alone
         on the switch would leave the reader to guess required for what. -->
    <Firma2ConfigRow
      icon="circle-check"
      label="Required reporting"
      value={measure.required ? 'Yes' : 'No'}
      id="measure-required"
    >
      <esa-switch-toggle
        id="fmc-required"
        size="md"
        label="Projects must report this to close a period"
        checked={measure.required}></esa-switch-toggle>
    </Firma2ConfigRow>
  </div>

  <!-- 5 · SUBCATEGORIES. The repeater owns the whole section body: the rows, the
       add affordance, and the vacancy state when there are none. A measure with no
       subcategories is reported as a single number, which is a complete and common
       answer rather than a gap — outstandingFields() deliberately never asks for
       one — so nothing here marks an empty list as unfinished.

       `rows` is the REAL record. No seeded example row: this renders a measure that
       exists, and inventing a "Habitat type" row the author did not create would be
       data they then have to delete.

       The heading is the one visible section title in the rail, because a repeating
       structure is the one thing whose boundaries a reader cannot infer from a
       single line. `label-md-strong` rather than a title composite — it names a
       group of controls inside a rail, not a section of a document. -->
  <div class="firma2-measure-config__group stack" data-gap="sm">
    <h3 class="typography-label-md-strong">Subcategories</h3>
    <Firma2OptionRepeater
      itemNoun="subcategory"
      nameLabel="Subcategory name"
      optionsLabel="Options"
      rows={measure.subcategories}
    />
  </div>

  <!-- 6 · THE PROSE, at the bottom, as real textareas.
       These are the two fields on the record that hold authored English — the
       catalog's ten examples run two to three sentences each. A row that collapses
       to `label · value` cannot show a paragraph, so collapsing these would give a
       line that says "Definition" and nothing else: strictly less than the rail
       shows for every setting above. Open boxes are the honest form, and putting
       them last keeps the scannable part of the rail scannable.

       Four rows: the median example in the catalog lands just inside it at this
       column width, so the common case needs no scrolling and no resize.

       Not wrapped in a group. They are the last two children of the spine and the
       gap around them is the spine's own — a wrapper would add a boundary where
       there is nothing to bound. -->
  <esa-textarea
    id="fmc-definition"
    label="Definition"
    required
    size="md"
    rows="4"
    value={measure.definition}
    help-text="What counts toward this measure, and what does not."></esa-textarea>

  <esa-textarea
    id="fmc-guidance"
    label="Reporter guidance"
    required
    size="md"
    rows="4"
    value={measure.reporterGuidance}
    help-text="Shown beside the value box when a project reports."></esa-textarea>
</section>

<style>
  /* NO max-inline-size. This component IS the rail — the column it sits in sets its
     width (the page composes it with the .sidebar primitive), and a measure cap here
     would leave it stranded short of its own column's edge on a wide screen. That is
     the opposite of the form sections, which are prose-width blocks in an open page
     and cap themselves at --form-section-measure. */

  /* The data-type block. One step DOWN the neutral elevation ramp rather than a
     tint: the sunken surface is the house's value-layered off-white, and it lifts
     the field box sitting on it forward without introducing a colour. The radius is
     the same step esa-card uses, so the one filled block in the rail agrees with
     every other filled block on the screen. */
  .firma2-measure-config__type {
    padding: var(--spacing-300, 0.75rem);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--color-background-elevation-sunken, #f5f5f5);
  }

  /* The typography composites set type ONLY — family, size, weight, line-height —
     and nothing in tokens.css or BaseLayout resets heading or paragraph margins. So
     the UA's own `margin: 1em 0` is still on this <p> and this <h3>, and inside a
     .stack it adds to the primitive's gap. Zeroing it is not a visual choice; it is
     the composite's missing half — the spine owns spacing. */
  .firma2-measure-config__outstanding,
  .firma2-measure-config__group > h3 {
    margin: 0;
  }

  /* Small text earns legibility by getting DARKER, never by getting quieter: this
     line is the densest type in the rail, so it takes the strongest content colour
     rather than the secondary one a summary line would normally get. */
  .firma2-measure-config__outstanding {
    color: var(--color-content-default, #171717);
  }

  /* Rhythm between rows, and deliberately nothing else — no dividers, no padding,
     no hover. firma2-config-row owns every pixel of its own chrome, and a border
     drawn from out here would either double its divider or fight it. One step is
     enough to read as a list at this density in either case. */
</style>

<script>
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-textarea';
  import '@esa/ecology/esa-switch-toggle';

  import {
    DATA_TYPES,
    AGGREGATIONS,
    REPORTING_FREQUENCIES,
    PROGRAMS,
  } from '../../data/firma2-performance-measures';

  // Decimal places is the one vocabulary with no home in the data module, because
  // it is not a vocabulary — it is a range. 0 through 3 covers every measure in the
  // catalog (whole barriers through two-decimal stream miles) with one step of
  // headroom. Same four values firma2-measure-measurement offers.
  const DECIMAL_PLACES = ['0', '1', '2', '3'];

  /**
   * The catalog stores display strings; the form submits slugs. One mapping, here,
   * matching the other measure sections' so a value produced by the create drawer,
   * by the setup page and by this rail are the same string.
   */
  const slug = (label: string) =>
    label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

  const toOptions = (values: readonly string[]) =>
    values.map((label) => ({ label, value: slug(label) }));

  /**
   * `options` is a PROPERTY on esa-select, not an attribute — an array cannot
   * survive the trip through markup. whenDefined is what guarantees the class
   * exists: assign before the element upgrades and the value lands on a plain
   * HTMLElement, where Lit's setter never sees it and the control renders empty.
   *
   * `value` is set AFTER `options`, and only from a data attribute, for two
   * reasons: esa-select resolves its trigger label by looking the value up in the
   * option list, and esa-select's `value` is a bare accessor with no declarative
   * attribute behind it, so a preselected value has no way to reach the element
   * except this assignment. (That missing attribute is a known hub gap, called out
   * in the hub's own form-section pattern.)
   */
  const hydrate = (id: string, values: readonly string[]) => {
    const el = document.getElementById(id) as (HTMLElement & { options: unknown; value: unknown }) | null;
    if (!el) return;
    el.options = toOptions(values);
    const initial = el.dataset.initial;
    if (initial) el.value = slug(initial);
  };

  Promise.all([
    customElements.whenDefined('esa-select'),
    customElements.whenDefined('esa-text-field'),
  ]).then(() => {
    hydrate('fmc-data-type', DATA_TYPES);
    hydrate('fmc-program', PROGRAMS);
    hydrate('fmc-decimals', DECIMAL_PLACES);
    hydrate('fmc-aggregation', AGGREGATIONS);
    hydrate('fmc-frequency', REPORTING_FREQUENCIES);
    wireUnitToDataType();
  });

  /**
   * THE ONE PLACE IN THIS RAIL WHERE TWO SETTINGS GENUINELY INTERACT, and the
   * justification for data type sitting above everything else.
   *
   * The data model leaves `unit` empty for Percent and Currency because both carry
   * their own — a percent is always a percent — and outstandingFields() demands a
   * unit for Number alone. So the Unit row is not disabled when it does not apply;
   * it is REMOVED. A disabled row still spends a line of a 20rem column telling the
   * reader about a setting this record does not have, and the rail's whole claim is
   * that every line it spends is a fact about the measure.
   *
   * The typed unit is STASHED rather than thrown away. Switching Number -> Percent
   * has to clear the box — a leftover "acres" on a percent measure is exactly the
   * wrong claim, and it is what would get saved — but a mis-click on the data type
   * must not cost someone the word they just typed. Switch back and it returns.
   *
   * The row's collapsed value is NOT written here. firma2-config-row owns what its
   * line displays, and reaching into a sibling component's chrome from this file is
   * how two components start disagreeing about one datum. While the unit does not
   * apply the row is hidden, so there is no stale line to see; when it comes back
   * the stashed value is restored and the two agree again.
   */
  function wireUnitToDataType(): void {
    const dataType = document.getElementById('fmc-data-type');
    const row = document.getElementById('fmc-unit-row');
    const unit = document.getElementById('fmc-unit') as
      | (HTMLElement & { value: string; required: boolean; helpText: string })
      | null;
    if (!dataType || !row || !unit) return;

    // Both strings come from the server-rendered data attributes, so the initial
    // help text and the swapped one are the same two constants — no second copy in
    // this file to drift from the frontmatter's.
    const helpApplies = unit.dataset.helpApplies ?? '';
    const helpNotApplicable = unit.dataset.helpNa ?? '';
    const NUMBER = slug('Number');

    let stashedUnit = unit.value;

    const reflect = (typeValue: string | null) => {
      const applies = typeValue === NUMBER;
      // Read the box back before blanking it, but only on the transition OUT of the
      // applicable state — re-reading an already-blanked field would overwrite the
      // stash with "".
      if (!applies && !row.hidden) stashedUnit = unit.value;
      unit.value = applies ? stashedUnit : '';
      unit.required = applies;
      unit.helpText = applies ? helpApplies : helpNotApplicable;
      row.hidden = !applies;
    };

    // esa-select emits a bubbling `change` carrying the new value in `detail` — the
    // shadow-DOM listbox's own events never escape, so this is the only handle on
    // the choice.
    dataType.addEventListener('change', (event) => {
      reflect((event as CustomEvent<{ value: string }>).detail?.value ?? null);
    });
  }
</script>
