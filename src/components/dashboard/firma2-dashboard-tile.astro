---
// firma2-dashboard-tile — one tile of the Progress Dashboard: a figure as one
// number, as bars by group, or over time. It carries what it opens on
// (data-open); src/lib/dashboard-figure draws it and firma2-dashboard-sheet
// edits it.
//
// NO CARD (user, 2026-11-12: no border around the charts or the sections). A
// tile is its content on the page, set apart by space alone. While its corner
// is being dragged it shows a dashed outline — the extent being set, not a
// frame it keeps.
//
// bcn-lego-checked: esa-stat is the number, esa-chart (mounted by
// dashboard-figure) the plot, esa-collapsible the data
// view, esa-empty-state the empty tile, bcn-tile-grip the size corner, and
// bcn-sortable-list (in firma2-dashboard) the move grip in its actions; layout
// is .stack/.repel with three inline flex overrides on the header row
// (no primitive keeps a .repel on one line). The <style> holds only the
// tile's positioning box for the grip and the drag outline. Beacon is not
// cloned.
import EsaCollapsible from '@esa/ecology/esa-collapsible.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import EsaStat from '@esa/ecology/esa-stat.astro';

interface Props {
  index: number;
  /** The question the tile opens on: figure, form, split, size. */
  open: Record<string, string | number>;
  /** Rendered but not on the dashboard yet. */
  hidden?: boolean;
}

const { index, open, hidden = false } = Astro.props;

// ONE GRIP, NOT THREE BUTTONS (docs/adr/0001: act from the grip). A pencil
// and a trash beside the grip took 120px of a number tile and wrapped its
// title to four lines (measured, 2026-11-12). The grip drags; clicked, its
// menu holds these above the moves.
const actions = [
  { label: 'Edit chart', action: 'edit' },
  { label: 'Duplicate', action: 'duplicate' },
  { label: 'Remove chart', action: 'remove', variant: 'danger' },
];
---
{/* A row of a bcn-sortable-list: it carries a sort key only while it is on
    the dashboard, so a tile waiting to be added is no place to drop beside. */}
<li class="firma2-dashboard-tile" data-tile={index} data-sort-key={hidden ? undefined : index} data-sort-actions={JSON.stringify(actions)} data-open={JSON.stringify(open)} style={hidden ? 'display: none' : undefined}>
  <div class="stack" data-gap="md" data-figure>
    {/* The title wraps before the actions drop under it, so every tile's
        actions sit in the same corner. */}
    <div class="repel" data-gap="sm" style="flex-wrap: nowrap; align-items: flex-start">
      <div class="stack" data-gap="2xs" style="min-width: 0">
        <h2 class="typography-title-sm-strong" data-figure-title></h2>
        <p class="typography-body-md" data-figure-query></p>
      </div>
      {/* Editing only: the grip, put here by bcn-sortable-list. Reading, the
          tile is its title and its figure. */}
      <div style="flex-shrink: 0" data-sort-grip-slot></div>
    </div>
    <div class="stack" data-gap="sm" data-figure-body>
      <div data-figure-number>
        <EsaStat value="–" label="–" sub="–" />
        <p class="typography-body-md" style="display: none" data-figure-nothing></p>
      </div>
      <div data-figure-chartwrap>
        <div data-figure-chart></div>
      </div>
      <p class="typography-body-md" data-figure-coverage></p>
      <p class="typography-body-md" data-figure-note></p>
      <div data-figure-chartwrap>
        <EsaCollapsible title="View as data" flush>
          <div data-grid></div>
        </EsaCollapsible>
      </div>
    </div>
    <div style="display: none" data-figure-empty>
      <EsaEmptyState size="sm" title="No project in this view has this data" />
    </div>
  </div>
  <bcn-tile-grip label="Resize chart" data-tile-grip data-edit-only></bcn-tile-grip>
</li>

<style>
  .firma2-dashboard-tile {
    position: relative;
    min-inline-size: 0;
  }
  .firma2-dashboard-tile[data-resizing] {
    outline: 1px dashed var(--color-border-default, #cecece);
    outline-offset: var(--spacing-200, 0.5rem);
  }
  /* One number has no size to set. */
  .firma2-dashboard-tile[data-kind='number'] bcn-tile-grip {
    display: none;
  }
</style>
