---
// firma2-settings-security — Settings › Personal › Security & access: how this
// person signs in, where they are signed in, and what their account can reach.
//
// THREE CARDS, from the thing you change to the thing you only read. Sign-in
// holds the two controls a person owns (password, two-step verification).
// Sessions lists where the account is open, so a lost phone has an answer.
// Access states role and organization as plain facts: an administrator assigns
// both, so they render as text, not as fields that would refuse an edit.
//
// MOCK, and honest about it: no password changes and no session ends. Both
// buttons are enabled and inert ("inert, not disabled"); the switch keeps its
// own state like the notification switches do.
//
// bcn-lego-checked: esa-card per section, esa-button for actions,
// esa-switch-toggle for two-step verification, firma2-settings-table for the
// session list (the spoke's home for small settings lists). The Access pairs
// are a native <dl> with typography composites; `.stack`/`.repel` lay
// everything out; no <style> block.
import '../shared/firma2-card-section.css';
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2SettingsTable from './firma2-settings-table.astro';
import { users, CURRENT_USER } from '../../data/firma2-directory';
import { withBase } from '../../lib/base';

const me = users.find((u) => u.name === CURRENT_USER.name)!;

// Invented devices and places; the first row is the browser reading this page.
const sessions = [
  { name: 'Chrome on macOS', cells: { location: 'Sacramento, CA', lastActive: 'Active now' } },
  { name: 'Safari on iPhone', cells: { location: 'Redding, CA', lastActive: '28 September 2026' } },
  { name: 'Edge on Windows', cells: { location: 'Sacramento, CA', lastActive: '16 September 2026' } },
];
---
<div class="stack" data-gap="xl">
  <EsaCard title="Sign-in">
    <div class="stack" data-gap="lg">
      <div class="repel">
        <div class="stack" data-gap="2xs">
          <span class="typography-label-md">Password</span>
          <span class="typography-body-sm">Last changed 14 March 2026</span>
        </div>
        <EsaButton variant="secondary" size="md">Change password</EsaButton>
      </div>
      <esa-switch-toggle name="two-step" label="Require a code from an authenticator app at sign-in"></esa-switch-toggle>
    </div>
  </EsaCard>

  <EsaCard title="Sessions">
    <EsaButton slot="actions" variant="chrome" size="sm">Sign out other sessions</EsaButton>
    <Firma2SettingsTable
      label="Where you are signed in"
      nameLabel="Device"
      columns={[{ key: 'location', label: 'Location' }, { key: 'lastActive', label: 'Last active' }]}
      rows={sessions}
    />
  </EsaCard>

  <EsaCard title="Access">
    <dl class="stack" data-gap="md">
      <div class="stack" data-gap="2xs">
        <dt class="typography-label-md">Role</dt>
        <dd class="typography-body-md">{me.role}</dd>
      </div>
      <div class="stack" data-gap="2xs">
        <dt class="typography-label-md">Organization</dt>
        <dd class="typography-body-md">
          <a href={withBase('/prototypes/workspace-settings/your-organization')}>{me.organization}</a>
        </dd>
      </div>
    </dl>
    <Fragment slot="footer">An administrator sets your role and organization.</Fragment>
  </EsaCard>
</div>

<script>
  import '@esa/ecology/esa-switch-toggle';
</script>
