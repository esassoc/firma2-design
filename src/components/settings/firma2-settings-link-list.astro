---
// firma2-settings-link-list — a column of settings destinations: one row per
// page, the whole row a link, a chevron on the far edge saying "this opens".
//
// The shape of an index of settings (Linear's team settings, GitHub's
// organization settings): the reader scans labels down a column and picks one.
// So the label leads, an optional datum trails it (how many members, which
// domain), and the chevron sits in one straight column at the right edge.
//
// ROWS RULED APART, the same way firma2-switch-list rules its switches: a
// hairline between rows, none above the first or below the last — the section
// heading and the page edge already bound the list.
//
// UNBUILT DESTINATIONS ARE INERT, the nav's contract (firma2-nav.ts): a row
// with no `href` renders as text, dimmed, with no chevron, rather than as a
// link to a 404. Give the row an href the moment its page exists.
//
// NO PER-ROW ICONS. Linear puts one on every row; design-principles reserves
// icons for structure, never items, and the section headings already group.
//
// bcn-lego-checked: walked the catalog for a link-row list. esa-link-column is
// a footer sitemap column (heading + rule + body-sm links, inherits colour) —
// no trailing datum, no row hit area, wrong role. esa-sidebar-nav is the app's
// nav, not page content. esa-card would box every row. firma2-settings-table is
// a data table, not navigation. Beacon is not cloned on this machine. The
// chevron is esa-icon and the row is `.repel`; the CSS below is the rule, the
// row's padding and its hover, nothing else.
import EsaIcon from '@esa/ecology/esa-icon.astro';

export interface SettingsLink {
  label: string;
  /** Omit for a page this spoke has not built — the row renders inert. */
  href?: string;
  /** A datum about the destination, trailing the label: "8 people", "cwrb.org". */
  value?: string;
}

interface Props {
  items: SettingsLink[];
}

const { items } = Astro.props;
---
<ul class="firma2-settings-link-list" role="list">
  {items.map((item) => (
    <li>
      {item.href ? (
        <a class="firma2-settings-link-list__row repel" data-gap="md" href={item.href}>
          <span class="typography-body-md">{item.label}</span>
          <span class="cluster" data-gap="sm">
            {item.value && <span class="firma2-settings-link-list__value typography-body-md">{item.value}</span>}
            <EsaIcon name="chevron-right" size="sm" />
          </span>
        </a>
      ) : (
        <span class="firma2-settings-link-list__row firma2-settings-link-list__row--inert repel" data-gap="md">
          <span class="typography-body-md">{item.label}</span>
          {item.value && <span class="firma2-settings-link-list__value typography-body-md">{item.value}</span>}
        </span>
      )}
    </li>
  ))}
</ul>

<style>
  .firma2-settings-link-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .firma2-settings-link-list > li + li {
    border-block-start: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #d9d9d9);
  }

  /* The row bleeds a step past the text on both sides so the hover fill has
     room around the label, then the negative margin puts the label back on the
     page's edge, in line with the section heading above it. */
  .firma2-settings-link-list__row {
    padding: var(--spacing-300, 0.75rem) var(--spacing-200, 0.5rem);
    margin-inline: calc(-1 * var(--spacing-200, 0.5rem));
    border-radius: var(--radius-sm, 0.25rem);
    color: var(--color-content-default);
    text-decoration: none;
  }

  a.firma2-settings-link-list__row:hover {
    background: var(--color-background-default-hover);
  }

  .firma2-settings-link-list__value,
  .firma2-settings-link-list__row :global(svg) {
    color: var(--color-content-default-secondary, #646464);
  }

  .firma2-settings-link-list__row--inert {
    color: var(--color-content-default-tertiary, #8d8d8d);
  }
</style>
