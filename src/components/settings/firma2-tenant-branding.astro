---
// firma2-tenant-branding — the tenant's brand colour, what it costs in
// legibility, and the public page wearing it. Ported from ProjectFirma2
// hackathon team 3's Branding & Theme screen.
//
// ONE COLOUR, AND EVERYTHING FOLLOWS. The theme already routes every brand
// role through a twelve-step ramp, so one hex re-skins buttons, links, focus
// rings and subtle surfaces — this screen, every other screen, and every
// public page (src/lib/tenant-brand.ts).
//
// THE FLEXIBILITY IS PRICED, NOT FORBIDDEN. A tenant can pick a colour that
// makes its own site hard to read. The contrast card says so the moment the
// colour is chosen — and warns rather than blocks, as the hackathon did,
// because a brand colour is the tenant's to choose and the cost is theirs to
// accept knowingly.
//
// THE PREVIEW IS THE PUBLIC PAGE ITSELF, in a frame, re-skinned through the
// same storage event the studio uses. And this screen re-skins too, live:
// the whole application is the bigger preview.
//
// CUT FROM THE HACKATHON: fonts (they need webfont loading the spoke does
// not do yet), the separate body-text colour (the neutral ramp already
// carries text, and a second free colour was a second way to fail
// contrast), logo upload and display name (already settings elsewhere in
// production). The Save button: the brand applies the moment it is picked,
// and "Use the house colour" is the way back.
import Firma2RailSection from '../shared/firma2-rail-section.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import { BRAND_SWATCHES, HOUSE_PRIMARY } from '../../lib/tenant-brand';

interface Props {
  /** A public page to preview the brand on. */
  previewHref: string;
}

const { previewHref } = Astro.props;
const swatches = BRAND_SWATCHES.map((value) => ({ value, label: value === HOUSE_PRIMARY ? 'House green' : value }));
---
<!-- bcn-lego-checked: every control is a lego (esa-color-picker, esa-button,
     esa-alert-box, esa-badge); the classes lay out the form/preview split and
     the contrast rows. Beacon is not cloned on this machine.

     NO CARDS. Each section is firma2-rail-section — a heading and its content,
     no box. Everything in here already carries its own edge (the picker's
     input and swatches, the table's rules, the preview's frame), so a card
     drew a second box around each of them. The page title and the settings
     rail already say what this screen is; the headings only say where each
     part starts. -->
<div class="firma2-tenant-branding" data-swatches={JSON.stringify(swatches)} data-house={HOUSE_PRIMARY}>
  <div class="stack" data-gap="xl">
    {/* The section heading carries the name, at the same level as Contrast and
        the preview. The picker takes no `label`, which would repeat "Brand
        colour" one line below at a smaller size; its controls fall back to the
        lego's generic names ("Color picker", "Hex value"), read straight after
        this heading. */}
    <Firma2RailSection title="Brand colour">
      <p class="typography-body-md">This one colour sets every shade the application uses: buttons, links, focus rings and every public page.</p>
      <esa-color-picker data-brand show-input></esa-color-picker>
      <div>
        <EsaButton variant="ghost" size="sm" icon="rotate-ccw" data-reset>Use the house colour</EsaButton>
      </div>
    </Firma2RailSection>

    <Firma2RailSection title="Contrast">
      <div class="stack" data-gap="md">
        <table class="firma2-tenant-branding__table">
          <thead><tr><th scope="col">Where the colour is used</th><th scope="col">Ratio</th><th scope="col">Readable</th></tr></thead>
          <tbody data-contrast-rows></tbody>
        </table>
        <div data-contrast-warning hidden>
          <EsaAlertBox variant="warning" title="Some readers will struggle with this colour">
            The colour still applies, but the rows marked above fall below WCAG AA for their use.
          </EsaAlertBox>
        </div>
      </div>
    </Firma2RailSection>
  </div>

  <aside class="firma2-tenant-branding__preview">
    {/* The frame keeps its one border: it is the edge of a page embedded in a
        page, and without it the preview bleeds into this one. */}
    <Firma2RailSection title="A public page in this brand">
      <div class="firma2-tenant-branding__frame">
        <iframe src={previewHref} title="Public page preview" tabindex="-1"></iframe>
      </div>
    </Firma2RailSection>
  </aside>

  <template data-badge-pass><EsaBadge variant="success" size="sm" value="Yes" /></template>
  <template data-badge-fail><EsaBadge variant="warning" size="sm" value="Below AA" /></template>
</div>

<style>
  .firma2-tenant-branding [hidden] {
    display: none !important;
  }

  .firma2-tenant-branding {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 34rem);
    gap: var(--spacing-600);
    align-items: start;
  }

  @media (max-width: 72rem) {
    .firma2-tenant-branding {
      grid-template-columns: 1fr;
    }
  }

  .firma2-tenant-branding__preview {
    position: sticky;
    top: var(--spacing-400);
  }

  .firma2-tenant-branding__frame {
    height: 32rem;
    overflow: hidden;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
  }

  .firma2-tenant-branding__frame iframe {
    width: 200%;
    height: 200%;
    border: 0;
    transform: scale(0.5);
    transform-origin: 0 0;
  }

  .firma2-tenant-branding__table {
    width: 100%;
    border-collapse: collapse;
  }

  .firma2-tenant-branding__table th,
  .firma2-tenant-branding__table :global(td) {
    padding: var(--spacing-200) var(--spacing-300);
    border-block-end: 1px solid var(--color-border-default);
    text-align: start;
    font-weight: normal;
  }

  /* No card around it, so the outer columns sit on the section's own edges,
     in line with the heading above. The body rows are written by the script
     below, so they carry no scope attribute — the whole `tr > cell` match
     has to be :global. */
  .firma2-tenant-branding__table :global(tr > :first-child) {
    padding-inline-start: 0;
  }

  .firma2-tenant-branding__table thead th {
    color: var(--color-text-secondary);
  }
</style>

<script>
  import '@esa/ecology/esa-color-picker';
  import { applyBrand, contrastRows, isHex, readBrand, writeBrand } from '../../lib/tenant-brand';

  type Picker = HTMLElement & { value?: string; swatches?: unknown };

  document.querySelectorAll<HTMLElement>('.firma2-tenant-branding').forEach((root) => {
    const picker = root.querySelector<Picker>('[data-brand]')!;
    const house = root.dataset.house ?? '';
    const pass = root.querySelector<HTMLTemplateElement>('[data-badge-pass]')!.innerHTML.trim();
    const fail = root.querySelector<HTMLTemplateElement>('[data-badge-fail]')!.innerHTML.trim();

    const paintContrast = (hex: string) => {
      const rows = contrastRows(hex);
      root.querySelector('[data-contrast-rows]')!.innerHTML = rows
        .map((r) => `<tr><td>${r.label}</td><td>${r.ratio.toFixed(1)} : 1</td><td>${r.passes ? pass : fail}</td></tr>`)
        .join('');
      root.querySelector<HTMLElement>('[data-contrast-warning]')!.hidden = rows.every((r) => r.passes);
    };

    /** Apply a colour everywhere: this document now, the preview by storage event. */
    const choose = (hex: string) => {
      const brand = hex.toLowerCase() === house.toLowerCase() ? null : { primary: hex };
      writeBrand(brand);
      applyBrand(brand);
      paintContrast(hex);
    };

    customElements.whenDefined('esa-color-picker').then(() => {
      picker.swatches = JSON.parse(root.dataset.swatches ?? '[]');
      const current = readBrand()?.primary ?? house;
      picker.value = current;
      paintContrast(current);
    });

    picker.addEventListener('change', () => {
      const hex = String(picker.value ?? '');
      if (isHex(hex)) choose(hex);
    });

    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      picker.value = house;
      choose(house);
    });
  });
</script>
