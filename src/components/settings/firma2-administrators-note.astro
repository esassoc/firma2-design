---
// firma2-administrators-note — the line that tells a reader who controls their
// role and organization, with a way to find those people.
//
// LINEAR'S "VIEW WORKSPACE ADMINS". Anyone — not only administrators — can see
// who the administrators are, because "an administrator sets your role" is a
// dead end until it names someone to ask. So the note carries one button, and
// the dialog lists the active administrators with their email addresses: the
// whole answer, and nothing to configure.
//
// A DIALOG, NOT A PAGE. Linear gives it a route; here it is three names asked
// for from inside Account or Security, read, and closed — the reader's place on
// the settings page is the thing to keep.
//
// bcn-lego-checked: esa-button opens an esa-dialog holding
// firma2-settings-table (the spoke's home for small lists; no esa- table lego
// exists). `.cluster` lays out the line; no <style> block. Beacon is not cloned
// on this machine.
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2SettingsTable from './firma2-settings-table.astro';
import { administrators } from '../../data/firma2-directory';

const rows = administrators().map((u) => ({ name: u.name, cells: { email: u.email } }));
---
<div class="firma2-administrators-note">
  <div class="cluster" data-gap="sm">
    <p class="typography-body-sm">Administrators set your role, and stewards add you to organizations.</p>
    <EsaButton variant="ghost" size="md" data-admins-open>View administrators</EsaButton>
  </div>
  <esa-dialog heading="Administrators" size="md" show-close-button>
    <Firma2SettingsTable label="Administrators" nameLabel="Name" columns={[{ key: 'email', label: 'Email' }]} rows={rows} />
    {/* A footer, though the header has a close: esa-dialog's empty-footer rule
        (`:not(:has(*))`) always sees its own <slot>, so an empty footer still
        draws its band. A Close there is the honest way to fill it. */}
    <EsaButton slot="footer" variant="secondary" size="md" data-admins-close>Close</EsaButton>
  </esa-dialog>
</div>

<script>
  import '@esa/ecology/esa-dialog';

  type Dialog = HTMLElement & { show(): void; close(): void };

  document.querySelectorAll<HTMLElement>('.firma2-administrators-note').forEach((root) => {
    const dialog = root.querySelector<Dialog>('esa-dialog');
    root.querySelector('[data-admins-open]')?.addEventListener('click', () => {
      void customElements.whenDefined('esa-dialog').then(() => dialog?.show());
    });
    root.querySelector('[data-admins-close]')?.addEventListener('click', () => dialog?.close());
  });
</script>
