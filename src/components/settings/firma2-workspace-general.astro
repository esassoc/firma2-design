---
// firma2-workspace-general — the workspace's own identity: its name, where it
// lives, who answers for it, and when its reporting year turns over.
//
// A FORM, NOT A RECORD — the second of this app's two field patterns (the long
// form is in firma2-settings-account). Settings are visited to change
// something, so every field draws its border at rest with its label above: the
// legos exactly as they ship. firma2-editable-field's borderless-until-hover
// display is for record pages that read first and are corrected in place.
//
// bcn-lego-checked: firma2-rail-section is the section (a heading, no box) and
// esa-text-field / esa-select are the controls — all existing, composed
// unchanged. No cards: a four-field page needs headings to say where a group
// starts, not borders. `.stack` spaces the fields; no bespoke flex, and no
// <style> block.
import Firma2RailSection from '../shared/firma2-rail-section.astro';
import { workspaceGeneral as ws, MONTHS } from '../../data/firma2-workspace-settings';

// esa-select takes `{ value, label }` records; identical value and label because
// these are plain month names, not codes. `options` is a Lit Array property, so
// the JSON attribute converts on upgrade. The selected VALUE has no attribute —
// the script below assigns it once the element is defined.
const monthOptions = JSON.stringify(MONTHS.map((m) => ({ value: m, label: m })));
---
<div class="stack" data-gap="2xl">
  <Firma2RailSection title="Public details">
    <div class="stack" data-gap="md">
      <esa-text-field name="name" label="Name" value={ws.name} size="md" required></esa-text-field>
      <esa-text-field name="address" label="Public site address" value={ws.address} size="md" required></esa-text-field>
      <esa-text-field name="contact" label="Contact email" value={ws.contact} size="md" type="email" required></esa-text-field>
    </div>
    <p class="typography-body-sm">The name and contact email appear on every public page.</p>
  </Firma2RailSection>

  <Firma2RailSection title="Reporting">
    <div class="stack" data-gap="md">
      <esa-select
        name="fiscalYearStart"
        label="Fiscal year starts in"
        size="md"
        options={monthOptions}
        data-seed={ws.fiscalYearStart}
      ></esa-select>
    </div>
    <p class="typography-body-sm">Annual totals and update deadlines follow this year.</p>
  </Firma2RailSection>
</div>

<script>
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-select';

  // Assigned only after define — a `.value` set on a not-yet-upgraded element
  // becomes an own property that shadows the lego's setter for good.
  customElements.whenDefined('esa-select').then(() => {
    document
      .querySelectorAll<HTMLElement & { value: string }>('esa-select[data-seed]')
      .forEach((el) => {
        el.value = el.dataset.seed ?? '';
      });
  });
</script>
