---
// firma2-settings-table — one Workspace settings list: a named row per thing
// the workspace defines, and the few facts that tell those rows apart.
//
// Every list section of Workspace settings (stages, custom fields,
// classifications, organization types, funding source fields, roles, labels)
// is the same shape — a homogeneous list scanned down a column — so it is one
// component fed by data, not seven tables. It follows firma2-type-roster's
// construction: the name cell is a row header with its description under it,
// so a screen reader hears what each row IS before its facts.
//
// Numeric columns align to the end and use tabular figures, so counts compare
// down the column.
import type { SettingsRow } from '../../data/firma2-workspace-settings';

export interface SettingsColumn {
  key: string;
  label: string;
  numeric?: boolean;
}

interface Props {
  /** Header of the name column, e.g. "Stage". */
  nameLabel: string;
  columns: SettingsColumn[];
  rows: SettingsRow[];
  /** Accessible name for the table; the page title usually suffices. */
  label: string;
}

const { nameLabel, columns, rows, label } = Astro.props;
---
<!-- bcn-lego-checked: a plain data table, no card around it (its own rules
     already bound every row, and it is the page's only content) — a few scannable
     columns over a handful of rows, too small for the AG Grid chrome; no esa-
     table lego exists. Beacon is not cloned on this machine. Same construction
     as firma2-type-roster; this is the reusable home for every settings list. -->
<table class="firma2-settings-table" aria-label={label}>
    <thead>
      <tr>
        <th scope="col">{nameLabel}</th>
        {columns.map((c) => (
          <th scope="col" class:list={{ 'firma2-settings-table__num': c.numeric }}>{c.label}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">
            {r.href
              ? <a class="firma2-settings-table__name" href={r.href}>{r.name}</a>
              : <span class="firma2-settings-table__name">{r.name}</span>}
            {r.description && <span class="firma2-settings-table__meta typography-body-sm">{r.description}</span>}
          </th>
          {columns.map((c) => (
            <td class:list={{ 'firma2-settings-table__num': c.numeric }}>{r.cells[c.key]}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>

<style>
  /* No card, so no inset: the first and last columns sit on the page's own
     edges, in line with the title above. */
  .firma2-settings-table tr > :first-child {
    padding-inline-start: 0;
  }
  .firma2-settings-table tr > :last-child {
    padding-inline-end: 0;
  }

  .firma2-settings-table {
    width: 100%;
    border-collapse: collapse;
  }

  .firma2-settings-table th,
  .firma2-settings-table td {
    padding: var(--spacing-400);
    border-block-end: 1px solid var(--color-border-default);
    text-align: start;
    vertical-align: top;
    font-weight: normal;
  }

  .firma2-settings-table tbody tr:last-child > * {
    border-block-end: 0;
  }

  .firma2-settings-table thead th {
    color: var(--color-text-secondary);
  }

  /* Element-qualified so it outranks the `th, td { text-align: start }` base. */
  .firma2-settings-table th.firma2-settings-table__num,
  .firma2-settings-table td.firma2-settings-table__num {
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  .firma2-settings-table__meta {
    display: block;
    margin-block-start: var(--spacing-100);
    color: var(--color-text-secondary);
  }
</style>
