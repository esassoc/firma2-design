---
// firma2-organization-grid — Workspace settings › Organizations: every
// organization with an account in this workspace, what kind it is, and what it
// does here (leads projects, funds them, or neither), searchable by name or
// contact and filterable by type.
//
// The SAME chrome as firma2-project-grid — search + filter row, CSV at the
// right, record count under the grid — because an administrator moves between
// the two and the second table should not have to be learned. Only the
// columns and the one filter differ.
//
// THE NAME IS A DOOR. Each row links to that organization's record; the
// reader's own organization links to "Your organization", the one record a
// signed-in reader reaches from the rail as well, so the two routes land on
// one page rather than two copies of it.
//
// bcn-lego-checked: ecology has NO table/grid lego — esa-grid is a
// documentation-only page with nothing to import; checked the full
// node_modules/@esa/ecology/src/components catalog. Beacon is not cloned on
// this machine. This is the spoke's established AG Grid surface
// (firma2-project-grid is the precedent) and shared/firma2-data-grid-chrome.css
// owns the frame. Every control around it IS a lego: esa-text-field,
// esa-filter-container + esa-filter-dropdown, esa-button, esa-empty-state.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaFilterContainer from '@esa/ecology/esa-filter-container.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import '../shared/firma2-data-grid-chrome.css';
import { organizations, organizationTypes, CURRENT_USER } from '../../data/firma2-directory';
import { withBase } from '../../lib/base';

// Only types that have members are offered, so the filter never returns nothing.
const typeOptions = organizationTypes
  .filter((t) => organizations.some((o) => o.type === t))
  .map((t) => ({ value: t, label: t }));

// Resolved here rather than in the client: the base path is a build-time fact.
const rows = organizations.map((o) => ({
  ...o,
  href: withBase(
    o.name === CURRENT_USER.organization
      ? '/prototypes/workspace-settings/your-organization'
      : `/prototypes/workspace-settings/organizations/${o.slug}`,
  ),
}));
---
<section class="firma2-organization-grid stack" data-gap="md">
  <div class="firma2-data-grid__controls repel">
    <div class="firma2-data-grid__controls-filters cluster">
      <div class="firma2-data-grid__search">
        <esa-text-field
          label="Search organizations"
          placeholder="Organization or contact"
          size="md"
          data-orgs-search
        ></esa-text-field>
      </div>
      <EsaFilterContainer>
        <esa-filter-dropdown
          data-orgs-type-filter
          name="type"
          label="Type"
          size="md"
          multiple
          placeholder="Search types"
          options={JSON.stringify(typeOptions)}
        ></esa-filter-dropdown>
      </EsaFilterContainer>
    </div>
    <EsaButton variant="chrome" iconOnly icon="download" label="Download CSV" size="sm" data-orgs-csv />
  </div>

  <div class="firma2-data-grid__grid" data-orgs-grid></div>

  <footer class="firma2-data-grid__footer">
    <span class="typography-meta" data-orgs-count>{rows.length} organizations</span>
  </footer>

  <div data-orgs-empty hidden aria-hidden="true">
    <EsaEmptyState
      size="sm"
      title="No matching organizations"
      description="Try a different search, or clear the Type filter."
    />
  </div>

  <script type="application/json" data-orgs-data set:html={JSON.stringify(rows)}></script>
</section>

<script>
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-filter-dropdown';
  import { escGridHtml as esc, wireDataGrid } from '../shared/grid-chrome';
  import { label } from '../../lib/vocabulary';
  import type { Organization } from '../../data/firma2-directory';
  import type { ColDef } from 'ag-grid-community';

  type Row = Organization & { href: string };

  function initOrganizationGrid(root: HTMLElement) {
    const emptyState = root.querySelector<HTMLElement>('[data-orgs-empty] > *');
    const typeFilter = root.querySelector<HTMLElement>('[data-orgs-type-filter]');
    let typeValues: string[] = [];

    // A count of zero reads as an empty cell, not "0": in a column of mostly
    // zeros (most organizations lead or fund, rarely both) the figures that
    // exist are the ones a reader is scanning for.
    const count = (p: { value?: number }) => (p.value ? String(p.value) : '');

    const handle = wireDataGrid<Row>({
      root,
      gridSelector: '[data-orgs-grid]',
      dataSelector: '[data-orgs-data]',
      searchSelector: '[data-orgs-search]',
      countSelector: '[data-orgs-count]',
      csvSelector: '[data-orgs-csv]',
      countNoun: label('organizations'),
      csvFileName: 'projectfirma-organizations.csv',
      suppressCellFocus: true,
      columnDefs: [
        {
          headerName: label('Organization'), field: 'name', colId: 'name',
          flex: 2, minWidth: 220, cellClass: 'firma2-grid-name', tooltipField: 'name',
          getQuickFilterText: (p) => p.data?.name ?? '',
          cellRenderer: (p: { data?: Row }) =>
            p.data ? `<a class="firma2-grid-link" href="${esc(p.data.href)}">${esc(p.data.name)}</a>` : '',
        },
        { headerName: 'Type', field: 'type', colId: 'type', flex: 1, minWidth: 170, tooltipField: 'type' },
        {
          headerName: 'Projects led', field: 'projectsLed', colId: 'projectsLed', width: 130,
          cellClass: 'firma2-grid-num', valueFormatter: count,
        },
        {
          headerName: 'Projects funded', field: 'projectsFunded', colId: 'projectsFunded', width: 150,
          cellClass: 'firma2-grid-num', valueFormatter: count,
        },
        { headerName: 'People', field: 'people', colId: 'people', width: 100, cellClass: 'firma2-grid-num' },
        {
          headerName: 'Primary contact', field: 'primaryContact', colId: 'primaryContact',
          flex: 1, minWidth: 160, tooltipField: 'primaryContact',
          getQuickFilterText: (p) => p.data?.primaryContact ?? '',
        },
      ] satisfies ColDef[],
      gridOptions: {
        overlayNoRowsTemplate: emptyState?.outerHTML,
        isExternalFilterPresent: () => typeValues.length > 0,
        doesExternalFilterPass: (node) => typeValues.includes(node.data?.type ?? ''),
      },
    });
    if (!handle) return;

    typeFilter?.addEventListener('selection-change', (event) => {
      typeValues = (event as CustomEvent<{ value?: string[] }>).detail?.value ?? [];
      handle.gridApi.onFilterChanged();
    });
  }

  document.querySelectorAll<HTMLElement>('.firma2-organization-grid').forEach(initOrganizationGrid);
</script>
