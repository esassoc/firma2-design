---
// firma2-organization-danger-zone — the ways out of an organization: leave it
// yourself, retire it, remove it, delete it. Ordered by how much each destroys.
//
// THE CONFIRM SAYS WHAT IT COSTS. Leave and Retire state their consequence in
// the dialog, once; only Delete, which has no dialog, carries a line in its row.
//
// RETIRE BEFORE DELETE, the rule measure setup set: anything projects have filed
// against retires, never deletes. Delete is therefore DISABLED while the
// organization leads or funds a project — and that is a true statement, with the
// reason in the row beside it ("Inert, not disabled" bounds the exception:
// disabled must be telling the truth, with the reason in view).
//
// Leave and Retire ask first, in ONE esa-confirm-dialog retargeted by the
// button pressed — map-layers' precedent. (Two sibling dialogs were tried: the
// Astro compiler nested the second inside the first, so it never rendered.)
// Nothing in the prototype acts on the answer; the dialog closes and the page
// stays as it was.
//
// REMOVE IS THE TAKEDOWN, administrators only (.scratch/access-requests/
// spec.md, decision 19). Delete is blocked once an organization leads a
// project, so an impostor that published under a real name could not be taken
// down; Remove can. It unpublishes the organization and its projects at once,
// hides it everywhere, ends its memberships, and leaves its projects to be
// reassigned or removed — all undoable for 30 days, and logged with a reason.
// Its dialog is an esa-dialog, not the shared confirm, because the reason is a
// field and esa-confirm-dialog holds only a message. The row renders for every
// reader and the script shows it only to an Administrator (currentActor(), so
// the `?as=` switch demonstrates it); the page is static, so the gate is
// client-side. Like Leave and Retire nothing is really removed: the row turns
// into Restore, which is what makes the toast's Undo legitimate (the snackbar
// lego allows an action only when the document offers it too).
//
// bcn-lego-checked: esa-danger-zone is the box and its heading, esa-button each
// act, esa-confirm-dialog each question, esa-dialog + esa-textarea the removal
// and its reason, esa-snackbar-container the confirmation — all composed
// unchanged. The lego's
// slot is a wrapping button row; rows each with their own consequence need
// a list inside it, which is the only CSS here (full width, ruled apart in the
// zone's own danger border). Beacon is not cloned on this machine.
import EsaDangerZone from '@esa/ecology/esa-danger-zone.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { membersOf, type Organization } from '../../data/firma2-directory';

interface Props {
  organization: Organization;
}

const { organization: org } = Astro.props;
const hasProjects = org.projectsLed + org.projectsFunded > 0;
const plural = (n: number) => `${n} project${n === 1 ? '' : 's'}`;

// Only the counts that exist: "leads 0 and funds 9" makes the reader parse a zero.
const holdings = [
  org.projectsLed > 0 && `leads ${plural(org.projectsLed)}`,
  org.projectsFunded > 0 && `funds ${plural(org.projectsFunded)}`,
].filter(Boolean).join(' and ');

const deleteReason = hasProjects
  ? `Retire it instead — it ${holdings}.`
  : 'Can’t be undone.';

// What Remove costs, in this organization's own numbers. Administrators belong
// to the workspace, not only here, so they keep their role.
const stranded = membersOf(org.name).filter((u) => u.role !== 'Administrator' && u.organizations.length === 1).length;
const people = (n: number) => `${n} ${n === 1 ? 'person' : 'people'}`;
const removeCosts = [
  'It and its projects come off the public site at once, and it disappears from every list and picker.',
  stranded > 0
    ? `Its memberships end; ${people(stranded)} with no other organization become Viewers.`
    : 'Its memberships end.',
  org.projectsLed > 0 && `Its ${plural(org.projectsLed)} need a new lead organization or removing.`,
  'You can undo this for 30 days.',
].filter(Boolean) as string[];

// What the dialog asks for each act, keyed by the button's data-danger.
const confirms = JSON.stringify({
  leave: {
    heading: 'Leave this organization?',
    message: 'You lose access until an administrator invites you back.',
    confirmLabel: 'Leave organization',
  },
  retire: {
    heading: 'Retire this organization?',
    message: 'It leaves lists and pickers and takes no new projects until restored.',
    confirmLabel: 'Retire organization',
  },
});

const rows: { key: string; title: string; body?: string; action: string; disabled: boolean }[] = [
  {
    key: 'leave',
    title: 'Leave organization',
    action: 'Leave',
    disabled: false,
  },
  {
    key: 'retire',
    title: 'Retire organization',
    action: 'Retire',
    disabled: false,
  },
  {
    key: 'remove',
    title: 'Remove organization',
    action: 'Remove',
    disabled: false,
  },
  {
    key: 'delete',
    title: 'Delete organization',
    body: deleteReason,
    action: 'Delete',
    disabled: hasProjects,
  },
];
---
<EsaDangerZone heading="Danger zone">
  <ul class="firma2-organization-danger-zone" role="list">
    {rows.map((row) => (
      <li class="repel" data-gap="md" style={row.key === 'remove' ? 'display: none' : undefined} data-danger-row={row.key}>
        <div class="stack" data-gap="3xs" id={`danger-${row.key}`}>
          <span class="typography-label-md-strong" data-danger-title>{row.title}</span>
          {row.body && <span class="typography-body-sm">{row.body}</span>}
          {row.key === 'remove' && <span class="typography-body-sm" style="display: none" data-removed-note>Restore it within 30 days.</span>}
        </div>
        <EsaButton
          variant="danger"
          appearance="soft"
          size="md"
          disabled={row.disabled}
          aria-describedby={`danger-${row.key}`}
          data-danger={row.key}
        >{row.action}</EsaButton>
      </li>
    ))}
  </ul>
</EsaDangerZone>

{/* Each dialog in its own wrapper: two sibling custom-element dialogs at this
    level come out NESTED (the second inside the first, which then never
    renders it) — the trap this file's header records. */}
<div><esa-confirm-dialog class="firma2-organization-danger-zone__confirm" variant="danger" data-confirms={confirms}></esa-confirm-dialog></div>

<esa-dialog class="firma2-organization-danger-zone__remove" heading={`Remove ${org.name}?`} size="sm" show-close-button data-organization={org.name}>
  <div class="stack" data-gap="lg">
    <div class="stack" data-gap="xs">
      {removeCosts.map((line) => <p class="typography-body-md">{line}</p>)}
    </div>
    <esa-textarea label="Reason" rows="3" size="md" name="reason" required data-remove-reason></esa-textarea>
  </div>
  <div class="cluster" data-gap="xs" slot="footer">
    <EsaButton variant="danger" size="md" data-remove-confirm>Remove organization</EsaButton>
    <EsaButton variant="ghost" size="md" data-remove-cancel>Cancel</EsaButton>
  </div>
</esa-dialog>

<esa-snackbar-container class="firma2-organization-danger-zone__toasts"></esa-snackbar-container>

<script>
  import '@esa/ecology/esa-confirm-dialog';
  import '@esa/ecology/esa-dialog';
  import '@esa/ecology/esa-textarea';
  import '@esa/ecology/esa-snackbar-container';
  import { currentActor } from '../../lib/workspace-permissions';

  type Copy = { heading: string; message: string; confirmLabel: string };
  type Confirm = HTMLElement & Copy & { show?: () => void };

  const dialog = document.querySelector<Confirm>('.firma2-organization-danger-zone__confirm');
  const copy: Record<string, Copy> = JSON.parse(dialog?.dataset.confirms ?? '{}');

  document.querySelectorAll<HTMLElement>('[data-danger]').forEach((button) => {
    const act = copy[button.dataset.danger ?? ''];
    if (!dialog || !act) return;
    button.addEventListener('click', async () => {
      // Assigned only after define, or the props shadow the lego's setters.
      await customElements.whenDefined('esa-confirm-dialog');
      Object.assign(dialog, act);
      dialog.show?.();
    });
  });

  // REMOVE — administrators only, and reversible here the way it is for 30
  // days in the product: the row becomes Restore, the toast offers Undo.
  type Dialog = HTMLElement & { show(): void; close(): void };
  type Field = HTMLElement & { value: string; errorText: string };
  type Toasts = HTMLElement & {
    show(config: { message: string; variant?: string; action?: string }): void;
  };

  const row = document.querySelector<HTMLElement>('[data-danger-row="remove"]');
  const removeDialog = document.querySelector<Dialog>('.firma2-organization-danger-zone__remove');
  const reason = document.querySelector<Field>('[data-remove-reason]');
  const toasts = document.querySelector<Toasts>('.firma2-organization-danger-zone__toasts');

  if (row && removeDialog && reason && toasts && currentActor().role === 'Administrator') {
    row.style.display = '';
    const name = removeDialog.dataset.organization ?? '';
    const button = row.querySelector<HTMLElement>('[data-danger="remove"]')!;
    const label = button.querySelector('.esa-button__label')!;
    const title = row.querySelector<HTMLElement>('[data-danger-title]')!;
    const note = row.querySelector<HTMLElement>('[data-removed-note]')!;
    let removed = false;

    const paint = () => {
      label.textContent = removed ? 'Restore' : 'Remove';
      title.textContent = removed ? 'Organization removed' : 'Remove organization';
      note.style.display = removed ? '' : 'none';
    };

    const restore = async () => {
      removed = false;
      paint();
      await customElements.whenDefined('esa-snackbar-container');
      toasts.show({ message: `${name} restored.`, variant: 'success' });
    };

    button.addEventListener('click', async () => {
      if (removed) return void restore();
      await customElements.whenDefined('esa-dialog');
      await customElements.whenDefined('esa-textarea');
      reason.value = '';
      reason.errorText = '';
      removeDialog.show();
    });
    document.querySelector('[data-remove-cancel]')?.addEventListener('click', () => removeDialog.close());
    document.querySelector('[data-remove-confirm]')?.addEventListener('click', async () => {
      if (!reason.value.trim()) {
        reason.errorText = 'Enter a reason.';
        reason.focus();
        return;
      }
      removed = true;
      paint();
      removeDialog.close();
      await customElements.whenDefined('esa-snackbar-container');
      toasts.show({ message: `${name} removed.`, variant: 'success', action: 'Undo' });
    });
    toasts.addEventListener('snackbar-action', () => {
      if (removed) void restore();
    });
  }
</script>

<style>
  /* The lego's slot is a wrapping flex row built for a few buttons; this list
     takes the whole row so each act sits on its own line with its consequence. */
  .firma2-organization-danger-zone {
    flex: 1 1 100%;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .firma2-organization-danger-zone > li {
    padding-block: var(--spacing-300, 0.75rem);
  }
  .firma2-organization-danger-zone > li:first-child { padding-block-start: 0; }
  .firma2-organization-danger-zone > li:last-child { padding-block-end: 0; }
  .firma2-organization-danger-zone > li + li {
    border-block-start: var(--border-width-default, 1px) solid var(--color-border-utility-danger, #fdbdbe);
  }

  /* The consequence wraps; the button keeps its width, and drops under the
     text once the zone is too narrow for both on one line (a phone). */
  .firma2-organization-danger-zone .stack {
    flex: 1 1 14rem;
    min-inline-size: 0;
  }
</style>
