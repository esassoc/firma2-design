---
// firma2-organization-general — an organization's own details: what it is
// called, what kind it is, where it lives online, who answers for it, and what
// it says about itself.
//
// A FORM, NOT A RECORD (brief §4, "A record reads first; a form shows its
// boxes"): this page is opened to change something, so every field draws its
// border at rest with its label above — the legos exactly as they ship, the
// same as firma2-workspace-general. No Save: each field commits when the
// reader leaves it, the spoke's one model of correcting a value.
//
// Primary contact is a select over this organization's members, not free text:
// the contact has to be someone who can sign in and answer.
//
// bcn-lego-checked: firma2-rail-section is each section, esa-text-field /
// esa-select / esa-textarea the controls — all existing, composed unchanged.
// `.stack` spaces the fields; no bespoke flex and no <style> block.
import Firma2RailSection from '../shared/firma2-rail-section.astro';
import { membersOf, organizationTypes } from '../../data/firma2-directory';
import type { Organization } from '../../data/firma2-directory';

interface Props {
  organization: Organization;
}

const { organization: org } = Astro.props;

// esa-select takes `{ value, label }` records as a JSON attribute; the selected
// value has no attribute and is seeded by the script below once defined.
const typeOptions = JSON.stringify(organizationTypes.map((t) => ({ value: t, label: t })));
const contactOptions = JSON.stringify(
  membersOf(org.name)
    .filter((u) => u.status === 'Active')
    .map((u) => ({ value: u.name, label: u.name })),
);
---
<div class="stack" data-gap="2xl">
  <Firma2RailSection title="Details">
    <div class="stack" data-gap="md">
      <esa-text-field name="name" label="Name" value={org.name} size="md" required></esa-text-field>
      <esa-select name="type" label="Type" size="md" options={typeOptions} data-seed={org.type}></esa-select>
      <esa-text-field name="website" label="Website" value={`https://${org.website}`} size="md" type="url"></esa-text-field>
      <esa-select
        name="primaryContact"
        label="Primary contact"
        help-text="One of this organization’s members."
        size="md"
        options={contactOptions}
        data-seed={org.primaryContact}
      ></esa-select>
    </div>
  </Firma2RailSection>

  {/* The heading is the field's visible label; a second "Description" on the
      box one line below it would say the same word twice. */}
  <Firma2RailSection title="Description">
    <esa-textarea
      name="description"
      aria-label="Description"
      rows="5"
      auto-resize
      value={org.description}
    ></esa-textarea>
  </Firma2RailSection>
</div>

<script>
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-textarea';

  // Assigned only after define — a `.value` set on a not-yet-upgraded element
  // becomes an own property that shadows the lego's setter for good.
  customElements.whenDefined('esa-select').then(() => {
    document
      .querySelectorAll<HTMLElement & { value: string }>('esa-select[data-seed]')
      .forEach((el) => {
        el.value = el.dataset.seed ?? '';
      });
  });
</script>
