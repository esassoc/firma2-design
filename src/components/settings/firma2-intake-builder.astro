---
// firma2-intake-builder — the workspace's project intake form, built the way
// Tally builds a form and the way a custom page is written: one document,
// edited where it stands, with nothing docked beside it. The grammar is shared
// with the custom-page editor — docs/adr/0001-one-editing-grammar-for-builder-
// canvases.md. Spec: .scratch/form-canvas/spec.md (supersedes the builder
// parts of .scratch/project-intake/spec.md); rules: src/lib/intake-form.ts.
//
// THE CANVAS IS THE FORM, AT THE FORM'S WIDTH. Members fill it in a reading
// column, so the canvas is capped at the same CONTENT_READING: a question drawn
// wider here than members will ever see it would misstate what they get. Every
// question is drawn with the member page's renderer (src/lib/intake-render.ts),
// inert here, so what you see is what they get. Wording, help text and choices
// are typed straight onto the question.
//
// ADD FROM ANY BLANK LINE. Enter at the end of a question, its help or its last
// choice opens a blank line beneath it; the canvas always ends on one. Type `/`
// there for Text or New screen (bcn-insert-menu). Typing words instead of `/`
// and pressing Enter makes a text block of them. No + beside the blocks: it
// was a second way to add questions (user, 2026-10-20).
//
// ACT FROM THE GRIP. One flat bcn-sortable-list holds every block AND every
// screen break, so a screen is moved the way a question is. The grip drags, and
// clicking it opens Duplicate / Required / Add condition / Remove above the moves
// (`data-sort-actions`). ⌘D duplicates, ⌥↑ ⌥↓ move, Backspace on an empty new
// block removes it.
//
// QUESTIONS COME ONLY FROM THE FIELDS DRAWER. The form never makes a field,
// and `/` lists neither custom fields nor standard questions (user,
// 2026-10-20): the drawer is the one way a question reaches the form, each
// placeable once. Its "New
// custom field" goes to Custom fields to make one and comes back with it placed.
// A placed field arrives with its name as the question, ready to be reworded
// the way members should read it ("How many acres will this restore?"); its
// name, kind and choices stay the field's, edited in Custom fields.
//
// THE FIELDS DRAWER, docked on the right (firma2-intake-fields-drawer in
// firma2-side-panel), lists every field as a tile: click one to place it below
// the selection, or drag it to the spot. A line shows where it lands.
// Hidden with everything else below Agency.
//
// SETTINGS SIT ON THE BLOCK. The `*` beside a label toggles Required. A selected
// custom question says which field it saves to, linked to that field. A
// condition is a "Show only when … is any of …" row under the block it governs.
// A locked standard question says why, and where its choices live.
//
// SCREENS ARE BREAKS. One screen shows no screen chrome at all. A second screen
// adds a break, and screen 1 gets a title line too; the break carries the title
// of the screen after it. The message after submitting is the last, fixed break.
//
// SAVED AS YOU GO, LIVE WHEN PUBLISHED. Every edit writes the working copy;
// members fill the published copy until Publish.
//
// THE FREE TIER CUSTOMIZES NOTHING. The page stays — a tease and a call to
// action, not a removal: the standard form, read-only, under one alert that
// leads to Workspace settings › Plan.
//
// FORMATTING IN LABELS AND HELP. Select text in a question's label or help and
// Bold / Italic / Link appear above it (⌘B ⌘I ⌘K too) — what the member's form
// can show there; it draws formatted copy itself (src/lib/intake-render.ts).
// Choices, screen titles and the fixed standard names stay plain. The surface
// takes esa-popover's tokens, as firma2-rich-text's toolbar does; the link
// field is esa-text-field in esa-dialog.
//
// bcn-lego-checked: no esa- form builder, block editor, slash-command menu or
// stepper exists (walked `ls node_modules/@esa/ecology/src/components/`).
// Beacon is not cloned here. Composed from: bcn-sortable-list (grips that drag
// and carry each block's actions), bcn-insert-menu (the `/` and + list),
// firma2-rich-text (text blocks and the after-submit message), esa-button
// (cloned from templates for runtime rows), esa-icon + esa-tooltip (the lock),
// esa-select, esa-checkbox-group, esa-text-field, esa-alert-box,
// firma2-intake-setup (the first-time guide). Bespoke: the
// block frame, the contenteditable add line, and the `*` Required switch — a
// text glyph you click on the label it marks, the in-place sibling of the
// contenteditable label beside it (no esa- lego is a glyph-sized switch;
// flagged as an Ecology deviation, .scratch/form-canvas/spec.md #6).
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import Firma2RichText from '../shared/firma2-rich-text.astro';
import Firma2PlanLock from '../shared/firma2-plan-lock.astro';
import Firma2IntakeSetup from './firma2-intake-setup.astro';
import Firma2IntakeFieldsDrawer from './firma2-intake-fields-drawer.astro';
import Firma2SidePanel from '../shared/firma2-side-panel.astro';
import { CONTENT_READING } from '../../lib/content-width';
import { withBase } from '../../lib/base';

// What `/` can add: layout only. Every question — custom field or standard —
// comes from the Fields drawer.
const LAYOUT = [
  { id: 'layout:text', label: 'Text' },
  { id: 'layout:screen', label: 'New screen' },
];
const GROUPS = [{ name: 'Layout', items: LAYOUT }];
// The gutter each block carries on its left: grip (40px) + gap (4px) + the
// block's padding (16px).
// The canvas is the reading width PLUS this, so a question's fields come out
// exactly as wide as members see them.
const GUTTER = '60px';
const canvasMax = `calc(${CONTENT_READING} + ${GUTTER})`;
const config = { groups: GROUPS, customFieldsHref: withBase('/prototypes/workspace-settings/custom-fields') };
---
<div class="firma2-intake-builder" data-config={JSON.stringify(config)}>
  <Firma2SidePanel id="intake-fields" title="Fields" max={canvasMax}>
    <Firma2IntakeFieldsDrawer slot="panel" />
    <div class="stack" data-gap="xl">
      <!-- The page's own title, the tease and the form's name start where the
           blocks' text does, past the grip gutter, as a page's title
           lines up with its text. -->
      <div class="firma2-intake-builder__lead stack" data-gap="xl">
      <slot name="header" />

      <!-- Below Agency: the tease, above the standard form drawn read-only. -->
      <Firma2PlanLock needs="agency" message="Upgrade to Agency to add your own questions, screens and conditions." />

      <!-- First time here: make the fields, place them, word them, publish. -->
      <Firma2IntakeSetup />

      <!-- The form's name, typed in place as Tally's is: the title members see on every page of it. -->
      <p class="firma2-intake-builder__form-title typography-heading-lg" role="textbox" aria-label="Form name" data-placeholder="Form name" spellcheck="true" data-form-title></p>
      </div>
      <div class="firma2-intake-builder__canvas" data-canvas></div>

      <!-- The last, fixed break: what members read once they submit. -->
      <section class="firma2-intake-builder__after stack" data-gap="md" aria-labelledby="intake-after-title">
        <h2 class="typography-heading-md firma2-intake-builder__break-title" id="intake-after-title">After submitting</h2>
        <Firma2RichText label="Message after submitting" placeholder="What happens next" />
      </section>

      <bcn-insert-menu aria-label="Add to the form" data-menu></bcn-insert-menu>

      <!-- Formatting for a selection in a question's label or help: what the
           member's form can show there (src/lib/inline-format.ts). The page
           editor's selection toolbar, cut to the three that fit one line. -->
      <div class="firma2-intake-builder__format cluster" data-gap="xs" role="toolbar" aria-label="Formatting" hidden data-format-bar>
        <EsaButton variant="chrome" size="sm" iconOnly icon="bold" label="Bold" data-format="bold" aria-pressed="false" />
        <EsaButton variant="chrome" size="sm" iconOnly icon="italic" label="Italic" data-format="italic" aria-pressed="false" />
        <EsaButton variant="chrome" size="sm" iconOnly icon="link" label="Link" data-format="link" aria-pressed="false" />
      </div>
      <esa-dialog heading="Link" size="sm" show-close-button data-label-link-dialog>
        <esa-text-field label="Web address" size="md" type="url" inputmode="url" placeholder="https://" data-label-link-url></esa-text-field>
        <div class="cluster" data-gap="xs" slot="footer">
          <EsaButton variant="primary" size="md" data-label-link-save>Save</EsaButton>
          <EsaButton variant="ghost" size="md" data-label-link-remove>Remove</EsaButton>
          <EsaButton variant="ghost" size="md" data-label-link-cancel>Cancel</EsaButton>
        </div>
      </esa-dialog>

      <!-- Runtime rows clone their legos from these. -->
      <template data-tpl="grip"><EsaButton variant="chrome" size="md" iconOnly icon="menu" aria-label="Move">Move</EsaButton></template>
      <template data-tpl="remove-condition"><EsaButton variant="chrome" size="md" iconOnly icon="x" aria-label="Remove condition">Remove condition</EsaButton></template>
      <template data-tpl="lock"><esa-tooltip text="Every project needs this"><EsaIcon name="lock" size="sm" /></esa-tooltip></template>
      <template data-tpl="text-block"><Firma2RichText label="Text" placeholder="Write something" /></template>
    </div>
  </Firma2SidePanel>
</div>

<style>
  .firma2-intake-builder :global([hidden]) {
    display: none !important;
  }

  /* Below Agency there is nothing to add, so no drawer and no way to open it. */
  .firma2-intake-builder[data-plan-locked] :global(.firma2-side-panel) {
    display: none !important;
  }

  /* Where a field dragged from the drawer will land: a line in the gap. */
  /* Drawn on the block, so the line starts where its text does, not under the grip. */
  .firma2-intake-builder :global(.firma2-intake-blocks > li[data-drop-after] > .firma2-intake-block) {
    box-shadow: 0 calc(var(--spacing-100) + 1px) 0 0 var(--color-content-brand);
  }

  .firma2-intake-builder :global(.firma2-intake-blocks > li[data-drop-before] > .firma2-intake-block) {
    box-shadow: 0 calc((var(--spacing-100) + 1px) * -1) 0 0 var(--color-content-brand);
  }

  .firma2-intake-builder__lead,
  .firma2-intake-builder__after {
    padding-inline-start: calc(var(--control-height-md, 2.5rem) + var(--spacing-100) + var(--spacing-400));
  }

  /* Lined up with the blocks' text below it. */
  .firma2-intake-builder__form-title {
    margin: 0;
    padding: var(--spacing-200) var(--spacing-300);
    margin-inline: calc(var(--spacing-300) * -1);
    border-radius: var(--radius-md);
    outline-offset: 2px;
  }

  .firma2-intake-builder__form-title[contenteditable]:hover {
    background: var(--color-background-elevation-sunken);
  }

  .firma2-intake-builder__form-title:empty::before {
    content: attr(data-placeholder);
    color: var(--color-text-secondary);
  }

  .firma2-intake-builder :global(.firma2-intake-blocks) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
  }

  /* The grip bcn-sortable-list puts first in each row, the +, then the block. */
  .firma2-intake-builder :global(.firma2-intake-blocks > li) {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-100);
  }

  .firma2-intake-builder :global(.firma2-intake-block) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
    padding: var(--spacing-400);
    border-radius: var(--radius-md);
  }

  /* Selection is the hover tint, held: the focused text shows its own ring. */
  .firma2-intake-builder :global(.firma2-intake-blocks > li:is(:hover, [data-selected]) .firma2-intake-block) {
    background: var(--color-background-elevation-sunken);
  }

  /* That ring is the house one: focus.css skips contenteditable, which would
     leave the canvas text on the browser's default ring. */
  .firma2-intake-builder :global([contenteditable]:focus-visible) {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, #3e9b4f);
    outline-offset: var(--focus-ring-offset, 2px);
  }

  /* focus.css's corner, for text that sets none of its own. */
  .firma2-intake-builder :global(:where([contenteditable])) {
    border-radius: var(--radius-sm, 0.25rem);
  }

  /* Typing a placeholder is typing in the box, so the box takes the focus the
     lego would show: its border and ring, drawn on the lego itself. */
  .firma2-intake-builder :global(.firma2-intake-box:has(.firma2-intake-box__placeholder:focus-visible) [data-answer]) {
    --form-border-color: var(--form-border-color-focus, #3e9b4f);
    border-radius: var(--radius-md, 0.5rem);
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, #3e9b4f);
    outline-offset: var(--focus-ring-offset, 2px);
  }

  .firma2-intake-builder :global(.firma2-intake-box__placeholder[contenteditable]:focus-visible) {
    outline-color: transparent;
  }

  /* The grip appears with the row, so the canvas reads as the form at rest. */
  .firma2-intake-builder :global(.firma2-intake-blocks > li > [data-sort-grip]) {
    opacity: 0;
    transition: opacity 120ms ease-out;
  }

  .firma2-intake-builder :global(.firma2-intake-blocks > li:is(:hover, :focus-within, [data-selected]) > [data-sort-grip]) {
    opacity: 1;
  }

  /* A screen break: a rule, the step, the screen's title. */
  .firma2-intake-builder :global(.firma2-intake-block[data-kind='break']) {
    padding-block-start: var(--spacing-600);
    border-block-start: 1px solid var(--color-border-default);
    border-radius: 0;
  }

  .firma2-intake-builder :global(.firma2-intake-blocks > li:first-child .firma2-intake-block[data-kind='break']) {
    padding-block-start: var(--spacing-400);
    border-block-start: 0;
  }

  .firma2-intake-builder :global(.firma2-intake-break__step),
  .firma2-intake-builder :global(.firma2-intake-block__meta),
  .firma2-intake-builder :global(.firma2-intake-block__lock) {
    color: var(--color-text-secondary);
  }

  .firma2-intake-builder :global(.firma2-intake-break__title),
  .firma2-intake-builder__break-title {
    margin: 0;
    min-width: 8ch;
    outline-offset: 2px;
  }

  .firma2-intake-builder :global(.firma2-intake-block__head) {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--spacing-200);
  }

  /* The legos' own label and help roles, so the canvas reads as their fields do. */
  .firma2-intake-builder :global(.firma2-intake-block__label) {
    color: var(--form-label-color, var(--color-text-secondary));
    outline-offset: 2px;
  }

  .firma2-intake-builder :global(.firma2-intake-block__required) {
    color: var(--color-content-utility-danger);
    outline-offset: 2px;
  }

  /* The Required switch: the member's red `*` when on; a faint `*` to click
     while the row is pointed at, selected or focused when off. */
  .firma2-intake-builder :global([role='switch'].firma2-intake-block__required) {
    cursor: pointer;
  }

  .firma2-intake-builder :global([role='switch'].firma2-intake-block__required[aria-checked='false']) {
    color: var(--color-text-secondary);
    opacity: 0;
  }

  .firma2-intake-builder :global(.firma2-intake-blocks > li:is(:hover, :focus-within, [data-selected]) [role='switch'].firma2-intake-block__required[aria-checked='false']) {
    opacity: 1;
  }

  .firma2-intake-builder :global(.firma2-intake-block__lock) {
    align-self: center;
    opacity: 0;
  }

  .firma2-intake-builder :global(.firma2-intake-blocks > li:is(:hover, :focus-within, [data-selected]) .firma2-intake-block__lock) {
    opacity: 1;
  }

  .firma2-intake-builder :global(.firma2-intake-block__meta) {
    margin: 0;
  }

  .firma2-intake-builder :global(.firma2-intake-block__meta a) {
    color: var(--color-content-brand);
  }

  /* "Saves to" and the locked note belong to the selected block only. */
  .firma2-intake-builder :global(.firma2-intake-blocks > li:not([data-selected]) [data-selected-only]) {
    display: none;
  }

  /* Formatting in a label or help line, as the member's form shows it. */
  .firma2-intake-builder :global([data-inline-format] a) {
    color: var(--color-content-brand);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* esa-popover's surface, token for token — firma2-rich-text's toolbar. */
  .firma2-intake-builder__format {
    position: fixed;
    z-index: var(--z-popover, 1000);
    padding: var(--spacing-100);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    box-shadow: var(--elevation-4, 0 6px 24px -6px rgba(0, 0, 0, 0.07));
  }

  .firma2-intake-builder__format :global([data-format][aria-pressed='true']) {
    background: var(--color-background-elevation-sunken);
    color: var(--color-content-brand);
  }

  .firma2-intake-builder :global(.firma2-intake-block__help) {
    color: var(--color-text-secondary);
    margin: 0;
    outline-offset: 2px;
  }

  .firma2-intake-builder :global(.firma2-intake-block__help:empty:not(:focus)) {
    display: none;
  }

  .firma2-intake-builder :global([data-selected] .firma2-intake-block__help:empty:not(:focus)) {
    display: block;
  }

  .firma2-intake-builder :global([contenteditable]:empty::before) {
    content: attr(data-placeholder);
    color: var(--color-text-tertiary, var(--color-text-secondary));
  }

  /* The condition row: its two legos side by side, the × at the end. */
  .firma2-intake-builder :global(.firma2-intake-when) {
    align-items: flex-end;
  }

  .firma2-intake-builder :global(.firma2-intake-when > esa-select) {
    flex: 1 1 14rem;
  }

  /* A text block is as tall as its text; the writing room an empty page
     editor keeps would open a gap in the form. */
  .firma2-intake-builder :global(.firma2-intake-block .firma2-rich-text__content) {
    min-block-size: 1.5em;
  }

  .firma2-intake-builder :global(.firma2-intake-preview) {
    pointer-events: none;
  }

  /* A free-text box with its placeholder typed straight into it: the text sits
     on the lego's own text area (positioned by the script), in the
     placeholder's ink, so it reads exactly as members will see it. */
  .firma2-intake-builder :global(.firma2-intake-box) {
    position: relative;
  }

  .firma2-intake-builder :global(.firma2-intake-box__placeholder) {
    position: absolute;
    display: flex;
    box-sizing: border-box;
    overflow: hidden;
    white-space: nowrap;
    color: var(--color-text-secondary);
    cursor: text;
    outline-offset: -2px;
  }

  /* Its own prompt only on the row being edited; at rest an empty box is empty. */
  .firma2-intake-builder :global(.firma2-intake-blocks > li:not([data-selected]) .firma2-intake-box__placeholder:empty:not(:focus)::before) {
    content: none;
  }

  .firma2-intake-builder :global(.firma2-intake-location__map) {
    height: 14rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-default);
  }

  /* A blank line: where `/` opens the list and typed words become text. It
     sits in the block column, after the same gutter every block has. */
  .firma2-intake-builder :global(.firma2-intake-add) {
    flex: 1;
    min-width: 0;
    padding: var(--spacing-300) var(--spacing-400);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    outline-offset: 2px;
  }

  /* Read-only (free tier): no grip, so each row keeps its room empty
     and the questions stay where the title says they start. */
  .firma2-intake-builder :global(.firma2-intake-blocks[data-locked] > li),
  .firma2-intake-builder :global(.firma2-intake-blocks > li.firma2-intake-add-row) {
    padding-inline-start: calc(var(--control-height-md, 2.5rem) + var(--spacing-100));
  }

  .firma2-intake-builder :global(.firma2-intake-add:empty::before) {
    content: attr(data-placeholder);
    color: var(--color-text-secondary);
  }

  .firma2-intake-builder__after {
    padding-block: var(--spacing-600) var(--spacing-1000, 5rem);
    border-block-start: 1px solid var(--color-border-default);
  }

  /* A block or screen just added settles in from 4px above; a removed one fades
     where it stood. transform and opacity only. --animation-enter carries the
     theme's arrival curve and is 0ms under reduced motion. */
  @keyframes firma2-intake-builder-arrive {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @keyframes firma2-intake-builder-leave {
    to {
      opacity: 0;
      transform: scale(0.98);
    }
  }

  .firma2-intake-builder :global([data-arriving]) {
    animation: firma2-intake-builder-arrive var(--animation-enter, 150ms cubic-bezier(0.23, 1, 0.32, 1));
  }

  .firma2-intake-builder :global([data-leaving]) {
    animation: firma2-intake-builder-leave var(--animation-enter, 150ms cubic-bezier(0.23, 1, 0.32, 1)) forwards;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .firma2-intake-builder :global(.firma2-intake-blocks > li > *) {
      transition: none;
    }
  }
</style>

<script>
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-checkbox-group';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-textarea';
  import '@esa/ecology/esa-radio-group';
  import '@esa/ecology/esa-combobox';
  import '@esa/ecology/esa-date-picker';
  import '@esa/ecology/esa-dropdown-menu';
  import '@esa/ecology/esa-tooltip';
  import '@esa/ecology/esa-dialog';
  import { isFormatted, sanitizeInline } from '../../lib/inline-format';
  import '../shared/bcn-sortable-list';
  import '../shared/bcn-insert-menu';
  import type { BcnInsertMenu, InsertItem } from '../shared/bcn-insert-menu';
  import { announce } from '@esa/ecology/announcer';
  import { DEFAULT_FORM_TITLE, STANDARD_FORM, builtin } from '../../data/firma2-intake';
  import type { Block, BuiltinKey, Condition, IntakeForm, QuestionBlock, Screen } from '../../data/firma2-intake';
  import { allFields } from '../../lib/project-type-draft';
  import {
    builtinsInForm,
    conditionOptions,
    conditionSources,
    duplicateBlock,
    fieldsInForm,
    findBlock,
    insertBlock,
    isLocked,
    isQuestion,
    newId,
    publish,
    readFormStore,
    relayout,
    removeBlock,
    removeScreen,
    saveWorking,
    splitScreen,
    updateBlock,
    updateScreen,
  } from '../../lib/intake-form';
  import { planIncludes } from '../../lib/workspace-plan';
  import { withBase } from '../../lib/base';
  import { PLACEHOLDER_INPUTS, controlMarkup, hydrateQuestions, inputOf } from '../../lib/intake-render';

  type Control = HTMLElement & { value: unknown; options?: unknown; label?: string; size?: string; helpText?: string; placeholder?: string };
  type Row = { kind: 'head' | 'break'; screen: Screen; i: number } | { kind: 'block'; block: Block; screen: Screen };
  type Target = { afterId?: string; screenId?: string; index?: number };

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  document.querySelectorAll<HTMLElement>('.firma2-intake-builder').forEach((root) => {
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const { groups, customFieldsHref }: { groups: { name: string; items: { id: string; label: string }[] }[]; customFieldsHref: string } = JSON.parse(root.dataset.config ?? '{}');
    const canvas = $('[data-canvas]');
    const menu = $<BcnInsertMenu>('[data-menu]');
    const locked = !planIncludes('agency');
    root.toggleAttribute('data-plan-locked', locked);

    let form: IntakeForm = locked ? structuredClone(STANDARD_FORM) : readFormStore().working;
    /** The selected row: a block id or a screen id. */
    let selected: string | null = null;
    /** The row a blank line is open under, besides the one that ends the canvas. */
    let lineAfter: string | null = null;
    /** Blocks and screens whose condition row is open before a question is picked. */
    const conditionOpen = new Set<string>();
    // Fields are read, never written: Custom fields owns them.
    const fields = () => allFields();
    const getField = (id: string) => fields().find((f) => f.id === id);
    const fieldHref = (id: string) => `${customFieldsHref}?field=${encodeURIComponent(id)}`;
    // Text blocks keep their editor across repaints: a ProseMirror view moved
    // in the DOM keeps working, and rebuilding it would lose the caret.
    const textEditors = new Map<string, HTMLElement>();

    // firma2-rich-text's script may run after this one; an editor not yet
    // mounted is asked again on the next frame until it is.
    const withEditor = (editor: HTMLElement, fn: () => void) => {
      if (editor.hasAttribute('data-mounted')) return fn();
      editor.dispatchEvent(new CustomEvent('firma2:rich-text-mount', { bubbles: true }));
      if (editor.hasAttribute('data-mounted')) return fn();
      requestAnimationFrame(() => withEditor(editor, fn));
    };

    const tpl = (name: string) => $<HTMLTemplateElement>(`template[data-tpl="${name}"]`).content.cloneNode(true) as DocumentFragment;
    const firstEl = (name: string) => tpl(name).firstElementChild as HTMLElement;
    const setButtonText = (button: HTMLElement, text: string) => ((button.querySelector('.esa-button__label') ?? button).textContent = text);

    // A runtime lego, its properties set once it is defined — a value set on a
    // not-yet-upgraded element shadows the lego's own accessor.
    const lego = <T extends Control>(tag: string, props: Partial<T>, attrs: Record<string, string> = {}) => {
      const el = document.createElement(tag) as T;
      Object.entries(attrs).forEach(([k, v]) => el.setAttribute(k, v));
      void customElements.whenDefined(tag).then(() => Object.assign(el, props));
      return el;
    };

    // ---- the menu's list -----------------------------------------------------
    // Layout only: questions come from the Fields drawer.
    const items = (): InsertItem[] => {
      const placed = builtinsInForm(form);
      return groups.flatMap((g) =>
        g.items.map((i) => {
          const inForm = i.id.startsWith('builtin:') && placed.has(i.id.slice(8) as BuiltinKey);
          return { ...i, group: g.name, disabled: inForm, note: inForm ? 'In form' : undefined };
        }),
      );
    };

    // ---- saving --------------------------------------------------------------
    const commit = (next: IntakeForm, repaint = true) => {
      form = next;
      saveWorking(form);
      root.dispatchEvent(new CustomEvent('firma2:intake-saved', { bubbles: true }));
      if (repaint) render();
    };

    // ---- labels --------------------------------------------------------------
    const questionName = (b: QuestionBlock) => b.label || 'Untitled question';
    const rowName = (key: string) => {
      const b = findBlock(form, key);
      if (b) return b.type === 'text' ? 'Text' : questionName(b);
      const i = form.screens.findIndex((s) => s.id === key);
      return form.screens[i]?.title || `Screen ${i + 1}`;
    };

    // ---- the rows ------------------------------------------------------------
    const rows = (): Row[] => {
      const out: Row[] = [];
      form.screens.forEach((screen, i) => {
        if (i > 0 || form.screens.length > 1) out.push({ kind: i === 0 ? 'head' : 'break', screen, i });
        screen.blocks.forEach((block) => out.push({ kind: 'block', block, screen }));
      });
      return out;
    };
    const keyOf = (r: Row) => (r.kind === 'block' ? r.block.id : r.screen.id);

    /** Where something added below a row goes. */
    const below = (key: string | null): Target => {
      if (!key) return { screenId: form.screens[form.screens.length - 1].id };
      if (form.screens.some((s) => s.id === key)) return { screenId: key, index: 0 };
      return { afterId: key };
    };

    // Lay the form out again from a flat order of row keys: a break starts its
    // screen; everything else joins the screen above it.
    const layoutFrom = (keys: string[]) => {
      const screenIds = new Set(form.screens.map((s) => s.id));
      const order: { screenId: string; blockIds: string[] }[] = [{ screenId: form.screens[0].id, blockIds: [] }];
      keys.forEach((k) => {
        if (k === form.screens[0].id) return;
        if (screenIds.has(k)) order.push({ screenId: k, blockIds: [] });
        else order[order.length - 1].blockIds.push(k);
      });
      commit(relayout(form, order));
    };
    const flatKeys = () => rows().filter((r) => r.kind !== 'head').map(keyOf);

    // ---- editable text -------------------------------------------------------
    const editable = (tag: string, cls: string, text: string, attrs: Record<string, string>) => {
      const el = document.createElement(tag);
      el.className = cls;
      if (!locked) {
        el.contentEditable = 'plaintext-only';
        el.spellcheck = true;
        el.setAttribute('role', 'textbox');
      }
      el.textContent = text;
      Object.entries(attrs).forEach(([k, v]) => el.setAttribute(k, v));
      return el;
    };
    // One line of copy that takes bold, italic and links: a question's label or
    // help. Pasting brings the text only; the formatting is what you add here.
    const richEditable = (tag: string, cls: string, html: string | undefined, text: string, attrs: Record<string, string>) => {
      const el = editable(tag, cls, text, attrs);
      if (html && isFormatted(html)) el.innerHTML = sanitizeInline(html).html;
      if (locked) return el;
      el.contentEditable = 'true';
      el.dataset.inlineFormat = '';
      el.addEventListener('paste', (e) => {
        e.preventDefault();
        document.execCommand('insertText', false, (e.clipboardData?.getData('text/plain') ?? '').replace(/\s+/g, ' '));
      });
      el.addEventListener('keydown', (e) => {
        if (!(e.metaKey || e.ctrlKey)) return;
        const k = e.key.toLowerCase();
        if (k === 'b' || k === 'i') {
          e.preventDefault();
          document.execCommand(k === 'b' ? 'bold' : 'italic');
        } else if (k === 'k') {
          e.preventDefault();
          openLink();
        }
      });
      return el;
    };
    /** The copy in a formattable line: its plain text, and its HTML when formatted. */
    const readRich = (el: HTMLElement) => {
      const { html, text } = sanitizeInline(el.innerHTML);
      // Emptied, a contenteditable keeps a <br>; clear it so the prompt shows again.
      if (!text && el.innerHTML) el.innerHTML = '';
      return { text, html: isFormatted(html) ? html : undefined };
    };

    // Enter at the end of a single-line field opens a blank line under its block.
    const enterOpensLine = (el: HTMLElement, key: string) =>
      el.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        openLine(key);
      });

    // ---- settings on the block -----------------------------------------------
    const requiredSwitch = (block: QuestionBlock) => {
      const star = document.createElement('span');
      star.className = 'firma2-intake-block__required typography-label-md';
      star.textContent = '*';
      if (locked || isLocked(block)) {
        star.setAttribute('aria-hidden', 'true');
        star.hidden = !block.required;
        return star;
      }
      star.setAttribute('role', 'switch');
      star.setAttribute('aria-checked', String(block.required));
      star.setAttribute('aria-label', 'Required');
      star.title = block.required ? 'Click to make optional' : 'Click to make required';
      star.tabIndex = 0;
      const toggle = () => setRequired(block.id);
      star.addEventListener('click', toggle);
      star.addEventListener('keydown', (e) => {
        if (e.key !== ' ' && e.key !== 'Enter') return;
        e.preventDefault();
        toggle();
      });
      star.dataset.fk = `required:${block.id}`;
      return star;
    };

    const setRequired = (id: string) => {
      const b = findBlock(form, id);
      if (!b || !isQuestion(b) || isLocked(b)) return;
      commit(updateBlock(form, id, { required: !b.required }));
      announce(b.required ? 'Optional.' : 'Required.');
    };

    // "Saves to <field>": where this question's answer is kept; the link opens
    // that field in Custom fields.
    const savesTo = (block: Extract<Block, { type: 'field' }>) => {
      const field = getField(block.fieldId);
      const p = document.createElement('p');
      p.className = 'firma2-intake-block__meta typography-body-sm';
      p.dataset.selectedOnly = '';
      if (!field) return p;
      p.innerHTML = `Saves to <a href="${esc(fieldHref(field.id))}">${esc(field.label)}</a>`;
      return p;
    };

    // A standard question: where its choices live (the lock's tooltip says why a locked one stays).
    const builtinNote = (block: Extract<Block, { type: 'builtin' }>) => {
      const from = builtin(block.key).choicesFrom;
      if (!from) return null;
      const p = document.createElement('p');
      p.className = 'firma2-intake-block__meta typography-body-sm';
      p.dataset.selectedOnly = '';
      p.innerHTML = `Change its choices in <a href="${esc(withBase(from.href))}">${esc(from.page)}</a>.`;
      return p;
    };

    // The condition row: Show only when <earlier question> — the answer is any of <…>.
    const conditionRow = (targetId: string, when: Condition | undefined) => {
      const row = document.createElement('div');
      row.className = 'firma2-intake-when cluster';
      row.dataset.gap = 'sm';
      const sources = conditionSources(form, targetId);
      const source = lego('esa-select', {
        label: 'Show only when',
        size: 'md',
        placeholder: 'Pick a question',
        options: sources.map((s) => ({ label: questionName(s), value: s.id })),
        value: when?.source ?? '',
        helpText: sources.length ? '' : 'Needs a yes-or-no or choice question above.',
      });
      source.dataset.fk = `when:${targetId}`;
      source.addEventListener('change', (e) => {
        const id = String((e as CustomEvent<{ value: string }>).detail.value);
        if (!id) return;
        const opts = conditionOptions(findBlock(form, id)!, fields()) ?? [];
        conditionOpen.delete(targetId);
        // Start from the first answer, so the rule is complete the moment it exists.
        setWhen(targetId, { source: id, op: 'is', values: opts.slice(0, 1) });
      });
      row.append(source);
      if (when) {
        const opts = conditionOptions(findBlock(form, when.source)!, fields()) ?? [];
        const values = lego('esa-checkbox-group', { label: 'The answer is any of', size: 'md', options: opts.map((o) => ({ label: o, value: o })), value: when.values });
        values.addEventListener('change', (e) => {
          const picked = ((e as CustomEvent<{ value: string[] }>).detail.value ?? []).map(String);
          if (!picked.length) return; // a rule must name at least one answer
          setWhen(targetId, { ...when, op: picked.length > 1 ? 'is-any-of' : 'is', values: picked });
        });
        row.append(values);
      }
      const remove = firstEl('remove-condition');
      remove.addEventListener('click', () => {
        conditionOpen.delete(targetId);
        setWhen(targetId, undefined);
        announce('Condition removed.');
      });
      row.append(remove);
      return row;
    };

    const setWhen = (targetId: string, when: Condition | undefined) => {
      if (form.screens.some((s) => s.id === targetId)) commit(updateScreen(form, targetId, { when }));
      else commit(updateBlock(form, targetId, { when }));
    };

    // ---- block bodies ----------------------------------------------------------
    const questionNode = (block: QuestionBlock) => {
      const body = document.createElement('div');
      body.className = 'firma2-intake-block';
      body.dataset.blockId = block.id;
      const head = document.createElement('div');
      head.className = 'firma2-intake-block__head';
      // A standard question keeps its own name everywhere, so on the canvas it
      // is shown, not edited. Focusable all the same, so a keyboard can select it.
      if (block.type === 'builtin') {
        const fixed = document.createElement('span');
        fixed.className = 'firma2-intake-block__label typography-label-md';
        fixed.textContent = builtin(block.key).label;
        fixed.tabIndex = locked ? -1 : 0;
        fixed.dataset.fk = `label:${block.id}`;
        if (!locked) enterOpensLine(fixed, block.id);
        head.append(fixed, requiredSwitch(block));
        if (isLocked(block) && !locked) {
          const lock = firstEl('lock');
          lock.classList.add('firma2-intake-block__lock');
          head.append(lock);
        }
      } else {
        const label = richEditable('span', 'firma2-intake-block__label typography-label-md', block.labelHtml, block.label, {
          'aria-label': 'Question',
          'data-placeholder': 'Type a question',
          'data-fk': `label:${block.id}`,
        });
        enterOpensLine(label, block.id);
        label.addEventListener('keydown', (e) => {
          // Backspace on a question nobody has started removes it, as an empty line goes.
          if (e.key !== 'Backspace' || (label.textContent ?? '') !== '' || !isUntouched(block.id)) return;
          e.preventDefault();
          removeRow(block.id, { quiet: true });
        });
        label.addEventListener('input', () => {
          const { text, html } = readRich(label);
          commit(updateBlock(form, block.id, { label: text, labelHtml: html }), false);
        });
        head.append(label, requiredSwitch(block));
      }
      body.append(head);

      // Choices included: they are the field's, drawn as members see them.
      {
        const preview = document.createElement('div');
        preview.className = 'firma2-intake-preview';
        preview.inert = true;
        // The box is drawn without its placeholder: on the canvas the
        // placeholder is the text typed over it, below.
        preview.innerHTML = controlMarkup({ ...block, placeholder: undefined }, fields(), { labelled: false });
        // CLICK INTO THE BOX AND TYPE, as in Tally: what you type there is
        // the example text members see in the empty box. Laid exactly over
        // the lego's own text area (placeOverlays) so it reads as the box's.
        if (!locked && PLACEHOLDER_INPUTS.has(inputOf(block, fields()))) {
          const wrap = document.createElement('div');
          wrap.className = 'firma2-intake-box';
          const ph = editable('span', 'firma2-intake-box__placeholder typography-body-md', block.placeholder ?? '', {
            'aria-label': 'Placeholder',
            'data-placeholder': 'Add a placeholder',
            'data-fk': `ph:${block.id}`,
          });
          enterOpensLine(ph, block.id);
          ph.addEventListener('input', () => commit(updateBlock(form, block.id, { placeholder: ph.textContent || undefined }), false));
          wrap.append(preview, ph);
          body.append(wrap);
        } else body.append(preview);
      }

      const help = richEditable('p', 'firma2-intake-block__help typography-body-sm', block.helpHtml, block.help ?? '', {
        'aria-label': 'Help text',
        'data-placeholder': 'Add help text',
        'data-fk': `help:${block.id}`,
      });
      if (locked && !block.help) help.hidden = true;
      enterOpensLine(help, block.id);
      help.addEventListener('input', () => {
        const { text, html } = readRich(help);
        commit(updateBlock(form, block.id, { help: text || undefined, helpHtml: html }), false);
      });
      body.append(help);

      if (!locked) {
        if (block.type === 'field') body.append(savesTo(block));
        const note = block.type === 'builtin' ? builtinNote(block) : null;
        if (note) body.append(note);
        if (block.when || conditionOpen.has(block.id)) body.append(conditionRow(block.id, block.when));
      }
      return body;
    };

    const textNode = (block: Extract<Block, { type: 'text' }>) => {
      const body = document.createElement('div');
      body.className = 'firma2-intake-block';
      body.dataset.blockId = block.id;
      let editor = textEditors.get(block.id);
      if (!editor) {
        editor = firstEl('text-block');
        textEditors.set(block.id, editor);
        const el = editor;
        // Mounted once it is in the document — the next frame, after render.
        requestAnimationFrame(() =>
          withEditor(el, () => {
            el.dispatchEvent(new CustomEvent('firma2:rich-text-set', { detail: { html: block.html } }));
            if (locked) el.dispatchEvent(new CustomEvent('firma2:rich-text-editable', { detail: { editable: false } }));
          }),
        );
        editor.addEventListener('firma2:rich-text-change', (e) => {
          commit(updateBlock(form, block.id, { html: (e as CustomEvent<{ html: string }>).detail.html }), false);
        });
        // Backspace in an empty text block removes it.
        editor.addEventListener(
          'keydown',
          (e) => {
            if (e.key !== 'Backspace' || (editor!.querySelector('.ProseMirror')?.textContent ?? 'x') !== '' || editor!.querySelector('img, [data-file-embed]')) return;
            e.preventDefault();
            e.stopPropagation();
            removeRow(block.id, { quiet: true });
          },
          true,
        );
      }
      body.append(editor);
      if (!locked && (block.when || conditionOpen.has(block.id))) body.append(conditionRow(block.id, block.when));
      return body;
    };

    const breakNode = (screen: Screen, i: number) => {
      const body = document.createElement('div');
      body.className = 'firma2-intake-block stack';
      body.dataset.gap = 'xs';
      body.dataset.kind = 'break';
      const step = document.createElement('span');
      step.className = 'firma2-intake-break__step typography-body-md';
      step.textContent = `Screen ${i + 1} of ${form.screens.length}`;
      const title = editable('h2', 'firma2-intake-break__title typography-heading-md', screen.title, {
        'aria-label': `Title of screen ${i + 1}`,
        'data-placeholder': 'Screen title',
        'data-fk': `screen:${screen.id}`,
      });
      enterOpensLine(title, screen.id);
      title.addEventListener('input', () => commit(updateScreen(form, screen.id, { title: title.textContent ?? '' }), false));
      body.append(step, title);
      if (!locked && i > 0 && (screen.when || conditionOpen.has(screen.id))) body.append(conditionRow(screen.id, screen.when));
      return body;
    };

    // ---- the grip's actions ---------------------------------------------------
    const actionsFor = (r: Row) => {
      const act: { label: string; action: string; variant?: 'danger' }[] = [];
      if (r.kind === 'break') {
        act.push({ label: r.screen.when ? 'Remove condition' : 'Add condition', action: r.screen.when ? 'uncondition' : 'condition' });
        act.push({ label: 'Remove screen', action: 'remove', variant: 'danger' });
        return act;
      }
      if (r.kind !== 'block') return act;
      const b = r.block;
      if (isLocked(b)) return act;
      if (b.type !== 'builtin') act.push({ label: 'Duplicate', action: 'duplicate' });
      if (isQuestion(b)) act.push({ label: b.required ? 'Make optional' : 'Make required', action: 'required' });
      act.push({ label: b.when ? 'Remove condition' : 'Add condition', action: b.when ? 'uncondition' : 'condition' });
      act.push({ label: b.type === 'text' ? 'Remove text' : 'Remove question', action: 'remove', variant: 'danger' });
      return act;
    };

    canvas.addEventListener('menu-action', (e) => {
      const action = (e as CustomEvent<string>).detail;
      const key = (e.target as HTMLElement).closest<HTMLElement>('li[data-sort-key]')?.dataset.sortKey;
      if (!key) return;
      if (action === 'duplicate') duplicate(key);
      if (action === 'required') setRequired(key);
      if (action === 'remove') removeRow(key);
      if (action === 'uncondition') {
        setWhen(key, undefined);
        announce('Condition removed.');
      }
      if (action === 'condition') {
        conditionOpen.add(key);
        select(key);
        render();
        requestAnimationFrame(() => canvas.querySelector<HTMLElement>(`[data-fk="when:${CSS.escape(key)}"]`)?.focus());
      }
    });

    // ---- rows --------------------------------------------------------------------
    const rowNode = (r: Row) => {
      const li = document.createElement('li');
      const key = keyOf(r);
      li.dataset.sortKey = key;
      li.dataset.sortLabel = rowName(key);
      if (selected === key) li.dataset.selected = '';
      if (r.kind === 'head') li.dataset.sortLocked = '';
      const own = actionsFor(r);
      if (own.length) li.dataset.sortActions = JSON.stringify(own);
      li.append(r.kind === 'block' ? (r.block.type === 'text' ? textNode(r.block) : questionNode(r.block)) : breakNode(r.screen, r.i));
      return li;
    };

    // A blank line: `/` opens the list; typed words and Enter make a text block.
    const addLine = (after: string | null) => {
      const li = document.createElement('li');
      li.className = 'firma2-intake-add-row';
      const line = document.createElement('div');
      line.className = 'firma2-intake-add typography-body-md';
      line.contentEditable = 'plaintext-only';
      line.dataset.placeholder = 'Type text, or / for a new screen';
      line.dataset.fk = `add:${after ?? 'end'}`;
      line.setAttribute('role', 'combobox');
      line.setAttribute('aria-label', 'Add to the form');
      line.setAttribute('aria-expanded', 'false');
      line.setAttribute('aria-autocomplete', 'list');
      line.addEventListener('input', () => {
        const text = line.textContent ?? '';
        if (!text.startsWith('/')) return menu.owner === line && menu.close();
        menuTarget = below(after);
        if (menu.owner !== line) {
          menu.items = items();
          menu.open(line, { owner: line, query: text.slice(1) });
        } else menu.filter(text.slice(1));
      });
      line.addEventListener('keydown', (e) => {
        if (menu.owner === line && menu.handleKey(e)) {
          if (e.key === 'Escape') line.textContent = '';
          return;
        }
        const text = (line.textContent ?? '').trim();
        if (e.key === 'Enter') {
          e.preventDefault();
          if (text && !text.startsWith('/')) {
            line.textContent = '';
            add('layout:text', below(after), `<p>${esc(text)}</p>`);
          }
          return;
        }
        if ((e.key === 'Backspace' && !text) || e.key === 'Escape') {
          if (after === null) return;
          e.preventDefault();
          lineAfter = null;
          render();
          focusKey(`label:${after}`) || focusKey(`screen:${after}`);
        }
      });
      line.addEventListener('blur', () => {
        if (menu.owner === line) return;
        if (!(line.textContent ?? '').startsWith('/')) line.textContent = '';
        // A line opened under a block goes when it is left empty.
        if (after !== null && lineAfter === after && !(line.textContent ?? '')) {
          requestAnimationFrame(() => {
            if (lineAfter !== after || canvas.contains(document.activeElement) && document.activeElement === line) return;
            lineAfter = null;
            render();
          });
        }
      });
      li.append(line);
      return li;
    };

    const openLine = (key: string) => {
      lineAfter = key;
      render();
      focusKey(`add:${key}`);
    };

    // ---- the canvas ----------------------------------------------------------
    const render = () => {
      const focusedKey = (document.activeElement as HTMLElement | null)?.dataset?.fk;
      const ol = document.createElement('ol');
      ol.className = 'firma2-intake-blocks';
      rows().forEach((r) => {
        ol.append(rowNode(r));
        if (!locked && lineAfter === keyOf(r)) ol.append(addLine(lineAfter));
      });
      if (!locked) ol.append(addLine(null));
      if (locked) {
        ol.dataset.locked = '';
        canvas.replaceChildren(ol);
      } else {
        const list = document.createElement('bcn-sortable-list');
        list.setAttribute('label', 'Form');
        const handle = document.createElement('template');
        handle.setAttribute('data-sort-handle', '');
        handle.content.append(tpl('grip'));
        list.append(handle, ol);
        canvas.replaceChildren(list);
      }
      // Drop editors of text blocks that left the form.
      const ids = new Set(form.screens.flatMap((s) => s.blocks.map((b) => b.id)));
      [...textEditors.keys()].filter((id) => !ids.has(id)).forEach((id) => textEditors.delete(id));
      void hydrateQuestions(canvas, form.screens.flatMap((s) => s.blocks.filter(isQuestion)), {}, fields(), false).then(() => requestAnimationFrame(placeOverlays));
      if (focusedKey) focusKey(focusedKey);
    };

    // Each placeholder sits on its box's own text area — measured inside the
    // lego, so a `$` prefix or a unit suffix keeps its room.
    const placeOverlays = () => {
      canvas.querySelectorAll<HTMLElement>('.firma2-intake-box').forEach((wrap) => {
        const ph = wrap.querySelector<HTMLElement>('.firma2-intake-box__placeholder');
        const native = wrap.querySelector<HTMLElement>('[data-answer]')?.shadowRoot?.querySelector<HTMLElement>('input, textarea');
        if (!ph || !native) return;
        const box = wrap.getBoundingClientRect();
        const r = native.getBoundingClientRect();
        const cs = getComputedStyle(native);
        Object.assign(ph.style, {
          left: `${r.left - box.left}px`,
          top: `${r.top - box.top}px`,
          width: `${r.width}px`,
          height: `${r.height}px`,
          paddingInline: `${cs.paddingLeft} ${cs.paddingRight}`,
          paddingBlock: native.tagName === 'TEXTAREA' ? cs.paddingTop : '0',
          alignItems: native.tagName === 'TEXTAREA' ? 'flex-start' : 'center',
        });
      });
    };
    window.addEventListener('resize', () => requestAnimationFrame(placeOverlays));

    // CLICK ANYWHERE AND TYPE. A click that lands on no control puts the caret
    // in the text nearest it, where it was clicked: beside a label is the end
    // of that label, under the last block is the blank line, the room around
    // the message after submitting is that message. Controls keep their clicks.
    const caretAt = (el: HTMLElement, x: number, y: number) => {
      el.focus({ preventScroll: true });
      const r = el.getBoundingClientRect();
      const cx = Math.min(Math.max(x, r.left + 1), r.right - 1);
      const cy = Math.min(Math.max(y, r.top + 1), r.bottom - 1);
      const doc = document as Document & { caretPositionFromPoint?: (x: number, y: number) => { offsetNode: Node; offset: number } | null };
      const hit = doc.caretPositionFromPoint?.(cx, cy);
      const range = document.createRange();
      if (hit && el.contains(hit.offsetNode)) {
        range.setStart(hit.offsetNode, hit.offset);
        range.collapse(true);
      } else {
        range.selectNodeContents(el);
        range.collapse(false);
      }
      const sel = getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
    };
    const CONTROLS = 'button, a, input, textarea, select, [role="switch"], esa-select, esa-checkbox-group, esa-text-field, esa-dropdown-menu, bcn-insert-menu, .firma2-intake-when, [contenteditable="plaintext-only"], [data-inline-format], .ProseMirror';
    const TYPEABLE = '[contenteditable="plaintext-only"], [data-inline-format][contenteditable="true"], .ProseMirror[contenteditable="true"]';
    const visible = (el: HTMLElement) => el.getBoundingClientRect().height > 0;
    const nearest = (els: HTMLElement[], y: number) =>
      els.reduce<{ el: HTMLElement; d: number } | null>((best, el) => {
        const r = el.getBoundingClientRect();
        const d = y < r.top ? r.top - y : y > r.bottom ? y - r.bottom : 0;
        return !best || d < best.d ? { el, d } : best;
      }, null)?.el ?? null;
    root.addEventListener('click', (e) => {
      if (locked || e.defaultPrevented || (e.target as HTMLElement).closest(CONTROLS)) return;
      if ((e.target as HTMLElement).closest('.firma2-intake-builder__lead')) return;
      const { clientX: x, clientY: y } = e;
      // The message after submitting: its editor, from anywhere in its section.
      if ((e.target as HTMLElement).closest('.firma2-intake-builder__after')) {
        const pm = root.querySelector<HTMLElement>('.firma2-intake-builder__after .ProseMirror');
        if (pm) caretAt(pm, x, y);
        return;
      }
      const rows = [...canvas.querySelectorAll<HTMLElement>('.firma2-intake-blocks > li')];
      if (!rows.length) return;
      // Past the last block: the blank line that ends the form.
      const last = rows[rows.length - 1].getBoundingClientRect();
      const row = y > last.bottom ? rows[rows.length - 1] : nearest(rows, y);
      if (!row) return;
      if (row.dataset.sortKey) select(row.dataset.sortKey);
      // Measured after selecting: a selected row shows its help line.
      const target = nearest([...row.querySelectorAll<HTMLElement>(TYPEABLE)].filter(visible), y);
      if (target) caretAt(target, x, y);
    });

    const focusKey = (key: string): boolean => {
      const el = canvas.querySelector<HTMLElement>(`[data-fk="${CSS.escape(key)}"]`);
      if (!el) return false;
      el.focus();
      if (el.isContentEditable) {
        // Caret to the end of what is already typed.
        const range = document.createRange();
        range.selectNodeContents(el);
        range.collapse(false);
        const sel = getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
      return true;
    };

    // ---- selection -----------------------------------------------------------
    const select = (key: string | null) => {
      if (key === selected) return;
      selected = key;
      canvas.querySelectorAll('[data-selected]').forEach((el) => el.removeAttribute('data-selected'));
      if (key) canvas.querySelector(`li[data-sort-key="${CSS.escape(key)}"]`)?.setAttribute('data-selected', '');
    };
    const rowKeyOf = (t: EventTarget | null) => (t as HTMLElement | null)?.closest?.<HTMLElement>('.firma2-intake-blocks > li[data-sort-key]')?.dataset.sortKey ?? null;
    // A press selects on its click, not on the focus its mousedown moves:
    // selecting reveals the new row's help and settings and folds the old
    // row's away, and doing that between press and release moved the page
    // under the pointer (scrolled to the bottom, a shorter page scrolls) so
    // the click landed on something else. The keyboard still selects on focus.
    let pressing = false;
    canvas.addEventListener('pointerdown', () => (pressing = true));
    window.addEventListener('pointerup', () => setTimeout(() => (pressing = false)));
    canvas.addEventListener('focusin', (e) => {
      const key = rowKeyOf(e.target);
      if (key && !pressing) select(key);
    });
    canvas.addEventListener('click', (e) => {
      const key = rowKeyOf(e.target);
      if (key) select(key);
    });

    // ---- keys: Escape, ⌘D, ⌥↑ ⌥↓ ------------------------------------------------
    root.addEventListener('keydown', (e) => {
      if (locked || menu.isOpen) return;
      if (e.key === 'Escape' && selected) {
        (document.activeElement as HTMLElement | null)?.blur();
        select(null);
        return;
      }
      if (!selected) return;
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'd') {
        e.preventDefault();
        duplicate(selected);
        return;
      }
      if (e.altKey && (e.key === 'ArrowUp' || e.key === 'ArrowDown')) {
        e.preventDefault();
        move(selected, e.key === 'ArrowUp' ? -1 : 1);
      }
    });

    const move = (key: string, by: -1 | 1) => {
      const keys = flatKeys();
      const i = keys.indexOf(key);
      const j = i + by;
      if (i === -1 || j < 0 || j >= keys.length) return;
      [keys[i], keys[j]] = [keys[j], keys[i]];
      const focusedKey = (document.activeElement as HTMLElement | null)?.dataset?.fk;
      layoutFrom(keys);
      if (focusedKey) focusKey(focusedKey);
      announce(`${rowName(key)} moved to ${j + 1} of ${keys.length}.`);
    };

    // ---- duplicating and removing --------------------------------------------
    const duplicate = (key: string) => {
      const { form: next, block } = duplicateBlock(form, key);
      if (!block) return;
      selected = block.id;
      commit(next);
      arrive(canvas.querySelector(`li[data-sort-key="${CSS.escape(block.id)}"]`));
      focusKey(`label:${block.id}`);
      announce(`${block.type === 'text' ? 'Text' : 'Question'} duplicated.`);
    };

    // A question emptied of everything: no wording, help, example or condition.
    const isUntouched = (id: string) => {
      const b = findBlock(form, id);
      return !!b && b.type === 'field' && !b.label && !b.help && !b.placeholder && !b.when;
    };

    const previousKey = (key: string) => {
      const keys = rows().map(keyOf);
      return keys[keys.indexOf(key) - 1] ?? null;
    };

    const removeRow = (key: string, { quiet = false } = {}) => {
      const isScreen = form.screens.some((s) => s.id === key);
      const block = isScreen ? undefined : findBlock(form, key);
      if (!isScreen && (!block || isLocked(block))) return;
      const back = previousKey(key);
      const finish = () => {
        if (isScreen) {
          commit(removeScreen(form, key));
          announce('Screen removed.');
        } else {
          if (selected === key) selected = null;
          commit(removeBlock(form, key));
          announce(`${block!.type === 'text' ? 'Text' : 'Question'} removed.`);
        }
        // Backspace carries on where it came from: the line above.
        if (quiet && back) focusKey(`label:${back}`) || focusKey(`screen:${back}`) || openLine(back);
      };
      // The row fades where it stood before its neighbours close the gap, so
      // it is clear which block went. The timeout covers a 0ms (reduced-motion)
      // animation that never fires its end.
      const row = canvas.querySelector<HTMLElement>(`li[data-sort-key="${CSS.escape(key)}"]`);
      if (quiet || !row || row.dataset.leaving != null) return finish();
      row.dataset.leaving = '';
      let done = false;
      const once = () => {
        if (done) return;
        done = true;
        finish();
      };
      row.addEventListener('animationend', once, { once: true });
      window.setTimeout(once, 250);
    };

    // ---- adding --------------------------------------------------------------
    // "New custom field" leaves for Custom fields; where it was asked for is
    // kept for the trip, so the new field comes back to that spot.
    const RETURN_KEY = 'firma2:intake-add-target';
    const leaveForNewField = (at: Target) => {
      try {
        sessionStorage.setItem(RETURN_KEY, JSON.stringify(at));
      } catch {
        // No storage: the field lands at the end of the form instead.
      }
      location.href = `${customFieldsHref}?new=1&for=intake`;
    };
    let menuTarget: Target = {};
    menu.addEventListener('insert-choose', (e) => {
      const owner = canvas.querySelector<HTMLElement>('.firma2-intake-add[aria-expanded="true"]');
      if (owner) owner.textContent = '';
      add((e as CustomEvent<{ id: string }>).detail.id, menuTarget);
    });
    menu.addEventListener('insert-close', () => {
      canvas.querySelectorAll<HTMLElement>('.firma2-intake-add').forEach((l) => {
        if (document.activeElement !== l) l.textContent = '';
      });
    });

    // WHERE IT LANDED. A block can land below the fold, and nothing else says
    // where it went: the new row is brought into view and settles in from 4px
    // above (motion tokens, so reduced motion is 0ms).
    const arrive = (el: Element | null) => {
      if (!(el instanceof HTMLElement)) return;
      el.scrollIntoView({ block: 'nearest' });
      el.dataset.arriving = '';
      el.addEventListener('animationend', () => delete el.dataset.arriving, { once: true });
    };

    const add = (id: string, at: Target, html = '') => {
      const [kind, what] = id.split(':') as [string, string];
      lineAfter = null;
      if (kind === 'new-field') return leaveForNewField(at);
      if (kind === 'layout' && what === 'screen') {
        const { form: next, screen } = splitScreen(form, at);
        selected = screen.id;
        commit(next);
        arrive(canvas.querySelector(`li[data-sort-key="${CSS.escape(screen.id)}"]`));
        focusKey(`screen:${screen.id}`);
        announce('Screen added.');
        return;
      }
      let block: Block;
      if (kind === 'builtin') {
        const b = builtin(what as BuiltinKey);
        block = { id: newId('q'), type: 'builtin', key: b.key, label: b.label, required: b.locked };
      } else if (kind === 'field') {
        const f = getField(what);
        if (!f || fieldsInForm(form).has(f.id)) return;
        // The field's name stands in as the question until it is reworded.
        block = { id: newId('q'), type: 'field', fieldId: f.id, label: f.label, help: f.helpText, required: false };
      } else {
        block = { id: newId('t'), type: 'text', html };
      }
      const next = insertBlock(form, block, at);
      if (next === form) return;
      selected = block.id;
      commit(next);
      arrive(canvas.querySelector(`li[data-sort-key="${CSS.escape(block.id)}"]`));
      const editor = block.type === 'text' ? textEditors.get(block.id) : undefined;
      if (editor) requestAnimationFrame(() => withEditor(editor, () => editor.dispatchEvent(new CustomEvent('firma2:rich-text-focus'))));
      if (block.type !== 'text' && focusKey(`label:${block.id}`) && block.type === 'field') selectAll(document.activeElement);
      announce(block.type === 'field' ? `${block.label} added.` : `${block.type === 'text' ? 'Text' : items().find((i) => i.id === id)?.label ?? 'Question'} added.`);
    };

    // A placed field's name is selected, so typing replaces it with the question.
    // That selection is the builder's, not the reader's: it raises no formatting
    // bar until they press or type something themselves.
    let quietSelection = false;
    canvas.addEventListener('pointerdown', () => (quietSelection = false), true);
    canvas.addEventListener('keydown', () => (quietSelection = false), true);
    const selectAll = (el: Element | null) => {
      if (!(el instanceof HTMLElement) || !el.isContentEditable) return;
      quietSelection = true;
      const range = document.createRange();
      range.selectNodeContents(el);
      getSelection()?.removeAllRanges();
      getSelection()?.addRange(range);
    };

    // ---- reordering: bcn-sortable-list has already moved the DOM --------------
    // ---- from the Fields drawer: a click places below the selection, a drop in place
    root.addEventListener('firma2:intake-add', (e) => {
      if (locked) return;
      add((e as CustomEvent<{ id: string }>).detail.id, below(selected));
    });
    const DRAG_TYPE = 'application/x-firma2-intake';
    const fromDrawer = (e: DragEvent) => !locked && !!e.dataTransfer?.types.includes(DRAG_TYPE);
    const clearDrop = () => canvas.querySelectorAll('[data-drop-after], [data-drop-before]').forEach((el) => el.removeAttribute('data-drop-after') || el.removeAttribute('data-drop-before'));
    // The row the drop goes after: the last whose middle is above the pointer.
    // Above them all, it opens the first screen.
    const dropTarget = (y: number): { li: HTMLElement | null; at: Target; before: boolean } => {
      const lis = [...canvas.querySelectorAll<HTMLElement>('.firma2-intake-blocks > li[data-sort-key]')];
      const after = lis.filter((li) => {
        const r = li.getBoundingClientRect();
        return r.top + r.height / 2 < y;
      }).pop();
      if (after) return { li: after, at: below(after.dataset.sortKey!), before: false };
      return { li: lis[0] ?? null, at: { screenId: form.screens[0].id, index: 0 }, before: true };
    };
    canvas.addEventListener('dragover', (e) => {
      if (!fromDrawer(e)) return;
      e.preventDefault();
      e.dataTransfer!.dropEffect = 'copy';
      const { li, before } = dropTarget(e.clientY);
      clearDrop();
      li?.setAttribute(before ? 'data-drop-before' : 'data-drop-after', '');
    });
    canvas.addEventListener('dragleave', (e) => {
      if (!canvas.contains(e.relatedTarget as Node | null)) clearDrop();
    });
    canvas.addEventListener('drop', (e) => {
      if (!fromDrawer(e)) return;
      e.preventDefault();
      const id = e.dataTransfer!.getData(DRAG_TYPE);
      const { at } = dropTarget(e.clientY);
      clearDrop();
      if (id) add(id, at);
    });
    document.addEventListener('dragend', clearDrop);

    canvas.addEventListener('sort-change', () => {
      layoutFrom([...canvas.querySelectorAll<HTMLElement>('.firma2-intake-blocks > li[data-sort-key]:not([data-sort-locked])')].map((li) => li.dataset.sortKey!));
    });

    // ---- formatting a label or help line ---------------------------------------
    // The toolbar shows over a selection inside one formattable line and goes
    // when the selection does. Its buttons keep the selection (mousedown is
    // eaten) and run the browser's own commands; the line's input handler
    // then sanitizes and saves what they made.
    const bar = $('[data-format-bar]');
    const linkDialog = $<HTMLElement & { show(): void; close(): void }>('[data-label-link-dialog]');
    const linkUrl = $<HTMLElement & { value: string; errorText: string }>('[data-label-link-url]');
    let linkRange: Range | null = null;
    let linkHost: HTMLElement | null = null;
    const elementOf = (n: Node | null | undefined) => (n instanceof Element ? n : n?.parentElement ?? null);
    const inlineHost = (n: Node | null | undefined) => elementOf(n)?.closest<HTMLElement>('[data-inline-format]') ?? null;
    const syncBar = () => {
      const sel = getSelection();
      const host = sel && sel.rangeCount && !sel.isCollapsed ? inlineHost(sel.anchorNode) : null;
      if (quietSelection || !sel || !host || host !== inlineHost(sel.focusNode) || !canvas.contains(host)) {
        if (!bar.contains(document.activeElement)) bar.hidden = true;
        return;
      }
      bar.hidden = false;
      const r = sel.getRangeAt(0).getBoundingClientRect();
      bar.style.left = `${Math.max(8, Math.min(r.left + r.width / 2 - bar.offsetWidth / 2, window.innerWidth - bar.offsetWidth - 8))}px`;
      bar.style.top = `${Math.max(8, r.top - bar.offsetHeight - 8)}px`;
      bar.querySelectorAll<HTMLElement>('[data-format]').forEach((b) => {
        const f = b.dataset.format!;
        b.setAttribute('aria-pressed', String(f === 'link' ? !!elementOf(sel.anchorNode)?.closest('a') : document.queryCommandState(f)));
      });
    };
    if (!locked) {
      document.addEventListener('selectionchange', syncBar);
      document.addEventListener('scroll', () => !bar.hidden && syncBar(), { passive: true, capture: true });
    }
    bar.addEventListener('mousedown', (e) => e.preventDefault());
    bar.addEventListener('click', (e) => {
      const f = (e.target as HTMLElement).closest<HTMLElement>('[data-format]')?.dataset.format;
      if (!f) return;
      if (f === 'link') return openLink();
      document.execCommand(f);
      syncBar();
    });

    function openLink() {
      const sel = getSelection();
      if (!sel?.rangeCount) return;
      linkHost = inlineHost(sel.anchorNode);
      if (!linkHost) return;
      linkRange = sel.getRangeAt(0).cloneRange();
      const current = elementOf(sel.anchorNode)?.closest('a')?.getAttribute('href') ?? '';
      bar.hidden = true;
      void customElements.whenDefined('esa-dialog').then(async () => {
        linkUrl.value = current;
        linkUrl.errorText = '';
        linkDialog.show();
        // esa-dialog calls showModal() in its own render, which puts focus on
        // the dialog — so the field is focused after that render, not before
        // (one frame was too early: typing then went to the page's shortcuts).
        // And the input itself: the lego's host is not focusable, so .focus()
        // on it did nothing and focus stayed on the dialog's close button.
        await (linkDialog as HTMLElement & { updateComplete?: Promise<unknown> }).updateComplete;
        requestAnimationFrame(() => (linkUrl.shadowRoot?.querySelector<HTMLElement>('input') ?? linkUrl).focus());
      });
    }
    // Back to the text, the selection as it was, so the command lands on it —
    // once the dialog has really closed: until its render runs close(), the
    // page under it is still inert and the text cannot take focus.
    const closeLink = async () => {
      linkDialog.close();
      await (linkDialog as HTMLElement & { updateComplete?: Promise<unknown> }).updateComplete;
      return restore();
    };
    const restore = () => {
      if (!linkHost || !linkRange) return false;
      linkHost.focus();
      const sel = getSelection();
      sel?.removeAllRanges();
      sel?.addRange(linkRange);
      return true;
    };
    const saveLink = () => {
      const raw = (linkUrl.value ?? '').trim();
      if (!raw) {
        linkUrl.errorText = 'Enter a web address.';
        linkUrl.focus();
        return;
      }
      const href = /^(https?:|mailto:)/i.test(raw) ? raw : `https://${raw}`;
      void closeLink().then((ok) => ok && document.execCommand('createLink', false, href));
    };
    $('[data-label-link-save]').addEventListener('click', saveLink);
    // Enter saves, and is spent here: left to run on, it landed in the
    // restored text and replaced the linked words with a line break.
    linkUrl.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key !== 'Enter') return;
      e.preventDefault();
      saveLink();
    });
    $('[data-label-link-remove]').addEventListener('click', () => void closeLink().then((ok) => ok && document.execCommand('unlink')));
    $('[data-label-link-cancel]').addEventListener('click', () => void closeLink());

    // ---- the form's name ----------------------------------------------------------
    const formTitle = $('[data-form-title]');
    formTitle.textContent = form.title;
    if (!locked) {
      formTitle.contentEditable = 'plaintext-only';
      formTitle.addEventListener('keydown', (e) => e.key === 'Enter' && e.preventDefault());
      formTitle.addEventListener('input', () => commit({ ...form, title: formTitle.textContent ?? '' }, false));
      // An empty name would leave members a page with no title.
      formTitle.addEventListener('blur', () => {
        if ((formTitle.textContent ?? '').trim()) return;
        formTitle.textContent = DEFAULT_FORM_TITLE;
        commit({ ...form, title: DEFAULT_FORM_TITLE }, false);
      });
    } else {
      formTitle.removeAttribute('role');
      formTitle.removeAttribute('aria-label');
    }

    // ---- the message after submitting -----------------------------------------
    const after = root.querySelector<HTMLElement>('.firma2-intake-builder__after [data-rich-text]');
    if (after) {
      withEditor(after, () => {
        after.dispatchEvent(new CustomEvent('firma2:rich-text-set', { detail: { html: form.afterSubmit } }));
        if (locked) after.dispatchEvent(new CustomEvent('firma2:rich-text-editable', { detail: { editable: false } }));
      });
      after.addEventListener('firma2:rich-text-change', (e) => commit({ ...form, afterSubmit: (e as CustomEvent<{ html: string }>).detail.html }, false));
    }

    // ---- publishing: the header's actions talk to this through events ---------
    document.addEventListener('firma2:intake-publish', () => {
      publish();
      root.dispatchEvent(new CustomEvent('firma2:intake-saved', { bubbles: true }));
      announce('Published.');
    });

    render();

    // Back from Custom fields with a new field: it goes where it was asked for.
    const params = new URLSearchParams(location.search);
    const added = params.get('add');
    if (added && !locked) {
      let at: Target = {};
      try {
        at = JSON.parse(sessionStorage.getItem(RETURN_KEY) ?? '{}');
        sessionStorage.removeItem(RETURN_KEY);
      } catch {
        // Lands at the end of the form.
      }
      // A spot that no longer exists falls back to the end of the form.
      if (at.afterId && !findBlock(form, at.afterId)) at = {};
      if (at.screenId && !form.screens.some((s) => s.id === at.screenId)) at = {};
      params.delete('add');
      history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}${location.hash}`);
      requestAnimationFrame(() => add(`field:${added}`, at.afterId || at.screenId ? at : below(null)));
    }
  });
</script>
