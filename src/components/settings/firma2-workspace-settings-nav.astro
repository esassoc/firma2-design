---
// firma2-workspace-settings-nav — the sections of Workspace settings, as
// links. Reached from the workspace menu on the rail's wordmark: the top of
// the rail names the workspace, so it is where you go to configure it.
//
// WORKSPACE, NOT ACCOUNT. /prototypes/settings is one person's preferences;
// this is the tenant's configuration — every screen and every public page
// changes for everyone. Two menus, two blast radii, two places.
//
// LINKS, NOT TABS: each section is its own page with its own URL, so a
// section can be bookmarked and sent, and a type's studio can sit under its
// section. The current section is the soft secondary button — a filled
// state the eye finds without reading — and carries aria-current.
import EsaButton from '@esa/ecology/esa-button.astro';
import { withBase } from '../../lib/base';

interface Props {
  /** The section this page belongs to. */
  current: 'classifications' | 'vocabulary' | 'grid-defaults' | 'branding';
}

const { current } = Astro.props;
const SECTIONS = [
  { key: 'classifications', label: 'Classifications', href: withBase('/prototypes/workspace-settings/classifications') },
  { key: 'vocabulary', label: 'Vocabulary', href: withBase('/prototypes/workspace-settings/vocabulary') },
  { key: 'grid-defaults', label: 'Grid defaults', href: withBase('/prototypes/workspace-settings/grid-defaults') },
  { key: 'branding', label: 'Branding', href: withBase('/prototypes/workspace-settings/branding') },
] as const;
---
<!-- data-aliasable: "Classifications" names a renameable noun. -->
<nav class="cluster" data-gap="xs" aria-label="Workspace settings" data-aliasable>
  {SECTIONS.map((s) => (
    <EsaButton
      variant={s.key === current ? 'secondary' : 'ghost'}
      appearance={s.key === current ? 'soft' : undefined}
      size="md"
      tag="a"
      href={s.href}
      aria-current={s.key === current ? 'page' : undefined}
    >
      {s.label}
    </EsaButton>
  ))}
</nav>
