---
// firma2-type-roster — every project type the tenant has, and what each one
// asks. The way into the studio, and the screen that answers "what kinds of
// work does this program track, and how differently?" read cold.
//
// A TABLE, NOT CARDS: six rows of the same five facts, scanned down a column.
// The swatch is the type's own colour — the one place a type is told apart
// at a glance, as on its public pages.
import { PROJECT_TYPES, PAGE_SECTIONS, resolveSections } from '../../data/firma2-project-types';
import { projects } from '../../data/firma2-projects';
import { withBase } from '../../lib/base';

const rows = PROJECT_TYPES.map((t) => ({
  type: t,
  href: withBase(`/prototypes/workspace-settings/project-types/${t.slug}`),
  projects: projects.filter((p) => p.program === t.name).length,
  fields: t.fields.length,
  hidden: resolveSections(t.sections)
    .filter((r) => !r.visible)
    .map((r) => r.section.label),
}));
const sectionCount = PAGE_SECTIONS.length;
---
<!-- bcn-lego-checked: a plain data table, no card around it (its own rules
     already bound every row, and it is the page's only content) — five scannable
     columns over six rows, too small for the AG Grid chrome; no esa- table
     lego exists. Beacon is not cloned on this machine. -->
  <table class="firma2-type-roster" data-type-roster>
    <thead>
      <tr>
        <th scope="col">Type</th>
        <th scope="col" data-aliasable>Projects</th>
        <th scope="col">Own fields</th>
        <th scope="col">Page</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr data-type-slug={r.type.slug}>
          <th scope="row">
            <a class="firma2-type-roster__name cluster" data-gap="xs" href={r.href}>
              <span class="firma2-type-roster__swatch" style={`background:${r.type.color}`} aria-hidden="true"></span>
              {r.type.name}
            </a>
            <span class="firma2-type-roster__meta typography-body-sm">{r.type.description}</span>
          </th>
          <td>{r.projects}</td>
          <td data-field-count>{r.fields}</td>
          <td data-page-summary>
            {r.hidden.length === 0 ? `All ${sectionCount} sections` : `Leaves out ${r.hidden.join(', ').toLowerCase()}`}
          </td>
        </tr>
      ))}
    </tbody>
  </table>

<style>
  /* No card, so no inset: the first and last columns sit on the page's own
     edges, in line with the title above. */
  .firma2-type-roster tr > :first-child {
    padding-inline-start: 0;
  }
  .firma2-type-roster tr > :last-child {
    padding-inline-end: 0;
  }

  .firma2-type-roster {
    width: 100%;
    border-collapse: collapse;
  }

  .firma2-type-roster th,
  .firma2-type-roster td {
    padding: var(--spacing-400);
    border-block-end: 1px solid var(--color-border-default);
    text-align: start;
    vertical-align: top;
    font-weight: normal;
  }

  .firma2-type-roster thead th {
    color: var(--color-text-secondary);
  }

  .firma2-type-roster__name {
    color: var(--color-content-link);
  }

  .firma2-type-roster__swatch {
    width: var(--spacing-300);
    height: var(--spacing-300);
    border-radius: var(--radius-sm);
  }

  .firma2-type-roster__meta {
    display: block;
    margin-block-start: var(--spacing-100);
    color: var(--color-text-secondary);
  }
</style>

<script>
  // Counts follow this browser's edits, so the roster agrees with the studio.
  import { PAGE_SECTIONS, resolveSections } from '../../data/firma2-project-types';
  import { withTypeDraft } from '../../lib/project-type-draft';
  import { label } from '../../lib/vocabulary';

  document.querySelectorAll<HTMLElement>('[data-type-roster] tr[data-type-slug]').forEach((tr) => {
    const type = withTypeDraft(tr.dataset.typeSlug ?? '');
    if (!type) return;
    const count = tr.querySelector('[data-field-count]');
    if (count) count.textContent = String(type.fields.length);
    const hidden = resolveSections(type.sections).filter((r) => !r.visible).map((r) => r.section.label);
    const summary = tr.querySelector('[data-page-summary]');
    if (summary)
      summary.textContent = hidden.length === 0 ? `All ${PAGE_SECTIONS.length} sections` : label(`Leaves out ${hidden.join(', ').toLowerCase()}`);
  });
</script>
