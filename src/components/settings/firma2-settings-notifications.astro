---
// firma2-settings-notifications — which events email this account.
//
// A SHORT NAME, THEN THE EVENT. Each row leads with a one- or two-word name the
// eye can scan down ("Stage changes", "Comments"), and a line under it says
// exactly what sends the email. The name stays on esa-switch-toggle's own
// `label`, because that is the switch's accessible name — the lego renders its
// role="switch" button with no aria-label passthrough, so a name in a sibling
// element would leave the switch unnamed. The description IS a sibling (the
// lego has no description slot), so the script below hands it to the inner
// button as aria-description; without that a screen-reader user would hear
// "Comments, switch, on" and never the sentence. Lego gap: a `description`
// prop on esa-switch-toggle would retire that script — esassoc/ecology#40.
//
// FOUR EVENTS, NOT A PAGE OF THEM. Each one is something a sponsor or program
// officer would plausibly want to hear about without opening the app — a record
// changed state, something is due, someone said something, and the weekly catch-up.
// Defaults are three on and one off: the digest is opt-in because it arrives
// whether or not anything happened, and a product that mails you to say nothing
// changed is how people learn to filter its mail.
//
// NOTHING HERE IS IRREVERSIBLE, which is why the whole section is a band of
// switches that can be read at a glance and flipped back — no confirmation, no
// save, no danger zone. The product brief reserves the room and the explanation
// for the irreversible, and there is none of it on this screen.
//
// bcn-lego-checked: esa-switch-toggle IS the control — form-associated, with the
// role="switch" semantics, the Space/Enter handling and the label all its own —
// and firma2-rail-section is the section. The switch is not re-implemented; there is no bespoke
// track, thumb, or row. Walked the catalog for a settings-list or preference-row
// lego and there is none; esa-checkbox-group was the alternative considered and
// rejected — a checkbox group is one question with several answers submitted
// together, and these are four independent settings that each take effect on
// change. Beacon is not cloned on this machine. Row layout, rules and the
// description line are firma2-switch-list.css, so this component has no <style>.

// NOT A CARD — the page's only section, under its own header, so the border was
// boxing the whole screen. Same card-less section as Preferences.
import Firma2RailSection from '../shared/firma2-rail-section.astro';
import '../shared/firma2-switch-list.css';

// The events, in the order a reader meets them: the record moved, something is
// owed, someone spoke, then the periodic summary.
// Every description starts the same way — when, then what — and names the same
// scope, "a project you sponsor", so the four read as one list.
const PERSONAL: Notification[] = [
  { key: 'stage-change', label: 'Stage changes', hint: 'When a project you sponsor moves to a new stage.', on: true },
  { key: 'measure-due', label: 'Reports due', hint: 'When a performance measure report is due on a project you sponsor.', on: true },
  { key: 'comment', label: 'Comments', hint: 'When someone comments on a project you sponsor.', on: true },
  { key: 'digest', label: 'Weekly summary', hint: 'Once a week, what changed on the projects you sponsor.', on: false },
];

export interface Notification {
  /** The switch's form name. */
  key: string;
  /** One or two words to scan down — also the switch's accessible name. */
  label: string;
  /** The event that sends the email, "When …". */
  hint: string;
  on: boolean;
}

// THE LIST IS A PROP so an organization's notifications (Organization settings ›
// Notifications) are this same band of switches with its own events. With no
// props it is the personal list, as it always was.
interface Props {
  title?: string;
  notifications?: Notification[];
}

const { title = 'Email notifications', notifications = PERSONAL } = Astro.props;
---
<Firma2RailSection title={title}>
  {/* ROWS RULED APART. A hairline between each switch ties every label to the
      track at the far end of its row — across a full section width, the eye needs
      the line to stay on one row. Spacing and rules: firma2-switch-list.css.

      TRACKS ON THE RIGHT EDGE. Label first, switch pinned to the section's right
      edge — firma2-switch-list.css. The four labels are different lengths, so a
      track that trailed its label would land in four places; pinned right, the
      tracks make one straight column to read on/off down. */}
  <div class="firma2-switch-list">
    {notifications.map((n) => (
      <div class="firma2-switch-list__row">
        <esa-switch-toggle
          name={n.key}
          label={n.label}
          label-position="before"
          checked={n.on ? true : undefined}
          data-hint={n.hint}
        ></esa-switch-toggle>
        <p class="firma2-switch-list__hint typography-body-sm">{n.hint}</p>
      </div>
    ))}
  </div>
</Firma2RailSection>

<script>
  // Registration only. These switches are a MOCK — nothing in this prototype
  // sends mail, so there is no change handler to write, and inventing a fake
  // persistence layer would make the section look more finished than it is. The
  // lego already handles its own checked state, keyboard and form value.
  import '@esa/ecology/esa-switch-toggle';

  // The description, handed to the switch's inner button — see the header.
  // After define and first render, because the button only exists once Lit has
  // rendered; nothing re-renders it, so setting it once holds.
  type SwitchEl = HTMLElement & { updateComplete: Promise<unknown> };
  customElements.whenDefined('esa-switch-toggle').then(() => {
    document
      .querySelectorAll<SwitchEl>('.firma2-switch-list esa-switch-toggle[data-hint]')
      .forEach(async (el) => {
        await el.updateComplete;
        el.shadowRoot?.querySelector('[role="switch"]')?.setAttribute('aria-description', el.dataset.hint ?? '');
      });
  });
</script>
