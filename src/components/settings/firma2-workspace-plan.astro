---
// firma2-workspace-plan — Workspace settings › Plan: which plan the workspace
// is on — Free, Agency or Program — and what each plan above Free adds. Where
// every plan-locked page's call to action leads. Spec: .scratch/tiers/spec.md
// (supersedes .scratch/form-canvas/spec.md #24, #25). Usage against limits
// is slotted in after the current plan (firma2-plan-usage).
//
// ONLY WHAT IS REALLY LOCKED. One entry per feature that is plan-gated today,
// each linking to the page it changes. A plan with nothing gated yet gets no
// section. No prices: the business has not set them. A feature gated later adds
// one entry to LOCKED below.
//
// THE SWITCH IS THE PROTOTYPE'S. The plan is `?tier=free|agency|program`, read
// and kept by readPlan() (src/lib/workspace-plan.ts); each button just reloads
// with another value, so a reviewer can walk every plan back to back.
//
// bcn-lego-checked: firma2-rail-section is each section (the settings surface
// rule — no cards), esa-badge the plan and "Included", esa-button the switch and
// the links; layout is `.stack` / `.repel` / `.cluster`. No CSS beyond secondary
// text colour.
import Firma2RailSection from '../shared/firma2-rail-section.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { withBase } from '../../lib/base';
import { PLANS, PLAN_NAME, type Plan } from '../../lib/workspace-plan';

const LOCKED: { name: string; what?: string; href: string; needs: Plan }[] = [
  {
    name: 'Intake form',
    what: 'Your own questions, screens and conditional logic.',
    href: withBase('/prototypes/workspace-settings/intake-form'),
    needs: 'agency',
  },
  {
    name: 'Branding',
    what: "Your own logo and colors.",
    href: withBase('/prototypes/workspace-settings/branding'),
    needs: 'agency',
  },
  {
    name: 'Terminology',
    what: "Your program’s own terms.",
    href: withBase('/prototypes/workspace-settings/labels'),
    needs: 'agency',
  },
  {
    name: 'Menu order',
    href: withBase('/prototypes/workspace-settings/menu-order'),
    needs: 'agency',
  },
  {
    name: 'Project types',
    what: "Types with their own fields and layout.",
    href: withBase('/prototypes/workspace-settings/project-types'),
    needs: 'agency',
  },
  {
    name: 'Stages',
    what: "Your own stage names and order.",
    href: withBase('/prototypes/workspace-settings/stages'),
    needs: 'agency',
  },
  {
    name: 'Custom fields',
    href: withBase('/prototypes/workspace-settings/custom-fields'),
    needs: 'agency',
  },
  {
    name: 'Funding source fields',
    href: withBase('/prototypes/workspace-settings/funding-source-fields'),
    needs: 'agency',
  },
  {
    name: 'Security',
    what: "Who can invite, import, export and publish.",
    href: withBase('/prototypes/workspace-settings/security'),
    needs: 'agency',
  },
  {
    name: 'GIS sync',
    what: "Footprints synced from your GIS (an add-on on Agency).",
    href: withBase('/prototypes/workspace-settings/gis-sync'),
    needs: 'program',
  },
  {
    name: 'Organization access',
    what: "Private organizations, email-domain joining, per-organization permissions.",
    href: withBase('/prototypes/workspace-settings/organization-settings/access'),
    needs: 'program',
  },
  {
    name: 'Publish review',
    what: "Review changes before they’re published.",
    href: withBase('/prototypes/workspace-settings/organization-settings/review'),
    needs: 'program',
  },
];

const PAID = PLANS.filter((p) => p !== 'free').map((plan) => ({ plan, features: LOCKED.filter((f) => f.needs === plan) })).filter((g) => g.features.length);
---
<div class="firma2-workspace-plan stack" data-gap="2xl">
  <Firma2RailSection title="Current plan">
    <div class="repel" data-gap="md">
      {PLANS.map((p) => (
        <span data-plan={p} hidden><EsaBadge variant={p === 'free' ? 'secondary' : 'success'} size="md" value={PLAN_NAME[p]} /></span>
      ))}
      <div class="cluster" data-gap="sm">
        {PLANS.map((p) => (
          <span data-switch={p} hidden><EsaButton variant="secondary" size="md" href={`?tier=${p}`}>Switch to {PLAN_NAME[p]}</EsaButton></span>
        ))}
      </div>
    </div>
  </Firma2RailSection>

  <slot name="usage" />

  {PAID.map(({ plan, features }) => (
    <Firma2RailSection title={`What ${PLAN_NAME[plan]} adds`}>
      <ul class="stack firma2-workspace-plan__list" data-gap="lg" role="list">
        {features.map((f) => (
          <li class="stack" data-gap="xs">
            <div class="cluster" data-gap="sm">
              <h4 class="typography-title-sm-strong firma2-workspace-plan__name">{f.name}</h4>
              <span data-included={f.needs} hidden><EsaBadge variant="success" size="sm" value="Included" /></span>
            </div>
            {f.what && <p class="typography-body-md firma2-workspace-plan__note">{f.what}</p>}
            <span><EsaButton variant="ghost" size="md" href={f.href}>Open {f.name.replace(/^[A-Z](?![A-Z])/, (c) => c.toLowerCase())}</EsaButton></span>
          </li>
        ))}
      </ul>
    </Firma2RailSection>
  ))}
</div>

<style>
  .firma2-workspace-plan :global([hidden]) {
    display: none !important;
  }

  .firma2-workspace-plan__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .firma2-workspace-plan__name,
  .firma2-workspace-plan__note {
    margin: 0;
  }

  .firma2-workspace-plan__note {
    color: var(--color-text-secondary);
  }
</style>

<script>
  import { planIncludes, readPlan, type Plan } from '../../lib/workspace-plan';

  document.querySelectorAll<HTMLElement>('.firma2-workspace-plan').forEach((root) => {
    const plan = readPlan();
    root.querySelectorAll<HTMLElement>('[data-plan]').forEach((el) => (el.hidden = el.dataset.plan !== plan));
    root.querySelectorAll<HTMLElement>('[data-switch]').forEach((el) => (el.hidden = el.dataset.switch === plan));
    root.querySelectorAll<HTMLElement>('[data-included]').forEach((el) => (el.hidden = !planIncludes(el.dataset.included as Plan)));
  });
</script>
