---
// firma2-organization-settings — the index of one organization's settings: the
// pages that configure it, grouped by what they configure.
//
// FOUR GROUPS, IN THE ORDER A NEW ORGANIZATION IS SET UP: who it is, who is in
// it and who may do what (unheaded — the page title already names it), then how
// its projects start, then how their updates move, then what it is wired to.
// The way out of the organization comes last, in its own danger zone.
//
// The unheaded group is built. Every other row is inert until its page exists
// — the nav's contract, so the index shows the whole shape without dead links.
//
// bcn-lego-checked: firma2-rail-section is each group (a heading, no box) and
// firma2-settings-link-list each list of destinations — both existing spoke
// components, composed unchanged. `.stack` spaces the groups; no <style>.
import Firma2RailSection from '../shared/firma2-rail-section.astro';
import Firma2SettingsLinkList from './firma2-settings-link-list.astro';
import type { SettingsLink } from './firma2-settings-link-list.astro';
import { withBase } from '../../lib/base';
import type { Organization } from '../../data/firma2-directory';
import { cadenceLabel, reviewCadence } from '../../data/firma2-publishing';

interface Props {
  organization: Organization;
}

const { organization: org } = Astro.props;

const identity: SettingsLink[] = [
  { label: 'General', href: withBase('/prototypes/workspace-settings/organization-settings/general') },
  {
    label: 'Members',
    href: withBase('/prototypes/workspace-settings/organization-settings/members'),
    value: `${org.people} ${org.people === 1 ? 'person' : 'people'}`,
  },
  // Straight after Members: once there are people, the next question is who
  // can see the organization, how others get in, and what each member may do.
  { label: 'Access and permissions', href: withBase('/prototypes/workspace-settings/organization-settings/access') },
  { label: 'Notifications', href: withBase('/prototypes/workspace-settings/organization-settings/notifications') },
];

const groups: { title: string; items: SettingsLink[] }[] = [
  {
    title: 'Projects',
    items: [
      { label: 'Defaults for new projects' },
      { label: 'Visibility' },
      { label: 'Fact sheets' },
    ],
  },
  {
    title: 'Workflow and updates',
    items: [
      // "Update approvals" became this page (2026-10-09): the approval IS the
      // publish, and what an organization sets is how often it sweeps.
      {
        label: 'Review schedule',
        href: withBase('/prototypes/workspace-settings/organization-settings/review'),
        value: cadenceLabel(reviewCadence(org.name)),
      },
      { label: 'Reporting schedule' },
      { label: 'Reminders' },
    ],
  },
  {
    title: 'Connections',
    items: [
      { label: 'ArcGIS Online', value: 'Connected' },
      { label: 'Email domain', value: org.website },
    ],
  },
];
---
<div class="stack" data-gap="2xl" data-organization-settings={org.name}>
  <Firma2SettingsLinkList items={identity} />
  {groups.map((group) => (
    <Firma2RailSection title={group.title}>
      <Firma2SettingsLinkList items={group.items} />
    </Firma2RailSection>
  ))}
</div>

<script>
  // The Review schedule row states this browser's choice, which the Review
  // schedule page persists (src/lib/publish-store.ts) — the seed otherwise.
  import { readPublishing } from '../../lib/publish-store';
  import { REVIEW_CADENCES } from '../../data/firma2-review-cadence';

  const organization = document.querySelector<HTMLElement>('[data-organization-settings]')?.dataset.organizationSettings ?? '';
  const chosen = readPublishing().cadence[organization];
  const value = document.querySelector('a[href$="/organization-settings/review"] .firma2-settings-link-list__value');
  const label = REVIEW_CADENCES.find((c) => c.value === chosen)?.label;
  if (value && label) value.textContent = label;
</script>
