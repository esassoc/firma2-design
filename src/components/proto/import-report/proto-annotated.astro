---
// PROTOTYPE, TO BE DELETED. Variant 3, "Annotated document". The report itself
// is the page: the person reads it top to bottom as they wrote it, and each
// proposed change sits in the margin beside the passage it was read from.
// There is no list and nothing to select; position says where a change came
// from, and a passage with an empty margin says nothing was taken from it.
//
// The one thing document order loses against a list is "what still needs me",
// so a sticky line above the document counts the waiting changes and moves to
// the next one.
//
// Everything is rendered here from `data`; bind() wires the controls. The
// client script only paints the waiting line, runs "Show next", and lights the
// lines a focused or hovered note was read from.
//
// NOT USED is not keyed to passages in the reading, so it is placed here by
// text: a passage line contained in the string, sharing its first three words,
// or whose every word appears in it; failing that, a string naming a page
// ("page 4") whose first word starts a passage heading on that page. Anything
// left over is listed at the end.
//
// bcn-lego-checked: every control is a lego (esa-checkbox, esa-text-field,
// esa-select, esa-textarea, esa-badge, esa-button). The classes lay out a
// document with a margin column, which no esa- component does; Beacon is not
// cloned on this machine.
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import type { ProtoData, ProtoItem } from './model';
import { formatFigure } from './model';

interface Props {
  data: ProtoData;
}

const { data } = Astro.props;

type BadgeVariant = 'secondary' | 'warning' | 'danger';
const BADGE_VARIANT: Record<NonNullable<ProtoItem['badge']>, BadgeVariant> = {
  'Needs a decision': 'warning',
  'No match': 'secondary',
  Unsure: 'danger',
  'Not in this workspace': 'warning',
};

const words = (s: string): string[] =>
  s
    .toLowerCase()
    .replace(/[^\p{L}\p{N}]+/gu, ' ')
    .trim()
    .split(' ')
    .filter(Boolean);
const flat = (s: string): string => words(s).join(' ');

/** The verbatim pieces of a quote: the text between curly quotes. */
const quoted = (quote: string): string[] => [...quote.matchAll(/“([^”]+)”/g)].map((m) => m[1]);

/** Index of the first line a piece of text was read from, or -1. */
const lineIndex = (lines: string[], pieces: string[]): number =>
  lines.findIndex((line) => pieces.some((piece) => flat(line).includes(flat(piece)) || flat(piece).includes(flat(line))));

/** Does a not-used string name this line? */
const names = (text: string, line: string): boolean => {
  const t = words(text);
  const l = words(line);
  if (!l.length) return false;
  if (flat(text).includes(flat(line))) return true;
  if (l.length >= 3 && l.slice(0, 3).join(' ') === t.slice(0, 3).join(' ')) return true;
  if (l.length >= 3) {
    const have = new Set(t);
    return l.every((w) => have.has(w));
  }
  return false;
};

interface Note {
  key: string;
  text: string;
  line: number;
}

// ---- place every not-used string ------------------------------------------
const notes = new Map<string, Note[]>();
const unplaced: string[] = [];
[...data.notUsed, ...data.skipped].forEach((text, n) => {
  const key = `not-used-${n}`;
  for (const page of data.document.pages) {
    for (const passage of page.passages) {
      const line = passage.lines.findIndex((l) => names(text, l));
      if (line >= 0) {
        // A string that is only the line says nothing about why.
        const bare = flat(text) === flat(passage.lines[line]);
        const shown = bare ? `${text.replace(/\.?$/, '.')} No performance measure asks for this.` : text;
        notes.set(passage.id, [...(notes.get(passage.id) ?? []), { key, text: shown, line }]);
        return;
      }
    }
  }
  // No line: a string naming a page and a heading's first word.
  const t = words(text);
  for (const page of data.document.pages) {
    if (!flat(text).includes(flat(page.label))) continue;
    const passage = page.passages.find((p) => p.heading && words(p.heading)[0] === t[0]);
    if (passage) {
      notes.set(passage.id, [...(notes.get(passage.id) ?? []), { key, text, line: -1 }]);
      return;
    }
  }
  unplaced.push(text);
});

// ---- the document, each passage with what was read from it -----------------
const pages = data.document.pages.map((page, p) => ({
  label: page.label,
  id: `proto-annotated-page-${p}`,
  rows: page.passages.map((passage) => {
    const items = data.items
      .filter((item) => item.passage === passage.id)
      .map((item, order) => ({ item, order, line: lineIndex(passage.lines, quoted(item.quote)) }))
      .sort((a, b) => (a.line < 0 ? 999 : a.line) - (b.line < 0 ? 999 : b.line) || a.order - b.order);
    const passageNotes = notes.get(passage.id) ?? [];
    // Which notes each line feeds, so focusing a note can light its line.
    const lineKeys = passage.lines.map((_, i) =>
      [...items.filter((x) => x.line === i).map((x) => x.item.id), ...passageNotes.filter((x) => x.line === i).map((x) => x.key)].join(' '),
    );
    return { passage, items: items.map((x) => x.item), notes: passageNotes, lineKeys };
  }),
}));

const waiting = data.items.filter((item) => item.status === 'needs').length;
const waitingNoun = (n: number): string => (n === 1 ? 'change needs you' : 'changes need you');
---
<div class="proto-annotated stack" data-gap="lg">
  <div class="proto-annotated__bar repel" data-gap="sm">
    <h2 class="proto-annotated__name typography-title" id="proto-annotated-name">{data.documentName}</h2>
    <div class="cluster" data-gap="sm">
      <p class="typography-body-md" data-some hidden={waiting === 0}>
        <span class="proto-annotated__count" data-waiting-count>{waiting}</span>
        <span data-noun>{waitingNoun(waiting)}</span>
      </p>
      <p class="typography-body-md" data-none hidden={waiting > 0}>No changes need you</p>
      <span data-next-wrap hidden={waiting === 0}>
        <EsaButton variant="secondary" appearance="outline" size="md" data-next>Show next</EsaButton>
      </span>
    </div>
  </div>

  <article class="proto-annotated__doc" aria-labelledby="proto-annotated-name">
    {pages.map((page) => (
      <section class="proto-annotated__page" aria-labelledby={page.id}>
        <h3 class="proto-annotated__page-label typography-label-md" id={page.id}>{page.label}</h3>
        {page.rows.map(({ passage, items, notes: passageNotes, lineKeys }) => (
          <div class="proto-annotated__row" data-passage={passage.id}>
            <div class="proto-annotated__passage stack" data-gap="xs">
              {passage.heading && <h4 class="typography-label-lg-strong">{passage.heading}</h4>}
              {passage.lines.map((line, i) => (
                <p class="proto-annotated__line typography-body-lg" data-for={lineKeys[i] || undefined}>{line}</p>
              ))}
            </div>
            {(items.length > 0 || passageNotes.length > 0) && (
              <ul class="proto-annotated__margin stack" data-gap="lg" role="list" aria-label={`Read from ${passage.heading ?? page.label}`}>
                {items.map((item) => {
                  const ticks = item.status !== 'on-file';
                  const needs = item.status === 'needs';
                  return (
                    <li
                      class="proto-annotated__note stack"
                      data-gap="xs"
                      data-item={item.id}
                      data-status={item.status}
                      data-lights={item.id}
                      data-picked={item.status === 'ready' ? '' : undefined}
                      data-waiting={needs ? '' : undefined}
                    >
                      {ticks ? (
                        <esa-checkbox data-pick size="md" label={item.label} checked={item.status === 'ready'}></esa-checkbox>
                      ) : (
                        <p class="typography-label-md-strong">{item.label}</p>
                      )}
                      <div class:list={['proto-annotated__body stack', { 'proto-annotated__body--ticked': ticks }]} data-gap="xs">
                        {(item.badge || item.check || !ticks) && (
                          <span class="cluster" data-gap="xs">
                            {!ticks && <EsaBadge variant="secondary" size="sm" value="Already on file" />}
                            {needs && item.badge && <EsaBadge variant={BADGE_VARIANT[item.badge]} size="sm" value={item.badge} />}
                            {item.check && <EsaBadge variant="warning" size="sm" value="Check this" />}
                          </span>
                        )}
                        <p class="proto-annotated__value typography-body-md" data-value>{item.value}</p>
                        {item.kind === 'field' && item.was && ticks && (
                          <p class="proto-annotated__meta typography-body-sm">Was {item.was}</p>
                        )}
                        {item.conversion && (
                          <p class="proto-annotated__meta typography-body-sm">
                            {item.kind === 'measure' && !item.conversion.includes('to date') ? 'Converted: ' : ''}
                            {item.conversion}
                          </p>
                        )}
                        {item.note && <p class="proto-annotated__meta typography-body-sm">{item.note}</p>}
                        {needs && item.reason && <p class="typography-body-sm">{item.reason}</p>}
                        {needs && item.kind === 'measure' && (
                          <esa-text-field
                            class="proto-annotated__field"
                            data-amount
                            size="md"
                            label="Amount"
                            suffix={item.unit || undefined}
                            inputmode="decimal"
                            value={item.amount == null ? '' : String(item.amount)}
                          ></esa-text-field>
                        )}
                        {needs && item.suggestion && (
                          <div class="cluster" data-gap="xs">
                            <p class="typography-body-sm">
                              Suggested: {`${formatFigure(item.suggestion.amount)} ${item.unit ?? ''}`.trim()}. {item.suggestion.basis}.
                            </p>
                            <EsaButton variant="ghost" size="md" data-use-suggestion>Use suggestion</EsaButton>
                          </div>
                        )}
                        {needs && item.kind === 'funding' && (
                          <esa-select class="proto-annotated__field" data-organization size="md" label="Organization"></esa-select>
                        )}
                      </div>
                    </li>
                  );
                })}
                {passageNotes.length > 0 && (
                  <li class="proto-annotated__note stack" data-gap="xs" data-lights={passageNotes.map((x) => x.key).join(' ')}>
                    <p class="typography-label-md-strong">Not used</p>
                    {passageNotes.map((note) => (
                      <p class="proto-annotated__meta typography-body-sm" data-lights={note.key}>{note.text}</p>
                    ))}
                  </li>
                )}
              </ul>
            )}
          </div>
        ))}
      </section>
    ))}
  </article>

  {unplaced.length > 0 && (
    <section class="stack" data-gap="xs" aria-labelledby="proto-annotated-unplaced">
      <h3 class="typography-label-lg-strong" id="proto-annotated-unplaced">Not used</h3>
      <ul class="proto-annotated__list stack" data-gap="2xs">
        {unplaced.map((text) => <li class="typography-body-md">{text}</li>)}
      </ul>
    </section>
  )}

  <esa-textarea class="proto-annotated__note-field" label="Note for the reviewer (optional)" rows="3"></esa-textarea>
</div>

<style>
  /* Layout primitives set `display`, which beats the UA's [hidden]. */
  .proto-annotated [hidden] {
    display: none !important;
  }

  .proto-annotated {
    --_reading: 65ch;
    --_margin: 22rem;
    --_tick-indent: calc(20px + var(--spacing-200, 0.5rem));
  }

  .proto-annotated h2,
  .proto-annotated h3,
  .proto-annotated h4,
  .proto-annotated p {
    margin: 0;
  }

  /* THE WAITING LINE. Stays under the top bar while the document scrolls, so
     "Show next" is always one press away. */
  .proto-annotated__bar {
    position: sticky;
    top: calc(var(--firma2-sticky-origin, 0px) + var(--firma2-band-height, 48px));
    z-index: 2;
    padding-block: var(--spacing-300, 0.75rem);
    background: var(--firma2-sheet-background, var(--color-background-default));
    border-block-end: 1px solid var(--color-border-default);
  }

  .proto-annotated__name {
    overflow-wrap: anywhere;
  }

  .proto-annotated__count {
    font-variant-numeric: tabular-nums;
  }

  /* THE DOCUMENT. One row per passage: the passage, and its margin. The row's
     bottom rule is shared by both, so a note belongs to the passage it sits
     level with. */
  .proto-annotated__page + .proto-annotated__page {
    margin-block-start: var(--spacing-600, 1.5rem);
  }

  .proto-annotated__page-label {
    color: var(--color-text-secondary);
    padding-block-end: var(--spacing-200, 0.5rem);
    border-block-end: 1px solid var(--color-border-default);
  }

  .proto-annotated__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-400, 1rem);
    padding-block: var(--spacing-500, 1.25rem);
    border-block-end: 1px solid var(--color-border-default);
  }

  .proto-annotated__passage {
    max-inline-size: var(--_reading);
    min-inline-size: 0;
  }

  .proto-annotated__line {
    overflow-wrap: anywhere;
    /* Room for the light without moving the words when it comes on. */
    padding-inline: var(--spacing-100, 0.25rem);
    margin-inline: calc(-1 * var(--spacing-100, 0.25rem));
    border-radius: var(--radius-sm);
    transition: background-color 150ms ease-out;
  }

  /* The line a focused or hovered note was read from. A tint behind the
     words, as the built document pane does, never a colored edge. */
  .proto-annotated__line[data-lit] {
    background: var(--color-background-brand-muted);
  }

  /* THE MARGIN. Below 64rem it sits under its passage on a sunken ground, so
     it never reads as more of the document. */
  .proto-annotated__margin {
    margin: 0;
    padding: var(--spacing-400, 1rem);
    list-style: none;
    min-inline-size: 0;
    background: var(--color-background-elevation-sunken);
    border-radius: var(--radius-sm);
  }

  .proto-annotated__note {
    min-inline-size: 0;
    scroll-margin-block: 8rem;
  }

  /* Values and their lines start where the tick's label starts. */
  .proto-annotated__body--ticked {
    padding-inline-start: var(--_tick-indent);
  }

  .proto-annotated__value,
  .proto-annotated__meta,
  .proto-annotated__note li {
    overflow-wrap: anywhere;
  }

  .proto-annotated__value:empty {
    display: none;
  }

  .proto-annotated__meta {
    color: var(--color-text-secondary);
  }

  /* An unticked ready change stays readable (it may be ticked back) but
     recedes; so does one already on file. */
  .proto-annotated__note[data-status='ready']:not([data-picked]) .proto-annotated__value,
  .proto-annotated__note[data-status='on-file'] .proto-annotated__value {
    color: var(--color-text-secondary);
  }

  .proto-annotated esa-checkbox {
    max-inline-size: 100%;
  }

  .proto-annotated__field {
    display: block;
    max-inline-size: 18rem;
  }

  .proto-annotated__list {
    margin: 0;
    padding-inline-start: var(--spacing-400, 1rem);
  }

  .proto-annotated__note-field {
    display: block;
    max-inline-size: 40rem;
  }

  /* Wide: the margin moves beside its passage, top to top, on the page's own
     ground. */
  @media (min-width: 64rem) {
    .proto-annotated__row {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, var(--_margin));
      column-gap: var(--spacing-800, 2rem);
      align-items: start;
    }

    .proto-annotated__margin {
      grid-column: 2;
      padding: 0;
      background: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proto-annotated__line {
      transition: none;
    }
  }
</style>

<script>
  import '@esa/ecology/esa-checkbox';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-textarea';
  import { PROTO_CHANGE, bind, getModel } from './model';

  document.querySelectorAll<HTMLElement>('.proto-annotated').forEach((root) => {
    bind(root);
    const model = getModel();
    const $ = (sel: string) => root.querySelector<HTMLElement>(sel)!;

    // ---- the waiting line ---------------------------------------------------
    const paint = () => {
      const n = model.waiting();
      $('[data-some]').hidden = n === 0;
      $('[data-none]').hidden = n > 0;
      $('[data-next-wrap]').hidden = n === 0;
      $('[data-noun]').textContent = n === 1 ? 'change needs you' : 'changes need you';
    };
    document.addEventListener(PROTO_CHANGE, paint);
    paint();

    // ---- Show next: the next waiting change after the one you are on ---------
    let last: HTMLElement | null = null;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const focusIn = (note: HTMLElement) => {
      const field = note.querySelector<HTMLElement>('esa-text-field, esa-select');
      if (field) return field.focus({ preventScroll: true });
      // esa-checkbox does not forward host focus; its control is the shadow box.
      note.querySelector('esa-checkbox')?.shadowRoot?.querySelector<HTMLElement>('[role="checkbox"]')?.focus({ preventScroll: true });
    };
    root.addEventListener('click', (event) => {
      if (!(event.target as Element).closest('[data-next]')) return;
      const waiting = [...root.querySelectorAll<HTMLElement>('[data-item][data-waiting]')];
      if (!waiting.length) return;
      const here = (document.activeElement?.closest<HTMLElement>('[data-item]') ?? last) || null;
      const after = here ? waiting.find((el) => here.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING) : undefined;
      const next = after ?? waiting[0];
      last = next;
      next.scrollIntoView({ block: 'center', behavior: reduce.matches ? 'auto' : 'smooth' });
      focusIn(next);
    });

    // ---- light the lines a note was read from --------------------------------
    const lines = [...root.querySelectorAll<HTMLElement>('[data-for]')];
    const light = (target: EventTarget | null) => {
      const keys = (target as Element | null)?.closest?.<HTMLElement>('[data-lights]')?.dataset.lights?.split(' ') ?? [];
      lines.forEach((line) => line.toggleAttribute('data-lit', line.dataset.for!.split(' ').some((k) => keys.includes(k))));
    };
    root.addEventListener('focusin', (event) => light(event.target));
    root.addEventListener('pointerover', (event) => light(event.target));
    root.addEventListener('pointerleave', () => light(null));
  });
</script>
