---
// PROTOTYPE, TO BE DELETED. Variant 1, "Side by side": the Import a report
// page exactly as it is built (firma2-project-report-import, unchanged), so
// every other variant is measured against the real thing and not a memory of
// it. The only addition is a script that presses "Sample funder report" on
// load, because the exploration is of the check step and not of choosing a
// file. Unlike the other variants, this one's Add really saves and returns to
// the project page.
//
// bcn-lego-checked: composes firma2-project-report-import; no markup of its own.
import Firma2ProjectReportImport from '../../projects/firma2-project-report-import.astro';
import type { Project } from '../../../data/firma2-projects';
import { projectHref, projectSlug } from '../../../data/firma2-projects';
import { getProjectDetail, isClosedPeriod } from '../../../data/firma2-project-detail';
import { organizations, users } from '../../../data/firma2-directory';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const detail = getProjectDetail(project);
const years = (detail.measures[0]?.series.filter(isClosedPeriod).map((period) => period.year) ?? []).reverse();
---
<div class="proto-side">
  <Firma2ProjectReportImport
    projectSlug={projectSlug(project)}
    projectName={project.projectName}
    projectHref={projectHref(project)}
    years={years}
    units={Object.fromEntries(detail.measures.map((measure) => [measure.name, measure.unit]))}
    reported={Object.fromEntries(detail.measures.map((measure) => [measure.name, measure.reported]))}
    fields={{ timeline: `${project.implementationStartYear},${project.completionYear}`, county: project.county }}
    contacts={detail.contacts.map(({ name, email }) => ({ name, email }))}
    funding={detail.funding.map(({ name, organization }) => ({ name, organization }))}
    organizations={organizations.map((organization) => organization.name)}
    people={users.map(({ name, email }) => ({ name, email }))}
  />
</div>

<script>
  // Straight to the check step: the same reading the other variants show.
  window.addEventListener('load', () => {
    document.querySelector<HTMLElement>('.proto-side [data-use-sample="report"]')?.click();
  });
</script>
