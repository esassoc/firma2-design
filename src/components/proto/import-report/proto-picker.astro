---
// PROTOTYPE, TO BE DELETED. The variant picker for /proto/import-report.
//
// bcn-lego-checked: this is harness chrome, not product UI. Its markup and
// styles are fixed by the prototyping method (a dark pill that looks the same
// in every project so it never reads as part of the design being judged), so
// it deliberately uses no esa- lego, no project token and no project font.
// esa-button-toggle is the product's segmented control and would make the
// picker look like a contestant. It is deleted with the prototype.
//
// One variant shows at a time, full size. Keys 1 to N and the arrow keys
// switch; the choice is kept in ?v=. Anything on the page marked
// data-proto-for="1 3" shows only while one of those variants is active.
interface Props {
  variants: string[];
}

const { variants } = Astro.props;
---
<nav class="proto-picker" aria-label="Prototype variants">
  <span class="proto-picker-highlight" aria-hidden="true"></span>
  {variants.map((name) => <button class="proto-picker-item" type="button">{name}</button>)}
</nav>

<style is:global>
  .proto-picker {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2147483647;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.82);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 8px 24px rgba(0, 0, 0, 0.24),
      0 2px 6px rgba(0, 0, 0, 0.12);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 13px;
    line-height: 1;
    -webkit-font-smoothing: antialiased;
    user-select: none;
    -webkit-user-select: none;
  }

  .proto-picker-highlight {
    position: absolute;
    top: 4px;
    left: 0;
    height: 28px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    will-change: transform;
  }

  /* The slide is enabled only after first paint (data-ready), so load doesn't animate. */
  .proto-picker[data-ready] .proto-picker-highlight {
    transition:
      transform 250ms cubic-bezier(0.23, 1, 0.32, 1),
      width 250ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .proto-picker[data-ready] .proto-picker-highlight { transition: none; }
  }

  .proto-picker-item {
    position: relative; /* sits above the highlight */
    display: flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    font: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: color 150ms ease-out;
  }

  .proto-picker-item:hover {
    color: rgba(255, 255, 255, 0.85);
  }

  .proto-picker-item:active {
    transform: scale(0.97);
  }

  .proto-picker-item:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.4);
    outline-offset: 2px;
  }

  .proto-picker-item[data-active] {
    color: #fff;
  }

  /* The stage shows one variant; these win over any layout primitive's display. */
  [data-proto-variant][hidden],
  [data-proto-for][hidden] {
    display: none !important;
  }
</style>

<script>
  const picker = document.querySelector<HTMLElement>('.proto-picker');
  if (picker) {
    const highlight = picker.querySelector<HTMLElement>('.proto-picker-highlight')!;
    const items = [...picker.querySelectorAll<HTMLElement>('.proto-picker-item')];
    const variants = [...document.querySelectorAll<HTMLElement>('[data-proto-variant]')];
    let current = 0;

    const moveHighlight = () => {
      const el = items[current];
      highlight.style.width = `${el.offsetWidth}px`;
      highlight.style.transform = `translateX(${el.offsetLeft}px)`;
    };

    const setActive = (i: number) => {
      if (i < 0 || i >= items.length) return;
      current = i;
      items.forEach((el, j) => {
        el.toggleAttribute('data-active', j === i);
        if (j === i) el.setAttribute('aria-current', 'true');
        else el.removeAttribute('aria-current');
      });
      moveHighlight();
      const url = new URL(window.location.href);
      url.searchParams.set('v', String(i + 1));
      window.history.replaceState(null, '', url);
      // Instant: the swap itself is never animated.
      variants.forEach((el, j) => (el.hidden = j !== i));
      document.querySelectorAll<HTMLElement>('[data-proto-for]').forEach((el) => {
        el.hidden = !(el.dataset.protoFor ?? '').split(' ').includes(String(i + 1));
      });
      document.dispatchEvent(new CustomEvent('proto:variant', { detail: { index: i } }));
    };

    items.forEach((el, i) => el.addEventListener('click', () => setActive(i)));
    window.addEventListener('resize', moveHighlight);

    document.addEventListener('keydown', (event) => {
      // Typing in a control is not a command. Lego inputs sit in shadow roots,
      // so the real target is the first node of the composed path.
      const target = (event.composedPath()[0] ?? event.target) as HTMLElement;
      if (/^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName ?? '') || target.isContentEditable) return;
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      const num = parseInt(event.key, 10);
      if (num >= 1 && num <= items.length) setActive(num - 1);
      else if (event.key === 'ArrowRight') setActive((current + 1) % items.length);
      else if (event.key === 'ArrowLeft') setActive((current - 1 + items.length) % items.length);
    });

    setActive((parseInt(new URLSearchParams(window.location.search).get('v') ?? '', 10) || 1) - 1);
    requestAnimationFrame(() => requestAnimationFrame(() => picker.setAttribute('data-ready', '')));
  }
</script>
