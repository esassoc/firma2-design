---
// PROTOTYPE, TO BE DELETED. Variant 4 of /proto/import-report, "On the record".
// Axis: which object is primary. Here the project's record is the page: its own
// sections in the project page's order, each proposed value sitting where it
// will land, beside what is there now. The document is secondary, opened per
// value with "Source". The bet: a wrong number is caught in its real place,
// next to its target and the last total.
//
// Everything is server-rendered from `data`; bind() (model.ts) wires the ticks,
// figures and organizations. The client script adds only what bind() does not:
// the after-adding totals, the singular/plural of the leading line, the Source
// disclosures, and a 40px tap strip around each 20px checkbox.
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { formatFigure, formatUsd, passageOf } from './model';
import type { ProtoData, ProtoItem } from './model';

interface Props {
  data: ProtoData;
}

const { data } = Astro.props;
const same = (a: string, b: string): boolean => a.trim().toLowerCase() === b.trim().toLowerCase();
const inGroup = (group: ProtoItem['group']) => data.items.filter((i) => i.group === group);

const BADGE_VARIANT = {
  'Needs a decision': 'warning',
  'No match': 'secondary',
  Unsure: 'danger',
  'Not in this workspace': 'warning',
} as const;

/** Where a value came from: the quote's location, and the passage with the quoted lines marked. */
const sourceOf = (item: ProtoItem) => {
  const found = passageOf(data, item);
  const [where, ...rest] = item.quote.split(' — ');
  const segments = [...item.quote.matchAll(/“([^”]+)”/g)].map((m) => m[1]);
  const lines = (found?.passage.lines ?? []).map((text) => ({
    text,
    quoted: segments.some((s) => text.includes(s) || s.includes(text)),
  }));
  return {
    id: `proto-record-source-${item.id}`,
    where: rest.length ? where : (found?.page ?? ''),
    lines,
    // The quote itself, only when no line of the passage carries it.
    verbatim: lines.some((l) => l.quoted) ? '' : rest.length ? rest.join(' ') : item.quote,
    note: item.note,
  };
};

const waiting = data.items.filter((i) => i.status === 'needs').length;

// ---- Key facts
const factItems = inGroup('Key facts');
const facts = data.record.facts.map((fact) => {
  const item = factItems.find((i) => same(i.name, fact.label));
  return { ...fact, item, source: item ? sourceOf(item) : undefined };
});

// ---- Performance measures: the record's measures in order, then any the report names that the record lacks.
const ofTarget = (n: number, expected: number, unit: string): string =>
  (expected > 0 ? `${formatFigure(n)} of ${formatFigure(expected)} ${unit}` : `${formatFigure(n)} ${unit}`).trim();
const measureItems = inGroup('Performance measures');
const orphans = measureItems
  .filter((i) => !data.record.measures.some((m) => same(m.name, i.name)))
  .map((i) => ({ name: i.name, unit: i.unit ?? '', reported: i.reported ?? 0, expected: i.expected ?? 0 }));
const measures = [...data.record.measures, ...orphans].map((m) => {
  const items = measureItems.filter((i) => same(i.name, m.name));
  const adds = items.filter((i) => i.status !== 'on-file');
  const added = adds.filter((i) => i.status === 'ready' && (i.amount ?? 0) > 0).reduce((sum, i) => sum + (i.amount ?? 0), 0);
  const after = m.reported + added;
  const over = m.expected > 0 && after > m.expected ? after - m.expected : 0;
  return {
    ...m,
    adds,
    rows: items.length ? items.map((item, k) => ({ item, first: k === 0, source: sourceOf(item) })) : [{ item: undefined, first: true, source: undefined }],
    multi: items.length > 1,
    afterText: added > 0 ? ofTarget(after, m.expected, m.unit) : 'No change',
    overText: over > 0 ? `${formatFigure(over)} ${m.unit} over target`.trim() : '',
  };
});
/** A figure the person may need to fill or correct is a field; the rest read as text. */
const editable = (item: ProtoItem): boolean => item.status === 'needs' || Boolean(item.check);

// ---- Funding sources
const fundingItems = inGroup('Funding sources');
const fundingOnFile = data.record.funding.map((f) => {
  const item = fundingItems.find(
    (i) => i.status === 'on-file' && i.funding && same(i.funding.name, f.name) && same(i.funding.organization, f.organization),
  );
  return { ...f, item, source: item ? sourceOf(item) : undefined };
});
const fundingNew = fundingItems
  .filter((i) => !fundingOnFile.some((f) => f.item === i))
  .map((item) => ({ item, source: sourceOf(item) }));

// ---- Contacts
const contactItems = inGroup('Contacts');
const contactsOnFile = data.record.contacts.map((c) => {
  const item = contactItems.find((i) => i.status === 'on-file' && i.contact && same(i.contact.email, c.email));
  return { ...c, item, source: item ? sourceOf(item) : undefined };
});
const contactsNew = contactItems
  .filter((i) => !contactsOnFile.some((c) => c.item === i))
  .map((item) => ({ item, source: sourceOf(item) }));
---
<div class="proto-record stack" data-gap="2xl">
  <!-- bcn-lego-checked: every control is a lego (esa-checkbox, esa-text-field,
       esa-select, esa-textarea, esa-button, esa-badge). The record sections are
       plain <table>s and a <dl>: three to seven rows need no AG Grid chrome (the
       reasoning firma2-project-funding.astro records), and no esa- component
       draws a table. The Source disclosure is an esa-button toggling a row
       below, not esa-popover: a popover centred on a cell overflows a 390px
       screen and is clipped by the table's scroll wrapper. Beacon is not cloned
       on this machine. -->

  <p class="proto-record__lead typography-body-md">
    <span data-waiting-some hidden={waiting === 0}><span data-waiting-count>{waiting}</span> <span data-waiting-noun>{waiting === 1 ? 'change needs' : 'changes need'}</span> you.</span>
    <span data-waiting-none hidden={waiting !== 0}>Nothing needs you.</span>
  </p>

  <!-- ===== KEY FACTS ===== -->
  <section class="stack" data-gap="md" aria-labelledby="proto-record-facts">
    <h2 id="proto-record-facts" class="proto-record__title typography-title-strong">Key facts</h2>
    <dl class="proto-record__facts grid" data-gap="lg">
      {facts.map((fact) => (
        <div class="stack" data-gap="xs" data-item={fact.item?.id}>
          <dt class="proto-record__term typography-label-sm">{fact.label}</dt>
          <dd class="stack" data-gap="xs">
            {fact.item?.status === 'ready' ? (
              <>
                <p class="typography-body-md"><span class="proto-record__term">On record now</span> {fact.item.was || 'Not set'}</p>
                <div class="proto-record__pick">
                  <esa-checkbox size="md" data-pick={fact.item.id} label={`Change to ${fact.item.value}`} checked></esa-checkbox>
                </div>
              </>
            ) : (
              <p class="typography-body-md">{fact.value || 'Not set'}</p>
            )}
            {fact.item?.status === 'on-file' && (
              <span><EsaBadge variant="secondary" size="sm" value="Already on file" /></span>
            )}
            {fact.source && (
              <>
                <span><EsaButton variant="ghost" size="md" icon="file-text" data-source-toggle aria-controls={fact.source.id} aria-expanded="false">Source</EsaButton></span>
                <div class="proto-record__source stack" data-gap="xs" id={fact.source.id} hidden>
                  <p class="proto-record__term typography-label-sm">{fact.source.where}</p>
                  {fact.source.lines.length > 0 && (
                    <ul class="proto-record__lines stack" data-gap="2xs">
                      {fact.source.lines.map((line) => <li>{line.quoted ? <mark>{line.text}</mark> : line.text}</li>)}
                    </ul>
                  )}
                  {fact.source.verbatim && <p>{fact.source.verbatim}</p>}
                  {fact.source.note && <p>{fact.source.note}</p>}
                </div>
              </>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- ===== PERFORMANCE MEASURES ===== -->
  <section class="stack" data-gap="md" aria-labelledby="proto-record-measures">
    <h2 id="proto-record-measures" class="proto-record__title typography-title-strong">Performance measures</h2>
    <div class="proto-record__scroll">
      <table class="proto-record__table typography-body-md" aria-labelledby="proto-record-measures">
        <thead>
          <tr>
            <th scope="col">Measure</th>
            <th scope="col" class="proto-record__num">On record now</th>
            <th scope="col" class="proto-record__num">From this report</th>
            <th scope="col" class="proto-record__num">After adding</th>
          </tr>
        </thead>
        {measures.map((m) => (
          <tbody>
            {m.rows.map(({ item, first, source }) => (
              <>
                <tr data-item={item?.id}>
                  <th scope="row">
                    <div class="stack" data-gap="xs">
                      {m.multi && first && <p>{m.name}</p>}
                      {item && item.status !== 'on-file' ? (
                        <div class="proto-record__pick">
                          <esa-checkbox size="md" data-pick={item.id} label={m.multi ? (item.period ?? '') : m.name} checked={item.status === 'ready' && (item.amount ?? 0) > 0}></esa-checkbox>
                        </div>
                      ) : (
                        <p class:list={{ 'proto-record__indent': m.multi }}>{m.multi ? item?.period : m.name}</p>
                      )}
                      {item && (item.badge || item.check || item.status === 'on-file') && (
                        <span class="cluster" data-gap="xs">
                          {item.status === 'on-file' && <EsaBadge variant="secondary" size="sm" value="Already on file" />}
                          {item.badge && <EsaBadge variant={BADGE_VARIANT[item.badge]} size="sm" value={item.badge} />}
                          {item.check && <EsaBadge variant="warning" size="sm" value="Check this" />}
                        </span>
                      )}
                      {item?.reason && <p class="proto-record__aside typography-body-sm">{item.reason}</p>}
                      {item?.conversion && <p class="proto-record__aside typography-body-sm">{item.conversion}</p>}
                      {item?.suggestion && (
                        <div class="cluster" data-gap="xs">
                          <p class="proto-record__aside typography-body-sm">Suggested: {formatFigure(item.suggestion.amount)} {item.unit}. {item.suggestion.basis}.</p>
                          <EsaButton variant="secondary" appearance="outline" size="md" data-use-suggestion={item.id}>Use suggestion</EsaButton>
                        </div>
                      )}
                      {source && (
                        <span><EsaButton variant="ghost" size="md" icon="file-text" data-source-toggle aria-controls={source.id} aria-expanded="false">Source</EsaButton></span>
                      )}
                    </div>
                  </th>
                  {first ? (
                    <td class="proto-record__num" data-label="On record now">{ofTarget(m.reported, m.expected, m.unit)}</td>
                  ) : (
                    <td class="proto-record__num" data-empty></td>
                  )}
                  {item && item.status !== 'on-file' ? (
                    <td class="proto-record__num" data-label="From this report">
                      {editable(item) ? (
                        <esa-text-field size="md" data-amount={item.id} label={item.period} suffix={item.unit} inputmode="decimal" value={item.amount == null ? '' : String(item.amount)}></esa-text-field>
                      ) : (
                        <span class="stack" data-gap="2xs">
                          <span class="proto-record__term typography-label-sm">{item.period}</span>
                          <span data-value={item.id}>{item.value}</span>
                        </span>
                      )}
                    </td>
                  ) : (
                    <td class="proto-record__num" data-empty></td>
                  )}
                  {first && m.adds.length > 0 ? (
                    <td
                      class="proto-record__num"
                      data-label="After adding"
                      data-after={m.adds.map((i) => i.id).join(' ')}
                      data-reported={m.reported}
                      data-expected={m.expected}
                      data-unit={m.unit}
                    >
                      <span class="stack" data-gap="2xs">
                        <span data-after-total>{m.afterText}</span>
                        <span class="proto-record__over typography-body-sm" data-after-over hidden={!m.overText}>{m.overText}</span>
                      </span>
                    </td>
                  ) : (
                    <td class="proto-record__num" data-empty></td>
                  )}
                </tr>
                {source && (
                  <tr class="proto-record__source-row" id={source.id} hidden>
                    <td colspan="4">
                      <div class="proto-record__source stack" data-gap="xs">
                        <p class="proto-record__term typography-label-sm">{source.where}</p>
                        {source.lines.length > 0 && (
                          <ul class="proto-record__lines stack" data-gap="2xs">
                            {source.lines.map((line) => <li>{line.quoted ? <mark>{line.text}</mark> : line.text}</li>)}
                          </ul>
                        )}
                        {source.verbatim && <p>{source.verbatim}</p>}
                        {source.note && <p>{source.note}</p>}
                      </div>
                    </td>
                  </tr>
                )}
              </>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </section>

  <!-- ===== FUNDING SOURCES ===== -->
  <section class="stack" data-gap="md" aria-labelledby="proto-record-funding">
    <h2 id="proto-record-funding" class="proto-record__title typography-title-strong">Funding sources</h2>
    <div class="proto-record__scroll">
      <table class="proto-record__table typography-body-md" aria-labelledby="proto-record-funding">
        <thead>
          <tr>
            <th scope="col">Source</th>
            <th scope="col">Administered by</th>
            <th scope="col" class="proto-record__num">Amount</th>
          </tr>
        </thead>
        <tbody>
          {fundingOnFile.map((f) => (
            <>
              <tr data-item={f.item?.id}>
                <th scope="row">
                  <div class="stack" data-gap="xs">
                    <p>{f.name}</p>
                    {f.item && <span><EsaBadge variant="secondary" size="sm" value="Already on file" /></span>}
                    {f.source && (
                      <span><EsaButton variant="ghost" size="md" icon="file-text" data-source-toggle aria-controls={f.source.id} aria-expanded="false">Source</EsaButton></span>
                    )}
                  </div>
                </th>
                <td data-label="Administered by">{f.organization}</td>
                <td class="proto-record__num" data-label="Amount">{formatUsd(f.amount)}</td>
              </tr>
              {f.source && (
                <tr class="proto-record__source-row" id={f.source.id} hidden>
                  <td colspan="3">
                    <div class="proto-record__source stack" data-gap="xs">
                      <p class="proto-record__term typography-label-sm">{f.source.where}</p>
                      {f.source.lines.length > 0 && (
                        <ul class="proto-record__lines stack" data-gap="2xs">
                          {f.source.lines.map((line) => <li>{line.quoted ? <mark>{line.text}</mark> : line.text}</li>)}
                        </ul>
                      )}
                      {f.source.verbatim && <p>{f.source.verbatim}</p>}
                      {f.source.note && <p>{f.source.note}</p>}
                    </div>
                  </td>
                </tr>
              )}
            </>
          ))}
          {fundingNew.map(({ item, source }) => (
            <>
              <tr data-item={item.id}>
                <th scope="row">
                  <div class="stack" data-gap="xs">
                    {item.status === 'on-file' ? (
                      <p>{item.funding?.name}</p>
                    ) : (
                      <div class="proto-record__pick">
                        <esa-checkbox size="md" data-pick={item.id} label={item.funding?.name ?? item.name} checked={item.status === 'ready'}></esa-checkbox>
                      </div>
                    )}
                    <span class="cluster" data-gap="xs">
                      {item.status === 'on-file' ? (
                        <EsaBadge variant="secondary" size="sm" value="Already on file" />
                      ) : (
                        <EsaBadge variant="info" size="sm" value="New" />
                      )}
                      {item.badge && <EsaBadge variant={BADGE_VARIANT[item.badge]} size="sm" value={item.badge} />}
                    </span>
                    <span><EsaButton variant="ghost" size="md" icon="file-text" data-source-toggle aria-controls={source.id} aria-expanded="false">Source</EsaButton></span>
                  </div>
                </th>
                <td data-label="Administered by">
                  {item.organizationMissing && item.status !== 'on-file' ? (
                    <div class="proto-record__decide stack" data-gap="xs">
                      {item.reason && <p class="proto-record__aside typography-body-sm">{item.reason}</p>}
                      <esa-select size="md" label="Organization" data-organization={item.id}></esa-select>
                    </div>
                  ) : (
                    item.funding?.organization
                  )}
                </td>
                <td class="proto-record__num" data-label="Amount">{item.funding ? formatUsd(item.funding.amount) : ''}</td>
              </tr>
              <tr class="proto-record__source-row" id={source.id} hidden>
                <td colspan="3">
                  <div class="proto-record__source stack" data-gap="xs">
                    <p class="proto-record__term typography-label-sm">{source.where}</p>
                    {source.lines.length > 0 && (
                      <ul class="proto-record__lines stack" data-gap="2xs">
                        {source.lines.map((line) => <li>{line.quoted ? <mark>{line.text}</mark> : line.text}</li>)}
                      </ul>
                    )}
                    {source.verbatim && <p>{source.verbatim}</p>}
                    {source.note && <p>{source.note}</p>}
                  </div>
                </td>
              </tr>
            </>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ===== CONTACTS ===== -->
  <section class="stack" data-gap="md" aria-labelledby="proto-record-contacts">
    <h2 id="proto-record-contacts" class="proto-record__title typography-title-strong">Contacts</h2>
    <div class="proto-record__scroll">
      <table class="proto-record__table typography-body-md" aria-labelledby="proto-record-contacts">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Role</th>
            <th scope="col">Organization</th>
            <th scope="col">Email</th>
          </tr>
        </thead>
        <tbody>
          {contactsOnFile.map((c) => (
            <>
              <tr data-item={c.item?.id}>
                <th scope="row">
                  <div class="stack" data-gap="xs">
                    <p>{c.name}</p>
                    {c.item && <span><EsaBadge variant="secondary" size="sm" value="Already on file" /></span>}
                    {c.source && (
                      <span><EsaButton variant="ghost" size="md" icon="file-text" data-source-toggle aria-controls={c.source.id} aria-expanded="false">Source</EsaButton></span>
                    )}
                  </div>
                </th>
                <td data-label="Role">{c.role}</td>
                <td data-label="Organization">{c.organization}</td>
                <td class="proto-record__email" data-label="Email">{c.email}</td>
              </tr>
              {c.source && (
                <tr class="proto-record__source-row" id={c.source.id} hidden>
                  <td colspan="4">
                    <div class="proto-record__source stack" data-gap="xs">
                      <p class="proto-record__term typography-label-sm">{c.source.where}</p>
                      {c.source.lines.length > 0 && (
                        <ul class="proto-record__lines stack" data-gap="2xs">
                          {c.source.lines.map((line) => <li>{line.quoted ? <mark>{line.text}</mark> : line.text}</li>)}
                        </ul>
                      )}
                      {c.source.verbatim && <p>{c.source.verbatim}</p>}
                      {c.source.note && <p>{c.source.note}</p>}
                    </div>
                  </td>
                </tr>
              )}
            </>
          ))}
          {contactsNew.map(({ item, source }) => (
            <>
              <tr data-item={item.id}>
                <th scope="row">
                  <div class="stack" data-gap="xs">
                    {item.status === 'on-file' ? (
                      <p>{item.contact?.name}</p>
                    ) : (
                      <div class="proto-record__pick">
                        <esa-checkbox size="md" data-pick={item.id} label={item.contact?.name ?? item.name} checked={item.status === 'ready'}></esa-checkbox>
                      </div>
                    )}
                    <span>
                      {item.status === 'on-file' ? (
                        <EsaBadge variant="secondary" size="sm" value="Already on file" />
                      ) : (
                        <EsaBadge variant="info" size="sm" value="New" />
                      )}
                    </span>
                    {item.status !== 'on-file' && <p class="proto-record__aside typography-body-sm">No invitation is sent.</p>}
                    <span><EsaButton variant="ghost" size="md" icon="file-text" data-source-toggle aria-controls={source.id} aria-expanded="false">Source</EsaButton></span>
                  </div>
                </th>
                <td data-label="Role">{item.contact?.role}</td>
                <td data-label="Organization">{item.contact?.organization}</td>
                <td class="proto-record__email" data-label="Email">{item.contact?.email}</td>
              </tr>
              <tr class="proto-record__source-row" id={source.id} hidden>
                <td colspan="4">
                  <div class="proto-record__source stack" data-gap="xs">
                    <p class="proto-record__term typography-label-sm">{source.where}</p>
                    {source.lines.length > 0 && (
                      <ul class="proto-record__lines stack" data-gap="2xs">
                        {source.lines.map((line) => <li>{line.quoted ? <mark>{line.text}</mark> : line.text}</li>)}
                      </ul>
                    )}
                    {source.verbatim && <p>{source.verbatim}</p>}
                    {source.note && <p>{source.note}</p>}
                  </div>
                </td>
              </tr>
            </>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ===== NOT USED, SKIPPED, NOTE ===== -->
  {data.notUsed.length > 0 && (
    <section class="stack" data-gap="xs" aria-labelledby="proto-record-not-used">
      <h2 id="proto-record-not-used" class="typography-label-md-strong">Not used</h2>
      <ul class="proto-record__quiet proto-record__bullets stack typography-body-md" data-gap="2xs">
        {data.notUsed.map((line) => <li>{line}</li>)}
      </ul>
    </section>
  )}
  {data.skipped.length > 0 && <p class="proto-record__quiet typography-body-md">Skipped: {data.skipped.join(' ')}</p>}
  <div class="proto-record__note">
    <esa-textarea label="Note for the reviewer (optional)" rows="3" size="md"></esa-textarea>
  </div>
</div>

<style>
  /* Layout primitives set `display`, which beats the UA's [hidden]. */
  .proto-record [hidden] {
    display: none !important;
  }

  .proto-record {
    max-inline-size: 64rem;
  }

  .proto-record p,
  .proto-record dd,
  .proto-record h2 {
    margin: 0;
  }

  .proto-record__title {
    color: var(--color-content-default, #202020);
  }

  /* The quiet ink of a term, a label or a secondary line: same as the project
     page's <dt>s. */
  .proto-record__term,
  .proto-record__aside,
  .proto-record__quiet {
    color: var(--color-content-default-secondary, #646464);
  }

  .proto-record__aside {
    max-inline-size: 36rem;
  }

  .proto-record__facts {
    --grid-min: 16rem;
  }

  /* A 20px checkbox in a 40px strip: a tap anywhere in the strip ticks it
     (the script forwards the click). */
  .proto-record__pick {
    display: flex;
    align-items: center;
    min-block-size: 2.5rem;
    cursor: pointer;
  }

  /* ---- the tables -------------------------------------------------------
     Chrome follows firma2-project-measures: separate borders, flush outer
     padding, secondary heads, numbers at the end in tabular figures. */
  .proto-record__scroll {
    position: relative;
    overflow-x: auto;
  }

  .proto-record__table {
    inline-size: 100%;
    border-collapse: separate;
    border-spacing: 0;
  }

  .proto-record__table th,
  .proto-record__table td {
    text-align: start;
    vertical-align: top;
    padding-block: var(--spacing-300, 0.75rem);
    padding-inline: var(--spacing-300, 0.75rem);
  }

  .proto-record__table th:first-child,
  .proto-record__table td:first-child {
    padding-inline-start: 0;
  }

  .proto-record__table th:last-child,
  .proto-record__table td:last-child {
    padding-inline-end: 0;
  }

  .proto-record__table thead th {
    color: var(--color-content-default-secondary, #646464);
    font-weight: var(--font-weight-semibold, 600);
    white-space: nowrap;
    vertical-align: bottom;
    border-block-end: var(--border-width-default, 1px) solid var(--color-border-default, #cecece);
  }

  /* The row header names the row; it is not a heading. */
  .proto-record__table tbody th {
    font-weight: inherit;
    min-inline-size: 14rem;
  }

  .proto-record__table tbody tr:not(:first-child) > :is(th, td),
  .proto-record__table tbody + tbody tr:first-child > :is(th, td) {
    border-block-start: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #d9d9d9);
  }

  /* The source opens under its row, as part of it: no rule between them. */
  .proto-record__table tbody tr.proto-record__source-row > td {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .proto-record__num {
    text-align: end !important;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .proto-record__num esa-text-field {
    display: inline-block;
    inline-size: 10rem;
    text-align: start;
  }

  .proto-record__num .stack {
    align-items: end;
  }

  .proto-record__over {
    color: var(--color-content-utility-warning, var(--color-content-default));
    font-weight: var(--font-weight-semibold, 600);
  }

  /* A second figure for a measure the report addresses twice starts on the
     first one's label text: past the box (20px) and its gap. */
  .proto-record__indent {
    padding-inline-start: calc(20px + var(--spacing-200, 0.5rem));
  }

  .proto-record__decide {
    min-inline-size: 12rem;
  }

  .proto-record__email {
    overflow-wrap: anywhere;
  }

  /* ---- the source ------------------------------------------------------- */
  .proto-record__source {
    max-inline-size: 40rem;
    padding: var(--spacing-300, 0.75rem);
    border-radius: var(--radius-sm, 0.25rem);
    background: var(--color-background-elevation-sunken, #f3f3f3);
    white-space: normal;
  }

  .proto-record__lines,
  .proto-record__bullets {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .proto-record__bullets {
    padding-inline-start: var(--spacing-400, 1rem);
    list-style: disc;
  }

  .proto-record mark {
    background: var(--color-background-brand-muted, #e9f6e9);
    color: inherit;
    border-radius: var(--radius-sm, 0.25rem);
  }

  .proto-record__note {
    max-inline-size: 40rem;
  }

  /* ---- phone: each row stacks into labelled lines ------------------------ */
  @media (max-width: 45rem) {
    .proto-record__table,
    .proto-record__table tbody,
    .proto-record__table tr,
    .proto-record__table th,
    .proto-record__table td {
      display: block;
    }

    .proto-record__table thead {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .proto-record__table th,
    .proto-record__table td {
      padding-inline: 0;
      padding-block: var(--spacing-200, 0.5rem);
      border-block-start: 0 !important;
    }

    .proto-record__table tbody th {
      min-inline-size: 0;
    }

    .proto-record__table tbody tr:not(.proto-record__source-row) {
      padding-block: var(--spacing-200, 0.5rem);
    }

    .proto-record__table tbody tr:not(.proto-record__source-row):not(:first-child),
    .proto-record__table tbody + tbody tr:first-child {
      border-block-start: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #d9d9d9);
    }

    .proto-record__table td[data-empty] {
      display: none;
    }

    .proto-record__table td[data-label] {
      display: flex;
      justify-content: space-between;
      align-items: start;
      gap: var(--spacing-300, 0.75rem);
      white-space: normal;
    }

    .proto-record__table td[data-label]::before {
      content: attr(data-label);
      color: var(--color-content-default-secondary, #646464);
      text-align: start;
      white-space: nowrap;
    }

    .proto-record__decide {
      min-inline-size: 0;
      flex: 1 1 auto;
      max-inline-size: 16rem;
    }
  }
</style>

<script>
  import '@esa/ecology/esa-checkbox';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-textarea';
  import { PROTO_CHANGE, bind, formatFigure, getModel } from './model';

  type Tick = HTMLElement & { checked?: boolean };

  document.querySelectorAll<HTMLElement>('.proto-record').forEach((root) => {
    bind(root);
    const m = getModel();
    const figure = (id: string): number => Number(m.amount(id).replace(/[$,\s]/g, '')) || 0;

    const paint = () => {
      // What each measure comes to if Add is pressed now: only ticked figures count.
      root.querySelectorAll<HTMLElement>('[data-after]').forEach((cell) => {
        const ids = (cell.dataset.after ?? '').split(' ').filter(Boolean);
        const reported = Number(cell.dataset.reported);
        const expected = Number(cell.dataset.expected);
        const unit = cell.dataset.unit ?? '';
        const added = ids.filter((id) => m.picked(id)).reduce((sum, id) => sum + figure(id), 0);
        const after = Math.round((reported + added) * 100) / 100;
        const over = expected > 0 && after > expected ? Math.round((after - expected) * 100) / 100 : 0;
        cell.querySelector('[data-after-total]')!.textContent =
          added > 0
            ? (expected > 0 ? `${formatFigure(after)} of ${formatFigure(expected)} ${unit}` : `${formatFigure(after)} ${unit}`).trim()
            : 'No change';
        const overLine = cell.querySelector<HTMLElement>('[data-after-over]')!;
        overLine.textContent = over > 0 ? `${formatFigure(over)} ${unit} over target`.trim() : '';
        overLine.hidden = over === 0;
      });
      const n = m.waiting();
      root.querySelector<HTMLElement>('[data-waiting-some]')!.hidden = n === 0;
      root.querySelector<HTMLElement>('[data-waiting-none]')!.hidden = n !== 0;
      root.querySelector('[data-waiting-noun]')!.textContent = n === 1 ? 'change needs' : 'changes need';
    };
    document.addEventListener(PROTO_CHANGE, paint);

    root.addEventListener('click', (event) => {
      const target = event.target as Element;

      // Source: opens below its row, so nothing in the row moves.
      const toggle = target.closest<HTMLElement>('[data-source-toggle]');
      if (toggle) {
        const panel = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
        if (!panel) return;
        const open = panel.hidden;
        panel.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        return;
      }

      // A tap in the strip around a checkbox, outside the checkbox itself.
      if (target.classList.contains('proto-record__pick')) {
        const tick = target.querySelector<Tick>('esa-checkbox');
        if (!tick) return;
        tick.checked = !tick.checked;
        tick.dispatchEvent(new CustomEvent('change', { bubbles: true, composed: true, detail: { checked: tick.checked } }));
      }
    });
  });
</script>
