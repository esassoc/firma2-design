---
// firma2-sign-in — the workspace's sign-in: the ways in, one button each
// (SIGN_IN_METHODS; the Security page no longer sets them, 2026-11-24).
//
// SIGNING IN IS SIGNING UP. There is no separate account form: the first
// sign-in with a provider makes the account, and the account starts as a Viewer
// with no organization (.scratch/access-requests/spec.md, decision 9). The one
// line under the buttons says so, because a newcomer otherwise hunts for
// "Create account".
//
// In the prototype every button leads to the first-sign-in question; a
// verified email domain would instead land them straight in their organization.
//
// bcn-lego-checked: esa-button for each provider, composed unchanged; no esa-
// lego is a sign-in panel. Beacon is not cloned on this machine. `.stack` lays
// it out; the CSS only removes heading margins.
import EsaButton from '@esa/ecology/esa-button.astro';
import { SIGN_IN_METHODS } from '../../data/firma2-workspace-settings';
import { withBase } from '../../lib/base';

const methods = SIGN_IN_METHODS.filter((m) => m.on);
const next = withBase('/prototypes/welcome');
---
<section class="firma2-sign-in stack" data-gap="xl">
  <h1 class="typography-heading-lg">Sign in</h1>
  <div class="stack" data-gap="sm">
    {methods.map((m) => (
      <EsaButton variant="secondary" size="md" href={next}>{m.key === 'signin-email' ? 'Continue with email' : `Continue with ${m.label}`}</EsaButton>
    ))}
  </div>
  <p class="typography-body-md">New here? Signing in creates your account.</p>
</section>

<style>
  .firma2-sign-in h1,
  .firma2-sign-in p {
    margin: 0;
  }
</style>
