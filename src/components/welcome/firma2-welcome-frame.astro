---
// firma2-welcome-frame — the frame a newcomer's first screens sit in: the
// workspace's name, then one narrow column, and no app chrome.
//
// NO NAVIGATION, BECAUSE THERE IS NOTHING TO NAVIGATE YET. A new account is a
// Viewer with no organization, which sees what the public sees
// (.scratch/access-requests/spec.md, decision 9); the full app rail would be a
// menu of doors that open onto nothing. Linear's own first screens do the same:
// one column, one question, the workspace named above it.
//
// The column is the reading measure (40rem), centred, with the pane's own
// gutter at phone width.
//
// bcn-lego-checked: esa-app-shell carries the full chrome this frame exists to
// leave out; no esa- lego is a bare onboarding column. `.center` and `.stack`
// lay it out; the CSS sets the measure and the surface only. Beacon is not
// cloned on this machine.
import { TENANT_NAME } from '../../data/firma2-project-types';
---
<div class="firma2-welcome-frame">
  <div class="center stack" data-gap="2xl">
    <p class="typography-label-md firma2-welcome-frame__tenant">{TENANT_NAME}</p>
    <main class="stack" data-gap="2xl">
      <slot />
    </main>
  </div>
</div>

<style>
  .firma2-welcome-frame {
    min-block-size: 100dvh;
    padding: var(--spacing-700) var(--spacing-400);
    background: var(--color-background-default);
  }
  .firma2-welcome-frame > .center {
    --center-max: 40rem;
  }
  .firma2-welcome-frame__tenant {
    margin: 0;
    color: var(--color-text-secondary);
  }
</style>
