---
// firma2-org-map — where one organization's work is: the work areas of every
// project it leads or funds, on one map, framed on that work.
//
// WHY NOT THE PORTFOLIO MAP. firma2-portfolio-map is a page — color-by,
// tags, coverage, charts, export — and it reads every project in the
// workspace. An organization's Home needs one picture of its own projects,
// so this is the same canvas (src/lib/leaflet), the same shapes, the same
// dots-when-zoomed-out rule and the same popup doors, scoped by a prop.
//
// COLOUR IS THE ORGANIZATION'S ROLE, the one split the summary above already
// makes ("3 led, 2 funded"). The key appears only when both roles do; one
// colour needs no key.
//
// THE GAP IS NAMED, because a map cannot show it: a project with no work area
// is invisible here by construction, so the ones missing are listed under the
// map, linked — the portfolio map's "Not on this map", at this scale.
//
// Shapes are read through src/lib/work-areas, so an area drawn on a project's
// map in this browser shows up here too.
//
// bcn-lego-checked: no map lego exists in the catalog; the canvas is Leaflet,
// as in firma2-portfolio-map and firma2-my-projects-map. The popup's preview
// button is the cloned firma2-project-peek-button (src/lib/project-peek). The
// key is a plain list with swatches — the portfolio map's shading key, not a
// control. Beacon is not cloned on this machine.
import type { OrganizationProject } from '../../data/firma2-organization-pages';
import { projectHref, projectSlug } from '../../data/firma2-projects';
import { seedWorkAreas } from '../../data/firma2-geography';
import { withBase } from '../../lib/base';

interface Props {
  rows: OrganizationProject[];
}

const { rows } = Astro.props;
const config = rows.map(({ project, leads }) => ({
  slug: projectSlug(project),
  name: project.projectName,
  href: withBase(projectHref(project)),
  leads,
  seed: seedWorkAreas(project),
}));
const bothRoles = rows.some((r) => r.leads) && rows.some((r) => !r.leads);
---
{rows.length > 0 && (
  <section class="firma2-org-map stack" data-gap="md" aria-labelledby="firma2-org-map-title" data-config={JSON.stringify(config)}>
    <h2 id="firma2-org-map-title" class="typography-title-sm-strong">Where the work is</h2>
    <div class="firma2-org-map__canvas" role="application" aria-label="Map of this organization's projects" data-canvas></div>
    {bothRoles && (
      <ul class="firma2-org-map__key typography-body-sm" aria-label="Key">
        <li><span class="firma2-org-map__swatch" data-role="led"></span>Led</li>
        <li><span class="firma2-org-map__swatch" data-role="funded"></span>Funded</li>
      </ul>
    )}
    <p class="typography-body-md" data-unmapped hidden></p>
  </section>
)}

<style>
  .firma2-org-map__canvas {
    block-size: clamp(18rem, 45vh, 28rem);
    border: 1px solid var(--color-border-default, #cecece);
    border-radius: var(--radius-md, 0.5rem);
    overflow: hidden;
    /* Leaflet's panes run to z-index 700; keep them under the app's chrome. */
    isolation: isolate;
  }

  .firma2-org-map [data-unmapped][hidden] {
    display: none;
  }

  .firma2-org-map__key {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-200) var(--spacing-400);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .firma2-org-map__key li {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100);
  }

  .firma2-org-map__swatch {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border-radius: 50%;
  }

  .firma2-org-map__swatch[data-role='led'] {
    background: var(--color-background-dataviz-categorical-1, #3e9b4f);
  }

  .firma2-org-map__swatch[data-role='funded'] {
    background: var(--color-background-dataviz-categorical-2, #3e63dd);
  }

  .firma2-org-map :global(.firma2-org-map__doors) {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100, 0.25rem);
  }

  .firma2-org-map :global(.leaflet-bar) {
    border: 1px solid var(--color-border-default, #cecece);
    border-radius: var(--radius-sm, 0.25rem);
    box-shadow: var(--elevation-1, 0 1px 4px rgba(0, 0, 0, 0.06));
  }

  .firma2-org-map :global(.leaflet-bar a) {
    background-color: var(--color-background-elevation-raised, #fcfcfc);
    color: var(--color-content-default, #202020);
  }

  .firma2-org-map :global(.leaflet-popup-content-wrapper),
  .firma2-org-map :global(.leaflet-popup-tip) {
    background: var(--color-background-elevation-floating, #fcfcfc);
    color: var(--color-content-default, #202020);
    box-shadow: var(--elevation-2, 0 2px 12px 0 rgba(0, 0, 0, 0.08));
  }

  .firma2-org-map :global(.leaflet-popup-content) {
    margin: var(--spacing-300) var(--spacing-400);
    font: inherit;
  }

  .firma2-org-map :global(.leaflet-popup-content a),
  .firma2-org-map [data-unmapped] :global(a) {
    color: var(--color-content-link, #2a7e3b);
  }

  :global(.firma2-map-tip) {
    padding: var(--spacing-200) var(--spacing-300);
    background: var(--color-background-elevation-floating, #fcfcfc);
    border: 1px solid var(--color-border-default, #cecece);
    border-radius: var(--radius-sm, 0.25rem);
    color: var(--color-content-default, #202020);
    box-shadow: var(--elevation-2, 0 2px 12px 0 rgba(0, 0, 0, 0.04));
  }
</style>

<script>
  import type { MapWorkArea } from '../../data/firma2-geography';
  import { centroid, formatExtent } from '../../lib/geo';
  import { createMap, kindColor, loadLeaflet, shapeStyle, token } from '../../lib/leaflet';
  import type { Leaflet } from '../../lib/leaflet';
  import { onGeoChange, readWorkAreas } from '../../lib/work-areas';
  import { label as vocab } from '../../lib/vocabulary';
  import { projectPeekButtonHTML } from '../../lib/project-peek';

  type Row = { slug: string; name: string; href: string; leads: boolean; seed: MapWorkArea[] };

  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  document.querySelectorAll<HTMLElement>('.firma2-org-map').forEach(async (root) => {
    const rows: Row[] = JSON.parse(root.dataset.config ?? '[]');
    const canvas = root.querySelector<HTMLElement>('[data-canvas]')!;
    const unmapped = root.querySelector<HTMLElement>('[data-unmapped]')!;

    const L: Leaflet | null = await loadLeaflet().catch(() => null);
    if (!L) {
      canvas.hidden = true;
      return;
    }

    // Led is categorical slot 1, funded slot 2 — the most separable pair.
    const roleColor = (row: Row) => kindColor(row.leads ? 'area' : 'reach');

    const shapes = L.featureGroup();
    const dots = L.featureGroup();
    const map = createMap(L, canvas, { zoomSnap: 0.5 }, () => paint());
    map.setView([37.6, -120.4], 6);
    shapes.addTo(map);

    // A treatment unit is a speck at the zoom that shows a whole region, so
    // each project is also a dot at its work's centre while zoomed out.
    const DOT_ZOOM = 9;
    const syncDots = () => {
      const out = map.getZoom() < DOT_ZOOM;
      if (out && !map.hasLayer(dots)) dots.addTo(map);
      if (!out && map.hasLayer(dots)) map.removeLayer(dots);
    };
    map.on('zoomend', syncDots);

    const paint = (frame = false) => {
      shapes.clearLayers();
      dots.clearLayers();
      const missing: Row[] = [];
      const all: [number, number][] = [];

      rows.forEach((row) => {
        const areas = readWorkAreas(row.slug, row.seed);
        if (!areas.length) return missing.push(row);
        const color = roleColor(row);
        const path = areas.flatMap((a) => a.path);
        all.push(...path);

        L.circleMarker(centroid(path), {
          radius: 7,
          color: token('--color-background-elevation-floating', '#fff'),
          weight: 2,
          fillColor: color,
          fillOpacity: 1,
        })
          .bindTooltip(esc(row.name), { className: 'firma2-map-tip', direction: 'top' })
          .on('click', () => map.fitBounds(L.latLngBounds(path), { padding: [48, 48], maxZoom: 13 }))
          .addTo(dots);

        areas.forEach((area) => {
          const style = shapeStyle(area.kind, color);
          const shape =
            area.kind === 'point'
              ? L.circleMarker(area.path[0], { ...style, radius: 6 })
              : area.kind === 'reach'
                ? L.polyline(area.path, style)
                : L.polygon(area.path, style);
          const extent = formatExtent(area.extent, area.unit);
          const line = `${esc(area.label)}${extent ? ` — ${extent}` : ''}`;
          shape
            .bindTooltip(`${esc(row.name)}<br>${line}`, { sticky: true, className: 'firma2-map-tip' })
            .bindPopup(
              `<strong>${esc(row.name)}</strong><br>${line}<br><span class="firma2-org-map__doors"><a href="${row.href}">${esc(vocab('Open project'))}</a>${projectPeekButtonHTML(row.slug, row.name)}</span>`,
            )
            .addTo(shapes);
        });
      });

      syncDots();
      if (frame && all.length) map.fitBounds(L.latLngBounds(all), { padding: [32, 32], maxZoom: 12 });

      unmapped.hidden = missing.length === 0;
      unmapped.innerHTML = missing.length
        ? `Not on the map: ${missing.map((r) => `<a href="${r.href}">${esc(r.name)}</a>`).join(', ')}`
        : '';
    };

    paint(true);
    onGeoChange(() => paint());
  });
</script>
