---
// firma2-org-report-gaps — the projects that owed a report for the last closed
// year and left a measure unfiled, each with the measures it left out.
//
// This is the Home page's one call to act: a gap found here is a report to a
// funder that will be short (brief §0, "make the gaps themselves legible"), and
// naming the measures says what to chase rather than only who.
//
// NOTHING OWED, NOTHING RENDERED. When every project reported, or none owed,
// the summary's reporting tile already says so; a heading over "no rows"
// would say it twice.
//
// The rows are firma2-settings-table's — the same ruled, card-less list every
// short list in this spoke uses — with the project peek on each name, so a
// reader can check the record without leaving the page. The page must use
// firma2-project-peek-layout.
import Firma2SettingsTable from '../settings/firma2-settings-table.astro';
import type { Coverage } from '../../data/firma2-organization-pages';
import { projectHref, projectSlug } from '../../data/firma2-projects';
import { withBase } from '../../lib/base';

interface Props {
  coverage: Coverage;
}

const { coverage } = Astro.props;
const title = `Missing a ${coverage.year} report`;
const rows = coverage.gaps.map(({ project, missing }) => ({
  name: project.projectName,
  href: withBase(projectHref(project)),
  peek: projectSlug(project),
  cells: { missing: missing.join(', '), stage: project.stage, lead: project.leadOrganization },
}));
---
{rows.length > 0 && (
  <section class="stack" data-gap="md" aria-labelledby="firma2-org-report-gaps-title">
    <h2 id="firma2-org-report-gaps-title" class="typography-title-sm-strong">{title}</h2>
    <Firma2SettingsTable
      label={title}
      nameLabel="Project"
      columns={[
        { key: 'missing', label: 'Measures not filed' },
        { key: 'stage', label: 'Stage' },
        { key: 'lead', label: 'Lead organization' },
      ]}
      rows={rows}
    />
  </section>
)}
