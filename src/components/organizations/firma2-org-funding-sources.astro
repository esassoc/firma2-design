---
// firma2-org-funding-sources — the funding sources an organization offers, on
// its page: each a door to the source's own page, with what it has put into
// projects.
//
// ONLY FOR AN ORGANIZATION THAT OFFERS ONE. Most organizations lead work and
// offer no money; for them the section is absent, not empty — "No funding
// sources" under a watershed council would be a row about something nobody
// expected.
//
// A PROJECT'S OWN MATCH IS NOT LISTED. "Local Sponsor Match" is the lead's
// contribution to its own project, recorded as a source so the funding rows
// add up; it is not money the organization offers anyone.
//
// bcn-lego-checked: firma2-settings-table, as the organization's other lists.
// No <style> block.
import Firma2SettingsTable from '../settings/firma2-settings-table.astro';
import { LOCAL_MATCH_NAME, fundingSourceHref } from '../../data/firma2-funding-sources';
import { fundingSourceRollups } from '../../data/firma2-funding-source-rollup';
import { currencyFormatter as money } from '../../lib/format';
import { withBase } from '../../lib/base';

interface Props {
  /** The organization's name. */
  name: string;
}

const { name } = Astro.props;
const rows = fundingSourceRollups()
  .filter((r) => r.source.organization === name && r.source.name !== LOCAL_MATCH_NAME)
  .map((r) => ({
    name: r.source.name,
    href: withBase(fundingSourceHref(r.source.slug)),
    cells: { projects: r.projects, amount: money.format(r.amount) },
  }));
---
{rows.length > 0 && (
  <section class="stack" data-gap="md" aria-labelledby="firma2-org-funding-sources-title">
    <h2 id="firma2-org-funding-sources-title" class="typography-title-sm-strong" data-aliasable>Funding sources</h2>
    <Firma2SettingsTable
      label={`Funding sources ${name} offers`}
      nameLabel="Funding source"
      columns={[
        { key: 'projects', label: 'Projects', numeric: true },
        { key: 'amount', label: 'Funding', numeric: true },
      ]}
      rows={rows}
    />
  </section>
)}
