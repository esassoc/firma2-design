---
// firma2-org-updates — what changed on an organization's projects, newest
// first: values filed, stages moved, pages published, comments left, records
// edited. One feed
// across every project the organization leads or funds, so nobody has to open
// nine project pages to learn what happened this month.
//
// ONE USE: organization Home's latest few, under a heading. The Updates pages
// (workspace and organization) that showed all of them, by month with a
// filter by kind, were removed on 2026-11-24 (user: not needed) — each
// project's History is where the whole log lives.
//
// ONE SITTING, ONE ROW. A person tidying a record makes a run of small edits;
// the feed folds the ones one person made on one project in one day into a
// single row — "4 record edits" — with the log's sentences listed under it
// (projectUpdates in firma2-organization-pages). Reports filed, stage changes
// and publishes never fold: they are what the feed's readers watch for.
//
// THE ROW IS THE RECORD'S OWN WORDS. The change text is the project change
// log's sentence and the comment is the comment — nothing is paraphrased, so
// the feed and the project page cannot tell two stories about one edit.
//
// bcn-lego-checked: a dated activity list has no esa- lego — walked the
// catalog (esa-card, esa-link-column, esa-collapsible, esa-file-list are the
// nearest and none is a feed of dated rows). The rows are plain list markup
// on the layout primitives; this is the reusable home for an organization's
// feed. Beacon is not cloned on this machine.
import type { OrganizationUpdate } from '../../data/firma2-organization-pages';
import { withBase } from '../../lib/base';

interface Props {
  updates: OrganizationUpdate[];
  /** How many of the newest to show. */
  limit?: number;
}

const { updates, limit = 5 } = Astro.props;
const shown = updates.slice(0, limit);
---
<section class="firma2-org-updates stack" data-gap="md" aria-labelledby="firma2-org-updates-title">
  <h2 id="firma2-org-updates-title" class="typography-title-sm-strong">Latest updates</h2>

  {shown.length === 0 ? (
    <p class="typography-body-md">No updates yet.</p>
  ) : (
    <ol class="firma2-org-updates__list" role="list">
      {shown.map((u) => (
        <li class="firma2-org-updates__row" data-kind={u.kind}>
          <div class="repel" data-gap="md">
            <a class="firma2-org-updates__project typography-label-md-strong" href={withBase(u.projectHref)}>{u.projectName}</a>
            <time class="typography-body-sm firma2-org-updates__meta" datetime={u.iso}>{u.date}</time>
          </div>
          <p class="typography-body-md firma2-org-updates__text">{u.kind === 'comment' ? `“${u.text}”` : u.text}</p>
          {u.lines && (
            <ul class="firma2-org-updates__lines typography-body-sm" role="list">
              {u.lines.map((line) => <li>{line}</li>)}
            </ul>
          )}
          <p class="typography-body-sm firma2-org-updates__meta">{u.kind === 'comment' ? `Comment from ${u.author}` : u.author}</p>
        </li>
      ))}
    </ol>
  )}
</section>

<style>
  .firma2-org-updates__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Ruled like firma2-settings-table: a hairline under each row, no card. */
  .firma2-org-updates__row {
    padding-block: var(--spacing-400);
    border-block-end: 1px solid var(--color-border-default);
  }
  .firma2-org-updates__project {
    color: var(--color-content-default-primary);
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .firma2-org-updates__project:hover {
      text-decoration: underline;
    }
  }

  .firma2-org-updates__text,
  .firma2-org-updates__meta {
    margin: 0;
  }
  .firma2-org-updates__text {
    margin-block-start: var(--spacing-100);
    max-inline-size: 72ch;
  }
  .firma2-org-updates__meta {
    color: var(--color-content-default-secondary);
  }

  /* A session's log sentences under its count, in the record's own words. */
  .firma2-org-updates__lines {
    margin: var(--spacing-100) 0 0;
    padding-inline-start: var(--spacing-500);
    max-inline-size: 72ch;
  }
</style>
