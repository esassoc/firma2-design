---
// firma2-top-bar — the thin, pinned strip across the top of the content column:
// the way out on its leading edge (home glyph › breadcrumb trail), the things you
// do with the page on its trailing edge (status · toolbar · actions). Modelled on
// Tally's editor bar (Mobbin, 2026-10-19): one 48px row, the page's name only as
// its last crumb, the big title left to the page body to scroll away.
//
// ONE BAR PER PAGE, OWNED BY THE LAYOUT. AppLayout renders a root-only bar as
// the first child of the content pane, so a page with no header still gets the
// strip. firma2-page-header renders a FULL bar (its crumbs and slots) and an
// inline script swaps it in for the layout's during parse, before first paint —
// the bar has to be a direct child of the pane to span the whole column and to
// stay pinned for the whole page (sticky is bounded by its parent), and the page
// is the only place its contents are known. Nothing is authored in JS: the swap
// moves one server-rendered node.
//
// Slots: "status" (badges — what state the record is in), "toolbar" (record
// utilities), "actions" (the page's workflow; its primary rightmost). No rail
// control lives here: a record's rail icons ride the record's own bar under
// this one (firma2-record-bar; user, 2026-10-22), and every other rail
// carries its toggle in its own corner (firma2-rail).
//
// bcn-lego-checked: esa-app-bar is the strip and esa-breadcrumbs the trail;
// esa-dropdown-menu + EsaButton chrome/iconOnly are the two "…" menus (the
// collapsed middle of a long trail, and the folded toolbar under 45rem). What is
// added is the band behaviour neither lego has — sticky, 48px, hairline, the
// pane-gutter bleed — the same gap firma2-page-header documented (no sticky /
// page-top primitive in the catalog; esa-page-header is the page's title block,
// not its chrome). Beacon is not cloned in this checkout.
//
// ECOLOGY DEVIATION, flagged to the user 2026-10-19: esa-app-bar has no compact
// density (its private padding is 16px/32px, which makes a 72px bar around a
// 40px control) and no tier-3 hooks by design. This component re-points the
// private --_bar-* steps on its own instance to reach 48px. Worth a /request-lego
// for a `density="compact"` variant, which would retire the override.
//
// SECOND DEVIATION, user-chosen 2026-10-19: the bar's buttons are a compact md —
// md's label and icon, re-pinned from AppLayout's 40px control line to 32px.
// esa-button's sm rung would be the obvious reach, but its label is
// microcopy-xs (12px, under the 13px floor) and it saves only 4px. Retire this
// with the same /request-lego: a compact density on esa-button, or an sm with a
// readable label.
import EsaAppBar from '@esa/ecology/esa-app-bar.astro';
import EsaBreadcrumbs from '@esa/ecology/esa-breadcrumbs.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { iconSvg } from '@esa/ecology/icon-registry';
import { withBase } from '../../lib/base';
import { HOME_HREF } from '../../data/firma2-nav';

/** One step of the trail. The LAST crumb is the current page and takes no href. */
export interface TopBarCrumb {
  label: string;
  href?: string;
  /** The label names a renameable noun ("Projects") — see src/lib/vocabulary.ts. */
  aliasable?: boolean;
}

interface Props {
  /** The trail AFTER the home glyph. Omit for the layout's root-only bar. */
  crumbs?: TopBarCrumb[];
  /** "app" is the bar in the pane; "page" is a header's bar waiting to replace it. */
  role?: 'app' | 'page';
}

const { crumbs = [], role = 'app' } = Astro.props;

// THE ROOT IS A GLYPH, not a word. The rail already names the workspace and its
// home row, so a text crumb would say it a third time; the glyph is the way out
// and the visually-hidden word is its name. No ProjectFirma glyph exists yet
// (AppLayout refuses to invent one), so it is the registry's `home`.
const homeIcon = `${iconSvg('home', 16) ?? ''}<span class="visually-hidden">Home</span>`;
const items = [
  { label: '', href: withBase(HOME_HREF), icon: homeIcon },
  ...crumbs.map((c, i) => ({ label: c.label, href: i === crumbs.length - 1 ? undefined : c.href })),
];
const aliasableCrumbs = crumbs.filter((c) => c.aliasable).map((c) => c.label);
const hasStatus = Astro.slots.has('status');
const hasToolbar = Astro.slots.has('toolbar');
const hasActions = Astro.slots.has('actions');
---
<div class="firma2-top-bar" data-firma2-top-bar={role}>
  <EsaAppBar as="div" tone="surface" class="firma2-top-bar__bar">
    <div slot="start" class="firma2-top-bar__trail" data-aliasable-crumbs={aliasableCrumbs.length ? JSON.stringify(aliasableCrumbs) : undefined}>
      <EsaBreadcrumbs items={items} size="md" />
    </div>
    {(hasStatus || hasToolbar || hasActions) && (
      <div slot="end" class="firma2-top-bar__end cluster" data-gap="sm">
        {hasStatus && (
          <div class="firma2-top-bar__status cluster" data-gap="xs">
            <slot name="status" />
          </div>
        )}
        {hasToolbar && (
          <div class="firma2-top-bar__toolbar cluster" data-gap="xs" data-top-bar-toolbar>
            <slot name="toolbar" />
          </div>
        )}
        {/* ONE "…" FOR EVERYTHING THAT FOLDS — the toolbar under 45rem, and the
            secondary actions whenever the bar runs out of room. It starts empty
            (hidden) and the script fills it, so a page with nothing folded never
            shows it. */}
        {(hasToolbar || hasActions) && (
          <esa-dropdown-menu class="firma2-top-bar__fold" position="below-end" data-top-bar-fold data-empty>
            <EsaButton variant="chrome" size="md" iconOnly icon="ellipsis" label="More actions" />
          </esa-dropdown-menu>
        )}
        {hasActions && (
          <div class="firma2-top-bar__actions cluster" data-gap="xs" data-top-bar-actions>
            <slot name="actions" />
          </div>
        )}
      </div>
    )}
  </EsaAppBar>

  {/* The collapsed middle of a long trail. Server-rendered and cloned, because
      EsaButton is compile-time and a runtime-built trigger would be a raw button. */}
  <template data-top-bar-ellipsis>
    <li class="esa-breadcrumbs__item firma2-top-bar__ellipsis">
      <esa-dropdown-menu position="below-start">
        <EsaButton variant="chrome" size="sm" iconOnly icon="ellipsis" label="Show full path" />
      </esa-dropdown-menu>
    </li>
  </template>
</div>

<script>
  import '@esa/ecology/esa-dropdown-menu';
  import type { EsaMenuItem } from '@esa/ecology/esa-dropdown-menu';

  type Menu = HTMLElement & { items: EsaMenuItem[] };

  // THE BAR'S HEIGHT IS PUBLISHED, for the same two consumers the old sticky
  // header band served: scroll-padding (WCAG 2.4.11 — focus and anchors must not
  // land under a pinned region) and --firma2-band-height, which every fold-sized
  // section subtracts. Measured, not restated, so a future density change cannot
  // leave either one stale.
  function publishHeight(bar: HTMLElement): void {
    const sync = (): void => {
      const h = Math.round(bar.getBoundingClientRect().height);
      document.documentElement.style.scrollPaddingBlockStart = `${h}px`;
      document.documentElement.style.setProperty('--firma2-band-height', `${h}px`);
    };
    sync();
    new ResizeObserver(sync).observe(bar);
  }

  const PHONE = matchMedia('(max-width: 45rem)');
  const TABLET = matchMedia('(max-width: 64rem)');

  const nameOf = (el: HTMLElement): string =>
    el.getAttribute('aria-label')?.trim() || el.textContent?.trim() || '';
  const shown = (el: Element): boolean => (el as HTMLElement).getClientRects().length > 0;

  /** One thing in the fold menu: what it reads, and what choosing it does. */
  interface FoldItem {
    label: string;
    run: () => void;
  }

  // THE BAR LAYS ITSELF OUT IN ONE PASS, from a clean slate, every time its
  // width or its actions change. Order of giving, cheapest first:
  //   1. a long trail collapses its middle into "…" (wide screens);
  //   2. the actions' secondary controls fold into the bar's "…" — every one
  //      under 45rem, longest label first and only while the bar is short
  //      under 64rem — and text riding the actions slot (a "Published 3 days
  //      ago") steps out on the way;
  //   3. under 45rem the parent crumb gives way; then, on any bar still short
  //      under 64rem, the primary action drops its label to its icon.
  // The primary action never folds: it is the slot's first primary-variant
  // button, or its last control when none is primary (the slot's own "primary
  // rightmost" rule). Status badges never fold; they ellipsize in CSS.
  // One function rather than one observer per part, because each step changes
  // the room the next one measures.
  function layout(bar: HTMLElement): void {
    const trail = bar.querySelector<HTMLElement>('.firma2-top-bar__trail');
    const list = trail?.querySelector<HTMLOListElement>('.esa-breadcrumbs__list');
    const tpl = bar.querySelector<HTMLTemplateElement>('template[data-top-bar-ellipsis]');
    const end = bar.querySelector<HTMLElement>('.firma2-top-bar__end');
    const toolbar = bar.querySelector<HTMLElement>('[data-top-bar-toolbar]');
    const actions = bar.querySelector<HTMLElement>('[data-top-bar-actions]');
    const status = bar.querySelector<HTMLElement>('.firma2-top-bar__status');
    const fold = bar.querySelector<Menu>('[data-top-bar-fold]');
    if (!trail || !list || !tpl) return;

    // ── The trail ────────────────────────────────────────────────────────────
    const current = list.querySelector<HTMLElement>('.esa-breadcrumbs__current');
    if (current?.textContent?.trim()) current.title = current.textContent.trim();
    const crumbs = [...list.children].filter((li): li is HTMLLIElement => li instanceof HTMLLIElement);
    // home + parent + current: the parent is a real crumb, not the home glyph.
    const parent = crumbs.length >= 3 ? crumbs[crumbs.length - 2] : null;
    // home + ≥1 hidden + parent + current
    const middle = crumbs.length >= 4 ? crumbs.slice(1, -2) : [];
    let node: HTMLLIElement | null = null;
    if (middle.length) {
      node = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
      // The separator after the ellipsis is the first middle crumb's own, so it
      // borrows it rather than drawing one.
      const sep = middle[0].querySelector('.esa-breadcrumbs__separator');
      if (sep) node.append(sep.cloneNode(true));
      middle[0].before(node);
      const menu = node.querySelector<Menu>('esa-dropdown-menu')!;
      menu.items = middle.map((li) => {
        const a = li.querySelector<HTMLAnchorElement>('a');
        return { label: a?.textContent?.trim() ?? '', action: a?.href ?? '' };
      });
      menu.addEventListener('menu-action', (e) => {
        const href = (e as CustomEvent<string>).detail;
        if (href) location.href = href;
      });
    }
    // The current crumb shrinks before the trail overflows, so "fits" means it
    // is not being ellipsized either.
    const trailFits = (): boolean =>
      trail.scrollWidth <= trail.clientWidth + 1 &&
      (!current || current.scrollWidth <= current.clientWidth + 1);
    // The bar is short when either side is past its floor: the trail clipping
    // its crumbs, or the end slot's controls spilling out of it.
    const barFits = (): boolean =>
      trail.scrollWidth <= trail.clientWidth && (!end || end.scrollWidth <= end.clientWidth);

    // ── The actions ──────────────────────────────────────────────────────────
    const CONTROL = '.esa-button, esa-dropdown-menu, esa-button-toggle';
    // A control's box is the outermost wrapper that holds nothing else, so a
    // folded button does not leave its page's <span> holding a gap open.
    const boxOf = (el: HTMLElement): HTMLElement => {
      let box = el;
      while (box.parentElement && box.parentElement !== actions && box.parentElement.children.length === 1) {
        box = box.parentElement;
      }
      return box;
    };
    const controls = (): HTMLElement[] =>
      actions
        ? [...actions.querySelectorAll<HTMLElement>(CONTROL)].filter(
            (el) => !el.parentElement?.closest(CONTROL) && shown(el),
          )
        : [];
    // Free text in the slot — a timestamp beside a button. It has no menu form,
    // so it steps out rather than folding.
    const notes = (root: HTMLElement | null = actions): HTMLElement[] =>
      root
        ? [...root.querySelectorAll<HTMLElement>('*')].filter(
            (el) =>
              !el.closest(CONTROL) &&
              !el.closest('.esa-badge') &&
              [...el.childNodes].some((n) => n.nodeType === Node.TEXT_NODE && n.textContent?.trim()) &&
              shown(el),
          )
        : [];
    const foldable: HTMLElement[] = [];
    // The toolbar's own buttons — not the ones inside what they open. A
    // toolbar component brings its sheet, dialog and toasts along in the same
    // slot, and those have to stay rendered for the buttons to work.
    const SURFACE = 'bcn-side-sheet, esa-dialog, esa-side-dialog, esa-confirm-dialog, esa-snackbar-container, esa-dropdown-menu';
    const toolbarControls = (): HTMLElement[] =>
      toolbar
        ? [...toolbar.querySelectorAll<HTMLElement>('a[href], button')].filter(
            (el) => !el.closest(SURFACE) && nameOf(el),
          )
        : [];

    const sync = (): void => {
      // Clean slate.
      bar.querySelectorAll('[data-top-bar-folded]').forEach((el) => el.removeAttribute('data-top-bar-folded'));
      bar.querySelectorAll('[data-top-bar-compact]').forEach((el) => el.removeAttribute('data-top-bar-compact'));
      trail.removeAttribute('data-drop-parent');
      if (node) {
        node.hidden = true;
        middle.forEach((li) => (li.hidden = false));
      }
      foldable.length = 0;
      const phone = PHONE.matches;
      const tablet = TABLET.matches;
      // A note riding the status (why Publish is still disabled) stays on the
      // one row: CSS ellipsizes it under 64rem and drops it under 45rem.
      notes(status).forEach((el) => el.setAttribute('data-top-bar-note', ''));

      // 0. Under 45rem the toolbar's buttons fold — each one's box, never the
      //    toolbar itself, so the surfaces they open stay laid out (a sheet
      //    inside a display:none toolbar opened at 0×0).
      if (phone) {
        const mine = toolbarControls();
        for (const el of mine) {
          let box = el;
          while (
            box.parentElement &&
            box.parentElement !== toolbar &&
            !box.parentElement.querySelector(SURFACE) &&
            mine.filter((c) => box.parentElement!.contains(c)).length === 1
          ) {
            box = box.parentElement;
          }
          box.setAttribute('data-top-bar-folded', '');
        }
      }

      // 1. The trail's middle (under 45rem CSS keeps only home, parent, current).
      if (node && !phone && !trailFits()) {
        node.hidden = false;
        middle.forEach((li) => (li.hidden = true));
      }

      // 2. The actions.
      const all = controls();
      const primary =
        all.find((el) => el.matches('.esa-button--variant-primary')) ??
        [...all].reverse().find((el) => !el.matches('esa-button-toggle'));
      // A segmented switch has no menu form; it stays.
      const secondary = all.filter((el) => el !== primary && !el.matches('esa-button-toggle'));
      const foldOne = (el: HTMLElement): void => {
        boxOf(el).setAttribute('data-top-bar-folded', '');
        if (el !== primary) foldable.push(el);
      };
      if (phone) {
        notes().forEach((el) => el.setAttribute('data-top-bar-folded', ''));
        secondary.forEach(foldOne);
      } else if (tablet && !barFits()) {
        notes().forEach((el) => el.setAttribute('data-top-bar-folded', ''));
        const longest = [...secondary].sort((a, b) => nameOf(b).length - nameOf(a).length);
        for (const el of longest) {
          if (barFits()) break;
          foldOne(el);
        }
      }
      // Keep the menu's order the slot's order.
      foldable.sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1));

      // 3. The parent crumb (phone), then — on any short bar — the primary's
      //    label, when it has an icon to stand on.
      if (phone && parent && trail.scrollWidth > trail.clientWidth + 1) trail.setAttribute('data-drop-parent', '');
      if (tablet && !barFits() && primary?.matches('.esa-button') && primary.querySelector('.esa-icon, svg')) {
        primary.setAttribute('data-top-bar-compact', '');
      }

      if (fold) {
        const items = foldItems(phone);
        fold.toggleAttribute('data-empty', items.length === 0);
      }
    };

    // ── The fold ─────────────────────────────────────────────────────────────
    // A MIRROR, NOT A COPY: each item is one of the bar's own controls, and
    // choosing it clicks that control (or, for a page's own "…" menu that
    // folded, replays the choice on that menu), so whatever the page wired —
    // share sheet, history drawer, a link — runs unchanged. The toolbar's
    // buttons are icon-only, so an item is named by its accessible name.
    // Toolbar first (it folds only under 45rem, where the pass above folds its buttons), then the
    // folded actions, a divider between the two groups.
    const foldItems = (phone: boolean): FoldItem[] => {
      const groups: FoldItem[][] = [];
      if (phone) {
        groups.push(toolbarControls().map((el) => ({ label: nameOf(el), run: () => el.click() })));
      }
      groups.push(
        foldable.flatMap((el): FoldItem[] => {
          if (el.matches('esa-dropdown-menu')) {
            return ((el as Menu).items ?? [])
              .filter((it) => !it.divider && !it.disabled)
              .map((it) => ({
                label: it.label,
                run: () =>
                  el.dispatchEvent(new CustomEvent('menu-action', { detail: it.action, bubbles: true, composed: true })),
              }));
          }
          const native = el.querySelector<HTMLElement>('.esa-button__native') ?? el;
          const label = nameOf(native);
          return label ? [{ label, run: () => native.click() }] : [];
        }),
      );
      return groups.filter((g) => g.length).flatMap((g, i) => (i ? [{ label: '', run: () => {} }, ...g] : g));
    };

    let openItems: FoldItem[] = [];
    if (fold) {
      // Rebuilt on open, so a control that appeared since the last pass is in it.
      fold.addEventListener(
        'click',
        () => {
          openItems = foldItems(PHONE.matches);
          fold.items = openItems.map((it, i) =>
            it.label ? { label: it.label, action: String(i) } : { label: '', divider: true },
          );
        },
        true,
      );
      fold.addEventListener('menu-action', (e) => {
        openItems[Number((e as CustomEvent<string>).detail)]?.run();
      });
    }

    let queued = 0;
    const schedule = (): void => {
      cancelAnimationFrame(queued);
      queued = requestAnimationFrame(sync);
    };
    sync();
    new ResizeObserver(schedule).observe(bar);
    PHONE.addEventListener('change', schedule);
    TABLET.addEventListener('change', schedule);
    document.fonts?.ready.then(schedule);
    // A page shows and hides its own actions (edit mode, a decision that
    // becomes available). Only those attributes are watched: this pass writes
    // data-* attributes alone, so it cannot wake itself.
    if (actions) {
      new MutationObserver(schedule).observe(actions, {
        subtree: true,
        childList: true,
        attributes: true,
        attributeFilter: ['hidden', 'style'],
      });
    }
  }

  customElements.whenDefined('esa-dropdown-menu').then(() => {
    const bar = document.querySelector<HTMLElement>('[data-firma2-top-bar="app"]');
    if (!bar) return;
    publishHeight(bar);
    layout(bar);
  });
</script>

<style>
  /* The bar's height before the script measures it, so the rails and maps that
     subtract it are right on first paint. The measured inline value wins. */
  :global(:root) {
    --firma2-band-height: 48px;
  }

  .firma2-top-bar {
    /* esa-app-shell's content padding, reached through so the bar runs rail
       edge to window edge — the same literal firma2-page-header and the maps
       restate (no hook exposes it; /request-lego for --app-shell-content-padding
       is filed). */
    /* Read from the shell where it publishes its padding: --firma2-sticky-origin
       is that padding, negated, and follows it when the phone gutter narrows
       to 16px (mobile-foundation 01). The literal above is the fallback. */
    --_bleed: calc(var(--firma2-sticky-origin, calc(var(--spacing-500, 1.5rem) * -1)) * -1);

    position: sticky;
    top: var(--firma2-sticky-origin, 0px);
    /* The header role from the z scale. It outranks ordinary content and the
       layers the two embedded libraries paint — the grid's rows and Leaflet
       (zoom control at 800) both clip under it because each scopes its stack in
       a container of its own. If one ever leaks, the fix is `isolation: isolate`
       on that container, not a higher bid here.
       ONE RUNG ABOVE THE RECORD RAIL, which claims header + 1 for its edge
       toggle (firma2-record-rail). The rail starts under the bar, so the two
       boxes never overlap — but what hangs from the bar does: its tooltips
       and "…" menus drop into the rail's column and were painted under it. */
    z-index: calc(var(--z-header, 200) + 2);
    margin-block: calc(var(--_bleed) * -1) var(--_bleed);
    margin-inline: calc(var(--_bleed) * -1);
  }

  /* 48px, hairline included: a 32px compact button with ~8px above and below
     (user, 2026-10-19 — at 40px the bar sat cramped on its buttons). The
     height is the box's, not padding around the content, so the 1px rule cannot push it to
     49. The surface is the canvas, not a raised plate — the bar is the page's
     own top, and the hairline alone marks where content passes under it. */
  .firma2-top-bar :global(.esa-app-bar.firma2-top-bar__bar) {
    /* The bar's gutter is the pane's, so the home glyph sits on the content's
       leading edge at every width. */
    --_bar-pad-x: var(--_bleed);
    --_bar-pad-y: 0px;
    --_bar-gap: var(--spacing-400, 1rem);
    box-sizing: border-box;
    min-block-size: 48px;
    display: flex;
    align-items: center;
    background: var(--firma2-sheet-background, var(--color-background-default, #fcfcfc));
    border-block-end: 1px solid var(--color-border-default, #e0e0e0);
  }
  .firma2-top-bar :global(.firma2-top-bar__bar > .esa-app-bar__row) {
    flex: 1;
    min-inline-size: 0;
  }

  /* COMPACT BUTTONS. AppLayout pins every md button to the 40px control line;
     in the bar that line is the bar itself, so its buttons step down to 32px —
     tighter top and bottom, md's label and icon unchanged. Icon-only buttons
     stay squares, the trail's sm "…" included (its padding alone made it 36). */
  .firma2-top-bar :global(.firma2-top-bar__bar .esa-button--md > .esa-button__native) {
    block-size: 32px;
    padding-block: 0;
  }
  .firma2-top-bar :global(.firma2-top-bar__bar.esa-app-bar .esa-button--icon-only > .esa-button__native) {
    block-size: 32px;
    inline-size: 32px;
    padding: 0;
  }
  /* A segmented switch (firma2-variant-switch) rides the actions slot on My
     Projects. At md it is 46px — taller than the bar — and it is Lit, so the
     light-DOM pin above cannot reach it; its private --_pad-y is set on the
     host, where an outer rule outranks :host(). Same deviation as the bar's.
     5.5px is not a step: it is what lands the switch on the buttons' 32px
     (21px of border, track inset and leading, measured 2026-10-19) — the 4px
     step made it 29, the 6px one 33. */
  .firma2-top-bar :global(.firma2-top-bar__bar esa-button-toggle) {
    --_pad-y: 5.5px;
  }

  /* The trail takes the slack and is the part that gives: it never wraps, and
     its current crumb ellipsizes before the actions are pushed. The start slot
     ships `flex: none`, which is right for a logo and wrong for a trail. */
  .firma2-top-bar :global(.esa-app-bar__start) {
    flex: 1 1 auto;
    min-inline-size: 0;
  }
  .firma2-top-bar__trail {
    min-inline-size: 0;
    overflow: hidden;
  }
  .firma2-top-bar__trail :global(.esa-breadcrumbs__list) {
    flex-wrap: nowrap;
  }
  .firma2-top-bar__trail :global(.esa-breadcrumbs__item) {
    flex: none;
    white-space: nowrap;
  }
  .firma2-top-bar__trail :global(.esa-breadcrumbs__item:last-child) {
    flex: 0 1 auto;
    min-inline-size: 0;
  }
  .firma2-top-bar__trail :global(.esa-breadcrumbs__current) {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* The glyph crumb has no text, so its link's 4px icon gap would offset it. */
  .firma2-top-bar__trail :global(.esa-breadcrumbs__item:first-child .esa-breadcrumbs__link) {
    gap: 0;
  }
