---
// bcn-option-list — the vocabulary a question can be answered with, edited as
// the list it actually is.
//
// WHAT IT REPLACED AND WHY THAT WAS WRONG. Both places that collect options —
// the primary category and every supporting question — used esa-input-tag: a
// text box you type into, press Enter, and watch your word turn into a removable
// chip below. It is a good lego and it is the wrong one here, for four reasons
// that all point the same way:
//
//   1. YOU CANNOT EDIT AN OPTION. A chip is add-or-destroy. Fixing "Invasve
//      removal" means deleting the chip and retyping the whole phrase. That is
//      the exact friction this product exists to remove — see the product
//      brief's "always editable, always saved": see something you want to
//      change, change it, with the fewest steps possible.
//   2. IT NEEDED INSTRUCTIONS. The field carried the help line "Press Enter
//      after each option." A control that has to explain its own keystroke is a
//      control doing the wrong job; the instruction is the symptom, not the fix.
//   3. ENTER IS A TRAP NOW THAT NOTHING IS SAVED EXPLICITLY. Type an option,
//      forget Enter, click away — the word is gone, and there is no Save button
//      left whose absence you would have noticed.
//   4. CHIPS ARE THE WRONG PICTURE. These options become the choices on every
//      entry form this measure ever renders — a list a reporter reads top to
//      bottom. A wrapped bag of tokens is not what they will look like, and it
//      hides the order they will appear in.
//
// THE PATTERN INSTEAD: one row per option, each a real field you can click into
// and correct, with a permanently blank row at the bottom. Typing in the blank
// row makes it an option and a fresh blank row appears underneath. There is no
// Add button, no Enter to remember, and no help text explaining any of it —
// the empty row IS the affordance, and it says what it does ("Add an option").
//
// EMPTYING A ROW REMOVES IT, which is the same rule firma2-measure-record
// already states for the primary category ("emptying its fields IS removing the
// primary"). One model for "delete" across the screen. The explicit remove
// button stays as well, because clearing a field is a discoverable rule only
// after you have discovered it, and destroying three words should not be the
// only path that is obvious.
//
// bcn-lego-checked: this composes esa-text-field and esa-button and reinvents
// neither — the row IS those two legos on a `.cluster`, the list is a `.stack`.
// What is bespoke is the BEHAVIOUR (a self-extending list with an editable row
// per value), and there is no lego for it: esa-input-tag is the closest and its
// four faults are itemised above; esa-chip-group renders a read-only set;
// esa-select is a closed vocabulary you pick FROM, not one you are authoring.
// Beacon is not cloned on this machine. `bcn-` rather than `firma2-` because
// nothing here knows what a measure is: it is a list of strings with a label,
// and every entity setup in this product has one (an organization's contact
// roles, a funding source's grant cycles, a protocol's sampling methods).
//
// CONTRACT — this is a real custom element, not an Astro-only component, and it
// has to be: firma2-reporter-questions clones a prototype ROW containing one of
// these, and only a custom element upgrades itself on insertion. It matches the
// surface esa-input-tag exposed, so it is a drop-in for both callers:
//   .value            get/set string[] — empty strings are never returned
//   .updateComplete   resolves after a set has settled and painted
//   `change`          bubbling + composed, on every mutation
//
// ONE CONTROL SIZE: md, everywhere, no exceptions.
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  /** Names the list for assistive tech and renders above it. */
  label: string;
  /** The vocabulary as authored. Empty is the normal state on a fresh draft. */
  options?: string[];
  /** Placeholder for a real option's field — the caller's own example. */
  placeholder?: string;
  /** Extra class for the caller's layout. */
  class?: string;
}

const { label, options = [], placeholder = '', class: className } = Astro.props;

// Every instance needs its own label id: a page renders one of these per
// supporting question plus one for the primary category, and a duplicated id
// would point every list's rows at the first list's name.
const uid = Math.random().toString(36).slice(2, 8);
const labelId = `bcn-option-list-${uid}`;

// Copy. There is exactly one string in this component and it is doing the work
// the deleted help line used to do badly: it names the ACT ("Add an option")
// rather than the keystroke ("Press Enter after each option"), and it sits in
// the place the act happens instead of underneath the whole field.
const ADD_PLACEHOLDER = 'Add an option';
const REMOVE_LABEL = 'Remove option';

// The server prints one row per authored option and nothing else. The blank
// tail row is appended by the element, so "there is always exactly one empty row
// at the end" has ONE implementation rather than two that must agree.
---
<bcn-option-list class:list={['bcn-option-list', className]} data-add-placeholder={ADD_PLACEHOLDER}>
  <!-- A <span>, not a <label>: a <label> names ONE control and this names a
       list of them. The <ul> takes it through aria-labelledby, so a screen
       reader announces "Options, list, 3 items" on entry and each row carries
       its own position name. -->
  <span id={labelId} class="bcn-option-list__label typography-label-sm">{label}</span>

  <ul id={`${labelId}-rows`} class="bcn-option-list__rows stack" data-gap="2xs" aria-labelledby={labelId}>
    {options.map((option) => (
      <li class="bcn-option-list__row cluster" data-gap="2xs">
        <!-- The field's NAME is set by the script, per row, because it is
             positional ("Options 2 of 4") and the positions renumber on every
             add and remove. `label` rather than `aria-label`: esa-text-field
             binds neither to its inner <input>, but it DOES render a real
             <label for>, so the visible-label path is the only one that
             actually names the control — and the script hides it in the shadow
             root, the same adopted-stylesheet technique this spoke already uses
             to pin control heights. A visible label per row would be the word
             "Options" printed four times. -->
        <esa-text-field
          class="bcn-option-list__field"
          size="md"
          value={option}
          placeholder={placeholder}
        ></esa-text-field>

        <!-- The accessible name identifies WHICH option this destroys — the
             typed value once there is one, the position until then. Kept
             visually quiet until the row is hovered or something in it has
             focus, so a list of six options reads as six words and not as six
             words and six buttons. -->
        <EsaButton
          class="bcn-option-list__remove"
          variant="chrome"
          iconOnly
          icon="x"
          size="md"
          aria-label={REMOVE_LABEL}
        >{REMOVE_LABEL}</EsaButton>
      </li>
    ))}
  </ul>

  <!-- A REAL <template>, NOT A HIDDEN ROW LIFTED ON INIT. Lifting is the
       technique firma2-reporter-questions uses and it is right there; it is
       wrong here, and the difference is that THIS component gets cloned. That
       page clones a whole question row — which contains one of these — by
       serializing its outerHTML, and if this element had already lifted its
       prototype out of the DOM by then, every cloned list would be a list that
       can never grow a row. Module execution order across two component scripts
       is not guaranteed, so it would have been a race, not a bug that shows up
       every time.
       Template content is inert: it is never upgraded, never painted, and
       survives outerHTML round trips intact. Still ONE authored copy — the row
       an author adds and the row the server printed are the same markup. -->
  <template data-option-row>
    <li class="bcn-option-list__row cluster" data-gap="2xs">
      <esa-text-field class="bcn-option-list__field" size="md" placeholder={placeholder}></esa-text-field>
      <EsaButton
        class="bcn-option-list__remove"
        variant="chrome"
        iconOnly
        icon="x"
        size="md"
        aria-label={REMOVE_LABEL}
      >{REMOVE_LABEL}</EsaButton>
    </li>
  </template>
</bcn-option-list>

<style>
  .bcn-option-list {
    display: block;
  }

  /* Matches the gap esa-text-field puts between its own label and control, so a
     list sitting beside a plain field in the same block has its name on the same
     baseline as the field's. */
  .bcn-option-list__label {
    display: block;
    margin-block-end: var(--spacing-100, 0.25rem);
    color: var(--color-content-default, #202020);
  }

  .bcn-option-list__rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* `nowrap` so the remove button never drops under its own field — a cluster
     wraps by default, and at rail width the row is close enough to the
     threshold that it would. The field takes the slack; the button is fixed. */
  .bcn-option-list__row {
    flex-wrap: nowrap;
  }

  .bcn-option-list__field {
    flex: 1 1 auto;
    min-inline-size: 0;
  }

  /* 40px, the one control height in this app. esa-button's icon-only md rung is
     46px — see AppLayout's CONTROL_PINS note for why every lego disagrees here.
     Light DOM, so this is plain CSS rather than an adopted stylesheet. */
  .bcn-option-list__row :global(.bcn-option-list__remove .esa-button__native) {
    block-size: 40px;
    inline-size: 40px;
  }

  /* QUIET UNTIL ASKED FOR. Six options should read as six words. `opacity`
     rather than `display` or `visibility` so the button keeps its box (the rows
     do not reflow when one is hovered) AND stays in the tab order — a keyboard
     user never hovers, and their focus is what reveals it. */
  .bcn-option-list__row :global(.bcn-option-list__remove) {
    opacity: 0;
    transition: opacity 120ms ease;
  }
  .bcn-option-list__row:hover :global(.bcn-option-list__remove),
  .bcn-option-list__row:focus-within :global(.bcn-option-list__remove) {
    opacity: 1;
  }
  @media (hover: none) {
    /* No hover to reveal with, so it is simply always there. */
    .bcn-option-list__row :global(.bcn-option-list__remove) {
      opacity: 1;
    }
  }

  /* The blank tail row has nothing to remove yet. The button is hidden rather
     than absent so the field's width matches every row above it — an input that
     grew 40px wider on the last row would make the list look ragged. */
  .bcn-option-list__row--new :global(.bcn-option-list__remove) {
    visibility: hidden;
  }

  /* The one colour in the component, on a destructive control at the moment of
     commitment — the same treatment firma2-reporter-questions gives its own
     remove. */
  .bcn-option-list__row :global(.bcn-option-list__remove .esa-button__native:hover),
  .bcn-option-list__row :global(.bcn-option-list__remove .esa-button__native:focus-visible) {
    color: var(--color-content-utility-danger, #ce2c31);
  }
</style>

<script>
  import '@esa/ecology/esa-text-field';

  // Hide the per-row label and pin the control to 40px in one sheet. The label
  // is a real <label for> — the only thing esa-text-field binds to its inner
  // input — so it has to EXIST to name the control and has to be invisible to
  // avoid printing "Options" once per row. The clip-rect pattern is a11y.css's
  // `.visually-hidden`, restated here because that class cannot reach into a
  // shadow root. The height pin is AppLayout's CONTROL_PINS payload, re-applied
  // per row for the same reason firma2-reporter-questions re-applies it: rows
  // created after load never went past that one-time pass.
  const FIELD_CSS = `
    .label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }
    .control { height: 40px; }
    .input { padding-block: 0; }
  `;

  type Field = HTMLElement & { value?: string; label?: string; updateComplete?: Promise<unknown> };
  type Marked = ShadowRoot & { _bcnOptionField?: boolean };

  function adopt(host: Element): void {
    const root = host.shadowRoot as Marked | null;
    if (!root || root._bcnOptionField) return;
    const sheet = new CSSStyleSheet();
    sheet.replaceSync(FIELD_CSS);
    root.adoptedStyleSheets = [...root.adoptedStyleSheets, sheet];
    root._bcnOptionField = true;
  }

  const frame = (): Promise<void> =>
    new Promise((resolve) => requestAnimationFrame(() => resolve()));

  class BcnOptionList extends HTMLElement {
    #template: HTMLTemplateElement | null = null;
    #wired = false;

    connectedCallback(): void {
      if (this.#wired) return;
      this.#wired = true;

      const list = this.#list;
      this.#template = this.querySelector<HTMLTemplateElement>('template[data-option-row]');
      if (!list || !this.#template) return;

      // NORMALISE FIRST, then add the tail. A clone taken from a LIVE list
      // already carries whatever blank rows that list had grown, so appending
      // unconditionally would give it two. Dropping every empty row and adding
      // exactly one is idempotent, which is what makes this safe to run on a
      // server-printed element and on a clone of a running one.
      this.#dropEmptyRows();
      list.append(this.#newRow());
      this.#refresh();

      // DELEGATED, so rows added later need no wiring of their own. `input`
      // from esa-text-field's inner control is composed and arrives here.
      this.addEventListener('input', this.#onInput);
      this.addEventListener('change', this.#onChange);
      this.addEventListener('focusout', this.#onFocusOut);
      this.addEventListener('click', this.#onClick);
      this.addEventListener('keydown', this.#onKeyDown);
    }

    // ---- the contract esa-input-tag used to satisfy ------------------------

    get value(): string[] {
      return this.#fields()
        .map((f) => (f.value ?? '').trim())
        .filter(Boolean);
    }

    set value(next: string[]) {
      const list = this.#list;
      if (!list || !this.#template) return;
      list.replaceChildren();
      for (const option of Array.isArray(next) ? next : []) {
        list.append(this.#newRow(option));
      }
      list.append(this.#newRow());
      this.#refresh();
    }

    /** Resolves once every row's field has rendered and the frame has painted. */
    get updateComplete(): Promise<void> {
      return Promise.all(this.#fields().map((f) => Promise.resolve(f.updateComplete)))
        .then(frame)
        .then(() => undefined);
    }

    // ---- internals ---------------------------------------------------------

    get #list(): HTMLElement | null {
      return this.querySelector<HTMLElement>('.bcn-option-list__rows');
    }

    #rows(): HTMLElement[] {
      return [...this.querySelectorAll<HTMLElement>('.bcn-option-list__row')];
    }

    #fields(): Field[] {
      return [...this.querySelectorAll<Field>('.bcn-option-list__field')];
    }

    /** Every row whose field is blank. Empty options are never meaningful. */
    #dropEmptyRows(): void {
      this.#rows().forEach((row) => {
        const field = row.querySelector<Field>('.bcn-option-list__field');
        if (!(field?.value ?? field?.getAttribute('value') ?? '').trim()) row.remove();
      });
    }

    #newRow(value = ''): HTMLElement {
      const row = this.#template!.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const field = row.querySelector<Field>('.bcn-option-list__field');
      // A property, not an attribute: the lego reads `.value` and the attribute
      // is only its initial seed, so setting the attribute on a row the author
      // later edits would be a value that silently stops tracking.
      if (field) field.setAttribute('value', value);
      return row;
    }

    /**
     * The list's one invariant, restated after every mutation: exactly one blank
     * row, always last, and every row named for where it sits. Called rather
     * than reasoned about, because add, remove, clear and a programmatic `set`
     * all disturb the same two things.
     */
    #refresh(): void {
      const rows = this.#rows();
      const addPlaceholder = this.dataset.addPlaceholder ?? '';
      const name = this.querySelector('.bcn-option-list__label')?.textContent?.trim() ?? 'Option';

      rows.forEach((row, index) => {
        const last = index === rows.length - 1;
        row.classList.toggle('bcn-option-list__row--new', last);

        const field = row.querySelector<Field>('.bcn-option-list__field');
        if (field) {
          // The name is positional and the positions renumber on every add and
          // remove, so it is written here rather than in the markup.
          field.label = last ? addPlaceholder : `${name} ${index + 1} of ${rows.length - 1}`;
          if (last) field.setAttribute('placeholder', addPlaceholder);
          void Promise.resolve(field.updateComplete).then(() => adopt(field));
        }

        const remove = row.querySelector<HTMLElement>('.bcn-option-list__remove button');
        if (remove) {
          const typed = (field?.value ?? '').trim();
          remove.setAttribute('aria-label', typed ? `Remove ${typed}` : 'Remove option');
        }
      });
    }

    #announce(): void {
      this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
    }

    #onInput = (event: Event): void => {
      const row = (event.target as Element).closest<HTMLElement>('.bcn-option-list__row');
      if (!row || !this.#list) return;
      // Typing in the tail row is what CREATES an option — no Enter, no button.
      // The new blank row is appended immediately so the affordance for the NEXT
      // one is already on screen by the time this one is finished.
      const rows = this.#rows();
      if (row === rows[rows.length - 1] && (row.querySelector<Field>('.bcn-option-list__field')?.value ?? '')) {
        this.#list.append(this.#newRow());
        this.#refresh();
      }
    };

    #onChange = (event: Event): void => {
      // OUR OWN EVENT, LET IT GO. #announce dispatches `change` ON this element,
      // and a listener bound to this element hears it — so without this guard the
      // handler answered its own broadcast and recursed until the stack gave out.
      // (Measured: "Maximum call stack size exceeded", once per keystroke.)
      if (event.target === this) return;

      // A row field's change is an implementation detail of this list. Swallow it
      // and re-emit one event from the list itself, or the caller receives two
      // for one edit — one naming an esa-text-field it has never heard of.
      event.stopPropagation();
      this.#refresh();
      this.#announce();
    };

    #onFocusOut = (): void => {
      // Cleared and left: the row goes. Deferred one tick because focusout fires
      // BEFORE the next element takes focus, and removing a row mid-transition
      // drops focus to <body>. By the next tick the browser has landed.
      setTimeout(() => {
        if (this.contains(document.activeElement)) return;
        const rows = this.#rows();
        let removed = false;
        rows.slice(0, -1).forEach((row) => {
          const field = row.querySelector<Field>('.bcn-option-list__field');
          if (!(field?.value ?? '').trim()) {
            row.remove();
            removed = true;
          }
        });
        if (removed) {
          this.#refresh();
          this.#announce();
        }
      }, 0);
    };

    #onClick = (event: Event): void => {
      const trigger = (event.target as Element).closest('.bcn-option-list__remove');
      const row = trigger?.closest<HTMLElement>('.bcn-option-list__row');
      if (!row) return;
      const rows = this.#rows();
      const index = rows.indexOf(row);
      row.remove();
      this.#refresh();
      // Focus the row that took this one's place, or the last one if this was
      // the end — never <body>, which is where a keyboard user would otherwise
      // be dropped after every deletion.
      const after = this.#rows();
      const next = after[Math.min(index, after.length - 1)];
      next?.querySelector<HTMLElement>('.bcn-option-list__field')?.focus();
      this.#announce();
    };

    #onKeyDown = (event: KeyboardEvent): void => {
      if (event.key !== 'Enter') return;
      // Enter is NOT required — typing is what adds — but a keyboard user who
      // presses it expects to move on rather than to submit whatever form they
      // are standing in. So it means "next row", and on the last row that row is
      // already there.
      const row = (event.target as Element).closest<HTMLElement>('.bcn-option-list__row');
      if (!row) return;
      event.preventDefault();
      const rows = this.#rows();
      const next = rows[rows.indexOf(row) + 1];
      next?.querySelector<HTMLElement>('.bcn-option-list__field')?.focus();
    };
  }

  if (!customElements.get('bcn-option-list')) {
    customElements.define('bcn-option-list', BcnOptionList);
  }
</script>
