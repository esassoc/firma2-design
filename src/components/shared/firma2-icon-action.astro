---
// firma2-icon-action — an icon-only chrome button with its name as a tooltip:
// the top bar's utilities (Share, Fact sheet, History, Review changes, the side
// panel toggles, Open project, Download). Since 2026-10-20 (user) only Edit /
// Update keeps a label in the bar; everything else is a glyph, and a glyph
// needs its name on hover and focus.
//
// THE NAME RIDES aria-label, NOT `label`. EsaButton's `label` also sets the
// native `title`, which would stack a slow browser tooltip on top of
// esa-tooltip's. aria-label counts as the accessible name for iconOnly, so the
// button is still named and the build warning stays quiet.
//
// bcn-lego-checked: composes esa-tooltip around EsaButton chrome iconOnly, both
// unchanged — no lego pairs the two, and six call sites would otherwise restate
// the pair. No styles. Beacon is not cloned in this checkout.
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  /** The action's name — the accessible name and the tooltip text. */
  label: string;
  /** Registry icon name (Lucide-keyed). */
  icon: string;
  /** Renders an <a> when set. */
  href?: string;
  /** Anything else (data-*, aria-*) is forwarded to the native control. */
  [attr: string]: unknown;
}

// `slot` places this component in its parent and must not reach the button:
// inside esa-tooltip's shadow root it would name a slot that does not exist,
// and the button would not render.
const { label, icon, href, slot: _slot, ...rest } = Astro.props;
---
<esa-tooltip text={label} position="below">
  <EsaButton variant="chrome" size="md" iconOnly icon={icon} aria-label={label} tag={href ? 'a' : undefined} href={href} {...rest} />
</esa-tooltip>

<script>
  import '@esa/ecology/esa-tooltip';
</script>
