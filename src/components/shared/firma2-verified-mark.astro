---
// firma2-verified-mark — the mark a VERIFIED organization carries beside its
// name: a check and the domain it proved it controls ("✓ deltarcd.org").
//
// THE DOMAIN, NOT A BADGE. A bare "Verified" proves only that someone pressed
// a button; a lookalike domain (apple-inc.org) verifies honestly too. Spelling
// the domain out lets the reader judge it (.scratch/access-requests/spec.md,
// decision 6). An unverified organization renders nothing — no "Unverified"
// label, which would read as an accusation against every funder nobody has
// set up yet.
//
// The check marks the datum it sits on, so it is aria-hidden; the accessible
// text says "Verified domain" once.
//
// bcn-lego-checked: esa-icon is the glyph and the text is a typography
// composite; no esa- lego shows a verified domain (esa-badge is a status chip,
// and a bordered chip beside every name is the clutter this avoids). Beacon is
// not cloned on this machine. `.cluster` lays it out; the only CSS colours the
// check with the success role.
import EsaIcon from '@esa/ecology/esa-icon.astro';
import { verifiedDomain, type Organization } from '../../data/firma2-directory';

interface Props {
  organization: Pick<Organization, 'website' | 'approvedDomains'>;
}

const domain = verifiedDomain(Astro.props.organization);
---
{domain && (
  <span class="firma2-verified-mark cluster typography-meta" data-gap="2xs">
    <span class="firma2-verified-mark__check" aria-hidden="true"><EsaIcon name="check" size="xs" /></span>
    <span><span class="visually-hidden">Verified domain </span>{domain}</span>
  </span>
)}

<style>
  .firma2-verified-mark {
    display: inline-flex;
    color: var(--color-text-secondary);
  }
  .firma2-verified-mark__check {
    display: inline-flex;
    color: var(--color-content-utility-success);
  }
</style>
