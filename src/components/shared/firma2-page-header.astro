---
// firma2-page-header — the page's own top: its breadcrumb trail, status and
// actions, handed to the app's pinned top bar, and its title, which stays in the
// page and scrolls with it.
//
// Slots: "status" (what STATE the record is in — badges), "toolbar" (record-
// level utilities) and "actions" (the page's workflow, primary last). All three
// render in firma2-top-bar, trailing the crumbs, in that order.
//
// SINCE 2026-10-19 THE TITLE IS NOT PINNED. The sticky band below used to hold
// crumb, title, status and actions together, and it was tall. The thin top bar
// (Tally's editor bar was the reference) now carries everything that has to stay
// on screen — the way out, the current page's name as its last crumb, and what
// you can do here — so the h1 is ordinary page content. The API did not change:
// no page had to be edited. The history below is kept where it still explains a
// decision the bar inherited.
//
// bcn-lego-checked: esa-page-header IS the title block and remains the whole
// of it; esa-breadcrumbs (inside firma2-top-bar) renders the trail. Nothing here
// re-implements either. What this component adds is the hand-off to the bar and
// the editable title's adoption of the lego's h1. Beacon is not cloned in this
// checkout. Every prototype opens with this section, so one shared component is
// its home — which is also what keeps the bar identical on every screen.
import EsaPageHeader from '@esa/ecology/esa-page-header.astro';
import Firma2EditableField from './firma2-editable-field.astro';
import Firma2TopBar from './firma2-top-bar.astro';

/** One step of the trail. The LAST crumb is the current page and takes no href —
    esa-breadcrumbs marks it aria-current="page" on that basis. */
export interface Crumb {
  label: string;
  href?: string;
  /** The label names a renameable noun ("Projects") — see src/lib/vocabulary.ts. */
  aliasable?: boolean;
}

/** Makes the h1 a field. `field` is the record's own key ("projectName");
    `label` is the word the display's edit hint and its text box are announced with. */
export interface EditableTitle {
  field: string;
  label: string;
  /**
   * The STORED value when it differs from the displayed title — a record that
   * has no name yet shows its fallback ("Untitled measure") as the h1, and the
   * editor must open EMPTY rather than seeded with the fallback, or the
   * fallback becomes the name the first time anyone commits. Defaults to the
   * title itself, which is the named-record case.
   */
  editValue?: string;
}

interface Props {
  /** The page's name. Renders as the h1. */
  title: string;
  /** The trail in the top bar, ending with this page. Omit on a top-level page:
      the bar then reads home › title. */
  crumbs?: Crumb[];
  /**
   * Present when the title is a STORED VALUE the reader may correct — a record's
   * name, not a screen's name. Omit on every page whose title is a route.
   */
  editableTitle?: EditableTitle;
  /**
   * The title names a renameable noun ("Projects"), so the tenant's
   * vocabulary rewrites it. Opt-in — see src/lib/vocabulary.ts.
   */
  aliasableTitle?: boolean;
}

const { title, crumbs, editableTitle, aliasableTitle = false } = Astro.props;
// A top-level page's trail is just its own name after the home glyph.
const trail = crumbs?.length ? crumbs : [{ label: title, aliasable: aliasableTitle }];
const hasStatus = Astro.slots.has('status');
const hasToolbar = Astro.slots.has('toolbar');
const hasActions = Astro.slots.has('actions');
---
{/* THE BAR FIRST, THEN THE SWAP. This bar is rendered here because only the
    page knows its trail and its actions; the inline script directly after it
    replaces the layout's root-only bar with it DURING PARSE, so the bar the
    reader first sees is already this one — no flash, no second paint. It has
    to run synchronously, which is why it is is:inline and reads currentScript:
    a module script would run after first paint. Astro counts a forwarded slot
    as FILLED even inside a false expression, so the bar may receive an empty
    cluster; it hides its own empty clusters rather than trusting has(). */}
<Firma2TopBar role="page" crumbs={trail}>
  {hasStatus && <slot name="status" slot="status" />}
  {hasToolbar && <slot name="toolbar" slot="toolbar" />}
  {hasActions && <slot name="actions" slot="actions" />}
</Firma2TopBar>
<script is:inline>
  (() => {
    const mine = document.currentScript && document.currentScript.previousElementSibling;
    const host = document.querySelector('[data-firma2-top-bar="app"]');
    if (!mine || !host || mine.getAttribute('data-firma2-top-bar') !== 'page') return;
    mine.setAttribute('data-firma2-top-bar', 'app');
    host.replaceWith(mine);
  })();
</script>

<div class="firma2-page-header" data-aliasable-title={aliasableTitle ? '' : undefined}>
  <EsaPageHeader title={title} />

  {/* THE TITLE, AS A FIELD. It renders here, outside the header, and the script
      below moves it into the title block around the h1 esa-page-header already
      rendered — the lego takes its title as a string prop and offers no slot to
      put a field in, so adoption is the only composition available that does not
      print the name twice. Rendered as MARKUP by the shared component, never
      built in JS: the script moves nodes, it does not author any.

      Filed as a /request-lego — a `title` slot on esa-page-header would let this
      be plain composition, and every spoke with an editable record name wants it. */}
  {editableTitle && (
    <Firma2EditableField
      field={editableTitle.field}
      label={editableTitle.label}
      value={title}
      editValue={editableTitle.editValue}
      as="page-title"
      required
    />
  )}

</div>

<script>
  // The bar's height (scroll-padding, --firma2-band-height) is published by
  // firma2-top-bar itself — it is the only pinned region now.
  const band = document.querySelector<HTMLElement>('.firma2-page-header');

  // ── THE EDITABLE TITLE: dock the field around the lego's own h1 ─────────────
  //
  // esa-page-header takes its title as a STRING prop and renders the h1 itself,
  // so there is no slot a field can be composed into. The two alternatives were
  // both worse: rendering a second heading and hiding the lego's puts the record's
  // name in the DOM twice and ships two h1s to anyone whose JS never ran, and
  // re-implementing the header's bar in the spoke drifts the one component every
  // page opens with. So the field ADOPTS the heading — the h1 esa-page-header
  // rendered is moved into the row, and the row's own display BUTTON (which the
  // field server-renders carrying the same title text) is moved inside the h1.
  // The heading keeps its class and its scope hash, so it looks identical after
  // the move; its content is now the button, so the heading's accessible name is
  // still exactly the project name (a button inside a heading is valid HTML —
  // the reverse nesting is not).
  //
  // The row's markup is server-rendered by firma2-editable-field; this only moves
  // nodes, it never authors any. Everything after the move — hover chrome, open,
  // seed, commit-on-leave, Enter, Escape, focus return — is that component's
  // delegated script, unchanged and shared with every other field on the page.
  const titleField = band?.querySelector<HTMLElement>('[data-editable-field][data-adopt-display]');
  const heading = band?.querySelector<HTMLElement>('.esa-page-header__title');

  if (band && titleField && heading) {
    // Grab the button BEFORE any node moves — after replaceChildren it is the
    // h1's content, and querying for it then would still work, but taking the
    // reference first keeps the sequence order-proof.
    const display = titleField.querySelector<HTMLElement>('[data-field-display]');
    heading.replaceWith(titleField);
    titleField.prepend(heading);
    if (display) heading.replaceChildren(display);
    titleField.hidden = false;

    // THE EDITOR KEEPS THE TITLE'S TYPE. Left alone, opening the title swaps a
    // 30px two-line heading for a 40px box of 15px text — the record's name
    // shrinks to half size at the exact moment someone is working on it, and
    // the band collapses under the sticky header. The input takes the h1's own
    // COMPUTED type instead (measured, not restated — the heading's composite
    // class stays the single source of truth), and the control's box goes
    // height:auto so it fits what it now holds.
    //
    // An adopted stylesheet into the lego's shadow root — the same technique,
    // and the same justification, as AppLayout's CONTROL_PINS and the select
    // option alignment in firma2-editable-field: a hub gap (no size rung
    // renders heading-scale text), worth a /request-lego, escaped locally and
    // loudly. `:host`-prefixed so it outranks the CONTROL_PINS 40px pin
    // regardless of which sheet lands last.
    const titleInput = titleField.querySelector<HTMLElement>('esa-text-field');
    if (titleInput) {
      customElements.whenDefined('esa-text-field').then(async () => {
        await (titleInput as HTMLElement & { updateComplete?: Promise<unknown> }).updateComplete;
        const root = titleInput.shadowRoot;
        if (!root) return;
        const type = getComputedStyle(heading);
        const sheet = new CSSStyleSheet();
        sheet.replaceSync(`
          :host .control { height: auto; }
          :host .input {
            font-size: ${type.fontSize};
            font-weight: ${type.fontWeight};
            line-height: ${type.lineHeight};
            letter-spacing: ${type.letterSpacing};
          }
        `);
        root.adoptedStyleSheets = [...root.adoptedStyleSheets, sheet];
      });
    }

    // THE NAME IS ON SCREEN TWICE, and the second one is one line up. The last
    // breadcrumb IS the current page, so a rename that left it reading the old
    // name would show a reader two names for one record with 12px between them.
    // The browser tab is the third copy and gets the same treatment: it is how a
    // reader picks this record out of eight open tabs.
    const crumb = document.querySelector<HTMLElement>('[data-firma2-top-bar="app"] .esa-breadcrumbs__current');
    let previous = heading.textContent?.trim() ?? '';

    titleField.addEventListener('firma2:field-save', (event: Event) => {
      const next = (event as CustomEvent<{ value: string }>).detail?.value?.trim() ?? '';
      if (!next || next === previous) return;
      if (crumb) {
        crumb.textContent = next;
        crumb.title = next;
      }
      // Replaced rather than rebuilt: the tab title is `<name> — <app>`, and the
      // suffix is the page's to compose, not this component's to know.
      if (previous) document.title = document.title.replace(previous, next);
      previous = next;
    });
  }
</script>

<style>
  /* NOT STICKY, NO BLEED, NO SURFACE. All three moved to firma2-top-bar with the
     crumbs and actions; what is left is the title block, which sits in the
     page's own column and scrolls with it. */
  .firma2-page-header {
    display: block;
  }

  /* THE TITLE COLUMN TAKES THE BAR'S SLACK. ALWAYS — not, as it did until now,
     only for the duration of an edit.

     esa-page-header sizes that column to its content, and shrink-to-fit is a
     defensible default for a heading that sits beside actions and stops. It is
     wrong here for a measurable reason: the adopted title is not a bare string
     any more, it is a BUTTON around the string, and that button carries
     `padding-inline` so the hover plate extends past the glyphs. Shrink-to-fit
     sizes the column from the text's max-content and the padding then eats into
     it from both sides, so the line box comes out ~15px SHORT of the very text
     it was sized for — and the heading wraps with two thirds of the bar empty
     beside it. "Bear River Gravel Augmentation" needs 452px, had 1184px of bar
     to sit in, and was given 437px. `text-wrap: balance` on the heading role is
     what makes the result look deliberate rather than broken: it splits the
     overflow into two even lines, so the title reads as a two-line design
     decision instead of as a box 15px too small.

     Growing the column costs nothing anywhere: the actions keep their width
     because the lego declares `flex-shrink: 0` on them, and `min-width: 0` on
     the column (also the lego's) means a genuinely long title still yields
     rather than pushing them off the edge. A title that wraps after this is a
     title that really is wider than the bar.

     The edit state no longer needs a rule of its own — it was the same
     declaration, for the same reason (a text box sized to a heading's content
     collapsed to ~240px), and it is now simply the resting behaviour.

     :global() because the column belongs to esa-page-header and carries its
     scope hash; contained by .firma2-page-header, so no other header on any page
     can be reached.

     BASIS 0, NOT auto, and the difference only shows once the actions cluster
     has occupants again (the project page's record actions were the first).
     The lego's bar is flex-wrap: wrap, and wrap happens at flex-BASIS: with
     `auto`, a title whose content width plus the actions' width overflows the
     bar wraps the whole cluster onto a second row — buttons stacked under the
     h1, above the status pill — before the title's min-width: 0 ever gets the
     chance to let it shrink. At basis 0 the line is laid out from the actions'
     width alone, so the cluster keeps the first row's trailing edge and the
     title takes what remains, balance-wrapping onto two lines when the name
     really is wider than its share. On a page with no actions nothing changes:
     the column still grows to the full bar. */
  .firma2-page-header :global(.esa-page-header__titles) {
    flex: 1 1 0;
    min-width: 0;
  }
</style>
