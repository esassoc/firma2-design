---
// firma2-report-source — the document a set of changes was read from, shown
// beside those changes so each can be checked against its own words.
//
// WHY IT EXISTS (.scratch/project-updates/spec.md, decisions 12 and 31). A
// person confirming a reading, and a manager publishing it, are both asked to
// stand behind figures. Neither can without the page they came from. The side
// sheet this replaced had room for one quoted line per row; a pane has room
// for the passage and what surrounds it, which is how a doubled line or a
// missing unit gets noticed.
//
// TWO SCREENS, ONE PANE: Import a report (the maintainer's check) and the
// project's review (the manager's). Both drive it through src/lib/
// report-source.ts — paintSource() once per document, showAt() per change —
// so the same evidence is in front of both.
//
// IT SCROLLS INSIDE ITSELF. The pane is as tall as the screen allows and its
// body scrolls; moving to a passage never moves the page, so the change being
// checked stays where the reader left it.
//
// NARROW SCREENS. Under 64rem there is no room for two columns. The host
// screen hides the pane and each change offers "Show source"; the pane then
// takes the column's place, with Back as its first control (`data-source-back`,
// rendered here, wired by the host).
//
// bcn-lego-checked: esa-button (Back) is the one control. The pane is a
// bordered region on surface tokens with a scrolling body; no esa- lego shows
// a document beside a list (esa-card is a static surface with no scrolling
// body or sticky height; esa-side-dialog is an overlay, which a comparison
// cannot be). The file-preview embed in firma2-rich-text draws one file inline
// in prose and has no passages. Beacon is not cloned on this machine.
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  /** The pane's accessible name. */
  label?: string;
}

const { label = 'Source document' } = Astro.props;
---
<section class="firma2-report-source" aria-label={label} data-report-source>
  <header class="firma2-report-source__head repel">
    <p class="firma2-report-source__name typography-label-md-strong" data-source-name></p>
    <span class="firma2-report-source__back">
      <EsaButton variant="ghost" size="md" icon="arrow-left" data-source-back>Back</EsaButton>
    </span>
  </header>
  <div class="firma2-report-source__body" data-source-body tabindex="0"></div>
</section>

<style>
  .firma2-report-source {
    display: flex;
    flex-direction: column;
    min-block-size: 0;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--color-background-default);
    overflow: hidden;
  }

  .firma2-report-source__head {
    align-items: center;
    padding: var(--spacing-300) var(--spacing-400);
    border-block-end: 1px solid var(--color-border-default);
  }

  .firma2-report-source__name {
    margin: 0;
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  /* Back belongs to the narrow layout only; the host screen shows it there. */
  .firma2-report-source__back {
    display: none;
  }

  /* position: relative so offsetTop of a passage is measured from this box,
     and so nothing absolutely placed inside can widen the page. */
  .firma2-report-source__body {
    position: relative;
    flex: 1 1 auto;
    min-block-size: 0;
    overflow: auto;
    padding: var(--spacing-400);
  }

  .firma2-report-source__body:focus-visible {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color);
    outline-offset: calc(var(--focus-ring-width, 2px) * -1);
  }

  .firma2-report-source[data-source-kind='pdf'] .firma2-report-source__body {
    padding: 0;
  }

  .firma2-report-source__body :global(.firma2-report-source__page + .firma2-report-source__page) {
    margin-block-start: var(--spacing-600);
    padding-block-start: var(--spacing-600);
    border-block-start: 1px solid var(--color-border-default);
  }

  .firma2-report-source__body :global(.firma2-report-source__page-label) {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .firma2-report-source__body :global(.firma2-report-source__passage) {
    padding: var(--spacing-300);
    border-radius: var(--radius-sm);
  }

  .firma2-report-source__body :global(.firma2-report-source__passage p) {
    margin: 0;
  }

  /* The passage the selected change was read from: a tint behind the words,
     never a colored edge. */
  .firma2-report-source__body :global(.firma2-report-source__passage[data-current]) {
    background: var(--color-background-utility-info-subtle, var(--color-background-elevation-sunken));
  }

  .firma2-report-source__body :global(.firma2-report-source__file) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 32rem;
    border: 0;
  }

  .firma2-report-source__body :global(.firma2-report-source__quote) {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .firma2-report-source__body :global([hidden]) {
    display: none !important;
  }
</style>
