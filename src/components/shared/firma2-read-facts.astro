---
// firma2-read-facts — a record's facts on a page that READS them: the same
// label-over-value rows a record page edits (firma2-editable-field), held
// read-only.
//
// WHY THE EDITABLE ROW AND NOT A SECOND ONE. A fact reads the same wherever it
// is shown — label above, value below, a linked value a real link — and the
// editable row already draws that. A reading page that built its own rows
// would be a second construction to keep in step with the first. So the rows
// are the record's own, and this wrapper sets the field's `data-locked` state
// on each (the hook firma2-review-project-rail uses): no hover ring, no edit
// on click, the value still in the tab order.
//
// Used where the reader cannot change the fact from this page: an
// organization's About (its record is edited in Workspace settings), a
// member's page, a support request's details.
//
// bcn-lego-checked: no esa- lego is a description list; the rows are
// firma2-editable-field, composed unchanged, in the `.stack` primitive. No
// CSS of its own.
interface Props {
  /** Names the list for assistive technology, e.g. "About this organization". */
  label: string;
}

const { label } = Astro.props;
---
<dl class="firma2-read-facts stack" data-gap="md" aria-label={label} data-read-facts>
  <slot />
</dl>

<script>
  document.querySelectorAll<HTMLElement>('[data-read-facts] .firma2-editable-field').forEach((field) => field.setAttribute('data-locked', ''));
</script>
