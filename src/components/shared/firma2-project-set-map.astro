---
// firma2-project-set-map — where a SET of projects works: their work areas on
// one map, framed on that work. An organization's Home passes the projects it
// leads or funds; a performance measure's page passes the projects reporting
// it. Born as firma2-org-map (2026-10-09) and lifted here when the measure
// page needed the same picture.
//
// WHY NOT THE PORTFOLIO MAP. firma2-portfolio-map is a page — color-by,
// coverage, charts, export — and it reads every project in the
// workspace. A page about one organization or one measure needs one picture
// of its own projects, so this is the same canvas (src/lib/leaflet), the same
// shapes, the same dots-when-zoomed-out rule and the same popup doors, scoped
// by a prop.
//
// COLOUR FOLLOWS THE WORKSPACE (src/lib/map-color.ts): each project's work
// wears its stage's colour, or whatever Map layers says maps are coloured by,
// and the key under the map names the values present. A page that splits its
// set its own way (an organization's led vs funded) passes `groups` instead:
// each project names its group, the categorical slots follow the groups'
// order, and the key appears only when two or more groups do.
//
// THE GAP IS NAMED, because a map cannot show it: a project with no work area
// is invisible here by construction, so the ones missing are listed under the
// map, linked — the portfolio map's "Not on this map", at this scale.
//
// Shapes are read through src/lib/work-areas, so an area drawn on a project's
// map in this browser shows up here too.
//
// A PAGE CAN DRIVE IT (the public home's explorer, firma2-public-map-band).
// The section listens for three events on itself and announces one:
//   firma2:set-map-filter  { slugs: string[] | null }  show only these projects, reframe
//   firma2:set-map-hover   { slug: string | null }     lift one project, quiet the rest
//   firma2:set-map-focus   { slug: string }            fly to one project, open its popup
//   firma2:set-map-select  { slug }  (bubbles)         a shape or dot was clicked
// A PAGE CAN SUPPLY THE POPUP: a `<template data-popup="<slug>">` in the
// `popups` slot is cloned into that project's popup as a full-bleed card (the
// public home's photo card) in place of the text popup built here.
// An item may carry a `photo` and a `meta` line for its popup, and `terrain`
// swaps the grey canvas for the topographic map — the ground the work sits on.
//
// bcn-lego-checked: no map lego exists in the catalog; the canvas is Leaflet,
// as in firma2-portfolio-map and firma2-my-projects-map. The popup's preview
// button is the cloned firma2-project-peek-button (src/lib/project-peek). The
// key is a plain list with swatches — the portfolio map's shading key, not a
// control. Beacon is not cloned on this machine.
import type { Project } from '../../data/firma2-projects';
import { projectHref, projectSlug } from '../../data/firma2-projects';
import { seedWorkAreas } from '../../data/firma2-geography';
import { publicProjectHref } from '../../data/firma2-public-site';
import { withBase } from '../../lib/base';

interface Props {
  /** The section heading. */
  title: string;
  /** The canvas's accessible name. */
  label: string;
  items: { project: Project; group?: string; photo?: { src: string; alt: string }; meta?: string }[];
  /** The colour split, in slot order. Omit for one colour. */
  groups?: { key: string; label: string }[];
  /**
   * Who is reading. `public` (the public site): doors lead to each project's
   * PUBLIC page and the popup has no preview button — the peek is the app's.
   */
  audience?: 'app' | 'public';
  /** The canvas's height (any CSS length) — for a page that leads with the map. */
  height?: string;
  /** Keep the heading for assistive tech only — where the map opens the page and needs no title. */
  hideTitle?: boolean;
  /** The canvas runs edge to edge: no frame, no rounded corners (a full-width band). */
  bleed?: boolean;
  /** Esri's topographic map (relief, water, place names) instead of the grey canvas. */
  terrain?: boolean;
  /** Left padding (px) kept clear when framing — room for a panel laid over the map. */
  insetStart?: number;
}

const { title, label, items, groups = [], audience = 'app', height, hideTitle = false, bleed = false, terrain = false, insetStart = 0 } = Astro.props;
const isPublic = audience === 'public';
const slotOf = (group?: string) => Math.max(0, groups.findIndex((g) => g.key === group)) + 1;
const config = items.map(({ project, group, photo, meta }) => ({
  photo,
  meta,
  slug: projectSlug(project),
  name: project.projectName,
  href: withBase(isPublic ? publicProjectHref(project) : projectHref(project)),
  slot: slotOf(group),
  seed: seedWorkAreas(project),
}));
const shownGroups = groups.filter((g) => items.some((i) => i.group === g.key));
const headingId = `firma2-project-set-map-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---
{items.length > 0 && (
  <section class:list={['firma2-project-set-map', 'stack', bleed && 'firma2-project-set-map--bleed']} data-gap="md" aria-labelledby={headingId} data-config={JSON.stringify(config)} data-audience={audience} data-split={groups.length > 0 ? '' : undefined} data-terrain={terrain ? '' : undefined} data-inset-start={insetStart} style={height ? `--firma2-project-set-map-height: ${height}` : undefined}>
    <h2 id={headingId} class:list={[hideTitle ? 'visually-hidden' : 'typography-title-sm-strong']}>{title}</h2>
    <div class="firma2-project-set-map__canvas" role="application" aria-label={label} data-canvas></div>
    {shownGroups.length > 1 && (
      <ul class="firma2-project-set-map__key typography-body-sm" aria-label="Key">
        {shownGroups.map((g) => (
          <li>
            <span class="firma2-project-set-map__swatch" style={`--swatch: var(--color-background-dataviz-categorical-${slotOf(g.key)})`}></span>
            {g.label}
          </li>
        ))}
      </ul>
    )}
    {groups.length === 0 && !bleed && <div class="firma2-map-key firma2-project-set-map__auto-key typography-body-sm" data-key hidden></div>}
    <p class="typography-body-md" data-unmapped hidden></p>
    <slot name="popups" />
  </section>
)}

<style>
  .firma2-project-set-map__canvas {
    /* A page that leads with the map (the public home) sets the height. */
    block-size: var(--firma2-project-set-map-height, clamp(18rem, 45vh, 28rem));
    border: 1px solid var(--color-border-default, #cecece);
    border-radius: var(--radius-md, 0.5rem);
    overflow: hidden;
    /* Leaflet's panes run to z-index 700; keep them under the app's chrome. */
    isolation: isolate;
  }
  .firma2-project-set-map--bleed .firma2-project-set-map__canvas {
    border-inline: 0;
    border-radius: 0;
  }

  .firma2-project-set-map [data-unmapped][hidden],
  .firma2-project-set-map [data-key][hidden] {
    display: none;
  }

  /* The workspace's key (map.css, firma2-map-key), laid out as this map's own
     key is: one wrapping row under the canvas, the dimension's name leading. */
  .firma2-project-set-map__auto-key,
  .firma2-project-set-map__auto-key :global(ul) {
    display: flex;
    flex-flow: row wrap;
    align-items: center;
    gap: var(--spacing-200) var(--spacing-400);
  }
  .firma2-project-set-map__auto-key :global(.firma2-map-key__title) {
    margin: 0;
  }

  .firma2-project-set-map__key {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-200) var(--spacing-400);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .firma2-project-set-map__key li {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100);
  }

  .firma2-project-set-map__swatch {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border-radius: 50%;
    background: var(--swatch);
  }

  .firma2-project-set-map :global(.firma2-project-set-map__doors) {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100, 0.25rem);
  }

  /* A supplied card runs edge to edge: the bubble is only its frame. */
  .firma2-project-set-map :global(.firma2-project-set-map__card .leaflet-popup-content-wrapper) {
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-lg, var(--radius-md));
  }
  .firma2-project-set-map :global(.firma2-project-set-map__card .leaflet-popup-content) {
    margin: 0;
    line-height: inherit;
  }
  /* Its close button rides on the card's photo: a round chip of the surface. */
  .firma2-project-set-map :global(.firma2-project-set-map__card a.leaflet-popup-close-button) {
    inset-block-start: var(--spacing-200);
    inset-inline-end: var(--spacing-200);
    border-radius: 50%;
    background: var(--color-background-elevation-floating);
    color: var(--color-content-default);
  }

  .firma2-project-set-map :global(.firma2-project-set-map__photo) {
    display: block;
    inline-size: 15rem;
    max-inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    margin-block-end: var(--spacing-200);
    border-radius: var(--radius-sm);
    background: var(--color-background-elevation-sunken);
  }

  .firma2-project-set-map :global(.leaflet-popup-content a:not(.esa-button__native)),
  .firma2-project-set-map [data-unmapped] :global(a) {
    color: var(--color-content-link, #2a7e3b);
  }
</style>

<script>
  import type { MapWorkArea } from '../../data/firma2-geography';
  import { centroid, formatExtent } from '../../lib/geo';
  import { addColorKey, colorKeyHTML, createMap, loadLeaflet, markerStyle, projectColor, shapeStyle, token } from '../../lib/leaflet';
  import type { Leaflet } from '../../lib/leaflet';
  import { onGeoChange, readWorkAreas } from '../../lib/work-areas';
  import { label as vocab } from '../../lib/vocabulary';
  import { projectPeekButtonHTML } from '../../lib/project-peek';

  type Row = { slug: string; name: string; href: string; slot: number; seed: MapWorkArea[]; photo?: { src: string; alt: string }; meta?: string };

  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  document.querySelectorAll<HTMLElement>('.firma2-project-set-map').forEach(async (root) => {
    const rows: Row[] = JSON.parse(root.dataset.config ?? '[]');
    const canvas = root.querySelector<HTMLElement>('[data-canvas]')!;
    const unmapped = root.querySelector<HTMLElement>('[data-unmapped]')!;
    const isPublic = root.dataset.audience === 'public';

    const L: Leaflet | null = await loadLeaflet().catch(() => null);
    if (!L) {
      canvas.hidden = true;
      return;
    }

    // The page's own split, else the workspace's colouring (stage by default).
    const split = root.dataset.split !== undefined;
    const key = root.querySelector<HTMLElement>('[data-key]');
    const colorOf = (row: Row, kind: MapWorkArea['kind'] = 'area') =>
      split ? token(`--color-background-dataviz-categorical-${row.slot}`, '#3e9b4f') : projectColor(row.slug, kind);

    const shapes = L.featureGroup();
    const dots = L.featureGroup();
    const map = createMap(L, canvas, { zoomSnap: 0.5 }, () => {
      syncBase();
      paint();
    });
    map.setView([39.05, -120.07], 10);
    shapes.addTo(map);
    // A full-bleed map has no margin under it to set a key in: its key rides on the map.
    const mapKey = !split && !key ? addColorKey(L, map) : null;

    // Esri's topographic map in place of the grey canvas: relief, water and
    // its own place names, so ours hide (as addBasemaps does for Topographic).
    // LIGHT THEME ONLY — the topo sheet is a bright page with no dark edition,
    // so the dark theme keeps the house dark canvas and its names.
    // Built on first use, so a map that never shows terrain never asks for it.
    let topoLayer: Leaflet | null = null;
    const topoOf = () =>
      (topoLayer ??= L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Tiles &copy; Esri, USGS, NOAA and contributors',
        maxZoom: window.devicePixelRatio > 1 ? 17 : 16,
        maxNativeZoom: 16,
        detectRetina: window.devicePixelRatio > 1,
      }));
    const syncBase = () => {
      const terrain = root.dataset.terrain !== undefined;
      if (!terrain && !topoLayer) return;
      const topo = topoOf();
      const dark = !terrain || document.documentElement.getAttribute('data-scheme') === 'dark';
      if (dark) {
        map.removeLayer(topo);
        map.firma2Base.addTo(map);
      } else {
        map.removeLayer(map.firma2Base);
        topo.addTo(map).bringToBack();
      }
      map.firma2Labels?.setOpacity(dark ? 1 : 0);
    };
    syncBase();

    // Driven from outside: which projects show, and each one's layers.
    let visible: Set<string> | null = null;
    const drawn = new Map<string, { path: [number, number][]; layers: Leaflet[] }>();
    const insetStart = Number(root.dataset.insetStart ?? 0);
    const framing = (pad: number) => ({ paddingTopLeft: [pad + (canvas.clientWidth > 720 ? insetStart : 0), pad], paddingBottomRight: [pad, pad] });
    const select = (slug: string) => root.dispatchEvent(new CustomEvent('firma2:set-map-select', { detail: { slug }, bubbles: true }));

    // A treatment unit is a speck at the zoom that shows a whole region, so
    // each project is also a dot at its work's centre while zoomed out.
    const DOT_ZOOM = 11;
    const syncDots = () => {
      const out = map.getZoom() < DOT_ZOOM;
      if (out && !map.hasLayer(dots)) dots.addTo(map);
      if (!out && map.hasLayer(dots)) map.removeLayer(dots);
    };
    map.on('zoomend', syncDots);

    const paint = (frame = false) => {
      shapes.clearLayers();
      dots.clearLayers();
      drawn.clear();
      const missing: Row[] = [];
      const all: [number, number][] = [];

      rows.forEach((row) => {
        if (visible && !visible.has(row.slug)) return;
        const areas = readWorkAreas(row.slug, row.seed);
        if (!areas.length) return missing.push(row);
        const color = colorOf(row);
        const path = areas.flatMap((a) => a.path);
        all.push(...path);
        const entry = { path, layers: [] as Leaflet[] };
        drawn.set(row.slug, entry);

        const dot = L.circleMarker(centroid(path), markerStyle(color))
          .bindTooltip(esc(row.name), { className: 'firma2-map-tip', direction: 'top' })
          .on('click', () => {
            map.fitBounds(L.latLngBounds(path), { ...framing(48), maxZoom: 13 });
            select(row.slug);
          })
          .addTo(dots);
        entry.layers.push(dot);
        const lead = row.photo ? `<img class="firma2-project-set-map__photo" src="${esc(row.photo.src)}" alt="${esc(row.photo.alt)}" width="480" height="320" loading="lazy">` : '';
        const meta = row.meta ? `${esc(row.meta)}<br>` : '';

        areas.forEach((area) => {
          const style = shapeStyle(area.kind, colorOf(row, area.kind));
          const shape =
            area.kind === 'point'
              ? L.circleMarker(area.path[0], { ...style, radius: 6 })
              : area.kind === 'reach'
                ? L.polyline(area.path, style)
                : L.polygon(area.path, style);
          const extent = formatExtent(area.extent, area.unit);
          const line = `${esc(area.label)}${extent ? ` — ${extent}` : ''}`;
          const card = root.querySelector<HTMLTemplateElement>(`template[data-popup="${row.slug}"]`);
          shape.bindTooltip(`${esc(row.name)}<br>${line}`, { sticky: true, className: 'firma2-map-tip' });
          if (card) {
            // A fixed width, so Leaflet sizes, centres and pans for the real card.
            const el = document.createElement('div');
            el.append(card.content.cloneNode(true));
            shape.bindPopup(el, { minWidth: 304, maxWidth: 304, className: 'firma2-project-set-map__card', autoPanPaddingTopLeft: [16 + (canvas.clientWidth > 720 ? insetStart : 0), 16], autoPanPaddingBottomRight: [16, 16] });
          } else {
            shape.bindPopup(
              `${lead}<strong>${esc(row.name)}</strong><br>${meta}${line}<br><span class="firma2-project-set-map__doors"><a href="${row.href}">${esc(vocab('Open project'))}</a>${isPublic ? '' : projectPeekButtonHTML(row.slug, row.name)}</span>`,
            );
          }
          shape
            .on('click', () => select(row.slug))
            .addTo(shapes);
          entry.layers.push(shape);
        });
      });

      syncDots();
      if (key) {
        const html = colorKeyHTML([...drawn.keys()]);
        key.hidden = !html;
        key.innerHTML = html ? `<p class="firma2-map-key__title typography-label-sm-strong">${esc(html.title)}</p><ul aria-label="${esc(html.title)}">${html.rows}</ul>` : '';
      }
      mapKey?.([...drawn.keys()]);
      if (frame && all.length) map.fitBounds(L.latLngBounds(all), { ...framing(32), maxZoom: 12 });

      unmapped.hidden = missing.length === 0;
      unmapped.innerHTML = missing.length
        ? `Not on the map: ${missing.map((r) => `<a href="${r.href}">${esc(r.name)}</a>`).join(', ')}`
        : '';
    };

    paint(true);
    onGeoChange(() => paint());

    root.addEventListener('firma2:set-map-filter', (e) => {
      const slugs = (e as CustomEvent<{ slugs: string[] | null }>).detail.slugs;
      visible = slugs ? new Set(slugs) : null;
      map.closePopup();
      paint(true);
    });
    // Lift one project: the rest go quiet. Each layer remembers its own style.
    root.addEventListener('firma2:set-map-hover', (e) => {
      const slug = (e as CustomEvent<{ slug: string | null }>).detail.slug;
      drawn.forEach((entry, key) => {
        entry.layers.forEach((layer) => {
          layer.firma2Rest ??= { opacity: layer.options.opacity ?? 1, fillOpacity: layer.options.fillOpacity ?? 0.2, weight: layer.options.weight ?? 3 };
          const rest = layer.firma2Rest;
          layer.setStyle(
            !slug ? rest : key === slug ? { ...rest, weight: rest.weight + 2 } : { opacity: rest.opacity * 0.25, fillOpacity: rest.fillOpacity * 0.25, weight: rest.weight },
          );
          if (key === slug) layer.bringToFront?.();
        });
      });
    });
    // The base map, switched from outside (the public site's settings): the
    // attribute is the state, so a switch made before this map existed holds.
    root.addEventListener('firma2:set-map-base', (e) => {
      root.toggleAttribute('data-terrain', (e as CustomEvent<{ terrain: boolean }>).detail.terrain);
      syncBase();
    });
    // Open on some of the projects without hiding the rest. `data-frame` holds
    // the slugs for the same reason the base map is an attribute.
    const frameTo = (slugs: string[]) => {
      const path = slugs.flatMap((slug) => drawn.get(slug)?.path ?? []);
      const all = path.length ? path : [...drawn.values()].flatMap((entry) => entry.path);
      if (all.length) map.fitBounds(L.latLngBounds(all), { ...framing(32), maxZoom: 12 });
    };
    const framed = () => (root.dataset.frame ?? '').split(' ').filter(Boolean);
    if (framed().length) frameTo(framed());
    root.addEventListener('firma2:set-map-frame', (e) => {
      root.dataset.frame = ((e as CustomEvent<{ slugs: string[] }>).detail.slugs ?? []).join(' ');
      frameTo(framed());
    });
    root.addEventListener('firma2:set-map-focus', (e) => {
      const entry = drawn.get((e as CustomEvent<{ slug: string }>).detail.slug);
      if (!entry) return;
      map.fitBounds(L.latLngBounds(entry.path), { ...framing(64), maxZoom: 13 });
      // The dot is layer 0; the first work area carries the popup.
      map.once('moveend', () => entry.layers[1]?.openPopup());
    });
  });
</script>
