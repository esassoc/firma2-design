---
// firma2-rail — THE rail. Every docked column on this spoke's pages is this
// component: the record rail, the project peek, the side panel (measure
// preview, intake Fields). The edit sheets are bcn-side-sheet, which cannot
// render an .astro component from inside its shadow root and so restates the
// same geometry, control and motion — see that file.
//
// ONE RAIL, NOT FOUR (user, 2026-10-20). The record rail, peek and side panel
// were built in different sessions, each copying the one before line for line
// and each drifting: one collapsed to a strip with a chevron on its edge, one
// closed with an X in its header, one was toggled from the top bar and simply
// vanished. A rail is a rail. What differs between them is content and
// numbers, so content is the slot and the numbers are props.
//
// THE CONTROL IS IN THE RAIL AND THE RAIL ANIMATES (user, same day): a
// panel-right icon button, size md like every control, in the rail's
// top-trailing corner on its first row — inside the column, not in the top bar
// ("why is it out of the rail"), not a chevron straddling the border (the user
// disliked both that icon and that spot), never a header X, and not a row of
// its own (a lone corner glyph pushed the tabs down). The rail is anchored to
// the window's edge, so the button barely moves as the track eases to the
// strip that keeps it: the way back is where the way out was. Callers whose
// first row is text give it room with --firma2-rail-toggle-room.
//
// TWO MODES, ONE CONTROL.
//   default   a companion that lasts as long as the page (record rail, side
//             panel). The button collapses it to the strip and back. The
//             state persists through the edge handle's storage key.
//   closes    a rail that exists for one thing at a time (the peek). The
//             button takes it down to the strip and then out of the page
//             (`hidden`), and the caller opens it again. Without this a
//             dismissed peek would leave a strip behind for good.
//
// THE CONSTRUCTION is the record rail's, which documented every load-bearing
// half at length (git history of firma2-record-rail.astro): sticky under the
// top bar at the fold's height, bleeding through the pane's padding to sit
// flush in its corner; a flex-basis capped so a drag can never push the main
// column under --sidebar-content-min; the inner element is the scroller so the
// edge controls do not scroll away.
//
// UNPINNED WHEN THE TRACK WRAPS. Below `unpinAt` (the parent's width at which
// `.sidebar` drops this under the content) the rail stops being a rail and is
// a plain block: no pin, no edge controls, and never collapsed. A container
// query cannot take a per-instance number, so the script measures the parent
// and sets `data-unpinned`.
//
// EVENTS (bubbling), for callers:
//   firma2:rail-open    dispatch ON the rail to open it (animated). A closes
//                       rail is unhidden first.
//   firma2:rail-close   dispatch ON the rail to collapse / close it (animated).
//   firma2:rail-opened  fired when an opening has landed and the content is
//                       back — measure or initialise maps here, not before.
//   firma2:rail-closed  fired when a closes rail has left the page.
//
// bcn-lego-checked: no esa- lego is a page-level rail — esa-sidebar-nav is the
// app's navigation, esa-side-dialog a transient overlay. `.sidebar` is the
// layout primitive the parent supplies; bcn-edge-handle is the resize grip;
// the toggle is esa-button. Beacon is not cloned on this machine.
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  /** The aside's id — the toggle's and the handle's aria-controls target. */
  id: string;
  /** What the rail holds, in the reader's words: "Collapse <label>". */
  label: string;
  /** The custom property on the parent `.sidebar` that sizes this track, and that the handle writes. */
  sizeVar?: string;
  /** The opening width when nothing has set sizeVar. */
  width?: string;
  /** The track's floor — the narrowest it renders, measured from its content. */
  floor?: string;
  /** Handle bounds, px. */
  min?: number;
  max?: number;
  /** Persists the reader's width (and, for a companion, collapsed). Per role, not per page. */
  storageKey: string;
  /** The parent width, px, at or below which the track has wrapped and the rail unpins. */
  unpinAt: number;
  /** One-thing-at-a-time rail: the toggle closes it rather than leaving a strip. */
  closes?: boolean;
  /** Start out of the page (a closes rail with nothing to show yet). */
  hidden?: boolean;
  /** Landmark name, when the rail does not open on its own heading. */
  ariaLabel?: string;
  ariaLabelledby?: string;
  class?: string;
}

const {
  id,
  label,
  sizeVar = '--sidebar-width',
  width = '25rem',
  floor = '25rem',
  min = 400,
  max = 544,
  storageKey,
  unpinAt,
  closes = false,
  hidden = false,
  ariaLabel,
  ariaLabelledby,
  class: className,
} = Astro.props;
---
<aside
  class:list={['firma2-rail', className]}
  id={id}
  data-rail
  data-unpin-at={unpinAt}
  data-closes={closes ? '' : undefined}
  aria-label={ariaLabel}
  aria-labelledby={ariaLabelledby}
  hidden={hidden}
  style={`--_rail-width: var(${sizeVar}, ${width}); --_rail-floor: ${floor}`}
>
  <!-- The toggle: inside the rail, top-trailing corner, on the first row. -->
  <div class="firma2-rail__toggle">
    <EsaButton
      variant="chrome"
      iconOnly
      icon="panel-right"
      label={`${closes ? 'Close' : 'Collapse'} ${label}`}
      size="md"
      data-rail-toggle
      aria-expanded="true"
      aria-controls={id}
    />
  </div>

  <div class="firma2-rail__inner stack" data-gap="xl">
    <slot />
  </div>

  <bcn-edge-handle
    edge="start"
    size-var={sizeVar}
    size-host="parent"
    min={String(min)}
    max={String(max)}
    label={label}
    storage-key={storageKey}
  ></bcn-edge-handle>
</aside>

<style>
  .firma2-rail {
    /* The pane's padding (esa-app-shell's literal), reached through so the
       rail sits flush in the pane's corner. */
    --_bleed: var(--spacing-500, 1.5rem);
    /* Shut, the rail is a strip just wide enough to hold its 40px toggle
       with --spacing-200 either side. */
    --_collapsed: calc(2.5rem + 2 * var(--spacing-200, 0.5rem) + var(--border-width-default, 1px));

    position: sticky;
    top: calc(var(--firma2-sticky-origin, 0px) + var(--firma2-band-height, 48px));
    align-self: start;
    block-size: calc(var(--firma2-fold, 100dvh) - var(--firma2-band-height, 48px));
    display: flex;
    flex-direction: column;
    z-index: calc(var(--z-header, 200) + 1);
    margin-block-start: calc(var(--_bleed) * -1);
    margin-inline-end: calc(var(--_bleed) * -1);
    padding: var(--_bleed);
    /* Overrides `.sidebar > :first-child`'s basis and grow. The min() keeps a
       drag from wrapping the track; the max() floor keeps the honest wrap a
       narrow window causes. */
    flex-basis: max(
      var(--_rail-floor),
      min(
        var(--_rail-width),
        calc(100% - var(--sidebar-content-min, 60%) - var(--spacing-500, 1.5rem) - 1px)
      )
    );
    flex-grow: 0;
    box-sizing: border-box;
    overflow: visible;
    background: var(--firma2-sheet-background, var(--color-background-default, #fcfcfc));
    border-inline-start: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #d9d9d9);
    transition:
      flex-basis var(--transition-base, 200ms ease),
      padding var(--transition-base, 200ms ease);
  }
  .firma2-rail[data-resizing] {
    transition: none;
  }
  .firma2-rail[hidden] {
    display: none;
  }

  .firma2-rail__inner {
    flex: 1;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* ---- THE TOGGLE ---- top-trailing, centred on a ~45px first row. */
  .firma2-rail__toggle {
    position: absolute;
    inset-block-start: var(--firma2-rail-toggle-inset, calc(var(--_bleed) + 0.125rem));
    inset-inline-end: var(--_bleed);
    z-index: 1;
    display: flex;
    transition: inset-inline-end var(--transition-base, 200ms ease);
  }
  .firma2-rail[collapsed] .firma2-rail__toggle {
    inset-inline-end: var(--spacing-200, 0.5rem);
  }
  .firma2-rail[data-resizing] .firma2-rail__toggle {
    transition: none;
  }

  /* ---- SHUT: THE STRIP ---- */
  .firma2-rail[collapsed] {
    flex-basis: var(--_collapsed);
    flex-grow: 0;
    padding-inline: var(--spacing-200, 0.5rem);
  }
  /* Content leaves on the click and comes back only once the track has
     finished growing (data-opening, held by the script) — content in flow
     would hold the track at its min-content width and leave nothing to ease. */
  .firma2-rail[collapsed] .firma2-rail__inner,
  .firma2-rail[data-opening] .firma2-rail__inner {
    display: none;
  }

  /* ---- WRAPPED: NOT A RAIL ANY MORE ---- */
  .firma2-rail[data-unpinned] {
    position: relative;
    display: block;
    block-size: auto;
    flex-basis: 100%;
    margin-block-start: 0;
    margin-inline-end: 0;
    padding: 0;
    background: none;
    border-inline-start: none;
    transition: none;
  }
  .firma2-rail[data-unpinned][hidden] {
    display: none;
  }
  .firma2-rail[data-unpinned] .firma2-rail__inner {
    overflow: visible;
  }
  .firma2-rail[data-unpinned] :is(bcn-edge-handle, .firma2-rail__toggle) {
    display: none;
  }
  /* A closes rail keeps a way out when it is two cards under the page. */
  .firma2-rail[data-unpinned][data-closes] .firma2-rail__toggle {
    display: flex;
    inset-block-start: 0;
    inset-inline-end: 0;
  }
  .firma2-rail[data-unpinned][collapsed] .firma2-rail__inner {
    display: flex;
  }
</style>

<script>
  import './bcn-edge-handle';

  type Persistable = HTMLElement & { persist?: () => void };

  /** Resolve once the track's flex-basis transition ends (or at once, with none running). */
  const settled = (rail: HTMLElement): Promise<void> => {
    const track = rail.getAnimations().find((a) => (a as CSSTransition).transitionProperty === 'flex-basis');
    return track ? track.finished.then(() => undefined, () => undefined) : Promise.resolve();
  };

  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
    const toggle = rail.querySelector<HTMLElement>('[data-rail-toggle]');
    const handle = rail.querySelector<Persistable>('bcn-edge-handle');
    const closes = rail.hasAttribute('data-closes');
    const unpinAt = Number(rail.dataset.unpinAt) || 0;
    const noun = (toggle?.getAttribute('aria-label') ?? '').replace(/^(Collapse|Close)\s+/, '');

    const sync = (): void => {
      if (!toggle) return;
      const shut = rail.hasAttribute('collapsed');
      const name = closes ? `Close ${noun}` : `${shut ? 'Expand' : 'Collapse'} ${noun}`;
      toggle.setAttribute('aria-label', name);
      toggle.setAttribute('title', name);
      toggle.setAttribute('aria-expanded', String(!shut));
    };

    const open = (): void => {
      if (rail.hidden) {
        // From out of the page: in at the strip, then ease open.
        rail.setAttribute('collapsed', '');
        rail.hidden = false;
        void rail.offsetWidth;
      }
      if (!rail.hasAttribute('collapsed')) {
        rail.dispatchEvent(new CustomEvent('firma2:rail-opened', { bubbles: true }));
        return;
      }
      rail.dataset.opening = '';
      rail.removeAttribute('collapsed');
      sync();
      void settled(rail).then(() => {
        delete rail.dataset.opening;
        rail.dispatchEvent(new CustomEvent('firma2:rail-opened', { bubbles: true }));
      });
    };

    const shut = (): void => {
      if (rail.hidden) return;
      if (closes && rail.hasAttribute('data-unpinned')) {
        rail.hidden = true;
        rail.dispatchEvent(new CustomEvent('firma2:rail-closed', { bubbles: true }));
        return;
      }
      rail.setAttribute('collapsed', '');
      sync();
      if (!closes) {
        handle?.persist?.();
        return;
      }
      void settled(rail).then(() => {
        rail.hidden = true;
        rail.removeAttribute('collapsed');
        sync();
        rail.dispatchEvent(new CustomEvent('firma2:rail-closed', { bubbles: true }));
      });
    };

    toggle?.addEventListener('click', () => {
      if (rail.hasAttribute('collapsed')) {
        open();
        handle?.persist?.();
      } else shut();
    });
    rail.addEventListener('firma2:rail-open', (event) => {
      if (event.target === rail) open();
    });
    rail.addEventListener('firma2:rail-close', (event) => {
      if (event.target === rail) shut();
    });

    const pin = (): void => {
      const parent = rail.parentElement;
      if (parent) rail.toggleAttribute('data-unpinned', parent.clientWidth <= unpinAt);
    };
    pin();
    if (rail.parentElement) new ResizeObserver(pin).observe(rail.parentElement);

    // The handle may have restored a collapsed state before this ran.
    if (closes) rail.removeAttribute('collapsed');
    sync();
  });
</script>
