---
// firma2-fact-grid — the few facts that place a record, at the top of its
// page: label over value, side by side, wrapping as the pane narrows.
//
// FOR A READING PAGE'S SUMMARY, where three or four facts sit under the
// record's name and nobody edits them here: an organization's type, website
// and primary contact; a member's role and email. It is the construction
// firma2-funding-source-summary draws its facts with, made a component the day
// a third page needed it, so two record pages a reader moves between read
// alike. A fact a reader CHANGES on the page is a firma2-editable-field row
// instead (a rail's facts: firma2-read-facts).
//
// A VALUE THAT IS A DOOR IS A LINK. `note` is a second, quieter line for what
// qualifies the value — what a role reaches, that a website is verified.
//
// bcn-lego-checked: no esa- lego is a description list; this is a <dl> on the
// hub's `.grid` primitive with typography composites. The CSS is the track
// minimum, the label's ink and the <dd> margin reset. Beacon is not cloned on
// this machine.
export interface Fact {
  label: string;
  value: string;
  href?: string;
  /** A quieter second line that qualifies the value. */
  note?: string;
}

interface Props {
  facts: Fact[];
  /** Names the list for assistive technology. */
  label: string;
}

const { facts, label } = Astro.props;
---
<dl class="firma2-fact-grid grid" data-gap="md" aria-label={label}>
  {facts.map((fact) => (
    <div class="stack" data-gap="2xs">
      <dt class="firma2-fact-grid__label typography-label-sm">{fact.label}</dt>
      <dd class="typography-body-md">{fact.href ? <a href={fact.href}>{fact.value}</a> : fact.value}</dd>
      {fact.note && <dd class="firma2-fact-grid__label typography-body-sm">{fact.note}</dd>}
    </div>
  ))}
</dl>

<style>
  .firma2-fact-grid {
    --grid-min: 12rem;
    margin: 0;
  }

  .firma2-fact-grid dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .firma2-fact-grid__label {
    color: var(--color-content-default-secondary);
  }
</style>
