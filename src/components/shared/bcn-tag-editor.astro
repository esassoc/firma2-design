---
// bcn-tag-editor — a vocabulary edited as a row of TAGS: every option is a
// chip you can rename in place, remove, drag into order, and extend from a
// ghost "add" slot at the end of the row.
//
// IT REPLACES bcn-option-list (one text field per option, stacked), at the
// user's direction: the stacked rows read as a form, not as a vocabulary, and
// they had no answer for ORDER — which is real data here, because the options'
// order is the order every entry form will offer them in. What survives from
// the option-list's argument is its best point: A TAG YOU CANNOT EDIT IS
// ADD-OR-DESTROY. So these chips are not esa-input-tag's chips — click a
// chip's label and it becomes a field, exactly where it lay.
//
// THE INTERACTIONS, all discoverable in place:
//   add      type in the ghost chip; Enter, comma or just leaving commits.
//            No keystroke to remember, no word lost to a forgotten Enter.
//   rename   click the chip's label (or Enter/F2 on a focused chip).
//            Commit on Enter/blur; Esc reverts; committing empty removes.
//   remove   the chip's own ×, or Delete/Backspace on a focused chip.
//   arrange  drag a chip along the row, or Shift+Arrow on a focused chip.
//
// bcn-lego-checked: the chip IS esa-pill (cloned from a server-rendered
// template, so its scoped styles ride along — the same clone trick the data
// grids use for status pills), and its × is the pill's own removable button,
// heard through the pill's `removed` event. No lego covers the BEHAVIOUR:
// esa-input-tag adds/removes but cannot rename in place and has no order;
// esa-chip-group renders a read-only set; esa-pillbox is a bare flex box with
// no list semantics; esa-select chip-mode picks from a CLOSED list, and this
// component is where such a list gets authored. Beacon is not cloned on this
// machine. `bcn-` because nothing here knows what a measure is: it is an
// ordered list of strings with a label.
//
// CONTRACT (drop-in for bcn-option-list's callers):
//   .value            get/set string[] — trimmed, empties never returned
//   `change`          bubbling + composed, on every mutation
//   `readonly` attr   chips render as facts: no ×, no ghost, no drag, no edit
import EsaPill from '@esa/ecology/esa-pill.astro';

interface Props {
  /** Names the list for assistive tech and renders above it. */
  label: string;
  /** Visually hide the label (kept for AT) — for hosts whose context already names the list. */
  labelHidden?: boolean;
  /** The vocabulary as authored. Empty is the normal state on a fresh draft. */
  options?: string[];
  /** Placeholder for the ghost add slot — the caller's own example. */
  placeholder?: string;
  /** Render the set as facts: no add, no remove, no rename, no drag. */
  readonly?: boolean;
  /** Extra class for the caller's layout. */
  class?: string;
}

const {
  label,
  labelHidden = false,
  options = [],
  placeholder = 'Add an option',
  readonly = false,
  class: className,
} = Astro.props;

const uid = Math.random().toString(36).slice(2, 8);
const labelId = `bcn-tag-editor-${uid}`;
---
<bcn-tag-editor
  class:list={['bcn-tag-editor', className]}
  readonly={readonly || undefined}
  data-add-placeholder={placeholder}
>
  <span
    id={labelId}
    class:list={['bcn-tag-editor__label', 'typography-label-sm', labelHidden && 'bcn-tag-editor__label--hidden']}
    >{label}</span
  >

  <ul class="bcn-tag-editor__tags" aria-labelledby={labelId}>
    {options.map((option) => (
      <li class="bcn-tag-editor__tag" tabindex={readonly ? undefined : 0} draggable={readonly ? undefined : 'true'}>
        <EsaPill label={option} size="md" removable={!readonly} />
      </li>
    ))}
    {!readonly && (
      <li class="bcn-tag-editor__new">
        <input class="bcn-tag-editor__add typography-microcopy-sm" type="text" placeholder={placeholder} aria-label={`${label} — ${placeholder}`} />
      </li>
    )}
  </ul>

  <!-- Inert master copy of one tag — what .value's setter and the ghost slot
       clone, so a chip added at runtime is byte-identical to a server one. -->
  <template data-tag>
    <li class="bcn-tag-editor__tag" tabindex="0" draggable="true">
      <EsaPill label="" size="md" removable={true} />
    </li>
  </template>
</bcn-tag-editor>

<style>
  .bcn-tag-editor {
    display: block;
  }

  .bcn-tag-editor__label {
    display: block;
    margin-block-end: var(--spacing-100, 0.25rem);
    color: var(--color-content-default, #202020);
  }

  /* Kept for AT, invisible — the host's own heading names the list. */
  .bcn-tag-editor__label--hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* esa-pillbox's wrap-row layout, restated on a real <ul> because the box
     lego is a <div> with no list semantics to give AT the item count. */
  .bcn-tag-editor__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-100, 0.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bcn-tag-editor__tag {
    display: inline-flex;
    border-radius: var(--radius-chip, 4px);
  }

  .bcn-tag-editor__tag:focus-visible {
    outline: 2px solid var(--color-border-default-focus, #46a758);
    outline-offset: 1px;
  }

  /* Drag states: the lifted chip fades; the drop target side is marked by the
     inset rule the script toggles. */
  .bcn-tag-editor__tag[data-dragging] {
    opacity: 0.4;
  }

  .bcn-tag-editor__tag[data-drop-before] {
    box-shadow: -3px 0 0 0 var(--color-border-default-focus, #46a758);
  }

  .bcn-tag-editor__tag[data-drop-after] {
    box-shadow: 3px 0 0 0 var(--color-border-default-focus, #46a758);
  }

  /* IN-PLACE RENAME: the input stands exactly where the label stood, inside
     the same pill — chip chrome unchanged, text swaps for a field. */
  .bcn-tag-editor__tag :global(.bcn-tag-editor__edit) {
    font: inherit;
    border: 0;
    padding: 0;
    margin: 0;
    background: transparent;
    color: inherit;
    outline: none;
    min-inline-size: 2ch;
  }

  /* THE GHOST SLOT — a dashed would-be chip whose whole body is the input.
     Same box as a real chip (esa-pill's own padding/radius tokens) so the row
     never jumps when typing turns it into one. */
  .bcn-tag-editor__new {
    display: inline-flex;
  }

  .bcn-tag-editor__add {
    font: inherit;
    padding-block: var(--spacing-150, 0.375rem);
    padding-inline: var(--spacing-200, 0.5rem);
    border: 1px dashed var(--color-border-default, #cecece);
    border-radius: var(--radius-chip, 4px);
    background: transparent;
    color: var(--color-content-default, #202020);
    /* Wide enough for its own placeholder — a ghost that clips "Add an
       option" reads as a rendering fault, not an invitation. */
    inline-size: 14ch;
    transition: inline-size 120ms ease;
  }

  .bcn-tag-editor__add:focus {
    outline: none;
    border-style: solid;
    border-color: var(--color-border-default-focus, #46a758);
    inline-size: 18ch;
  }

  .bcn-tag-editor__add::placeholder {
    color: var(--color-content-default-secondary, #646464);
  }

  /* Belt-and-braces for read-only instances: even if an editable-shaped chip
     lands inside one, its × and ghost slot stay out of sight. */
  .bcn-tag-editor[readonly] :global(.esa-pill__remove),
  .bcn-tag-editor[readonly] .bcn-tag-editor__new {
    display: none;
  }
</style>

<script>
  type Marked = HTMLElement & { _bcnWired?: boolean };

  class BcnTagEditor extends HTMLElement {
    #template: HTMLTemplateElement | null = null;

    connectedCallback(): void {
      const self = this as Marked;
      if (self._bcnWired) return;
      self._bcnWired = true;

      // RECLAIM A SHADOWED `value`. A host that assigns el.value before this
      // module has defined the element creates an OWN data property, and an
      // own property outranks the prototype accessor forever — the classic
      // upgrade trap. Lift the stashed value off, delete the shadow, and
      // replay it through the real setter once the template is in hand.
      let stashed: string[] | null = null;
      if (Object.prototype.hasOwnProperty.call(this, 'value')) {
        stashed = (this as unknown as { value: string[] }).value;
        delete (this as unknown as { value?: string[] }).value;
      }
      this.#template = this.querySelector<HTMLTemplateElement>('template[data-tag]');
      if (stashed) this.value = stashed;
      if (this.hasAttribute('readonly')) return;

      // esa-pill's own delegated × handler removes the PILL and emits
      // `removed`; the tag <li> shell is ours to clean up, and the mutation is
      // ours to announce.
      this.addEventListener('removed', (event) => {
        const tag = (event.target as Element).closest<HTMLElement>('.bcn-tag-editor__tag');
        if (!tag) return;
        const next = tag.nextElementSibling ?? tag.previousElementSibling;
        tag.remove();
        (next as HTMLElement)?.focus?.();
        this.#announce();
      });

      this.addEventListener('click', this.#onClick);
      this.addEventListener('keydown', this.#onKeyDown);
      this.addEventListener('focusout', this.#onFocusOut);
      this.addEventListener('dragstart', this.#onDragStart);
      this.addEventListener('dragover', this.#onDragOver);
      this.addEventListener('drop', this.#onDrop);
      this.addEventListener('dragend', this.#onDragEnd);

      const add = this.#addInput;
      add?.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ',') {
          event.preventDefault();
          this.#commitAdd();
        }
      });
      add?.addEventListener('blur', () => this.#commitAdd());
    }

    // ---- the bcn-option-list contract ------------------------------------

    get value(): string[] {
      return this.#tags()
        .map((t) => this.#labelOf(t))
        .filter(Boolean);
    }

    set value(next: string[]) {
      const list = this.#list;
      if (!list) return;
      this.#tags().forEach((t) => t.remove());
      const anchor = this.querySelector('.bcn-tag-editor__new');
      for (const option of Array.isArray(next) ? next : []) {
        const tag = this.#newTag(option);
        if (anchor) list.insertBefore(tag, anchor);
        else list.append(tag);
      }
    }

    // ---- internals -------------------------------------------------------

    get #list(): HTMLElement | null {
      return this.querySelector('.bcn-tag-editor__tags');
    }

    get #addInput(): HTMLInputElement | null {
      return this.querySelector<HTMLInputElement>('.bcn-tag-editor__add');
    }

    #tags(): HTMLElement[] {
      return [...this.querySelectorAll<HTMLElement>('.bcn-tag-editor__tag')];
    }

    #labelOf(tag: HTMLElement): string {
      const editing = tag.querySelector<HTMLInputElement>('.bcn-tag-editor__edit');
      return (editing ? editing.value : tag.querySelector('.esa-pill__label')?.textContent ?? '').trim();
    }

    #newTag(label: string): HTMLElement {
      const tag = this.#template!.content.firstElementChild!.cloneNode(true) as HTMLElement;
      tag.querySelector('.esa-pill__label')!.textContent = label;
      if (this.hasAttribute('readonly')) {
        // The template's tag is the editable shape; a read-only instance
        // strips the affordances so a cloned chip is a fact, not a control.
        tag.removeAttribute('tabindex');
        tag.removeAttribute('draggable');
        tag.querySelector('[data-esa-pill-remove]')?.remove();
      } else {
        tag
          .querySelector('[data-esa-pill-remove]')
          ?.setAttribute('aria-label', `Remove ${label}`);
      }
      return tag;
    }

    #announce(): void {
      this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
    }

    #commitAdd(): void {
      const add = this.#addInput;
      const label = add?.value.trim();
      if (!add || !label) return;
      this.#list?.insertBefore(this.#newTag(label), add.closest('li'));
      add.value = '';
      this.#announce();
    }

    // ---- rename in place ---------------------------------------------------

    // The pill's label element, parked during a rename. The SAME node is
    // restored on commit — a freshly created span would lack the pill's
    // Astro scope attribute and silently drop its typography.
    #parkedLabel = new WeakMap<HTMLElement, HTMLElement>();

    #startEdit(tag: HTMLElement): void {
      const labelEl = tag.querySelector<HTMLElement>('.esa-pill__label');
      if (!labelEl || tag.querySelector('.bcn-tag-editor__edit')) return;
      this.#parkedLabel.set(tag, labelEl);
      const current = labelEl.textContent ?? '';
      const input = document.createElement('input');
      input.className = 'bcn-tag-editor__edit';
      input.type = 'text';
      input.value = current;
      input.dataset.was = current;
      input.setAttribute('aria-label', `Rename ${current}`);
      input.style.inlineSize = `${Math.max(current.length, 2)}ch`;
      input.addEventListener('input', () => {
        input.style.inlineSize = `${Math.max(input.value.length, 2)}ch`;
      });
      // A mid-rename chip must not be draggable — a drag would eat the mouseup
      // the field needs.
      tag.removeAttribute('draggable');
      labelEl.replaceWith(input);
      input.focus();
      input.select();
    }

    #finishEdit(tag: HTMLElement, commit: boolean): void {
      const input = tag.querySelector<HTMLInputElement>('.bcn-tag-editor__edit');
      if (!input) return;
      // RE-ENTRANCY GUARD: replacing the focused input fires focusout
      // synchronously, whose handler calls this method again mid-replace —
      // the second pass must stand down or replaceWith throws on a node
      // already out of the tree.
      if (input.dataset.finishing) return;
      input.dataset.finishing = '1';
      const was = input.dataset.was ?? '';
      const next = commit ? input.value.trim() : was;
      if (!next) {
        // Renamed to nothing = removed, the same rule the option list stated.
        const sibling = tag.nextElementSibling ?? tag.previousElementSibling;
        tag.remove();
        (sibling as HTMLElement)?.focus?.();
        this.#announce();
        return;
      }
      const labelEl = this.#parkedLabel.get(tag);
      if (!labelEl) return;
      labelEl.textContent = next;
      input.replaceWith(labelEl);
      tag.setAttribute('draggable', 'true');
      tag.querySelector('[data-esa-pill-remove]')?.setAttribute('aria-label', `Remove ${next}`);
      if (next !== was) this.#announce();
    }

    #onClick = (event: Event): void => {
      const target = event.target as HTMLElement;
      if (target.closest('[data-esa-pill-remove]') || target.closest('.bcn-tag-editor__edit')) return;
      const label = target.closest('.esa-pill__label');
      const tag = target.closest<HTMLElement>('.bcn-tag-editor__tag');
      if (label && tag) this.#startEdit(tag);
    };

    #onFocusOut = (event: FocusEvent): void => {
      const input = event.target as HTMLElement;
      if (!input.classList?.contains('bcn-tag-editor__edit')) return;
      const tag = input.closest<HTMLElement>('.bcn-tag-editor__tag');
      if (tag) this.#finishEdit(tag, true);
    };

    #onKeyDown = (event: KeyboardEvent): void => {
      const target = event.target as HTMLElement;

      // Inside a rename field: Enter commits, Esc reverts.
      if (target.classList?.contains('bcn-tag-editor__edit')) {
        const tag = target.closest<HTMLElement>('.bcn-tag-editor__tag');
        if (!tag) return;
        if (event.key === 'Enter') {
          event.preventDefault();
          this.#finishEdit(tag, true);
          tag.focus();
        } else if (event.key === 'Escape') {
          event.preventDefault();
          this.#finishEdit(tag, false);
          tag.focus();
        }
        return;
      }

      const tag = target.closest<HTMLElement>('.bcn-tag-editor__tag');
      if (!tag || target !== tag) return;

      if (event.key === 'Enter' || event.key === 'F2') {
        event.preventDefault();
        this.#startEdit(tag);
      } else if (event.key === 'Delete' || event.key === 'Backspace') {
        event.preventDefault();
        const sibling = tag.nextElementSibling ?? tag.previousElementSibling;
        tag.remove();
        (sibling as HTMLElement)?.focus?.();
        this.#announce();
      } else if (event.shiftKey && (event.key === 'ArrowLeft' || event.key === 'ArrowRight')) {
        // Keyboard arrange — the drag gesture's non-pointer twin.
        event.preventDefault();
        const sibling = event.key === 'ArrowLeft' ? tag.previousElementSibling : tag.nextElementSibling;
        if (sibling?.classList.contains('bcn-tag-editor__tag')) {
          sibling.insertAdjacentElement(event.key === 'ArrowLeft' ? 'beforebegin' : 'afterend', tag);
          tag.focus();
          this.#announce();
        }
      } else if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        const sibling = event.key === 'ArrowLeft' ? tag.previousElementSibling : tag.nextElementSibling;
        if (sibling?.classList.contains('bcn-tag-editor__tag')) (sibling as HTMLElement).focus();
      }
    };

    // ---- drag arrange ------------------------------------------------------

    #dragging: HTMLElement | null = null;

    #clearDropMarks(): void {
      this.#tags().forEach((t) => {
        t.removeAttribute('data-drop-before');
        t.removeAttribute('data-drop-after');
      });
    }

    #onDragStart = (event: DragEvent): void => {
      const tag = (event.target as HTMLElement).closest<HTMLElement>('.bcn-tag-editor__tag');
      if (!tag) return;
      this.#dragging = tag;
      tag.setAttribute('data-dragging', '');
      event.dataTransfer?.setData('text/plain', this.#labelOf(tag));
      if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
    };

    #onDragOver = (event: DragEvent): void => {
      if (!this.#dragging) return;
      event.preventDefault();
      const over = (event.target as HTMLElement).closest<HTMLElement>('.bcn-tag-editor__tag');
      this.#clearDropMarks();
      if (!over || over === this.#dragging) return;
      const r = over.getBoundingClientRect();
      const before = event.clientX < r.left + r.width / 2;
      over.setAttribute(before ? 'data-drop-before' : 'data-drop-after', '');
    };

    #onDrop = (event: DragEvent): void => {
      if (!this.#dragging) return;
      event.preventDefault();
      const over = (event.target as HTMLElement).closest<HTMLElement>('.bcn-tag-editor__tag');
      if (over && over !== this.#dragging) {
        const r = over.getBoundingClientRect();
        const before = event.clientX < r.left + r.width / 2;
        over.insertAdjacentElement(before ? 'beforebegin' : 'afterend', this.#dragging);
        this.#announce();
      }
      this.#clearDropMarks();
    };

    #onDragEnd = (): void => {
      this.#dragging?.removeAttribute('data-dragging');
      this.#dragging = null;
      this.#clearDropMarks();
    };
  }

  if (!customElements.get('bcn-tag-editor')) {
    customElements.define('bcn-tag-editor', BcnTagEditor);
  }
</script>
