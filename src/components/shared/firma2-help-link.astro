---
// firma2-help-link — a "Learn about…" link that opens the Help sheet
// (firma2-help-sheet, mounted by AppLayout) at one article, beside the control
// it explains. For the few surfaces where people stall; not for every heading.
//
// A real link (`?help=<article>`), so it still works before scripts load and
// opens in a new tab with ⌘-click. The sheet's one delegated listener catches
// the click, so this has no script of its own — safe inside a <template>.
//
// bcn-lego-checked: an inline text link is a native <a>; no esa- lego is a
// text link (esa-icon-link is icon-led navigation). Beacon is not cloned.
interface Props {
  /** The Help article's slug, from src/data/firma2-help.ts. */
  article: string;
  slot?: string;
}

const { article } = Astro.props;
---
<a class="firma2-help-link typography-body-sm" href={`?help=${article}`} data-help-article={article}><slot /></a>

<style>
  .firma2-help-link {
    white-space: nowrap;
  }
</style>
