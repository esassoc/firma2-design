---
// firma2-changelog-list — the changelog's dated entries, newest first, from
// src/data/firma2-changelog.ts. One heading per day, its changes as a list.
//
// bcn-lego-checked: a dated list of plain sentences is a <section> per date
// with an <h2> and a <ul>; no esa- lego is a changelog (esa-card would box
// every day, which the settings surface rule cuts). Beacon is not cloned.
import { CHANGELOG } from '../../data/firma2-changelog';

const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const dateLabel = (iso: string): string => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${MONTHS[m - 1]} ${d}, ${y}`;
};
---
<div class="firma2-changelog-list stack" data-gap="2xl">
  {CHANGELOG.map((entry) => (
    <section class="stack" data-gap="sm" aria-labelledby={`changelog-${entry.date}`}>
      <h2 class="typography-title-strong firma2-changelog-list__date" id={`changelog-${entry.date}`}>
        <time datetime={entry.date}>{dateLabel(entry.date)}</time>
      </h2>
      <ul class="stack firma2-changelog-list__changes" data-gap="xs">
        {entry.changes.map((change) => <li class="typography-body-md">{change}</li>)}
      </ul>
    </section>
  ))}
</div>

<style>
  .firma2-changelog-list__date {
    margin: 0;
  }
  .firma2-changelog-list__changes {
    margin: 0;
    padding-inline-start: var(--spacing-500, 1.5rem);
  }
</style>
