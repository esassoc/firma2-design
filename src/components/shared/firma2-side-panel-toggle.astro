---
// firma2-side-panel-toggle — the button that opens and closes a
// firma2-side-panel. A disclosure: aria-controls names the panel and
// aria-expanded follows it (the panel's script keeps every toggle for it in
// step). Ghost, because it shows a companion to the page rather than acting
// on the record; it rides the page header's toolbar row.
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  /** The firma2-side-panel's id. */
  controls: string;
  label: string;
  icon?: string;
}

const { controls, label, icon = 'eye' } = Astro.props;
---
<EsaButton variant="ghost" size="md" icon={icon} aria-controls={controls} aria-expanded="true" data-side-panel-toggle={controls}>{label}</EsaButton>
