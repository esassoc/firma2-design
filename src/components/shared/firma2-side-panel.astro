---
// firma2-side-panel — a page spine with a docked side panel: the page's
// content in a capped column, and a firma2-rail at the window's edge holding
// whatever the page puts in its "panel" slot, under a heading.
//
// FOR A LIVE COMPANION TO WHAT YOU ARE EDITING — the measure page's reporter
// preview first (user, 2026-10-08): the preview sat in a sticky column inside
// the old side sheet, was demoted to the bottom of a one-column page, and came
// back as this, so the cost of an edit is in view while the edit is made.
//
// ONE OF firma2-rail's PRESETS (2026-10-20). It used to restate the peek's
// construction, close with an X and reopen from a top-bar toggle, vanishing
// with no motion. It is the same rail as every other now: the chevron on its
// edge collapses it to a strip and back, animated, and the strip is the way
// back. Collapsed is remembered per panel through the edge handle's key.
//
// Use on an AppLayout with width="full" so the panel reaches the window edge;
// `max` caps the content column (CONTENT_READING for a settings record).
// 664px is where the track wraps: the 20rem floor + the 1.5rem gutter + the
// 20rem --sidebar-content-min this spine sets.
//
// bcn-lego-checked: the rail is firma2-rail; the column cap is esa-container.
// Beacon is not cloned on this machine.
import EsaContainer from '@esa/ecology/esa-container.astro';
import Firma2Rail from './firma2-rail.astro';
import { CONTENT_MAX } from '../../lib/content-width';

interface Props {
  /** The rail's id, and its storage key. */
  id: string;
  /** The panel's heading, and the name its landmark is announced by. */
  title: string;
  /** The content column's cap. */
  max?: string;
  /** Opening width; the reader can drag it from there, between 320 and 640px. */
  panelWidth?: string;
}

const { id, title, max = CONTENT_MAX, panelWidth = '26rem' } = Astro.props;
const titleId = `${id}-title`;
---
<div class="sidebar firma2-side-panel-layout" data-side="end" style={`--sidebar-width: ${panelWidth}; --sidebar-content-min: 20rem`}>
  <Firma2Rail
    id={id}
    class="firma2-side-panel"
    label={title.toLowerCase()}
    ariaLabelledby={titleId}
    width={panelWidth}
    floor="20rem"
    min={320}
    max={640}
    storageKey={`side-panel-${id}`}
    unpinAt={664}
  >
    <h2 class="firma2-side-panel__title typography-title" id={titleId}>{title}</h2>
    <slot name="panel" />
  </Firma2Rail>
  <EsaContainer maxWidth={max}><slot /></EsaContainer>
</div>

<style>
  .firma2-side-panel__title {
    margin: 0;
    /* The rail's toggle sits at this row's trailing end. */
    padding-inline-end: calc(2.5rem + var(--spacing-200, 0.5rem));
  }
</style>
