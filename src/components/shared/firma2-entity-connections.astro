---
// firma2-entity-connections — the Connections section of a record's rail: the
// record and everything it links to directly, as an Obsidian-style local
// graph (user, 2026-10-09). Rendered in every record's right rail — a tab on
// the project page, the whole rail on a classification, a performance measure
// and an organization.
//
// The brief's five (docs/product-brief.md §5):
// 1. ONE QUESTION: "What is this record tied to, and where do I go next?"
// 2. READERS: program staff moving between a goal, its measures and the
//    projects reporting them; a partner arriving from a chip who wants the
//    neighbourhood before the numbers.
// 3. SERIES/SCALAR: neither — a set of links. The graph is the picture, the
//    legend states the counts, and the list is the same set in text.
// 4. IRREVERSIBLE: nothing; every node is a door.
// 5. CUT: a depth control (one hop, by decision) and filtering by kind.
//
// VIEW CONTROLS. Zoom in, zoom out and reset float over the graph's corner,
// the floating-map-tool idiom (firma2-project-map's chrome sm buttons). They
// are the keyboard's way to zoom — pinch and ctrl/⌘+wheel are the pointer's,
// and a bare wheel stays the rail's scroll (bcn-entity-graph's header).
//
// COMPOSITION: bcn-entity-graph draws; this owns the words around it — the
// heading (absent where a tab already names the panel), the kind legend, the
// empty state, and the "View as list" alternative the graph's accessibility
// story depends on (esa-chart's convention: a chart ships with its data).
//
// bcn-lego-checked: legend dots are a 10px swatch beside a label — esa-badge
// and esa-pill carry text in a box, not a series key; checked Beacon (not
// cloned). Everything else is esa-collapsible, esa-empty-state and the layout
// primitives.
import EsaCollapsible from '@esa/ecology/esa-collapsible.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { ENTITY_KINDS } from '../../lib/entity-graph';
import type { EntityGraph } from '../../lib/entity-graph';

interface Props {
  graph: EntityGraph;
  /** Show the "Connections" heading. Off where a tab already names the panel. */
  heading?: boolean;
}

const { graph, heading = true } = Astro.props;
const center = graph.nodes.find((n) => n.center);
const neighbours = graph.nodes.filter((n) => !n.center);
const groups = ENTITY_KINDS.map((k) => ({ ...k, nodes: neighbours.filter((n) => n.kind === k.kind) })).filter(
  (g) => g.nodes.length > 0,
);
const kindAttrs = Object.fromEntries(ENTITY_KINDS.map((k) => [`data-kind-${k.kind}`, k.one]));
const headingId = 'firma2-entity-connections-heading';
---
<section class="firma2-entity-connections stack" data-gap="md" aria-labelledby={heading ? headingId : undefined} aria-label={heading ? undefined : 'Connections'}>
  {heading && <h2 id={headingId} class="typography-title-strong">Connections</h2>}

  {neighbours.length === 0 ? (
    <EsaEmptyState title="No connections yet" size="sm" />
  ) : (
    <>
      <ul class="firma2-entity-connections__legend cluster" data-gap="sm" role="list">
        {groups.map((g) => (
          <li class="firma2-entity-connections__key typography-body-sm" data-kind={g.kind}>
            <span class="firma2-entity-connections__swatch" aria-hidden="true"></span>
            {g.many} <span class="firma2-entity-connections__count">{g.nodes.length}</span>
          </li>
        ))}
      </ul>

      <div class="firma2-entity-connections__canvas">
        <bcn-entity-graph label={`Connections of ${center?.label ?? 'this record'}`} {...kindAttrs}>
          <script type="application/json" set:html={JSON.stringify(graph)} />
        </bcn-entity-graph>
        <div class="firma2-entity-connections__tools cluster" data-gap="xs">
          <EsaButton variant="chrome" size="sm" iconOnly icon="zoom-in" label="Zoom in" data-graph-action="zoomIn" />
          <EsaButton variant="chrome" size="sm" iconOnly icon="zoom-out" label="Zoom out" data-graph-action="zoomOut" />
          <EsaButton variant="chrome" size="sm" iconOnly icon="scan" label="Reset view" data-graph-action="fit" />
        </div>
      </div>

      <EsaCollapsible title="View as list" flush>
        <div class="stack" data-gap="lg">
          {groups.map((g) => (
            <div class="stack" data-gap="xs">
              <h3 class="typography-label-md-strong">{g.many}</h3>
              <ul class="firma2-entity-connections__list stack" data-gap="xs" role="list">
                {g.nodes.map((n) => (
                  <li class="typography-body-sm">{n.href ? <a href={n.href}>{n.label}</a> : n.label}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </EsaCollapsible>
    </>
  )}
</section>

<style>
  .firma2-entity-connections__canvas {
    position: relative;
  }
  .firma2-entity-connections__tools {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
  }
  .firma2-entity-connections__legend {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .firma2-entity-connections__key {
    /* One slot per kind, the same slots bcn-entity-graph paints with. */
    --_kind: var(--color-background-dataviz-categorical-8, #167a7a);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-150, 0.375rem);
    color: var(--color-content-default, #1c2024);
  }
  .firma2-entity-connections__key[data-kind='project'] { --_kind: var(--color-background-dataviz-categorical-1, #2a7e3b); }
  .firma2-entity-connections__key[data-kind='classification'] { --_kind: var(--color-background-dataviz-categorical-2, #3e63dd); }
  .firma2-entity-connections__key[data-kind='measure'] { --_kind: var(--color-background-dataviz-categorical-3, #ef5f00); }
  .firma2-entity-connections__key[data-kind='organization'] { --_kind: var(--color-background-dataviz-categorical-4, #0090ff); }
  .firma2-entity-connections__key[data-kind='tag'] { --_kind: var(--color-background-dataviz-categorical-5, #c2298a); }

  .firma2-entity-connections__swatch {
    inline-size: 10px;
    block-size: 10px;
    border-radius: 50%;
    background: var(--_kind);
    flex: none;
  }
  .firma2-entity-connections__count {
    color: var(--color-content-default-secondary, #60646c);
  }
  .firma2-entity-connections__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>

<script>
  import './bcn-entity-graph';

  type Graph = HTMLElement & { zoomIn(): void; zoomOut(): void; fit(): void };

  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLElement>('[data-graph-action]');
    if (!button) return;
    const graph = button.closest('.firma2-entity-connections__canvas')?.querySelector<Graph>('bcn-entity-graph');
    const action = button.dataset.graphAction as 'zoomIn' | 'zoomOut' | 'fit';
    graph?.[action]?.();
  });
</script>
