---
// firma2-funding-source-summary — the top of a funding source's page: what it
// is (its stored description), who offers it, what the workspace recorded
// about it, and the three figures it adds up to across projects.
//
// THE DESCRIPTION IS A DATUM, not a lede: the sentence stored on the funding
// source. The recorded facts are the workspace's funding source fields
// (Workspace settings › Funding source fields), answered; one that was not
// answered is not listed.
//
// SECURED AND REQUESTED ARE SEPARATE FIGURES (docs/data-model.md, decision 7).
// Secured is money projects have. Requested is asked for and not decided, and
// is never added to it.
//
// bcn-lego-checked: esa-stat for the figures on the hub's `.grid` primitive
// (firma2-classification-summary's construction); the facts are a <dl> on
// `.stack`, the measure facts' construction. Beacon is not cloned on this
// machine.
import EsaStat from '@esa/ecology/esa-stat.astro';
import type { FundingSourceRollup } from '../../data/firma2-funding-source-rollup';
import { currencyFormatter as currency } from '../../lib/format';

interface Props {
  rollup: FundingSourceRollup;
}

const { rollup } = Astro.props;
const { source } = rollup;
const facts = [['Offered by', source.organization], ...Object.entries(source.fields)];
const askedBy = rollup.rows.filter((row) => row.status === 'requested').length;
---
<section class="firma2-funding-source-summary stack" data-gap="lg" aria-label="Summary">
  {source.description && <p class="typography-body-lg">{source.description}</p>}
  <div class="firma2-funding-source-summary__figures grid" data-gap="md">
    <EsaStat value={currency.format(rollup.secured)} label="Secured" />
    <EsaStat value={currency.format(rollup.requested)} label="Requested" sub={askedBy > 0 ? `${askedBy} ${askedBy === 1 ? 'project' : 'projects'} waiting` : undefined} />
    <EsaStat value={rollup.projects} label="Projects" />
  </div>
  <dl class="firma2-funding-source-summary__facts grid" data-gap="md">
    {facts.map(([label, value]) => (
      <div class="stack" data-gap="2xs">
        <dt class="firma2-funding-source-summary__label typography-label-sm">{label}</dt>
        <dd class="typography-body-md">{value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  /* Three tiles go three-up or one-up, never two and an orphan. */
  .firma2-funding-source-summary__figures {
    --grid-min: 14rem;
  }

  .firma2-funding-source-summary__facts {
    --grid-min: 12rem;
    margin: 0;
  }

  .firma2-funding-source-summary__facts dd {
    margin: 0;
  }

  .firma2-funding-source-summary__label {
    color: var(--color-content-default-secondary);
  }
</style>
