---
// firma2-public-site-home — Public site › Home page: which sections the public
// home shows, in what order, each section's few choices, and the announcement.
//
// SECTIONS ARE A LIST YOU BUILD. The five one-of-a-kind sections (introduction,
// map, goals, recently updated, partners) can each be removed and put back;
// the four written kinds (text, image with text, button, custom page) can be
// added any number of times. Removing a written block deletes its words;
// Discard changes is the way back.
//
// ONE PANEL AT A TIME. A row's Edit opens that section's choices under the
// list. A written kind has one panel, pointed at whichever block is open.
//
// AN ADMINISTRATOR CHOOSES WHAT APPEARS, NEVER A NUMBER (decision 3): the
// panels pick results, projects and goals from what published projects
// already report. Nothing here takes a figure.
//
// "NOTHING TO SHOW YET" (decision 8). A section that is on the page but has no
// content says so on its row, and its panel says why, so an empty stretch of
// the home is never a mystery.
//
// bcn-lego-checked: firma2-ordered-picker (the lists), firma2-site-image,
// esa-text-field, esa-textarea, esa-select, esa-button-toggle,
// esa-switch-toggle in firma2-switch-list rows, esa-date-picker — all composed
// unchanged in firma2-rail-section. The one class names a group of controls
// inside a panel. Beacon is not cloned on this machine.
import Firma2RailSection from '../shared/firma2-rail-section.astro';
import '../shared/firma2-switch-list.css';
import Firma2OrderedPicker from './firma2-ordered-picker.astro';
import Firma2SiteImage from './firma2-site-image.astro';
import { publicSiteDefaults } from '../../data/firma2-public-site';
import { MAP_BASES, MAX_FEATURED, MAX_RESULTS, RECENT_COUNTS } from '../../lib/public-site-config';

const defaults = publicSiteDefaults();
const json = (v: unknown) => JSON.stringify(v);
const areas = [{ value: 'all', label: 'All projects' }, ...defaults.counties];
const SIDES = [
  { value: 'start', label: 'Left' },
  { value: 'end', label: 'Right' },
];
const PARTNER_SWITCHES = [
  { path: 'home.partners.funders', label: 'Funders' },
  { path: 'home.partners.leads', label: 'Lead organizations' },
  { path: 'home.partners.amounts', label: 'Funding amounts' },
];
---
<div class="firma2-public-site-home stack" data-gap="2xl" data-site-part="home">
  <Firma2RailSection title="Sections">
    <Firma2OrderedPicker name="sections" label="Home page sections" addLabel="Add section" edit emptyText="The home page has no sections." />
  </Firma2RailSection>

  <div hidden data-section-panel="hero" tabindex="-1">
    <Firma2RailSection title="Introduction">
      <div class="stack" data-gap="lg">
        <esa-text-field label="Headline" size="md" data-bind="home.hero.headline"></esa-text-field>
        <esa-textarea label="Description" size="md" rows="3" data-bind="home.hero.description"></esa-textarea>
        <div class="stack" data-gap="sm">
          <h4 class="typography-label-md-strong">Results</h4>
          <Firma2OrderedPicker name="results" label="Results" addLabel="Add result" max={MAX_RESULTS} emptyText="No results shown." />
        </div>
        <div class="stack" data-gap="sm">
          <h4 class="typography-label-md-strong">Featured projects</h4>
          <Firma2OrderedPicker name="featured" label="Featured projects" addLabel="Add project" max={MAX_FEATURED} emptyText="No projects featured." />
          <p class="firma2-public-site-home__quiet typography-body-sm">Only public projects with a photo can be featured.</p>
        </div>
      </div>
    </Firma2RailSection>
  </div>

  <div hidden data-section-panel="map" tabindex="-1">
    <Firma2RailSection title="Map">
      <div class="stack" data-gap="lg">
        <p class="firma2-public-site-home__quiet typography-body-sm" hidden data-empty-reason="map"></p>
        <esa-button-toggle label="Base map" size="md" options={json(MAP_BASES)} data-bind="home.map.base"></esa-button-toggle>
        <esa-select label="Opens on" size="md" options={json(areas)} data-bind="home.map.area"></esa-select>
      </div>
    </Firma2RailSection>
  </div>

  <div hidden data-section-panel="goals" tabindex="-1">
    <Firma2RailSection title="Goals">
      <div class="stack" data-gap="sm">
        <p class="firma2-public-site-home__quiet typography-body-sm" hidden data-empty-reason="goals"></p>
        <Firma2OrderedPicker name="goals" label="Goals shown" addLabel="Add goal" emptyText="No goals shown." />
      </div>
    </Firma2RailSection>
  </div>

  <div hidden data-section-panel="recent" tabindex="-1">
    <Firma2RailSection title="Recently updated">
      <div class="stack" data-gap="sm">
        <p class="firma2-public-site-home__quiet typography-body-sm" hidden data-empty-reason="recent"></p>
        <esa-button-toggle label="Projects shown" size="md" options={json(RECENT_COUNTS)} data-bind="home.recent.count"></esa-button-toggle>
      </div>
    </Firma2RailSection>
  </div>

  <div hidden data-section-panel="partners" tabindex="-1">
    <Firma2RailSection title="Partners">
      <div class="stack" data-gap="sm">
        <p class="firma2-public-site-home__quiet typography-body-sm" hidden data-empty-reason="partners"></p>
        <div class="firma2-switch-list">
          {PARTNER_SWITCHES.map((s) => (
            <div class="firma2-switch-list__row">
              <esa-switch-toggle label={s.label} label-position="before" data-bind={s.path}></esa-switch-toggle>
            </div>
          ))}
        </div>
      </div>
    </Firma2RailSection>
  </div>

  {/* The written kinds: one panel each, bound to whichever block is open. */}
  <div hidden data-section-panel="text" data-bind-scope tabindex="-1">
    <Firma2RailSection title="Text">
      <div class="stack" data-gap="lg">
        <esa-text-field label="Heading" size="md" data-bind="heading"></esa-text-field>
        <esa-textarea label="Text" size="md" rows="6" help-text="A blank line starts a new paragraph." data-bind="body"></esa-textarea>
      </div>
    </Firma2RailSection>
  </div>

  <div hidden data-section-panel="image-text" data-bind-scope tabindex="-1">
    <Firma2RailSection title="Image with text">
      <div class="stack" data-gap="lg">
        <Firma2SiteImage path="image" label="Image" alt="The block's image" max={1400} />
        <esa-text-field label="Image description" size="md" help-text="Read aloud to people who cannot see the image." data-bind="imageAlt"></esa-text-field>
        <esa-button-toggle label="Image side" size="md" options={json(SIDES)} data-bind="side"></esa-button-toggle>
        <esa-text-field label="Heading" size="md" data-bind="heading"></esa-text-field>
        <esa-textarea label="Text" size="md" rows="6" help-text="A blank line starts a new paragraph." data-bind="body"></esa-textarea>
      </div>
    </Firma2RailSection>
  </div>

  <div hidden data-section-panel="button" data-bind-scope tabindex="-1">
    <Firma2RailSection title="Button">
      <div class="stack" data-gap="lg">
        <esa-text-field label="Heading" size="md" data-bind="heading"></esa-text-field>
        <esa-textarea label="Text" size="md" rows="3" data-bind="body"></esa-textarea>
        <esa-text-field label="Button text" size="md" placeholder="e.g. Apply for a grant" data-bind="buttonLabel"></esa-text-field>
        <esa-text-field label="Button address" size="md" placeholder="e.g. https://example.org/apply" data-bind="href"></esa-text-field>
      </div>
    </Firma2RailSection>
  </div>

  <div hidden data-section-panel="page" data-bind-scope tabindex="-1">
    <Firma2RailSection title="Custom page">
      {defaults.pages.length > 0 ? (
        <esa-select label="Page" size="md" options={json(defaults.pages)} data-bind="pageId"></esa-select>
      ) : (
        <p class="firma2-public-site-home__quiet typography-body-sm">This workspace has no custom pages yet.</p>
      )}
    </Firma2RailSection>
  </div>

  <Firma2RailSection title="Announcement">
    <div class="stack" data-gap="lg">
      <div class="firma2-switch-list">
        <div class="firma2-switch-list__row">
          <esa-switch-toggle label="Show an announcement" label-position="before" data-bind="announcement.on" data-hint="A strip under the navigation bar on the home page."></esa-switch-toggle>
          <p class="firma2-switch-list__hint typography-body-sm">A strip under the navigation bar on the home page.</p>
        </div>
      </div>
      <esa-text-field label="Message" size="md" data-bind="announcement.text"></esa-text-field>
      <div class="grid" data-gap="md" data-min="12rem">
        <esa-text-field label="Link text" size="md" data-bind="announcement.linkLabel"></esa-text-field>
        <esa-text-field label="Link address" size="md" data-bind="announcement.href"></esa-text-field>
      </div>
      <div class="grid" data-gap="md" data-min="12rem">
        <esa-date-picker label="First day shown" size="md" data-bind="announcement.from"></esa-date-picker>
        <esa-date-picker label="Last day shown" size="md" data-bind="announcement.until"></esa-date-picker>
      </div>
    </div>
  </Firma2RailSection>
</div>

<style>
  .firma2-public-site-home [data-section-panel]:focus {
    outline: none;
  }
  .firma2-public-site-home h4,
  .firma2-public-site-home__quiet {
    margin: 0;
  }
  .firma2-public-site-home__quiet {
    color: var(--color-text-secondary);
  }
</style>

<script>
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-textarea';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-button-toggle';
  import '@esa/ecology/esa-switch-toggle';
  import '@esa/ecology/esa-date-picker';
  import { orderedPicker } from '../../lib/ordered-picker';
  import type { Picker } from '../../lib/ordered-picker';
  import { BLOCK_KINDS, BUILT_IN_SECTIONS, isBuiltIn, newBlock } from '../../lib/public-site-config';
  import type { BlockKind, Option, SiteBlock } from '../../lib/public-site-config';
  import { bind, commit, config, defaults, describeSwitches, write } from '../../lib/public-site-form';
  import { PUBLIC_SITE_EVENT } from '../../lib/public-site-store';

  const root = document.querySelector<HTMLElement>('[data-site-part="home"]');
  if (root && defaults) {
    const home = config.home;
    const picker = (name: string): HTMLElement => root.querySelector<HTMLElement>(`[data-picker="${name}"]`)!;
    const labelIn = (options: Option[], key: string): string => options.find((o) => o.value === key)?.label ?? key;
    const kindLabel = (kind: BlockKind): string => labelIn(BLOCK_KINDS, kind);

    /** Does a written block have enough to appear on the page? */
    const filled = (block: SiteBlock): boolean =>
      block.kind === 'text'
        ? Boolean(block.heading.trim() || block.body.trim())
        : block.kind === 'image-text'
          ? Boolean(block.image)
          : block.kind === 'button'
            ? Boolean(block.buttonLabel.trim() && block.href.trim())
            : Boolean(block.pageId);

    const sectionLabel = (id: string): string => {
      if (isBuiltIn(id)) return labelIn(BUILT_IN_SECTIONS, id);
      const block = home.blocks[id];
      if (!block) return id;
      const named = block.kind === 'page' ? labelIn(defaults.pages, block.pageId) : block.heading.trim();
      return named && named !== block.pageId ? `${kindLabel(block.kind)}: ${named}` : kindLabel(block.kind);
    };

    // A simple pick-from-a-list picker: results, featured projects, goals.
    const choose = (name: string, path: 'home.hero.results' | 'home.hero.featured' | 'home.goals.shown', options: Option[]): Picker => {
      const keys = (): string[] => (path === 'home.hero.results' ? home.hero.results : path === 'home.hero.featured' ? home.hero.featured : home.goals.shown);
      return orderedPicker(picker(name), {
        keys,
        set: (next) => write(path, next),
        labelOf: (key) => labelIn(options, key),
        choices: () => options.filter((o) => !keys().includes(o.value)).map((o) => ({ label: o.label, action: o.value })),
        add: (action) => action,
      });
    };
    choose('results', 'home.hero.results', defaults.measures);
    choose('featured', 'home.hero.featured', defaults.projects);
    choose('goals', 'home.goals.shown', defaults.goals);

    root.querySelectorAll<HTMLElement>('[data-empty-reason]').forEach((el) => {
      const reason = defaults.empty[el.dataset.emptyReason as keyof typeof defaults.empty];
      el.textContent = reason ?? '';
      el.hidden = !reason;
    });

    // ONE PANEL AT A TIME, under the list.
    let open: string | null = null;
    const panels = [...root.querySelectorAll<HTMLElement>('[data-section-panel]')];
    const mark = (): void => {
      picker('sections')
        .querySelectorAll<HTMLElement>('li[data-sort-key]')
        .forEach((li) => (li.dataset.sortKey === open ? li.setAttribute('aria-current', 'true') : li.removeAttribute('aria-current')));
    };
    const show = (id: string | null): void => {
      open = id;
      const kind = id && (isBuiltIn(id) ? id : home.blocks[id]?.kind);
      panels.forEach((panel) => (panel.hidden = panel.dataset.sectionPanel !== kind));
      const panel = panels.find((p) => !p.hidden);
      if (panel && id && !isBuiltIn(id)) bind(panel, `home.blocks.${id}.`);
      mark();
      // After the frame, so a closing menu handing focus back to its button
      // does not take it away again.
      if (panel)
        requestAnimationFrame(() => {
          panel.focus({ preventScroll: true });
          panel.scrollIntoView({ block: 'nearest', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        });
    };

    const sections = orderedPicker(picker('sections'), {
      keys: () => home.order,
      set: (next) => write('home.order', next),
      labelOf: sectionLabel,
      noteOf: (id) =>
        isBuiltIn(id) ? (defaults.empty[id] ? 'Nothing to show yet' : '') : home.blocks[id] && !filled(home.blocks[id]) ? 'Not shown until filled in' : '',
      choices: () => {
        const missing = BUILT_IN_SECTIONS.filter((s) => !home.order.includes(s.value)).map((s) => ({ label: s.label, action: s.value as string }));
        return [...missing, ...(missing.length ? [{ label: '', action: '', divider: true }] : []), ...BLOCK_KINDS.map((k) => ({ label: k.label, action: `new:${k.value}` }))];
      },
      add: (action) => {
        if (!action.startsWith('new:')) return action;
        const kind = action.slice(4) as BlockKind;
        const id = `${kind}-${Date.now().toString(36)}`;
        home.blocks[id] = newBlock(kind);
        return id;
      },
      onEdit: show,
      onRemove: (id) => {
        if (!isBuiltIn(id)) delete home.blocks[id];
        if (open === id) show(null);
        commit();
      },
      onChange: mark,
    });

    // A block's row is named by its heading, so the list follows the typing.
    document.addEventListener(PUBLIC_SITE_EVENT, () => {
      sections.paint();
      mark();
    });

    bind(root);
    describeSwitches(root);
  }
</script>
