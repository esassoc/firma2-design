---
// firma2-site-image — one picture a workspace uploads for its public site: the
// logo, the browser-tab icon, a block's image. Shows the picture in use, takes
// a replacement, and removes it.
//
// The file is downscaled in the browser before it is kept
// (src/lib/public-site-store.ts imageToDataUrl): `max` is the longest side in
// pixels, and a logo keeps its transparency (`png`).
//
// bcn-lego-checked: esa-file-upload is the drop zone and file browser;
// esa-button removes. The lego lists file names and has no picture of what is
// in use, which is the thing an administrator checks here, so the one class
// frames that picture. Beacon is not cloned on this machine.
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  /** The setting that holds the image, as public-site-form's `bind` reads it. */
  path: string;
  label: string;
  /** What the picture is, for the picture's own alt text. */
  alt: string;
  max: number;
  type?: 'png' | 'jpeg';
}

const { path, label, alt, max, type = 'jpeg' } = Astro.props;
---
<div class="firma2-site-image stack" data-gap="sm" data-image-bind={path} data-image-max={max} data-image-type={type}>
  <img class="firma2-site-image__shown" alt={alt} hidden data-image-shown />
  <esa-file-upload label={label} accept="image/*" max-size-mb="8"></esa-file-upload>
  <div hidden data-image-remove><EsaButton variant="ghost" size="md" icon="trash-2">Remove image</EsaButton></div>
</div>

<style>
  .firma2-site-image [hidden] {
    display: none !important;
  }
  /* Checkered-free on purpose: the sunken ground shows a transparent logo's
     edge without inventing a pattern. */
  .firma2-site-image__shown {
    display: block;
    max-inline-size: 100%;
    max-block-size: 9rem;
    inline-size: auto;
    padding: var(--spacing-200);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    background: var(--color-background-elevation-sunken);
    object-fit: contain;
  }
</style>

<script>
  import '@esa/ecology/esa-file-upload';
</script>
