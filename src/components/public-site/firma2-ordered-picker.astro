---
// firma2-ordered-picker — a short ordered list a person builds from a closed
// set: reorder by the grip, remove with the row's button, add from a menu of
// what is not in the list yet. The public site's settings use it for the
// home's sections, the bar's destinations, the introduction's results and
// featured projects, and the goals shown.
//
// THE LIST IS THE CONSUMER'S. This is markup only; src/lib/ordered-picker.ts
// paints the rows and hands changes back (`orderedPicker(root, options)`),
// so each use decides what a key is and what adding one means.
//
// `max` is the page's room, not a preference: the introduction holds four
// results and three photographs. At the limit the Add button gives way to a
// line that says how to make room.
//
// bcn-lego-checked: bcn-sortable-list reorders (the spoke's stand-in for
// esa-sortable-list, esassoc/ecology#39); esa-button and esa-dropdown-menu are
// the controls. esa-combobox and esa-input-tag choose a set but hold no order,
// and esa-checkbox-group cannot be reordered. The classes lay out a row.
// firma2-menu-order-editor is the same construction for a fixed set of rows;
// this adds and removes. Beacon is not cloned on this machine.
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  /** The list's accessible name. */
  label: string;
  /** The Add button's words. */
  addLabel: string;
  /** The most rows the list may hold. */
  max?: number;
  /** Rows carry an Edit button. */
  edit?: boolean;
  /** Said when the list holds nothing. */
  emptyText?: string;
  /** Names this picker for the script that drives it. */
  name: string;
}

const { label, addLabel, max, edit = false, emptyText, name } = Astro.props;
---
<div class="firma2-ordered-picker stack" data-gap="sm" data-picker={name} data-max={max} data-edit-on-add={edit ? '' : undefined}>
  <bcn-sortable-list label={label}>
    <template data-sort-handle><EsaButton variant="chrome" size="md" iconOnly icon="menu" aria-label="Move">Move</EsaButton></template>
    <ol class="firma2-ordered-picker__rows" aria-label={label} data-picker-rows></ol>
  </bcn-sortable-list>
  <template data-picker-row>
    <li>
      <span class="firma2-ordered-picker__name">
        <span class="typography-body-md" data-picker-label></span>
        <span class="firma2-ordered-picker__note typography-body-sm" data-picker-note hidden></span>
      </span>
      <span class="firma2-ordered-picker__actions">
        {edit && <EsaButton variant="ghost" size="md" data-picker-edit>Edit</EsaButton>}
        <EsaButton variant="chrome" size="md" iconOnly icon="x" aria-label="Remove" data-picker-remove>Remove</EsaButton>
      </span>
    </li>
  </template>
  {emptyText && <p class="firma2-ordered-picker__quiet typography-body-sm" data-picker-empty hidden>{emptyText}</p>}
  <div data-picker-add>
    <esa-dropdown-menu position="below-start"><EsaButton variant="secondary" size="md" icon="plus">{addLabel}</EsaButton></esa-dropdown-menu>
  </div>
  {max && <p class="firma2-ordered-picker__quiet typography-body-sm" data-picker-full hidden>Remove one to add another.</p>}
</div>

<style>
  .firma2-ordered-picker :global([hidden]) {
    display: none !important;
  }
  .firma2-ordered-picker__rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .firma2-ordered-picker__rows :global(li) {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    padding-block: var(--spacing-100);
    border-block-end: 1px solid var(--color-border-default-subtle);
  }
  .firma2-ordered-picker__rows :global(li[aria-current='true']) {
    background: var(--color-background-elevation-sunken);
  }
  .firma2-ordered-picker__name {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--spacing-050, 2px) var(--spacing-300);
    min-inline-size: 0;
  }
  .firma2-ordered-picker__note,
  .firma2-ordered-picker__quiet {
    margin: 0;
    color: var(--color-text-secondary);
  }
  .firma2-ordered-picker__actions {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--spacing-100);
  }
</style>
