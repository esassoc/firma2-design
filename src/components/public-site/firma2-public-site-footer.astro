---
// firma2-public-site-footer — Public site › Footer: what the foot of every
// public page carries beyond the workspace's name: its contact address, a line
// naming its funders, its own links and its social accounts.
//
// THE NAME AND THE CREDIT ARE NOT SWITCHES. Whose site this is, and what it
// runs on, stay. Funders are named from published projects' funding, not typed
// — the same rule as every figure on the site.
//
// bcn-lego-checked: esa-switch-toggle in firma2-switch-list rows and
// firma2-site-links (esa-text-field, esa-button), in firma2-rail-section. No
// CSS of its own. Beacon is not cloned on this machine.
import Firma2RailSection from '../shared/firma2-rail-section.astro';
import '../shared/firma2-switch-list.css';
import Firma2SiteLinks from './firma2-site-links.astro';
import { PUBLIC_SITE_OWNER } from '../../data/firma2-public-site';

const SWITCHES = [
  { path: 'footer.contact', label: 'Contact email', hint: PUBLIC_SITE_OWNER.contact },
  { path: 'footer.funders', label: 'Funders', hint: 'Names the organizations that fund public projects.' },
];
---
<div class="stack" data-gap="2xl" data-site-part="footer">
  <Firma2RailSection title="Shown in the footer">
    <div class="firma2-switch-list">
      {SWITCHES.map((s) => (
        <div class="firma2-switch-list__row">
          <esa-switch-toggle label={s.label} label-position="before" data-bind={s.path} data-hint={s.hint}></esa-switch-toggle>
          <p class="firma2-switch-list__hint typography-body-sm">{s.hint}</p>
        </div>
      ))}
    </div>
  </Firma2RailSection>

  <Firma2RailSection title="Links">
    <Firma2SiteLinks path="footer.links" addLabel="Add link" example="e.g. Accessibility" exampleAddress="e.g. https://example.org/accessibility" />
  </Firma2RailSection>

  <Firma2RailSection title="Social accounts">
    <Firma2SiteLinks path="footer.social" addLabel="Add account" example="e.g. Instagram" exampleAddress="e.g. https://instagram.com/example" />
  </Firma2RailSection>
</div>

<script>
  import '@esa/ecology/esa-switch-toggle';
  import { bind, bindLinkLists, defaults, describeSwitches } from '../../lib/public-site-form';

  const root = document.querySelector<HTMLElement>('[data-site-part="footer"]');
  if (root && defaults) {
    bind(root);
    bindLinkLists(root);
    describeSwitches(root);
  }
</script>
