---
// firma2-site-links — a short list of links a workspace adds to its public
// site: a label and an address per row, added and removed one at a time. The
// footer's own links and its social accounts are both this.
//
// Rows are painted by src/lib/public-site-form.ts (`bindLinkLists`) from the
// template below; each field commits as it is typed.
//
// bcn-lego-checked: esa-text-field and esa-button are the controls; the class
// sets a row's two fields and its button on one line. esa-input-tag holds
// single strings, not label-and-address pairs. firma2-settings-link-list is a
// list of links to pages, not an editor. Beacon is not cloned on this machine.
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  /** The setting that holds the list. */
  path: string;
  addLabel: string;
  /** An example label, e.g. "Instagram". */
  example: string;
  exampleAddress: string;
}

const { path, addLabel, example, exampleAddress } = Astro.props;
---
<div class="firma2-site-links stack" data-gap="md" data-link-list={path}>
  <div class="stack" data-gap="md" data-link-rows></div>
  <template data-link-row>
    <div class="firma2-site-links__row">
      <esa-text-field label="Label" size="md" placeholder={example} data-link-field="label"></esa-text-field>
      <esa-text-field label="Address" size="md" placeholder={exampleAddress} data-link-field="href"></esa-text-field>
      <EsaButton variant="chrome" size="md" iconOnly icon="x" aria-label="Remove link" data-link-remove>Remove</EsaButton>
    </div>
  </template>
  <div><EsaButton variant="secondary" size="md" icon="plus" data-link-add>{addLabel}</EsaButton></div>
</div>

<style>
  .firma2-site-links__row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr) auto;
    gap: var(--spacing-200);
    align-items: end;
  }
  @media (max-width: 45rem) {
    .firma2-site-links__row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .firma2-site-links__row :global(esa-text-field:first-child) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import '@esa/ecology/esa-text-field';
</script>
