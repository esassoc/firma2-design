---
// firma2-gis-subscriptions — project footprints kept current from a GIS the
// workspace already runs. Ported from ProjectFirma2 hackathon team 2's
// /geospatial-subscriptions, the screen Marcus lives on.
//
// MARCUS'S BAR IS TWO-WAY, and this page is the inbound half: his layer stays
// authoritative, a sync follows it, and nobody redigitizes. Three things the
// team learned the hard way are built into the screen rather than a runbook:
//
//   A SYNC NEVER DELETES. A feature that stops appearing upstream leaves its
//   shape kept and marked stale — and the result SAYS so, with the name.
//   Refusals are not failures: a feature that matches no project is listed.
//
//   SUBSCRIBING IS NOT A TRAP. "Take over the shapes" keeps every footprint on
//   its project, editable here, and retires the subscription — a deliberate
//   exit, not a delete (decision 22).
//
//   JOIN ON WHAT MEANS "THIS PROJECT". GlobalID and OBJECTID identify SHAPES,
//   and a republished layer regenerates them — every project then reads as
//   abandoned at once. The join picker says so where the choice is made.
//
// EXTRA FIELDS ARE A PICK-LIST, NEVER "BRING EVERYTHING", and the ArcGIS
// plumbing (OBJECTID, GlobalID, Shape__Area) is not offered at all. A field
// already nominated that the current layer no longer carries stays listed,
// marked, so a schema change upstream never silently drops a nomination.
//
// The editor is a side sheet with five steps in the order the decisions fall:
// access decides what the rest of the form even is. Adding is an act, so it
// has a button; editing an existing subscription saves as it happens.
//
// bcn-lego-checked: legos throughout — esa-card, esa-button, esa-badge,
// esa-alert-box, esa-empty-state, esa-side-dialog, esa-radio-group,
// esa-select, esa-text-field, esa-switch-toggle, esa-confirm-dialog. The
// schema table and the mapped-field rows are plain markup in the
// firma2-settings-table style; no lego is a data table. Beacon's BCN-1599
// (choose from what is shared to your group) is the precedent for step 2;
// Beacon is not cloned here.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import { ARCGIS_GROUP, MAPPABLE_PROJECT_FIELDS, SHARED_LAYERS, SYNC_RESULT } from '../../data/firma2-geography';
import { projects, STAGE_ORDER } from '../../data/firma2-projects';
import { withBase } from '../../lib/base';

const config = {
  layers: SHARED_LAYERS,
  group: ARCGIS_GROUP,
  mappable: MAPPABLE_PROJECT_FIELDS,
  programs: [...new Set(projects.map((p) => p.program))].sort(),
  stages: STAGE_ORDER,
  sync: SYNC_RESULT,
};
const sourceHref = withBase('/prototypes/workspace-settings/project-source');
---
<div class="firma2-gis-subs stack" data-gap="xl" data-config={JSON.stringify(config)}>
  <!-- WHERE THE SWITCH IS. Subscribed mode is set on a different screen, so a
       reader whose administrator changes it would otherwise find this page
       changed with nothing saying why. -->
  <p class="typography-body-md" data-mode-note>
    This workspace gets its projects from these subscriptions. That is set in <a href={sourceHref}>Workspace settings › Project source</a>, which is also where you would leave it.
  </p>

  <div data-off hidden>
    <EsaEmptyState
      title="This workspace creates its projects here"
      description="Subscriptions keep projects current from a GIS your organization already maintains. Switching to them changes how every project gets its shapes, so it is set in Workspace settings › Project source."
    />
    <div class="firma2-gis-subs__center">
      <EsaButton variant="secondary" size="md" tag="a" href={sourceHref}>Open Project source</EsaButton>
    </div>
  </div>

  <div class="stack" data-gap="lg" data-list></div>

  <div data-none hidden>
    <EsaEmptyState title="No subscriptions yet" description="Add one to keep project footprints current from your own GIS." />
  </div>

  <!-- ---- clone sources ---------------------------------------------------- -->
  <template data-tpl-card>
    <EsaCard title="Subscription" subtitle="url">
      <div class="stack" data-gap="lg">
        <!-- A ROW OF ITS OWN, not the card header: four actions in a header
             beside a long URL stacked into a column. The everyday two lead;
             the exit and the delete keep the far side. -->
        <div class="repel" data-card-actions>
          <span class="cluster" data-gap="xs">
            <span data-sync-wrap><EsaButton variant="primary" size="sm" icon="rotate-ccw" data-sync>Sync now</EsaButton></span>
            <EsaButton variant="secondary" appearance="outline" size="sm" data-edit>Edit</EsaButton>
          </span>
          <span class="cluster" data-gap="xs">
            <EsaButton variant="ghost" size="sm" data-retire>Take over the shapes and retire</EsaButton>
            <span data-delete-wrap><EsaButton variant="danger" appearance="soft" size="sm" data-delete>Delete</EsaButton></span>
          </span>
        </div>
        <dl class="firma2-gis-subs__meta" data-meta></dl>
        <dl class="firma2-gis-subs__meta firma2-gis-subs__meta--run" data-run></dl>
        <div data-result-slot></div>
      </div>
    </EsaCard>
  </template>
  <template data-tpl-success>
    <EsaAlertBox variant="success" title="Sync complete"><div class="stack" data-gap="2xs" data-lines></div></EsaAlertBox>
  </template>
  <template data-tpl-badge-geometry><EsaBadge variant="info" size="sm" value="Polygon" /></template>
  <template data-tpl-badge-role><EsaBadge variant="secondary" size="xs" value="role" /></template>
  <template data-tpl-remove><EsaButton variant="ghost" size="sm" iconOnly icon="x" aria-label="Remove">Remove</EsaButton></template>

  <!-- ---- the editor --------------------------------------------------------- -->
  <esa-side-dialog class="firma2-gis-subs__sheet" heading="Add subscription" size="lg" position="right">
    <div class="stack" data-gap="2xl">
      <section class="stack" data-gap="md">
        <h4 class="typography-label-md-strong firma2-gis-subs__step"><span class="firma2-gis-subs__num">1</span> Access</h4>
        <esa-radio-group data-access label="How ProjectFirma reaches this service"></esa-radio-group>
        <p class="typography-body-sm" data-access-help></p>
      </section>

      <section class="stack" data-gap="md">
        <h4 class="typography-label-md-strong firma2-gis-subs__step"><span class="firma2-gis-subs__num">2</span> Layer</h4>
        <esa-select data-layer label="Shared layer" placeholder="Choose a layer shared to your group" size="md"></esa-select>
        <esa-text-field data-url label="Feature service URL" size="md" placeholder="https://services.arcgis.com/…/FeatureServer/0"></esa-text-field>
        <div class="cluster" data-gap="sm" data-read-wrap hidden>
          <EsaButton variant="secondary" size="sm" data-read>Read the layer</EsaButton>
        </div>
        <div class="stack" data-gap="sm" data-schema hidden>
          <div class="cluster" data-gap="sm">
            <span class="typography-title-strong" data-schema-name></span>
            <span data-schema-geometry></span>
            <span class="typography-body-sm firma2-gis-subs__muted" data-schema-count></span>
          </div>
          <div class="firma2-gis-subs__scroll">
            <table class="firma2-gis-subs__table">
              <thead><tr><th scope="col">Field</th><th scope="col">Type</th></tr></thead>
              <tbody data-schema-rows></tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="stack" data-gap="md">
        <h4 class="typography-label-md-strong firma2-gis-subs__step"><span class="firma2-gis-subs__num">3</span> Matching</h4>
        <p class="typography-body-sm firma2-gis-subs__muted" data-locked>Choose a layer above and its fields are listed here.</p>
        <div class="stack" data-gap="md" data-unlocked>
          <esa-select data-join label="Match projects on" size="md"></esa-select>
          <esa-select data-feature-id label="Tell shapes apart by" size="md"></esa-select>
          <esa-select data-label-field label="Call each shape" size="md"></esa-select>
          <esa-select data-extra label="Extra fields to bring across" multiple chip-mode placeholder="None — only the fields above are read" size="md"></esa-select>
        </div>
      </section>

      <section class="stack" data-gap="md">
        <h4 class="typography-label-md-strong firma2-gis-subs__step"><span class="firma2-gis-subs__num">4</span> Project fields from this layer</h4>
        <p class="typography-body-sm">A sync <strong>creates the projects this layer describes</strong>. A project field mapped to a layer field is <strong>kept by the layer on every sync</strong>: read-only on the project, and changed in your GIS.</p>
        <div class="stack" data-gap="md" data-unlocked>
          <esa-select data-name-field label="Project name from" size="md"></esa-select>
          <div class="firma2-gis-subs__pair">
            <esa-select data-default-program label="Program, when not mapped" size="md"></esa-select>
            <esa-select data-default-stage label="Stage, when not mapped" size="md"></esa-select>
          </div>
          <esa-text-field data-default-lead label="Lead organization, when not mapped" size="md" placeholder="Leave blank to require one in the layer"></esa-text-field>
          <div class="stack" data-gap="sm">
            <span class="typography-label-md">Mapped project fields</span>
            <ul class="firma2-gis-subs__mappings stack" data-gap="sm" data-mappings></ul>
            <p class="typography-body-sm firma2-gis-subs__muted" data-no-mappings>None. County, years and cost are left empty on a created project and edited on the project.</p>
            <esa-select data-add-mapping label="Map another project field" placeholder="Choose a project field" size="md"></esa-select>
            <p class="typography-body-sm firma2-gis-subs__muted">Program and stage are matched to yours by name. A value that matches none keeps the default, and the sync result lists it.</p>
          </div>
        </div>
      </section>

      <section class="stack" data-gap="md">
        <h4 class="typography-label-md-strong firma2-gis-subs__step"><span class="firma2-gis-subs__num">5</span> This subscription</h4>
        <esa-text-field data-name label="Name" size="md" placeholder="Enterprise project boundaries"></esa-text-field>
        <esa-switch-toggle data-active label="Active — included in syncs"></esa-switch-toggle>
      </section>
    </div>
    <div slot="footer" class="cluster" data-gap="xs">
      <span data-add-wrap><EsaButton variant="primary" size="md" data-add>Add subscription</EsaButton></span>
      <span data-done-wrap hidden><EsaButton variant="secondary" size="md" data-done>Done</EsaButton></span>
      <span data-cancel-wrap><EsaButton variant="ghost" size="md" data-cancel>Cancel</EsaButton></span>
    </div>
  </esa-side-dialog>

  <esa-confirm-dialog
    class="firma2-gis-subs__retire"
    heading="Take over the shapes and retire this subscription?"
    confirm-label="Take over the shapes"
    cancel-label="Keep subscribing"
  ></esa-confirm-dialog>
</div>

<style>
  .firma2-gis-subs [hidden] {
    display: none !important;
  }

  .firma2-gis-subs__center {
    display: flex;
    justify-content: center;
  }

  .firma2-gis-subs__muted {
    color: var(--color-text-secondary);
  }

  .firma2-gis-subs__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--spacing-400) var(--spacing-600);
    margin: 0;
  }

  /* The last run's message is the most useful thing on the card, so it gets
     its own row and WRAPS — team 2 lost an evening to it being truncated. */
  .firma2-gis-subs__meta--run {
    grid-template-columns: minmax(12rem, auto) 1fr;
    padding-block-start: var(--spacing-400);
    border-block-start: 1px solid var(--color-border-default);
  }

  .firma2-gis-subs :global(.firma2-gis-subs__meta dt) {
    color: var(--color-text-secondary);
  }

  .firma2-gis-subs :global(.firma2-gis-subs__meta dd) {
    margin: var(--spacing-100) 0 0;
  }

  .firma2-gis-subs :global(code) {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.9em;
  }

  .firma2-gis-subs__step {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    margin: 0;
  }

  .firma2-gis-subs__num {
    display: inline-grid;
    place-items: center;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: 50%;
    background: var(--color-background-brand-subtle, #e9f6e9);
    color: var(--color-content-brand, #2a7e3b);
  }

  .firma2-gis-subs__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-400);
  }

  /* A layer with sixty fields would push the sheet's footer away. */
  .firma2-gis-subs__scroll {
    max-block-size: 16rem;
    overflow-y: auto;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm, 0.25rem);
  }

  .firma2-gis-subs__table {
    width: 100%;
    border-collapse: collapse;
  }

  .firma2-gis-subs__table th,
  .firma2-gis-subs__table :global(td) {
    padding: var(--spacing-200) var(--spacing-300);
    border-block-end: 1px solid var(--color-border-default);
    text-align: start;
    font-weight: normal;
    vertical-align: middle;
  }

  .firma2-gis-subs__table thead th {
    position: sticky;
    top: 0;
    background: var(--color-background-elevation-raised, #fcfcfc);
    color: var(--color-text-secondary);
  }

  .firma2-gis-subs :global(.firma2-gis-subs__field) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-200);
  }

  .firma2-gis-subs__mappings {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .firma2-gis-subs :global(.firma2-gis-subs__mapping) {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--spacing-200);
  }
</style>

<script>
  import '@esa/ecology/esa-side-dialog';
  import '@esa/ecology/esa-radio-group';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-switch-toggle';
  import '@esa/ecology/esa-confirm-dialog';
  import type { SharedLayer, Subscription } from '../../data/firma2-geography';
  import { fixSideDialog } from '../../lib/side-dialog-fix';
  import { onGeoChange, readProjectSource, readSubscriptions, writeSubscriptions } from '../../lib/work-areas';

  type Control = HTMLElement & { value?: unknown; options?: unknown; errorText?: string; helpText?: string; checked?: boolean; disabled?: boolean; heading?: string; message?: string };
  type Sheet = HTMLElement & { show: () => void; close: () => void; heading?: string };

  interface Config {
    layers: SharedLayer[];
    group: { id: string; title: string };
    mappable: { value: string; label: string }[];
    programs: string[];
    stages: string[];
    sync: { added: number; updated: number; stale: string[]; projectsUpdated: number; unmatched: string[]; skippedWithoutJoin: number };
  }

  const PLUMBING = ['OID', 'GlobalID'];
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const dateText = (iso: string | null) =>
    iso ? new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : 'Never';

  document.querySelectorAll<HTMLElement>('.firma2-gis-subs').forEach((root) => {
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const config: Config = JSON.parse(root.dataset.config ?? '{}');
    const clone = (name: string) => ($<HTMLTemplateElement>(`[data-tpl-${name}]`).content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
    const results = new Map<string, HTMLElement>();
    let syncing: string | null = null;

    const layerById = (id: string) => config.layers.find((l) => l.id === id);
    const save = (next: Subscription[]) => writeSubscriptions(next);

    // ---- the list --------------------------------------------------------------
    const paint = () => {
      const subscribed = readProjectSource() === 'subscribed';
      const subs = readSubscriptions();
      $('[data-off]').hidden = subscribed;
      $('[data-mode-note]').hidden = !subscribed;
      $('[data-none]').hidden = !subscribed || subs.length > 0;
      document.querySelectorAll<HTMLElement>('[data-add-subscription]').forEach((el) => (el.hidden = !subscribed));
      const list = $('[data-list]');
      if (!subscribed) return list.replaceChildren();

      list.replaceChildren(
        ...subs.map((sub) => {
          const card = clone('card');
          card.querySelector('.esa-card__title')!.textContent = sub.active ? sub.name : `${sub.name} (inactive)`;
          card.querySelector('.esa-card__subtitle')!.textContent = sub.url;
          const layer = layerById(sub.layerId);
          const meta: [string, string][] = [
            // WHOSE FIELD IS WHOSE: the left one is in their layer, the right one is ours.
            ['Matched on', `<code>${esc(sub.joinField)}</code> in your layer → the external ID on a project`],
            ['Access', sub.access === 'arcgis' ? `Shared with the ProjectFirma account, through ${esc(config.group.title)}` : 'A public service'],
            ['Keeps current', `${sub.projectCount} projects, ${sub.workAreaCount} work areas`],
            ['Brings across', sub.extraFields.length ? sub.extraFields.map((f) => `<code>${esc(f)}</code>`).join(', ') : 'Shapes only'],
            ['Layer', layer ? `${esc(layer.name)} (${layer.geometry.toLowerCase()}s)` : 'A public service'],
          ];
          card.querySelector('[data-meta]')!.innerHTML = meta.map(([dt, dd]) => `<div><dt class="typography-body-sm">${dt}</dt><dd class="typography-body-md">${dd}</dd></div>`).join('');
          card.querySelector('[data-run]')!.innerHTML = `
            <div><dt class="typography-body-sm">Last successful sync</dt><dd class="typography-body-md">${dateText(sub.lastSuccess)}</dd></div>
            <div><dt class="typography-body-sm">Last run</dt><dd class="typography-body-md">${esc(sub.lastMessage ?? 'Not yet run')}</dd></div>`;

          const syncWrap = card.querySelector<HTMLElement>('[data-sync-wrap]')!;
          syncWrap.classList.toggle('esa-button--disabled', !sub.active || syncing === sub.id);
          syncWrap.title = sub.active ? '' : 'Inactive subscriptions are not synced.';
          const syncLabel = syncWrap.querySelector('.esa-button__label');
          if (syncLabel) syncLabel.textContent = syncing === sub.id ? 'Syncing…' : 'Sync now';
          card.querySelector('[data-sync]')!.addEventListener('click', () => sync(sub.id));
          card.querySelector('[data-edit]')!.addEventListener('click', () => openEditor(sub.id));
          card.querySelector('[data-retire]')!.addEventListener('click', () => askRetire(sub));
          // Delete only when it keeps nothing current: deleting one that does
          // would leave its shapes with no owner, and "Take over" is that act done right.
          card.querySelector<HTMLElement>('[data-delete-wrap]')!.hidden = sub.workAreaCount > 0;
          card.querySelector('[data-delete]')!.addEventListener('click', () => save(readSubscriptions().filter((s) => s.id !== sub.id)));
          const result = results.get(sub.id);
          if (result) card.querySelector('[data-result-slot]')!.append(result);
          return card;
        }),
      );
    };

    // ---- sync: scripted, and what a real one would say -----------------------------
    const sync = (id: string) => {
      const sub = readSubscriptions().find((s) => s.id === id);
      if (!sub?.active || syncing) return;
      syncing = id;
      results.delete(id);
      paint();
      window.setTimeout(() => {
        const r = config.sync;
        const alert = clone('success');
        const lines = [
          `${r.added} added, ${r.updated} updated. ${r.projectsUpdated} projects had a mapped field change.`,
          ...r.stale.map((name) => `“${name}” is no longer upstream. It was kept and marked stale, never deleted.`),
          r.skippedWithoutJoin ? `${r.skippedWithoutJoin} feature skipped: nothing in ${sub.joinField} to match a project on.` : '',
          r.unmatched.length ? `Matched no project: ${r.unmatched.join(', ')}. Add the project, or correct ${sub.joinField} in your layer.` : '',
          sub.extraFields.length ? `${sub.extraFields.join(' and ')} updated on every matched project.` : '',
        ].filter(Boolean);
        alert.querySelector('[data-lines]')!.innerHTML = lines.map((l) => `<p class="typography-body-sm">${esc(l)}</p>`).join('');
        results.set(id, alert);
        syncing = null;
        save(
          readSubscriptions().map((s) =>
            s.id === id
              ? {
                  ...s,
                  lastSuccess: new Date().toISOString(),
                  lastMessage: `Matched ${s.projectCount} of ${s.projectCount + 1} features on ${s.joinField}. ${r.stale.length} no longer upstream, kept. 1 matched no project: ${r.unmatched.join(', ')}.`,
                  staleLabels: r.stale,
                }
              : s,
          ),
        );
      }, 1200);
    };

    // ---- the exit that keeps the shapes ------------------------------------------
    const retire = $<Control & { show: () => void }>('.firma2-gis-subs__retire');
    let retiring: Subscription | null = null;
    const askRetire = (sub: Subscription) => {
      retiring = sub;
      retire.message = `The ${sub.workAreaCount} work areas it keeps current stay on their ${sub.projectCount} projects and become editable in ProjectFirma. Nothing is read from this layer again. To follow the layer later, add a new subscription.`;
      retire.show();
    };
    retire.addEventListener('resolved', (e) => {
      const { confirmed } = (e as CustomEvent<{ confirmed: boolean }>).detail;
      if (confirmed && retiring) save(readSubscriptions().filter((s) => s.id !== retiring!.id));
      retiring = null;
    });

    // ---- the editor --------------------------------------------------------------
    const sheet = $<Sheet>('.firma2-gis-subs__sheet');
    void fixSideDialog(sheet);
    const f = {
      access: $<Control>('[data-access]'),
      layer: $<Control>('[data-layer]'),
      url: $<Control>('[data-url]'),
      join: $<Control>('[data-join]'),
      featureId: $<Control>('[data-feature-id]'),
      label: $<Control>('[data-label-field]'),
      extra: $<Control>('[data-extra]'),
      nameField: $<Control>('[data-name-field]'),
      program: $<Control>('[data-default-program]'),
      stage: $<Control>('[data-default-stage]'),
      lead: $<Control>('[data-default-lead]'),
      addMapping: $<Control>('[data-add-mapping]'),
      name: $<Control>('[data-name]'),
      active: $<Control>('[data-active]'),
    };

    let draft: Subscription;
    let editingId: string | null = null;

    const blank = (): Subscription => ({
      id: `sub-${Date.now().toString(36)}`,
      name: '',
      access: 'arcgis',
      layerId: '',
      url: '',
      joinField: '',
      featureIdField: '',
      labelField: '',
      extraFields: [],
      nameField: '',
      defaultLead: '',
      defaultProgram: config.programs[0],
      defaultStage: 'Planning & Design',
      mappings: [],
      active: true,
      projectCount: 0,
      workAreaCount: 0,
      lastSuccess: null,
      lastMessage: null,
    });

    /** Edits to an existing subscription save as they happen. */
    const commit = () => {
      if (!editingId) return;
      save(readSubscriptions().map((s) => (s.id === editingId ? draft : s)));
    };

    const fieldOptions = (layer: SharedLayer | undefined, includePlumbing = true) =>
      (layer?.fields ?? [])
        .filter((field) => includePlumbing || !PLUMBING.includes(field.type) && !field.name.startsWith('Shape__'))
        .map((field) => ({ value: field.name, label: field.alias ? `${field.name} — ${field.alias}` : field.name }));

    const paintSchema = () => {
      const layer = layerById(draft.layerId);
      $('[data-schema]').hidden = !layer;
      root.querySelectorAll<HTMLElement>('[data-unlocked]').forEach((el) => (el.hidden = !layer));
      $('[data-locked]').hidden = Boolean(layer);
      if (!layer) return;
      $('[data-schema-name]').textContent = layer.name;
      const geometry = clone('badge-geometry');
      geometry.querySelector('.esa-badge__text')!.textContent = layer.geometry;
      $('[data-schema-geometry]').replaceChildren(geometry);
      $('[data-schema-count]').textContent = `${layer.fields.length} fields`;
      $('[data-schema-rows]').replaceChildren(
        ...layer.fields.map((field) => {
          const tr = document.createElement('tr');
          const roles = [
            field.name === layer.globalIdField && 'global ID',
            field.name === layer.objectIdField && 'object ID',
            field.name === layer.displayField && 'display',
          ].filter(Boolean) as string[];
          const cell = document.createElement('td');
          cell.innerHTML = `<span class="firma2-gis-subs__field typography-body-sm"><code>${esc(field.name)}</code>${field.alias && field.alias !== field.name ? `<span class="firma2-gis-subs__muted">${esc(field.alias)}</span>` : ''}</span>`;
          roles.forEach((role) => {
            const badge = clone('badge-role');
            badge.querySelector('.esa-badge__text')!.textContent = role;
            cell.firstElementChild!.append(badge);
          });
          const type = document.createElement('td');
          type.className = 'typography-body-sm';
          type.textContent = field.type;
          tr.append(cell, type);
          return tr;
        }),
      );

      // Three of the four pickers offer every field; the extra-fields list
      // offers none of the plumbing, plus anything already nominated that
      // this layer no longer carries — marked, so it is never dropped silently.
      const all = fieldOptions(layer);
      f.join.options = all;
      f.featureId.options = all;
      f.label.options = all;
      f.nameField.options = [{ value: '', label: 'The external ID (no name field)' }, ...all];
      const extras = fieldOptions(layer, false);
      const missing = draft.extraFields.filter((name) => !layer.fields.some((x) => x.name === name)).map((name) => ({ value: name, label: `${name} — not in this layer` }));
      f.extra.options = [...extras, ...missing];
      f.join.value = draft.joinField;
      f.featureId.value = draft.featureIdField;
      f.label.value = draft.labelField;
      f.nameField.value = draft.nameField;
      f.extra.value = [...draft.extraFields];
      const shapeId = [layer.globalIdField, layer.objectIdField].includes(draft.joinField);
      f.join.helpText = shapeId
        ? `${draft.joinField} identifies a shape, not a project. Republishing the layer regenerates it, and every project would read as abandoned at once. Choose the field that means “this project”: a project number or grant ID.`
        : 'Matched against each project’s external ID. Only you know which field carries it.';
      f.join.errorText = '';
      f.featureId.helpText = 'Only matters when one project has several shapes.';
      f.label.helpText = 'What each shape is called on the map.';
      paintMappings();
    };

    const paintMappings = () => {
      const layer = layerById(draft.layerId);
      const list = $('[data-mappings]');
      list.replaceChildren(
        ...draft.mappings.map((m) => {
          const li = document.createElement('li');
          li.className = 'firma2-gis-subs__mapping';
          const select = document.createElement('esa-select') as Control;
          select.setAttribute('size', 'md');
          select.setAttribute('label', config.mappable.find((x) => x.value === m.projectField)?.label ?? m.projectField);
          customElements.whenDefined('esa-select').then(() => {
            select.options = fieldOptions(layer);
            select.value = m.layerField;
          });
          select.addEventListener('change', () => {
            draft = { ...draft, mappings: draft.mappings.map((x) => (x.projectField === m.projectField ? { ...x, layerField: String(select.value ?? '') } : x)) };
            commit();
          });
          const remove = clone('remove');
          remove.setAttribute('aria-label', `Stop mapping ${select.getAttribute('label')}`);
          remove.addEventListener('click', () => {
            draft = { ...draft, mappings: draft.mappings.filter((x) => x.projectField !== m.projectField) };
            commit();
            paintMappings();
          });
          li.append(select, remove);
          return li;
        }),
      );
      $('[data-no-mappings]').hidden = draft.mappings.length > 0;
      const addable = config.mappable.filter((x) => !draft.mappings.some((m) => m.projectField === x.value));
      f.addMapping.hidden = addable.length === 0;
      f.addMapping.options = addable;
      f.addMapping.value = '';
    };

    const paintAccess = () => {
      const arcgis = draft.access === 'arcgis';
      f.layer.hidden = !arcgis;
      $('[data-read-wrap]').hidden = arcgis;
      $('[data-access-help]').textContent = arcgis
        ? `No credentials. Your organization adds the ProjectFirma ArcGIS account to ${config.group.title} and shares feature services into it; nothing is stored here and there is no password to rotate.`
        : 'A service anyone can read without signing in. It must return GeoJSON — for ArcGIS, the query URL with f=geojson.';
      f.url.helpText = arcgis ? 'Filled in from the layer you choose.' : '';
      f.url.disabled = arcgis;
    };

    const fill = () => {
      f.access.value = draft.access;
      f.layer.value = draft.layerId;
      f.url.value = draft.url;
      f.program.value = draft.defaultProgram;
      f.stage.value = draft.defaultStage;
      f.lead.value = draft.defaultLead;
      f.name.value = draft.name;
      f.name.errorText = '';
      f.url.errorText = '';
      f.active.checked = draft.active;
      paintAccess();
      paintSchema();
    };

    const openEditor = (id: string | null) => {
      editingId = id;
      draft = id ? { ...readSubscriptions().find((s) => s.id === id)! } : blank();
      sheet.heading = id ? 'Edit subscription' : 'Add subscription';
      $('[data-add-wrap]').hidden = Boolean(id);
      $('[data-cancel-wrap]').hidden = Boolean(id);
      $('[data-done-wrap]').hidden = !id;
      void Promise.all(['esa-select', 'esa-radio-group', 'esa-text-field', 'esa-switch-toggle'].map((t) => customElements.whenDefined(t))).then(() => {
        fill();
        sheet.show();
      });
    };

    void Promise.all(['esa-select', 'esa-radio-group'].map((t) => customElements.whenDefined(t))).then(() => {
      f.access.options = [
        { value: 'arcgis', label: 'Shared with the ProjectFirma ArcGIS account' },
        { value: 'public', label: 'A public service' },
      ];
      f.layer.options = config.layers.map((l) => ({ value: l.id, label: `${l.name} — ${l.geometry.toLowerCase()}s` }));
      f.program.options = config.programs.map((p) => ({ value: p, label: p }));
      f.stage.options = config.stages.map((s) => ({ value: s, label: s }));
    });

    // Choosing a layer fills in the URL, the name, and the defaults ArcGIS
    // already knows — the feature ID from the GlobalID, the label from the
    // display field. The join is NOT guessed: only the tenant knows it.
    f.access.addEventListener('change', () => {
      draft = { ...draft, access: String(f.access.value ?? 'arcgis') as 'arcgis' | 'public' };
      commit();
      paintAccess();
    });
    f.layer.addEventListener('change', () => {
      const layer = layerById(String(f.layer.value ?? ''));
      if (!layer) return;
      draft = {
        ...draft,
        layerId: layer.id,
        url: layer.url,
        name: draft.name || layer.name,
        featureIdField: layer.globalIdField,
        labelField: layer.displayField,
        joinField: layer.fields.some((x) => x.name === draft.joinField) ? draft.joinField : '',
      };
      f.url.value = draft.url;
      f.name.value = draft.name;
      commit();
      paintSchema();
    });
    f.url.addEventListener('change', () => {
      draft = { ...draft, url: String(f.url.value ?? '').trim() };
      commit();
    });
    $('[data-read]').addEventListener('click', () => {
      if (!String(f.url.value ?? '').trim()) {
        f.url.errorText = 'Paste the service’s query URL first.';
        return;
      }
      f.url.errorText = '';
      draft = { ...draft, layerId: config.layers[0].id, featureIdField: config.layers[0].globalIdField, labelField: config.layers[0].displayField };
      commit();
      paintSchema();
    });
    const bind = (control: Control, key: keyof Subscription, after?: () => void) =>
      control.addEventListener('change', () => {
        draft = { ...draft, [key]: control === f.active ? Boolean(control.checked) : Array.isArray(control.value) ? [...control.value] : String(control.value ?? '') };
        commit();
        after?.();
      });
    bind(f.join, 'joinField', paintSchema);
    bind(f.featureId, 'featureIdField');
    bind(f.label, 'labelField');
    bind(f.extra, 'extraFields');
    bind(f.nameField, 'nameField');
    bind(f.program, 'defaultProgram');
    bind(f.stage, 'defaultStage');
    bind(f.lead, 'defaultLead');
    bind(f.name, 'name');
    bind(f.active, 'active');
    f.addMapping.addEventListener('change', () => {
      const field = String(f.addMapping.value ?? '');
      if (!field || draft.mappings.some((m) => m.projectField === field)) return;
      draft = { ...draft, mappings: [...draft.mappings, { projectField: field, layerField: '' }] };
      commit();
      paintMappings();
    });

    $('[data-add]').addEventListener('click', () => {
      f.name.errorText = draft.name.trim() ? '' : 'Name it the way your team will.';
      f.url.errorText = draft.url ? '' : draft.access === 'arcgis' ? 'Choose a shared layer.' : 'Paste the service’s query URL.';
      f.join.errorText = draft.joinField ? '' : 'Choose the field that says which project a shape belongs to.';
      if (f.name.errorText || f.url.errorText || (draft.layerId && f.join.errorText)) return;
      save([...readSubscriptions(), draft]);
      sheet.close();
    });
    $('[data-done]').addEventListener('click', () => sheet.close());
    $('[data-cancel]').addEventListener('click', () => sheet.close());
    // The page header owns the Add button; it is wired here, where the editor is.
    document.querySelectorAll('[data-add-subscription]').forEach((b) => b.addEventListener('click', () => openEditor(null)));

    onGeoChange(paint);
    paint();
  });
</script>
