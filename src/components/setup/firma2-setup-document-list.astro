---
// firma2-setup-document-list — the documents setup has read, one row each:
// the file's name, what kind of file it is and how much of it there was, and
// a status mark saying it has been read.
//
// bcn-lego-checked: esa-file-list is the lego for a list of existing files, and
// it was used here first; its EsaFile carries a name and an href only, with a
// fixed icon | name | actions row, so it has no place for a second line (kind
// and page count) or a status mark, which is what this list exists to show.
// esa-file-upload renders rows only for File objects it collected itself, and
// the sample path never hands it any. Checked Beacon (simple-file-display is
// the same name-only row esa-file-list ports). So the row is composed here from
// legos: esa-card (outlined, no padding) is the surface, esa-icon the glyph,
// esa-badge the status. The bespoke part is the row grid, the hairline between
// rows and the tinted glyph square, which no lego owns.
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import type { DocumentKind, TenantDocument } from '../../data/firma2-setup';

interface Props {
  documents: TenantDocument[];
}

const { documents } = Astro.props;

const KIND_LABEL: Record<DocumentKind, string> = {
  pdf: 'PDF',
  xlsx: 'Excel spreadsheet',
  docx: 'Word document',
};

/** "PDF, 28 pages" when the page count is known; the file size otherwise. */
const detailFor = (doc: TenantDocument): string => {
  const kind = KIND_LABEL[doc.kind];
  if (doc.pages) return `${kind}, ${doc.pages} pages`;
  const kb = doc.size / 1000;
  const size = kb >= 1000 ? `${(kb / 1000).toFixed(1)} MB` : `${Math.round(kb)} KB`;
  return `${kind}, ${size}`;
};
---
<EsaCard variant="outlined" padding="none">
  <ul class="firma2-setup-document-list">
    {documents.map((doc) => (
      <li class="firma2-setup-document-list__row">
        <span class="firma2-setup-document-list__glyph"><EsaIcon name="file-text" size="md" /></span>
        <span class="firma2-setup-document-list__text">
          <span class="typography-label-md-strong firma2-setup-document-list__name" title={doc.name}>{doc.name}</span>
          <span class="typography-body-md firma2-setup-document-list__detail">{detailFor(doc)}</span>
        </span>
        <EsaBadge value="Read" variant="success" size="sm" />
      </li>
    ))}
  </ul>
</EsaCard>

<style>
  .firma2-setup-document-list {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: start;
  }
  .firma2-setup-document-list__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--spacing-300);
    padding-block: var(--spacing-300);
    padding-inline: var(--spacing-400);
  }
  .firma2-setup-document-list__row + .firma2-setup-document-list__row {
    border-block-start: var(--border-width-default) solid var(--color-border-default);
  }
  /* The milestone's hue: the same brand-muted plate and brand glyph the screen's
     icon circle wears, at row scale. */
  .firma2-setup-document-list__glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--color-background-brand-muted);
    color: var(--color-content-brand);
  }
  .firma2-setup-document-list__text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050);
    min-inline-size: 0;
  }
  .firma2-setup-document-list__name {
    overflow-x: clip;
    overflow-y: visible;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-content-default);
  }
  .firma2-setup-document-list__detail {
    color: var(--color-content-default-secondary);
  }
</style>
