---
// The start flow: context and intent, one screen at a time.
//
// Screen 1 takes the documents the tenant already has. Screens 2 to 7 each ask
// one question with two to four label-only pills: only the questions Start asks
// (intentQuestionsFor('documents')), what the program does. The rules it runs by
//
// GUIDANCE UNDER THE HEADLINE, NO GUIDE COLUMN, 2026-09-24. Each Start screen
// used to show its guide (title, body, examples, the milestones it sets up) in a
// sticky 17rem column to the right, which made Start the one walk whose screen
// column was narrower than the rest and put the context beside the question
// instead of under it. Andy moved Documents' guide under the headline, then
// asked for the same on every step. Now the guide's body is the screen's lede
// and its examples are one row of badges (firma2-setup-guide-row) between the
// heading and the choices; the "Sets up" milestone list is gone, the hub shows
// the same thing as suggested cards a screen later. Start's layout is the
// stepper's: rail, then screens, nothing nested.
// are Program shape's. The last screen reads the answers back as one sentence
// and hands off to the hub, where the map lights for the first time. The
// eight screens are listed in the rail every stepped milestone wears
// (firma2-setup-step-rail; Andy, 2026-09-24: "For each milestone, you should
// see the steps you're completing, and be able to traverse backwards (and
// forwards?) easily"), which replaced the back arrow and the circular Next.
// The rail sits left, the screens centre, the guide stays right: the sidebar
// primitive twice, rail around the existing screen-and-guide pair. The
// documents screen carries its guide in the screen itself, under the prompt
// (Andy, 2026-09-24), so the guide column is empty on that screen and holds its
// width, keeping the screen column where it sits on every other screen. Start keeps
// its own script because its readiness is the intent answers, not a screen
// attribute; it writes that readiness onto each screen as `data-step-ready`
// so the rail reads it the same way it does on the shared stepper, and it
// handles the rail's `[data-step-go]` rows itself. Every screen has a URL (?step=<id>) so it
// can be resumed, and the setup bar's "Finish later" returns to the hub with
// the answers so far kept. The milestone's own band (emblem and the word
// Start) is the layout's, above this, on every screen; the prompts are h2s
// under it.
//
// Where a question's choices cannot be exhaustive it also carries an ask field:
// what is typed there becomes one more chip in the same group, already chosen,
// so there is never a second kind of answer on the screen.
//
// bcn-lego-checked: no esa-* stepper or wizard exists (ls of the catalog:
// esa-progress-bar is the only progress lego and it is linear, not stepped);
// checked Beacon (no ui-stepper). Each screen is composed from legos:
// esa-chip-group for the pills (brand tone, its selected roles re-pointed to a
// solid fill), esa-text-field + esa-button for the ask row, firma2-setup-step-next for
// Next, esa-card for the confirm card, firma2-setup-document-upload for the
// first screen, esa-icon in a tinted circle above each prompt,
// firma2-setup-hex-map as the illustration on the last screen. The bespoke part
// is the screen switching, the centred stack and the icon circle, which no lego
// owns; the ask row is the .cluster primitive inside the same centring wrapper
// the chips already use, so it lands in their column rather than the page's.
//
// Setup is allowed to be louder than the app: display-size prompts and a
// brand-tinted icon per screen, where the app's own pages stay at heading-lg.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import Firma2SetupGuideRow from './firma2-setup-guide-row.astro';
import Firma2SetupDocumentUpload from './firma2-setup-document-upload.astro';
import Firma2SetupStepNext from './firma2-setup-step-next.astro';
import Firma2SetupStepRail from './firma2-setup-step-rail.astro';
import { intentQuestionsFor, stepGuides } from '../../data/firma2-setup';
import { withBase } from '../../lib/base';
import { labelFromId, nextLabel } from '../../lib/setup-steps';
import type { SetupStep } from '../../lib/setup-steps';
// The screen chrome (icon plate, prompt, advance block) is shared with every
// stepped milestone; the rules below are only what Start adds on top of it.
import '../shared/firma2-setup-steps.css';

const intentQuestions = intentQuestionsFor('documents');

// The rail's words for each screen. The questions' prompts are the data's;
// these short names are this walk's, so they live beside it. An id missing
// here (a question added to the data later) falls back to its sentence-cased id.
const RAIL_LABELS: Record<string, string> = {
  documents: 'Documents',
  work: 'Kind of work',
  goals: 'Goals',
  slices: 'Project groups',
  map: 'Map',
  reporters: 'Data entry',
  confirm: 'Review',
};
const steps: SetupStep[] = ['documents', ...intentQuestions.map((q) => q.id), 'confirm'].map((id) => ({
  id,
  label: RAIL_LABELS[id] ?? labelFromId(id),
}));
const stepIds = steps.map((step) => step.id);

/** "Next: <label>" for the screen after `id`. Start renders its own screens, so it writes this at build. */
const nextLabelFor = (id: string): string => {
  const next = steps[stepIds.indexOf(id) + 1];
  return next ? nextLabel(next) : 'Next';
};
const hubHref = withBase('/prototypes/setup');
---
<div
  class="firma2-setup-steps firma2-setup-steps--railed sidebar"
  data-setup-steps
  data-step-ids={stepIds.join(',')}
  data-step-current={stepIds[0]}
>
  <Firma2SetupStepRail steps={steps} />
  <div class="firma2-setup-steps__main">
  <section class="firma2-setup-steps__screen stack" data-gap="lg" data-step="documents">
    <span class="firma2-setup-steps__icon"><EsaIcon name="upload" size="xl" /></span>
    <div class="stack firma2-setup-steps__heading" data-gap="sm">
      <h2 class="typography-display-sm firma2-setup-steps__prompt">What do you have on hand?</h2>
      {/* The guide's body is the lede (2026-09-24): why documents matter, in one
          sentence under the question, so the card below is one row and the
          sample-documents button clears the sticky footer at 1280 by 800. */}
      <p class="typography-body-md firma2-setup-steps__lede">{stepGuides.documents.body}</p>
    </div>
    <Firma2SetupGuideRow guide={stepGuides.documents} />
    <Firma2SetupDocumentUpload />
    <div class="firma2-setup-steps__advance">
      <Firma2SetupStepNext label={nextLabelFor('documents')} />
      <EsaButton variant="ghost" size="lg" data-step-skip>Nothing yet</EsaButton>
    </div>
  </section>

  {intentQuestions.map((q) => (
    <section class="firma2-setup-steps__screen stack" data-gap="lg" data-step={q.id} hidden>
      <span class="firma2-setup-steps__icon"><EsaIcon name={q.icon} size="xl" /></span>
      <div class="stack firma2-setup-steps__heading" data-gap="sm">
        <h2 class="typography-display-sm firma2-setup-steps__prompt">{q.prompt}</h2>
        <p class="typography-body-md firma2-setup-steps__lede">{q.guide.body}</p>
      </div>
      {q.guide.examples && <Firma2SetupGuideRow guide={q.guide} />}
      <div class="firma2-setup-steps__choices">
        <esa-chip-group
          data-intent-question={q.id}
          label={q.prompt}
          name={`intent-${q.id}`}
          size="lg"
          {...(q.multiple ? { multiple: true } : {})}
          options={JSON.stringify(q.options.map((o) => ({ value: o.id, label: o.label, tone: 'brand' })))}
        ></esa-chip-group>
      </div>
      {q.ask && (
        <div class="firma2-setup-steps__ask">
          <div class="cluster" data-gap="sm">
            <esa-text-field
              data-ask-field
              data-ask-question={q.id}
              label={q.ask.label}
              placeholder={q.ask.placeholder}
              size="md"
            ></esa-text-field>
            <EsaButton variant="ai" data-ask-add data-ask-question={q.id}>Add</EsaButton>
          </div>
        </div>
      )}
      <div class="firma2-setup-steps__advance">
        <Firma2SetupStepNext label={nextLabelFor(q.id)} disabled />
      </div>
    </section>
  ))}

  <section class="firma2-setup-steps__screen stack" data-gap="lg" data-step="confirm" hidden>
    <span class="firma2-setup-steps__icon"><EsaIcon name="circle-check" size="xl" /></span>
    <div class="stack firma2-setup-steps__heading" data-gap="sm">
      <h2 class="typography-display-sm firma2-setup-steps__prompt">Does this look right?</h2>
      <p class="typography-body-md firma2-setup-steps__lede">{stepGuides.confirm.body}</p>
    </div>
    <EsaCard variant="outlined" padding="spacious">
      <div class="stack" data-gap="md">
        <p class="typography-body-lg firma2-setup-steps__summary" data-step-summary></p>
        <p class="typography-body-md" data-step-documents-line hidden></p>
        <div class="cluster" data-gap="sm">
          <EsaButton variant="secondary" size="sm" data-step-edit>Edit</EsaButton>
        </div>
      </div>
    </EsaCard>
    <div class="firma2-setup-steps__advance">
      <Firma2SetupStepNext href={hubHref} label="Go to setup" />
    </div>
  </section>

  <script type="application/json" data-step-questions set:html={JSON.stringify(intentQuestions.map((q) => ({ id: q.id, multiple: q.multiple })))}></script>
  </div>
</div>

<script>
  import '@esa/ecology/esa-chip-group';
  import '@esa/ecology/esa-text-field';
  import { composeIntentSummary, sampleDocuments } from '../../data/firma2-setup';
  import { addIntentOption, intentOptionsFor, readSetupDraft, setIntentAnswer } from '../../lib/setup-draft';

  interface Question {
    id: string;
    multiple: boolean;
  }

  /** The chip group's own option shape, restated here so the script owns no lego types. */
  interface ChipOption {
    value: string;
    label: string;
    tone: string;
  }

  type ChipGroupElement = HTMLElement & { options: ChipOption[]; values: string[]; value: string };
  type AskFieldElement = HTMLElement & { value: string };

  const root = document.querySelector<HTMLElement>('[data-setup-steps]');
  if (root) {
    const stepIds = (root.dataset.stepIds ?? '').split(',');
    const questions: Question[] = JSON.parse(root.querySelector('[data-step-questions]')?.textContent ?? '[]');
    const questionById = new Map(questions.map((q) => [q.id, q]));
    const screens = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));

    const stepFromUrl = (): string => {
      const wanted = new URLSearchParams(location.search).get('step') ?? '';
      return stepIds.includes(wanted) ? wanted : stepIds[0];
    };

    let current = stepFromUrl();

    const answered = (id: string): boolean => (readSetupDraft().intent[id] ?? []).length > 0;

    const valid = (id: string): boolean => {
      if (id === 'documents') return readSetupDraft().documentsUploaded;
      if (id === 'confirm') return true;
      return answered(id);
    };

    // The options are rebuilt on every sync, not just the selection: a typed answer
    // is stored as one more option on its question, so the group has to re-render
    // with the extra chip before the selection can point at it.
    const syncChoices = () => {
      const draft = readSetupDraft();
      root.querySelectorAll<ChipGroupElement>('[data-intent-question]').forEach((el) => {
        const id = el.dataset.intentQuestion ?? '';
        const chosen = draft.intent[id] ?? [];
        el.options = intentOptionsFor(id, draft).map((o) => ({ value: o.id, label: o.label, tone: 'brand' }));
        if (questionById.get(id)?.multiple) el.values = [...chosen];
        else el.value = chosen[0] ?? '';
      });
    };

    // Blank or already-taken text leaves the field alone, so what was typed is still
    // there to see. A stored option clears it: the chip above is now the answer.
    const submitAsk = (questionId: string) => {
      const field = root.querySelector<AskFieldElement>(`[data-ask-field][data-ask-question="${questionId}"]`);
      if (!field) return;
      if (addIntentOption(questionId, field.value)) field.value = '';
    };

    const syncSummary = () => {
      const draft = readSetupDraft();
      const summary = root.querySelector<HTMLElement>('[data-step-summary]');
      if (summary) summary.textContent = composeIntentSummary(draft.intent, draft.customIntentOptions, 'documents');
      const line = root.querySelector<HTMLElement>('[data-step-documents-line]');
      if (line) {
        line.hidden = !draft.documentsUploaded;
        line.textContent = `Documents read: ${sampleDocuments.length}`;
      }
    };

    // The rail reads each screen's answer the way it does on the shared stepper,
    // from `data-step-ready`; here that answer is the intent draft, so it is
    // written onto every screen whenever the draft moves.
    const syncReady = () => {
      for (const screen of screens) {
        const id = screen.dataset.step ?? '';
        screen.dataset.stepReady = String(valid(id));
      }
    };

    const setNext = (id: string) => {
      const next = root.querySelector<HTMLButtonElement>(`[data-step="${id}"] [data-step-next]`);
      if (!next) return;
      const ok = valid(id);
      next.disabled = !ok;
      next.closest('.esa-button')?.classList.toggle('esa-button--disabled', !ok);
      const skip = root.querySelector<HTMLElement>(`[data-step="${id}"] [data-step-skip]`);
      if (skip) skip.hidden = ok;
    };

    const show = (id: string, push: boolean) => {
      current = id;
      for (const screen of screens) screen.hidden = screen.dataset.step !== id;
      const index = stepIds.indexOf(id);
      setNext(id);
      if (id === 'confirm') syncSummary();
      const url = new URL(location.href);
      if (index === 0) url.searchParams.delete('step');
      else url.searchParams.set('step', id);
      if (push) history.pushState({ step: id }, '', url);
      else history.replaceState({ step: id }, '', url);
      root.dataset.stepCurrent = id;
      root.dispatchEvent(new CustomEvent('setup-step-show', { detail: { step: id }, bubbles: true }));
      root.querySelector<HTMLElement>(`[data-step="${id}"] .firma2-setup-steps__prompt`)?.focus();
    };

    const move = (delta: number) => {
      const index = stepIds.indexOf(current) + delta;
      if (index < 0 || index >= stepIds.length) return;
      show(stepIds[index], true);
    };

    root.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      // A rail row: any step already reached; the rail marks the rest aria-disabled.
      const go = target.closest<HTMLElement>('[data-step-go]');
      if (go) {
        const id = go.dataset.stepGo ?? '';
        if (go.getAttribute('aria-disabled') !== 'true' && stepIds.includes(id) && id !== current) show(id, true);
        return;
      }
      const add = target.closest<HTMLElement>('[data-ask-add]');
      if (add) submitAsk(add.dataset.askQuestion ?? '');
      else if (target.closest('[data-step-next]')) move(1);
      else if (target.closest('[data-step-skip]')) move(1);
      else if (target.closest('[data-step-edit]')) show(stepIds[1], true);
    });

    root.addEventListener('change', (event) => {
      const el = event.target as HTMLElement | null;
      const id = el?.dataset.intentQuestion;
      if (!id) return;
      const detail = (event as CustomEvent<{ values?: string[]; value?: string }>).detail ?? {};
      const chosen = questionById.get(id)?.multiple ? (detail.values ?? []) : detail.value ? [detail.value] : [];
      setIntentAnswer(id, chosen);
    });

    // Enter in an ask field is the same gesture as Add. The event is retargeted to
    // the esa-text-field host on the way out of its shadow root, so the field is
    // reachable with closest() and there is no inner input to reach for.
    root.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key !== 'Enter') return;
      const field = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-ask-field]');
      if (!field) return;
      event.preventDefault();
      submitAsk(field.dataset.askQuestion ?? '');
    });

    document.addEventListener('setup-draft-change', () => {
      syncChoices();
      syncReady();
      setNext(current);
      if (current === 'confirm') syncSummary();
    });

    window.addEventListener('popstate', () => show(stepFromUrl(), false));

    customElements.whenDefined('esa-chip-group').then(() => {
      syncChoices();
      syncReady();
      show(current, false);
    });
  }
</script>

<style>
  /* One choice per row, each a full-width capsule: the lego's chip radius token
     re-pointed to the pill, the chip part stretched. The group has no justify
     hook, so a wrapped, centred row of chips is not reachable from outside. */
  .firma2-setup-steps__choices {
    --radius-chip: var(--radius-pill);
    /* The brand tone's selected chip reads these three roles; here they resolve
       to a solid brand fill with knockout text, so the chosen answer is unmistakable. */
    --color-background-brand-subtle: var(--color-background-brand);
    --color-border-brand: var(--color-background-brand);
    --color-content-brand: var(--color-content-default-knockout);
    display: flex;
    justify-content: center;
  }
  .firma2-setup-steps__choices esa-chip-group {
    display: flex;
    inline-size: min(100%, 26rem);
    --_gap: var(--spacing-200, 0.5rem);
  }
  .firma2-setup-steps__choices esa-chip-group::part(chip) {
    inline-size: 100%;
    justify-content: center;
    padding-block: var(--spacing-300);
    white-space: normal;
    text-align: center;
  }
  /* bcn-lego-checked: the ask row is esa-text-field + esa-button laid out by the
     .cluster primitive — no bespoke flex of its own. This wrapper is the same
     centring device __choices uses above it, and for the same reason: the screen
     stretches its direct children to full width, so the 26rem column has to be an
     inner element. --align is the cluster's own knob, set to flex-end so the button
     sits on the field's box rather than centred against its label. */
  .firma2-setup-steps__ask {
    display: flex;
    justify-content: center;
  }
  .firma2-setup-steps__ask > .cluster {
    --align: flex-end;
    inline-size: min(100%, 26rem);
  }
  /* The screen centres its text; a form control's label and value read from the
     start edge. The field takes the leftover width beside the button. */
  .firma2-setup-steps__ask esa-text-field {
    flex: 1;
    min-inline-size: 0;
    text-align: start;
  }
  .firma2-setup-steps__summary {
    margin: 0;
    text-align: start;
  }
  .firma2-setup-steps [data-step-documents-line] {
    margin: 0;
    text-align: start;
    color: var(--color-content-default-secondary);
  }
</style>
