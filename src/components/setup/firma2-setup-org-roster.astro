---
// firma2-setup-org-roster: the last screen of the Organizations walk. Every
// organization this program has confirmed, from the documents and the directory,
// and the arrow back to the hub.
//
// A TABLE, NOT MORE TILES. A tile is for CHOOSING; it is large because it is a
// target. These are chosen. What matters now is comparison down a column: who
// has no location, who came out of the directory rather than a document, is
// anyone here twice under two names. Rows do that; a grid of cards does not.
//
// REMOVE IS NOT DELETE, and the two cases differ. An organization the documents
// proposed goes back to `suggested`, which the first screen shows as an
// un-pressed tile, because the document still says it and hiding it forever
// would make that screen lie about what was found. One picked out of the
// directory has no document behind it, so it goes to `dismissed`, and the
// directory offers it again the moment it is searched for. No confirm either
// way: neither is destructive and both are one click from undone.
//
// THE TENANT IS FIRST AND HAS NO REMOVE. Cascade Headwaters Partnership is the
// program itself; a roster it could be removed from is a roster that can be made
// nonsense. It is also the one row that is true before the browser has any
// draft, which is why it is the only one server-rendered.
//
// THE ARROW GOES TO THE HUB, filled, the way Start's last screen does: the walk
// is done and the hub is where the next milestone is chosen. Finish later, in
// the bar, is the other way out and keeps the same draft.
//
// bcn-lego-checked: every mark in here is a lego. esa-badge for the roles and
// for the level, esa-button (iconOnly, chrome) for the row action and (primary,
// lg) for the arrow; esa-icon-button is deprecated in the catalog and forwards
// to esa-button anyway. The emblem in the name cell is firma2-org-mark, which
// filed its own lookup (esa-avatar is the near miss and is wrong for an
// organization), and the cell that holds the two of them is the .cluster
// primitive. The bespoke part is the <table>, on firma2-table.css: there is no
// esa-table (walked the catalog), and the spoke's AG Grid chrome is priced for
// portfolio-scale surfaces that need search, filters and CSV export, none of
// which a dozen rows read once during setup can use. Beacon is not cloned on
// this machine. firma2-setup-funding-roster is the sibling this table matches.
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2OrgMark from './firma2-org-mark.astro';
import Firma2SetupStepScreen from './firma2-setup-step-screen.astro';
import { tenantOrganization } from '../../data/firma2-setup';
import { directoryById, levelLabels } from '../../data/firma2-org-directory';
import '../shared/firma2-table.css';
import { withBase } from '../../lib/base';

const hubHref = withBase('/prototypes/setup');

// The tenant's row is true before the browser has a draft, so its emblem and its
// level are resolved here rather than by the script. The lookup can miss: an
// organization that is not in the directory has no level, and an unknown level is
// not a level, so both cells render nothing rather than a placeholder.
const tenantEntry = directoryById.get(tenantOrganization.id);
---
<Firma2SetupStepScreen
  step="review"
  icon="users"
  prompt="Your organizations"
  align="start"
  class="firma2-setup-org-roster"
>
  <div class="firma2-table__scroll">
    <table class="firma2-table">
      <caption class="visually-hidden">Confirmed organizations</caption>
      <thead>
        <tr>
          <th scope="col" class="typography-label-sm-strong">Name</th>
          <th scope="col" class="typography-label-sm-strong">Level</th>
          <th scope="col" class="typography-label-sm-strong">Roles</th>
          <th scope="col" class="typography-label-sm-strong">Location</th>
          <th scope="col" class="typography-label-sm-strong">Origin</th>
          <th scope="col"><span class="visually-hidden">Remove</span></th>
        </tr>
      </thead>
      <tbody data-part="body">
        <tr>
          <td>
            <span class="cluster" data-gap="xs">
              {tenantEntry && <Firma2OrgMark mark={tenantEntry.mark} size="sm" />}
              <span class="typography-label-sm-strong">{tenantOrganization.name}</span>
            </span>
          </td>
          <td>
            {tenantEntry && <EsaBadge value={levelLabels[tenantEntry.level]} variant="secondary" size="sm" />}
          </td>
          <td>
            <span class="cluster" data-gap="3xs">
              {tenantOrganization.roles.map((role) => <EsaBadge value={role} variant="secondary" size="sm" />)}
            </span>
          </td>
          <td class="typography-body-sm">{tenantOrganization.location}</td>
          <td class="typography-body-sm">Manual</td>
          <td class="firma2-table__action"></td>
        </tr>

        {/* The master copy every scripted row is cloned from. A hidden <tr> rather
            than a <template>, because a row is only a row inside a table: the
            markup stays authored here instead of turning into a string in the
            script below. */}
        <tr hidden data-part="row-template">
          <td>
            <span class="cluster" data-gap="xs">
              <span data-part="mark"></span>
              <span class="typography-label-sm-strong" data-part="name"></span>
            </span>
          </td>
          <td data-part="level"></td>
          <td><span class="cluster" data-gap="3xs" data-part="roles"></span></td>
          <td class="typography-body-sm" data-part="place"></td>
          <td class="typography-body-sm" data-part="source"></td>
          <td class="firma2-table__action">
            <EsaButton variant="chrome" iconOnly icon="circle-x" label="Remove" size="sm" data-part="remove" />
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  {/* One role badge, cloned per role, so the roster's marks are the tiles' marks. */}
  <template data-roster-role><EsaBadge value="" variant="secondary" size="sm" /></template>

  <div slot="advance" class="firma2-setup-steps__arrow">
    <EsaButton variant="primary" size="lg" iconOnly icon="arrow-right" label="Go to setup" href={hubHref} />
  </div>
</Firma2SetupStepScreen>

<script>
  import { listOrganizations, setOrganizationStatus } from '../../lib/setup-draft';
  import { tenantOrganization } from '../../data/firma2-setup';
  import type { Organization, OrganizationSource } from '../../data/firma2-setup';
  import { directoryById, levelLabels } from '../../data/firma2-org-directory';
  import { orgMarkHtml } from '../../lib/org-mark';

  // The Source column, in the words a reader already has. "Document" is where it
  // was found, "Directory" is where she picked it, "Manual" is the program itself.
  const SOURCE_LABEL: Record<OrganizationSource, string> = {
    document: 'Document',
    ask: 'Directory',
    manual: 'Manual',
  };

  const screen = document.querySelector<HTMLElement>('.firma2-setup-org-roster[data-step]');
  const body = screen?.querySelector<HTMLTableSectionElement>('[data-part="body"]');
  const rowTemplate = screen?.querySelector<HTMLTableRowElement>('[data-part="row-template"]');
  const roleTemplate = screen?.querySelector<HTMLTemplateElement>('template[data-roster-role]');

  if (screen && body && rowTemplate) {
    // The tenant's row and the master copy are the two the script never rebuilds.
    const tenantRow = body.rows[0];

    const buildRow = (org: Organization): HTMLTableRowElement => {
      const row = rowTemplate.cloneNode(true) as HTMLTableRowElement;
      row.removeAttribute('hidden');
      row.removeAttribute('data-part');

      const part = (name: string): HTMLElement | null => row.querySelector<HTMLElement>(`[data-part="${name}"]`);

      // The directory holds the emblem and the level. A record from a document
      // that is in neither has its name stand alone and its level cell stay
      // empty: an unknown level is not a level, and a dash would claim otherwise.
      const entry = directoryById.get(org.id);

      const name = part('name');
      if (name) name.textContent = org.name;

      const mark = part('mark');
      if (mark) {
        if (entry) mark.innerHTML = orgMarkHtml(entry.mark, 'sm');
        else mark.hidden = true;
      }

      // The level badge is the role badge (same lego, same variant, same size),
      // so it is cloned from the one template rather than given a second.
      const level = part('level');
      if (level && entry && roleTemplate) {
        const badge = roleTemplate.content.cloneNode(true) as DocumentFragment;
        const text = badge.querySelector('.esa-badge__text');
        if (text) text.textContent = levelLabels[entry.level];
        level.append(badge);
      }

      const roles = part('roles');
      if (roles && roleTemplate) {
        for (const role of org.roles) {
          const badge = roleTemplate.content.cloneNode(true) as DocumentFragment;
          const text = badge.querySelector('.esa-badge__text');
          if (text) text.textContent = role;
          roles.append(badge);
        }
      }

      const place = part('place');
      if (place) place.textContent = org.location ?? '';

      const source = part('source');
      if (source) source.textContent = SOURCE_LABEL[org.source];

      const remove = part('remove');
      if (remove) {
        // "Remove" alone is the same name on every row; a screen reader reading the
        // action list needs to hear WHICH organization it would take out.
        remove.setAttribute('aria-label', `Remove ${org.name}`);
        remove.setAttribute('title', `Remove ${org.name}`);
        remove.dataset.orgId = org.id;
        remove.dataset.orgSource = org.source;
      }

      return row;
    };

    const render = (): void => {
      const confirmed = listOrganizations().filter(
        (org) => org.status === 'confirmed' && org.id !== tenantOrganization.id,
      );
      body.replaceChildren(tenantRow, rowTemplate, ...confirmed.map(buildRow));
    };

    // Delegated, so rows can be replaced wholesale without rewiring anything.
    body.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-org-id]');
      if (!button) return;
      const id = button.dataset.orgId;
      if (!id) return;
      // A document still says this name, so it returns to the first screen
      // un-pressed. A directory pick has nothing behind it and simply goes away.
      setOrganizationStatus(id, button.dataset.orgSource === 'document' ? 'suggested' : 'dismissed');
    });

    document.addEventListener('setup-draft-change', render);
    render();
  }
</script>
