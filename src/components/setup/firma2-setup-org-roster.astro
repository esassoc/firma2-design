---
// firma2-setup-org-roster — the cast, after the picking: every organization this
// program has actually confirmed.
//
// WHY THE SCREEN NEEDS A THIRD SECTION. The picker and the ask both EMPTY as they
// succeed: a confirmed tile leaves the grid, an answered request clears the box.
// Without this, the reward for forty seconds of picking is a blank page, and Dana
// has no way to see what she just built or to undo a mistake. The roster is where
// the work accumulates, and it is the only place a decision can be taken back.
//
// A TABLE, NOT MORE TILES. A tile is for CHOOSING — it is large because it is a
// target. These are chosen. What matters now is comparison down a column: who has
// no location, who came from the ask rather than a document, is anyone here twice
// under two names. Rows do that; a grid of cards does not.
//
// REMOVE IS NOT DELETE, and the two cases differ. An organization the documents
// proposed goes back to `suggested` — it returns to the picker above, because the
// document still says it, and hiding it forever would make the grid lie about what
// was found. One that came from the ask has no document behind it, so it goes to
// `dismissed`: nothing would ever propose it again. No confirmation dialog either
// way, because neither is destructive and both are one click from undone.
//
// THE TENANT IS FIRST AND HAS NO REMOVE. Cascade Headwaters Partnership is the
// program itself; a roster it could be removed from is a roster that can be made
// nonsense. It is also the one row that is true before the browser has any draft,
// which is why it is the only one server-rendered.
//
// bcn-lego-checked: every mark in here is a lego — esa-badge for the roles,
// esa-button (iconOnly, chrome) for the row action; esa-icon-button is deprecated
// in the catalog and forwards to esa-button anyway. The bespoke part is the
// <table>: there is no esa-table (walked the catalog), and the spoke's AG Grid
// chrome is priced for portfolio-scale surfaces that need search, filters and CSV
// export, none of which a dozen rows read once during setup can use. Beacon is not
// cloned on this machine. firma2-project-actions is the precedent this table's
// markup and CSS follow.
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { tenantOrganization } from '../../data/firma2-setup';

const headingId = 'firma2-setup-org-roster-heading';
---
<section class="firma2-setup-org-roster stack" data-gap="sm" aria-labelledby={headingId}>
  <h2 id={headingId} class="typography-title-strong">In your program</h2>

  <div class="firma2-setup-org-roster__scroll">
    <table class="firma2-setup-org-roster__table">
      <caption class="visually-hidden">Confirmed organizations</caption>
      <thead>
        <tr>
          <th scope="col" class="typography-label-sm-strong">Name</th>
          <th scope="col" class="typography-label-sm-strong">Roles</th>
          <th scope="col" class="typography-label-sm-strong">Location</th>
          <th scope="col" class="typography-label-sm-strong">Source</th>
          <th scope="col"><span class="visually-hidden">Remove</span></th>
        </tr>
      </thead>
      <tbody data-part="body">
        <tr>
          <td class="typography-label-sm-strong">{tenantOrganization.name}</td>
          <td>
            <span class="cluster" data-gap="3xs">
              {tenantOrganization.roles.map((role) => <EsaBadge value={role} variant="secondary" size="sm" />)}
            </span>
          </td>
          <td class="typography-body-sm">{tenantOrganization.location}</td>
          <td class="typography-body-sm">Manual</td>
          <td class="firma2-setup-org-roster__action"></td>
        </tr>

        {/* The master copy every scripted row is cloned from. A hidden <tr> rather
            than a <template>, because a row is only a row inside a table: the
            markup stays authored here instead of turning into a string in the
            script below. */}
        <tr hidden data-part="row-template">
          <td class="typography-label-sm-strong" data-part="name"></td>
          <td><span class="cluster" data-gap="3xs" data-part="roles"></span></td>
          <td class="typography-body-sm" data-part="place"></td>
          <td class="typography-body-sm" data-part="source"></td>
          <td class="firma2-setup-org-roster__action">
            <EsaButton variant="chrome" iconOnly icon="circle-x" label="Remove" size="sm" data-part="remove" />
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  {/* One role badge, cloned per role, so the roster's marks are the tiles' marks. */}
  <template data-roster-role><EsaBadge value="" variant="secondary" size="sm" /></template>
</section>

<style>
  .firma2-setup-org-roster > h2 {
    margin: 0;
  }

  /* Five columns hold their width down to a phone; the table scrolls inside this
     rather than pushing the page sideways. */
  .firma2-setup-org-roster__scroll {
    overflow-x: auto;
  }

  .firma2-setup-org-roster__table {
    inline-size: 100%;
    border-collapse: collapse;
  }

  .firma2-setup-org-roster__table th {
    text-align: start;
    padding-block-end: var(--spacing-200, 0.5rem);
    padding-inline-end: var(--spacing-400, 1rem);
    color: var(--color-content-default-secondary, #60655f);
    border-block-end: var(--border-width-default, 1px) solid var(--color-border-default, #cccfcc);
    white-space: nowrap;
  }

  .firma2-setup-org-roster__table td {
    vertical-align: middle;
    padding-block: var(--spacing-250, 0.625rem);
    padding-inline-end: var(--spacing-400, 1rem);
  }

  /* The rule goes on the TOP of every row after the first, not the bottom of
     every row: the master copy lives in this tbody as a hidden row, and a
     bottom-border rule would leave a hairline under the last visible row
     whenever the hidden one followed it. */
  .firma2-setup-org-roster__table tbody tr + tr td {
    border-block-start: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #e3e5e2);
  }

  .firma2-setup-org-roster__table th:last-child,
  .firma2-setup-org-roster__table td:last-child {
    padding-inline-end: 0;
  }

  /* The action column is as wide as its button and no wider. The colour is set
     on the CELL because variant="chrome" takes currentColor from its context by
     design: one declaration keeps a row action from reading as loud as the name
     beside it, and the button's hover scrim still derives from it. */
  .firma2-setup-org-roster__action {
    inline-size: 1%;
    white-space: nowrap;
    text-align: end;
    color: var(--color-content-default-secondary, #60655f);
  }
</style>

<script>
  import { listOrganizations, setOrganizationStatus } from '../../lib/setup-draft';
  import { tenantOrganization } from '../../data/firma2-setup';
  import type { Organization, OrganizationSource } from '../../data/firma2-setup';

  // The Source column, in the words a reader already has. "Document" is where it
  // was found, "Ask" is what she typed, "Manual" is the program itself.
  const SOURCE_LABEL: Record<OrganizationSource, string> = {
    document: 'Document',
    ask: 'Ask',
    manual: 'Manual',
  };

  const section = document.querySelector<HTMLElement>('.firma2-setup-org-roster');
  const body = section?.querySelector<HTMLTableSectionElement>('[data-part="body"]');
  const rowTemplate = section?.querySelector<HTMLTableRowElement>('[data-part="row-template"]');
  const roleTemplate = section?.querySelector<HTMLTemplateElement>('template[data-roster-role]');

  if (section && body && rowTemplate) {
    // The tenant's row and the master copy are the two the script never rebuilds.
    const tenantRow = body.rows[0];

    const buildRow = (org: Organization): HTMLTableRowElement => {
      const row = rowTemplate.cloneNode(true) as HTMLTableRowElement;
      row.removeAttribute('hidden');
      row.removeAttribute('data-part');

      const part = (name: string): HTMLElement | null => row.querySelector<HTMLElement>(`[data-part="${name}"]`);

      const name = part('name');
      if (name) name.textContent = org.name;

      const roles = part('roles');
      if (roles && roleTemplate) {
        for (const role of org.roles) {
          const badge = roleTemplate.content.cloneNode(true) as DocumentFragment;
          const text = badge.querySelector('.esa-badge__text');
          if (text) text.textContent = role;
          roles.append(badge);
        }
      }

      const place = part('place');
      if (place) place.textContent = org.location ?? '';

      const source = part('source');
      if (source) source.textContent = SOURCE_LABEL[org.source];

      const remove = part('remove');
      if (remove) {
        // "Remove" alone is the same name on every row; a screen reader reading the
        // action list needs to hear WHICH organization it would take out.
        remove.setAttribute('aria-label', `Remove ${org.name}`);
        remove.setAttribute('title', `Remove ${org.name}`);
        remove.dataset.orgId = org.id;
        remove.dataset.orgSource = org.source;
      }

      return row;
    };

    const render = (): void => {
      const confirmed = listOrganizations().filter(
        (org) => org.status === 'confirmed' && org.id !== tenantOrganization.id,
      );
      body.replaceChildren(tenantRow, rowTemplate, ...confirmed.map(buildRow));
    };

    // Delegated, so rows can be replaced wholesale without rewiring anything.
    body.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-org-id]');
      if (!button) return;
      const id = button.dataset.orgId;
      if (!id) return;
      // A document still says this name, so it returns to the picker. An asked-for
      // organization has nothing behind it and simply goes away.
      setOrganizationStatus(id, button.dataset.orgSource === 'document' ? 'suggested' : 'dismissed');
    });

    document.addEventListener('setup-draft-change', render);
    render();
  }
</script>
