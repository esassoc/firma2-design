---
// firma2-setup-funding-tile: one funding source as a large, tappable toggle. The
// unit firma2-setup-funding-picker deals in.
//
// IT RENDERS NOTHING BY ITSELF. Same construction as firma2-setup-org-tile: an
// inert <template> holding the tile's markup, the tile's CSS, and a
// <firma2-funding-tile> custom element that clones the template and fills it. A
// caller creates the element and sets `.source`; no caller writes tile markup.
//
// THE CONTRACT
//   el.source = FundingSource   fills the name, administering organization, document
//   el.sourceId                 the source's id, for the caller's write
//   el.selected                 get/set, mirrors aria-pressed on the button
//   'funding-tile-toggle'       bubbling CustomEvent<{ id, selected }> on every click
//
// SELECTION IS NOT A WRITE. Tapping marks the tile; the picker's action row is
// what commits, once, for the set.
//
// WHAT IS ON THE TILE, AND WHAT IS NOT. The name, because the tile is a yes-or-no
// on the name. The administering organization, because two grants from one funder
// are told apart by it, and it is the field the extraction is least sure of, so
// it has to be visible at the moment of the yes. The document, as provenance in
// the mono composite. The award stays off: the org tile cut location for being a
// fourth datum competing with three, and a dollar figure beside a name is louder
// than a town was. The roster holds the award as a column, where it can be
// compared down the page.
//
// THE CHROME IS SHARED, THE FIELDS ARE NOT. The button, its pressed state and
// the check mark come from shared/firma2-pick-tile.css, extracted when the
// stage and classification pickers made four; this file keeps the host rule
// and the fields a funding source fills. The template-clone construction has
// no slots to offer, so each record still owns its own tile file.
//
// bcn-lego-checked: nothing in the catalog is a SELECTABLE tile. esa-card is
// presentational (no pressed state, closed prop set); esa-checkbox has the right
// semantics and a 16px target; esa-chip-group `multiple` is the closest behaviour
// but a chip is one nowrap line and this holds three data in a stack; esa-button
// `active` is a control, not a record. Beacon is not cloned on this machine. So
// the toggle is a native <button aria-pressed>, the same semantics esa-chip-group
// uses inside itself, styled from tokens in shared/firma2-pick-tile.css, and
// every mark inside it is a lego: esa-icon for the check and the file glyph,
// laid out by .stack and .cluster.
import EsaIcon from '@esa/ecology/esa-icon.astro';
import '../shared/firma2-pick-tile.css';
import '../shared/firma2-provenance.css';
---
{/* The master copy. Inert until a <firma2-funding-tile> clones it. */}
<template data-funding-tile>
  <button type="button" class="firma2-pick-tile" aria-pressed="false">
    {/* The selected mark. Present in every tile, shown only when pressed, so
        selecting cannot reflow the card it sits in. */}
    <span class="firma2-pick-tile__mark"><EsaIcon name="circle-check" size="sm" /></span>

    <span class="firma2-pick-tile__body stack" data-gap="2xs">
      <span class="firma2-funding-tile__name typography-label-md-strong" data-part="name"></span>
      <span class="firma2-pick-tile__secondary typography-body-sm" data-part="organization"></span>
      {/* The document the name was found in. The file glyph is the label. */}
      <span class="firma2-provenance typography-code-sm" data-part="source" hidden>
        <EsaIcon name="file-text" size="xs" />
        <span data-part="source-name"></span>
      </span>
    </span>
  </button>
</template>

<style is:global>
  /* The host is created by script and never carries this component's scope
     attribute, so its one rule is global, scoped by a tag name this file owns.
     Stretching to the grid row's height keeps a short tile clickable edge to
     edge beside a tall one. */
  firma2-funding-tile {
    display: block;
    block-size: 100%;
  }
</style>

<script>
  import { sampleDocuments } from '../../data/firma2-setup';
  import type { FundingSource } from '../../data/firma2-setup';

  const TAG = 'firma2-funding-tile';

  /** The document a `document`-sourced suggestion came from, by name. */
  const documentName = (id?: string): string => sampleDocuments.find((doc) => doc.id === id)?.name ?? '';

  class Firma2FundingTile extends HTMLElement {
    #source: FundingSource | null = null;
    #button: HTMLButtonElement | null = null;
    #selected = false;

    /** Fills the tile. Setting it again rebuilds; there is no partial update. */
    set source(value: FundingSource) {
      this.#source = value;
      this.#build();
    }

    get source(): FundingSource | null {
      return this.#source;
    }

    get sourceId(): string {
      return this.#source?.id ?? '';
    }

    get selected(): boolean {
      return this.#selected;
    }

    set selected(value: boolean) {
      this.#selected = value;
      this.#button?.setAttribute('aria-pressed', value ? 'true' : 'false');
    }

    connectedCallback(): void {
      if (!this.#button) this.#build();
    }

    #build(): void {
      const source = this.#source;
      if (!source) return;

      const tileTemplate = document.querySelector<HTMLTemplateElement>('template[data-funding-tile]');
      if (!tileTemplate) return;

      const tile = tileTemplate.content.cloneNode(true) as DocumentFragment;
      const part = (name: string): HTMLElement | null => tile.querySelector<HTMLElement>(`[data-part="${name}"]`);

      const name = part('name');
      if (name) name.textContent = source.name;

      const organization = part('organization');
      if (organization) organization.textContent = source.organizationName;

      const sourceLine = part('source');
      const sourceName = documentName(source.sourceDocumentId);
      const sourceValue = part('source-name');
      if (sourceValue) sourceValue.textContent = sourceName;
      if (sourceLine) sourceLine.hidden = !sourceName;

      this.replaceChildren(tile);
      this.#button = this.querySelector('button');
      this.#button?.setAttribute('aria-pressed', this.#selected ? 'true' : 'false');
      this.#button?.addEventListener('click', () => {
        this.selected = !this.selected;
        this.dispatchEvent(
          new CustomEvent('funding-tile-toggle', {
            detail: { id: this.sourceId, selected: this.selected },
            bubbles: true,
            composed: true,
          }),
        );
      });
    }
  }

  if (!customElements.get(TAG)) customElements.define(TAG, Firma2FundingTile);
</script>
