---
// The panel beside a start screen: what the choice on that screen sets up,
// a few concrete instances, and the journeys the answer can light. One per
// screen; the stepper shows the one for the current screen.
//
// No bespoke UI: esa-card (filled) is the panel, esa-badge the journey marks,
// stack and cluster the layout.
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaCard from '@esa/ecology/esa-card.astro';
import type { SetupJourney, StepGuide } from '../../data/firma2-setup';

interface Props {
  step: string;
  guide: StepGuide;
  journeys?: SetupJourney[];
  hidden?: boolean;
}

const { step, guide, journeys = [], hidden = false } = Astro.props;
---
<div data-step-guide={step} {...(hidden ? { hidden: true } : {})}>
  <EsaCard variant="filled">
    <div class="stack" data-gap="md">
      <h2 class="typography-title-strong firma2-setup-step-guide__title">{guide.title}</h2>
      <p class="typography-body-md firma2-setup-step-guide__body">{guide.body}</p>
      {guide.examples && (
        <ul class="stack firma2-setup-step-guide__examples" data-gap="xs">
          {guide.examples.map((example) => (
            <li class="typography-body-md">{example}</li>
          ))}
        </ul>
      )}
      {journeys.length > 0 && (
        <div class="stack" data-gap="xs">
          <span class="typography-label-md-strong">Sets up</span>
          <div class="cluster" data-gap="xs">
            {journeys.map((j) => (
              <EsaBadge value={j.title} variant="secondary" size="sm" />
            ))}
          </div>
        </div>
      )}
    </div>
  </EsaCard>
</div>

<style>
  [data-step-guide][hidden] {
    display: none;
  }
  .firma2-setup-step-guide__title,
  .firma2-setup-step-guide__body {
    margin: 0;
  }
  .firma2-setup-step-guide__examples {
    margin: 0;
    padding-inline-start: var(--spacing-400);
  }
</style>
