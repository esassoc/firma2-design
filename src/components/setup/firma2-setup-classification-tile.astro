---
// firma2-setup-classification-tile: one classification as a large, tappable
// toggle. The unit firma2-setup-classification-picker deals in.
//
// IT RENDERS NOTHING BY ITSELF. Same construction as firma2-setup-funding-tile:
// an inert <template> holding the tile's markup and a <firma2-classification-tile>
// custom element that clones the template and fills it. A caller creates the
// element and sets `.classification`; no caller writes tile markup.
//
// THE CONTRACT
//   el.classification = ClassificationRecord   fills the name and the document; setting it again rebuilds
//   el.classificationId                        the record's id, for the caller's write
//   el.selected                                get/set, mirrors aria-pressed on the button
//   'classification-tile-toggle'               bubbling CustomEvent<{ id, selected }> on every click
//
// SELECTION IS NOT A WRITE. Tapping marks the tile; the picker's arrow is what
// commits, once, for the set.
//
// WHAT IS ON THE TILE, AND WHAT IS NOT. The name, because the tile is a yes-or-no
// on the name. The document, as provenance in the mono composite, because it is
// what makes the tile read as found rather than invented. No secondary line: the
// suggestions come from a spreadsheet column, which holds values and not
// definitions, so dbo.Classification.ClassificationDescription is empty on every
// document candidate and a line for it would render nothing or narration.
//
// THE CHROME IS SHARED, THE FIELDS ARE NOT. The button, its pressed state and the
// check mark come from shared/firma2-pick-tile.css; this file keeps the host rule
// and the fields a classification fills.
//
// bcn-lego-checked: nothing in the catalog is a SELECTABLE tile. esa-card is
// presentational (no pressed state, closed prop set); esa-checkbox has the right
// semantics and a 16px target; esa-chip-group `multiple` is the closest behaviour
// but a chip is one nowrap line and this holds a name over a provenance line;
// esa-button `active` is a control, not a record. Beacon is not cloned on this
// machine. So the toggle is a native <button aria-pressed>, styled from tokens in
// shared/firma2-pick-tile.css (the reusable home), and every mark inside it is a
// lego: esa-icon for the check and the file glyph, laid out by .stack.
import EsaIcon from '@esa/ecology/esa-icon.astro';
import '../shared/firma2-pick-tile.css';
import '../shared/firma2-provenance.css';
---
{/* The master copy. Inert until a <firma2-classification-tile> clones it. */}
<template data-classification-tile>
  <button type="button" class="firma2-pick-tile" aria-pressed="false">
    {/* The selected mark. Present in every tile, shown only when pressed, so
        selecting cannot reflow the card it sits in. */}
    <span class="firma2-pick-tile__mark"><EsaIcon name="circle-check" size="sm" /></span>

    <span class="firma2-pick-tile__body stack" data-gap="2xs">
      <span class="typography-label-md-strong" data-part="name"></span>
      {/* The document the name was found in. The file glyph is the label. */}
      <span class="firma2-provenance typography-code-sm" data-part="source" hidden>
        <EsaIcon name="file-text" size="xs" />
        <span data-part="source-name"></span>
      </span>
    </span>
  </button>
</template>

<style is:global>
  /* The host is created by script and never carries this component's scope
     attribute, so its one rule is global, scoped by a tag name this file owns.
     Stretching to the grid row's height keeps a short tile clickable edge to
     edge beside a tall one. */
  firma2-classification-tile {
    display: block;
    block-size: 100%;
  }
</style>

<script>
  import { sampleDocuments } from '../../data/firma2-setup';
  import type { ClassificationRecord } from '../../data/firma2-setup';

  const TAG = 'firma2-classification-tile';

  /** The document a `document`-sourced suggestion came from, by name. */
  const documentName = (id?: string): string => sampleDocuments.find((doc) => doc.id === id)?.name ?? '';

  class Firma2ClassificationTile extends HTMLElement {
    #record: ClassificationRecord | null = null;
    #button: HTMLButtonElement | null = null;
    #selected = false;

    /** Fills the tile. Setting it again rebuilds; there is no partial update. */
    set classification(value: ClassificationRecord) {
      this.#record = value;
      this.#build();
    }

    get classification(): ClassificationRecord | null {
      return this.#record;
    }

    get classificationId(): string {
      return this.#record?.id ?? '';
    }

    get selected(): boolean {
      return this.#selected;
    }

    set selected(value: boolean) {
      this.#selected = value;
      this.#button?.setAttribute('aria-pressed', value ? 'true' : 'false');
    }

    connectedCallback(): void {
      if (!this.#button) this.#build();
    }

    #build(): void {
      const record = this.#record;
      if (!record) return;

      const tileTemplate = document.querySelector<HTMLTemplateElement>('template[data-classification-tile]');
      if (!tileTemplate) return;

      const tile = tileTemplate.content.cloneNode(true) as DocumentFragment;
      const part = (name: string): HTMLElement | null => tile.querySelector<HTMLElement>(`[data-part="${name}"]`);

      const name = part('name');
      if (name) name.textContent = record.name;

      const sourceLine = part('source');
      const sourceName = documentName(record.sourceDocumentId);
      const sourceValue = part('source-name');
      if (sourceValue) sourceValue.textContent = sourceName;
      if (sourceLine) sourceLine.hidden = !sourceName;

      this.replaceChildren(tile);
      this.#button = this.querySelector('button');
      this.#button?.setAttribute('aria-pressed', this.#selected ? 'true' : 'false');
      this.#button?.addEventListener('click', () => {
        this.selected = !this.selected;
        this.dispatchEvent(
          new CustomEvent('classification-tile-toggle', {
            detail: { id: this.classificationId, selected: this.selected },
            bubbles: true,
            composed: true,
          }),
        );
      });
    }
  }

  if (!customElements.get(TAG)) customElements.define(TAG, Firma2ClassificationTile);
</script>
