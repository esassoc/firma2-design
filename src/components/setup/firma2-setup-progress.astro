---
// firma2-setup-progress — the hub's one aggregate: the collection of milestone
// emblems, and the fraction of them earned.
//
// THE SASH. Every milestone's emblem, small, in one row at the top of the hub,
// in the order the cards below appear and spaced into the same five subject
// groups. Confirmed ones are solid in their colour with no seal, ones under way carry their
// half-drawn arc, and everything not yet started is a light grey outline, so
// the row reads as a collection with its gaps showing. It is the card grid seen at a
// glance: the same eleven marks in the same colours at a fraction of the size,
// which is what lets a reader who spots the one filled hexagon on the left know
// where to scroll before reading a word.
//
// THE FRACTION IS WHAT SOMEBODY REPORTS. "6 of 11 milestones complete" is the
// sentence a program admin says out loud; the percentage is arithmetic performed
// on it. The sash is the redundant half and is therefore aria-hidden: every
// status it draws is stated in words by the card grid beneath it, so announcing
// it again would read the whole hub twice.
//
// MEASURES IS IN THE TOTAL. Mission 6 owns performance measures, so this slice
// cannot confirm it, and the fraction tops out at ten of eleven here. That is
// the honest number: setup is not stood up until measures is, and a sash that
// left the eleventh badge off would disagree with the grid that shows it.
//
// STATUS IS DERIVED, NEVER STORED. The server renders the ZERO state and the
// script re-applies the real one on load and on every `setup-draft-change` —
// same contract as the card grid, reading the same two functions, so the meter
// and the cards can never disagree.
//
// bcn-lego-checked: esa-progress-bar is the lego for a meter and was read before
// building (node_modules/@esa/ecology/src/components/esa-progress-bar.astro). It
// is ONE track and ONE fill sized by an inline width percentage — no per-step
// state, no per-step colour — and this meter is eleven distinct marks each in
// its own colour and state. The marks are firma2-setup-milestone-emblem, the
// same object the grid draws large, laid in a .cluster; nothing here is a
// primitive of its own. Beacon is not cloned on this machine, so tier 2 is
// unavailable. firma2-setup-progress is the reusable home for the whole meter,
// fraction and sash together, because the two are one fact and splitting them
// is how they drift apart.
import { journeys, milestoneSections } from '../../data/firma2-setup';
import { journeyStatuses, setupCompletion } from '../../lib/setup-draft';
import Firma2SetupMilestoneEmblem from './firma2-setup-milestone-emblem.astro';

// The sash's reading order IS the grid's reading order: sections in their
// declared order, milestones in theirs. `sectionStart` is what opens the wider
// gap that makes five groups out of eleven marks.
const marks = milestoneSections.flatMap((section) =>
  journeys
    .filter((journey) => journey.section === section.key)
    .map((journey, index) => ({ journey, sectionStart: index === 0 })),
);

// The zero state, resolved at build time. journeyStatuses() and setupCompletion()
// are SSR-safe (no localStorage on the server), so this is exactly what a
// first-time visitor sees before the script runs, not a placeholder that flickers.
const initial = journeyStatuses();
const completion = setupCompletion();
---
<div class="firma2-setup-progress repel" data-gap="md" data-align="center">
  <p class="typography-title firma2-setup-progress__fraction">
    <span data-setup-progress-done>{completion.done}</span> of <span data-setup-progress-total>{completion.total}</span> milestones complete
  </p>

  <ul class="firma2-setup-progress__sash cluster" data-gap="xs" aria-hidden="true">
    {
      marks.map(({ journey, sectionStart }) => (
        <li
          class="firma2-setup-progress__mark"
          data-setup-mark={journey.key}
          data-section-start={sectionStart ? '' : undefined}
          title={journey.title}
        >
          <Firma2SetupMilestoneEmblem
            icon={journey.icon}
            hue={journey.hue}
            status={initial[journey.key].status}
            size="xs"
            tone="earned"
            seal={false}
          />
        </li>
      ))
    }
  </ul>
</div>

<script>
  // The meter's one job after render: keep the fraction and every mark honest
  // about a draft that lives in this browser. Both functions are the ones the
  // server rendered from, so this is a re-derivation rather than a second opinion.
  import { journeyStatuses, setupCompletion } from '../../lib/setup-draft';
  import type { JourneyKey } from '../../data/firma2-setup';

  const root = document.querySelector<HTMLElement>('.firma2-setup-progress');

  if (root) {
    const done = root.querySelector<HTMLElement>('[data-setup-progress-done]');
    const total = root.querySelector<HTMLElement>('[data-setup-progress-total]');

    const apply = (): void => {
      const statuses = journeyStatuses();
      const completion = setupCompletion();

      if (done) done.textContent = String(completion.done);
      if (total) total.textContent = String(completion.total);

      root.querySelectorAll<HTMLElement>('[data-setup-mark]').forEach((mark) => {
        const progress = statuses[mark.dataset.setupMark as JourneyKey];
        if (!progress) return;
        const emblem = mark.querySelector<HTMLElement>('[data-milestone-emblem]');
        if (!emblem) return;
        emblem.dataset.status = progress.status;
      });
    };

    apply();
    document.addEventListener('setup-draft-change', apply);
  }
</script>

<style>
  /* One sentence in one voice. Tabular figures because the numbers change in
     place and a shifting baseline under a changing digit reads as a glitch. */
  .firma2-setup-progress__fraction {
    margin: 0;
    color: var(--color-content-default-secondary);
    font-variant-numeric: tabular-nums;
  }

  .firma2-setup-progress__sash {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .firma2-setup-progress__mark {
    display: flex;
  }

  /* The group seam. A wider gap before each section's first mark is the whole of
     the grouping: five labelled rows under an eleven-mark row would be text about
     the row, and the headings below already name every group. */
  .firma2-setup-progress__mark[data-section-start]:not(:first-child) {
    margin-inline-start: var(--spacing-300);
  }
</style>
