---
// firma2-setup-hex-map — the tenant's setup progress as an isometric hex board.
//
// WHAT IT IS. One hex per setup journey, laid out from the axial (q, r)
// coordinates the journey model already carries, drawn as a low-relief prism:
// a foreshortened top face plus the two side faces a viewer above and in front
// of the board would see. A journey's state is its hex's state — flat grey
// while nothing is known, outlined while the documents have only proposed
// something, filled and raised once an admin has confirmed it. The board fills
// in as the tenant does.
//
// WHY A BOARD AND NOT A BAR. setupCompletion() already gives a fraction, and a
// linear meter would show it in one line. What a meter cannot show is WHICH
// journeys are done, which are under way, and which sit next to each other —
// and adjacency is load-bearing in this model ("neighbours depend on each
// other", firma2-setup.ts). A hex board renders the fraction, the identity and
// the dependency structure in the same picture, which is the whole reason the
// journeys were given hex coordinates in the first place.
//
// bcn-lego-checked: walked node_modules/@esa/ecology/src/components/ (60
// components, listed 2026-09-11) — there is NO hex map, no isometric tile, no
// board or grid-of-shapes primitive of any kind. The nearest relatives were
// checked and rejected on their own terms: esa-progress-bar is strictly LINEAR
// (value/mode/size/variant — no shape prop, no segments), esa-chart's series
// types are cartesian/donut and have no tile or hex geometry, esa-stat is a
// number with a label, and esa-card/esa-badge/esa-pill are rectangles that
// would flatten the map into the list the hub already shows above it. Beacon
// (tier 2) is not cloned on this machine, so that tier is unavailable — and an
// Angular prod app for a 2015-era product has no isometric board either.
// firma2-setup-hex-map is the reusable home: it is the ONE place the hex model
// in firma2-setup.ts is turned into geometry, so the hub page, a future
// go-live screen and the documents page can all render the same board without
// a second copy of the axial-to-pixel maths.
//
// WHY NO ICONS ON THE TILES. Each journey carries an esa-icon registry name,
// and this component deliberately does not draw it. Two reasons, both
// doctrinal: design-principles is explicit that icons mark STRUCTURE, never
// items — eleven glyphs, one per tile, is exactly the per-item ornament that
// rule exists to stop — and an esa-icon renders its own <svg> wrapper, so
// composing it here would mean nesting a second viewport inside each tile and
// re-deriving its scale by hand. The title is the identity; the fill is the
// state. Nothing is left for a glyph to say.
//
// WHY THE STATE IS APPLIED AT RUNTIME. journeyStatuses() reads localStorage,
// which does not exist during `astro build`. Every hex therefore ships as
// `untouched` and the script below corrects it on load and on every
// `setup-draft-change` event. This is the same contract the rest of the setup
// slice uses; it also means the board can never disagree with the records
// beneath it, because it re-derives rather than caches.
import '@esa/tokens/typography.css';
import { journeys } from '../../data/firma2-setup';
import type { JourneyStatus } from '../../data/firma2-setup';
import { withBase } from '../../lib/base';

interface Props {
  /**
   * Rendered width ceiling. `md` is the hub's column; `sm` for a rail or a
   * half-width slot; `lg` where the board is the page's main subject. The
   * geometry is a fixed viewBox either way — this scales the element, never
   * the maths.
   */
  size?: 'sm' | 'md' | 'lg';
  /**
   * Whether tiles are links to their journeys. Off when the board is the
   * illustrative companion of a list that already carries the navigation:
   * the map then shows state and nothing else.
   */
  linked?: boolean;
  /** Whether the status legend renders under the board. Off when the board is pure illustration. */
  legend?: boolean;
}

const { size = 'md', linked = true, legend = true } = Astro.props;

// ---------------------------------------------------------------------------
// Geometry — every number below is derived, so changing HEX_R or FORESHORTEN
// moves the whole board consistently instead of drifting against hand-tuned
// siblings.
// ---------------------------------------------------------------------------

/** Circumradius of the un-foreshortened pointy-top hexagon, in SVG user units. */
const HEX_R = 60;

/**
 * Vertical squash. A board seen from elevation θ foreshortens by sin(θ), so
 * 0.6 is a ~37° camera rather than the 30° a literal reading would give.
 * 30° (0.5) was tried first and rejected: it leaves a 30-unit band across the
 * tile's centre, which is under the 28 units two lines of label need plus any
 * breathing room, so every long title either collided with its own tile edge
 * or had to shrink below the legible floor. 37° still reads unmistakably as a
 * board seen from above and buys the label the room it needs.
 */
const FORESHORTEN = 0.6;

/** Side-face height at full lift. The only "how tall is confirmed" number. */
const HEX_DEPTH = 16;

/**
 * Layout spacing multiplier. 1.0 is a true tessellation with tiles sharing
 * edges; 1.06 opens a hairline between them so each tile reads as a discrete
 * object and the dashed `suggested` outline has a ground to sit against.
 */
const HEX_GAP = 1.06;

const HEX_W = (Math.sqrt(3) * HEX_R) / 2; // half-width  (the flat left/right edges)
const HEX_H = FORESHORTEN * HEX_R; // half-height (the top/bottom points)

// Axial -> pixel for POINTY-TOP hexes: r is the row, and each row shifts half a
// hex along q. This is the reading firma2-setup.ts's own comment describes, and
// it is the one that makes the model's stated adjacencies true — documents
// (0,-2) really does touch organizations (-1,-1) and funding-sources (0,-1).
const COL = HEX_W * 2 * HEX_GAP;
const ROW = 1.5 * HEX_R * FORESHORTEN * HEX_GAP;

/**
 * The slant of a lower hex edge, as an angle. The side faces are drawn as
 * plain rects and sheared onto the tile's lower-left / lower-right edges by
 * this much, which is what lets a single scaleY() raise a tile without any
 * polygon point being recomputed. See the CSS for the full derivation.
 */
const SIDE_SKEW = (Math.atan(HEX_H / (2 * HEX_W)) * 180) / Math.PI;

const round = (n: number): number => Math.round(n * 100) / 100;

/** The top face, as a points string. Pointy-top, already foreshortened. */
const CAP_POINTS = [
  [0, -HEX_H],
  [HEX_W, -HEX_H / 2],
  [HEX_W, HEX_H / 2],
  [0, HEX_H],
  [-HEX_W, HEX_H / 2],
  [-HEX_W, -HEX_H / 2],
]
  .map(([x, y]) => `${round(x)},${round(y)}`)
  .join(' ');

// PAINTER'S ORDER, back row first. A raised tile grows UPWARD out of the board,
// so it overlaps the row behind it; drawing in ascending r means the nearer
// tile is painted last and occludes the further one, which is the only thing
// that makes the relief read as relief rather than as overlapping stickers.
const placed = journeys
  .map((journey) => ({
    journey,
    x: COL * (journey.hex.q + journey.hex.r / 2),
    y: ROW * journey.hex.r,
  }))
  .sort((a, b) => a.journey.hex.r - b.journey.hex.r);

const PAD = 12;
const xs = placed.map((p) => p.x);
const ys = placed.map((p) => p.y);
const minX = Math.min(...xs) - HEX_W;
const maxX = Math.max(...xs) + HEX_W;
// The top bound allows for a fully raised tile in the back row; the bottom
// bound does not, because the footprint never moves.
const minY = Math.min(...ys) - HEX_H - HEX_DEPTH;
const maxY = Math.max(...ys) + HEX_H;

const VIEW_W = round(maxX - minX + PAD * 2);
const VIEW_H = round(maxY - minY + PAD * 2);
const ORIGIN_X = round(-minX + PAD);
const ORIGIN_Y = round(-minY + PAD);

// ---------------------------------------------------------------------------
// Labels
// ---------------------------------------------------------------------------

/**
 * Label size in SVG USER UNITS, not rendered pixels — the two differ by the
 * viewBox scale, so a rem-based typography composite cannot be used here: it
 * would resolve against the root font size and then be scaled again, breaking
 * the tile-to-text proportion at every width. 13 user units renders at 14.7px
 * at the 520px floor this board is designed for, 18.2px at 640 and 20.4px at
 * 720 — above the 14px floor across the stated range. A deliberate hard-code,
 * sanctioned by design-principles § token-first (4): no token expresses "a
 * length in the coordinate system of this viewBox".
 *
 * BELOW 520px the board scales down with its viewBox and the labels go with
 * it (~10px on a phone), and there is no honest fix at this size: the widest
 * label is a single unbreakable word, "Classifications", which already fills
 * the tile at 13 units, so growing the type just pushes it through the tile
 * edge. The board degrades to a picture of the shape of progress at that
 * width, and the visually-hidden list below it — every journey, every status,
 * in words — is what carries the content. It is not an optional extra here.
 */
const LABEL_SIZE = 13;
const LABEL_LINE = 15;
/** Cap height of the label face, for optically centring the block on the tile. */
const LABEL_CAP = 9.2;

/**
 * Longest title that stays on one line. Deliberately short: two balanced lines
 * sit better inside a hexagon (which is widest exactly at its centre) than one
 * long line that runs at the tile's full width. Only "People" clears it.
 */
const SINGLE_LINE_MAX = 10;

/** Deterministic: the split that minimises the longer line. No measurement, no randomness. */
const wrapTitle = (title: string): string[] => {
  const words = title.split(' ');
  if (words.length === 1 || title.length <= SINGLE_LINE_MAX) return [title];
  let bestIndex = 1;
  let bestScore = Number.POSITIVE_INFINITY;
  for (let i = 1; i < words.length; i += 1) {
    const score = Math.max(words.slice(0, i).join(' ').length, words.slice(i).join(' ').length);
    if (score < bestScore) {
      bestScore = score;
      bestIndex = i;
    }
  }
  return [words.slice(0, bestIndex).join(' '), words.slice(bestIndex).join(' ')];
};

const firstBaseline = (lineCount: number): number =>
  round(LABEL_CAP / 2 - ((lineCount - 1) * LABEL_LINE) / 2);

// ---------------------------------------------------------------------------
// State names
// ---------------------------------------------------------------------------

/**
 * The four states, in words. Read by the legend and by the screen-reader list,
 * so a tile and its list row can never name the same state differently.
 * `untouched` is the model's internal word and is not shown: "Not started" is
 * what an admin would say, and internal vocabulary does not leak into copy.
 */
const STATUS_LABEL: Record<JourneyStatus, string> = {
  untouched: 'Not started',
  suggested: 'Suggested',
  'in-progress': 'In progress',
  confirmed: 'Confirmed',
};

const legendOrder: JourneyStatus[] = ['untouched', 'suggested', 'in-progress', 'confirmed'];

const SWATCH_SCALE = 0.2;
const SWATCH_POINTS = CAP_POINTS.split(' ')
  .map((pair) => pair.split(',').map((n) => round(Number(n) * SWATCH_SCALE)).join(','))
  .join(' ');
const SWATCH_W = round(HEX_W * SWATCH_SCALE + 2);
const SWATCH_H = round(HEX_H * SWATCH_SCALE + 2);

const rootClass = ['firma2-setup-hex-map', `firma2-setup-hex-map--${size}`, 'stack'].join(' ');

/**
 * The four geometry constants the stylesheet has to agree with, handed over as
 * inherited custom properties on the root. Written by hand rather than with
 * `define:vars` deliberately: define:vars stamps the whole set onto EVERY
 * element the component renders — here, sixty-odd rects, polygons and groups —
 * where one declaration on the root inherits to all of them for free.
 */
const rootVars = [
  `--hex-cap-offset: ${round(HEX_H)}px`,
  `--hex-skew: ${round(SIDE_SKEW)}deg`,
  `--hex-depth: ${HEX_DEPTH}px`,
  `--hex-label-size: ${LABEL_SIZE}px`,
].join('; ');
---

<div class={rootClass} data-gap="lg" style={rootVars}>
  <!-- aria-hidden, and every tile link inside is tabindex="-1": the board is a
       picture of state that a screen reader cannot usefully walk, and the list
       at the bottom of this component carries the same eleven journeys, the
       same statuses and the same links in words. focusable="false" keeps
       legacy engines from parking a tab stop on the root <svg>. -->
  <svg
    class="firma2-setup-hex-map__board"
    viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
    aria-hidden="true"
    focusable="false"
  >
    <g transform={`translate(${ORIGIN_X}, ${ORIGIN_Y})`}>
      {
        placed.map(({ journey, x, y }) => {
          const lines = wrapTitle(journey.title);
          const baseline = firstBaseline(lines.length);
          const tile = (
            <g
              class="firma2-setup-hex-map__hex"
              data-journey={journey.key}
              data-status="untouched"
              data-external={journey.external ? '' : undefined}
              transform={`translate(${round(x)}, ${round(y)})`}
            >
              {/* The two visible side faces. Each is a plain rect, sheared onto
                  its hex edge and scaled vertically by the tile's lift — see
                  the CSS for why that is exactly equivalent to the extruded
                  parallelogram, and why it is the only form of it that a CSS
                  transition can animate. */}
              <rect
                class="firma2-setup-hex-map__side firma2-setup-hex-map__side--left"
                x={round(-HEX_W)}
                y={-HEX_DEPTH}
                width={round(HEX_W)}
                height={HEX_DEPTH}
              />
              <rect
                class="firma2-setup-hex-map__side firma2-setup-hex-map__side--right"
                x="0"
                y={-HEX_DEPTH}
                width={round(HEX_W)}
                height={HEX_DEPTH}
              />
              <g class="firma2-setup-hex-map__top">
                <polygon class="firma2-setup-hex-map__face" points={CAP_POINTS} stroke-linejoin="round" />
                <text class="firma2-setup-hex-map__label" x="0" y={baseline} text-anchor="middle">
                  {lines.map((line, index) => (
                    <tspan x="0" dy={index === 0 ? 0 : LABEL_LINE}>{line}</tspan>
                  ))}
                </text>
              </g>
            </g>
          );

          return linked && journey.route ? (
            <a class="firma2-setup-hex-map__tile-link" href={withBase(journey.route)} tabindex="-1">
              {tile}
            </a>
          ) : (
            tile
          );
        })
      }
    </g>
  </svg>

  <!-- The five states beside their swatch, and nothing else. aria-hidden
       because it is a key to a picture the screen reader is not being shown;
       the list below states every journey's status in words instead. -->
  {legend && <ul class="firma2-setup-hex-map__legend cluster" data-gap="md" aria-hidden="true">
    {
      legendOrder.map((status) => (
        <li class="firma2-setup-hex-map__legend-item cluster" data-gap="2xs" data-status={status}>
          <svg
            class="firma2-setup-hex-map__swatch"
            viewBox={`${-SWATCH_W} ${-SWATCH_H} ${SWATCH_W * 2} ${SWATCH_H * 2}`}
            aria-hidden="true"
            focusable="false"
          >
            <polygon class="firma2-setup-hex-map__face" points={SWATCH_POINTS} stroke-linejoin="round" />
          </svg>
          <span class="typography-label-md">{STATUS_LABEL[status]}</span>
        </li>
      ))
    }
  </ul>}

  <!-- The board in words. Visually hidden; a row that carries a link reveals
       itself when a keyboard user reaches it, so nothing is ever focused
       invisibly. The script keeps every status string and every href in step
       with the tiles. -->
  <ul class="firma2-setup-hex-map__list" aria-label="Setup milestones">
    {
      journeys.map((journey) => (
        <li
          class={`firma2-setup-hex-map__item visually-hidden${linked && journey.route ? ' visually-hidden--focusable' : ''}`}
          data-journey={journey.key}
        >
          {linked && journey.route ? (
            <a class="firma2-setup-hex-map__item-link" href={withBase(journey.route)}>
              {journey.title}
            </a>
          ) : (
            <span>{journey.title}</span>
          )}
          <span class="firma2-setup-hex-map__item-status">: {STATUS_LABEL.untouched}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .firma2-setup-hex-map {
    inline-size: 100%;
  }

  /* The board is sized by its element, never by its geometry — the viewBox is
     fixed, so these three rungs scale one drawing rather than describing three.
     520-720px is the range the label size was tuned against. */
  .firma2-setup-hex-map--sm { --board-max: 520px; }
  .firma2-setup-hex-map--md { --board-max: 640px; }
  .firma2-setup-hex-map--lg { --board-max: 720px; }

  .firma2-setup-hex-map__board {
    display: block;
    inline-size: 100%;
    max-inline-size: var(--board-max);
    block-size: auto;
  }

  /* -------------------------------------------------------------------------
     The five states. Every visual difference between them is a custom property
     set here and read by the shapes below, which is what lets the legend swatch
     and the tile share one definition instead of drifting apart.

     --hex-lift-base is a UNITLESS 0-1 scalar, not a length: the side faces
     consume it as a scaleY() factor and the top face as a multiplier on
     --hex-depth, so one number raises both halves of the prism by exactly the
     same amount. It is copied into --hex-lift one rule below rather than used
     directly, because hover has to add to it and a custom property cannot
     reference itself — `--hex-lift: calc(var(--hex-lift) + x)` is a cycle, and
     a cycle resolves to guaranteed-invalid, which would drop every tile flat
     the moment the cursor touched one.
     ------------------------------------------------------------------------- */

  .firma2-setup-hex-map [data-status='untouched'] {
    --hex-lift-base: 0.14;
    --hex-cap: var(--color-background-elevation-sunken);
    --hex-edge: var(--color-border-default-subtle);
    --hex-side-left: var(--firma2-neutral-5);
    --hex-side-right: var(--firma2-neutral-6);
    --hex-text: var(--color-content-default);
  }

  /* Dashed, because a suggestion is a shape the tenant has not agreed to yet.
     The tint is the faintest step of the brand ramp: enough to say "something
     is here", not enough to be mistaken for a filled tile. */
  .firma2-setup-hex-map [data-status='suggested'] {
    --hex-lift-base: 0.14;
    --hex-cap: var(--color-background-brand-subtle);
    --hex-edge: var(--color-background-brand);
    --hex-edge-dash: 6 4;
    --hex-side-left: var(--firma2-brand-4);
    --hex-side-right: var(--firma2-brand-5);
    --hex-text: var(--color-content-default);
  }

  .firma2-setup-hex-map [data-status='in-progress'] {
    --hex-lift-base: 0.5;
    --hex-cap: var(--color-background-brand-muted);
    --hex-edge: var(--color-border-brand);
    --hex-side-left: var(--firma2-brand-6);
    --hex-side-right: var(--firma2-brand-7);
    --hex-text: var(--color-content-default);
  }

  /* Full height, full fill. The two side faces are consecutive steps of the
     brand ramp below the cap, which is how a solid lit from above and to the
     left actually shades — there is no semantic role for "the shaded face of a
     prism", so the ramp steps are named directly. */
  .firma2-setup-hex-map [data-status='confirmed'] {
    --hex-lift-base: 1;
    --hex-cap: var(--color-background-brand);
    --hex-edge: var(--firma2-brand-10);
    --hex-side-left: var(--firma2-brand-10);
    --hex-side-right: var(--firma2-brand-11);
    --hex-text: var(--color-content-on-brand);
  }

  /* MISSION 6'S TILE. Performance measures belongs to another team, so it is
     drawn as a seam rather than as ground this slice can fill: the page's own
     surface for a cap, a strong neutral outline at double weight, and no state
     colour in any direction. It stays a link — the prototype for it exists —
     but it never lights up, whatever the draft says. Declared after the five
     status blocks so it wins on source order at equal specificity. */
  .firma2-setup-hex-map [data-external] {
    --hex-lift-base: 0.14;
    --hex-cap: var(--color-background-default);
    --hex-edge: var(--color-border-default-strong);
    --hex-edge-dash: none;
    --hex-edge-width: 2.25;
    --hex-side-left: var(--firma2-neutral-3);
    --hex-side-right: var(--firma2-neutral-5);
    --hex-text: var(--color-content-default-secondary);
  }

  /* -------------------------------------------------------------------------
     The prism
     ------------------------------------------------------------------------- */

  .firma2-setup-hex-map__hex {
    --hex-lift: var(--hex-lift-base);
  }

  .firma2-setup-hex-map__face {
    fill: var(--hex-cap);
    stroke: var(--hex-edge);
    stroke-width: var(--hex-edge-width, 1.5);
    stroke-dasharray: var(--hex-edge-dash, none);
  }

  .firma2-setup-hex-map__top {
    transform: translateY(calc(var(--hex-lift) * var(--hex-depth) * -1));
  }

  /*
   * THE SIDE FACES, AND WHY THEY ARE RECTS.
   *
   * A hex prism's visible side face is the parallelogram swept when the tile's
   * lower-left (or lower-right) edge is extruded straight down. Written as a
   * <polygon> its four points depend on the lift — and polygon points are not
   * animatable, so every change of state would snap.
   *
   * The same parallelogram is an affine image of a rectangle, and affine
   * transforms ARE animatable. So each side is authored as a plain rect of
   * height --hex-depth sitting above the origin, and placed with:
   *
   *     translate(0, +halfHeight)   move the origin to the tile's bottom point
   *     skewY(±edgeAngle)           shear the rect onto the real hex edge
   *     scaleY(lift)                set how much of the depth is showing
   *
   * Read right to left: scaleY runs first about the origin, so the rect's
   * bottom edge stays pinned on the hex edge and its top edge rises by exactly
   * lift x depth — the same distance --top travels. The two halves of the
   * prism therefore cannot separate, at rest or mid-transition.
   *
   * transform-box: fill-box puts the transform origin on the rect's own bbox
   * corner rather than the SVG's view box, which is the one corner that
   * coincides with the tile's bottom point in local coordinates.
   */
  .firma2-setup-hex-map__side {
    transform-box: fill-box;
  }

  .firma2-setup-hex-map__side--left {
    fill: var(--hex-side-left);
    transform-origin: 100% 100%;
    transform: translate(0px, var(--hex-cap-offset)) skewY(var(--hex-skew)) scaleY(var(--hex-lift));
  }

  .firma2-setup-hex-map__side--right {
    fill: var(--hex-side-right);
    transform-origin: 0% 100%;
    transform: translate(0px, var(--hex-cap-offset)) skewY(calc(var(--hex-skew) * -1)) scaleY(var(--hex-lift));
  }

  .firma2-setup-hex-map__label {
    font-size: var(--hex-label-size);
    font-weight: 500;
    fill: var(--hex-text);
  }

  .firma2-setup-hex-map__top,
  .firma2-setup-hex-map__side,
  .firma2-setup-hex-map__face,
  .firma2-setup-hex-map__label {
    transition:
      transform 240ms ease-out,
      fill 240ms ease-out,
      stroke 240ms ease-out;
  }

  /* Pointer affordance only — the tile lifts a little further under the
     cursor, using the same single scalar the state machine uses, so hover and
     confirm cannot drift into two different motions. */
  .firma2-setup-hex-map__tile-link {
    cursor: pointer;
  }

  .firma2-setup-hex-map__tile-link:hover .firma2-setup-hex-map__hex {
    --hex-lift: calc(var(--hex-lift-base) + 0.22);
  }

  /* -------------------------------------------------------------------------
     Legend
     ------------------------------------------------------------------------- */

  .firma2-setup-hex-map__legend,
  .firma2-setup-hex-map__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .firma2-setup-hex-map__legend-item {
    align-items: center;
    color: var(--color-content-default-secondary);
  }

  .firma2-setup-hex-map__swatch {
    display: block;
    inline-size: 1.4em;
    block-size: auto;
    flex-shrink: 0;
  }

  /* -------------------------------------------------------------------------
     The screen-reader list
     ------------------------------------------------------------------------- */

  .firma2-setup-hex-map__list {
    position: relative;
  }

  .firma2-setup-hex-map__item-link {
    color: var(--color-content-link);
  }

  /* -------------------------------------------------------------------------
     Motion and forced colours
     ------------------------------------------------------------------------- */

  @media (prefers-reduced-motion: reduce) {
    .firma2-setup-hex-map__top,
    .firma2-setup-hex-map__side,
    .firma2-setup-hex-map__face,
    .firma2-setup-hex-map__label {
      transition: none;
    }
  }

  /* forced-colors does not touch SVG fill/stroke, so a board left alone here
     keeps its author colours against a system background it was never measured
     against. Declared explicitly instead: the tiles flatten to the system
     surface, the outlines carry the shape, and a confirmed tile takes the
     system's own Highlight pair. The states stop being distinguishable by
     colour at that point, which is precisely why the word-for-word list above
     is not optional. */
  @media (forced-colors: active) {
    .firma2-setup-hex-map__face {
      fill: Canvas;
      stroke: CanvasText;
    }

    .firma2-setup-hex-map__side {
      fill: Canvas;
      stroke: CanvasText;
      stroke-width: 1;
    }

    .firma2-setup-hex-map__label {
      fill: CanvasText;
    }

    .firma2-setup-hex-map [data-status='confirmed'] .firma2-setup-hex-map__face {
      fill: Highlight;
    }

    .firma2-setup-hex-map [data-status='confirmed'] .firma2-setup-hex-map__label {
      fill: HighlightText;
    }
  }
</style>

<script>
  // The board's only source of truth. journeyStatuses() re-derives every
  // journey's state from the stored draft on each call, so this file never
  // holds state of its own — it paints what the draft says, now.
  import { journeyStatuses } from '../../lib/setup-draft';
  import type { JourneyKey, JourneyStatus } from '../../data/firma2-setup';

  const STATUS_LABEL: Record<JourneyStatus, string> = {
    untouched: 'Not started',
    suggested: 'Suggested',
    'in-progress': 'In progress',
    confirmed: 'Confirmed',
  };

  const paint = (): void => {
    const statuses = journeyStatuses();

    document.querySelectorAll<SVGGElement>('.firma2-setup-hex-map__hex').forEach((hex) => {
      const key = hex.dataset.journey as JourneyKey | undefined;
      const progress = key ? statuses[key] : undefined;
      if (!progress) return;
      hex.setAttribute('data-status', progress.status);
    });

    document.querySelectorAll<HTMLLIElement>('.firma2-setup-hex-map__item').forEach((item) => {
      const key = item.dataset.journey as JourneyKey | undefined;
      const progress = key ? statuses[key] : undefined;
      if (!progress) return;
      const status = item.querySelector<HTMLElement>('.firma2-setup-hex-map__item-status');
      if (status) status.textContent = `: ${STATUS_LABEL[progress.status]}`;
    });
  };

  paint();
  document.addEventListener('setup-draft-change', paint);
</script>
