---
// The stepped-flow shell: the milestone's steps in a rail on the left, one
// screen at a time beside it, the current step in the URL. Start wrote the
// one-screen walk for itself (firma2-setup-start-steps); this is the same walk
// with the Start-specific parts removed, so any milestone can be stepped
// without a navigation script of its own. Andy, 2026-09-18: "make funding
// sources a multi-step thing", then "can the multi-step stuff happen on orgs
// too?"
//
// THE RAIL REPLACED THE ARROWS. Andy, 2026-09-24: "I'm not loving our
// paging/arrows per milestone ... For each milestone, you should see the steps
// you're completing, and be able to traverse backwards (and forwards?)
// easily." So the ghost back arrow above the screen is gone (a rail row is the
// way back), and each screen's advance button names the step it leads to. The
// rail is firma2-setup-step-rail; this shell renders it, so a page never does.
//
// THE CONTRACT. Pass `steps`, `{ id, label }[]` in walking order; `stepIds`
// alone still works and labels each step from its id, and `steps` wins when
// both are given. Children are screens: any descendant with
// `data-step="<id>"`, one per step. The shell shows one, hides the rest, and
// wires three gestures by delegation: [data-step-next] and [data-step-skip]
// advance, [data-step-go="<id>"] (a rail row) jumps to any step already
// reached. A screen says whether it is answered by setting
// `data-step-ready="false"` on itself (absent means ready); the shell disables
// Next and shows the ghost skip while it is false, and re-reads it on every
// attribute change, so a screen never has to know about the shell. Each show
// writes `data-step-current` on the root and dispatches `setup-step-show`
// with `{ step }`, which the rail follows and a screen that must build
// something only once it has a width (an AG Grid) can listen for.
//
// NEXT NAMES THE NEXT STEP. A screen's advance slot holds
// firma2-setup-step-next; the shell writes "Next: <label>" into every
// [data-step-next-label] on load, from the step list only it has. A screen
// still on the old icon-only arrow keeps working as an arrow.
//
// POSITION IS THE URL, `?step=<id>`, exactly as Start does it: the first step
// carries no param, Back and Forward work through popstate, and a reload lands
// on the same screen. Nothing about position is written to the draft store,
// because the answers are the record; which screen was open is not.
//
// THE LAST SCREEN HAS NO NEXT. Its button is a link (to the hub), so the walk
// ends in navigation the shell does not own.
//
// THE LAYOUT is the .sidebar primitive: the rail is the aside, the screens
// take the rest and keep their centred composition. Below the point where the
// screens would drop under two thirds of the column the sidebar wraps, the
// rail goes above the screen and turns itself into one line.
import Firma2SetupStepRail from './firma2-setup-step-rail.astro';
import { resolveSetupSteps } from '../../lib/setup-steps';
import type { SetupStep } from '../../lib/setup-steps';
import '../shared/firma2-setup-steps.css';

interface Props {
  /** The walk, in order, with each step's rail label. The first is the entry and carries no URL param. */
  steps?: SetupStep[];
  /** Fallback for a page not yet given labels: ids in walking order, labelled from the id. */
  stepIds?: string[];
}

const { steps: givenSteps, stepIds } = Astro.props;
const steps = resolveSetupSteps(givenSteps, stepIds);
---
<div
  class="firma2-setup-steps firma2-setup-steps--railed sidebar"
  data-setup-steps
  data-step-ids={steps.map((step) => step.id).join(',')}
  data-step-current={steps[0]?.id}
>
  <Firma2SetupStepRail steps={steps} />
  <!-- The sidebar primitive reads its first and last children: the rail, then
       this column. The step list rides inside the column for that reason. -->
  <div class="firma2-setup-steps__main">
    <slot />
    <script type="application/json" data-step-list set:html={JSON.stringify(steps)}></script>
  </div>
</div>

<script>
  import { nextLabel } from '../../lib/setup-steps';
  import type { SetupStep } from '../../lib/setup-steps';

  const root = document.querySelector<HTMLElement>('[data-setup-steps]');

  if (root) {
    const steps: SetupStep[] = JSON.parse(root.querySelector('[data-step-list]')?.textContent ?? '[]');
    const stepIds = steps.map((step) => step.id);
    const screens = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));

    const stepFromUrl = (): string => {
      const wanted = new URLSearchParams(location.search).get('step') ?? '';
      return stepIds.includes(wanted) ? wanted : stepIds[0];
    };

    let current = stepFromUrl();

    const screenFor = (id: string): HTMLElement | undefined => screens.find((screen) => screen.dataset.step === id);

    // Each screen's Next says where it goes. Written once: the step list never changes on a page.
    steps.forEach((step, i) => {
      const next = steps[i + 1];
      if (!next) return;
      screenFor(step.id)
        ?.querySelectorAll<HTMLElement>('[data-step-next-label]')
        .forEach((label) => (label.textContent = nextLabel(next)));
    });

    /** Absent means ready: a screen with nothing to answer never has to say so. */
    const ready = (id: string): boolean => screenFor(id)?.dataset.stepReady !== 'false';

    const setNext = (id: string): void => {
      const screen = screenFor(id);
      if (!screen) return;
      const ok = ready(id);
      const next = screen.querySelector<HTMLButtonElement>('[data-step-next]');
      if (next) {
        next.disabled = !ok;
        next.closest('.esa-button')?.classList.toggle('esa-button--disabled', !ok);
      }
      const skip = screen.querySelector<HTMLElement>('[data-step-skip]');
      if (skip) skip.hidden = ok;
    };

    const show = (id: string, push: boolean): void => {
      current = id;
      for (const screen of screens) screen.hidden = screen.dataset.step !== id;
      const index = stepIds.indexOf(id);
      setNext(id);

      const url = new URL(location.href);
      if (index === 0) url.searchParams.delete('step');
      else url.searchParams.set('step', id);
      if (push) history.pushState({ step: id }, '', url);
      else history.replaceState({ step: id }, '', url);

      root.dataset.stepCurrent = id;
      root.dispatchEvent(new CustomEvent('setup-step-show', { detail: { step: id }, bubbles: true }));
      screenFor(id)?.querySelector<HTMLElement>('.firma2-setup-steps__prompt')?.focus();
    };

    const move = (delta: number): void => {
      const index = stepIds.indexOf(current) + delta;
      if (index < 0 || index >= stepIds.length) return;
      show(stepIds[index], true);
    };

    root.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      const go = target.closest<HTMLElement>('[data-step-go]');
      if (go) {
        // The rail marks steps not yet reached; they stay where they are.
        const id = go.dataset.stepGo ?? '';
        if (go.getAttribute('aria-disabled') !== 'true' && stepIds.includes(id) && id !== current) show(id, true);
        return;
      }
      if (target.closest('[data-step-next]')) move(1);
      else if (target.closest('[data-step-skip]')) move(1);
    });

    // A screen reports its readiness by attribute; the shell only ever reads it.
    const readiness = new MutationObserver(() => setNext(current));
    for (const screen of screens) readiness.observe(screen, { attributes: true, attributeFilter: ['data-step-ready'] });

    window.addEventListener('popstate', () => show(stepFromUrl(), false));

    show(current, false);
  }
</script>
