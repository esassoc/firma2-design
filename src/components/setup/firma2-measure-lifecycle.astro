---
// firma2-measure-lifecycle — the measure's status, and every transition out of
// it, in the page header's actions cluster (the canon position: the project
// page's "Edit project" lives in the same spot).
//
// THE MODEL. A measure is a standing question, so its lifecycle is about what
// happens to the ASKING, and each status offers exactly the transitions that
// are honest for it:
//   Draft   → Publish (primary; the page's goal state) · Delete draft (the
//             only deletable state — nothing has been asked of anyone yet)
//   Active  → Retire (stop asking; entries already filed stay in reports —
//             which is why an active measure can never be DELETED)
//   Retired → Reactivate (start asking again)
//
// PUBLISH IS GATED, AND THE GATE IS VISIBLE. The button is disabled while
// outstandingFields() reports gaps — genuine unavailability, not "not wired
// yet", so disabled is the honest treatment — and the readiness line rendered
// beside this cluster ("3 settings needed before publishing") is the
// explanation, kept live by the same function that gates the button. One
// opinion about readiness, three renders (line, claim blanks, this gate).
//
// CONFIRMS. Retire and Delete get esa-confirm-dialog — one stops data
// collection on every project, the other discards work — with the CONSEQUENCE
// as the message, per that lego's own contract. Publish confirms nothing: it
// is the goal state and Retire is its undo. Reactivate likewise.
//
// THE PILL LIVES HERE because this component owns the status: pill, buttons
// and dialogs are three renders of one fact, and splitting the pill into the
// page while the transitions lived here is how the two drift. The
// visually-hidden "Status" is load-bearing — a pill reading "Draft" is
// unambiguous beside a title only because of where it sits.
//
// WIRING — the zone pattern (see measure-editor.ts):
//   [data-firma2-measure-lifecycle]  the root; data-status is the truth
//   readStatus() / setStatus(next)   expandos for the controller
//   firma2-status-change             bubbling, on every user transition —
//                                    the controller publishes and persists on it
// DELETE is the one act that bypasses the controller: it clears the local
// draft and leaves for the catalog. There is no backend, so "delete" cannot
// remove a build-time seed — for the seeded blank drafts it correctly resets
// them to "Untitled measure"; a real app deletes the record here.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaPill from '@esa/ecology/esa-pill.astro';
import {
  MEASURE_STATUS_TONE,
  isReadyToPublish,
} from '../../data/firma2-performance-measures';
import type { PerformanceMeasureDefinition } from '../../data/firma2-performance-measures';
import { withBase } from '../../lib/base';

interface Props {
  measure: PerformanceMeasureDefinition;
}

const { measure } = Astro.props;
---
<div
  class="firma2-measure-lifecycle cluster"
  data-gap="sm"
  data-firma2-measure-lifecycle
  data-status={measure.status}
  data-catalog-href={withBase('/prototypes/performance-measures')}
>
  <span class="visually-hidden">Status</span>
  <EsaPill
    label={measure.status}
    variant={MEASURE_STATUS_TONE[measure.status]}
    size="md"
    removable={false}
  />

  <!-- Windows order: tertiary far left of the group, primary rightmost.
       display:contents wrappers so a hidden action leaves no phantom flex item
       doubling the cluster's gap.

       CHROME, NOT SECONDARY, on the two state changes — and the reason is the
       pill they stand beside. `secondary` fills with
       --color-background-brand-muted, a green tint at the same size and radius
       as the status pill one gap to its left, so a STATUS and an ACTION
       rendered as siblings: the header read as two pills, one of which
       happened to be clickable. Chrome is also the honest weight for what
       these do. Retiring a measure stops a question being asked of every
       project from here on; it is rare, consequential, and never the thing
       the page is recommending — a tinted fill sells it as advice. The one
       action that IS recommended keeps its fill: Publish, on a draft. -->
  <span class="firma2-measure-lifecycle__action" data-when="Retired">
    <EsaButton variant="chrome" data-lifecycle="reactivate">Reactivate</EsaButton>
  </span>
  <span class="firma2-measure-lifecycle__action" data-when="Active">
    <EsaButton variant="chrome" data-lifecycle="retire">Retire</EsaButton>
  </span>
  <span class="firma2-measure-lifecycle__action" data-when="Draft">
    <EsaButton variant="chrome" data-lifecycle="delete">Delete draft</EsaButton>
  </span>
  <span class="firma2-measure-lifecycle__action" data-when="Draft">
    <EsaButton
      variant="primary"
      data-lifecycle="publish"
      disabled={!isReadyToPublish(measure)}
    >Publish</EsaButton>
  </span>

  <!-- The confirms ride in the cluster but render in the top layer when open;
       at rest they are display:none dialogs and cost the header nothing. -->
  <esa-confirm-dialog
    data-confirm="retire"
    heading="Retire this measure?"
    message="Projects stop being asked this question. Entries already filed stay in every report."
    confirm-label="Retire measure"
    variant="warning"
  ></esa-confirm-dialog>
  <esa-confirm-dialog
    data-confirm="delete"
    heading="Delete this draft?"
    message="Removes the draft and everything entered so far. No project has reported against it."
    confirm-label="Delete draft"
    variant="danger"
  ></esa-confirm-dialog>
</div>

<style>
  /* Visibility is CSS reading the root's own data-status — the script flips
     one attribute and every action follows; there is no per-button show/hide
     to leave half-done. display:contents keeps the visible buttons as direct
     cluster items. */
  .firma2-measure-lifecycle__action {
    display: none;
  }
  .firma2-measure-lifecycle[data-status='Draft'] .firma2-measure-lifecycle__action[data-when='Draft'],
  .firma2-measure-lifecycle[data-status='Active'] .firma2-measure-lifecycle__action[data-when='Active'],
  .firma2-measure-lifecycle[data-status='Retired'] .firma2-measure-lifecycle__action[data-when='Retired'] {
    display: contents;
  }
</style>

<script>
  import '@esa/ecology/esa-confirm-dialog';
  import {
    MEASURE_STATUS_TONE,
    outstandingFields,
    type MeasureStatus,
    type PerformanceMeasureDefinition,
  } from '../../data/firma2-performance-measures';
  import { clearDraft, MEASURE_CHANGE_EVENT, type MeasureChangeDetail } from '../../lib/measure-draft';

  type ConfirmDialog = HTMLElement & { open?: boolean };
  const STATUSES: MeasureStatus[] = ['Active', 'Draft', 'Retired'];

  function init(root: HTMLElement): void {
    const pillLabel = root.querySelector<HTMLElement>('.esa-pill__label');
    const pill = root.querySelector<HTMLElement>('.esa-pill');
    const publish = root.querySelector<HTMLButtonElement>('[data-lifecycle="publish"]');

    const status = (): MeasureStatus =>
      (STATUSES as string[]).includes(root.dataset.status ?? '')
        ? (root.dataset.status as MeasureStatus)
        : 'Draft';

    /** One truth (data-status), three renders: the CSS reads it for the
        buttons, this repaints the pill, and the controller reads it back. */
    const paint = (): void => {
      const s = status();
      if (pillLabel) pillLabel.textContent = s;
      if (pill) {
        STATUSES.forEach((v) => pill.classList.remove(`esa-pill--${MEASURE_STATUS_TONE[v]}`));
        pill.classList.add(`esa-pill--${MEASURE_STATUS_TONE[s]}`);
      }
    };

    const setStatus = (next: MeasureStatus, announce: boolean): void => {
      if (status() === next) return;
      root.dataset.status = next;
      paint();
      if (announce) {
        root.dispatchEvent(new CustomEvent('firma2-status-change', { bubbles: true }));
      }
    };

    const confirmThen = (which: string, act: () => void): void => {
      const dialog = root.querySelector<ConfirmDialog>(`[data-confirm="${which}"]`);
      if (!dialog) return;
      dialog.addEventListener(
        'resolved',
        (event) => {
          if ((event as CustomEvent<{ confirmed?: boolean }>).detail?.confirmed) act();
        },
        { once: true },
      );
      dialog.open = true;
    };

    root.addEventListener('click', (event) => {
      const act = (event.target as Element).closest<HTMLElement>('[data-lifecycle]');
      if (!act) return;
      switch (act.dataset.lifecycle) {
        case 'publish':
          setStatus('Active', true);
          break;
        case 'reactivate':
          setStatus('Active', true);
          break;
        case 'retire':
          confirmThen('retire', () => setStatus('Retired', true));
          break;
        case 'delete':
          confirmThen('delete', () => {
            // The one transition with no record to keep: drop the local draft
            // and leave. The build-time seed cannot be removed without a
            // backend — the module header owns that caveat.
            const slug = root
              .closest('[data-firma2-measure-root]')
              ?.getAttribute('data-firma2-measure-root');
            if (slug) clearDraft(slug);
            window.location.assign(root.dataset.catalogHref ?? '..');
          });
          break;
      }
    });

    // THE GATE tracks the record through the same event every panel reads —
    // outstandingFields() is the one opinion about readiness, and the
    // readiness line beside this cluster renders the same count as the
    // explanation for the disabled state.
    //
    // THREE FLAGS, NOT ONE. esa-button's disabled state is the native
    // `disabled` PLUS an `esa-button--disabled` class on its wrapper — and the
    // wrapper class is the one that kills pointer events, so flipping only the
    // native re-enables the button in the DOM while every click still falls
    // through to the cluster behind it (found by an intercepted real click in
    // verification, invisible to a synthetic .click()). aria-disabled rides
    // along because the lego renders it in step.
    document.addEventListener(MEASURE_CHANGE_EVENT, (event) => {
      const { measure } = (event as CustomEvent<MeasureChangeDetail>).detail ?? {};
      if (!measure || !publish) return;
      const blocked = outstandingFields(measure as PerformanceMeasureDefinition).length > 0;
      publish.disabled = blocked;
      if (blocked) publish.setAttribute('aria-disabled', 'true');
      else publish.removeAttribute('aria-disabled');
      publish.closest('.esa-button')?.classList.toggle('esa-button--disabled', blocked);
    });

    // The controller's zone contract — read on every publish, set on restore.
    (root as HTMLElement & { readStatus?: () => MeasureStatus }).readStatus = status;
    (root as HTMLElement & { setStatus?: (next: MeasureStatus) => void }).setStatus = (next) =>
      setStatus(next, false);
  }

  document.querySelectorAll<HTMLElement>('[data-firma2-measure-lifecycle]').forEach(init);
</script>
