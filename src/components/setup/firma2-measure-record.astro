---
// firma2-measure-record — WHAT THIS MEASURES. The block being built: the
// primary subcategory plus the amount and the counting rule — the measure
// itself, as opposed to the attributes recorded about each entry
// (firma2-measure-attributes).
//
// This section holds the record's core, which the page used to scatter across
// two containers: the primary category lived in the dimension list as one row
// with a radio on it, and the amount (quantity, unit, decimals) plus the
// counting rule lived in the metadata band, filed between the program picker
// and the prose. Neither home was right. For an output, an entry IS
// "what was done" plus "how much", combined by the counting rule — the data
// module states it outright ("you cannot report '20 acres' without saying what
// you did") — so those fields are one object and they render as one object,
// on one surface.
//
// THE PRIMARY IS STRUCTURAL NOW, NOT A FLAG YOU SET. The old editor marked the
// primary with a native radio on each reported row: the single most defining
// choice about a measure, rendered as row trim, legible only to an author who
// already understood the model. Here the primary category is a PLACE — this
// block — and whatever is declared in it is the primary. That deletes the whole
// radio apparatus (the bespoke control, its per-instance group renaming, its
// aria-labels, the "no primary now" announcement): mutual exclusion is now
// enforced by there being exactly one slot, which no script can get wrong.
//
// THE BLOCK IS PERMANENT — no remove button. Emptying its fields IS removing
// the primary: readPrimaryDimension() then reports null and outstandingFields()
// flags the measure, exactly as it did when a radio went unchecked. A trash can
// on a required slot would offer to delete a hole.
//
// WHAT THIS COSTS, stated: a supporting question can no longer be MADE primary
// by clicking a radio on its row. You retype (or cut and paste) its name and
// options here. Two fields instead of one click — but the radio's flexibility
// was exactly what buried the concept, and promotion is a rare act on a field
// that should almost never change after entries exist.
//
// AN OUTCOME RENDERS NO CATEGORY SUB-FORM AT ALL — absent, not disabled. An
// outcome has no actor: nobody "did" a water temperature, so there is no
// "what was done" to author. Its record is the reading itself — quantity, unit,
// decimals, rule — and that is what this section shows. The flag is
// measureKind().requiresPrimaryDimension, read once here and never re-derived
// from the kind string, so this section and outstandingFields() cannot
// disagree about what blocks a measure publishing.
//
// THE OPTIONS ARE A LIST, NOT A BAG OF CHIPS. This section used esa-input-tag
// for the category's vocabulary and now composes bcn-option-list — one editable
// row per option with a self-extending blank row at the foot. That component's
// header states the four faults it fixes; the short version is that a chip
// cannot be corrected, only destroyed, which is the one thing this product has
// decided it will not make people do.
//
// CONTRACTS — consumed by src/lib/measure-editor.ts:
//   .firma2-measure-record                       the root class it queries
//   readPrimaryDimension(): MeasureDimension|null  expando; null means "no
//                                                  primary declared" (also the
//                                                  constant answer on outcomes)
//   setPrimaryDimension(d | null)                expando; null CLEARS the
//                                                  fields, so a draft whose
//                                                  author deleted the primary
//                                                  restores without
//                                                  resurrecting the seed's
//   firma2-dimensions-change                     bubbled after a programmatic
//                                                  set has SETTLED, so the
//                                                  controller's publish never
//                                                  reads a half-built primary
// The field ids fmc-quantity / fmc-unit / fmc-decimals / fmc-rule are the same
// contract they were in the band: measure-editor.ts reads them by id, and they
// moved here without renaming.
//
// ONE CONTROL SIZE: md, everywhere, no exceptions.
import BcnOptionList from '../shared/bcn-option-list.astro';
import type { PerformanceMeasureDefinition } from '../../data/firma2-performance-measures';
import {
  COUNTING_RULES,
  measureKind,
  primaryDimension,
} from '../../data/firma2-performance-measures';

interface Props {
  /** The measure being configured. Every field on it may be empty or unset. */
  measure: PerformanceMeasureDefinition;
}

const { measure } = Astro.props;

// The ONE consequence of the output/outcome fork here, resolved once.
const requiresPrimary = measureKind(measure.kind).requiresPrimaryDimension;
const primary = primaryDimension(measure);

// The chosen rule's record: the field's help line shows the current rule's
// DESCRIPTION (the record stores an id, and "latest-per-place" would be the
// database talking). Undefined on a draft, which is correct: nothing is
// preselected, because a guessed counting rule is a wrong program total nobody
// chose.
const selectedRule = COUNTING_RULES.find((r) => r.id === measure.countingRule);

// THE COUNTING-RULE DESCRIPTIONS, SERIALISED FOR THE CLIENT. The rules are the
// hardest choice on this screen and they are genuinely not distinguishable from
// their names — "Sum every entry" and "Union the mapped extent" both sound like
// totalling acres, and the difference is whether ground treated twice counts
// twice. esa-select's option type is `{label, value, disabled}` with no
// description slot (filed as a hub gap), so the description is the field's help
// text and it SWAPS with the selection. Serialised as data rather than re-typed
// in the script, because two copies of one sentence is one copy that drifts.
// The map covers ALL the rules while the options cover only this kind's: the
// option list decides what can be chosen, the map only has to explain whatever
// is currently set.
const ruleHelpUnset = 'How entries combine into one program total.';
const ruleDescriptions = JSON.stringify(
  Object.fromEntries(COUNTING_RULES.map((r) => [r.id, r.description]))
);

// Copy. The category's help line is the one sentence that places the field in
// the model: its value becomes the opening question on every entry form, which
// the entry-form preview in the rail renders as the first box.
const HEADING = 'What this measures';
const CATEGORY_LABEL = 'Primary subcategory';
const CATEGORY_HELP = 'The first question on every entry: what was done.';
const OPTIONS_LABEL = 'Options';
---

<section
  class="firma2-measure-record stack"
  data-gap="md"
  aria-labelledby="firma2-measure-record-heading"
  data-requires-primary={requiresPrimary ? '' : undefined}
>
  <!-- NAMED, NOT TITLED — the same call firma2-measure-definition makes one
       section up, for the same reason. This block is the first thing under the
       page header, which already names the measure, and its contents are
       visible in full: a caption reading "What this measures" over a form whose
       first field says "Primary subcategory" is a label on something the reader
       can already see the whole of.

       IT STAYS AN <h2>, hidden rather than deleted. The name still has to exist
       — a screen-reader user choosing between this section, "Other
       subcategories" and the two previews navigates by the heading list, and
       removing the element would leave an unnamed region and a gap in that
       list. `.visually-hidden` is a11y.css's clip-rect pattern; the string is
       unchanged. -->
  <h2 id="firma2-measure-record-heading" class="visually-hidden">{HEADING}</h2>

  <!-- bcn-lego-checked: the block's SURFACE is one step down the neutral
       elevation ramp — the same sunken treatment the definition band gave its
       quantity field, widened to the whole record now that the record is one
       object. Checked Ecology: esa-card is the raised white card and esa-container
       a neutral frame; neither is the sunken step, and design-principles owns
       the three-surface value ramp this reads from. No new primitive — padding,
       radius and a background token on a layout stack. -->
  <div class="firma2-measure-record__block stack" data-gap="lg">
    {requiresPrimary && (
      <!-- THE CATEGORY — the reported-row form shape from the old editor, minus
           the radio (structural now) and minus the trash (permanent slot).
           `.switcher` at the primitive's default 32rem threshold, which fires in
           this column: name and options sit side by side at 1440px and stack on
           a narrow page. -->
      <div class="firma2-measure-record__category switcher" data-gap="sm">
        <esa-text-field
          class="firma2-measure-record__category-name"
          label={CATEGORY_LABEL}
          size="md"
          value={primary?.name ?? ''}
          placeholder="e.g. Treatment type"
          help-text={CATEGORY_HELP}
        ></esa-text-field>

        <!-- ONE ROW PER OPTION, each correctable in place, with a blank row at
             the foot that becomes the next one as you type. It replaced
             esa-input-tag, whose four faults bcn-option-list itemises — the one
             that mattered here is that a chip cannot be EDITED, so fixing a
             typo in "Invasive removal" meant destroying it and retyping.
             The help line went with it: it read "Press Enter after each
             option", and a control that has to teach its own keystroke is the
             wrong control rather than an under-explained one. -->
        <BcnOptionList
          class="firma2-measure-record__category-options"
          label={OPTIONS_LABEL}
          options={primary?.options ?? []}
          placeholder="e.g. Planting"
        />
      </div>
    )}

    <!-- THE AMOUNT. Quantity is authored English naming what this program
         counts — a text field, not a select, because the catalog's quantities
         are five different phrases and none would survive a closed list. Its
         help line states the format and pre-empts the one error it invites:
         writing the unit into the quantity, which would then be stated twice
         and could disagree with the Unit field.

         UNIT IS A CLOSED LIST, and the reasoning is the data module's: an open
         unit list cannot be AGGREGATED. Free text produces "acres", "Acres",
         "ac" and "acre" as four distinct units, and the moment two measures in
         a program disagree about the spelling, no total across them is
         computable at all.

         IT DOES NOT FORK ON KIND, and that is a decision rather than an
         oversight: a monitoring effort measuring tons of sediment is an outcome
         carrying an output's unit, and a filtered list would tell that author
         the product cannot describe their measure. The kind constrains what a
         measure MEANS; it does not constrain what it can be measured in.

         DECIMAL PLACES is not in outstandingFields() and not `required`: 0 is a
         real, complete answer and every record carries one. -->
    <div class="firma2-measure-record__amount grid" data-gap="md">
      <esa-text-field
        id="fmc-quantity"
        label="Quantity"
        required
        size="md"
        value={measure.quantity}
        placeholder="e.g. Treated extent"
        help-text="What is counted, without its unit. 'Treated extent', not 'acres treated'."></esa-text-field>

      <esa-select
        id="fmc-unit"
        label="Unit"
        required
        size="md"
        placeholder="Select a unit"
        data-initial={measure.unit ?? ''}
        help-text="Fixed list. Units outside it cannot be totalled across measures."></esa-select>

      <esa-select
        id="fmc-decimals"
        label="Decimal places"
        size="md"
        placeholder="Select 0 to 3"
        data-initial={String(measure.decimalPlaces)}
        help-text="Rounds every reported value to this precision."></esa-select>
    </div>

    <!-- THE COUNTING RULE — on its own row, capped, with the swapping help
         line. It is the most consequential setting in this section: "1,240
         acres" is ambiguous between effort delivered and ground in a condition
         until it is answered, and changing it later silently changes what every
         historical total means.

         THE OPTIONS ARE THE KIND'S, NOT THE CATALOGUE'S. countingRulesFor()
         hands an output three rules and an outcome two; the list is built in
         the client script from `data-kind`, which rides on the SELECT so the
         element that gets the filtered options carries the fact the filter is
         made from. No disabled options, no "not available for outcomes" note —
         an outcome author never learns that Sum exists, because summing water
         temperatures is not a choice they made wrongly.

         `countingRule` is optional on the record and undefined on a fresh
         draft, so this renders unset rather than pre-picking Sum. -->
    <div class="firma2-measure-record__rule">
      <esa-select
        id="fmc-rule"
        label="Counting rule"
        required
        size="md"
        placeholder="Select a counting rule"
        data-initial={measure.countingRule ?? ''}
        data-kind={measure.kind}
        data-help-unset={ruleHelpUnset}
        data-descriptions={ruleDescriptions}
        help-text={selectedRule?.description ?? ruleHelpUnset}></esa-select>
    </div>
  </div>
</section>

<style>
  /* The record's surface: one step DOWN the neutral elevation ramp, never a
     tint. It lifts the white field boxes forward and makes the section read as
     one object — the thing the page exists to build. The radius is the same
     step esa-card uses, so this filled block agrees with every other filled
     block on the screen. */
  .firma2-measure-record__block {
    padding: var(--spacing-400, 1rem);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--color-background-elevation-sunken, #f5f5f5);
  }

  /* No rule for the h2: it is `.visually-hidden` now, so its margin and colour
     style a box that is 1px and clipped. */

  /* 14rem is the width below which "Decimal places" wraps its own label —
     the layout primitive's documented knob, set where the layout is declared. */
  .firma2-measure-record__amount {
    --grid-min: 14rem;
  }

  /* The counting rule is CAPPED, not stretched: its help line is a full
     sentence that swaps with the selection, and a sentence set across the whole
     column is a line nobody's eye can return from. */
  .firma2-measure-record__rule {
    max-inline-size: 30rem;
  }
</style>

<script>
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-text-field';

  import { hydrateSelect, identityOptions, type EsaOption } from '../../lib/hydrate-select';
  import type { MeasureDimension, MeasureKind } from '../../data/firma2-performance-measures';
  import { UNITS, countingRulesFor } from '../../data/firma2-performance-measures';

  // Decimal places is the one vocabulary with no home in the data module,
  // because it is not a vocabulary — it is a range. 0 through 3 covers every
  // measure in the catalog with headroom.
  const DECIMAL_PLACES: EsaOption[] = ['0', '1', '2', '3'].map((v) => ({ label: v, value: v }));

  const root = document.querySelector<HTMLElement>('.firma2-measure-record');

  type TagField = HTMLElement & { value?: string[]; updateComplete?: Promise<unknown> };
  type TextField = HTMLElement & { value?: string };

  const nameField = (): TextField | null =>
    root?.querySelector<TextField>('.firma2-measure-record__category-name') ?? null;
  const optionsField = (): TagField | null =>
    root?.querySelector<TagField>('.firma2-measure-record__category-options') ?? null;

  // NO SEEDING PASS. esa-input-tag needed one — an array cannot survive the trip
  // through markup, so the server wrote JSON into a data attribute and this
  // script parsed it back onto the property. bcn-option-list takes `options` as
  // a real Astro prop and PRINTS a row per value, so the authored vocabulary is
  // in the markup before any script runs and there is nothing to rehydrate.

  customElements.whenDefined('esa-select').then(() => {
    hydrateSelect('fmc-unit', identityOptions(UNITS));
    hydrateSelect('fmc-decimals', DECIMAL_PLACES);

    // The counting rules are filtered by kind — "Sum every entry" is not a
    // setting an outcome picked wrongly, it is a sentence about water
    // temperature that does not parse. countingRulesFor() owns the filter. The
    // narrowing is exhaustive over MeasureKind rather than a coerce-to-output:
    // the fallback is unreachable from anything this component renders, and if
    // it ever fires an outcome is being offered "Sum every entry" — a bug to
    // fix, not a state to design for.
    const ruleEl = document.getElementById('fmc-rule');
    const kindAttr = ruleEl?.dataset.kind;
    const kind: MeasureKind =
      kindAttr === 'outcome' || kindAttr === 'output' ? kindAttr : 'output';
    hydrateSelect(
      'fmc-rule',
      countingRulesFor(kind).map((r) => ({ label: r.name, value: r.id }))
    );
    wireCountingRuleHelp();
  });

  /**
   * THE COUNTING RULE EXPLAINS ITSELF IN PLACE. Both the descriptions and the
   * unset line come from data attributes the SERVER wrote out of
   * COUNTING_RULES; nothing in this script owns a copy of either, which is the
   * only way the sentence under the field and the sentence in the data module
   * cannot drift apart.
   */
  function wireCountingRuleHelp(): void {
    const rule = document.getElementById('fmc-rule') as
      | (HTMLElement & { helpText: string })
      | null;
    if (!rule) return;

    const unset = rule.dataset.helpUnset ?? '';
    let descriptions: Record<string, string> = {};
    try {
      descriptions = JSON.parse(rule.dataset.descriptions ?? '{}');
    } catch {
      descriptions = {};
    }

    // esa-select emits a bubbling `change` carrying the new value in `detail` —
    // the shadow-DOM listbox's own events never escape, so this is the only
    // handle on the choice.
    rule.addEventListener('change', (event) => {
      const value = (event as CustomEvent<{ value: string }>).detail?.value ?? '';
      rule.helpText = descriptions[value] ?? unset;
    });
  }

  /**
   * THE PRIMARY, READ BACK. Null when the sub-form is absent (an outcome) or
   * both fields are empty (the author removed the primary).
   *
   * `primary: true` IS CLAIMED ONLY WHEN THE NAME IS NON-EMPTY. The flag is
   * what satisfies outstandingFields()'s publish gate, and options typed under
   * a nameless category must not satisfy it silently — the entry form would
   * open on an unlabelled question and the breakdown chart would title an axis
   * with an empty string. The half-declared work still survives (the dimension
   * is returned, unflagged), the gate just stays honest.
   */
  function readPrimaryDimension(): MeasureDimension | null {
    if (!root || root.dataset.requiresPrimary === undefined) return null;
    const name = (nameField()?.value ?? '').trim();
    const rawOptions = optionsField()?.value;
    const options = Array.isArray(rawOptions)
      ? rawOptions.map((o) => o.trim()).filter(Boolean)
      : [];
    if (!name && options.length === 0) return null;
    const dimension: MeasureDimension = { name, source: { kind: 'reported' } };
    if (options.length > 0) dimension.options = options;
    if (name) dimension.primary = true;
    return dimension;
  }

  /**
   * THE PRIMARY, RESTORED. Null CLEARS the fields — a stored draft whose
   * author deleted the primary must not resurrect the seed's on reload.
   *
   * IT EMITS ONLY AFTER EVERYTHING HAS SETTLED, then one frame later — the
   * same discipline the old editor's setDimensions() carried, for the same
   * shipped bug: the controller publishes on this event, and publishing while
   * the tag field is still rendering hands every preview a primary with empty
   * options until the next keystroke.
   */
  async function setPrimaryDimension(dimension: MeasureDimension | null): Promise<void> {
    if (!root || root.dataset.requiresPrimary === undefined) return;
    await Promise.all([
      customElements.whenDefined('esa-text-field'),
      customElements.whenDefined('bcn-option-list'),
    ]);
    const name = nameField();
    const opts = optionsField();
    if (name) name.value = dimension?.name ?? '';
    if (opts) {
      await Promise.resolve(opts.updateComplete);
      opts.value = [...(dimension?.options ?? [])];
      await Promise.resolve(opts.updateComplete);
    }
    await new Promise((resolve) => requestAnimationFrame(resolve));
    root.dispatchEvent(
      new CustomEvent('firma2-dimensions-change', {
        bubbles: true,
        detail: { dimensions: readPrimaryDimension() ? [readPrimaryDimension()] : [] },
      })
    );
  }

  // The expandos are installed even on an outcome, where readPrimaryDimension
  // is constantly null — the controller distinguishes "component absent"
  // (undefined from the optional chain, fall back to the seed) from "no
  // primary" (null, a real answer), and an outcome must give the real answer.
  if (root) {
    (root as HTMLElement & {
      readPrimaryDimension?: () => MeasureDimension | null;
    }).readPrimaryDimension = readPrimaryDimension;
    (root as HTMLElement & {
      setPrimaryDimension?: (d: MeasureDimension | null) => Promise<void>;
    }).setPrimaryDimension = setPrimaryDimension;
  }
</script>
