---
// The advance button at the foot of a step screen, in place of the circular
// arrow: a labelled primary button that names where it goes. Interior screens
// render it bare and the stepper writes "Next: <the next step's label>" into
// it on load, because the step list is the stepper's and a screen does not
// know what follows it. The last screen passes `href` and `label` ("Go to
// setup") and gets a link, which the stepper never touches.
//
// Put it in the screen's `advance` slot, ahead of any skip link:
//   <Firma2SetupStepNext slot="advance" />
//   <Firma2SetupStepNext slot="advance" href={hubHref} label="Go to setup" />
//
// The button carries `data-step-next`, so the stepper's gestures and a
// screen's own save-on-Next listener (`[data-step-next]`) work as they did on
// the arrow. The words sit in `[data-step-next-label]` so the stepper can
// write them without rebuilding the lego's markup.
//
// Composed from esa-button alone; the wrapper is the advance block's own
// child, laid out by firma2-setup-steps.css.
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  /** The last screen's way out. Omit on every screen that has a next step. */
  href?: string;
  /** The words. Interior screens leave it; the stepper replaces it with the next step's name. */
  label?: string;
  /** Start's question screens open unanswered; the shell enables the button once they are. */
  disabled?: boolean;
}

const { href, label = 'Next', disabled = false } = Astro.props;
---
<div class="firma2-setup-steps__next">
  {href ? (
    <EsaButton variant="primary" size="lg" href={href}>{label}</EsaButton>
  ) : (
    <EsaButton variant="primary" size="lg" disabled={disabled} data-step-next>
      <span data-step-next-label>{label}</span>
    </EsaButton>
  )}
</div>
