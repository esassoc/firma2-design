---
// firma2-setup-milestone-grid — the setup hub's milestones, as a card per
// milestone grouped by subject.
//
// WHY CARDS AND NOT ROWS. The list this replaces grouped by TIER (foundation,
// build, go-live), which is the model's dependency order and answers "what may I
// do next". It is the wrong question for somebody who has never stood a tenant
// up: the first thing an admin wants is to recognise the SUBJECT — money,
// people, the shape of the program — and pick the one they already have answers
// for. So the grouping is by `section` and the unit is a card, sized to hold the
// milestone's emblem at full size, because a milestone here is a thing you go
// and collect rather than a line you tick.
//
// SETUP IS STILL NOT A WIZARD. Nothing here numbers a step or advances a cursor.
// Every card is its own URL, resumable, openable in any order its dependencies
// allow, and the only ordering the grid asserts is the one the data already
// carries: milestoneSections, then the order milestones are declared in.
//
// STATUS IS DERIVED, NEVER STORED (setup-draft.ts). The server renders the ZERO
// state — journeyStatuses() with no draft, which is exactly what a fresh browser
// shows — and the script re-applies the real statuses on load and on every
// `setup-draft-change`. That is why the grid, the meter above it and the hex map
// can never disagree: all three read the same function and none keeps a copy.
//
// PROGRESS IS A ROW OF MARKS, NOT A WORD. Under each title sit five dots in the
// milestone's colour, filled as far as the milestone has got: screens answered
// on the start step, records resolved on a record milestone. The emblem already
// says which state the milestone is in (outline, tinted plate, solid plate), so
// a status badge beside it repeated the emblem in text, and a
// count line under that repeated the same fact a third time in a number that
// meant something different on every card. The dots are the one thing the
// emblem cannot show, how far along, and milestoneDotsFilled() is the single
// rule for it on both server and client.
//
// A CARD WITH NO ROUTE IS INERT, NOT A DEAD LINK — the rule AppLayout applies to
// the sidenav, for the same reason: a route this spoke has not built is a route
// you cannot go to, and it should say so rather than 404. A LOCKED card is inert
// too, because a dependency is unmet. Locked is not permanent, so the href is
// PARKED on the element rather than thrown away — confirming organizations
// unlocks first-project in the same tick that fires setup-draft-change, and the
// link has to come straight back. Same mechanic firma2-setup-hex-map uses.
//
// bcn-lego-checked: the card IS esa-card (variant="outlined"), the emblem is
// firma2-setup-milestone-emblem and the layout is .grid / .stack / .cluster
// with their own gap and --grid-min knobs. The progress row is five dots and
// nothing in the catalog draws one: esa-progress-bar is one track and one fill
// with no steps, esa-pagination is navigation, esa-badge is a word. What is
// written here and nowhere else is that row and the WHOLE-CARD LINK: esa-card is a
// <div> with a closed prop set (title/meta/icon/variant/padding) and no href, no
// anchor and no interactive state, and esa-button href renders a button-shaped
// anchor rather than a card-shaped one. Walked the catalog for a clickable card
// or tile (`ls node_modules/@esa/ecology/src/components/`); esa-icon-link and
// esa-link-column are text links, esa-chip-group is a control. Beacon is not
// cloned on this machine, so tier 2 is unavailable. So the link is a real <a>
// wrapping the lego, taking the page's own focus ring from tokens/focus.css, and
// the only rules below it are the hover edge and the inert dim.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import Firma2SetupMilestoneEmblem from './firma2-setup-milestone-emblem.astro';
import { journeys, milestoneSections } from '../../data/firma2-setup';
import { MILESTONE_DOTS, journeyStatuses, milestoneDotsFilled } from '../../lib/setup-draft';
import { withBase } from '../../lib/base';

const DOTS = Array.from({ length: MILESTONE_DOTS }, (_, i) => i);

// The zero state, resolved at build time. readSetupDraft() is SSR-safe (no
// localStorage on the server, so it returns the empty draft), which means this
// is the same picture a first-time visitor sees before the script runs — not a
// placeholder that flickers into something else.
const initial = journeyStatuses();
---
<div class="firma2-setup-milestone-grid stack" data-gap="xl">
  {
    milestoneSections.map((section) => {
      const cards = journeys.filter((journey) => journey.section === section.key);
      if (cards.length === 0) return null;
      const headingId = `firma2-setup-section-${section.key}`;
      // The heading belongs to the cards under it, so the gap inside a section
      // is a third of the gap between sections.
      return (
        <section class="stack" data-gap="sm" aria-labelledby={headingId}>
          <h2 id={headingId} class="typography-heading-md firma2-setup-milestone-grid__heading">
            {section.heading}
          </h2>

          <ul class="grid firma2-setup-milestone-grid__cards" data-gap="md">
            {cards.map((journey) => {
              const progress = initial[journey.key];
              const navigable = !!journey.route && progress.status !== 'locked';
              const filled = milestoneDotsFilled(progress);
              const complete = progress.status === 'confirmed';
              const Tag = journey.route ? 'a' : 'div';
              const linkProps = journey.route
                ? { href: withBase(journey.route), 'data-milestone-link': '' }
                : {};
              return (
                <li
                  class="firma2-setup-milestone-grid__card"
                  data-milestone={journey.key}
                  data-inert={navigable ? undefined : ''}
                  data-status={progress.status}
                  style={`--milestone-hue: ${journey.hue}`}
                >
                  <Tag class="firma2-setup-milestone-grid__link" {...linkProps}>
                    {/* esa-card is the whole surface: border, radius, background
                        and padding are all its own. Its HEADER is deliberately
                        unused — a card header is a title band with a rule under
                        it, and the emblem has to sit ABOVE the title rather than
                        beside it — so the milestone fills the body slot. */}
                    <EsaCard variant="outlined" padding="compact">
                      <div class="firma2-setup-milestone-grid__panel stack" data-gap="xs">
                        {/* The emblem is a fixed-size inline box, so it needs a
                            block of its own to centre inside — a flex item cannot
                            be centred by the text-align its siblings use. */}
                        <div class="firma2-setup-milestone-grid__emblem">
                          <Firma2SetupMilestoneEmblem
                            icon={journey.icon}
                            hue={journey.hue}
                            status={progress.status}
                            size="md"
                            seal={false}
                          />
                        </div>

                        <h3 class="typography-label-md-strong firma2-setup-milestone-grid__title">{journey.title}</h3>

                        {/* The dots are decoration over the emblem's state for a
                            sighted reader and one sentence for everyone else.
                            A complete milestone swaps the row for one check in
                            the success colour: done is done, in the same green
                            on every card, not a full row in eleven colours. */}
                        <div
                          class="firma2-setup-milestone-grid__dots cluster"
                          data-gap="2xs"
                          data-justify="center"
                          data-milestone-dots
                          role="img"
                          aria-label={`${filled} of ${MILESTONE_DOTS} complete`}
                          hidden={complete}
                        >
                          {DOTS.map((i) => (
                            <span class="firma2-setup-milestone-grid__dot" data-filled={i < filled ? '' : undefined} />
                          ))}
                        </div>
                        <div
                          class="firma2-setup-milestone-grid__done"
                          data-milestone-done
                          role="img"
                          aria-label="Complete"
                          hidden={!complete}
                        >
                          <EsaIcon name="circle-check" size="sm" />
                        </div>
                      </div>
                    </EsaCard>
                  </Tag>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })
  }
</div>

<script>
  // The grid's one job after render: keep every card honest about a draft that
  // lives in this browser. journeyStatuses() is the same function the server
  // rendered from, so "apply" is a re-render of the same derivation rather than
  // a second opinion about it.
  import { MILESTONE_DOTS, journeyStatuses, milestoneDotsFilled } from '../../lib/setup-draft';
  import type { JourneyKey } from '../../data/firma2-setup';

  const root = document.querySelector<HTMLElement>('.firma2-setup-milestone-grid');

  /**
   * A locked milestone keeps its markup and loses its destination. The href is
   * parked on the element rather than thrown away, because locks are not
   * permanent — see this component's header note.
   */
  const setLinkState = (link: HTMLElement | null, locked: boolean): void => {
    if (!link) return;
    const href = link.getAttribute('href') ?? link.dataset.href;
    if (!href) return;
    link.dataset.href = href;
    if (locked) {
      link.removeAttribute('href');
      link.setAttribute('aria-disabled', 'true');
    } else {
      link.setAttribute('href', href);
      link.removeAttribute('aria-disabled');
    }
  };

  if (root) {
    const apply = (): void => {
      const statuses = journeyStatuses();

      root.querySelectorAll<HTMLElement>('[data-milestone]').forEach((card) => {
        const progress = statuses[card.dataset.milestone as JourneyKey];
        if (!progress) return;

        // The emblem is one element with five CSS states. It carries no seal
        // here: the solid plate and the check under the title say done.
        const emblem = card.querySelector<HTMLElement>('[data-milestone-emblem]');
        if (emblem) emblem.dataset.status = progress.status;

        const filled = milestoneDotsFilled(progress);
        const complete = progress.status === 'confirmed';
        const done = card.querySelector<HTMLElement>('[data-milestone-done]');
        if (done) done.hidden = !complete;
        const dots = card.querySelector<HTMLElement>('[data-milestone-dots]');
        if (dots) {
          dots.hidden = complete;
          dots.setAttribute('aria-label', `${filled} of ${MILESTONE_DOTS} complete`);
          dots.querySelectorAll<HTMLElement>('.firma2-setup-milestone-grid__dot').forEach((dot, i) => {
            dot.toggleAttribute('data-filled', i < filled);
          });
        }

        const link = card.querySelector<HTMLElement>('[data-milestone-link]');
        const navigable = !!link && progress.status !== 'locked';
        setLinkState(link, !navigable);
        card.toggleAttribute('data-inert', !navigable);
        card.dataset.status = progress.status;
      });
    };

    apply();
    document.addEventListener('setup-draft-change', apply);
  }
</script>

<style>
  /* The typography composites set type only; the UA's heading margin survives
     them and would stack on top of the .stack gap. The spine owns spacing. */
  .firma2-setup-milestone-grid__heading,
  .firma2-setup-milestone-grid__title {
    margin: 0;
  }

  /* Three cards across the hub's column, one across a phone. 14rem is the
     narrowest a card can be and still hold "Names and appearance" on one line
     at label size with compact padding. */
  .firma2-setup-milestone-grid__cards {
    --grid-min: 14rem;
    /* auto-fill, not the primitive's auto-fit: a section with one milestone keeps
       the same card width as a section with three, so the grid reads as one set
       of cards rather than as rows of different things. */
    grid-template-columns: repeat(auto-fill, minmax(min(var(--grid-min), 100%), 1fr));
    list-style: none;
    padding: 0;
  }

  /* THE CARD WEARS ITS MILESTONE. The two brand roles the card reads (the hover
     edge, the dots) are re-pointed to the milestone's hue at the same primitive
     step the theme reads them from, the way SetupLayout does for a milestone
     page. Everything inside then takes the colour without naming it. */
  .firma2-setup-milestone-grid__card {
    --color-background-brand: oklch(from var(--firma2-brand-9) l c var(--milestone-hue));
    --color-border-brand: oklch(from var(--firma2-brand-6) l c var(--milestone-hue));
  }

  /* The card is the whole target, so the anchor is the whole card: full height
     so a short card in a row still clicks edge to edge, and the page's own focus
     ring (tokens/focus.css) rounded to match the corner it sits around. */
  .firma2-setup-milestone-grid__link {
    display: block;
    block-size: 100%;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .firma2-setup-milestone-grid__link > :global(.esa-card) {
    block-size: 100%;
  }

  /* HOVER IS THE ONLY AFFORDANCE A WHOLE-CARD LINK HAS — there is no underline
     to thicken and no button to press, so the card's own edge takes the brand
     and the card lifts. [href] rather than a class, because the script parks the
     href when a milestone locks: the target and the appearance of a target then
     cannot disagree, whatever order the two updates land in. */
  .firma2-setup-milestone-grid__link[href]:hover > :global(.esa-card) {
    border-color: var(--color-border-brand);
    box-shadow: var(--elevation-2);
  }

  /* Centred, because the emblem is the card's subject and a subject reads as
     collected rather than listed when it sits on the card's axis. Text-align is
     the whole of it: the emblem, the badges and the count lines are all inline
     boxes inside their own blocks, so none of them needs a flex alignment of its
     own. */
  .firma2-setup-milestone-grid__panel {
    text-align: center;
  }

  /* THE DOTS. Filled ones take the milestone's fill at the same step the emblem's
     plate reads, so a card's row and its emblem are one colour; empty ones take
     the default border, the same grey the sash gives a milestone that has not
     started. A suggested milestone's empty row shows its outline in the
     milestone's border step, the way its emblem does, so a row that has not
     begun still says which colour it will fill in. */
  .firma2-setup-milestone-grid__dots {
    --_dot-fill: var(--color-background-brand);
    --_dot-line: var(--color-border-brand);
    --_dot-empty: var(--color-border-default);
  }

  .firma2-setup-milestone-grid__dot {
    inline-size: var(--spacing-200);
    block-size: var(--spacing-200);
    border-radius: var(--radius-full);
    box-shadow: inset 0 0 0 var(--border-width-default) var(--_dot-empty);
  }

  .firma2-setup-milestone-grid__card:is([data-status='suggested'], [data-status='in-progress'])
    .firma2-setup-milestone-grid__dot {
    box-shadow: inset 0 0 0 var(--border-width-default) var(--_dot-line);
  }

  .firma2-setup-milestone-grid__dot[data-filled] {
    background: var(--_dot-fill);
    box-shadow: none;
  }

  /* .cluster sets display:flex, which beats the UA's [hidden] rule, so the row
     restates it for the runtime toggle. */
  .firma2-setup-milestone-grid__dots[hidden] {
    display: none;
  }

  /* The done mark is the utility success role, the one colour on the hub that
     is not a milestone's own: complete means the same thing on every card. */
  .firma2-setup-milestone-grid__done {
    color: var(--color-content-utility-success);
    line-height: 0;
  }

  /* Only a LOCKED milestone dims: its dependency is unmet and the card says so.
     A milestone this spoke has not built yet is inert but keeps full presence,
     because on this hub every card is a thing to go and earn. */
  .firma2-setup-milestone-grid__card[data-status='locked'] {
    opacity: 0.6;
  }
</style>
