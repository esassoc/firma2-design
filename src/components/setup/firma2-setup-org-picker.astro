---
// firma2-setup-org-picker: the first screen of the Organizations walk. Every
// organization the documents proposed, as a tile you tap to keep.
//
// ONE QUESTION OVER THE WHOLE CAST. The idiom is the music-app onboarding picker,
// not a review queue: a queue asks one question nine times and makes the ninth
// answer feel like the first; a grid asks once, over every document-sourced
// candidate, and nothing is written on tap. The write is Next. Next confirms
// the pressed tiles and dismisses the rest, because "which of these do you work
// with" has one answer for each tile and leaving some unanswered is not one of
// them. "None of these" is the same write with nothing pressed. That is the
// change from the one-page picker this replaced, whose "Skip the rest" dismissed
// pressed and unpressed alike (Andy, 2026-09-18: "what does 'Skip the rest'
// mean?").
//
// THE SCREEN SHOWS EVERY DOCUMENT-SOURCED ORGANIZATION, not only the open ones,
// with the confirmed ones already pressed. So the screen is resumable and
// idempotent: Back from the roster shows the answer as given, a tile can be
// un-pressed and Next re-writes the cast. The roster's Remove returns a
// document-sourced row to `suggested`, which reads here as un-pressed.
//
// ORDER IS THE DATA'S. listOrganizations() returns the suggestions ordered by how
// many projects the documents mention them on, so the organizations this program
// works with most are the ones it sees first. Nothing here re-sorts. The tenant
// is not a tile: it is the program itself, confirmed before any draft exists, and
// the roster is where it shows.
//
// WHY THIS SCREEN DOES NOT ASK FOR AN UPLOAD. The Start step already took the
// documents, for every milestone at once; asking again here would make the
// program answer the same question per record type. When there are no documents
// the screen says so and points at Start.
//
// Composed: firma2-setup-step-screen is the screen, .grid the layout engine
// (--grid-min 16rem lands three tiles across and folds to one on a phone without
// a media query), firma2-setup-org-tile the tile, esa-button Next and the
// skip, esa-empty-state the no-documents state.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import Firma2SetupStepScreen from './firma2-setup-step-screen.astro';
import Firma2SetupStepNext from './firma2-setup-step-next.astro';
import Firma2SetupOrgTile from './firma2-setup-org-tile.astro';
import { withBase } from '../../lib/base';
---
<Firma2SetupStepScreen
  step="suggested"
  icon="file-text"
  prompt="Which of these organizations do you work with?"
  align="start"
  class="firma2-setup-org-picker"
>
  <!-- Filled by the script: which documents named the cast is draft state. -->
  <p slot="lede" class="typography-body-md firma2-setup-steps__lede" data-part="lede" hidden></p>

  <!-- Filled by the script: which suggestions exist and which are pressed is
       draft state, so there is nothing honest to render at build time. The
       tile's markup is still authored, in firma2-setup-org-tile's template. -->
  <ul class="firma2-setup-org-picker__grid grid" data-gap="md" data-part="grid" hidden></ul>

  <!-- Plain <div> wrapper because esa-empty-state's props have no `hidden`. -->
  <div data-part="no-documents" hidden>
    <EsaEmptyState title="No suggestions yet" description="Upload a report or spreadsheet to find organizations.">
      <EsaButton variant="primary" href={withBase('/prototypes/setup/start')}>Start</EsaButton>
    </EsaEmptyState>
  </div>

  <Firma2SetupOrgTile />

  <Firma2SetupStepNext slot="advance" />
  <EsaButton slot="advance" variant="ghost" size="lg" data-step-skip>None of these</EsaButton>
</Firma2SetupStepScreen>

<style>
  /* .grid is the layout engine; this strips the list chrome that comes with
     choosing <ul> for its semantics and sets the tile's floor. */
  .firma2-setup-org-picker__grid {
    --grid-min: 16rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* .grid owns display, so [hidden] needs the specificity to win. */
  .firma2-setup-org-picker__grid[hidden] {
    display: none;
  }
</style>

<script>
  import { listOrganizations, readSetupDraft, setOrganizationStatuses, sourceDocumentNames } from '../../lib/setup-draft';
  import type { Organization, OrganizationStatus } from '../../data/firma2-setup';

  const TILE = 'firma2-org-tile';

  /** "A, B, and C": the documents named in the lede, in reading order. */
  const LIST = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' });

  type OrgTile = HTMLElement & { org: Organization; orgId: string; selected: boolean };

  const screen = document.querySelector<HTMLElement>('.firma2-setup-org-picker[data-step]');
  const grid = screen?.querySelector<HTMLElement>('[data-part="grid"]');
  const lede = screen?.querySelector<HTMLElement>('[data-part="lede"]');
  const noDocuments = screen?.querySelector<HTMLElement>('[data-part="no-documents"]');
  const next = screen?.querySelector<HTMLElement>('[data-step-next]');
  const skip = screen?.querySelector<HTMLElement>('[data-step-skip]');

  if (screen && grid && lede && noDocuments && next && skip) {
    /** The cast this screen answers for: everything a document proposed, whatever its status now. */
    const fromDocuments = (): Organization[] => listOrganizations().filter((org) => org.source === 'document');

    const tiles = (): OrgTile[] => [...grid.querySelectorAll<OrgTile>(TILE)];

    // Answered means at least one tile pressed. A cast of none has nothing to
    // answer, so Next stays live and the walk goes on.
    const syncReady = (): void => {
      const cast = tiles();
      screen.dataset.stepReady = String(cast.length === 0 || cast.some((tile) => tile.selected));
    };

    const render = (): void => {
      const cast = fromDocuments();
      const uploaded = readSetupDraft().documentsUploaded;

      grid.replaceChildren(
        ...cast.map((org) => {
          const item = document.createElement('li');
          const tile = document.createElement(TILE) as OrgTile;
          tile.org = org;
          tile.selected = org.status === 'confirmed';
          item.append(tile);
          return item;
        }),
      );

      grid.hidden = cast.length === 0;
      noDocuments.hidden = uploaded;
      // The line under the prompt names the documents the cast came from, so the
      // tiles read as what those documents said, not a list setup invented.
      const named = sourceDocumentNames(cast);
      lede.textContent = named.length > 0 ? `Named in ${LIST.format(named)}.` : '';
      lede.hidden = named.length === 0;
      syncReady();
    };

    grid.addEventListener('org-tile-toggle', syncReady);

    // Next is the write: pressed tiles confirmed, the rest dismissed, in one
    // pass. The shell advances on the same click.
    next.addEventListener('click', () => {
      const statuses: Record<string, OrganizationStatus> = {};
      for (const tile of tiles()) statuses[tile.orgId] = tile.selected ? 'confirmed' : 'dismissed';
      if (Object.keys(statuses).length > 0) setOrganizationStatuses(statuses);
    });

    skip.addEventListener('click', () => {
      const statuses: Record<string, OrganizationStatus> = {};
      for (const org of fromDocuments()) statuses[org.id] = 'dismissed';
      if (Object.keys(statuses).length > 0) setOrganizationStatuses(statuses);
    });

    // Every write in setup-draft.ts announces itself, so this screen, the roster
    // and the header's counts all re-read the same draft.
    let ready = false;
    document.addEventListener('setup-draft-change', () => {
      if (ready) render();
    });

    // The tile is a custom element: wait for its definition, or createElement
    // hands back an unupgraded element whose `org` setter goes nowhere.
    customElements.whenDefined(TILE).then(() => {
      ready = true;
      render();
    });
  }
</script>
