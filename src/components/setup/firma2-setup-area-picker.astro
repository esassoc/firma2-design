---
// firma2-setup-area-picker: the first screen of the Spatial areas walk. Every
// area the documents named, as a tile you tap to keep.
//
// ONE QUESTION OVER THE WHOLE CAST. The idiom is
// firma2-setup-classification-picker's, unchanged: the screen asks once, over
// every document-sourced candidate, and nothing is written on tap. The write is
// Next. Next confirms the pressed tiles and dismisses the rest; "None of
// these" is the same write with nothing pressed.
//
// THE SCREEN SHOWS EVERY DOCUMENT-SOURCED AREA, not only the open ones, with the
// confirmed ones already pressed. So the screen is resumable and idempotent: Back
// from the roster shows the answer as given, and the roster's Remove returns a
// document row to `suggested`, which reads here as un-pressed.
//
// THE CAST IS THE ANNUAL REPORT'S MAP. The teammate's 2026-09-23 "Five Doors"
// mock opened by asking what fills the blank in "What have you done in ___?".
// Start's `map` intent question already asks that (Watersheds, Counties, Our own
// boundaries), so this screen does not ask it again: it offers the named areas
// the documents hold, each carrying its kind. When there are no documents the
// screen says so and points at Start.
//
// Composed: firma2-setup-step-screen is the screen, .grid the layout engine,
// firma2-setup-area-tile the tile, firma2-setup-step-next the Next button, esa-button the skip,
// esa-empty-state the no-documents state.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import Firma2SetupStepScreen from './firma2-setup-step-screen.astro';
import Firma2SetupStepNext from './firma2-setup-step-next.astro';
import Firma2SetupAreaTile from './firma2-setup-area-tile.astro';
import { withBase } from '../../lib/base';
---
<Firma2SetupStepScreen
  step="suggested"
  icon="file-text"
  prompt="Which of these areas do your projects fall in?"
  align="start"
  class="firma2-setup-area-picker"
>
  <!-- Filled by the script: which documents named the cast is draft state. -->
  <p slot="lede" class="typography-body-md firma2-setup-steps__lede" data-part="lede" hidden></p>

  <!-- Filled by the script: which suggestions exist and which are pressed is
       draft state. The tile's markup is authored in its own template. -->
  <ul class="firma2-setup-area-picker__grid grid" data-gap="md" data-part="grid" hidden></ul>

  <!-- Plain <div> wrapper because esa-empty-state's props have no `hidden`. -->
  <div data-part="no-documents" hidden>
    <EsaEmptyState title="No suggestions yet" description="Upload a report with a map to find areas.">
      <EsaButton variant="primary" href={withBase('/prototypes/setup/start')}>Start</EsaButton>
    </EsaEmptyState>
  </div>

  <Firma2SetupAreaTile />

  <Firma2SetupStepNext slot="advance" />
  <EsaButton slot="advance" variant="ghost" size="lg" data-step-skip>None of these</EsaButton>
</Firma2SetupStepScreen>

<style>
  /* .grid is the layout engine; this strips the list chrome that comes with
     choosing <ul> for its semantics and sets the tile's floor. */
  .firma2-setup-area-picker__grid {
    --grid-min: 16rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* .grid owns display, so [hidden] needs the specificity to win. */
  .firma2-setup-area-picker__grid[hidden] {
    display: none;
  }
</style>

<script>
  import { listSpatialAreas, readSetupDraft, setSpatialAreaStatuses, sourceDocumentNames } from '../../lib/setup-draft';
  import type { SpatialAreaRecord, SpatialAreaStatus } from '../../data/firma2-setup';

  const TILE = 'firma2-area-tile';

  /** "A, B, and C": the documents named in the lede, in reading order. */
  const LIST = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' });

  type AreaTile = HTMLElement & {
    area: SpatialAreaRecord;
    areaId: string;
    selected: boolean;
  };

  const screen = document.querySelector<HTMLElement>('.firma2-setup-area-picker[data-step]');
  const grid = screen?.querySelector<HTMLElement>('[data-part="grid"]');
  const lede = screen?.querySelector<HTMLElement>('[data-part="lede"]');
  const noDocuments = screen?.querySelector<HTMLElement>('[data-part="no-documents"]');
  const next = screen?.querySelector<HTMLElement>('[data-step-next]');
  const skip = screen?.querySelector<HTMLElement>('[data-step-skip]');

  if (screen && grid && lede && noDocuments && next && skip) {
    /** The cast this screen answers for: everything a document proposed, whatever its status now. */
    const fromDocuments = (): SpatialAreaRecord[] => listSpatialAreas().filter((record) => record.source === 'document');

    const tiles = (): AreaTile[] => [...grid.querySelectorAll<AreaTile>(TILE)];

    // Answered means at least one tile pressed. A cast of none has nothing to
    // answer, so Next stays live and the walk goes on.
    const syncReady = (): void => {
      const cast = tiles();
      screen.dataset.stepReady = String(cast.length === 0 || cast.some((tile) => tile.selected));
    };

    const render = (): void => {
      const cast = fromDocuments();
      const uploaded = readSetupDraft().documentsUploaded;

      grid.replaceChildren(
        ...cast.map((record) => {
          const item = document.createElement('li');
          const tile = document.createElement(TILE) as AreaTile;
          tile.area = record;
          tile.selected = record.status === 'confirmed';
          item.append(tile);
          return item;
        }),
      );

      grid.hidden = cast.length === 0;
      noDocuments.hidden = uploaded;
      const named = sourceDocumentNames(cast);
      lede.textContent = named.length > 0 ? `Named in ${LIST.format(named)}.` : '';
      lede.hidden = named.length === 0;
      syncReady();
    };

    grid.addEventListener('area-tile-toggle', syncReady);

    // Next is the write: pressed tiles confirmed, the rest dismissed, in one
    // pass. The shell advances on the same click.
    next.addEventListener('click', () => {
      const statuses: Record<string, SpatialAreaStatus> = {};
      for (const tile of tiles()) statuses[tile.areaId] = tile.selected ? 'confirmed' : 'dismissed';
      if (Object.keys(statuses).length > 0) setSpatialAreaStatuses(statuses);
    });

    skip.addEventListener('click', () => {
      const statuses: Record<string, SpatialAreaStatus> = {};
      for (const record of fromDocuments()) statuses[record.id] = 'dismissed';
      if (Object.keys(statuses).length > 0) setSpatialAreaStatuses(statuses);
    });

    let ready = false;
    document.addEventListener('setup-draft-change', () => {
      if (ready) render();
    });

    // Wait for the tile's definition, or createElement hands back an unupgraded
    // element whose `area` setter goes nowhere.
    customElements.whenDefined(TILE).then(() => {
      ready = true;
      render();
    });
  }
</script>
