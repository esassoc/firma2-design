---
// firma2-setup-guide-row — the documents screen's guidance, set in the
// screen itself under the prompt (Andy, 2026-09-24: "move 'Documents worth
// bringing' just below the main headline"). Same content as the guide panel it
// came from; the examples become a row of badges because a bulleted list in a
// centred column reads as a stray list, and badges keep them one glance wide.
//
// No bespoke UI: esa-card (filled) is the panel, esa-badge the examples, stack
// and cluster the layout.
import EsaPill from '@esa/ecology/esa-pill.astro';
import EsaCard from '@esa/ecology/esa-card.astro';
import type { StepGuide } from '../../data/firma2-setup';

interface Props {
  guide: StepGuide;
}

const { guide } = Astro.props;
---
<div class="firma2-setup-guide-row">
  {/* ONE ROW, 2026-09-24: the guide's title and its examples as badges. The
      guide's body is the screen's lede (firma2-setup-start-steps), so the row
      carries only what the lede cannot: the concrete examples. Andy moved the
      guidance under the headline on Documents, then asked for the same on every
      Start step ("Shouldn't we move the guidance above on all steps?"), which
      retired Start's right-hand guide column. The examples are neutral
      esa-pills, not milestone-tinted badges: they are reference material, not
      choices, and tinted they read as one more set of options above the real
      ones (Andy, 2026-09-24: "they could be neutral"). esa-badge has no neutral
      variant; esa-pill's default is. */}
  <EsaCard variant="filled" padding="compact">
    <div class="cluster firma2-setup-guide-row__row" data-gap="sm">
      <h3 class="typography-label-md-strong firma2-setup-guide-row__title">{guide.title}</h3>
      {guide.examples && (
        <ul class="cluster firma2-setup-guide-row__examples" data-gap="xs">
          {guide.examples.map((example) => (
            <li><EsaPill label={example} variant="default" size="md" removable={false} /></li>
          ))}
        </ul>
      )}
    </div>
  </EsaCard>
</div>

<style>
  .firma2-setup-guide-row {
    text-align: start;
  }
  .firma2-setup-guide-row__row {
    align-items: center;
  }
  .firma2-setup-guide-row__title {
    margin: 0;
  }
  .firma2-setup-guide-row__examples {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
