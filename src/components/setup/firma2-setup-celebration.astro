---
// firma2-setup-celebration: a short burst of confetti when setup finishes.
//
// ANDY, 2026-09-24: "When you click the Complete demo button, can we also get
// some sort of fireworks? Want folks to celebrate. Make it short but nice." The
// element exposes one method, burst(origin), which the finish panel calls when
// the program reads complete. Two staggered bursts rise from the origin's top
// centre, about 120 pieces in all, and the whole effect clears in about 1.4
// seconds. The canvas is created for the burst and removed when the last piece
// fades, so between celebrations the page carries no canvas and no frame loop.
//
// THE COLOURS ARE THE ELEVEN MILESTONES. One probe per journey carries the
// emblem recipe (the brand token with only its hue swapped, relative colour
// syntax), and burst() reads each probe's computed ink and tint at the moment
// it fires, so the confetti follows the live theme. Ink colours the saturated
// pieces, tint the pale ones.
//
// DETERMINISTIC. The piece field comes from a seeded generator, so every run of
// the demo throws the same confetti (design-principles: no Math.random in
// anything a client watches).
//
// prefers-reduced-motion: reduce throws nothing. burst() returns false and the
// caller may fall back to its own quiet arrival.
//
// bcn-lego-checked: no esa-* lego is a celebration or particle effect; the
// catalog's motion is confined to overlays, spinners and progress. Beacon is
// not cloned on this machine, so tier 2 is unavailable. firma2-setup-celebration
// is the reusable home: any caller mounts it once and calls burst(origin).
import { journeys } from '../../data/firma2-setup';
---
<firma2-setup-celebration class="firma2-setup-celebration" aria-hidden="true">
  {journeys.map((journey) => (
    <span class="firma2-setup-celebration__probe" style={`--_probe-hue: ${journey.hue}`} data-celebration-probe={journey.key}></span>
  ))}
</firma2-setup-celebration>

<style>
  .firma2-setup-celebration {
    display: contents;
  }

  /* A probe is never seen: it exists so the browser resolves the recipe. */
  .firma2-setup-celebration__probe {
    position: absolute;
    inline-size: 0;
    block-size: 0;
    overflow: hidden;
    background: oklch(from var(--color-background-brand-muted) l c var(--_probe-hue));
    color: oklch(from var(--color-content-brand) l c var(--_probe-hue));
  }
</style>

<script>
  interface Piece {
    x: number;
    y: number;
    vx: number;
    vy: number;
    angle: number;
    spin: number;
    flutter: number;
    size: number;
    disc: boolean;
    color: string;
    born: number;
    life: number;
  }

  interface BurstPlan {
    delay: number;
    count: number;
  }

  const BURSTS: BurstPlan[] = [
    { delay: 0, count: 64 },
    { delay: 180, count: 56 },
  ];
  const GRAVITY = 1400; // px per second squared
  const DRAG = 2.4; // per second, exponential
  const LIFE_MIN = 950; // ms
  const LIFE_SPREAD = 250; // ms
  const FAN = (58 * Math.PI) / 180; // half-angle either side of straight up
  const SPEED_MIN = 520; // px per second
  const SPEED_SPREAD = 420;

  /** mulberry32: a small seeded generator, so every burst throws the same field. */
  const seeded = (seed: number): (() => number) => {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) >>> 0;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  };

  class Firma2SetupCelebration extends HTMLElement {
    private running = false;

    /** The eleven milestone hues as [ink, tint], read off the probes now. */
    private palette(): { ink: string[]; tint: string[] } {
      const ink: string[] = [];
      const tint: string[] = [];
      this.querySelectorAll<HTMLElement>('[data-celebration-probe]').forEach((probe) => {
        const style = getComputedStyle(probe);
        ink.push(style.color);
        tint.push(style.backgroundColor);
      });
      return { ink, tint };
    }

    /**
     * Throw confetti from the top centre of `origin`. Returns false when
     * nothing was thrown (reduced motion, already running, no colours).
     */
    burst(origin: Element): boolean {
      if (this.running) return false;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
      const { ink, tint } = this.palette();
      if (ink.length === 0) return false;

      const rect = origin.getBoundingClientRect();
      const ox = rect.left + rect.width / 2;
      const oy = Math.max(rect.top - 8, 24);
      const spread = Math.min(rect.width * 0.18, 140);

      const canvas = document.createElement('canvas');
      canvas.setAttribute('aria-hidden', 'true');
      const z = getComputedStyle(document.documentElement).getPropertyValue('--z-toast').trim() || '1000';
      Object.assign(canvas.style, {
        position: 'fixed',
        inset: '0',
        inlineSize: '100vw',
        blockSize: '100vh',
        pointerEvents: 'none',
        zIndex: z,
      });
      const context = canvas.getContext('2d');
      if (!context) return false;

      const resize = (): void => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(window.innerWidth * dpr);
        canvas.height = Math.round(window.innerHeight * dpr);
        context.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      resize();
      window.addEventListener('resize', resize);
      document.body.append(canvas);
      this.running = true;

      const random = seeded(20260924);
      const pieces: Piece[] = [];
      for (const plan of BURSTS) {
        for (let i = 0; i < plan.count; i += 1) {
          const angle = -Math.PI / 2 + (random() * 2 - 1) * FAN;
          const speed = SPEED_MIN + random() * SPEED_SPREAD;
          const hue = Math.floor(random() * ink.length);
          const pale = random() < 0.3;
          pieces.push({
            x: ox + (random() * 2 - 1) * spread,
            y: oy,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            angle: random() * Math.PI * 2,
            spin: (random() * 2 - 1) * 9,
            flutter: random() * Math.PI * 2,
            size: 6 + random() * 4,
            disc: random() < 0.35,
            color: pale ? tint[hue] : ink[hue],
            born: plan.delay,
            life: LIFE_MIN + random() * LIFE_SPREAD,
          });
        }
      }

      const start = performance.now();
      let last = start;

      const frame = (now: number): void => {
        const elapsed = now - start;
        const dt = Math.min((now - last) / 1000, 1 / 30);
        last = now;
        const damp = Math.exp(-DRAG * dt);

        context.clearRect(0, 0, window.innerWidth, window.innerHeight);
        let alive = 0;

        for (const piece of pieces) {
          const age = elapsed - piece.born;
          if (age < 0) {
            alive += 1;
            continue;
          }
          if (age >= piece.life) continue;
          alive += 1;

          piece.vx *= damp;
          piece.vy = piece.vy * damp + GRAVITY * dt;
          piece.x += piece.vx * dt;
          piece.y += piece.vy * dt;
          piece.angle += piece.spin * dt;
          piece.flutter += 10 * dt;

          const progress = age / piece.life;
          context.globalAlpha = progress < 2 / 3 ? 1 : Math.max(0, (1 - progress) * 3);
          context.fillStyle = piece.color;
          context.save();
          context.translate(piece.x, piece.y);
          context.rotate(piece.angle);
          if (piece.disc) {
            context.beginPath();
            context.arc(0, 0, piece.size / 2, 0, Math.PI * 2);
            context.fill();
          } else {
            // A paper strip turning over: its height breathes with the flutter.
            const height = piece.size * 0.6 * Math.max(0.2, Math.abs(Math.cos(piece.flutter)));
            context.fillRect(-piece.size / 2, -height / 2, piece.size, height);
          }
          context.restore();
        }

        if (alive > 0) {
          requestAnimationFrame(frame);
          return;
        }
        window.removeEventListener('resize', resize);
        canvas.remove();
        this.running = false;
      };

      requestAnimationFrame(frame);
      return true;
    }
  }

  if (!customElements.get('firma2-setup-celebration')) {
    customElements.define('firma2-setup-celebration', Firma2SetupCelebration);
  }
</script>
