---
// firma2-setup-finish: the hub's finish line. It exists only when every
// milestone reads confirmed, and then it is the first thing under the title:
// the program read back as one paragraph, and the next steps that have a screen.
//
// INLINE, ONE PARAGRAPH, TOKENS, 2026-09-23. THE SAME DAY IT WAS BUILT, ANDY
// REDIRECTED THE FINISH: NO SEPARATE PAGE. THE /prototypes/setup/complete ROUTE
// AND ITS HERO, PORTRAIT AND NEXT-STEPS COMPONENTS WERE REMOVED, AND THE FINISH
// NOW LIVES HERE, WHERE THE BAND WAS. THE PORTRAIT IS NO LONGER THREE COLUMNS
// OF BODY COPY UNDER THE HUB'S GROUP HEADINGS: IT IS ONE PARAGRAPH OF FOUR OR
// FIVE SENTENCES IN LARGE TYPE, A MAD LIBS OF THE PROGRAM, WHERE EACH FACT IS A
// TOKEN THE EYE LANDS ON. Sentence one is the celebration ("... is set up"),
// the rest is the portrait. lib/setup-summary composes the runs; this
// component only draws them.
//
// A TOKEN RHYMES WITH ITS CARD. Every milestone token carries that milestone's
// icon and hue off the journey record, and derives its tint and ink with the
// emblem's recipe (the brand token with only its hue swapped, relative colour
// syntax), so "12 organizations" is the Organizations card's colour and glyph.
// The name and noun tokens take Names and appearance's hue, the milestone that
// produced them, so they sit in the same family as the Describe your program
// cards. The accent color and site visibility are settings, not facts about the
// program, and stay off the paragraph (Andy, 2026-09-23); the color-run renderer
// below (disc from lib/tenant-swatch) remains for a caller that wants it. The
// three shape rules (money, year, proposals) stay prose.
//
// TOKENS WRAP. A token is `display: inline` with its box decoration cloned, not
// inline-flex: an atomic box around "Cascade Headwaters Partnership" or "24
// restoration actions" cannot break, and at a phone's width it would overflow
// the column. Inline, the plate breaks with the words and each line fragment
// keeps its own padding and corners. The icon is an inline block on the text
// baseline. The paragraph's leading is opened from the role's tight 1.3 to the
// normal 1.6 so plates on adjacent lines do not touch.
//
// THE TYPE ROLE IS heading-md, AT FULL COLUMN WIDTH. The complete draft's
// paragraph is about 520 characters. display-sm (36px bold) runs it past ten
// lines at the hub's 960px; heading-lg (30px) near ten; heading-md (24px) holds
// it at about seven, which is the largest role inside the eight-line budget.
// A 40ch to 48ch measure would push it past ten lines again, so the paragraph
// takes the column. Tokens keep the paragraph's size and weight: the plate is
// the emphasis, not a font change.
//
// NO CARD. The earlier band sat on a filled esa-card. With twelve tinted plates
// in the paragraph, a sunken fill behind them lowers every plate's contrast
// against its ground and adds a second surface to a block that is already the
// loudest thing on the page. The paragraph sits on the page ground, between
// the meter and the outlined milestone cards, separated by the hub's own gap.
//
// ABSENT, NOT EMPTY. The server renders it `hidden` (a first visit is never
// complete) and the script re-renders it on load and on every
// `setup-draft-change`, so Complete demo raises it and Reset demo takes it away
// without a reload. The wrapper is a plain div so `hidden` lands on an element
// that owns no display rule; the step slots are plain spans for the same reason.
//
// bcn-lego-checked: no esa-* lego is a token that sits inside running text.
// esa-pill is a block-ish label with its own type scale (xs to lg), six fixed
// variants and no hue channel; esa-badge is a count or status mark sized by its
// own padding. Both are server-rendered .astro legos, so neither can be built
// from runs composed in the browser from a localStorage draft, and both would
// change the font size mid-sentence. esa-icon is used as-is, server-rendered
// into one template per milestone and cloned into its token. Beacon is not
// cloned on this machine, so tier 2 is unavailable. firma2-setup-finish is the
// reusable home of the finish token.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import { journeys } from '../../data/firma2-setup';
import { completeSetupDraft } from '../../lib/setup-draft';
import { nextSteps, programPortrait } from '../../lib/setup-summary';
import { withBase } from '../../lib/base';

// The step slots render from the finished demo draft, which is the only draft
// that can raise this panel on first paint; the script rewrites each label, href
// and visibility from the live draft.
const steps = nextSteps(programPortrait(completeSetupDraft()));
---
<!-- manifest:
  layout: stack(xl)
  sections:
    - paragraph  -> p in typography-heading-md (runs from finishRuns: text, and name, color, noun and milestone tokens)
    - next steps -> cluster of esa-button (secondary, md, arrow-right; up to three, from nextSteps)
-->
<div class="firma2-setup-finish" data-setup-finish hidden>
  <div class="stack" data-gap="xl">
    <p class="typography-heading-md firma2-setup-finish__paragraph" data-finish-paragraph></p>

    <div class="cluster" data-gap="sm">
      {steps.map((step) => (
        <span data-finish-step={step.id}>
          <EsaButton variant="ghost" appearance="outline" size="md" iconRight="arrow-right" href={withBase(step.route)}>{step.label}</EsaButton>
        </span>
      ))}
    </div>
  </div>

  {/* One glyph per milestone, cloned into its token by the script. */}
  {journeys.map((journey) => (
    <template data-finish-icon={journey.key}>
      <EsaIcon name={journey.icon} size="sm" />
    </template>
  ))}
</div>

<style>
  .firma2-setup-finish__paragraph {
    margin: 0;
    color: var(--color-content-default);
    line-height: var(--line-height-normal);
    text-wrap: pretty;
  }

  /* THE TOKEN. Built in the browser, so it carries no scope attribute and is
     reached through :global under the scoped paragraph. The palette is the
     emblem's: each role is the brand token with only its hue swapped, and `h`
     (the origin's own channel) leaves a hue-less token in the brand's colour. */
  .firma2-setup-finish__paragraph :global(.firma2-setup-finish__token) {
    --_token-hue: h;
    --_token-tint: oklch(from var(--color-background-brand-muted) l c var(--_token-hue));
    --_token-ink: oklch(from var(--color-content-brand) l c var(--_token-hue));

    display: inline;
    padding-block: var(--spacing-050);
    /* The tint reaches past the word through box-shadow, not padding, so a
       comma or period that follows the token hugs the word the way it would in
       plain text instead of standing off from the plate. */
    padding-inline: 0.1em;
    box-shadow: 0.2em 0 0 var(--_token-tint), -0.2em 0 0 var(--_token-tint);
    border-radius: var(--radius-sm);
    background: var(--_token-tint);
    color: var(--_token-ink);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* The milestone glyph at the text's own size, on its baseline. */
  .firma2-setup-finish__paragraph :global(.firma2-setup-finish__token .esa-icon) {
    display: inline-block;
    inline-size: 1em;
    block-size: 1em;
    margin-inline-end: 0.25em;
    vertical-align: -0.125em;
  }

  .firma2-setup-finish__paragraph :global(.firma2-setup-finish__token .esa-icon svg) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  /* The disc and its colour word stay on one line; a disc alone at a line's
     end reads as a stray bullet. */
  .firma2-setup-finish__paragraph :global(.firma2-setup-finish__token[data-kind="color"]) {
    white-space: nowrap;
  }

  /* The color token's disc, the appearance roster's swatch at text size. */
  .firma2-setup-finish__paragraph :global(.firma2-setup-finish__disc) {
    display: inline-block;
    inline-size: 0.75em;
    block-size: 0.75em;
    margin-inline-end: 0.3em;
    border: var(--border-width-default) solid var(--color-border-default-subtle);
    border-radius: var(--radius-full);
    background: var(--swatch);
    vertical-align: -0.05em;
  }

  @media (forced-colors: active) {
    .firma2-setup-finish__paragraph :global(.firma2-setup-finish__token) {
      border: var(--border-width-default) solid CanvasText;
    }
  }
</style>

<script>
  import { readSetupDraft, setupComplete } from '../../lib/setup-draft';
  import { finishRuns, nextSteps, programPortrait } from '../../lib/setup-summary';
  import type { NextStepId, PortraitRun } from '../../lib/setup-summary';
  import { tenantSwatch } from '../../lib/tenant-swatch';
  import { withBase } from '../../lib/base';

  type TokenRun = Exclude<PortraitRun, { kind: 'text' }>;

  const root = document.querySelector<HTMLElement>('[data-setup-finish]');
  const paragraph = root?.querySelector<HTMLElement>('[data-finish-paragraph]');

  if (root && paragraph) {
    const icons = new Map<string, HTMLTemplateElement>();
    root.querySelectorAll<HTMLTemplateElement>('template[data-finish-icon]').forEach((template) => {
      if (template.dataset.finishIcon) icons.set(template.dataset.finishIcon, template);
    });
    const slots = [...root.querySelectorAll<HTMLElement>('[data-finish-step]')];

    const token = (run: TokenRun): HTMLElement => {
      const el = document.createElement('span');
      el.className = 'firma2-setup-finish__token';
      el.dataset.kind = run.kind;
      if (run.hue !== null) el.style.setProperty('--_token-hue', String(run.hue));
      if (run.kind === 'milestone') {
        el.dataset.journey = run.journey;
        const icon = icons.get(run.journey);
        if (icon) el.append(icon.content.cloneNode(true));
      }
      if (run.kind === 'color') {
        const disc = document.createElement('span');
        disc.className = 'firma2-setup-finish__disc';
        disc.setAttribute('aria-hidden', 'true');
        disc.style.setProperty('--swatch', tenantSwatch(run.hue));
        el.append(disc);
      }
      el.append(run.text);
      return el;
    };

    const apply = (): void => {
      const draft = readSetupDraft();
      const complete = setupComplete(draft);
      root.hidden = !complete;
      if (!complete) return;

      const portrait = programPortrait(draft);
      paragraph.replaceChildren(
        ...finishRuns(portrait).map((run) => (run.kind === 'text' ? document.createTextNode(run.text) : token(run))),
      );

      const steps = new Map(nextSteps(portrait).map((step) => [step.id, step]));
      for (const slot of slots) {
        const step = steps.get(slot.dataset.finishStep as NextStepId);
        slot.hidden = !step;
        if (!step) continue;
        const link = slot.querySelector<HTMLAnchorElement>('a');
        const label = slot.querySelector<HTMLElement>('.esa-button__label');
        if (link) link.href = withBase(step.route);
        if (label) label.textContent = step.label;
      }
    };

    apply();
    document.addEventListener('setup-draft-change', apply);
  }
</script>
