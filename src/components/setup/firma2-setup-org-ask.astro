---
// firma2-setup-org-ask — the half of the cast the documents never had.
//
// WHY A SENTENCE AND NOT A FORM. The picker can only offer what was written down.
// Every program has partners who appear in no report: the two land trusts, the
// county, the district that joined last month. The traditional answer is an "Add
// organization" form with name, roles and location, filled once per partner, and
// it is the reason nobody finishes setup. Dana knows her partners as a GROUP
// ("the two land trusts we work with on the Metolius"); this takes the sentence
// and comes back with tiles, which is the same picking gesture as the grid above.
//
// THE ANSWER IS STILL A PROPOSAL. proposeOrganizations() returns and stores
// nothing; the tiles arrive pre-selected because Dana asked for them by name, and
// the Add button is still the write. Same rule as the picker: nothing enters the
// program without a person pressing something.
//
// THE EXAMPLES ARE THE DOCUMENTATION. An empty box with a Suggest button teaches
// nobody what a good request looks like, so the three examples are on screen and
// clicking one fills the box, where it can be edited before it is sent. They are
// the prototype's answerable requests, which is also what the info line says.
//
// Composed: esa-textarea for the request, esa-chip-group for the examples,
// esa-alert-box for the one honest limit, firma2-setup-org-tile for the answer,
// esa-button for the write.
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import Firma2SetupOrgTile from './firma2-setup-org-tile.astro';
import { askExamples } from '../../data/firma2-setup';

const headingId = 'firma2-setup-org-ask-heading';
const resultsId = 'firma2-setup-org-ask-results';

// Value and label are the same string: the chip IS the request, and clicking it
// puts exactly what it says into the field.
const exampleOptions = askExamples.map((example) => ({ value: example.prompt, label: example.prompt }));
---
<section class="firma2-setup-org-ask stack" data-gap="md" aria-labelledby={headingId}>
  <h2 id={headingId} class="typography-title-strong">Add more</h2>

  <div class="firma2-setup-org-ask__request stack" data-gap="sm">
    <esa-textarea
      class="firma2-setup-org-ask__field"
      label="Describe who else you work with"
      rows="3"
      data-part="text"
    ></esa-textarea>

    <esa-chip-group
      class="firma2-setup-org-ask__examples"
      label="Examples"
      size="sm"
      data-part="examples"
      options={JSON.stringify(exampleOptions)}
    ></esa-chip-group>

    <!-- The one limit worth stating: a request this prototype cannot answer comes
         back as a single organization named after the text, and a reviewer who did
         not know that would read it as a bug. -->
    <EsaAlertBox variant="info">Suggestions come from a fixed set of examples in this prototype.</EsaAlertBox>

    <div class="cluster" data-gap="sm">
      <EsaButton variant="primary" data-part="suggest">Suggest</EsaButton>
    </div>
  </div>

  <div class="firma2-setup-org-ask__results stack" data-gap="md" data-part="results" hidden>
    <h3 id={resultsId} class="typography-label-lg-strong">Suggestions</h3>
    <ul class="firma2-setup-org-ask__grid grid" data-gap="md" data-part="grid" aria-labelledby={resultsId}></ul>
    <div class="cluster" data-gap="sm">
      <EsaButton variant="primary" data-part="add">Add organizations</EsaButton>
    </div>
  </div>

  <Firma2SetupOrgTile />
</section>

<style>
  .firma2-setup-org-ask > h2,
  .firma2-setup-org-ask h3 {
    margin: 0;
  }

  /* The request is a sentence, not a paragraph: a full-bleed box invites an essay
     nothing here can read. */
  .firma2-setup-org-ask__field {
    display: block;
    max-inline-size: 44rem;
  }

  /* Same engine and same floor as the picker's grid; the list chrome comes off
     because <ul> was chosen for its semantics, not its bullets. */
  .firma2-setup-org-ask__grid {
    --grid-min: 13rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* .stack owns display, so [hidden] needs the specificity to win. */
  .firma2-setup-org-ask__results[hidden] {
    display: none;
  }
</style>

<style is:global>
  /* A chip is built for one or two words and sets `white-space: nowrap` on the
     part; these examples are whole requests, and nowrap is what would push the
     page sideways on a phone. Wrapping the chip is the only change, and it is made
     through the part the lego exposes rather than by rebuilding it. Global because
     ::part is the one selector Astro's scoping cannot be trusted to rewrite. */
  .firma2-setup-org-ask esa-chip-group::part(chip) {
    white-space: normal;
    text-align: start;
  }
</style>

<script>
  import '@esa/ecology/esa-textarea';
  import '@esa/ecology/esa-chip-group';
  import { addOrganizations, proposeOrganizations, setOrganizationStatus } from '../../lib/setup-draft';
  import type { Organization } from '../../data/firma2-setup';

  const TILE = 'firma2-org-tile';

  type OrgTile = HTMLElement & { org: Organization; orgId: string; selected: boolean };
  type ValueElement = HTMLElement & { value: string };

  const section = document.querySelector<HTMLElement>('.firma2-setup-org-ask');
  const field = section?.querySelector<ValueElement>('[data-part="text"]');
  const examples = section?.querySelector<ValueElement>('[data-part="examples"]');
  const suggestButton = section?.querySelector<HTMLButtonElement>('[data-part="suggest"]');
  const results = section?.querySelector<HTMLElement>('[data-part="results"]');
  const grid = section?.querySelector<HTMLElement>('[data-part="grid"]');
  const addButton = section?.querySelector<HTMLButtonElement>('[data-part="add"]');

  if (section && field && examples && suggestButton && results && grid && addButton) {
    // The proposals, by id, so Add writes the RECORD rather than what the tile
    // happens to be displaying.
    let proposed: Organization[] = [];

    const picked = (): OrgTile[] => [...grid.querySelectorAll<OrgTile>(TILE)].filter((tile) => tile.selected);

    const syncAddButton = (): void => {
      const count = picked().length;
      addButton.disabled = count === 0;
      const label = addButton.querySelector('.esa-button__label');
      if (label) {
        label.textContent =
          count === 0 ? 'Add organizations' : count === 1 ? 'Add 1 organization' : `Add ${count} organizations`;
      }
    };

    // The tile is a custom element, and setting `.org` on one the browser has not
    // upgraded yet writes an own property that SHADOWS the accessor for good. So
    // every proposal waits for the definition, exactly as the picker does.
    const tileReady = customElements.whenDefined(TILE);

    const showProposals = (organizations: Organization[]): void => {
      proposed = organizations;
      void tileReady.then(() => {
        grid.replaceChildren(
          ...organizations.map((org) => {
            const item = document.createElement('li');
            const tile = document.createElement(TILE) as OrgTile;
            tile.org = org;
            // Pre-selected: she asked for these by name. Unpicking is the edit.
            tile.selected = true;
            item.append(tile);
            return item;
          }),
        );
        results.hidden = organizations.length === 0;
        syncAddButton();
      });
    };

    // Clicking an example fills the field, where it can be edited before it is sent.
    examples.addEventListener('change', () => {
      const prompt = examples.value;
      if (!prompt) return;
      field.value = prompt;
      field.focus();
    });

    // Once the text is the user's own, no example is still "the" request.
    field.addEventListener('change', () => {
      if (examples.value) examples.value = '';
    });

    suggestButton.addEventListener('click', () => {
      const text = field.value.trim();
      if (!text) {
        field.focus();
        return;
      }
      showProposals(proposeOrganizations(text));
    });

    grid.addEventListener('org-tile-toggle', syncAddButton);

    addButton.addEventListener('click', () => {
      const keep = new Set(picked().map((tile) => tile.orgId));
      const organizations = proposed.filter((org) => keep.has(org.id));
      if (organizations.length === 0) return;

      // Two writes on purpose: addOrganizations mints them as suggested, the
      // status write is the confirmation Dana just gave by pressing this.
      addOrganizations(organizations);
      for (const org of organizations) setOrganizationStatus(org.id, 'confirmed');

      // The request is answered: clear the box so the next one starts empty and the
      // added organizations are read from the roster, where they now live.
      proposed = [];
      grid.replaceChildren();
      results.hidden = true;
      field.value = '';
      if (examples.value) examples.value = '';
    });
  }
</script>
