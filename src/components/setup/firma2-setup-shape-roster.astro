---
// firma2-setup-shape-roster: the last screen of the Program shape walk. The
// three rules, what the program answered, and the document evidence behind
// each, and Next back to the hub.
//
// THREE FIXED ROWS. The cast is the three program-shape intent questions, in
// screen order, so the rows are authored and only the Answer and Evidence cells
// are draft state. An unanswered rule keeps its row with the no-value mark:
// the question still exists, it is only open.
//
// NO REMOVE COLUMN. An answer is not a record to delete; Back reaches each
// question, and "Decide later" is how one is left open.
//
// EVIDENCE IS THE EXTRACTED LABEL, shown only once documents are uploaded, so
// the column never claims a document the admin has not given setup.
//
// NEXT GOES TO THE HUB, filled, the way the classification roster's does.
//
// bcn-lego-checked: esa-button for Next. The bespoke part is the <table>,
// on firma2-table.css: there is no esa-table (walked the catalog), and the
// spoke's AG Grid chrome is priced for portfolio-scale surfaces with search,
// filters and export, none of which three rows read once during setup can use.
// Beacon is not cloned on this machine. firma2-setup-classification-roster is
// the precedent this table follows.
import Firma2SetupStepScreen from './firma2-setup-step-screen.astro';
import Firma2SetupStepNext from './firma2-setup-step-next.astro';
import '../shared/firma2-table.css';
import { withBase } from '../../lib/base';
import type { ProgramShapeQuestionId } from '../../data/firma2-setup';

/** The Rule column, in screen order: the name of each rule, not its question. */
const rules: { questionId: ProgramShapeQuestionId; label: string }[] = [
  { questionId: 'money', label: 'How money moves' },
  { questionId: 'time', label: 'Reporting year' },
  { questionId: 'proposals', label: 'Proposals' },
];

const hubHref = withBase('/prototypes/setup');
---
<Firma2SetupStepScreen
  step="review"
  icon="settings"
  prompt="Your program shape"
  align="start"
  class="firma2-setup-shape-roster"
>
  <div class="firma2-table__scroll">
    <table class="firma2-table">
      <caption class="visually-hidden">Program rules</caption>
      <thead>
        <tr>
          <th scope="col" class="typography-label-sm-strong">Rule</th>
          <th scope="col" class="typography-label-sm-strong">Answer</th>
          <th scope="col" class="typography-label-sm-strong">Evidence</th>
        </tr>
      </thead>
      <tbody>
        {rules.map((rule) => (
          <tr data-question={rule.questionId}>
            <td><span class="typography-label-sm-strong">{rule.label}</span></td>
            <td class="typography-body-sm" data-part="answer">–</td>
            <td class="typography-body-sm" data-part="evidence">–</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <Firma2SetupStepNext slot="advance" href={hubHref} label="Go to setup" />
</Firma2SetupStepScreen>

<script>
  import { programShapeEvidence } from '../../data/firma2-setup';
  import { intentOptionsFor, readSetupDraft } from '../../lib/setup-draft';

  /** The no-value mark: an EN dash, never text the data did not produce. */
  const NONE = '–';

  const screen = document.querySelector<HTMLElement>('.firma2-setup-shape-roster[data-step]');
  const rows = [...(screen?.querySelectorAll<HTMLTableRowElement>('tr[data-question]') ?? [])];

  const render = (): void => {
    const draft = readSetupDraft();
    for (const row of rows) {
      const questionId = row.dataset.question ?? '';
      const chosen = draft.intent[questionId]?.[0];
      const answer = intentOptionsFor(questionId, draft).find((option) => option.id === chosen);
      const evidence = draft.documentsUploaded
        ? programShapeEvidence.find((entry) => entry.questionId === questionId)
        : undefined;

      const answerCell = row.querySelector<HTMLElement>('[data-part="answer"]');
      if (answerCell) answerCell.textContent = answer?.label ?? NONE;
      const evidenceCell = row.querySelector<HTMLElement>('[data-part="evidence"]');
      if (evidenceCell) evidenceCell.textContent = evidence?.label ?? NONE;
    }
  };

  if (rows.length > 0) {
    document.addEventListener('setup-draft-change', render);
    render();
  }
</script>
