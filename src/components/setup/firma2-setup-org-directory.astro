---
// firma2-setup-org-directory — the half of the cast no document named, picked out
// of a directory instead of typed into a box.
//
// WHY A DIRECTORY AND NOT A TEXT FIELD. The picker above can only offer what was
// written down, and every program has partners who appear in no report: the county,
// the irrigation district, the land trust that joined last month. The obvious build
// is "Add organization" with a name field, and it is the single worst record in any
// program database — by year three the same irrigation district is in there four
// times under four spellings, and the reporter meeting that dropdown (product brief
// §5.2) is the one who pays. Typing invents a record. Picking resolves one.
//
// A GRID, NOT TILES. Forty-seven records is a table's scale: the reader is hunting
// one name among many, and a row per record with the level, kind and jurisdiction
// in their own columns is what lets the eye run down a column instead of reading
// forty-seven cards. The whole directory is on the page from the start, ordered
// top of the governance stack down and then by name, so the search narrows a list
// the reader can already see rather than conjuring one. The curated "common for
// programs like yours" opening set came off with the cards on 2026-09-11: it
// existed because a card grid could not show forty-seven, and a grid can.
//
// THE MARK RIDES THE NAME. The emblem's shape carries the level (shield for an
// agency, hex for a district, square for a city, disc for a trust or a fund), so
// the eye sorts the rows before it reads a word of them.
//
// ADDING KEEPS THE PLACE. A row that has been added swaps its Add for an Added
// badge in place — the grid never reshuffles under the cursor — and focus moves to
// the next row's Add, so a keyboard user adds five partners without a single Tab.
//
// THE SPOKE'S GRID, WITH TWO PIECES OF ITS CHROME LEFT OFF. Search and the record
// count are here; the download action is not, because a program picks from this
// directory and never exports it, and a button that does nothing useful is chrome
// for chrome's sake. The clear-filters control is the level chip group's own
// deselect.
//
// bcn-lego-checked: every control here is a lego — esa-text-field for the search,
// esa-chip-group for the level filter, esa-button for Add, esa-badge for Added,
// esa-empty-state for no matches. The tabular surface is AG Grid through
// shared/grid-chrome.ts and shared/firma2-data-grid-chrome.css, this spoke's
// vetted precedent for a table (there is no esa-table; firma2-project-grid is the
// pattern this follows). The Add button and the Added badge are server-rendered
// legos cloned into cells, the same trick the project grid uses for its stage
// pills, so the cell IS the lego rather than a hand-rolled copy of it. Beacon is
// not cloned on this machine.
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import '../shared/firma2-data-grid-chrome.css';
import { byLevelThenName, levelLabels, organizationDirectory, organizationLevels } from '../../data/firma2-org-directory';

const headingId = 'firma2-setup-org-directory-heading';

// "All" first, then the governance stack top down — the same order the rows come
// in, so the filter row and the grid agree about what is above what.
const levelOptions = [
  { value: 'all', label: 'All' },
  ...organizationLevels.map((level) => ({ value: level, label: levelLabels[level] })),
];

// Row data, in the order the grid opens with. The level label is resolved here so
// the cell and the quick filter read the word the chip row shows.
const rows = [...organizationDirectory].sort(byLevelThenName).map((entry) => ({
  id: entry.id,
  name: entry.name,
  level: entry.level,
  levelLabel: levelLabels[entry.level],
  kind: entry.kind,
  jurisdiction: entry.jurisdiction,
}));
---
<section class="firma2-setup-org-directory stack" data-gap="md" aria-labelledby={headingId}>
  <h2 id={headingId} class="typography-title-strong">Add from the directory</h2>

  <!-- The control row is the data grid's: search at the leading edge, the level
       filter beside it. md on both, the rung where the two legos' labels agree
       (the project grid documents the sm mismatch). -->
  <div class="firma2-data-grid__controls repel">
    <div class="firma2-data-grid__controls-filters cluster">
      <div class="firma2-data-grid__search">
        <esa-text-field
          label="Search organizations"
          placeholder="Name, jurisdiction or kind"
          size="md"
          data-part="search"
        ></esa-text-field>
      </div>

      <esa-chip-group
        label="Level"
        size="md"
        value="all"
        data-part="levels"
        options={JSON.stringify(levelOptions)}
      ></esa-chip-group>
    </div>
  </div>

  <!-- AG Grid mounts here. autoHeight grows with rows so the page owns vertical
       scroll; the wrapper owns the framed surface. -->
  <div class="firma2-data-grid__grid" data-part="grid"></div>

  <footer class="firma2-data-grid__footer">
    <span class="typography-meta" data-part="count">{rows.length} organizations</span>
  </footer>

  {/* The two states of the action cell, server-rendered once and cloned per row.
      Both are the lego; neither is re-authored in the script. */}
  <div data-part="add-template" hidden aria-hidden="true">
    <EsaButton variant="secondary" size="xs" icon="plus" data-org-id="">Add</EsaButton>
  </div>
  <div data-part="added-template" hidden aria-hidden="true">
    <EsaBadge value="Added" variant="success" size="sm" />
  </div>

  <!-- The no-match state, handed to AG Grid as its overlayNoRowsTemplate so the
       grid never falls back to its own "No Rows To Show". -->
  <div data-part="empty" hidden aria-hidden="true">
    <EsaEmptyState size="sm" title="No matches" description="Try fewer words, or choose a different level." />
  </div>

  <script type="application/json" data-part="rows" set:html={JSON.stringify(rows)}></script>
</section>

<style>
  .firma2-setup-org-directory > h2 {
    margin: 0;
  }

  /* A fixed frame for a normal-layout grid: about eleven rows and the header.
     Checked hard-code; no token names a viewport height. */
  .firma2-setup-org-directory .firma2-data-grid__grid {
    block-size: 32rem;
  }

  /* The name cell holds the emblem beside the name, on ONE line. The cluster
     primitive wraps by default, and a name too long for the column wrapped
     under the mark, where the row's fixed height hid it entirely. So: no wrap,
     the mark never shrinks, and the name truncates with the full text in the
     cell's tooltip. Runtime-built markup carries no scope hash, hence :global. */
  .firma2-setup-org-directory :global(.firma2-setup-org-directory__org) {
    block-size: 100%;
    flex-wrap: nowrap;
    --align: center;
  }
  .firma2-setup-org-directory :global(.firma2-setup-org-directory__org .firma2-org-mark) {
    flex: none;
  }
  .firma2-setup-org-directory :global(.firma2-setup-org-directory__org > span) {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The action cell centres its control vertically, the same way the project
     grid's status cell centres its pill. */
  .firma2-setup-org-directory :global(.firma2-setup-org-directory__action) {
    display: inline-flex;
    align-items: center;
    block-size: 100%;
  }
</style>

<script>
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-chip-group';
  import { escGridHtml as esc, wireDataGrid } from '../shared/grid-chrome';
  import type { ColDef } from 'ag-grid-community';
  import { addOrganizations, listOrganizations, setOrganizationStatus } from '../../lib/setup-draft';
  import { directoryById, toOrganization } from '../../data/firma2-org-directory';
  import type { OrganizationLevel } from '../../data/firma2-org-directory';
  import { orgMarkHtml } from '../../lib/org-mark';

  interface DirectoryRow {
    id: string;
    name: string;
    level: OrganizationLevel;
    levelLabel: string;
    kind: string;
    jurisdiction: string;
  }

  type ValueElement = HTMLElement & { value: string };

  const root = document.querySelector<HTMLElement>('.firma2-setup-org-directory');
  const levels = root?.querySelector<ValueElement>('[data-part="levels"]');
  const gridHost = root?.querySelector<HTMLElement>('[data-part="grid"]');
  const addHTML = root?.querySelector('[data-part="add-template"]')?.innerHTML ?? '';
  const addedHTML = root?.querySelector('[data-part="added-template"]')?.innerHTML ?? '';
  // outerHTML of the element itself: overlayNoRowsTemplate takes HTML with a
  // SINGLE root element, and the wrapper's innerHTML would hand it whitespace too.
  const emptyState = root?.querySelector<HTMLElement>('[data-part="empty"] > *');

  if (root && levels && gridHost) {
    let level: OrganizationLevel | 'all' = 'all';

    /**
     * Added means CONFIRMED, not merely known.
     *
     * The eleven names the documents proposed are `suggested` until somebody
     * answers them in the picker above, and marking those "Added" down here would
     * be the screen telling Dana a decision was made that was not. They keep their
     * Add, and pressing it IS the answer — the same write the picker's Add makes,
     * so the tile up there drops out and the row appears in the roster.
     */
    let added = new Set<string>();
    const readAdded = (): void => {
      added = new Set(listOrganizations().filter((org) => org.status === 'confirmed').map((org) => org.id));
    };
    readAdded();

    const columnDefs: ColDef<DirectoryRow>[] = [
      // The identifying column carries the row: emblem, then name. Escaped even
      // though every name is a literal in our own data module — the renderer takes
      // a string of HTML, and the moment this data comes from anywhere else an
      // unescaped interpolation is an injection point.
      {
        headerName: 'Organization', field: 'name', colId: 'name',
        flex: 2, minWidth: 300, cellClass: 'firma2-grid-name', tooltipField: 'name',
        getQuickFilterText: (p) => p.data?.name ?? '',
        cellRenderer: (p: { data?: DirectoryRow }) => {
          if (!p.data) return '';
          const entry = directoryById.get(p.data.id);
          const mark = entry ? orgMarkHtml(entry.mark, 'sm', 'center') : '';
          return `<span class="firma2-setup-org-directory__org cluster" data-gap="xs">${mark}<span>${esc(p.data.name)}</span></span>`;
        },
      },
      {
        headerName: 'Level', field: 'levelLabel', colId: 'level', width: 100,
      },
      {
        headerName: 'Kind', field: 'kind', colId: 'kind', width: 176,
        getQuickFilterText: (p) => p.data?.kind ?? '',
      },
      {
        headerName: 'Jurisdiction', field: 'jurisdiction', colId: 'jurisdiction', flex: 1, minWidth: 160, tooltipField: 'jurisdiction',
        getQuickFilterText: (p) => p.data?.jurisdiction ?? '',
      },
      // The action. Added rows keep their place and show the badge; open rows show
      // the button with the organization's name in its accessible name, because
      // "Add" alone is the same name on every row.
      {
        headerName: '', field: 'id', colId: 'action', width: 104, sortable: false, resizable: false,
        cellClass: 'firma2-setup-org-directory__action',
        cellRenderer: (p: { data?: DirectoryRow }) => {
          if (!p.data) return '';
          if (added.has(p.data.id)) return addedHTML;
          return addHTML
            .replace('data-org-id=""', `data-org-id="${esc(p.data.id)}" aria-label="Add ${esc(p.data.name)}"`);
        },
      },
    ];

    const handle = wireDataGrid<DirectoryRow>({
      root,
      gridSelector: '[data-part="grid"]',
      dataSelector: '[data-part="rows"]',
      searchSelector: '[data-part="search"]',
      countSelector: '[data-part="count"]',
      countNoun: 'organizations',
      csvFileName: 'organization-directory.csv',
      suppressCellFocus: true,
      columnDefs,
      gridOptions: {
        // The directory scrolls inside a fixed frame instead of growing to 64
        // rows: the page below it (the roster, the way forward) stays reachable.
        domLayout: 'normal',
        overlayNoRowsTemplate: emptyState?.outerHTML,
        isExternalFilterPresent: () => level !== 'all',
        doesExternalFilterPass: (node) => node.data?.level === level,
      },
    });

    if (handle) {
      const { gridApi } = handle;

      // A chip group in single-select mode can be toggled back off, which reads as All.
      levels.addEventListener('change', () => {
        level = (levels.value || 'all') as OrganizationLevel | 'all';
        gridApi.onFilterChanged();
      });

      /** The Add buttons still on offer, in row order. */
      const openAdds = (): HTMLElement[] => [...gridHost.querySelectorAll<HTMLElement>('[data-org-id]')];

      // Delegated on the host, because AG Grid rebuilds cells as it pleases.
      gridHost.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLElement>('[data-org-id]');
        const id = button?.dataset.orgId;
        if (!button || !id) return;
        const entry = directoryById.get(id);
        if (!entry) return;

        // Where the next Add sits is decided BEFORE the write, while this row still
        // has one: adding chains, so the hands stay on the grid.
        const buttons = openAdds();
        const nextId = buttons[buttons.indexOf(button) + 1]?.dataset.orgId;

        // Two writes on purpose: addOrganizations mints the record as suggested, the
        // status write is the confirmation just given by pressing this.
        addOrganizations([toOrganization(entry)]);
        setOrganizationStatus(id, 'confirmed');

        if (nextId) gridHost.querySelector<HTMLElement>(`[data-org-id="${nextId}"]`)?.focus();
      });

      // A status change redraws the action column only. The roster and the header
      // counts listen to the same event and rebuild themselves, because that is
      // where the change actually shows.
      document.addEventListener('setup-draft-change', () => {
        readAdded();
        gridApi.refreshCells({ columns: ['action'], force: true });
      });
    }
  }
</script>
