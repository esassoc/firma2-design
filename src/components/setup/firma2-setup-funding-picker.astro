---
// firma2-setup-funding-picker: the first screen of the Funding sources walk.
// Every funding source the documents proposed, as a tile you tap to keep.
//
// ONE QUESTION OVER THE WHOLE CAST. The idiom is firma2-setup-org-picker's: the
// screen asks once, over every document-sourced candidate, and nothing is written
// on tap. The write is the arrow. Next confirms the selected tiles and dismisses
// the rest, because "which of these fund your projects" has one answer for each
// tile and leaving some unanswered is not one of them. "None of these" is the
// same write with nothing selected. That is the change from the one-page picker
// this replaced, whose "Skip the rest" dismissed selected and unselected alike
// (Andy, 2026-09-18: "what does 'Skip the rest' mean?").
//
// THE SCREEN SHOWS EVERY DOCUMENT-SOURCED SOURCE, not only the open ones, with
// the confirmed ones already pressed. So the screen is resumable and idempotent:
// Back from the roster shows the answer as given, a tile can be un-pressed and
// the arrow re-writes the cast. The roster's Remove returns a document-sourced
// row to `suggested`, which reads here as un-pressed.
//
// WHY THIS SCREEN DOES NOT ASK FOR AN UPLOAD. The Start step already took the
// documents, for every milestone at once; asking again here would make the
// program answer the same question per record type. So the first thing on this
// walk is what those documents said about money, and when there are no documents
// the screen says so and points at Start.
//
// Composed: firma2-setup-step-screen is the screen, .grid the layout engine,
// firma2-setup-funding-tile the tile, esa-button the arrow and the skip,
// esa-empty-state the no-documents state.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import Firma2SetupStepScreen from './firma2-setup-step-screen.astro';
import Firma2SetupFundingTile from './firma2-setup-funding-tile.astro';
import { withBase } from '../../lib/base';
---
<Firma2SetupStepScreen
  step="suggested"
  icon="file-text"
  prompt="Which of these fund your projects?"
  align="start"
  class="firma2-setup-funding-picker"
>
  <!-- Filled by the script: which documents named the cast is draft state. -->
  <p slot="lede" class="typography-body-md firma2-setup-steps__lede" data-part="lede" hidden></p>

  <!-- Filled by the script: which suggestions exist and which are pressed is
       draft state, so there is nothing honest to render at build time. The
       tile's markup is still authored, in firma2-setup-funding-tile's template. -->
  <ul class="firma2-setup-funding-picker__grid grid" data-gap="md" data-part="grid" hidden></ul>

  <!-- Plain <div> wrapper because esa-empty-state's props have no `hidden`. -->
  <div data-part="no-documents" hidden>
    <EsaEmptyState title="No suggestions yet" description="Upload a report or grant agreement to find funding sources.">
      <EsaButton variant="primary" href={withBase('/prototypes/setup/start')}>Start</EsaButton>
    </EsaEmptyState>
  </div>

  <Firma2SetupFundingTile />

  <div slot="advance" class="firma2-setup-steps__arrow">
    <EsaButton variant="primary" appearance="outline" size="lg" iconOnly icon="arrow-right" label="Next" data-step-next />
  </div>
  <EsaButton slot="advance" variant="ghost" size="sm" data-step-skip>None of these</EsaButton>
</Firma2SetupStepScreen>

<style>
  /* .grid is the layout engine; this strips the list chrome that comes with
     choosing <ul> for its semantics and sets the tile's floor. */
  .firma2-setup-funding-picker__grid {
    --grid-min: 16rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* .grid owns display, so [hidden] needs the specificity to win. */
  .firma2-setup-funding-picker__grid[hidden] {
    display: none;
  }
</style>

<script>
  import { listFundingSources, readSetupDraft, setFundingSourceStatuses, sourceDocumentNames } from '../../lib/setup-draft';
  import type { FundingSource, FundingSourceStatus } from '../../data/firma2-setup';

  const TILE = 'firma2-funding-tile';

  /** "A, B, and C": the documents named in the lede, in reading order. */
  const LIST = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' });

  type FundingTile = HTMLElement & { source: FundingSource; sourceId: string; selected: boolean };

  const screen = document.querySelector<HTMLElement>('.firma2-setup-funding-picker[data-step]');
  const grid = screen?.querySelector<HTMLElement>('[data-part="grid"]');
  const lede = screen?.querySelector<HTMLElement>('[data-part="lede"]');
  const noDocuments = screen?.querySelector<HTMLElement>('[data-part="no-documents"]');
  const next = screen?.querySelector<HTMLElement>('[data-step-next]');
  const skip = screen?.querySelector<HTMLElement>('[data-step-skip]');

  if (screen && grid && lede && noDocuments && next && skip) {
    /** The cast this screen answers for: everything a document proposed, whatever its status now. */
    const fromDocuments = (): FundingSource[] => listFundingSources().filter((source) => source.source === 'document');

    const tiles = (): FundingTile[] => [...grid.querySelectorAll<FundingTile>(TILE)];

    // Answered means at least one tile pressed. A cast of none has nothing to
    // answer, so the arrow stays live and the walk goes on.
    const syncReady = (): void => {
      const cast = tiles();
      screen.dataset.stepReady = String(cast.length === 0 || cast.some((tile) => tile.selected));
    };

    const render = (): void => {
      const cast = fromDocuments();
      const uploaded = readSetupDraft().documentsUploaded;

      grid.replaceChildren(
        ...cast.map((source) => {
          const item = document.createElement('li');
          const tile = document.createElement(TILE) as FundingTile;
          tile.source = source;
          tile.selected = source.status === 'confirmed';
          item.append(tile);
          return item;
        }),
      );

      grid.hidden = cast.length === 0;
      noDocuments.hidden = uploaded;
      // The line under the prompt names the documents the cast came from, so the
      // tiles read as what those documents said, not a list setup invented.
      const named = sourceDocumentNames(cast);
      lede.textContent = named.length > 0 ? `Named in ${LIST.format(named)}.` : '';
      lede.hidden = named.length === 0;
      syncReady();
    };

    grid.addEventListener('funding-tile-toggle', syncReady);

    // The arrow is the write: pressed tiles confirmed, the rest dismissed, in one
    // pass. The shell advances on the same click.
    next.addEventListener('click', () => {
      const statuses: Record<string, FundingSourceStatus> = {};
      for (const tile of tiles()) statuses[tile.sourceId] = tile.selected ? 'confirmed' : 'dismissed';
      if (Object.keys(statuses).length > 0) setFundingSourceStatuses(statuses);
    });

    skip.addEventListener('click', () => {
      const statuses: Record<string, FundingSourceStatus> = {};
      for (const source of fromDocuments()) statuses[source.id] = 'dismissed';
      if (Object.keys(statuses).length > 0) setFundingSourceStatuses(statuses);
    });

    let ready = false;
    document.addEventListener('setup-draft-change', () => {
      if (ready) render();
    });

    // Wait for the tile's definition, or createElement hands back an unupgraded
    // element whose `source` setter goes nowhere.
    customElements.whenDefined(TILE).then(() => {
      ready = true;
      render();
    });
  }
</script>
