---
// firma2-setup-stage-tile: one of the six fixed project stages as a large,
// tappable toggle. The unit firma2-setup-stage-picker deals in.
//
// IT RENDERS NOTHING BY ITSELF. Same construction as firma2-setup-funding-tile:
// an inert <template> holding the tile's markup, and a <firma2-stage-tile>
// custom element that clones the template and fills it. A caller creates the
// element and sets `.stage`; no caller writes tile markup.
//
// THE CONTRACT
//   el.stage = StageOption      fills the name, the definition, the tracker statuses
//   el.stageId                  the stage's id, for the caller's write
//   el.selected                 get/set, mirrors aria-pressed on the button
//   el.showProvenance           get/set (or the `show-provenance` attribute):
//                               whether the tracker line may show. The picker
//                               sets it from documentsUploaded, because a stage's
//                               trackerStatuses are seed data and only count as
//                               evidence once the tracker is in.
//   'stage-tile-toggle'         bubbling CustomEvent<{ id, selected }> on every click
//
// SELECTION IS NOT A WRITE. Tapping marks the tile; the picker's arrow commits,
// once, for all six.
//
// WHAT IS ON THE TILE. The stage name (dbo.ProjectStage.ProjectStageDisplayName),
// because the tile is a yes-or-no on it. The definition, because the six names
// are ProjectFirma's words and a program that calls its own statuses "Funded"
// and "In construction" has to see what each stage means to map onto it. The
// tracker Status values that land in the stage, as provenance in the mono
// composite: the evidence the pre-pressed state rests on. Deferred has none, so
// its line stays hidden.
//
// bcn-lego-checked: nothing in the catalog is a SELECTABLE tile. esa-card is
// presentational (no pressed state, closed prop set); esa-checkbox has the right
// semantics and a 16px target; esa-chip-group `multiple` is the closest behaviour
// but a chip is one nowrap line and this holds three data in a stack; esa-button
// `active` is a control, not a record. Beacon is not cloned on this machine. So
// the toggle is the shared native <button aria-pressed> from
// shared/firma2-pick-tile.css, the reusable home every setup picker's tile uses,
// and every mark inside it is a lego: esa-icon for the check and the file glyph,
// laid out by .stack.
import EsaIcon from '@esa/ecology/esa-icon.astro';
import '../shared/firma2-pick-tile.css';
import '../shared/firma2-provenance.css';
---
{/* The master copy. Inert until a <firma2-stage-tile> clones it. */}
<template data-stage-tile>
  <button type="button" class="firma2-pick-tile" aria-pressed="false">
    {/* The selected mark. Present in every tile, shown only when pressed, so
        selecting cannot reflow the card it sits in. */}
    <span class="firma2-pick-tile__mark"><EsaIcon name="circle-check" size="sm" /></span>

    <span class="firma2-pick-tile__body stack" data-gap="2xs">
      <span class="typography-label-md-strong" data-part="name"></span>
      <span class="firma2-pick-tile__secondary typography-body-sm" data-part="definition"></span>
      {/* The tracker Status values that land here. The file glyph is the label. */}
      <span class="firma2-provenance typography-code-sm" data-part="source" hidden>
        <EsaIcon name="file-text" size="xs" />
        <span data-part="source-name"></span>
      </span>
    </span>
  </button>
</template>

<style is:global>
  /* The host is created by script and never carries this component's scope
     attribute, so its one rule is global, scoped by a tag name this file owns.
     Stretching to the grid row's height keeps a short tile clickable edge to
     edge beside a tall one. */
  firma2-stage-tile {
    display: block;
    block-size: 100%;
  }
</style>

<script>
  import type { StageOption } from '../../data/firma2-setup';

  const TAG = 'firma2-stage-tile';

  /** "Proposed, Funded": tracker values as written, listed without a conjunction. */
  const LIST = new Intl.ListFormat('en', { style: 'narrow', type: 'unit' });

  class Firma2StageTile extends HTMLElement {
    static observedAttributes = ['show-provenance'];

    #stage: StageOption | null = null;
    #button: HTMLButtonElement | null = null;
    #selected = false;

    /** Fills the tile. Setting it again rebuilds; there is no partial update. */
    set stage(value: StageOption) {
      this.#stage = value;
      this.#build();
    }

    get stage(): StageOption | null {
      return this.#stage;
    }

    get stageId(): StageOption['id'] | '' {
      return this.#stage?.id ?? '';
    }

    get selected(): boolean {
      return this.#selected;
    }

    set selected(value: boolean) {
      this.#selected = value;
      this.#button?.setAttribute('aria-pressed', value ? 'true' : 'false');
    }

    get showProvenance(): boolean {
      return this.hasAttribute('show-provenance');
    }

    set showProvenance(value: boolean) {
      this.toggleAttribute('show-provenance', value);
    }

    attributeChangedCallback(): void {
      this.#syncProvenance();
    }

    connectedCallback(): void {
      if (!this.#button) this.#build();
    }

    /** The tracker line shows only when the caller allows it and the stage has values. */
    #syncProvenance(): void {
      const line = this.querySelector<HTMLElement>('[data-part="source"]');
      if (line) line.hidden = !this.showProvenance || (this.#stage?.trackerStatuses.length ?? 0) === 0;
    }

    #build(): void {
      const stage = this.#stage;
      if (!stage) return;

      const tileTemplate = document.querySelector<HTMLTemplateElement>('template[data-stage-tile]');
      if (!tileTemplate) return;

      const tile = tileTemplate.content.cloneNode(true) as DocumentFragment;
      const part = (name: string): HTMLElement | null => tile.querySelector<HTMLElement>(`[data-part="${name}"]`);

      const name = part('name');
      if (name) name.textContent = stage.name;

      const definition = part('definition');
      if (definition) definition.textContent = stage.definition;

      const sourceValue = part('source-name');
      if (sourceValue) sourceValue.textContent = LIST.format(stage.trackerStatuses);

      this.replaceChildren(tile);
      this.#syncProvenance();
      this.#button = this.querySelector('button');
      this.#button?.setAttribute('aria-pressed', this.#selected ? 'true' : 'false');
      this.#button?.addEventListener('click', () => {
        this.selected = !this.selected;
        this.dispatchEvent(
          new CustomEvent('stage-tile-toggle', {
            detail: { id: this.stageId, selected: this.selected },
            bubbles: true,
            composed: true,
          }),
        );
      });
    }
  }

  if (!customElements.get(TAG)) customElements.define(TAG, Firma2StageTile);
</script>
