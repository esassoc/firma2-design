---
// firma2-org-mark — an organization's emblem, at build time.
//
// The drawing lives in lib/org-mark.ts, not here, because half the marks on this
// screen are created in the BROWSER: the directory's results are client state, and
// an .astro component cannot be instantiated at runtime. One renderer serving both
// callers is what stops a server-rendered roster mark and a script-built result
// mark drifting into two different emblems for the same organization.
//
// bcn-lego-checked: esa-avatar is the near miss and is worth naming — it does
// initials in a tinted disc at four sizes, and it is the right lego for a PERSON.
// Three things make it the wrong one for an organization: its hue is hashed from
// the name (this spoke's hue is a stored datum, so a tenant can be given its real
// brand colour later, and a renamed organization keeps its mark), its shapes are
// circle and square only (a shield and a hex are what separate an agency from a
// district at a glance across 47 results), and it is .astro only, so the directory
// could not build one. Also checked esa-icon (a glyph registry, not a letterform)
// and esa-badge (text in a pill, no shape axis). Beacon is not cloned on this
// machine. Filed as the reusable home for every emblem in this spoke.
import { orgMarkSvg } from '../../lib/org-mark';
import type { OrgMark, OrgMarkSize } from '../../lib/org-mark';

interface Props {
  mark: OrgMark;
  size?: OrgMarkSize;
}

const { mark, size = 'md' } = Astro.props;
---
<Fragment set:html={orgMarkSvg(mark, size)} />

<style is:global>
  /* Global because most marks on this screen are appended by script and therefore
     never carry this component's scope attribute. Two declarations only: the
     emblem is sized by its own width/height attributes, and everything else about
     where it sits is the parent primitive's business. `flex: none` is the one
     thing the parent cannot say for it — a .cluster would otherwise squeeze the
     emblem before it wrapped the name beside it. */
  .firma2-org-mark {
    display: block;
    flex: none;
  }
</style>
