---
// firma2-measure-create-dialog — LIBRARY-FIRST measure creation: browse ~15
// themes, pick a concept, land on a prefilled draft. "Start from scratch" is
// the escape, not the door.
//
// WHY LIBRARY-FIRST (docs/measure-model.md, PM10): concepts converge across
// tenants — near-identical measures with the same option lists, retyped by
// hand into drift. A tenant that STARTS from the standard library starts
// aggregable, keeps the shared vocabularies by construction, and sees the
// multi-aspect model working before authoring anything.
//
// A SIBLING OF firma2-entity-create-dialog, NOT A FORK OF IT. The generic
// dialog's contract is exactly ONE question routed to one destination — the
// right shape for entities whose creation is one decision, and Organizations /
// Funding Sources / Users should keep using it. Browsing a library is a
// different act, so it gets its own component rather than a mode flag that
// would wreck the generic one's guarantee.
//
// PICKING A CONCEPT CREATES — one act, not select-then-confirm. The thing
// created is a DRAFT, which makes the click cheap by construction; a
// confirmation step would be pricing it wrong. "Start from scratch" renders as
// the last entry in the theme list, and its "concepts" are the two measure
// kinds — the old dialog's one question, demoted to the escape path but
// keeping its full descriptions, because output-vs-outcome is still the one
// unchangeable decision.
//
// HOW CREATE WORKS ON A STATIC SITE (the localStorage-patch trick): the two
// draft pages are frozen seeds, and the setup page already merges a stored
// draft over its seed on load. So create = clearDraft(slug) — a create is
// fresh, never a resume — then writeDraft(slug, the concept's prefill), then
// navigate. No route changes, no query params (the old `?kind=` was written
// and never read; it dies here).
//
// KNOWN LIMIT, stated: both creates of the same kind share one draft slug, so
// consecutive creates overwrite — a static build cannot mint records, and
// newest-wins is the honest behavior. The toast-free navigation makes this
// visible immediately: you land on the page you just wrote.
import EsaButton from '@esa/ecology/esa-button.astro';
import {
  LIBRARY_THEMES,
  MEASURE_CONCEPTS,
  conceptsForTheme,
} from '../../data/firma2-measure-library';
import { MEASURE_KINDS, VOCABULARIES } from '../../data/firma2-performance-measures';
import { withBase } from '../../lib/base';

interface Props {
  /** Element id — the page's New-measure button points here via data-opens. */
  id: string;
}

const { id } = Astro.props;

const HEADING = 'New performance measure';
const SCRATCH_ID = '__scratch__';
const SCRATCH_LABEL = 'Start from scratch';
const SCRATCH_DESCRIPTION = 'A blank measure — you decide everything.';

// The kind fork's destinations, base-prefixed at build (dev serves at /, Pages
// at /firma2-design/) — the same technique the generic dialog uses.
const DESTINATIONS = JSON.stringify({
  output: withBase('/prototypes/measures/draft-untitled-output'),
  outcome: withBase('/prototypes/measures/draft-untitled-outcome'),
});

// Everything a concept prefills, serialized for the client. The library module
// is imported ONLY here — the setup page never ships it.
const CONCEPTS = JSON.stringify(MEASURE_CONCEPTS);

// A concept's meta line: its amounts and what it asks — the tax and the shape,
// readable before committing. "2 amounts · asks 2 questions · 3 free splits".
const conceptMeta = (conceptId: string): string => {
  const c = MEASURE_CONCEPTS.find((x) => x.id === conceptId)!;
  const amounts = c.aspects
    .map((a) => a.unit ?? '')
    .filter(Boolean)
    .join(' + ');
  const asked = c.dimensions.filter((d) => d.source.kind === 'reported').length;
  const free = c.dimensions.length - asked;
  const parts = [amounts];
  parts.push(asked === 0 ? 'asks nothing' : asked === 1 ? 'asks 1 question' : `asks ${asked} questions`);
  if (free > 0) parts.push(`${free} free split${free === 1 ? '' : 's'}`);
  return parts.filter(Boolean).join(' · ');
};

// Vocabulary presence is worth a sanity check at build: a concept referencing
// a vocabulary that does not exist would render "No options yet" on arrival,
// which is a library bug, not a state to design for.
const knownVocabularies = new Set(VOCABULARIES.map((v) => v.id));
for (const c of MEASURE_CONCEPTS) {
  for (const d of c.dimensions) {
    if (d.vocabularyId && !knownVocabularies.has(d.vocabularyId)) {
      throw new Error(`Library concept "${c.id}" references unknown vocabulary "${d.vocabularyId}"`);
    }
  }
}

// The first theme that actually has concepts opens selected — an empty pane
// as the dialog's first impression would read as a broken library.
const firstTheme = LIBRARY_THEMES.find((t) => conceptsForTheme(t.id).length > 0)?.id ?? SCRATCH_ID;
---

<!-- esa-dialog is a Lit lego: registered by the client script's import, used
     as a custom element here. Native <dialog> under the hood — focus trap,
     Escape, backdrop, scroll lock all come from the platform. -->
<esa-dialog id={id} heading={HEADING} size="lg">
  <div
    class="firma2-measure-create"
    data-destinations={DESTINATIONS}
    data-concepts={CONCEPTS}
    data-first-theme={firstTheme}
  >
    <!-- The library's own claim, one line, then the two panes. -->
    <p class="firma2-measure-create__lede typography-body-sm">
      Standard measures share option lists across programs, so totals roll up the same way everywhere.
    </p>

    <div class="firma2-measure-create__panes">
      <!-- THEMES. A <ul> of buttons, aria-pressed carrying the selection —
           these switch the pane, they do not commit anything. Empty themes
           render dimmed-but-present: hiding them would misstate the standard's
           coverage, and the count says why there is nothing to click. -->
      <ul class="firma2-measure-create__themes stack" data-gap="3xs">
        {LIBRARY_THEMES.map((theme) => {
          const count = conceptsForTheme(theme.id).length;
          return (
            <li>
              <!-- bcn-lego-checked: a selection row in a master-detail list —
                   label + count, full-width, pressed state — which no esa-*
                   lego renders (esa-button draws a CTA box; esa-tab-layout is
                   horizontal tabs over panels and its tab list cannot hold a
                   14-item vertical index). Native button + tokens; the pane
                   switching is this component's own. -->
              <button
                type="button"
                class="firma2-measure-create__theme"
                data-create-theme={theme.id}
                aria-pressed={theme.id === firstTheme ? 'true' : 'false'}
                disabled={count === 0}
              >
                <span class="typography-label-md">{theme.name}</span>
                <span class="firma2-measure-create__count typography-microcopy-sm">
                  {count === 0 ? 'none yet' : count}
                </span>
              </button>
            </li>
          );
        })}
        <li>
          <button
            type="button"
            class="firma2-measure-create__theme firma2-measure-create__theme--scratch"
            data-create-theme={SCRATCH_ID}
            aria-pressed={firstTheme === SCRATCH_ID ? 'true' : 'false'}
          >
            <span class="typography-label-md">{SCRATCH_LABEL}</span>
          </button>
        </li>
      </ul>

      <!-- CONCEPTS. One group per theme, all server-rendered, one visible.
           Each row is a button that CREATES — the meta line prices it before
           the click. -->
      <div class="firma2-measure-create__concepts">
        {LIBRARY_THEMES.filter((t) => conceptsForTheme(t.id).length > 0).map((theme) => (
          <ul
            class="firma2-measure-create__group stack"
            data-gap="2xs"
            data-concept-group={theme.id}
            hidden={theme.id !== firstTheme}
          >
            {conceptsForTheme(theme.id).map((concept) => (
              <li>
                <button type="button" class="firma2-measure-create__concept" data-concept={concept.id}>
                  <span class="typography-label-md-strong">{concept.name}</span>
                  <span class="firma2-measure-create__definition typography-body-sm">{concept.definition}</span>
                  <span class="firma2-measure-create__meta typography-microcopy-sm">{conceptMeta(concept.id)}</span>
                </button>
              </li>
            ))}
          </ul>
        ))}

        <!-- The escape pane: the kind question, in the old dialog's own words. -->
        <ul
          class="firma2-measure-create__group stack"
          data-gap="2xs"
          data-concept-group={SCRATCH_ID}
          hidden={firstTheme !== SCRATCH_ID}
        >
          <li class="firma2-measure-create__scratch-lede typography-body-sm">{SCRATCH_DESCRIPTION}</li>
          {MEASURE_KINDS.map((kind) => (
            <li>
              <button type="button" class="firma2-measure-create__concept" data-scratch-kind={kind.id}>
                <span class="typography-label-md-strong">{kind.name} measure</span>
                <span class="firma2-measure-create__definition typography-body-sm">
                  Records {kind.description}. Reported by {kind.reportedBy}. Not changeable later.
                </span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <EsaButton slot="footer" variant="ghost" data-create-cancel>Cancel</EsaButton>
</esa-dialog>

<style>
  /* `hidden` HAS TO WIN: the concept groups are `.stack`s, whose display:flex
     outranks the UA's weakest-in-cascade [hidden] rule — the same guard every
     hiding component in this spoke carries. */
  .firma2-measure-create [hidden] {
    display: none;
  }

  .firma2-measure-create__lede {
    margin: 0 0 var(--spacing-300, 0.75rem);
    color: var(--color-content-default-secondary, #646464);
  }

  /* Master–detail: a fixed theme index beside a fluid concept pane. Plain grid
     rather than the .sidebar primitive because this must NOT wrap — inside a
     dialog there is no "below" for the index to drop to. */
  .firma2-measure-create__panes {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: var(--spacing-400, 1rem);
    align-items: start;
  }

  .firma2-measure-create__themes,
  .firma2-measure-create__group {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The concept pane scrolls, the index does not: 60dvh keeps the dialog's own
     height stable across themes with 1 vs 4 concepts (one stable footprint). */
  .firma2-measure-create__concepts {
    max-block-size: min(24rem, 60dvh);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-inline-end: var(--spacing-100, 0.25rem);
  }

  .firma2-measure-create__theme {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-200, 0.5rem);
    inline-size: 100%;
    padding: var(--spacing-200, 0.5rem) var(--spacing-300, 0.75rem);
    background: none;
    border: none;
    border-radius: var(--radius-sm, 0.25rem);
    cursor: pointer;
    text-align: start;
    color: var(--color-content-default, #202020);
  }
  .firma2-measure-create__theme:hover {
    background: var(--color-background-default-hover, #f0f0f0);
  }
  .firma2-measure-create__theme[aria-pressed='true'] {
    background: var(--color-background-elevation-sunken, #f0f0f0);
  }
  .firma2-measure-create__theme:disabled {
    cursor: default;
    opacity: 0.5;
    background: none;
  }
  .firma2-measure-create__count {
    color: var(--color-content-default-secondary, #646464);
  }
  /* The escape sits apart from the standard themes by a hairline, not a hue. */
  .firma2-measure-create__theme--scratch {
    margin-block-start: var(--spacing-200, 0.5rem);
    border-block-start: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #d9d9d9);
    border-radius: 0 0 var(--radius-sm, 0.25rem) var(--radius-sm, 0.25rem);
  }

  /* A concept row: name, definition, price line — a card-shaped button on the
     raised step, the whole row being the target. */
  .firma2-measure-create__concept {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100, 0.25rem);
    inline-size: 100%;
    padding: var(--spacing-300, 0.75rem);
    background: var(--color-background-elevation-raised, #fcfcfc);
    border: var(--border-width-default, 1px) solid var(--color-border-default-subtle, #d9d9d9);
    border-radius: var(--radius-sm, 0.25rem);
    cursor: pointer;
    text-align: start;
    color: var(--color-content-default, #202020);
  }
  .firma2-measure-create__concept:hover,
  .firma2-measure-create__concept:focus-visible {
    border-color: var(--color-border-strong, #838383);
  }
  .firma2-measure-create__definition {
    color: var(--color-content-default-secondary, #646464);
  }
  .firma2-measure-create__meta {
    color: var(--color-content-default, #202020);
  }
  .firma2-measure-create__scratch-lede {
    color: var(--color-content-default-secondary, #646464);
    padding-block-end: var(--spacing-100, 0.25rem);
  }
</style>

<script>
  import '@esa/ecology/esa-dialog';
  import { clearDraft, writeDraft, type MeasureDraft } from '../../lib/measure-draft';

  interface Concept {
    id: string;
    theme: string;
    kind: 'output' | 'outcome';
    name: string;
    definition: string;
    aspects: unknown[];
    dimensions: unknown[];
    classifications: unknown[];
    reporterGuidance: string;
  }

  type DialogEl = HTMLElement & { open?: boolean; close?: () => void };

  function init(root: HTMLElement): void {
    const dialog = root.closest<DialogEl>('esa-dialog');
    let destinations: Record<string, string> = {};
    let concepts: Concept[] = [];
    try {
      destinations = JSON.parse(root.dataset.destinations ?? '{}');
      concepts = JSON.parse(root.dataset.concepts ?? '[]');
    } catch {
      return;
    }
    const conceptById = new Map(concepts.map((c) => [c.id, c]));

    // ---- theme switching ---------------------------------------------------
    root.addEventListener('click', (event) => {
      // data-CREATE-theme, not data-theme: the app shell sets `data-theme` on
      // <html> for token theming, and closest() walks that far — a bare
      // [data-theme] here matched the page root on EVERY click and swallowed
      // the other branches. Found the hard way; the prefix is the fix.
      const themeButton = (event.target as Element).closest<HTMLElement>('[data-create-theme]');
      if (themeButton) {
        const theme = themeButton.dataset.createTheme!;
        root.querySelectorAll<HTMLElement>('[data-create-theme]').forEach((b) => {
          b.setAttribute('aria-pressed', b === themeButton ? 'true' : 'false');
        });
        root.querySelectorAll<HTMLElement>('[data-concept-group]').forEach((g) => {
          g.hidden = g.dataset.conceptGroup !== theme;
        });
        return;
      }

      const conceptButton = (event.target as Element).closest<HTMLElement>('[data-concept]');
      if (conceptButton) {
        const concept = conceptById.get(conceptButton.dataset.concept ?? '');
        if (concept) create(concept.kind, concept);
        return;
      }

      const scratchButton = (event.target as Element).closest<HTMLElement>('[data-scratch-kind]');
      if (scratchButton) {
        create(scratchButton.dataset.scratchKind as 'output' | 'outcome', null);
      }
    });

    /**
     * CREATE = clear, prefill, go. clearDraft first because a create is fresh
     * — without it, the concept's patch would merge OVER whatever draft the
     * last visit left on this slug, a chimera nobody asked for. The blank
     * create is the same flow with no patch: clear alone restores the seed.
     */
    function create(kind: 'output' | 'outcome', concept: Concept | null): void {
      const destination = destinations[kind];
      if (!destination) return;
      const slug = destination.split('/').filter(Boolean).pop()!;
      clearDraft(slug);
      if (concept) {
        const patch = {
          name: concept.name,
          definition: concept.definition,
          classifications: concept.classifications,
          aspects: concept.aspects,
          dimensions: concept.dimensions,
          reporterGuidance: concept.reporterGuidance,
          conceptId: concept.id,
          theme: concept.theme,
        } as MeasureDraft;
        if (!writeDraft(slug, patch)) {
          // Storage blocked: the prefill cannot land, and navigating anyway
          // would silently deliver a blank measure claiming to be the concept.
          // Falling through to the blank draft IS the honest degradation —
          // same page, no false provenance.
        }
      }
      window.location.assign(destination);
    }

    // Cancel closes; esa-dialog itself owns Escape and backdrop clicks.
    dialog?.querySelector('[data-create-cancel]')?.addEventListener('click', () => dialog?.close?.());
  }

  // The `data-opens` trigger seam, same contract as the generic create dialog:
  // any element carrying data-opens="<dialog id>" opens it, delegated from
  // document so the page needs no wiring script.
  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element | null)?.closest<HTMLElement>('[data-opens]');
    if (!trigger) return;
    const dialog = document.getElementById(trigger.dataset.opens ?? '') as DialogEl | null;
    if (dialog?.tagName === 'ESA-DIALOG') dialog.open = true;
  });

  document.querySelectorAll<HTMLElement>('.firma2-measure-create').forEach(init);
</script>
